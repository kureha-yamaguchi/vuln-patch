# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `.env` is gitignored — never commit real keys. config.py auto-loads it
# from the repo root, so no extra flags are needed when you run the pipeline.
#
# Real exported environment variables take precedence over anything here.
#
# Pick ONE LLM backend. Precedence: Azure > OpenAI direct > local server.

# --- Option A: Azure OpenAI (takes precedence if the key is set) ----------
AZURE_OPENAI_API_KEY=
# Your resource endpoint — change this to YOUR Azure resource URL:
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
# The deployment name (often equals the model name):
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Option B: OpenAI direct ----------------------------------------------
# OPENAI_API_KEY=sk-...
# LOCAL_LLM_MODEL=gpt-5

# --- Option C: local server (Ollama / LM Studio / vLLM) -------------------
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=gpt-oss-20b
# LOCAL_LLM_API_KEY=not-needed

# --- Optional tuning (defaults shown; uncomment to override) ---------------
# OPENAI_REASONING_EFFORT=medium          # minimal | low | medium | high
# OPENAI_MAX_COMPLETION_TOKENS=16384
# LLM_TIMEOUT_SECONDS=6000
# LLM_STREAM=auto                         # auto | always | never
# JAZZER_VERSION=0.22.1
