package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int meanMilli = data.consumeInt(-100000, 100000);
        int sdMilli = data.consumeInt(1, 100000);
        int k = data.consumeInt(-6, 6);
        if (k == 0) {
            k = 2;
        }

        double mean = meanMilli / 1000.0;
        double sd = sdMilli / 1000.0;
        double x = mean + k * sd;

        exploreRoundTrip(mean, sd, x);

        if (data.remainingBytes() > 0) {
            int anchorishK = data.consumeInt(1, 6);
            double anchorishMean = 0.0;
            double anchorishSd = 1.0;
            double anchorishX = anchorishMean + anchorishK * anchorishSd;
            exploreRoundTrip(anchorishMean, anchorishSd, anchorishX);
        }
    }

    private static void anchor() {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);
        try {
            double p = 0.9772498680518209;
            double result = normal.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0) > 1.0e-12) {
                throw new RuntimeException("[oracle:anchor-exact] metamorphic violation: expected exact test result 2.0 inputP="
                        + p + " got=" + result);
            }

            double roundTrip = normal.cumulativeProbability(result);
            if (Math.abs(roundTrip - p) > 1.0e-12) {
                throw new RuntimeException("[oracle:anchor-rt] metamorphic violation: CDF(ICDF(p)) must equal p for valid probabilities"
                        + " p=" + p + " icdf=" + result + " roundTrip=" + roundTrip);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void exploreRoundTrip(double mean, double sd, double x) {
        NormalDistribution d1 = new NormalDistributionImpl(mean, sd);
        NormalDistribution d2 = new NormalDistributionImpl(mean, sd);

        try {
            double p = d1.cumulativeProbability(x);

            if (!(p > 0.0 && p < 1.0)) {
                return;
            }

            double q1 = d1.inverseCumulativeProbability(p);
            double q2 = d2.inverseCumulativeProbability(p);

            double tol = Math.max(1.0e-10, Math.abs(x) * 1.0e-10);

            /* Contract/oracle:
             * For a continuous distribution, inverseCumulativeProbability is the inverse of
             * cumulativeProbability on valid probabilities. We generate p by construction as
             * p = CDF(x) from the same real distribution object, so a correct implementation
             * is obliged to accept it and return x again. A patch that merely suppresses the
             * buggy throw, or otherwise silently computes the wrong bracket/result, breaks
             * this round-trip relation even when no exception is thrown.
             */
            if (Math.abs(q1 - x) > tol) {
                throw new RuntimeException("[oracle:roundtrip] metamorphic violation: ICDF(CDF(x)) must recover x"
                        + " mean=" + mean + " sd=" + sd + " x=" + x + " p=" + p + " got=" + q1);
            }

            /* Independent consistency cross-check:
             * Two identically constructed real distribution objects must report the same
             * quantile for the same probability.
             */
            if (Math.abs(q1 - q2) > tol) {
                throw new RuntimeException("[oracle:twin-consistency] consistency violation: identical distributions disagree"
                        + " mean=" + mean + " sd=" + sd + " p=" + p + " q1=" + q1 + " q2=" + q2);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void handleThrowable(Throwable t) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            sneakyThrow(t);
        }
    }

    private static boolean isRootCause(Throwable t) {
        return isMathExceptionFamily(t) && hasBracketFrame(t);
    }

    private static boolean isMathExceptionFamily(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasBracketFrame(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            StackTraceElement[] frames = cur.getStackTrace();
            if (frames != null) {
                for (StackTraceElement ste : frames) {
                    if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(ste.getClassName())
                            && "bracket".equals(ste.getMethodName())) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.startsWith("org.apache.commons.math")
                    && (name.contains("Invalid") || name.contains("Illegal") || name.contains("OutOfRange"))) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
