        int[] indices = new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        try {
            PolyhedronsSet anchor = buildPolyhedron(anchorCoords, indices);
            try {
                anchor.getSize();
                anchor.getBarycenter();
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseClassCast(e)) {
                    throw e;
                }
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseClassCast(e)) {
                throw e;
            }
        }

        float scale = boundedScale(data.consumeInt(-500, 500));
        float dx = boundedOffset(data.consumeInt(-1000, 1000));
        float dy = boundedOffset(data.consumeInt(-1000, 1000));
        float dz = boundedOffset(data.consumeInt(-1000, 1000));
        float fuzz = data.consumeInt(-1000, 1000) / 1000000.0f;

        float[] coords = new float[anchorCoords.length];
        for (int i = 0; i < anchorCoords.length; i += 3) {
            coords[i]     = anchorCoords[i]     * scale + dx;
            coords[i + 1] = anchorCoords[i + 1] * scale + dy;
            coords[i + 2] = anchorCoords[i + 2] * scale + dz;
        }
        coords[15] = (1.0f + fuzz) * scale + dx;
        coords[16] = 1.0f * scale + dy;
        coords[17] = 1.0f * scale + dz;

        float tx = boundedOffset(data.consumeInt(-200, 200));
        float ty = boundedOffset(data.consumeInt(-200, 200));
        float tz = boundedOffset(data.consumeInt(-200, 200));

        float[] translated = new float[coords.length];
        for (int i = 0; i < coords.length; i += 3) {
            translated[i]     = coords[i]     + tx;
            translated[i + 1] = coords[i + 1] + ty;
            translated[i + 2] = coords[i + 2] + tz;
        }

        PolyhedronsSet p1;
        PolyhedronsSet p2;
        try {
            p1 = buildPolyhedron(coords, indices);
            p2 = buildPolyhedron(translated, indices);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseClassCast(e)) {
                throw e;
            }
            return;
