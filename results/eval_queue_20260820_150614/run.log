package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
                throw new RuntimeException("[oracle:anchor-reject] createNumber accepted known-invalid input=" + anchors[i]);
            } catch (IllegalArgumentException expectedRejection) {
                // Correct post-fix behavior: invalid numeric syntax is rejected cleanly.
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }
        }

        String candidate;
        if (data.consumeBoolean()) {
            String stem = data.consumeAsciiString(32);
            char suffix = data.consumeBoolean() ? 'L' : 'l';
            candidate = stem + suffix;
        } else {
            candidate = data.consumeAsciiString(33);
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (IllegalArgumentException expectedRejection) {
            // Clean rejection of malformed input is correct.
        } catch (RuntimeException t) {
            if ((isAnchorLikeRootCauseInput(candidate) || isExactAnchor(candidate)) && isRootCause(t)) {
                throw t;
            }
        }

        int n = data.consumeInt(-1_000_000, 1_000_000);
        String canonical = Integer.toString(n);
        String suffixed = canonical + (data.consumeBoolean() ? "L" : "l");

        try {
            /*
             * Contract/oracle:
             * For a canonical decimal integer string, createNumber("<n>L") and createLong("<n>")
             * denote the same numeric quantity through two independent real library paths.
             * A throw-deleting or overfitted patch that skips or mangles the 'L' handling would
             * break this equality while no exception is thrown.
             */
            Number viaCreateNumber = NumberUtils.createNumber(suffixed);
            Long viaCreateLong = NumberUtils.createLong(canonical);
            if (viaCreateNumber == null || viaCreateLong == null) {
                return;
            }
            if (viaCreateNumber.longValue() != viaCreateLong.longValue()) {
                throw new RuntimeException(
                    "[oracle:long-suffix] metamorphic violation: createNumber/createLong disagree input="
                        + suffixed + " lhs=" + viaCreateNumber + " rhs=" + viaCreateLong);
            }
        } catch (IllegalArgumentException skip) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) && isAnchorLikeRootCauseInput(suffixed)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            /*
             * Equivalent-input relation on real APIs:
             * For canonical decimal integers in range, the represented value of "<n>L" must equal
             * the represented value of "<n>" even though the chosen wrapper type may differ.
             */
            Number lhs = NumberUtils.createNumber(suffixed);
            Number rhs = NumberUtils.createNumber(canonical);
            if (lhs == null || rhs == null) {
                return;
            }
            if (lhs.longValue() != rhs.longValue()) {
                throw new RuntimeException(
                    "[oracle:same-value] metamorphic violation: suffixed and unsuffixed values disagree input="
                        + canonical + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (IllegalArgumentException skip) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) && isAnchorLikeRootCauseInput(suffixed)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean isExactAnchor(String s) {
        return "l".equals(s) || "L".equals(s) || "f".equals(s) || "F".equals(s) || "junk".equals(s) || "bobL".equals(s);
    }

    private static boolean isAnchorLikeRootCauseInput(String s) {
        return s != null && s.length() == 1 && (s.charAt(0) == 'l' || s.charAt(0) == 'L');
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] frames = t.getStackTrace();
        for (int i = 0; i < frames.length; i++) {
            String cls = frames[i].getClassName();
            String method = frames[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }
}
