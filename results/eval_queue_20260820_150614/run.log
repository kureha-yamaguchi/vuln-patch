            craftedLen3,
            slicedLen3,
            "oof",
            "yep",
            "tru",
            data.consumeBoolean() ? "abc" : "123"
        };

        for (int i = 0; i < candidates.length; i++) {
            String s = candidates[i];
            if (s == null) {
