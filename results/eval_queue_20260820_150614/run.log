    private static String readAll(Reader reader) throws IOException {
        StringBuffer out = new StringBuffer();
        char[] buf = new char[64];
        int n;
        while ((n = reader.read(buf)) != -1) {
            out.append(buf, 0, n);
        }
        return out.toString();
