package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = nonEmpty(data.consumeAsciiString(6), "P");
        String base = nonEmpty(data.consumeString(16), "foo");
        char pad = (char) (data.consumeByte() & 0xff);

        int widthBase = 1 + Math.abs(data.consumeInt(1, 8));
        boolean useNullObject = data.consumeBoolean();

        String s1 = extendToLength(base, widthBase + 1);
        String s2 = extendToLength(base, widthBase + 2);
        String s3 = extendToLength(base, Math.max(widthBase + 4, 5));
        String s4 = extendToLength(base, Math.max(widthBase + 5, 6));

        runRevealHiddenTail(prefix, s1, widthBase, pad, useNullObject);
        runRevealHiddenTail(prefix, s2, widthBase, pad, !useNullObject);
        runRevealHiddenTail(prefix, s3, widthBase, pad, useNullObject);
        runRevealHiddenTail(prefix, s4, widthBase, pad, !useNullObject);

        if (data.remainingBytes() > 0) {
            String extra = nonEmpty(data.consumeRemainingAsString(), "bar");
            int width2 = 1 + Math.abs(widthBase % 8);
            String s5 = extendToLength(extra, width2 + 1 + (extra.length() % 5));
            runRevealHiddenTail(prefix + "X", s5, width2, (char) (pad ^ 1), data.consumeBoolean());
        }
    }

    private static void runAnchor() {
        try {
            StrBuilder sb = new StrBuilder(1);
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (IllegalArgumentException ignored) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                return;
            }
        }
    }

    private static void runRevealHiddenTail(String prefix, String source, int width, char padChar, boolean useNullObject) {
        if (prefix == null || prefix.length() == 0 || source == null || source.length() <= width || width <= 0) {
            return;
        }

        int targetLen = prefix.length() + source.length();

        StrBuilder actual = new StrBuilder(targetLen);
        StrBuilder expected = new StrBuilder(targetLen);

        try {
            actual.ensureCapacity(targetLen);
            actual.append(prefix);
            if (useNullObject) {
                actual.setNullText(source);
                actual.appendFixedWidthPadRight((Object) null, width, padChar);
            } else {
                actual.appendFixedWidthPadRight((Object) source, width, padChar);
            }
        } catch (IllegalArgumentException ignored) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                return;
            }
            return;
        }

        try {
            expected.ensureCapacity(targetLen);
            expected.append(prefix);
            expected.append(source, 0, width);
        } catch (IllegalArgumentException ignored) {
            return;
        } catch (RuntimeException ignored) {
            return;
        }

        try {
            /*
             * Contract used:
             *   setLength "updates the length of the builder by either dropping the last characters
             *   or adding filler of unicode zero".
             * Therefore, after appendFixedWidthPadRight appends only a width-sized field and we then
             * extend the builder to prefix.length() + source.length(), the newly exposed suffix must
             * be unicode zero fillers, not stale hidden characters copied past size.
             * A throw-deleting or overfitted patch can leave visible output for the initial length
             * looking fine while corrupting buffer contents beyond size; setLength exposes that bug.
             */
            actual.setLength(targetLen);
            expected.setLength(targetLen);
        } catch (RuntimeException ignored) {
            return;
        }

        String actualString;
        String expectedString;
        try {
            actualString = actual.toString();
            expectedString = expected.toString();
        } catch (RuntimeException ignored) {
            return;
        }

        if (!expectedString.equals(actualString)) {
            throw new RuntimeException(
                "[oracle:setlength-fill] metamorphic violation: extending length should expose only unicode-zero filler after fixed-width append"
                    + " prefix=" + printable(prefix)
                    + " source=" + printable(source)
                    + " width=" + width
                    + " useNullObject=" + useNullObject
                    + " expected=" + printable(expectedString)
                    + " actual=" + printable(actualString));
        }

        if (actual.buffer.length < actual.length()) {
            throw new RuntimeException(
                "[oracle:capacity-bounds] metamorphic violation: internal capacity below reported length"
                    + " len=" + actual.length()
                    + " capacity=" + actual.buffer.length);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String nonEmpty(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static String extendToLength(String s, int minLen) {
        String base = nonEmpty(s, "x");
        StringBuilder out = new StringBuilder(base);
        while (out.length() < minLen) {
            out.append(base);
            if (out.length() < minLen) {
                out.append('Z');
            }
        }
        if (out.length() == 0) {
            out.append('x');
        }
        return out.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == 0) {
                sb.append("\\0");
            } else if (ch == '\n') {
                sb.append("\\n");
            } else if (ch == '\r') {
                sb.append("\\r");
            } else if (ch == '\t') {
                sb.append("\\t");
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }
}
