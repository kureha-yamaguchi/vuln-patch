package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        TimeSeries anchor = new TimeSeries("S");
        try {
            anchor.add(new Day(19, 8, 2005), new Integer(1));
            anchor.add(new Day(31, 1, 2006), new Integer(1));
            int originalCount = anchor.getItemCount();
            RegularTimePeriod originalFirst = anchor.getDataItem(0).getPeriod();
            RegularTimePeriod originalLast = anchor.getDataItem(anchor.getItemCount() - 1).getPeriod();
            TimeSeries anchorCopy = anchor.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));

            /* Contract used for this oracle:
             * createCopy(start, end) returns a copy of the series limited to the requested inclusive period range.
             * For a range strictly inside a gap between two existing items, the copy must therefore be empty.
             * A throw-deleting or overfit patch that merely suppresses the old exception can still return a non-empty
             * or otherwise wrong copy, so we assert the observable contents here.
             */
            if (anchorCopy.getItemCount() != 0 || !anchorCopy.getItems().isEmpty()) {
                throw new RuntimeException("[oracle:anchor-gap-empty] metamorphic violation: gap-only range must produce empty copy itemCount="
                        + anchorCopy.getItemCount() + " itemsSize=" + anchorCopy.getItems().size());
            }
            if (anchor.getItemCount() != originalCount
                    || anchor.getDataItem(0).getPeriod().compareTo(originalFirst) != 0
                    || anchor.getDataItem(anchor.getItemCount() - 1).getPeriod().compareTo(originalLast) != 0) {
                throw new RuntimeException("[oracle:createCopy-nonmutating] metamorphic violation: createCopy modified original series");
            }

