private static void runNestedBracketCase(
            UnivariateRealFunction f,
            double expectedRoot,
            double min,
            double max,
            double initial,
            FuzzedDataProvider data) {

        if (f == null || !(min < max) || initial < min || initial > max) {
            return;
        }

        Double outer = solveValid(f, min, max, initial, expectedRoot, "outer");
        if (outer == null) {
            return;
        }

        double shrinkLeft;
        double shrinkRight;
        if (data != null && data.remainingBytes() >= 8) {
            shrinkLeft = scaledPositive(data.consumeInt(1, 4000), 1.0e-5, Math.max((expectedRoot - min) * 0.95, 1.0e-5));
            shrinkRight = scaledPositive(data.consumeInt(1, 4000), 1.0e-5, Math.max((max - expectedRoot) * 0.95, 1.0e-5));
        } else {
            shrinkLeft = Math.max((expectedRoot - min) * 0.5, 1.0e-5);
            shrinkRight = Math.max((max - expectedRoot) * 0.5, 1.0e-5);
        }

        double innerMin = expectedRoot - Math.min(shrinkLeft, Math.max(expectedRoot - min - 1.0e-12, 1.0e-8));
        double innerMax = expectedRoot + Math.min(shrinkRight, Math.max(max - expectedRoot - 1.0e-12, 1.0e-8));

        if (!(innerMin < expectedRoot) || !(expectedRoot < innerMax) || !(innerMin < innerMax)) {
            return;
        }

        double innerInitial = clamp(initial, innerMin, innerMax);
        Double inner = solveValid(f, innerMin, innerMax, innerInitial, expectedRoot, "inner");
        if (inner == null) {
            return;
        }

        BisectionSolver tolSolver = new BisectionSolver();
        double tol = tolSolver.getAbsoluteAccuracy() * 6.0 + 1.0e-12;

        /*
         * Contract/oracle:
         * Both calls solve the same real SinFunction root on two valid bracketing intervals where the
         * second interval is a strict sub-interval around that very same unique zero. A correct bisection
         * implementation must converge to the same root from either bracket within solver accuracy.
         * A band-aid patch that merely silences the original throw or special-cases the seed can still
         * make behavior differ when the bracket is tightened around the same root.
         */
        if (Math.abs(outer.doubleValue() - inner.doubleValue()) > tol) {
            throw new RuntimeException(
                    "[oracle:nested-bracket] metamorphic violation: tightening a valid bracket around the same SinFunction root changed the solution"
                            + " expectedRoot=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " innerMin=" + innerMin
                            + " innerMax=" + innerMax
                            + " innerInitial=" + innerInitial
                            + " outer=" + outer
                            + " inner=" + inner
                            + " tol=" + tol);
        }

        /*
         * Independent consistency check:
         * For the same successful call, the solver reports both a returned root and its cached result via
         * getResult(); these are two independently obtained views of the same quantity and must agree.
         * This catches a throw-deleting or shortcut patch that returns a value without preserving solver state.
         */
        BisectionSolver solver = new BisectionSolver();
        try {
            double returned = solver.solve(f, min, max, initial);
            double cached = solver.getResult();
            double cacheTol = Math.max(solver.getAbsoluteAccuracy(), 1.0e-12);
            if (Math.abs(returned - cached) > cacheTol) {
                throw new RuntimeException(
                        "[oracle:returned-cached] metamorphic violation: solver returned root differs from cached getResult()"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " returned=" + returned
                                + " cached=" + cached
                                + " tol=" + cacheTol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:nested-bracket] metamorphic violation: valid solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " expectedRoot=" + expectedRoot,
                        t);
            }
        }
    }
