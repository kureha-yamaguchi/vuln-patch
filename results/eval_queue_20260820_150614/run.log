package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testInput("off", true);

        String exploredCore = buildThreeCharNonYesAscii(data);
        testInput(exploredCore, true);

        String fromBytes = data.consumeAsciiString(3);
        if (fromBytes.length() == 3 && fromBytes.charAt(0) != 'y' && fromBytes.charAt(0) != 'Y') {
            testInput(fromBytes, true);
        } else {
            testInput(fromBytes, false);
        }

        String knownFalse = buildKnownFalseThreeChar(data);
        testInput(knownFalse, true);

        String knownTrue = buildKnownTrueToken(data);
        try {
            boolean actual = BooleanUtils.toBoolean(knownTrue);
            if (!actual) {
                throw new RuntimeException("[oracle:known-true] metamorphic violation: constructed documented true token must parse as true input=" + repr(knownTrue) + " lhs=" + actual + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String mixedCaseTrue = randomizeCase(data, knownTrue);
        try {
            boolean lhs = BooleanUtils.toBoolean(knownTrue);
            boolean rhs = BooleanUtils.toBoolean(mixedCaseTrue);
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:case-agree] metamorphic violation: case-insensitive documented tokens must agree input=" + repr(knownTrue) + " lhs=" + lhs + " rhsInput=" + repr(mixedCaseTrue) + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String maybeOther = data.consumeRemainingAsString();
        testInput(maybeOther, false);
    }

    private static void testInput(String s, boolean assertKnownFalseWhenApplicable) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            /* Contract asserted:
             * The public API examples/tests for BooleanUtils.toBoolean(String) specify that
             * invalid 3-char tokens such as "off", "oof", and "yep" return false.
             * A throw-deleting or branch-skipping patch that merely avoids the crash but returns
             * the wrong value would violate this observable result, so we assert false for
             * fuzz-generated inputs built to have the same valid shape.
             */
            if (assertKnownFalseWhenApplicable && s != null && s.length() == 3
                    && s.charAt(0) != 'y' && s.charAt(0) != 'Y'
                    && !equalsIgnoreAsciiCase(s, "yes")
                    && !equalsIgnoreAsciiCase(s, "on")
                    && !equalsIgnoreAsciiCase(s, "true")) {
                if (result) {
                    throw new RuntimeException("[oracle:false-3char] metamorphic violation: documented non-true token of length 3 should parse as false input=" + repr(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && s != null && s.length() == 3) {
                throw t;
            }
        }
    }

    private static String buildThreeCharNonYesAscii(FuzzedDataProvider data) {
        char c0 = (char) data.consumeInt(32, 126);
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = (char) data.consumeInt(32, 126);
        char c2 = (char) data.consumeInt(32, 126);
        return new String(new char[] { c0, c1, c2 });
    }

    private static String buildKnownFalseThreeChar(FuzzedDataProvider data) {
        String[] seeds = new String[] { "off", "oof", "yep", "tru", "abc", "zzz", "0no", "___" };
        String base = seeds[data.consumeInt(0, seeds.length - 1)];
        char[] chars = base.toCharArray();
        int mode = data.consumeInt(0, 3);
        if (mode == 1) {
            chars[1] = flipAsciiCase(chars[1]);
        } else if (mode == 2) {
            chars[2] = flipAsciiCase(chars[2]);
        } else if (mode == 3) {
            chars[1] = (char) data.consumeInt(32, 126);
            chars[2] = (char) data.consumeInt(32, 126);
        }
        if (chars[0] == 'y' || chars[0] == 'Y') {
            chars[0] = 'o';
        }
        String s = new String(chars);
        if (equalsIgnoreAsciiCase(s, "yes")) {
            s = "yep";
        }
        return s;
    }

    private static String buildKnownTrueToken(FuzzedDataProvider data) {
        String[] bases = new String[] { "true", "yes", "on" };
        return randomizeCase(data, bases[data.consumeInt(0, bases.length - 1)]);
    }

    private static String randomizeCase(FuzzedDataProvider data, String s) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static char flipAsciiCase(char c) {
        if (c >= 'a' && c <= 'z') {
            return (char) (c - ('a' - 'A'));
        }
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static boolean equalsIgnoreAsciiCase(String a, String b) {
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (ca == cb) {
                continue;
            }
            if (ca >= 'A' && ca <= 'Z') {
                ca = (char) (ca + ('a' - 'A'));
            }
            if (cb >= 'A' && cb <= 'Z') {
                cb = (char) (cb + ('a' - 'A'));
            }
            if (ca != cb) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String repr(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
