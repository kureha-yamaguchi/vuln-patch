    private static void runRealExplore(FuzzedDataProvider data) {
        int cols = data.consumeInt(1, 4);
        int rows = cols + data.consumeInt(1, 4);

        double[][] backing = new double[rows][cols];
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                backing[r][c] = data.consumeInt(-20, 20);
            }
        }

