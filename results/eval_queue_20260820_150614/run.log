    private static void runBoundaryFlipCase(UnivariateRealFunction f, FuzzedDataProvider data) {
        IntervalCase c = buildValidCase(data);
        double edgeFraction = (data.consumeInt(0, 1000) + 1) / 1002.0;
        double initial = c.min + (c.max - c.min) * edgeFraction;
