package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.ConvergenceException;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MathException;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorNormalDistribution();

        int initialInt = data.consumeInt(-1000, 1000);
        int lowerSlack = data.consumeInt(0, 8);
        int upperSlack = data.consumeInt(0, 8);
        int maxIterations = data.consumeInt(1, 16);

        double initial = initialInt;
        double root = initial + 1.0;
        double lowerBound = initial - 1.0 - lowerSlack;
        double upperBound = root + upperSlack;

        exerciseBracketEndpointRoot(initial, root, lowerBound, upperBound, maxIterations);
    }

    private static void anchorNormalDistribution() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            normal.inverseCumulativeProbability(0.9772498680518209d);
        } catch (Throwable t) {
            // Anchor the exact failing production path first, but do not use the already-covered
            // crash signature as the finding for this harness.
        }
    }

    private static void exerciseBracketEndpointRoot(double initial, double root,
                                                    double lowerBound, double upperBound,
                                                    int maxIterations) {
        PolynomialFunction f = new PolynomialFunction(new double[] { -root, 1.0d });

        try {
            double[] bracket = UnivariateRealSolverUtils.bracket(f, initial, lowerBound, upperBound, maxIterations);

            if (bracket == null || bracket.length != 2) {
                throw new RuntimeException("[oracle:endpoint-root-shape] metamorphic violation: bracket must return two endpoints initial="
                        + initial + " root=" + root);
            }

            double a = bracket[0];
            double b = bracket[1];

            // Contract/post-condition: bracket returns an interval bracketing a root. For the
            // linear polynomial x-root that we constructed, the returned interval must stay
            // within the requested bounds and support solving for the known root. A patch that
            // merely deletes/suppresses the throw but returns a wrong interval will fail this.
            if (a < lowerBound || b > upperBound || a > b) {
                throw new RuntimeException("[oracle:endpoint-root-bounds] metamorphic violation: invalid returned interval initial="
                        + initial + " lower=" + lowerBound + " upper=" + upperBound + " a=" + a + " b=" + b);
            }

            try {
                BrentSolver solver = new BrentSolver();
                double solved = solver.solve(f, a, b);
                if (Math.abs(solved - root) > 1.0e-8d) {
                    throw new RuntimeException("[oracle:endpoint-root-solve] metamorphic violation: solve(bracket(f)) must recover constructed root initial="
                            + initial + " root=" + root + " a=" + a + " b=" + b + " solved=" + solved);
                }
            } catch (Throwable ignored) {
                return;
            }

            try {
                double fb = f.value(b);
                if (Math.abs(fb) > 1.0e-12d) {
                    return;
                }
                double midpointValue = f.value((a + b) * 0.5d);
                double expectedMidpointValue = ((a + b) * 0.5d) - root;
                if (Math.abs(midpointValue - expectedMidpointValue) > 1.0e-12d) {
                    throw new RuntimeException("[oracle:linear-self-consistency] metamorphic violation: polynomial evaluation inconsistent root="
                            + root + " midpoint=" + ((a + b) * 0.5d)
                            + " value=" + midpointValue + " expected=" + expectedMidpointValue);
                }
            } catch (FunctionEvaluationException ignored) {
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromBracket(t)) {
                throw new RuntimeException("[oracle:endpoint-root-accept] metamorphic violation: valid root-on-endpoint bracketing input was rejected initial="
                        + initial + " root=" + root + " lower=" + lowerBound + " upper=" + upperBound
                        + " maxIterations=" + maxIterations, t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseFromBracket(Throwable t) {
        if (!(t instanceof ConvergenceException || t instanceof MathException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement e : stack) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.ConvergenceException".equals(cls)
                    && "<init>".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && ("buildMessage".equals(method) || "createIllegalArgumentException".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math.analysis.UnivariateRealFunction".equals(cls)
                    && "value".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
