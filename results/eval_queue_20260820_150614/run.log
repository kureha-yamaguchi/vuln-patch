package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorCalls();

        int len = data.consumeInt(1, 8);
        Object[] input = new Object[len];
        boolean insertedNull = false;

        int forcedNulls = data.consumeInt(1, Math.max(1, len));
        for (int i = 0; i < forcedNulls; i++) {
            int pos = data.consumeInt(0, len - 1);
            input[pos] = null;
            insertedNull = true;
        }

        for (int i = 0; i < len; i++) {
            if (input[i] == null && data.consumeBoolean()) {
                insertedNull = true;
                continue;
            }
            input[i] = makeRealObject(data);
        }

        if (!insertedNull) {
            input[data.consumeInt(0, len - 1)] = null;
            insertedNull = true;
        }

        Class<?>[] expected = new Class<?>[input.length];
        for (int i = 0; i < input.length; i++) {
            expected[i] = input[i] == null ? null : input[i].getClass();
        }

