    private static void runDuplicateConstraintOracle(FuzzedDataProvider data) {
        final int n = Math.max(2, Math.min(8, data.consumeInt(2, 8)));
        final int maxUlps = Math.max(1, Math.min(8, Math.abs(data.consumeInt())));
        final double epsilon = 1.0e-6;

        double[] objectiveCoeffs = new double[n];
        for (int i = 0; i < n; i++) {
            objectiveCoeffs[i] = data.consumeInt(-5, 5);
        }
        objectiveCoeffs[0] = 1.0;

        List<LinearConstraint> base = new ArrayList<LinearConstraint>();

        double[] sumRow = new double[n];
        for (int i = 0; i < n; i++) {
            sumRow[i] = 1.0 + data.consumeInt(0, 3);
        }
        base.add(new LinearConstraint(sumRow, Relationship.GEQ, 1.0 + data.consumeInt(0, 4)));

        for (int c = 0; c < n; c++) {
            double[] unit = new double[n];
            unit[c] = 1.0;
            base.add(new LinearConstraint(unit, Relationship.GEQ, 0.0));
        }

        double[] duplicate = new double[n];
        int focus = data.consumeInt(0, n - 1);
        duplicate[focus] = 1.0;
        if (data.consumeBoolean()) {
            duplicate[(focus + 1) % n] = 1.0;
        }
        double duplicateRhs = data.consumeBoolean() ? 0.0 : 1.0;
        base.add(new LinearConstraint(duplicate, Relationship.GEQ, duplicateRhs));

        List<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(base);
        duplicated.add(new LinearConstraint(duplicate.clone(), Relationship.GEQ, duplicateRhs));

        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0);

        PointValuePair a;
        PointValuePair b;
        try {
            a = solve(f, base, GoalType.MINIMIZE, true, epsilon, maxUlps);
            b = solve(f, duplicated, GoalType.MINIMIZE, true, epsilon, maxUlps);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (a == null || b == null) {
            return;
        }

        if (!validSolution(a, base, epsilon) || !validSolution(b, duplicated, epsilon)) {
            return;
        }

        double va = a.getValue();
        double vb = b.getValue();
        if (Double.isNaN(va) || Double.isNaN(vb) || Double.isInfinite(va) || Double.isInfinite(vb)) {
            return;
        }

        double tol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(va), Math.abs(vb)));
        if (Math.abs(va - vb) > tol) {
            throw new RuntimeException(
                "[oracle:dup-constraint] metamorphic violation: duplicating an existing constraint must not change the feasible region or optimum"
                    + " lhs=" + va + " rhs=" + vb + " n=" + n + " focus=" + focus);
        }

        double[] pa = a.getPoint();
        double[] pb = b.getPoint();
        if (pa != null && pb != null && pa.length == pb.length && pa.length > 0) {
            double maxDiff = 0.0;
            for (int i = 0; i < pa.length; i++) {
                maxDiff = Math.max(maxDiff, Math.abs(pa[i] - pb[i]));
            }
            if (maxDiff > 1.0e-5) {
                throw new RuntimeException(
                    "[oracle:dup-point] metamorphic violation: equivalent LPs should admit the same optimum point for this uniquely-shaped construction"
                        + " maxDiff=" + maxDiff + " len=" + pa.length);
            }
        }
    }

    private static double[] mkObjective(int len, FuzzedDataProvider data) {
        double[] coeffs = new double[len];
        coeffs[0] = 1.0;
        for (int i = 1; i < len; i++) {
            coeffs[i] = data.consumeInt(-2, 2);
        }
        return coeffs;
    }

    private static void trySolve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints,
                                 GoalType goalType, boolean restrictToNonNegative,
                                 double epsilon, int maxUlps) {
        try {
            PointValuePair p1 = solve(f, constraints, goalType, restrictToNonNegative, epsilon, maxUlps);
            PointValuePair p2 = solve(f, constraints, goalType, restrictToNonNegative, epsilon, maxUlps);
            if (p1 != null && p2 != null && validSolution(p1, constraints, epsilon) && validSolution(p2, constraints, epsilon)) {
                double v1 = p1.getValue();
                double v2 = p2.getValue();
                double tol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(v1), Math.abs(v2)));
                if (Math.abs(v1 - v2) > tol) {
                    throw new RuntimeException(
                        "[oracle:repeatable] metamorphic violation: repeated optimization of the same LP on fresh solvers should agree"
                            + " lhs=" + v1 + " rhs=" + v2);
                }
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static PointValuePair solve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints,
                                        GoalType goalType, boolean restrictToNonNegative,
                                        double epsilon, int maxUlps) throws MaxCountExceededException {
        SimplexSolver solver = new SimplexSolver(epsilon, maxUlps);
        return solver.optimize(f, constraints, goalType, restrictToNonNegative);
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return false;
        }
        String name = t.getClass().getName();
        if (name.contains("Invalid") || name.contains("NoFeasibleSolutionException")
                || name.contains("UnboundedSolutionException")) {
            return false;
        }
        if (!(t instanceof MaxCountExceededException) && !(t instanceof RuntimeException) && !(t instanceof Error)) {
            return false;
        }
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                return true;
            }
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getNumObjectiveFunctions".equals(method)
                        || "getHeight".equals(method)
                        || "getWidth".equals(method)
                        || "getEntry".equals(method)
                        || "getNumArtificialVariables".equals(method)
                        || "getArtificialVariableOffset".equals(method)
                        || "getBasicRow".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(method) || "equals".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.RealMatrix".equals(cls)
                    && ("getRowDimension".equals(method)
                        || "getColumnDimension".equals(method)
                        || "getEntry".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
