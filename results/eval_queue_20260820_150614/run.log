    private static void exercise(String s, boolean anchor) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            /*
             * Contract/oracle:
             * BooleanUtils.toBoolean(String) is a case-insensitive textual parser for its
             * recognized vocabulary ("true", "on", "yes"), and other strings parse as false.
             * Therefore changing only case must not change the result.
             * A throw-deleting or branch-skipping patch could avoid the crash but still violate
             * this observable case-insensitive behavior.
             */
            if (s != null) {
                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                            "[oracle:casefold-upper] metamorphic violation: case-only change must preserve result input="
                                + repr(s) + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                    if (isCleanRejection(t)) {
                        return;
                    }
                    if (isRootCauseInTarget(t) && isValidByConstruction(upperSafe(s))) {
                        throw t;
                    }
                }

                try {
                    String lower = s.toLowerCase();
                    boolean lowerResult = BooleanUtils.toBoolean(lower);
                    if (result != lowerResult) {
                        throw new RuntimeException(
                            "[oracle:casefold-lower] metamorphic violation: case-only change must preserve result input="
                                + repr(s) + " lhs=" + result + " rhs=" + lowerResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                    if (isCleanRejection(t)) {
                        return;
                    }
                    if (isRootCauseInTarget(t) && isValidByConstruction(lowerSafe(s))) {
                        throw t;
                    }
                }
            }

            /*
             * Contract/oracle:
             * From the BooleanUtils test contract for toBoolean(String), the only 3-character
             * token accepted as true is case-insensitive "yes"; other 3-character strings such
             * as "off", "oof", and "yep" must return false.
             */
            if (s != null && s.length() == 3 && !equalsIgnoreAsciiCase(s, "yes")) {
                if (result) {
                    throw new RuntimeException(
                        "[oracle:false-3char] metamorphic violation: non-yes 3-char token must parse as false input="
                            + repr(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInTarget(t) && (anchor || isValidByConstruction(s))) {
                throw t;
            }
        }
    }

    private static boolean isRootCauseInTarget(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                    && "toBoolean".equals(st[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(RuntimeException t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isValidByConstruction(String s) {
        return true;
    }

    private static boolean equalsIgnoreAsciiCase(String a, String b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (ca == cb) {
                continue;
            }
            if ('A' <= ca && ca <= 'Z') {
                ca = (char) (ca + ('a' - 'A'));
            }
            if ('A' <= cb && cb <= 'Z') {
                cb = (char) (cb + ('a' - 'A'));
            }
            if (ca != cb) {
                return false;
            }
        }
        return true;
    }

    private static String upperSafe(String s) {
        return s == null ? null : s.toUpperCase();
    }

    private static String lowerSafe(String s) {
        return s == null ? null : s.toLowerCase();
    }

    private static String repr(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
