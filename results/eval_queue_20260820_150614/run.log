            size2 = p2.getSize();
            bc1v = p1.getBarycenter();
            bc2v = p2.getBarycenter();
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseClassCast(e)) {
                throw e;
            }
            return;
