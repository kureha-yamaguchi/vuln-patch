package org.apache.commons.math.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runBigAnchor();
        runRealAnchor();

        int cols = data.consumeInt(1, 6);
        int extraRows = data.consumeInt(1, 6);
        int rows = cols + extraRows;

        BigDecimal[][] bigData = new BigDecimal[rows][cols];
        double[][] realData = new double[rows][cols];
        BigDecimal[] bigVec = new BigDecimal[cols];
        double[] realVec = new double[cols];

        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                int v = data.consumeInt(-1000, 1000);
                bigData[r][c] = BigDecimal.valueOf(v);
                realData[r][c] = v;
            }
        }
        for (int i = 0; i < cols; i++) {
            int v = data.consumeInt(-1000, 1000);
            bigVec[i] = BigDecimal.valueOf(v);
            realVec[i] = v;
        }

        runBigCase(bigData, bigVec, true);
        runRealCase(realData, realVec, true);
    }

    private static void runBigAnchor() {
        BigDecimal[][] m = new BigDecimal[][] {
            { BigDecimal.valueOf(1), BigDecimal.valueOf(2) },
            { BigDecimal.valueOf(3), BigDecimal.valueOf(4) },
            { BigDecimal.valueOf(5), BigDecimal.valueOf(6) }
        };
        BigDecimal[] v = new BigDecimal[] { BigDecimal.valueOf(1), BigDecimal.valueOf(1) };
        runBigCase(m, v, true);
    }

    private static void runRealAnchor() {
        double[][] m = new double[][] {
            { 1d, 2d },
            { 3d, 4d },
            { 5d, 6d }
        };
        double[] v = new double[] { 1d, 1d };
        runRealCase(m, v, true);
    }

    private static void runBigCase(BigDecimal[][] matrixData, BigDecimal[] vector, boolean validByConstruction) {
        try {
            BigMatrixImpl matrix = new BigMatrixImpl(matrixData, false);

            int beforeRows = matrix.getRowDimension();
            int beforeCols = matrix.getColumnDimension();

            BigDecimal[] operated = matrix.operate(vector);

            if (operated.length != beforeRows) {
                throw new RuntimeException("[oracle:big-length] metamorphic violation: operate result length must equal rowDimension inputRows="
                        + beforeRows + " resultLength=" + operated.length + " inputCols=" + beforeCols);
            }

            int afterRows = matrix.getRowDimension();
            int afterCols = matrix.getColumnDimension();
            if (beforeRows != afterRows || beforeCols != afterCols) {
                throw new RuntimeException("[oracle:big-readonly] metamorphic violation: operate is read-only but dimensions changed before=("
                        + beforeRows + "," + beforeCols + ") after=(" + afterRows + "," + afterCols + ")");
            }

            try {
                /*
                 * Contract used for this oracle:
                 * - BigMatrixImpl(BigDecimal[] v) creates the column matrix for v.
                 * - multiply(BigMatrixImpl) computes matrix multiplication.
                 * Therefore matrix.operate(v) and matrix.multiply(new BigMatrixImpl(v)) must describe
                 * the same matrix-vector product. A patch that merely suppresses the crash or truncates
                 * the output breaks this equality.
                 */
                BigMatrixImpl viaMultiply = matrix.multiply(new BigMatrixImpl(vector));
                if (viaMultiply.getRowDimension() != operated.length) {
                    throw new RuntimeException("[oracle:big-mul-shape] metamorphic violation: multiply/operate shape disagreement rows="
                            + viaMultiply.getRowDimension() + " operateLength=" + operated.length);
                }
                for (int r = 0; r < operated.length; r++) {
                    BigDecimal expected = viaMultiply.getEntry(r, 0);
                    BigDecimal actual = operated[r];
                    if (expected == null ? actual != null : expected.compareTo(actual) != 0) {
                        throw new RuntimeException("[oracle:big-mul-eq] metamorphic violation: operate(v) must equal multiply(column(v)) row="
                                + r + " lhs=" + actual + " rhs=" + expected);
                    }
                }
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    return;
                }
                throw e;
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (validByConstruction && isRootCauseAioobe(e)) {
                throw e;
            }
            if (isOracle(e)) {
                throw e;
            }
        } catch (Exception e) {
            return;
        }
    }

    private static void runRealCase(double[][] matrixData, double[] vector, boolean validByConstruction) {
        try {
            RealMatrixImpl matrix = new RealMatrixImpl(matrixData, false);

            int beforeRows = matrix.getRowDimension();
            int beforeCols = matrix.getColumnDimension();

            double[] operated = matrix.operate(vector);

            if (operated.length != beforeRows) {
                throw new RuntimeException("[oracle:real-length] metamorphic violation: operate result length must equal rowDimension inputRows="
                        + beforeRows + " resultLength=" + operated.length + " inputCols=" + beforeCols);
            }

            int afterRows = matrix.getRowDimension();
