            // - deleteFirst(String) removes the first matching string.
            // - indexOf(String, int) should therefore report that "three" is absent here.
            // - toCharArray() "represents the contents of the builder", so its length must equal length().
            // - A fresh StrBuilder built from sb.toString() has the same contents, so indexOf on both objects must agree.
            checkLengthConsistency(sb, "anchor-deleteFirst");
            checkFreshBuilderIndexAgreement(sb, "three", 0, "anchor-deleteFirst");

            int idx = sb.indexOf("three", 0);
            if (idx != -1) {
                throw new RuntimeException("[oracle:anchor-index] deleteFirst(\"three\") left stale searchable content: index=" + idx + " text=" + sb.toString());
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runAnchorDeleteAll() {
        try {
            StrBuilder sb = new StrBuilder("\n%BLAH%\nDo more stuff\neven more stuff\n%BLAH%\n");
            sb.deleteAll("\n%BLAH%");

