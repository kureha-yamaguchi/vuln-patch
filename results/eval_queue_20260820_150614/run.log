    private static void runExplore(FuzzedDataProvider data) {
        String s = data.consumeString(64);
        if (s == null || s.length() == 0) {
            s = "A";
        }

        char pad = (char) (data.consumeByte() & 0xff);

        // Valid-by-construction: width is positive and bounded, and we explicitly support both truncation and padding cases.
        int width;
        if (data.consumeBoolean()) {
            width = data.consumeInt(1, Math.max(1, s.length()));
        } else {
            width = data.consumeInt(1, Math.max(1, s.length() + 16));
        }

        // Root-cause-shaping: make initial capacity small so copying obj.toString() can exceed the buffer
        // when s.length() > width, which is the verified failing pattern.
        int capacityUpper = Math.max(0, Math.min(8, s.length() == 0 ? 0 : s.length() - 1));
        int initialCapacity = data.consumeInt(0, capacityUpper);

        StrBuilder actual = new StrBuilder(initialCapacity);
        String actualString;
        try {
            actual.appendFixedWidthPadRight(s, width, pad);
            actualString = actual.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // Independent construction using real library calls only.
        StrBuilder expected = new StrBuilder(initialCapacity);
        String expectedString;
        try {
            // Contract/post-condition: fixed-width right-pad either truncates to width or pads to width.
            // Equivalent library construction:
            //   truncate branch: append(str, 0, width)
            //   pad branch: append(str) followed by appendPadding(width - str.length(), pad)
            if (s.length() >= width) {
                expected.append(s, 0, width);
            } else {
                expected.append(s);
                expected.appendPadding(width - s.length(), pad);
