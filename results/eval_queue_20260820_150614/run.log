    private static void runFuzzedProblem(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 8);
        int duplicates = data.consumeInt(2, 4);
        int extra = data.consumeInt(1, 5);

        double[] objective = new double[vars];
        objective[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            objective[i] = bounded(data.consumeInt(-7, 7));
        }
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, bounded(data.consumeInt(-10, 10)));

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] pivotRow = new double[vars];
        pivotRow[0] = 1.0;
        for (int j = 1; j < vars; j++) {
            pivotRow[j] = bounded(data.consumeInt(0, 9));
        }
        double rhs = data.consumeInt(1, 20);

        for (int i = 0; i < duplicates; i++) {
            double[] coeffs = pivotRow.clone();
            int tweaks = data.consumeInt(0, Math.max(0, vars - 1));
            for (int t = 0; t < tweaks; t++) {
                int idx = data.consumeInt(1, vars - 1);
                coeffs[idx] += bounded(data.consumeInt(0, 2));
            }
            coeffs[0] = 1.0;
            constraints.add(new LinearConstraint(coeffs, Relationship.GEQ, rhs));
        }

        for (int i = 0; i < extra; i++) {
            double[] coeffs = new double[vars];
            coeffs[0] = data.consumeBoolean() ? 1.0 : 2.0;
            for (int j = 1; j < vars; j++) {
                coeffs[j] = bounded(data.consumeInt(-10, 10));
            }
            Relationship rel;
            int sel = data.consumeInt(0, 2);
            if (sel == 0) {
                rel = Relationship.GEQ;
            } else if (sel == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }
            double val = bounded(data.consumeInt(-20, 20));
            constraints.add(new LinearConstraint(coeffs, rel, val));
        }

        constraints.add(new LinearConstraint(unitVector(vars, 0), Relationship.GEQ, 0.0));
        if (vars > 1) {
            constraints.add(new LinearConstraint(unitVector(vars, 1), Relationship.GEQ, 0.0));
        }

        solveAndCheck(f, constraints, data.consumeBoolean());
    }

    private static void solveAndCheck(LinearObjectiveFunction f, List<LinearConstraint> constraints, boolean nonNegative) {
        SimplexSolver solver1 = new SimplexSolver(1.0e-6, 10);
        PointValuePair a = null;
        try {
            a = solver1.optimize(f, constraints, GoalType.MINIMIZE, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            throwUnchecked(t);
            return;
        }

        if (a == null) {
            return;
        }

        // Contract-based check: PointValuePair returned by optimize must describe a feasible solution
        // for the supplied constraints, and its objective value must equal the objective recomputed
        // from the returned point. A patch that only suppresses the iteration failure can still return
        // a stale or wrong point/value pair; this independent recomputation catches that.
        if (!validSolution(a, constraints, 1.0e-5)) {
            throw new RuntimeException("[oracle:feasible] metamorphic violation: returned point is not feasible");
        }
        double recomputed = f.getValue(a.getPoint());
        if (!Precision.equals(recomputed, a.getValue(), 1.0e-5)) {
            throw new RuntimeException("[oracle:objval] metamorphic violation: reported objective disagrees with recomputation lhs="
                    + a.getValue() + " rhs=" + recomputed);
        }

        List<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
        Collections.reverse(permuted);
        SimplexSolver solver2 = new SimplexSolver(1.0e-6, 10);
        PointValuePair b;
        try {
            b = solver2.optimize(f, permuted, GoalType.MINIMIZE, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (b == null) {
            return;
        }

        if (!validSolution(b, permuted, 1.0e-5)) {
            throw new RuntimeException("[oracle:feasible2] metamorphic violation: permuted constraints produced infeasible solution");
        }
        double recomputed2 = f.getValue(b.getPoint());
        if (!Precision.equals(recomputed2, b.getValue(), 1.0e-5)) {
            throw new RuntimeException("[oracle:objval2] metamorphic violation: permuted reported objective disagrees with recomputation lhs="
                    + b.getValue() + " rhs=" + recomputed2);
        }

        // Metamorphic relation: permuting the order of constraints does not change the linear program,
        // so any correct solver must return the same optimum value when both calls succeed.
        if (!Precision.equals(a.getValue(), b.getValue(), 1.0e-5)) {
            throw new RuntimeException("[oracle:permute] metamorphic violation: optimum changed after constraint permutation lhs="
                    + a.getValue() + " rhs=" + b.getValue());
        }
    }

    private static double[] unitVector(int vars, int index) {
        double[] v = new double[vars];
        v[index] = 1.0;
        return v;
    }

    private static double bounded(int x) {
        if (x > 1000000) {
            return 1000000.0;
        }
        if (x < -1000000) {
            return -1000000.0;
        }
        return (double) x;
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
            return true;
        }
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(c)
                    && ("getPivotRow".equals(m) || "doIteration".equals(m) || "doOptimize".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(c)
                    && ("getNumObjectiveFunctions".equals(m)
                    || "getHeight".equals(m)
                    || "getWidth".equals(m)
                    || "getEntry".equals(m)
                    || "getNumArtificialVariables".equals(m)
                    || "getArtificialVariableOffset".equals(m)
                    || "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(c)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(c)
                    || "org.apache.commons.math3.linear.BlockRealMatrix".equals(c)
                    || "org.apache.commons.math3.linear.AbstractRealMatrix".equals(c)) {
                if ("getRowDimension".equals(m) || "getColumnDimension".equals(m) || "getEntry".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof MathIllegalArgumentException
                || (t instanceof MathIllegalStateException && !(t instanceof MaxCountExceededException));
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
