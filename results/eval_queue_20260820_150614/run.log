package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.chrono.ISOChronology;
import org.joda.time.format.DateTimeFormat;
import org.joda.time.format.DateTimeFormatter;

public class FuzzHarness {
    private static final DateTimeZone LONDON = DateTimeZone.forID("Europe/London");
    private static final long TEST_TIME_NOW =
            (31L + 28L + 31L + 30L + 31L + 9L - 1L) * DateTimeConstants.MILLIS_PER_DAY;
    private static final DateTimeFormatter MD_FORMAT = DateTimeFormat.forPattern("'--'MM-dd");

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        DateTimeZone oldZone = DateTimeZone.getDefault();
        try {
            DateTimeUtils.setCurrentMillisFixed(TEST_TIME_NOW);
            DateTimeZone.setDefault(LONDON);

            runAnchorCases();

            runExplore(data);
        } finally {
            DateTimeZone.setDefault(oldZone);
            DateTimeUtils.setCurrentMillisSystem();
        }
    }

    private static void runAnchorCases() {
        tryRootCase(new ValidCase(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                DurationFieldType.months(),
                -1,
                "--01-29"));
        tryRootCase(new ValidCase(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                DurationFieldType.days(),
                1,
                "--03-01"));
    }

    private static void runExplore(FuzzedDataProvider data) {
        int variant = data.consumeInt(0, 7);

        ValidCase c;
        switch (variant) {
            case 0:
                c = buildParsedCase("--02-29", DurationFieldType.months(), 1, "--03-29", true);
                break;
            case 1:
                c = buildParsedCase("--02-29", DurationFieldType.months(), -1, "--01-29", true);
                break;
            case 2:
                c = buildParsedCase("--02-29", DurationFieldType.days(), 1, "--03-01", true);
                break;
            case 3:
                c = buildParsedCase("--02-29", DurationFieldType.days(), -1, "--02-28", true);
                break;
            case 4:
                c = buildParsedCase("--03-31", DurationFieldType.months(), -1, "--02-29", true);
                break;
            case 5:
                c = buildConstructedCase(2, 29, DurationFieldType.months(), 1, "--03-29");
                break;
            case 6:
                c = buildConstructedCase(2, 29, DurationFieldType.months(), -1, "--01-29");
                break;
            default:
                c = buildConstructedCase(3, 31, DurationFieldType.months(), -1, "--02-29");
                break;
        }

        if (c == null) {
            return;
        }

        tryRootCase(c);

        String canonical = c.base.toString();
        try {
            MonthDay parsed1 = MonthDay.parse(canonical);
            MonthDay parsed2 = MonthDay.parse(canonical, MD_FORMAT);
            if (!parsed1.equals(parsed2)) {
                throw new RuntimeException("[oracle:parse-agree] metamorphic violation: parse overloads disagree input="
                        + canonical + " lhs=" + parsed1 + " rhs=" + parsed2);
            }
        } catch (RuntimeException ex) {
            if (isOracle(ex)) {
                throw ex;
            }
        }
    }

    private static ValidCase buildParsedCase(String canonical, DurationFieldType fieldType, int amount,
                                             String expected, boolean requireSiblingAgreement) {
        try {
            MonthDay viaDefault = MonthDay.parse(canonical);
            if (requireSiblingAgreement) {
                MonthDay viaPattern = MonthDay.parse(canonical, MD_FORMAT);
                if (!viaDefault.equals(viaPattern)) {
                    throw new RuntimeException("[oracle:parse-agree] metamorphic violation: parse overloads disagree input="
                            + canonical + " lhs=" + viaDefault + " rhs=" + viaPattern);
                }
            }
            return new ValidCase(viaDefault, fieldType, amount, expected);
        } catch (RuntimeException ex) {
            if (isOracle(ex)) {
                throw ex;
            }
            return null;
        }
    }

    private static ValidCase buildConstructedCase(int month, int day, DurationFieldType fieldType, int amount,
                                                  String expected) {
        try {
            return new ValidCase(new MonthDay(month, day, ISOChronology.getInstanceUTC()), fieldType, amount, expected);
        } catch (RuntimeException ex) {
            return null;
        }
    }

    private static void tryRootCase(ValidCase c) {
        if (c == null) {
            return;
        }
        try {
            MonthDay result = c.base.withFieldAdded(c.fieldType, c.amount);

            /*
             * Contract/oracle:
             * These inputs are valid by construction and come from canonical month-day values whose expected
             * transformed canonical value is known a priori from the public API's documented add semantics
             * (the same semantics exercised by the failing tests). A throw-deleting patch or a silent clamp
             * would still return a MonthDay, but its observable ISO string would differ from the required one.
             */
            String actual = result.toString();
            if (!c.expectedCanonical.equals(actual)) {
                throw new RuntimeException("[oracle:canonical-op] metamorphic violation: input="
                        + c.base + " field=" + c.fieldType + " amount=" + c.amount
                        + " expected=" + c.expectedCanonical + " actual=" + actual);
            }

            try {
                MonthDay reparsed = MonthDay.parse(actual, MD_FORMAT);
                if (!result.equals(reparsed)) {
                    throw new RuntimeException("[oracle:format-parse] metamorphic violation: input="
                            + c.base + " field=" + c.fieldType + " amount=" + c.amount
                            + " result=" + result + " reparsed=" + reparsed);
                }
            } catch (RuntimeException ex) {
                if (isOracle(ex)) {
                    throw ex;
                }
            }
        } catch (RuntimeException ex) {
            if (isOracle(ex)) {
                throw ex;
            }
            if (c.validByConstruction && isGroundTruthLike(ex) && hasRelevantFrame(ex)) {
                throw ex;
            }
        }
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isGroundTruthLike(Throwable t) {
        String name = t.getClass().getName();
        return "org.joda.time.IllegalFieldValueException".equals(name)
                || name.endsWith("AssertionFailedError");
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
