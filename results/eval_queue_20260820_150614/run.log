            result = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:boundary-membership] metamorphic violation: valid solve(f,min,max,initial) for SinFunction threw NullPointerException"
                                + " min=" + min + " max=" + max + " initial=" + initial,
                        t);
            }
            return;
        }

        /*
         * Post-condition: Bisection maintains a bracketing interval and returns the midpoint of the final
         * bracket, so a correct result must remain within the original interval (up to solver accuracy).
         * A band-aid patch that avoids the crash by skipping the real solve path or returning a stale/default
         * value can violate this even when no exception is thrown.
         */
        double tol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;
        if (result < min - tol || result > max + tol) {
            throw new RuntimeException(
                    "[oracle:boundary-membership] metamorphic violation: result escaped bracketing interval"
                            + " min=" + min + " max=" + max + " initial=" + initial + " result=" + result
                            + " tol=" + tol);
        }

        double mirroredInitial = clampToInterval(min + max - initial, min, max);
        BisectionSolver solver2 = new BisectionSolver();
        final double mirroredResult;
        try {
            mirroredResult = solver2.solve(f, min, max, mirroredInitial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:edge-flip] metamorphic violation: mirrored valid solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min + " max=" + max + " initial=" + initial
