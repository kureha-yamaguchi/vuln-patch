package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        int rounds = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < rounds; i++) {
            String s;
            int strategy = data.consumeInt(0, 5);

            if (strategy == 0) {
                char[] chars = new char[3];
                for (int j = 0; j < 3; j++) {
                    chars[j] = (char) data.consumeByte();
                }
                s = new String(chars);
            } else if (strategy == 1) {
                String raw = data.consumeAsciiString(16);
                if (raw.length() < 3) {
                    raw = (raw + "off");
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else if (strategy == 2) {
                String raw = data.consumeString(16);
                if (raw.length() < 3) {
                    raw = raw + "xyz";
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else if (strategy == 3) {
                String[] literals = new String[] {
                    "off", "oof", "yep", "tru", "abc", "no!", "___", "000",
                    "tfx", "ofF", "YEP", "YES", "yes", "Tru", "tru", "yeS"
                };
                s = literals[data.consumeInt(0, literals.length - 1)];
            } else if (strategy == 4) {
                String raw = data.consumeRemainingAsString();
                if (raw.length() == 0) {
                    raw = "off";
                }
                while (raw.length() < 3) {
                    raw = raw + "x";
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else {
                char first;
                int mode = data.consumeInt(0, 4);
                if (mode == 0) {
                    first = 'o';
                } else if (mode == 1) {
                    first = 't';
                } else if (mode == 2) {
                    first = 'T';
                } else if (mode == 3) {
                    first = 'y';
                } else {
                    first = (char) ('a' + data.consumeInt(0, 25));
                }
                char second = (char) data.consumeByte();
                char third = (char) data.consumeByte();
                s = new String(new char[] { first, second, third });
            }

            exercise(s, false);
        }
    }

    private static void exercise(String s, boolean isAnchor) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            /*
             * Contract/oracle:
             * BooleanUtils.toBoolean(String) is a case-insensitive parser for the recognized
             * true tokens ("true", "on", "yes"); all other strings return false.
             * Therefore any 3-character string other than case-insensitive "yes" must parse
             * as false. A patch that merely avoids the crash but returns true would violate
             * this observable result.
             */
            if (isKnownFalseThreeCharToken(s) && result) {
                throw new RuntimeException(
                        "[oracle:three-char-false] metamorphic violation: non-yes 3-char token must parse as false input="
                                + repr(s) + " lhs=" + result + " rhs=false");
            }

            /*
             * Contract/oracle:
             * The parser is case-insensitive for its string vocabulary, so changing only the
             * case of a non-null string must not change the boolean result.
             * If either side throws, the relation does not apply and is skipped.
             */
            if (s != null) {
                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                                "[oracle:casefold-upper] metamorphic violation: case-insensitive agreement input="
                                        + repr(s) + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                }

                try {
                    String lower = s.toLowerCase();
                    boolean lowerResult = BooleanUtils.toBoolean(lower);
                    if (result != lowerResult) {
                        throw new RuntimeException(
                                "[oracle:casefold-lower] metamorphic violation: case-insensitive agreement input="
                                        + repr(s) + " lhs=" + result + " rhs=" + lowerResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                }
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInToBoolean(t) && (isAnchor || isValidByConstruction(s))) {
                throw t;
            }
        }
    }

    private static boolean isValidByConstruction(String s) {
        return s != null && s.length() == 3;
    }

    private static boolean isKnownFalseThreeCharToken(String s) {
        return s != null && s.length() == 3 && !equalsIgnoreAsciiCase(s, "yes");
    }

    private static boolean equalsIgnoreAsciiCase(String a, String b) {
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char x = a.charAt(i);
            char y = b.charAt(i);
            if (x == y) {
                continue;
            }
            if (toAsciiLower(x) != toAsciiLower(y)) {
                return false;
            }
        }
        return true;
    }

    private static char toAsciiLower(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char) (c - 'A' + 'a');
        }
        return c;
    }

    private static boolean isOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseInToBoolean(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                    && "toBoolean".equals(st[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\') {
                sb.append("\\\\");
            } else if (c == '"') {
                sb.append("\\\"");
            } else if (c == '\n') {
                sb.append("\\n");
            } else if (c == '\r') {
                sb.append("\\r");
            } else if (c == '\t') {
                sb.append("\\t");
            } else if (c < 32 || c > 126) {
                String hex = Integer.toHexString(c);
                sb.append("\\u");
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            } else {
                sb.append(c);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
