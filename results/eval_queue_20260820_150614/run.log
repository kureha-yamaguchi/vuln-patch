package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchorBadInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchorBadInputs.length; i++) {
            exercisePossiblyInvalid(anchorBadInputs[i]);
        }

        int mode = data.consumeInt(0, 4);

        if (mode == 0) {
            String suffixOnly = String.valueOf((char) "lLfFdD".charAt(data.consumeInt(0, 5)));
            exercisePossiblyInvalid(suffixOnly);

            String surrounding = data.consumeAsciiString(24);
            if (surrounding.length() == 0) {
                surrounding = "0";
            }
            String withSuffix = surrounding + suffixOnly;
            exercisePossiblyInvalid(withSuffix);

            String remaining = data.consumeRemainingAsString();
            if (remaining.length() > 0) {
                char last = remaining.charAt(remaining.length() - 1);
                if ("lLfFdD".indexOf(last) < 0) {
                    remaining = remaining + suffixOnly;
                }
                exercisePossiblyInvalid(remaining);
            }
            return;
        }

        if (mode == 1 || mode == 2) {
            int n = data.consumeInt(-1_000_000, 1_000_000);
            String hexDigits = Integer.toHexString(Math.abs(n));
            if (hexDigits.length() == 0) {
                hexDigits = "0";
            }

            String hex = (n < 0 ? "-0x" : "0x") + hexDigits;
            checkCreateNumberAgreesWithCreateInteger(hex);

            String hexUpper = (n < 0 ? "-0x" : "0x") + hexDigits.toUpperCase();
            checkEquivalentNumbers(hex, hexUpper);

            if (data.consumeBoolean()) {
                String padded = (n < 0 ? "-0x0" : "0x0") + hexDigits;
                checkCreateNumberAgreesWithCreateInteger(padded);
            }
            return;
        }

        if (mode == 3) {
            int whole = data.consumeInt(-1_000_000, 1_000_000);
            String base = Integer.toString(whole) + ".0";

            checkCreateNumberAgreesWithCreateFloat(base + "F", base);
            checkEquivalentNumbers(base + "F", base + "f");

            checkCreateNumberAgreesWithCreateDouble(base + "D", base);
            checkEquivalentNumbers(base + "D", base + "d");
            return;
        }

        String raw = data.consumeAsciiString(32);
        if (raw.length() == 0) {
            raw = "0";
        }
        if (data.consumeBoolean()) {
            raw = raw + (char) "lLfFdD".charAt(data.consumeInt(0, 5));
        }
        exercisePossiblyInvalid(raw);
    }

    private static void exercisePossiblyInvalid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            return;
        }
    }

    private static void checkCreateNumberAgreesWithCreateInteger(String hex) {
        try {
            Number fromCreateNumber = NumberUtils.createNumber(hex);
            Integer fromCreateInteger = NumberUtils.createInteger(hex);
            if (fromCreateNumber == null || fromCreateInteger == null) {
                return;
            }
            if (fromCreateNumber.intValue() != fromCreateInteger.intValue()) {
                throw new RuntimeException(
                    "[oracle:hex-int] metamorphic violation: createNumber(hex) must agree with createInteger(hex) input="
                        + hex + " lhs=" + fromCreateNumber + " rhs=" + fromCreateInteger);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkCreateNumberAgreesWithCreateFloat(String suffixed, String base) {
        try {
            Number fromCreateNumber = NumberUtils.createNumber(suffixed);
            Float fromCreateFloat = NumberUtils.createFloat(base);
            if (fromCreateNumber == null || fromCreateFloat == null) {
                return;
            }
            if (!(fromCreateNumber instanceof Float)) {
                throw new RuntimeException(
                    "[oracle:float-type] metamorphic violation: valid finite *F input should produce Float input="
                        + suffixed + " lhsType=" + fromCreateNumber.getClass().getName() + " lhs=" + fromCreateNumber
                        + " rhs=" + fromCreateFloat);
            }
            if (Float.floatToIntBits(fromCreateNumber.floatValue()) != Float.floatToIntBits(fromCreateFloat.floatValue())) {
                throw new RuntimeException(
                    "[oracle:float-eq] metamorphic violation: createNumber(*F) must agree with createFloat(base) input="
                        + suffixed + " lhs=" + fromCreateNumber + " rhs=" + fromCreateFloat);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkCreateNumberAgreesWithCreateDouble(String suffixed, String base) {
        try {
            Number fromCreateNumber = NumberUtils.createNumber(suffixed);
            Double fromCreateDouble = NumberUtils.createDouble(base);
            if (fromCreateNumber == null || fromCreateDouble == null) {
                return;
            }
            if (!(fromCreateNumber instanceof Double)) {
                throw new RuntimeException(
                    "[oracle:double-type] metamorphic violation: valid finite *D input should produce Double input="
                        + suffixed + " lhsType=" + fromCreateNumber.getClass().getName() + " lhs=" + fromCreateNumber
                        + " rhs=" + fromCreateDouble);
            }
            if (Double.doubleToLongBits(fromCreateNumber.doubleValue())
                != Double.doubleToLongBits(fromCreateDouble.doubleValue())) {
                throw new RuntimeException(
                    "[oracle:double-eq] metamorphic violation: createNumber(*D) must agree with createDouble(base) input="
                        + suffixed + " lhs=" + fromCreateNumber + " rhs=" + fromCreateDouble);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentNumbers(String a, String b) {
        try {
            Number lhs = NumberUtils.createNumber(a);
            Number rhs = NumberUtils.createNumber(b);
            if (lhs == null || rhs == null) {
                return;
            }
            if (!lhs.getClass().equals(rhs.getClass())
                || Double.doubleToLongBits(lhs.doubleValue()) != Double.doubleToLongBits(rhs.doubleValue())) {
                throw new RuntimeException(
                    "[oracle:eq-inputs] metamorphic violation: equivalent numeric spellings must parse equally a="
                        + a + " b=" + b + " lhsType=" + lhs.getClass().getName() + " lhs=" + lhs
                        + " rhsType=" + rhs.getClass().getName() + " rhs=" + rhs);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "charAt".equals(method)
                    || "substring".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
