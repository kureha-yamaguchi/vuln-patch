package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String fuzzValue = makeLongNonEmpty(data.consumeAsciiString(24));
        String fuzzNullText = makeLongNonEmpty(data.consumeString(24));
        String prefix = data.consumeAsciiString(8);
        char pad = (char) (data.consumeByte() & 0xff);
        int width = data.consumeInt(1, 4);
        int initialCapacity = data.consumeInt(0, prefix.length());

        exerciseNonNullPath(prefix, fuzzValue, width, pad, initialCapacity);
        exerciseNullTextPath(prefix, fuzzNullText, width, pad, initialCapacity);
    }

    private static void runAnchor() {
        try {
            StrBuilder sb = new StrBuilder(1);
            sb.appendFixedWidthPadRight("foo", 1, '-');

            String out = sb.toString();
            if (!"f".equals(out)) {
                throw new RuntimeException("[oracle:anchor-post] appendFixedWidthPadRight must append the leftmost width characters when obj.toString().length() >= width; input=foo width=1 got=" + out);
            }

            crossCheckMaterializedState(sb, out);
        } catch (RuntimeException t) {
            if (isValidationException(t)) {
                return;
            }
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exerciseNonNullPath(String prefix, String value, int width, char pad, int initialCapacity) {
        boolean validByConstruction = value != null && value.length() >= 6 && width > 0 && width <= 4 && value.length() >= width;
        if (!validByConstruction) {
            return;
        }

        String lhs = null;
        String rhs = null;

        try {
            StrBuilder target = new StrBuilder(initialCapacity);
            target.append(prefix);
            target.appendFixedWidthPadRight(value, width, pad);
            lhs = target.toString();
            crossCheckMaterializedState(target, lhs);
        } catch (RuntimeException t) {
            if (isValidationException(t)) {
                return;
            }
            if (isOracleFailure(t) || (validByConstruction && isRootCause(t))) {
                throw t;
            }
            return;
        }

        try {
            StrBuilder ref = new StrBuilder(initialCapacity);
            ref.append(prefix);
            ref.append(value, 0, width);
            rhs = ref.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:prefix-eq] equivalent real-library constructions disagree input=" + value + " prefix=" + prefix + " width=" + width + " pad=" + (int) pad + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void exerciseNullTextPath(String prefix, String nullText, int width, char pad, int initialCapacity) {
        boolean validByConstruction = nullText != null && nullText.length() >= 6 && width > 0 && width <= 4 && nullText.length() >= width;
        if (!validByConstruction) {
            return;
        }

        String lhs = null;
        String rhs = null;

        try {
            StrBuilder target = new StrBuilder(initialCapacity);
            target.setNullText(nullText);
            target.append(prefix);
            target.appendFixedWidthPadRight(null, width, pad);
            lhs = target.toString();
            crossCheckMaterializedState(target, lhs);
        } catch (RuntimeException t) {
            if (isValidationException(t)) {
                return;
            }
            if (isOracleFailure(t) || (validByConstruction && isRootCause(t))) {
                throw t;
            }
            return;
        }

        try {
            StrBuilder ref = new StrBuilder(initialCapacity);
            ref.setNullText(nullText);
            ref.append(prefix);
            ref.append(nullText, 0, width);
            rhs = ref.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:nulltext-prefix-eq] appendFixedWidthPadRight(null,...) must use getNullText() and append its leftmost width characters when nullText is longer than width input=" + nullText + " prefix=" + prefix + " width=" + width + " pad=" + (int) pad + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void crossCheckMaterializedState(StrBuilder sb, String visible) {
        try {
            char[] a = sb.toCharArray();
            char[] b = sb.getChars(null);
            String sa = new String(a);
            String sbString = new String(b);

            if (!visible.equals(sa) || !visible.equals(sbString) || a.length != b.length || a.length != visible.length()) {
                throw new RuntimeException("[oracle:chars-agree] builder materializations disagree visible=" + visible + " toCharArray=" + sa + " getChars=" + sbString + " lens=" + visible.length() + "/" + a.length + "/" + b.length);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationException(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                    || "ensureCapacity".equals(method)
                    || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String makeLongNonEmpty(String s) {
        if (s == null) {
            s = "";
        }
        if (s.length() >= 6) {
            return s;
        }
        String seed = s + "ABCDEFGH";
        return seed.substring(0, 6);
    }
}
