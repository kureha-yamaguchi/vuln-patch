package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkCreateNumber("1eE");

        String crafted = buildBugShape(data);
        checkCreateNumber(crafted);

        String crafted2 = buildBugShape(data);
        checkCreateNumber(crafted2);

        /*
         * Oracle:
         * For a canonical base-10 integer string in int range, createNumber(String) takes
         * the integer path (no decimal point, no exponent) and must therefore agree with
         * createInteger(String) on both type and value.
         */
        int v = data.consumeInt(-1_000_000, 1_000_000);
        String s = Integer.toString(v);
        try {
            Number n = NumberUtils.createNumber(s);
            Integer i = NumberUtils.createInteger(s);
            if (!(n instanceof Integer) || i == null || n.intValue() != i.intValue()) {
                throw new RuntimeException("[oracle:int-path] metamorphic violation: input=" + s + " lhs=" + n + " rhs=" + i);
            }
        } catch (RuntimeException ignored) {
            // Skip oracle on rejected inputs or unrelated failures; the bug-triggering calls above are uncaught.
        }
    }

    private static boolean checkCreateNumber(String val) {
        try {
            Object obj = NumberUtils.createNumber(val);
            return obj != null;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    private static String buildBugShape(FuzzedDataProvider data) {
        String left = nonEmptyDigits(data.consumeAsciiString(8));
        String right = data.consumeBoolean() ? "" : nonEmptyDigits(data.consumeAsciiString(8));
        int variant = data.consumeInt(0, 5);
        switch (variant) {
            case 0:
                return left + "eE";
            case 1:
                return left + "Ee";
            case 2:
                return left + "e" + right + "E";
            case 3:
                return left + "E" + right + "e";
            case 4:
                return (data.consumeBoolean() ? "-" : "") + left + "eE";
            default:
                return (data.consumeBoolean() ? "-" : "") + left + "E" + right + "e";
        }
    }

    private static String nonEmptyDigits(String in) {
        if (in == null || in.length() == 0) {
            return "1";
        }
