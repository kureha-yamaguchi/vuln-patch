package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.Region;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerBoundaryAttributeAnchor();

        int rounds = data.consumeInt(1, 8);
        for (int i = 0; i < rounds; i++) {
            double x = data.consumeInt(-100000, 100000) / 100.0;
            double y = data.consumeInt(-100000, 100000) / 100.0;
            Vector2D probe = new Vector2D(x, y);

            try {
                exerciseBooleanLeafBoundary(probe, data.consumeBoolean(), data.consumeBoolean());
            } catch (RuntimeException t) {
                if (isOurOracle(t) || isRootCause(t)) {
                    throw t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            } catch (Error t) {
                if (isOurOracle(t)) {
                    throw t;
                }
                return;
            }
        }
    }

    private static void triggerBoundaryAttributeAnchor() {
        try {
            BSPTree<Euclidean2D> badLeaf =
                    new BSPTree<Euclidean2D>(new BoundaryAttribute<Euclidean2D>(null, null, null));
            PolygonsSet polygons = new PolygonsSet(badLeaf);
            polygons.getSize();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                return;
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static void exerciseBooleanLeafBoundary(Vector2D probe, boolean readVerticesFirst, boolean repeatReads) {
        BSPTree<Euclidean2D> wholeTree = new BSPTree<Euclidean2D>(Boolean.TRUE);
        BSPTree<Euclidean2D> emptyTree = new BSPTree<Euclidean2D>(Boolean.FALSE);

        PolygonsSet whole = new PolygonsSet(wholeTree);
        PolygonsSet empty = new PolygonsSet(emptyTree);

        if (readVerticesFirst) {
            if (whole.getVertices().length != 0 || empty.getVertices().length != 0) {
                throw new RuntimeException("[oracle:vertices-empty] metamorphic violation: no-cut leaf regions must expose zero polygon loops");
            }
        }

        double wholeSize = whole.getSize();
        Vector2D wholeBary = (Vector2D) whole.getBarycenter();
        double emptySize = empty.getSize();
        Vector2D emptyBary = (Vector2D) empty.getBarycenter();

        if (repeatReads) {
            double wholeSize2 = whole.getSize();
            Vector2D wholeBary2 = (Vector2D) whole.getBarycenter();
            double emptySize2 = empty.getSize();
            Vector2D emptyBary2 = (Vector2D) empty.getBarycenter();
            if (different(wholeSize, wholeSize2) || different(emptySize, emptySize2)
                    || differentPoint(wholeBary, wholeBary2) || differentPoint(emptyBary, emptyBary2)) {
                throw new RuntimeException(
                        "[oracle:stable-readback] metamorphic violation: repeated non-mutating reads changed reported geometry");
            }
        }

        Region.Location wholeLoc = whole.checkPoint(probe);
        Region.Location emptyLoc = empty.checkPoint(probe);

        if (wholeLoc != Region.Location.INSIDE) {
            throw new RuntimeException(
                    "[oracle:whole-membership] metamorphic violation: Boolean.TRUE no-cut tree should represent whole space, point="
                            + probe + " location=" + wholeLoc);
        }
        if (emptyLoc != Region.Location.OUTSIDE) {
            throw new RuntimeException(
                    "[oracle:empty-membership] metamorphic violation: Boolean.FALSE no-cut tree should represent empty space, point="
                            + probe + " location=" + emptyLoc);
        }

        if (wholeLoc == emptyLoc) {
            throw new RuntimeException(
                    "[oracle:location-flip] metamorphic violation: flipping the leaf attribute from false to true must flip point classification, point="
                            + probe + " whole=" + wholeLoc + " empty=" + emptyLoc);
        }

