        BigMatrixImpl product = m.multiply(col);
        for (int r = 0; r < rows; r++) {
            BigDecimal lhs = out1[r];
            BigDecimal rhs = product.getEntry(r, 0);
            if (lhs.compareTo(rhs) != 0) {
                throw new RuntimeException("[oracle:big-colmatrix] metamorphic violation: operate(v)==multiply(column(v)) input=row=" +
                    r + " lhs=" + lhs + " rhs=" + rhs);
            }
