package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final Object NULL_TO_STRING = new Object() {
        @Override
        public String toString() {
            return null;
        }
    };

    private static final String[] EMPTY_ARRAY_LIST = {};
    private static final String[] NULL_ARRAY_LIST = { null };
    private static final Object[] NULL_TO_STRING_LIST = { NULL_TO_STRING };
    private static final String[] MIXED_ARRAY_LIST = { null, "", "foo" };
    private static final Object[] MIXED_TYPE_LIST = { "foo", Long.valueOf(2L) };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        int choice = data.consumeInt(0, 3);
        if (choice == 0) {
            exploreCharRange(data);
        } else if (choice == 1) {
            exploreStringRange(data);
        } else if (choice == 2) {
            exploreVarargs(data);
        } else {
            exploreTokenConsistency(data);
        }
    }

    private static void runAnchorChecks() {
        String nullArrayJoin = StringUtils.join((Object[]) null, '/');
        if (nullArrayJoin != null) {
            throw new RuntimeException("[oracle:anchor-null-array] metamorphic violation: join((Object[]) null, '/') must return null, got=" + nullArrayJoin);
        }

        String nullVarargsJoin = StringUtils.join((Object[]) null);
        if (nullVarargsJoin != null) {
            throw new RuntimeException("[oracle:anchor-null-varargs] metamorphic violation: join((Object[]) null) must return null, got=" + nullVarargsJoin);
        }

        String emptyVarargsJoin = StringUtils.join();
        if (!"".equals(emptyVarargsJoin)) {
            throw new RuntimeException("[oracle:anchor-empty-varargs] metamorphic violation: join() must return empty string, got=" + emptyVarargsJoin);
        }

        String objectNullJoin = StringUtils.join((Object) null);
        if (!"".equals(objectNullJoin)) {
            throw new RuntimeException("[oracle:anchor-object-null] metamorphic violation: join((Object) null) must return empty string, got=" + objectNullJoin);
        }

        try {
            String anchored = StringUtils.join(NULL_TO_STRING_LIST, '/', 0, 1);
            if (!"null".equals(anchored)) {
                throw new RuntimeException("[oracle:anchor-null-token-char] metamorphic violation: exact trigger input must render as \"null\", got=" + anchored);
            }
            if (!"null".equals(StringUtils.left(anchored, 4))) {
                throw new RuntimeException("[oracle:anchor-prefix-char] metamorphic violation: first token must be \"null\", got=" + anchored);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromJoin(t)) {
                throw new RuntimeException("[oracle:anchor-null-token-char] metamorphic violation: valid input {obj with toString()==null} must render as \"null\" for join(array,'/',0,1)", t);
            }
        }

        try {
            String anchored = StringUtils.join(NULL_TO_STRING_LIST);
            if (!"null".equals(anchored)) {
                throw new RuntimeException("[oracle:anchor-null-token-varargs] metamorphic violation: exact varargs trigger must render as \"null\", got=" + anchored);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromJoin(t)) {
                throw new RuntimeException("[oracle:anchor-null-token-varargs] metamorphic violation: valid input {obj with toString()==null} must render as \"null\" for join(array)", t);
            }
        }

        // Shared EMPTY state agreement: these APIs document returning the empty String for these inputs.
        String empty1 = StringUtils.join(MIXED_TYPE_LIST, "/", 2, 1);
        String empty2 = StringUtils.trimToEmpty(null);
        String empty3 = StringUtils.stripToEmpty(null);
        String empty4 = StringUtils.left("abc", -1);
        String empty5 = StringUtils.substring("", 1);
        if (!(empty1.equals(empty2) && empty2.equals(empty3) && empty3.equals(empty4) && empty4.equals(empty5))) {
            throw new RuntimeException("[oracle:empty-shared-state] metamorphic violation: StringUtils empty-returning APIs disagree: "
                    + empty1 + "|" + empty2 + "|" + empty3 + "|" + empty4 + "|" + empty5);
        }

        // Preserve known-good fixtures from the original tests.
        checkExpectedNoThrow(StringUtils.join(EMPTY_ARRAY_LIST), "", "anchor-empty-array");
        checkExpectedNoThrow(StringUtils.join(NULL_ARRAY_LIST), "", "anchor-null-array-single");
        checkExpectedNoThrow(StringUtils.join(MIXED_ARRAY_LIST), "foo", "anchor-mixed-array");
        checkExpectedNoThrow(StringUtils.join(MIXED_TYPE_LIST), "foo2", "anchor-mixed-type");
    }

    private static void exploreCharRange(FuzzedDataProvider data) {
        char sep = (char) (data.consumeByte() & 0x7f);
        if (sep == 0) {
            sep = '/';
        }

        Object[] array = buildArrayWithNullToStringAtStart(data, 1 + data.consumeInt(0, 4));
        int start = 0;
        int end = array.length;

        try {
            String joined = StringUtils.join(array, sep, start, end);
            checkFirstTokenContract(joined, String.valueOf(sep), "char-range");
            checkLengthConsistency(array, String.valueOf(sep), start, end, joined, "char-range-len");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromJoin(t)) {
                throw new RuntimeException("[oracle:char-range] metamorphic violation: valid range join must accept first element whose toString() returns null and render first token as \"null\"", t);
            }
        }
    }

    private static void exploreStringRange(FuzzedDataProvider data) {
        String sep = data.consumeAsciiString(3);
        if (sep.length() == 0) {
            sep = "/";
        }

        Object[] array = buildArrayWithNullToStringAtStart(data, 1 + data.consumeInt(0, 4));
        int start = 0;
