package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        runCase(f, 3.0, 3.2, 3.1, Math.PI, "anchor");

        int k = data.consumeInt(-1000, 1000);
        double expectedRoot = k * Math.PI;

        double leftWidth = scaledPositive(data.consumeInt(1, 100000), 1.0e-6, 1.0);
        double rightWidth = scaledPositive(data.consumeInt(1, 100000), 1.0e-6, 1.0);

        double min = expectedRoot - leftWidth;
        double max = expectedRoot + rightWidth;
        if (!(min < max)) {
            return;
        }

        int selector = data.consumeInt(0, 100000);
        double initial = min + (max - min) * (selector / 100000.0);
        if (initial < min) {
            initial = min;
        } else if (initial > max) {
            initial = max;
        }

        runCase(f, min, max, initial, expectedRoot, "explore");

        double mirroredInitial = min + max - initial;
        if (mirroredInitial < min) {
            mirroredInitial = min;
        } else if (mirroredInitial > max) {
            mirroredInitial = max;
        }
        runSiblingAgreementCase(f, min, max, initial, mirroredInitial, expectedRoot);
    }

    private static void runCase(
            UnivariateRealFunction f,
            double min,
            double max,
            double initial,
            double expectedRoot,
            String label) {

        if (f == null || Double.isNaN(min) || Double.isNaN(max) || Double.isNaN(initial)) {
            return;
        }
        if (!(min < max) || initial < min || initial > max) {
            return;
        }

        BisectionSolver solver = new BisectionSolver();
        final double withInitial;
        try {
            withInitial = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isOracleRuntime(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw (RuntimeException) t;
            }
            return;
        }

        double tol = Math.max(solver.getAbsoluteAccuracy(), 1.0e-12) * 8.0 + 1.0e-12;

        /*
         * Contract used for this post-condition:
         * a successful bisection solve stores the same solution as both the return value and getResult(),
         * and a successful solve on a valid bracketing interval around a constructed SinFunction root
         * must return that root within solver accuracy. A throw-deleting or shortcut patch can avoid the
         * original crash yet still fail to preserve solver state or return the wrong root.
         */
        double cached = solver.getResult();
        if (Math.abs(withInitial - cached) > tol) {
            throw new RuntimeException(
                    "[oracle:cached-result] metamorphic violation: solve(f,min,max,initial) disagreed with getResult()"
                            + " label=" + label
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " returned=" + withInitial
                            + " cached=" + cached
                            + " tol=" + tol);
        }

        if (withInitial < min - tol || withInitial > max + tol) {
            throw new RuntimeException(
                    "[oracle:interval-membership] metamorphic violation: returned root escaped the original bracketing interval"
                            + " label=" + label
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " result=" + withInitial
                            + " tol=" + tol);
        }

        if (Math.abs(withInitial - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:constructed-root] metamorphic violation: valid SinFunction bracket missed the constructed root"
                            + " label=" + label
                            + " expectedRoot=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " result=" + withInitial
                            + " tol=" + tol);
