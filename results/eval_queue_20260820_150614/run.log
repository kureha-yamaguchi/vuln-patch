package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.io.Reader;
import java.io.IOException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int width = data.consumeInt(1, 16);
        int extra = data.consumeInt(1, 8);
        char padChar = (char) (data.consumeByte() & 0xff);

        String prefix = data.consumeAsciiString(16);
        String core = data.consumeString(32);
        if (core == null) {
            core = "";
        }

        StringBuilder sbObj = new StringBuilder(core);
        while (sbObj.length() <= width) {
            sbObj.append((char) ('A' + (sbObj.length() % 26)));
        }
        for (int i = 0; i < extra; i++) {
            sbObj.append((char) ('a' + (i % 26)));
        }
        String obj = sbObj.toString();

        int initialCapacity;
        if (data.consumeBoolean()) {
            initialCapacity = Math.max(1, prefix.length() + width);
        } else {
            initialCapacity = Math.max(1, prefix.length());
        }

        runScenario(prefix, obj, width, padChar, initialCapacity, data.consumeBoolean());
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String actual = sb.toString();
        if (!"f".equals(actual)) {
            throw new RuntimeException("[oracle:anchor] metamorphic violation: exact regression input should truncate to width 1 input=foo lhs=" + actual + " rhs=f");
        }

        checkStateConsistency(sb, "[oracle:anchor-state]");
    }

    private static void runScenario(String prefix, String obj, int width, char padChar, int initialCapacity, boolean minimizeBeforeCall) {
        StrBuilder actual = new StrBuilder(initialCapacity);
        try {
            actual.append(prefix);
            if (minimizeBeforeCall) {
                actual.minimizeCapacity();
            }
            actual.appendFixedWidthPadRight((Object) obj, width, padChar);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        StrBuilder expected = new StrBuilder(initialCapacity);
        try {
            expected.append(prefix);
            if (minimizeBeforeCall) {
                expected.minimizeCapacity();
            }
            /*
             * Contract used for this oracle:
             * appendFixedWidthPadRight(Object, width, padChar) appends either the
             * leftmost `width` chars of obj.toString() when the string is longer
             * than width, or the full string followed by padding when shorter.
             * We compute the same result using OTHER real StrBuilder APIs:
             * append(String, start, length) and appendPadding(...).
             * A patch that merely suppresses the crash or corrupts internal state
             * will disagree with this independently-constructed result.
             */
            if (obj.length() >= width) {
                expected.append(obj, 0, width);
            } else {
                expected.append(obj);
                expected.appendPadding(width - obj.length(), padChar);
            }
        } catch (RuntimeException t) {
            return;
        }

        String actualString;
        String expectedString;
        try {
            actualString = actual.toString();
            expectedString = expected.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (!expectedString.equals(actualString)) {
            throw new RuntimeException(
                "[oracle:fixed-width] metamorphic violation: appendFixedWidthPadRight disagrees with equivalent real-library construction"
                    + " prefix=" + quote(prefix)
                    + " obj=" + quote(obj)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " initialCapacity=" + initialCapacity
                    + " lhs=" + quote(actualString)
                    + " rhs=" + quote(expectedString));
        }

        checkStateConsistency(actual, "[oracle:state]");
    }

    private static void checkStateConsistency(StrBuilder sb, String oraclePrefix) {
        try {
            String s = sb.toString();
            int reportedLength = sb.length();
            int stringLength = s.length();
            int arrayLength = sb.toCharArray().length;
            if (reportedLength != stringLength || reportedLength != arrayLength) {
                throw new RuntimeException(
                    oraclePrefix + " consistency violation: length=" + reportedLength
                        + " toString.length=" + stringLength
                        + " toCharArray.length=" + arrayLength
                        + " value=" + quote(s));
            }
        } catch (RuntimeException t) {
            throw t;
        } catch (Throwable t) {
            return;
        }

        try {
            String s = sb.toString();
            String viaReader = readAll(sb.asReader());
            if (!s.equals(viaReader)) {
                throw new RuntimeException(
                    oraclePrefix + " consistency violation: reader disagrees with toString"
                        + " toString=" + quote(s)
                        + " reader=" + quote(viaReader));
            }
        } catch (RuntimeException t) {
            throw t;
        } catch (Throwable t) {
            return;
        }
    }

    private static String readAll(Reader reader) throws IOException {
        StringBuffer out = new StringBuffer();
        char[] buf = new char[64];
        int n;
        while ((n = reader.read(buf)) != -1) {
            out.append(buf, 0, n);
        }
        return out.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
