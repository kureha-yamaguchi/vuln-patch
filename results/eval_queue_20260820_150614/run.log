             * token accepted as true is case-insensitive "yes". Any other 3-character string
             * must parse as false. This catches throw-deleting/branch-skipping patches that
             * avoid the exception but silently return the wrong boolean.
             */
            if (s != null && s.length() == 3 && !equalsIgnoreAsciiCase(s, "yes")) {
                if (result) {
                    throw new RuntimeException(
                        "[oracle:false-3char] metamorphic violation: non-yes 3-char token must parse as false input="
                            + repr(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInToBoolean(t) && (anchor || isValidByConstruction(s))) {
