package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        Object[] fuzzArray = buildValidArray(data);
        try {
            Class<?>[] classes = ClassUtils.toClass(fuzzArray);

            /* Contract asserted from the public API and failing test:
             * - toClass(null) returns null.
             * - for a non-null Object[] input, the returned Class[] has the same length.
             * - each non-null element maps to its runtime class; null elements map to null.
             * A throw-deleting / branch-skipping patch would violate this by silently dropping or
             * miscomputing entries, so we check the observable result.
             *
             * Independent cross-check for non-null elements:
             *   ClassUtils.toClass(array)[i]
             * must agree with
             *   ClassUtils.getClass(array[i].getClass().getName())
             * which computes the same class through a different public API path in ClassUtils.
             */
            if (classes == null) {
                if (fuzzArray != null) {
                    throw new RuntimeException("[oracle:nonnull-nullout] metamorphic violation: non-null array produced null result");
                }
                return;
            }

            if (classes.length != fuzzArray.length) {
                throw new RuntimeException(
                        "[oracle:length] metamorphic violation: input length=" + fuzzArray.length
                                + " output length=" + classes.length);
            }

            for (int i = 0; i < fuzzArray.length; i++) {
                Object element = fuzzArray[i];
                Class<?> reported = classes[i];
                if (element == null) {
                    if (reported != null) {
                        throw new RuntimeException(
                                "[oracle:null-slot] metamorphic violation: null element at index " + i
                                        + " produced " + reported);
                    }
                } else {
                    Class<?> independent;
                    try {
                        independent = ClassUtils.getClass(element.getClass().getName());
                    } catch (ClassNotFoundException | LinkageError e) {
                        return;
                    } catch (RuntimeException e) {
                        return;
                    }
                    if (reported != independent) {
                        throw new RuntimeException(
                                "[oracle:class-agree] metamorphic violation: index=" + i
                                        + " elementType=" + element.getClass().getName()
                                        + " reported=" + reported
                                        + " independent=" + independent);
                    }
                }
            }

            trySingletonAgreement(fuzzArray, classes);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
        }
    }

    private static void runAnchor() {
        if (ClassUtils.toClass((Object[]) null) != null) {
            throw new RuntimeException("[oracle:null-array] metamorphic violation: toClass(null) must return null");
        }

        Class<?>[] empty = ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        if (empty != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("[oracle:empty-array] metamorphic violation: empty array should return EMPTY_CLASS_ARRAY");
        }

        try {
            Class<?>[] simple = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
            Class<?>[] expectedSimple = new Class[] { String.class, Integer.class, Double.class };
            if (!Arrays.equals(expectedSimple, simple)) {
                throw new RuntimeException(
                        "[oracle:anchor-simple] metamorphic violation: lhs=" + Arrays.toString(simple)
                                + " rhs=" + Arrays.toString(expectedSimple));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
            return;
        }

        try {
            Class<?>[] withNull = ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });
            Class<?>[] expectedWithNull = new Class[] { String.class, null, Double.class };
            if (!Arrays.equals(expectedWithNull, withNull)) {
                throw new RuntimeException(
                        "[oracle:anchor-null] metamorphic violation: lhs=" + Arrays.toString(withNull)
                                + " rhs=" + Arrays.toString(expectedWithNull));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
        }
    }

    private static void trySingletonAgreement(Object[] fuzzArray, Class<?>[] classes) {
        for (int i = 0; i < fuzzArray.length; i++) {
            try {
                Class<?>[] singleton = ClassUtils.toClass(new Object[] { fuzzArray[i] });
                if (singleton == null || singleton.length != 1) {
                    throw new RuntimeException(
                            "[oracle:singleton-shape] metamorphic violation: singleton result invalid at index " + i);
                }
                if (singleton[0] != classes[i]) {
                    throw new RuntimeException(
                            "[oracle:singleton-agree] metamorphic violation: index=" + i
                                    + " wholeArray=" + classes[i]
                                    + " singleton=" + singleton[0]);
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw propagate(t);
                }
                return;
            }
        }
    }

    private static Object[] buildValidArray(FuzzedDataProvider data) {
        int len = data.consumeInt(0, 16);
        Object[] array = new Object[len];
        boolean forceNull = data.consumeBoolean();
        int nullIndex = len == 0 ? -1 : data.consumeInt(0, len - 1);

        for (int i = 0; i < len; i++) {
            if ((forceNull && i == nullIndex) || data.consumeInt(0, 5) == 0) {
                array[i] = null;
                continue;
            }
            switch (data.consumeInt(0, 8)) {
                case 0:
                    array[i] = data.consumeString(32);
                    break;
                case 1:
                    array[i] = Integer.valueOf(data.consumeInt(-1000, 1000));
                    break;
                case 2:
                    array[i] = Double.valueOf((double) data.consumeInt(-1000, 1000));
                    break;
                case 3:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 4:
                    array[i] = Long.valueOf((long) data.consumeInt(-1000, 1000));
                    break;
                case 5:
                    array[i] = data.consumeBytes(16);
                    break;
                case 6:
                    array[i] = new int[] { data.consumeInt(-10, 10), data.consumeInt(-10, 10) };
                    break;
                case 7:
                    array[i] = new Object[] { data.consumeAsciiString(8), Integer.valueOf(data.consumeInt(-10, 10)) };
                    break;
                default:
                    array[i] = new StringBuilder(data.consumeAsciiString(16));
                    break;
            }
        }
        return array;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && "toClass".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && "getClass".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException propagate(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
