package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        invokeCreateNumber("1234.5", true);

        String digits = Integer.toString(data.consumeInt(0, 1_000_000));
        if (digits.length() == 0) {
            digits = "0";
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String base = sign + digits;

        String expMarker = data.consumeBoolean() ? "e" : "E";
        String zeroExponent = data.consumeBoolean() ? "0" : "+0";

        Number plain = invokeCreateNumber(base, true);
        Number withZeroExp = invokeCreateNumber(base + expMarker + zeroExponent, true);
        if (plain != null && withZeroExp != null) {
            if (Double.compare(plain.doubleValue(), withZeroExp.doubleValue()) != 0) {
                throw new RuntimeException(
                    "[oracle:exp-zero-equiv] metamorphic violation: createNumber(n) must equal createNumber(n"
                        + expMarker + zeroExponent + ") for integer n"
                        + " input=" + base
                        + " lhs=" + plain
                        + " rhs=" + withZeroExp);
            }
        }

        String appendedZero = base + "0";
        Number withExpOne = invokeCreateNumber(base + expMarker + "1", true);
        Number timesTen = invokeCreateNumber(appendedZero, true);
        if (withExpOne != null && timesTen != null) {
            if (Double.compare(withExpOne.doubleValue(), timesTen.doubleValue()) != 0) {
                throw new RuntimeException(
                    "[oracle:exp-one-times-ten] metamorphic violation: createNumber(n"
                        + expMarker + "1) must equal createNumber(n0)"
                        + " input=" + base
                        + " lhs=" + withExpOne
                        + " rhs=" + timesTen);
            }
        }

        exerciseBoundaryVariants(data, base);
    }

    private static void exerciseBoundaryVariants(FuzzedDataProvider data, String base) {
        String junk = data.consumeAsciiString(3);
        String[] variants = new String[] {
            base + "e",
            base + "E",
            base + "e+",
            base + "E-",
            base + "e" + junk,
            base + "E" + junk,
            base + "e0",
            base + "E0",
            base + "e+0",
            base + "E-0"
        };

        for (int i = 0; i < variants.length; i++) {
            invokeCreateNumber(variants[i], isValidExponentForm(variants[i]));
        }
    }

    private static boolean isValidExponentForm(String s) {
        int e = Math.max(s.indexOf('e'), s.indexOf('E'));
        if (e < 0 || e == s.length() - 1) {
            return false;
        }
        int start = e + 1;
        if (start < s.length() && (s.charAt(start) == '+' || s.charAt(start) == '-')) {
            start++;
        }
        if (start >= s.length()) {
            return false;
        }
        for (int i = start; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }
        return true;
    }

    private static Number invokeCreateNumber(String s, boolean validByConstruction) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(frame.getClassName())) {
                String m = frame.getMethodName();
                if ("createNumber".equals(m)
                    || "createInteger".equals(m)
                    || "isAllZeros".equals(m)
                    || "isDigits".equals(m)
                    || "createLong".equals(m)
                    || "createBigInteger".equals(m)
                    || "createFloat".equals(m)
                    || "createDouble".equals(m)
                    || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }
}
