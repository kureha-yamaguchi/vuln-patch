    private static void checkTableauConsistency(SimplexTableau tableau, int constraintCount) {
        int rows = tableau.getHeight();
        int expectedRows = tableau.getNumObjectiveFunctions() + constraintCount;
        if (rows != expectedRows) {
            throw new RuntimeException("[oracle:tableau-height] metamorphic violation: height=" + rows + " expected=" + expectedRows);
        }

        int width = tableau.getWidth();
        int offset = tableau.getArtificialVariableOffset();
        if (tableau.getNumArtificialVariables() > 0) {
            if (offset < tableau.getNumObjectiveFunctions() || offset >= width) {
                throw new RuntimeException("[oracle:artificial-offset] metamorphic violation: offset=" + offset + " width=" + width);
            }
        }

        // Consistency check: a reported basic row must actually contain a unit entry in that column.
        for (int c = 0; c < width - 1; c++) {
            Integer basic = tableau.getBasicRow(c);
            if (basic != null) {
                if (basic.intValue() < 0 || basic.intValue() >= rows) {
                    throw new RuntimeException("[oracle:basic-row-range] metamorphic violation: basicRow=" + basic + " rows=" + rows);
                }
