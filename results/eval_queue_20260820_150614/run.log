package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        double targetRoot = 3.0 + (data.consumeInt(0, 2000) / 10000.0); // [3.0, 3.2]
        double halfWidth = 0.01 + (data.consumeInt(0, 400) / 10000.0);  // [0.01, 0.05]
        double min = targetRoot - halfWidth;
        double max = targetRoot + halfWidth;

        int initialMode = data.consumeInt(0, 4);
        double initial;
        if (initialMode == 0) {
            initial = min;
        } else if (initialMode == 1) {
            initial = max;
        } else if (initialMode == 2) {
            initial = targetRoot;
        } else if (initialMode == 3) {
            initial = min + (max - min) * 0.25;
        } else {
            initial = min + (max - min) * 0.75;
        }

        double staleRoot = 0.5 + (data.consumeInt(0, 1000) / 1000.0); // [0.5, 1.5], far from target interval
        double staleHalfWidth = 0.1 + (data.consumeInt(0, 200) / 1000.0); // [0.1, 0.3]
        double staleMin = staleRoot - staleHalfWidth;
        double staleMax = staleRoot + staleHalfWidth;

        runStateIndependenceCheck(targetRoot, min, max, initial, staleRoot, staleMin, staleMax);
    }

    private static void exerciseAnchor() {
        try {
            BisectionSolver solver = new BisectionSolver();
            solver.solve(new SinFunction(), 3.0, 3.2, 3.1);
        } catch (Throwable t) {
            // Exact regression trigger from the failing test. Execute it first to reach the patched line,
            // but do not report the already-known NullPointerException signature from this harness.
        }
    }

    private static void runStateIndependenceCheck(
            double targetRoot, double min, double max, double initial,
            double staleRoot, double staleMin, double staleMax) {
        PolynomialFunction stale = new PolynomialFunction(new double[] { -staleRoot, 1.0 });
        PolynomialFunction target = new PolynomialFunction(new double[] { -targetRoot, 1.0 });

        BisectionSolver primed = new BisectionSolver();
        try {
            double first = primed.solve(stale, staleMin, staleMax);

            try {
                double second = primed.solve(staleMin, staleMax);
                if (Math.abs(first - second) > primed.getAbsoluteAccuracy() * 4.0) {
                    throw new RuntimeException(
                            "[oracle:cached-result] metamorphic violation: repeated solve on stored function disagrees"
                                    + " staleRoot=" + staleRoot
                                    + " first=" + first
                                    + " second=" + second);
                }
            } catch (Throwable ignored) {
                return;
            }

            double result = primed.solve(target, min, max, initial);

            /*
             * Contract/oracle:
             * - The overload taking an explicit UnivariateRealFunction argument must solve for that function,
             *   independent of any earlier function stored in the solver.
             * - We build target as the linear polynomial x - targetRoot, so a correct implementation must return
             *   targetRoot (within solver accuracy) on [min, max], regardless of prior receiver state.
             * - solve(UnivariateRealFunction, ...) also calls setResult(...) before returning, so getResult()
             *   must match the returned value after a successful solve.
             *
             * A band-aid patch that merely suppresses the historical throw but still consults stale receiver state
             * will return a value near the interval edge instead of targetRoot, and this check still fires.
             */
            double tolerance = primed.getAbsoluteAccuracy() * 4.0;
            if (Math.abs(result - targetRoot) > tolerance) {
                throw new RuntimeException(
                        "[oracle:state-indep] metamorphic violation: explicit-function solve depended on prior solver state"
                                + " targetRoot=" + targetRoot
                                + " interval=[" + min + "," + max + "]"
                                + " initial=" + initial
                                + " staleRoot=" + staleRoot
                                + " result=" + result
                                + " tolerance=" + tolerance);
            }

            double cached = primed.getResult();
            if (Math.abs(cached - result) > tolerance) {
                throw new RuntimeException(
                        "[oracle:result-cache] metamorphic violation: returned root and cached solver result disagree"
                                + " targetRoot=" + targetRoot
                                + " returned=" + result
                                + " cached=" + cached
                                + " tolerance=" + tolerance);
            }

            double residual = target.value(result);
            if (Math.abs(residual) > tolerance) {
                throw new RuntimeException(
                        "[oracle:known-root] metamorphic violation: solver failed to recover the known root of x-c"
                                + " targetRoot=" + targetRoot
                                + " result=" + result
                                + " residual=" + residual
                                + " tolerance=" + tolerance);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (Throwable t) {
            return;
        }
    }
}
