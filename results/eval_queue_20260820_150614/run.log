package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression input from NormalDistributionTest.testMath280.
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0.0, 1.0);
            exerciseDistribution(normal, 0.9772498680518209, 2.0);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }

        // EXPLORE: build valid probabilities via the real CDF, so inverseCumulativeProbability
        // is obliged to accept them. The triggering property is that the requested probability
        // corresponds exactly to a root at/near a bracket endpoint (e.g. standardized integer z=2,
        // where the buggy code sees fb == 0 and mishandles the sign test).
        int meanInt = data.consumeInt(-20, 20);
        int sdTicks = data.consumeInt(1, 200);
        int z = data.consumeInt(1, 6);

        double mean = meanInt;
        double sd = sdTicks / 20.0;

        try {
            NormalDistributionImpl dist = new NormalDistributionImpl(mean, sd);

            double expectedX = mean + sd * z;
            double p = dist.cumulativeProbability(expectedX);
            exerciseDistribution(dist, p, expectedX);

            // Additional nearby valid cases: same construction, different exact standardized roots.
            int extraCases = data.consumeInt(0, 3);
            for (int i = 0; i < extraCases; i++) {
                int zi = data.consumeInt(1, 6);
                double xi = mean + sd * zi;
                double pi = dist.cumulativeProbability(xi);
                exerciseDistribution(dist, pi, xi);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void exerciseDistribution(NormalDistributionImpl dist, double p, double expectedX) throws MathException {
        double x = dist.inverseCumulativeProbability(p);

        // Post-condition / metamorphic check:
        // For probabilities produced by the same distribution's cumulativeProbability,
        // inverseCumulativeProbability must recover the original quantile.
        // A "fix" that merely suppresses the exception or bypasses the buggy branch but returns
        // the wrong value violates this round-trip guarantee.
        double tolX = 1.0e-9 * Math.max(1.0, Math.abs(expectedX));
        if (Math.abs(x - expectedX) > tolX) {
            throw new RuntimeException(
                "[oracle:normal-roundtrip-x] metamorphic violation: invCDF(CDF(x)) != x"
                    + " expected=" + expectedX + " actual=" + x + " p=" + p);
        }

        // Independent consistency check using the same real API from the opposite direction:
        // CDF(invCDF(p)) must recover p for valid 0<p<1.
        double p2 = dist.cumulativeProbability(x);
        double tolP = 1.0e-12;
        if (Math.abs(p2 - p) > tolP) {
            throw new RuntimeException(
                "[oracle:normal-roundtrip-p] metamorphic violation: CDF(invCDF(p)) != p"
                    + " p=" + p + " cdf(invCDF(p))=" + p2 + " x=" + x);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof IllegalArgumentException || c instanceof NumberFormatException) {
                return true;
            }
            String name = c.getClass().getName();
            if (name.contains("Invalid") || name.contains("IllegalArgument")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        boolean hasMathExceptionFamily = false;
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof MathException || c.getClass().getName().equals("org.apache.commons.math.MathException")) {
                hasMathExceptionFamily = true;
            }
            if (hasBracketFrame(c)) {
                return hasMathExceptionFamily;
            }
        }
        return false;
    }

    private static boolean hasBracketFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(ste.getClassName())
                    && "bracket".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
