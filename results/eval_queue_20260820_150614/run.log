            String formatted1 = emf.format(args);

            ExtendedMessageFormat reparsed = new ExtendedMessageFormat(reported, registry);
            String reported2 = reparsed.toPattern();
            String formatted2 = reparsed.format(args);

            if (!safeEquals(reported, reported2) || !safeEquals(formatted1, formatted2)) {
                throw new RuntimeException(
                        "[oracle:toPattern-stability] metamorphic violation: input=" + pattern
                                + " reported=" + reported
                                + " reparsed=" + reported2
                                + " formatted1=" + formatted1
                                + " formatted2=" + formatted2);
