package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.chrono.ISOChronology;

public class FuzzHarness {
    private static final DateTimeZone LONDON = DateTimeZone.forID("Europe/London");
    private static final long TEST_TIME_NOW =
            (31L + 28L + 31L + 30L + 31L + 9L - 1L) * DateTimeConstants.MILLIS_PER_DAY;

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        DateTimeZone originalZone = DateTimeZone.getDefault();
        DateTimeUtils.setCurrentMillisFixed(TEST_TIME_NOW);
        DateTimeZone.setDefault(LONDON);
        try {
            runAnchorCases();
            runExplore(data);
        } finally {
            DateTimeZone.setDefault(originalZone);
            DateTimeUtils.setCurrentMillisSystem();
        }
    }

    private static void runAnchorCases() {
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.months(), -1, "anchor-feb29-minus1m");
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.months(), 1, "anchor-feb29-plus1m");
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.months(), -1, "anchor-minusmonths-fromleap-direct");
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.months(), 1, "anchor-minusmonths-negfromleap-direct");
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.days(), 1, "anchor-feb29-plus1d");
        tryOneValidCase(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), DurationFieldType.days(), -1, "anchor-feb29-minus1d");
        tryOneValidCase(new MonthDay(3, 31, ISOChronology.getInstanceUTC()), DurationFieldType.months(), -1, "anchor-mar31-minus1m");
        tryOneValidCase(new MonthDay(3, 31, ISOChronology.getInstanceUTC()), DurationFieldType.months(), -1, "anchor-minusmonths-endofmonth-direct");

        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "plusMonths", 1, "anchor-wrapper-plusMonths");
        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "plusMonths", -1, "anchor-wrapper-plusMonths-neg");
        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "minusMonths", 1, "anchor-wrapper-minusMonths");
        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "minusMonths", -1, "anchor-wrapper-minusMonths-neg");
        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "plusDays", 1, "anchor-wrapper-plusDays");
        callWrapperAndCheck(new MonthDay(2, 29, ISOChronology.getInstanceUTC()), "minusDays", -1, "anchor-wrapper-minusDays-neg");
        callWrapperAndCheck(new MonthDay(3, 31, ISOChronology.getInstanceUTC()), "plusMonths", -1, "anchor-wrapper-mar31-plusMonths-neg");
        callWrapperAndCheck(new MonthDay(3, 31, ISOChronology.getInstanceUTC()), "minusMonths", 1, "anchor-wrapper-mar31-minusMonths");
    }

    private static void runExplore(FuzzedDataProvider data) {
        int month;
        int maxDay;
        switch (data.consumeInt(0, 5)) {
            case 0:
                month = 2;
                maxDay = 29;
                break;
            case 1:
                month = 3;
                maxDay = 31;
                break;
            case 2:
                month = 1;
                maxDay = 31;
                break;
            case 3:
                month = 4;
                maxDay = 30;
                break;
            case 4:
                month = 5;
                maxDay = 31;
                break;
            default:
                month = 12;
                maxDay = 31;
                break;
        }

        int lower = Math.max(1, maxDay - 3);
        int day = data.consumeInt(lower, maxDay);

        MonthDay md;
        try {
            md = new MonthDay(month, day, ISOChronology.getInstanceUTC());
        } catch (RuntimeException e) {
            return;
        }

        DurationFieldType fieldType = data.consumeBoolean() ? DurationFieldType.months() : DurationFieldType.days();

        int amount = data.consumeInt(-3, 3);
        if (amount == 0) {
            amount = data.consumeBoolean() ? 1 : -1;
        }

        tryOneValidCase(md, fieldType, amount, "explore-direct");

        if (fieldType == DurationFieldType.months()) {
            callWrapperAndCheck(md, amount >= 0 ? "plusMonths" : "minusMonths", Math.abs(amount), "explore-wrapper-months");
        } else {
            callWrapperAndCheck(md, amount >= 0 ? "plusDays" : "minusDays", Math.abs(amount), "explore-wrapper-days");
        }

        if (fieldType == DurationFieldType.months() && Math.abs(amount) == 1) {
            try {
                MonthDay viaWithFieldAdded = md.withFieldAdded(DurationFieldType.months(), amount);
                MonthDay viaWithMonth = md.withMonthOfYear(wrapMonth(md.getMonthOfYear(), amount));
                if (md.getDayOfMonth() <= 28) {
                    if (viaWithFieldAdded.getMonthOfYear() != viaWithMonth.getMonthOfYear()
                            || viaWithFieldAdded.getDayOfMonth() != viaWithMonth.getDayOfMonth()) {
                        throw new RuntimeException(
                                "[oracle:month-wrap-agree] metamorphic violation: safe day<=28 should make direct month replacement agree with month addition by one step"
                                        + " input=" + md
                                        + " amount=" + amount
                                        + " lhs=" + viaWithFieldAdded
                                        + " rhs=" + viaWithMonth);
                    }
                }
            } catch (RuntimeException ignored) {
            }
        }
    }

    private static void callWrapperAndCheck(MonthDay md, String op, int amount, String tag) {
        try {
            MonthDay actual;
            if ("plusMonths".equals(op)) {
                actual = md.plusMonths(amount);
                assertMatchesYearMonthDayModel(md, DurationFieldType.months(), amount, actual, tag);
            } else if ("minusMonths".equals(op)) {
                actual = md.minusMonths(amount);
                assertMatchesYearMonthDayModel(md, DurationFieldType.months(), -amount, actual, tag);
            } else if ("plusDays".equals(op)) {
                actual = md.plusDays(amount);
                assertMatchesYearMonthDayModel(md, DurationFieldType.days(), amount, actual, tag);
            } else if ("minusDays".equals(op)) {
                actual = md.minusDays(amount);
                assertMatchesYearMonthDayModel(md, DurationFieldType.days(), -amount, actual, tag);
            }
        } catch (IllegalArgumentException e) {
            throw new RuntimeException(
                    "[oracle:unexpected-rejection] metamorphic violation: valid leap-sensitive MonthDay arithmetic rejected"
                            + " tag=" + tag + " input=" + md + " op=" + op + " amount=" + amount, e);
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static void tryOneValidCase(MonthDay md, DurationFieldType fieldType, int amount, String tag) {
        try {
            MonthDay actual = md.withFieldAdded(fieldType, amount);
            assertMatchesYearMonthDayModel(md, fieldType, amount, actual, tag);
        } catch (IllegalArgumentException e) {
            throw new RuntimeException(
                    "[oracle:unexpected-rejection] metamorphic violation: withFieldAdded rejected a valid MonthDay boundary case"
                            + " tag=" + tag + " input=" + md + " field=" + fieldType + " amount=" + amount, e);
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static void assertMatchesYearMonthDayModel(
            MonthDay original, DurationFieldType fieldType, int amount, MonthDay actual, String tag) {
        YearMonthDay base = new YearMonthDay(2004, original.getMonthOfYear(), original.getDayOfMonth(), ISOChronology.getInstanceUTC());
        YearMonthDay expectedYmd;
        if (fieldType == DurationFieldType.months()) {
            expectedYmd = base.plusMonths(amount);
        } else if (fieldType == DurationFieldType.days()) {
            expectedYmd = base.plusDays(amount);
        } else {
            return;
        }

        int expectedMonth = expectedYmd.getMonthOfYear();
        int expectedDay = expectedYmd.getDayOfMonth();

        if (actual.getMonthOfYear() != expectedMonth || actual.getDayOfMonth() != expectedDay) {
            throw new RuntimeException(
                    "[oracle:yearmonthday-model] metamorphic violation: MonthDay boundary arithmetic must agree with the same month/day embedded in leap year 2004"
                            + " tag=" + tag
                            + " input=" + original
                            + " field=" + fieldType
                            + " amount=" + amount
                            + " actual=" + actual
                            + " expected=--"
                            + two(expectedMonth) + "-" + two(expectedDay));
        }

        // Contract used: the operation is non-mutating; wrapper methods return a new MonthDay and the original test object stays unchanged.
        if (original.getMonthOfYear() != base.getMonthOfYear() || original.getDayOfMonth() != base.getDayOfMonth()) {
            throw new RuntimeException(
                    "[oracle:immutability-extra] metamorphic violation: source MonthDay mutated"
                            + " tag=" + tag + " input=" + original + " field=" + fieldType + " amount=" + amount);
        }
    }

    private static boolean isOracleFailure(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static int wrapMonth(int month, int delta) {
        int zeroBased = month - 1;
        int wrapped = (zeroBased + delta) % 12;
        if (wrapped < 0) {
            wrapped += 12;
        }
        return wrapped + 1;
    }

    private static String two(int v) {
        return v < 10 ? "0" + v : String.valueOf(v);
    }
}
