package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);

        // ANCHOR: exact regression input from NormalDistributionTest.testMath280.
        try {
            double result = normal.inverseCumulativeProbability(0.9772498680518209d);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException("[oracle:anchor-value] metamorphic violation: inverseCumulativeProbability(cdf(2)) should be 2.0 input=0.9772498680518209 lhs=" + result + " rhs=2.0");
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                // Same underlying bug as the known crash, but surfaced through a contract oracle:
                // for valid p in [0,1], and specifically p = cdf(2), a correct inverse must not fail.
                throw new RuntimeException("[oracle:anchor-valid-input] metamorphic violation: valid probability from the real API was rejected for inverseCumulativeProbability input=0.9772498680518209 cause=" + t, t);
            }
        }

        // EXPLORE: flip the patched condition around the real boundary by constructing probabilities
        // exactly from the real CDF at positive x. For x > 0 the buggy bracket path can hit an endpoint root.
        int x = data.consumeInt(1, 8);
        if (data.consumeBoolean()) {
            x = 2;
        }

        double p;
        double q;
        try {
            p = normal.cumulativeProbability((double) x);
            q = normal.cumulativeProbability((double) (-x));
        } catch (Throwable t) {
            return;
        }

        // Fence to valid-by-construction probabilities only.
        if (!(p > 0.0d && p < 1.0d && q > 0.0d && q < 1.0d && q < p)) {
            return;
        }

        // Oracle 1 (outside the already-covered families):
        // For the standard normal, symmetry guarantees inverseCumulativeProbability(p)
        // == -inverseCumulativeProbability(1 - p); since q = cdf(-x) = 1 - cdf(x),
        // a correct implementation must satisfy inv(p) == -inv(q).
        try {
            double ip = normal.inverseCumulativeProbability(p);
            double iq = normal.inverseCumulativeProbability(q);
            if (Math.abs(ip + iq) > 1.0e-9d) {
                throw new RuntimeException("[oracle:symmetry] metamorphic violation: inv(cdf(x)) and inv(cdf(-x)) must be negatives x=" + x + " p=" + p + " q=" + q + " lhs=" + ip + " rhs=" + (-iq));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:symmetry-valid-input] metamorphic violation: valid symmetric probabilities from cumulativeProbability were rejected x=" + x + " p=" + p + " q=" + q + " cause=" + t, t);
            }
            return;
        }

        // Oracle 2: monotonicity around the exact boundary value produced by the real CDF.
        // A correct inverse CDF is non-decreasing, so for p- < p < p+ we must have inv(p-) <= inv(p) <= inv(p+).
        // This specifically exercises the exact endpoint case and its immediate neighbors.
        double pBelow = Math.nextAfter(p, 0.0d);
        double pAbove = Math.nextAfter(p, 1.0d);
        if (!(pBelow > 0.0d && pAbove < 1.0d && pBelow < p && p < pAbove)) {
            return;
        }

        try {
            double lo = normal.inverseCumulativeProbability(pBelow);
            double mid = normal.inverseCumulativeProbability(p);
            double hi = normal.inverseCumulativeProbability(pAbove);
            if (!(lo <= mid && mid <= hi)) {
                throw new RuntimeException("[oracle:monotonic-boundary] metamorphic violation: inverse CDF must be non-decreasing x=" + x + " pBelow=" + pBelow + " p=" + p + " pAbove=" + pAbove + " lhs=" + lo + "," + mid + "," + hi);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:monotonic-valid-input] metamorphic violation: valid boundary probability from cumulativeProbability was rejected x=" + x + " p=" + p + " pBelow=" + pBelow + " pAbove=" + pAbove + " cause=" + t, t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls) && "bracket".equals(m))
                    || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls) && "inverseCumulativeProbability".equals(m))
                    || ("org.apache.commons.math.ConvergenceException".equals(cls) && "<init>".equals(m))) {
                return true;
            }
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }
}
