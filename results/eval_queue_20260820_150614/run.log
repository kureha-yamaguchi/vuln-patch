    private static void triggerWithBoundaryAttribute(BSPTree<Euclidean2D> tree) {
        PolygonsSet polygon = new PolygonsSet(tree);

        double size1 = polygon.getSize();
        Vector2D bary1 = (Vector2D) polygon.getBarycenter();
        double size2 = polygon.getSize();
        Vector2D bary2 = (Vector2D) polygon.getBarycenter();

        if (size1 != size2 || bary1.getX() != bary2.getX() || bary1.getY() != bary2.getY()) {
