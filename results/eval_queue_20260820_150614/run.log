                            + String.valueOf(s) + " result=" + result);
                }

                String upper = s.toUpperCase();
                try {
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (upperResult) {
                        throw new RuntimeException("[oracle:booleanutils-3char-case] metamorphic violation: uppercasing a non-yes 3-char token must still parse as false input="
                                + String.valueOf(s) + " upper=" + String.valueOf(upper) + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException t) {
                    boolean inTarget = false;
                    for (StackTraceElement ste : t.getStackTrace()) {
                        if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                                && "toBoolean".equals(ste.getMethodName())) {
                            inTarget = true;
                            break;
                        }
                    }
                    if (t instanceof StringIndexOutOfBoundsException && inTarget) {
                        throw t;
                    }
                    if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                        return;
                    }
                }
            } catch (RuntimeException t) {
                boolean inTarget = false;
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                            && "toBoolean".equals(ste.getMethodName())) {
                        inTarget = true;
                        break;
