package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.HashMap;
import java.util.Map;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        // Anchor: exact failing-test pattern first, through the real public API.
        tryPattern("it''s a {0,lower} 'test'!", registry, false);

        String quoted1 = escapeQuotes(nonEmpty(data.consumeAsciiString(24)));
        String quoted2 = escapeQuotes(nonEmpty(data.consumeAsciiString(24)));
        String sep1 = sanitizeUnquoted(data.consumeAsciiString(12));
        String sep2 = sanitizeUnquoted(data.consumeAsciiString(12));

        String placeholder;
        switch (data.consumeInt(0, 2)) {
            case 0:
                placeholder = "{0}";
                break;
            case 1:
                placeholder = "{0,number}";
                break;
            default:
                placeholder = "{0,date}";
                break;
        }

        StringBuilder pattern = new StringBuilder();
        pattern.append('\'').append(quoted1).append('\'');
        pattern.append(sep1);
        pattern.append(placeholder);
        pattern.append(sep2);
        if (data.consumeBoolean()) {
            pattern.append('\'').append(quoted2).append('\'');
        }

        // Property-driven exploration: valid-by-construction patterns that begin with a quote.
        // This drives applyPattern -> appendQuotedString with escapingOn=true on many variants.
        tryPattern(pattern.toString(), registry, true);

        // Boundary variants around the patched condition: a leading quote and a leading doubled quote.
        String q = escapeQuotes(nonEmpty(data.consumeAsciiString(16)));
        tryPattern("'" + q + "'{0}", registry, true);
        tryPattern("''" + sanitizeUnquoted(data.consumeAsciiString(16)) + "{0}", registry, false);
    }

    private static void tryPattern(String pattern, Map registry, boolean runOracle) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            if (runOracle) {
                runMetamorphicChecks(emf, registry);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (Error) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            // Other throwables are outside this patch's scope or malformed-input fallout.
        }
    }

    private static void runMetamorphicChecks(ExtendedMessageFormat emf, Map registry) {
        try {
            String before = emf.toPattern();
            String out1 = emf.format(new Object[] { "DuMmY" });
            String after = emf.toPattern();

            // Contract used for this oracle:
            // formatting is observationally read-only with respect to the parsed pattern,
            // so toPattern() must not change across format().
            if (before == null ? after != null : !before.equals(after)) {
                throw new RuntimeException("[oracle:toPattern-stable] metamorphic violation: format changed toPattern input="
                        + safe(before) + " after=" + safe(after));
            }

            ExtendedMessageFormat reparsed = new ExtendedMessageFormat(before, registry);
            String before2 = reparsed.toPattern();
            String out2 = reparsed.format(new Object[] { "DuMmY" });

            // Round-trip oracle:
            // reparsing an object's own toPattern() should preserve both the pattern representation
            // and the formatted output for the same arguments.
            if ((before == null ? before2 != null : !before.equals(before2)) || (out1 == null ? out2 != null : !out1.equals(out2))) {
                throw new RuntimeException("[oracle:roundtrip] metamorphic violation: parse(toPattern()) changed behaviour input="
                        + safe(before) + " pattern2=" + safe(before2) + " lhs=" + safe(out1) + " rhs=" + safe(out2));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (Error) t;
            }
            // If either side throws, the oracle does not apply to this input.
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(cls)) {
                if ("appendQuotedString".equals(method) || "next".equals(method)) {
                    return true;
                }
            } else if ("org.apache.commons.lang.text.StrBuilder".equals(cls)) {
                if ("append".equals(method) || "startsWith".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                if (name.contains("Validate") || name.contains("Validation") || name.contains("Invalid")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String escapeQuotes(String s) {
        return s.replace("'", "''");
    }

    private static String sanitizeUnquoted(String s) {
        return s.replace("'", "x").replace("{", "x").replace("}", "x");
    }

    private static String nonEmpty(String s) {
        return s.length() == 0 ? "a" : s;
    }

    private static String safe(String s) {
        return s == null ? "null" : s;
    }
}
