    private static void tryCategoryPresentAndLegendConsistency(String label, double value, int index, Layer layer, boolean notify) {
        try {
            DefaultCategoryDataset dataset = new DefaultCategoryDataset();
            dataset.addValue(value, "S1", label);
            dataset.addValue(value + 1.0, "S2", label + "_b");

            CategoryPlot plot = new CategoryPlot(
                    dataset,
                    new CategoryAxis("Domain"),
                    new NumberAxis("Range"),
                    new LineAndShapeRenderer()
            );

            /*
             * Sound oracle:
             * LegendItemCollection.getItemCount() is the collection's reported size, and
             * LegendItemCollection.get(i) must succeed exactly for indices 0..count-1.
             * We recompute the same quantity by iterating with real get(i) calls and assert agreement.
             * This is independent of marker-removal return values and exercises LegendItemCollection.get.
             */
            int beforeLegend = checkedLegendCount(plot.getLegendItems());

            CategoryMarker domainMarker = new CategoryMarker(label + "_dm");
            ValueMarker rangeMarker = new ValueMarker(value + 2.0);
            plot.addDomainMarker(index, domainMarker, layer, false);
            plot.addRangeMarker(index, rangeMarker, layer, false);

            boolean removedDomain = plot.removeDomainMarker(index, domainMarker, layer, notify);
            boolean removedRange = plot.removeRangeMarker(index, rangeMarker, layer, notify);

            if (!removedDomain) {
                throw new RuntimeException("[oracle:cat-present-domain] present domain marker removal returned false");
            }
            if (!removedRange) {
                throw new RuntimeException("[oracle:cat-present-range] present range marker removal returned false");
            }

            Collection domainMarkers = plot.getDomainMarkers(index, layer);
            if (domainMarkers != null && domainMarkers.contains(domainMarker)) {
                throw new RuntimeException("[oracle:cat-domain-post] removed domain marker still present");
            }

            Collection rangeMarkers = plot.getRangeMarkers(index, layer);
            if (rangeMarkers != null && rangeMarkers.contains(rangeMarker)) {
                throw new RuntimeException("[oracle:cat-range-post] removed range marker still present");
            }

            int afterLegend = checkedLegendCount(plot.getLegendItems());
            if (beforeLegend != afterLegend) {
                throw new RuntimeException("[oracle:cat-legend-stable] legend item count changed across marker-only mutations: before=" + beforeLegend + " after=" + afterLegend);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

