            UnivariateRealSolverUtils.bracket(constant, 1.0d, 0.0d, 2.0d, 0);
        } catch (IllegalArgumentException e) {
            // Clean rejection.
        } catch (Throwable t) {
            // Out of scope.
        }

        // Reach MathRuntimeException.createIllegalArgumentException(String, double, double, double).
        try {
            PolynomialFunction constant = new PolynomialFunction(new double[]{1.0d});
            UnivariateRealSolverUtils.bracket(constant, -1.0d, 0.0d, 2.0d, 5);
        } catch (IllegalArgumentException e) {
