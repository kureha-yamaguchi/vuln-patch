        exercisePattern(pattern2, registry, true);

        String pattern3 = a + escapedQuotes.toString() + b + " '{0}' " + c + "{0}" + d;
        exercisePattern(pattern3, registry, true);
    }

    private static void exercisePattern(String pattern, Map registry, boolean runOracle) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            if (!runOracle) {
                return;
            }

            // Contract-based metamorphic check:
            // toPattern() is the object's exposed pattern representation. Re-parsing that exposed
            // pattern with the same registry into a fresh object must yield the same toPattern(),
            // and formatting with the same arguments must agree. A "fix" that merely skips the
            // patched bookkeeping/progress would violate this observable stability even if it no
            // longer crashes.
            String reported = emf.toPattern();
