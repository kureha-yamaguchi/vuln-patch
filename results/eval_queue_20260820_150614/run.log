package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction sin = new SinFunction();

        // ANCHOR: exact failing test input from BisectionSolverTest.testMath369.
        try {
            BisectionSolver solver = new BisectionSolver();
            double result = solver.solve(sin, 3.0, 3.2, 3.1);
            double tol = solver.getAbsoluteAccuracy() * 4.0 + 1.0e-12;
            if (Math.abs(result - Math.PI) > tol) {
                throw new RuntimeException(
                        "[oracle:anchor-root] metamorphic violation: exact regression seed missed the known SinFunction root"
                                + " min=3.0 max=3.2 initial=3.1 result=" + result + " expected=" + Math.PI + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:anchor-valid] metamorphic violation: valid solve(f,min,max,initial) for SinFunction threw from patched region"
                                + " min=3.0 max=3.2 initial=3.1",
                        t);
            }
            return;
        }

        // EXPLORE: vary the same valid shape around the seed:
        // a SinFunction bracket around a known root, with initial guesses near either boundary.
        int k = data.consumeInt(-8, 8);
        double root = Math.PI + (2.0 * Math.PI * k);

        double leftSpan = scaled(data.consumeInt(1, 5000), 1.0e-4, 0.35);
        double rightSpan = scaled(data.consumeInt(1, 5000), 1.0e-4, 0.35);

        double min = root - leftSpan;
        double max = root + rightSpan;
        if (!(min < root && root < max)) {
            return;
        }

        double edgeBias = scaled(data.consumeInt(0, 1000), 0.0, 1.0);
        double initial;
        if (data.consumeBoolean()) {
            initial = min + edgeBias * Math.min(1.0e-6 + (max - min) * 0.02, max - min);
        } else {
            initial = max - edgeBias * Math.min(1.0e-6 + (max - min) * 0.02, max - min);
        }
        initial = clamp(initial, min, max);

        runStateIndependenceCase(sin, min, max, initial, root);

        // Extra variation: shift by another whole period while keeping the same property.
        int extraPeriods = data.consumeInt(-3, 3);
        double shift = 2.0 * Math.PI * extraPeriods;
        if (shift != 0.0) {
            runStateIndependenceCase(sin, min + shift, max + shift, initial + shift, root + shift);
        }
    }

    private static void runStateIndependenceCase(
            UnivariateRealFunction explicitFunction,
            double min,
            double max,
            double initial,
            double expectedRoot) {

        if (explicitFunction == null) {
            return;
        }
        if (Double.isNaN(min) || Double.isNaN(max) || Double.isNaN(initial) || Double.isNaN(expectedRoot)) {
            return;
        }
        if (!(min < max) || initial < min || initial > max) {
            return;
        }

        final double fresh;
        final BisectionSolver freshSolver = new BisectionSolver();
        try {
            fresh = freshSolver.solve(explicitFunction, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:fresh-valid] metamorphic violation: valid explicit-function solve on a fresh solver threw from patched region"
                                + " min=" + min + " max=" + max + " initial=" + initial,
                        t);
            }
            return;
        }

        /*
         * Contract/oracle:
         * The overload solve(f, min, max, initial) explicitly receives the function to solve.
         * Therefore its result must depend on that explicit argument, not on stale receiver state
         * left behind by prior calls. We compare the same call on:
         *   (1) a fresh solver, and
         *   (2) a solver "warmed" by a prior successful solve with a different real library function.
         * Any correct implementation must return the same root for both.
         * A band-aid patch that suppresses the known fresh-solver NPE by accidentally reusing stored
         * state, or that still routes through solve(min,max), violates this receiver-state independence.
         */
        final PolynomialFunction poison = new PolynomialFunction(new double[] { -1.0, 1.0 }); // x - 1
        final BisectionSolver warmedSolver = new BisectionSolver();
        try {
            warmedSolver.solve(poison, 0.0, 2.0, 1.0);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        final double warmed;
        try {
            warmed = warmedSolver.solve(explicitFunction, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:state-independence-throw] metamorphic violation: receiver state from a prior solve influenced a later valid solve(f,min,max,initial)"
                                + " min=" + min + " max=" + max + " initial=" + initial,
                        t);
            }
            return;
        }

        double tol = Math.max(freshSolver.getAbsoluteAccuracy(), warmedSolver.getAbsoluteAccuracy()) * 6.0 + 1.0e-12;
        if (Math.abs(fresh - warmed) > tol) {
            throw new RuntimeException(
                    "[oracle:state-independence] metamorphic violation: solve(f,min,max,initial) disagreed between fresh and warmed solvers"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " expectedRoot=" + expectedRoot
                            + " fresh=" + fresh
                            + " warmed=" + warmed
                            + " tol=" + tol);
        }

        /*
         * Independent consistency check:
         * After a successful solve, getResult() is the solver's own cached view of the same returned root.
         * Recomputing this on the warmed solver gives an independent quantity exposed by the real API.
         */
        double cached = warmedSolver.getResult();
        if (Math.abs(cached - warmed) > tol) {
            throw new RuntimeException(
                    "[oracle:warmed-cache] consistency violation: warmed solver returned root differs from cached getResult()"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " returned=" + warmed
                            + " cached=" + cached
                            + " tol=" + tol);
        }

        if (Math.abs(fresh - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:constructed-root] metamorphic violation: valid SinFunction bracket missed the constructed root"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " expectedRoot=" + expectedRoot
                            + " result=" + fresh
                            + " tol=" + tol);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name != null) {
            String lower = name.toLowerCase();
            if (lower.indexOf("convergence") >= 0
                    || lower.indexOf("evaluation") >= 0
                    || lower.indexOf("invalid") >= 0
                    || lower.indexOf("argument") >= 0) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if (e == null) {
                continue;
            }
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static double scaled(int value, double min, double max) {
        if (max <= min) {
            return min;
        }
        double fraction = ((double) value) / 5000.0;
        if (fraction < 0.0) {
            fraction = 0.0;
        }
        if (fraction > 1.0) {
            fraction = 1.0;
        }
        return min + (max - min) * fraction;
    }

    private static double clamp(double v, double min, double max) {
        if (v < min) {
            return min;
        }
        if (v > max) {
            return max;
        }
        return v;
    }
}
