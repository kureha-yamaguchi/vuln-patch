                    || "org.joda.time.format.DateTimeFormatter".equals(cls)
                    || "org.joda.time.format.DateTimeFormat".equals(cls)
                    || "org.joda.time.format.ISODateTimeFormat".equals(cls)
                    || "org.joda.time.base.BasePartial".equals(cls)
                    || "org.joda.time.DateTimeFieldType".equals(cls)
                    || "org.joda.time.MockInstant".equals(cls)
                    || "org.joda.time.field.AbstractPartial".equals(cls)) {
