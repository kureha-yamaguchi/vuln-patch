package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorDeleteFirst();

        String prefix = data.consumeAsciiString(24);
        String needle = data.consumeAsciiString(16);
        String replacement = data.consumeAsciiString(12);
        int mode = data.consumeInt(0, 2);

        if (needle.length() == 0) {
            return;
        }
        if (replacement.indexOf(needle) >= 0) {
            replacement = "R";
        }

        try {
            if (mode == 0) {
                runSetLengthSuffixCase(prefix, needle);
            } else if (mode == 1) {
                runReplaceFirstSuffixCase(prefix, needle, replacement);
            } else {
                runDeleteFirstSuffixCase(prefix, needle);
            }
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
        }
    }

    private static void runAnchorDeleteFirst() {
        StrBuilder sb = new StrBuilder("onetwothree");
        try {
            sb.deleteFirst("three");
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        int reported;
        try {
            reported = sb.indexOf("three", 0);
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        int independent = sb.toString().indexOf("three", 0);
        if (reported != independent) {
            throw new RuntimeException("[oracle:anchor-deletefirst-string-agree] metamorphic violation: StrBuilder indexOf must work like String#indexOf after deleteFirst input=three lhs=" + reported + " rhs=" + independent + " text=" + sb.toString());
        }
    }

    private static void runSetLengthSuffixCase(String prefix, String needle) {
        StrBuilder sb = new StrBuilder(prefix + needle);
        int newLen = prefix.length();
        try {
            sb.ensureCapacity(sb.length() + 8);
            sb.setLength(newLen);
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        checkIndexAgreement(sb, needle, 0, "setlength");
        int start = Math.max(0, prefix.length() - 1);
        checkIndexAgreement(sb, needle, start, "setlength-start");
    }

    private static void runReplaceFirstSuffixCase(String prefix, String needle, String replacement) {
        StrBuilder sb = new StrBuilder(prefix + needle);
        try {
            sb.ensureCapacity(sb.length() + 8);
            sb.replaceFirst(needle, replacement);
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        checkIndexAgreement(sb, needle, 0, "replacefirst");

        StrBuilder twice = new StrBuilder(prefix + needle);
        try {
            twice.replaceFirst(needle, replacement);
            String once = twice.toString();
            twice.replaceFirst(needle, replacement);
            String twiceText = twice.toString();
            if (!once.equals(twiceText)) {
                throw new RuntimeException("[oracle:replacefirst-idempotent] metamorphic violation: replacing the only suffix occurrence with a replacement that does not contain the needle must be idempotent input=" + prefix + "|" + needle + "|" + replacement + " lhs=" + once + " rhs=" + twiceText);
            }
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
        }
    }

    private static void runDeleteFirstSuffixCase(String prefix, String needle) {
        StrBuilder sb = new StrBuilder(prefix + needle);
        try {
            sb.deleteFirst(needle);
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        checkIndexAgreement(sb, needle, 0, "deletefirst");
    }

    private static void checkIndexAgreement(StrBuilder sb, String needle, int start, String tag) {
        int reported;
        try {
            reported = sb.indexOf(needle, start);
        } catch (RuntimeException e) {
            if (isInterestingRuntime(e)) {
                throw e;
            }
            return;
        }

        int independent = sb.toString().indexOf(needle, start);
        if (reported != independent) {
            throw new RuntimeException("[oracle:" + tag + "-string-agree] metamorphic violation: documented behavior says StrBuilder#indexOf should work like String#indexOf input=" + sb.toString() + " needle=" + needle + " start=" + start + " lhs=" + reported + " rhs=" + independent);
        }

        if (reported >= 0) {
            int viaOneArg;
            try {
                viaOneArg = sb.indexOf(needle);
            } catch (RuntimeException e) {
                if (isInterestingRuntime(e)) {
                    throw e;
                }
                return;
            }
            if (start == 0 && viaOneArg != reported) {
                throw new RuntimeException("[oracle:index-overload-agree] metamorphic violation: indexOf(str) must agree with indexOf(str,0) input=" + sb.toString() + " needle=" + needle + " lhs=" + viaOneArg + " rhs=" + reported);
            }
        }
    }

    private static boolean isInterestingRuntime(RuntimeException e) {
        if (e instanceof IllegalArgumentException || e instanceof NumberFormatException) {
            return false;
        }
        if (e instanceof ArrayIndexOutOfBoundsException) {
            return stackHasRelevantFrame(e);
        }
        return e.getMessage() != null && e.getMessage().startsWith("[oracle:");
    }

    private static boolean stackHasRelevantFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("indexOf".equals(m) || "deleteImpl".equals(m) || "replaceImpl".equals(m))) {
                return true;
            }
        }
        return false;
    }
}
