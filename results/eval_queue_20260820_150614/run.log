package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-32, 32);
        double root = k * Math.PI;

        int leftUnits = data.consumeInt(1, 2000);
        int rightUnits = data.consumeInt(1, 2000);
        double leftWidth = leftUnits / 10000.0 + 1e-6;
        double rightWidth = rightUnits / 10000.0 + 1e-6;

        double min = root - leftWidth;
        double max = root + rightWidth;

        int selector1 = data.consumeInt(0, 6);
        int selector2 = data.consumeInt(0, 6);

        double initial1 = chooseInitial(selector1, min, max, root, leftWidth, rightWidth);
        double initial2 = chooseInitial(selector2, min, max, root, leftWidth, rightWidth);

        runInitialIndependenceCase(f, min, max, initial1, initial2);
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        runInitialIndependenceCase(f, 3.0, 3.2, 3.1, Math.PI);
    }

    private static double chooseInitial(int selector, double min, double max, double root, double leftWidth, double rightWidth) {
        switch (selector) {
            case 0:
                return root;
            case 1:
                return min;
            case 2:
                return max;
            case 3:
                return root - leftWidth * 0.5;
            case 4:
                return root + rightWidth * 0.5;
            case 5:
                return min + (max - min) * 0.25;
            default:
                return min + (max - min) * 0.75;
        }
    }

    private static void runInitialIndependenceCase(
            UnivariateRealFunction f, double min, double max, double initial1, double initial2) {
        Double result1 = null;
        Double result2 = null;

        try {
            BisectionSolver solver1 = new BisectionSolver();
            result1 = solver1.solve(f, min, max, initial1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            BisectionSolver solver2 = new BisectionSolver();
            result2 = solver2.solve(f, min, max, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (result1 == null || result2 == null) {
            return;
        }

        BisectionSolver tolSolver = new BisectionSolver();
        double tol = tolSolver.getAbsoluteAccuracy() * 4.0 + 1e-12;

        /*
         * Contract/oracle: BisectionSolver's implementation of solve(f,min,max) uses only f, min, and max;
         * the "initial" parameter is not consulted by the bisection iteration. Therefore, for the same real
         * function and interval, varying only "initial" must not change the computed root beyond solver
         * accuracy. A throw-deleting or seed-special-casing patch can silence the known NPE yet still make
         * solve(f,min,max,initial) behave inconsistently across different initial values.
         */
        if (Math.abs(result1.doubleValue() - result2.doubleValue()) > tol) {
            throw new RuntimeException(
                    "[oracle:initial-ignored] metamorphic violation: solve(f,min,max,initial1) != solve(f,min,max,initial2)"
                            + " min=" + min
                            + " max=" + max
                            + " initial1=" + initial1
                            + " initial2=" + initial2
                            + " lhs=" + result1
                            + " rhs=" + result2
                            + " tol=" + tol);
        }
    }

    private static boolean isRootCauseNpeFromPatchedRegion(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof NullPointerException) {
                StackTraceElement[] stack = cur.getStackTrace();
                for (int i = 0; i < stack.length; i++) {
                    StackTraceElement e = stack[i];
                    if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                            && "solve".equals(e.getMethodName())) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("ConvergenceException")
                    || name.contains("NoBracketing")
                    || name.contains("Invalid")
                    || name.contains("OutOfRange")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
