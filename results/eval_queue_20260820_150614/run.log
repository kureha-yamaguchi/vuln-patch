        if (!(Double.isInfinite(wholeSize) && wholeSize > 0.0)) {
            throw new RuntimeException(
                    "[oracle:whole-size] metamorphic violation: whole-space no-cut tree must report infinite size, got " + wholeSize);
        }
        if (!(Double.isNaN(wholeBary.getX()) && Double.isNaN(wholeBary.getY()))) {
            throw new RuntimeException(
                    "[oracle:whole-bary] metamorphic violation: whole-space no-cut tree must report NaN barycenter, got "
                            + wholeBary);
        }
        if (emptySize != 0.0) {
            throw new RuntimeException(
                    "[oracle:empty-size] metamorphic violation: empty no-cut tree must report zero size, got " + emptySize);
        }
        if (emptyBary.getX() != 0.0 || emptyBary.getY() != 0.0) {
            throw new RuntimeException(
                    "[oracle:empty-bary] metamorphic violation: empty no-cut tree must report origin barycenter, got "
                            + emptyBary);
        }
    }

    private static boolean different(double a, double b) {
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a != b;
        }
        return Double.doubleToLongBits(a) != Double.doubleToLongBits(b);
    }

    private static boolean differentPoint(Vector2D a, Vector2D b) {
        return different(a.getX(), b.getX()) || different(a.getY(), b.getY());
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method)
                    || "getAttribute".equals(method)
                    || "getCut".equals(method)
                    || "visit".equals(method)
                    || "isEmpty".equals(method)
                    || "getSmallest".equals(method)
                    || "followLoop".equals(method)
                    || "getLine".equals(method)
                    || "toSpace".equals(method)
                    || "getStart".equals(method)
                    || "toSubSpace".equals(method)
                    || "getX".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cls)
                    && ("setBarycenter".equals(method) || "setSize".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.util.FastMath".equals(cls)
                    && ("abs".equals(method) || "max".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.euclidean.oned.Vector1D".equals(cls)
                    && "<init>".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid")
                || name.contains("parse")
                || name.contains("format")
                || name.contains("argument")
                || name.contains("exception");
    }

    private static boolean isOurOracle(Throwable t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
}
