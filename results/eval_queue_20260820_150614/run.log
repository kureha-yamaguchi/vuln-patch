package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.io.IOException;
import java.io.Reader;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeAsciiString(8);
        String s = data.consumeString(24);
        if (s.length() == 0) {
            s = "X";
        }

        char padChar = (char) (' ' + data.consumeInt(0, 94));
        int initialCapacity = data.consumeInt(1, 8);

        int width;
        if (s.length() > 1 && data.consumeBoolean()) {
            width = data.consumeInt(1, Math.min(8, s.length() - 1));
        } else {
            width = data.consumeInt(1, Math.min(8, Math.max(1, s.length() + 2)));
        }

        runCase(new StrBuilder(initialCapacity), prefix, s, width, padChar);

        String nullText = data.consumeString(16);
        if (nullText.length() == 0) {
            nullText = "N";
        }
        int nullWidth;
        if (nullText.length() > 1 && data.consumeBoolean()) {
            nullWidth = data.consumeInt(1, Math.min(8, nullText.length() - 1));
        } else {
            nullWidth = data.consumeInt(1, Math.min(8, Math.max(1, nullText.length() + 2)));
        }
        runNullCase(new StrBuilder(initialCapacity), prefix, nullText, nullWidth, padChar);
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String actual = sb.toString();
        if (!"f".equals(actual)) {
            throw new RuntimeException("[oracle:anchor-contract] appendFixedWidthPadRight(\"foo\",1,'-') must keep exactly the leftmost width characters; actual=" + actual);
        }

        try {
            String viaReader = readAll(sb.asReader());
            if (!actual.equals(viaReader)) {
                throw new RuntimeException("[oracle:reader-agree-anchor] asReader() must expose the same content as toString() for the same StrBuilder state; toString=" + actual + " reader=" + viaReader);
            }
        } catch (Throwable ignored) {
        }
    }

    private static void runCase(StrBuilder sb, String prefix, String value, int width, char padChar) {
        try {
            sb.append(prefix);
            sb.appendFixedWidthPadRight(value, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String expected = prefix + expectedFixedWidthPadRight(value, width, padChar);
        String actual = sb.toString();

        /* Contract used for this oracle:
         * when the source string is at least width characters long, exactly width characters are appended;
         * otherwise the source is appended and padded on the right up to width.
         * A throw-deleting or branch-skipping patch can silently produce the wrong content without crashing.
         */
        if (!expected.equals(actual)) {
            throw new RuntimeException("[oracle:fixed-right-contract] input=" + value + " width=" + width + " pad=" + (int) padChar + " prefix=" + prefix + " expected=" + expected + " actual=" + actual);
        }

        /* Independent consistency check:
         * asReader() is another public view of the same StrBuilder contents, so reading it back must equal
         * toString() for any correct implementation.
         */
        try {
            String viaReader = readAll(sb.asReader());
            if (!actual.equals(viaReader)) {
                throw new RuntimeException("[oracle:reader-agree] input=" + value + " width=" + width + " prefix=" + prefix + " toString=" + actual + " reader=" + viaReader);
            }
        } catch (Throwable ignored) {
        }
    }

    private static void runNullCase(StrBuilder sb, String prefix, String nullText, int width, char padChar) {
        try {
            sb.setNullText(nullText);
            sb.append(prefix);
            sb.appendFixedWidthPadRight((Object) null, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String expected = prefix + expectedFixedWidthPadRight(nullText, width, padChar);
        String actual = sb.toString();

        if (!expected.equals(actual)) {
            throw new RuntimeException("[oracle:nulltext-contract] nullText=" + nullText + " width=" + width + " pad=" + (int) padChar + " prefix=" + prefix + " expected=" + expected + " actual=" + actual);
        }

        try {
            String viaReader = readAll(sb.asReader());
            if (!actual.equals(viaReader)) {
                throw new RuntimeException("[oracle:reader-agree-null] nullText=" + nullText + " width=" + width + " prefix=" + prefix + " toString=" + actual + " reader=" + viaReader);
            }
        } catch (Throwable ignored) {
        }
    }

    private static String expectedFixedWidthPadRight(String src, int width, char padChar) {
        if (width <= 0) {
            return "";
        }
        if (src.length() >= width) {
            return src.substring(0, width);
        }
        StringBuilder out = new StringBuilder(width);
        out.append(src);
        while (out.length() < width) {
            out.append(padChar);
        }
        return out.toString();
    }

    private static String readAll(Reader reader) throws IOException {
        char[] buf = new char[64];
        StringBuilder out = new StringBuilder();
        int n;
        while ((n = reader.read(buf)) != -1) {
            out.append(buf, 0, n);
        }
        return out.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)
                && !(t instanceof ArrayIndexOutOfBoundsException)
                && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
