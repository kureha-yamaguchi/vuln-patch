package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String[] ANCHOR_BAD_INPUTS = new String[] { "l", "L", "f", "F", "junk", "bobL" };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (int i = 0; i < ANCHOR_BAD_INPUTS.length; i++) {
            tryInvalid(ANCHOR_BAD_INPUTS[i]);
        }

        String singleSuffix = pickSuffix(data.consumeInt(0, 5));
        tryInvalid(singleSuffix);

        String nearBoundaryGarbage = data.consumeAsciiString(2);
        if (nearBoundaryGarbage.length() == 0) {
            nearBoundaryGarbage = "x";
        }
        tryInvalid(nearBoundaryGarbage + singleSuffix);

        String longCore = buildValidIntegerCore(data);
        char longSuffix = data.consumeBoolean() ? 'L' : 'l';
        checkLongSiblingAgreement(longCore, longSuffix);

        String floatCore = buildValidDecimalCore(data, false);
        char floatSuffix = data.consumeBoolean() ? 'F' : 'f';
        checkFloatSiblingAgreement(floatCore, floatSuffix);

        String doubleCore = buildValidDecimalCore(data, true);
        char doubleSuffix = data.consumeBoolean() ? 'D' : 'd';
        checkDoubleSiblingAgreement(doubleCore, doubleSuffix);

        String explore = buildExplorationInput(data);
        tryInvalid(explore);
    }

    private static void tryInvalid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                return;
            }
        }
    }

    private static void checkLongSiblingAgreement(String core, char suffix) {
        String withSuffix = core + suffix;
        try {
            Number parsed = NumberUtils.createNumber(withSuffix);
            Long direct = NumberUtils.createLong(core);

            /* Contract used: createNumber selects a specific requested type when a valid type suffix
             * is supplied; tests in NumberUtilsTest show "...L"/"...l" produce a Long for valid longs.
             * A throw-deleting or overfit patch near the length==1 boundary could make valid minimal
             * suffixed inputs reject or return the wrong value/type. */
            if (!(parsed instanceof Long) || parsed.longValue() != direct.longValue()) {
                throw new RuntimeException(
                    "[oracle:long-sibling] metamorphic violation: createNumber(core+L) must agree with createLong(core)"
                        + " core=" + core
                        + " input=" + withSuffix
                        + " parsedClass=" + (parsed == null ? "null" : parsed.getClass().getName())
                        + " parsedValue=" + String.valueOf(parsed)
                        + " directValue=" + direct);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static void checkFloatSiblingAgreement(String core, char suffix) {
        String withSuffix = core + suffix;
        try {
            Number parsed = NumberUtils.createNumber(withSuffix);
            Float direct = NumberUtils.createFloat(core);

            /* Contract used: with a valid 'F'/'f' suffix and moderate finite input, createNumber is
             * requesting a specific float type and should return the same float value as createFloat(core).
             * This is an independent sibling-oracle: even if a patch merely suppresses the historical crash,
             * valid boundary inputs like "1F" must still parse to the same Float. */
            if (!(parsed instanceof Float)
                || Float.floatToIntBits(parsed.floatValue()) != Float.floatToIntBits(direct.floatValue())) {
                throw new RuntimeException(
                    "[oracle:float-sibling] metamorphic violation: createNumber(core+F) must agree with createFloat(core)"
                        + " core=" + core
                        + " input=" + withSuffix
                        + " parsedClass=" + (parsed == null ? "null" : parsed.getClass().getName())
                        + " parsedValue=" + String.valueOf(parsed)
                        + " directValue=" + direct);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static void checkDoubleSiblingAgreement(String core, char suffix) {
        String withSuffix = core + suffix;
        try {
            Number parsed = NumberUtils.createNumber(withSuffix);
            Double direct = NumberUtils.createDouble(core);

            /* Contract used: with a valid 'D'/'d' suffix and moderate finite input, createNumber is
             * requesting a specific double type and should return the same double value as createDouble(core).
             * This flips the patched length boundary: suffix-only strings must reject, while minimally-valid
             * strings such as "1D" must still parse correctly. */
            if (!(parsed instanceof Double)
                || Double.doubleToLongBits(parsed.doubleValue()) != Double.doubleToLongBits(direct.doubleValue())) {
                throw new RuntimeException(
                    "[oracle:double-sibling] metamorphic violation: createNumber(core+D) must agree with createDouble(core)"
                        + " core=" + core
                        + " input=" + withSuffix
                        + " parsedClass=" + (parsed == null ? "null" : parsed.getClass().getName())
                        + " parsedValue=" + String.valueOf(parsed)
                        + " directValue=" + direct);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static String buildValidIntegerCore(FuzzedDataProvider data) {
        int magnitude = data.consumeInt(0, 1_000_000);
        String digits = Integer.toString(magnitude);
        if (data.consumeBoolean() && magnitude != 0) {
            return "-" + digits;
        }
        return digits;
    }

    private static String buildValidDecimalCore(FuzzedDataProvider data, boolean allowExponent) {
        int whole = data.consumeInt(0, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean() && (whole != 0 || frac != 0)) {
            sb.append('-');
        }
        sb.append(whole);
        if (data.consumeBoolean()) {
            sb.append('.');
            String fracStr = Integer.toString(frac);
            int minWidth = data.consumeInt(1, 6);
            for (int i = fracStr.length(); i < minWidth; i++) {
                sb.append('0');
            }
            sb.append(fracStr);
        }
        if (allowExponent && data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'E' : 'e');
            int exp = data.consumeInt(-10, 10);
            sb.append(exp);
        }
        return sb.toString();
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                return pickSuffix(data.consumeInt(0, 5));
            case 1:
                return data.consumeBoolean() ? ("-" + pickSuffix(data.consumeInt(0, 5))) : ("+" + pickSuffix(data.consumeInt(0, 5)));
            case 2:
                return data.consumeAsciiString(1) + pickSuffix(data.consumeInt(0, 5));
            case 3:
                return buildValidIntegerCore(data) + pickSuffix(data.consumeInt(0, 1));
            case 4:
                return buildValidDecimalCore(data, false) + pickSuffix(data.consumeInt(2, 5));
            default:
                return data.consumeAsciiString(6);
        }
    }

    private static String pickSuffix(int idx) {
        switch (idx) {
            case 0:
                return "l";
            case 1:
                return "L";
            case 2:
                return "f";
            case 3:
                return "F";
            case 4:
                return "d";
            default:
                return "D";
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "charAt".equals(method)
                    || "substring".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }
}
