package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.ConvergenceException;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MathException;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorNormalDistribution();
        exploreBracketBoundary(data);
        exploreNormalSymmetry(data);
    }

    private static void anchorNormalDistribution() {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);
            double p = 0.9772498680518209d;
            double result = normal.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException("[oracle:anchor-value] metamorphic violation: Normal(0,1).inverseCumulativeProbability(0.9772498680518209) must equal 2.0 from the regression test, got " + result);
            }
        } catch (Throwable t) {
            if (isValidationException(t)) {
                return;
            }
            if (hasStackFrame(t, "org.apache.commons.math.distribution.AbstractContinuousDistribution", "inverseCumulativeProbability")
                    || hasStackFrame(t, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils", "bracket")) {
                throw new RuntimeException("[oracle:anchor-exc] metamorphic violation: valid standard-normal quantile input triggered failure for the regression seed", t);
            }
        }
    }

    private static void exploreBracketBoundary(FuzzedDataProvider data) {
        int trials = 1 + (data.remainingBytes() > 0 ? data.consumeInt(1, 4) : 1);
        for (int i = 0; i < trials; i++) {
            int rootInt = data.consumeInt(1, 1000);
            int upperSlack = data.consumeInt(0, 3);
            int maxIterations = data.consumeInt(1, 10);

            double root = rootInt;
            double initial = root - 1.0d;
            double lower = root - 2.0d;
            double upper = root + upperSlack;

            PolynomialFunction f = new PolynomialFunction(new double[] { -root, 1.0d });

            double[] r4;
            double[] r5;
            try {
                r4 = UnivariateRealSolverUtils.bracket(f, initial, lower, upper);
                r5 = UnivariateRealSolverUtils.bracket(f, initial, lower, upper, maxIterations);
            } catch (Throwable t) {
                if (isValidationException(t)) {
                    return;
                }
                if (hasStackFrame(t, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils", "bracket")) {
                    throw new RuntimeException("[oracle:flip-bracket] metamorphic violation: valid-by-construction bracketing input with one endpoint exactly at a root must not fail; root="
                            + root + " initial=" + initial + " lower=" + lower + " upper=" + upper + " maxIterations=" + maxIterations, t);
                }
                return;
            }

            try {
                double fa4 = f.value(r4[0]);
                double fb4 = f.value(r4[1]);
                double fa5 = f.value(r5[0]);
                double fb5 = f.value(r5[1]);

                if (fa4 * fb4 > 0.0d) {
                    throw new RuntimeException("[oracle:bracket-sign] metamorphic violation: returned interval from 4-arg bracket does not bracket a root; a="
                            + r4[0] + " b=" + r4[1] + " f(a)=" + fa4 + " f(b)=" + fb4);
                }
                if (fa5 * fb5 > 0.0d) {
                    throw new RuntimeException("[oracle:bracket-sign] metamorphic violation: returned interval from 5-arg bracket does not bracket a root; a="
                            + r5[0] + " b=" + r5[1] + " f(a)=" + fa5 + " f(b)=" + fb5);
                }

                /* Documented sibling-agreement check: the 4-arg bracket overload is the same operation
                 * as the 5-arg overload with a maximum-iterations parameter; for the same valid input,
                 * both overloads must return the same bracketing interval. A throw-deleting or condition-
                 * mangling patch can make one path silently diverge. */
                if (r4.length != 2 || r5.length != 2 || r4[0] != r5[0] || r4[1] != r5[1]) {
                    throw new RuntimeException("[oracle:overload-agree] metamorphic violation: bracket overloads disagree on equivalent valid input; "
                            + "root=" + root + " r4=[" + r4[0] + "," + r4[1] + "] r5=[" + r5[0] + "," + r5[1] + "]");
                }
            } catch (FunctionEvaluationException e) {
                return;
            }
        }
    }

    private static void exploreNormalSymmetry(FuzzedDataProvider data) {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);
            int scaled = data.consumeInt(-1000000, 1000000);
            double p = 0.5d + (scaled * 1.0e-6d) * 0.25d;
            if (p <= 1.0e-12d) {
