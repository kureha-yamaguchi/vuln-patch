    private static void assertMonthDayEquals(
            String oracleId,
            int inMonth,
            int inDay,
            int amount,
            MonthDay actual,
            int expectedMonth,
            int expectedDay) {
        if (actual.getMonthOfYear() != expectedMonth || actual.getDayOfMonth() != expectedDay) {
            throw new RuntimeException(
                    "[oracle:"
                            + oracleId
                            + "] metamorphic violation: input=--"
                            + two(inMonth)
                            + "-"
                            + two(inDay)
                            + " amount="
                            + amount
                            + " expected=--"
                            + two(expectedMonth)
                            + "-"
                            + two(expectedDay)
                            + " actual="
                            + actual);
        }
    }

    private static boolean stackHasPatchedRegion(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.joda.time.MonthDay".equals(cls)
                    && ("withFieldAdded".equals(method)
                            || "plusMonths".equals(method)
                            || "plusDays".equals(method)
                            || "minusMonths".equals(method)
                            || "minusDays".equals(method)
                            || "indexOfSupported".equals(method)
                            || "getValues".equals(method)
                            || "getField".equals(method))) {
                return true;
            }
            if ("org.joda.time.field.FieldUtils".equals(cls) && "verifyValueBounds".equals(method)) {
                return true;
            }
            if ("org.joda.time.field.PreciseDurationDateTimeField".equals(cls) && "set".equals(method)) {
                return true;
            }
            if ("org.joda.time.chrono.BasicMonthOfYearDateTimeField".equals(cls) && "add".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.indexOf("IllegalFieldValue") >= 0
                || name.indexOf("Invalid") >= 0
                || name.indexOf("ParseException") >= 0
                || name.indexOf("Malformed") >= 0;
    }

    private static int maxValidDayForLeapYearMonth(int month) {
        switch (month) {
            case 2:
                return 29;
            case 4:
            case 6:
            case 9:
            case 11:
                return 30;
            default:
                return 31;
        }
    }

    private static int boundedNonZero(int value) {
        if (value == 0) {
            return 1;
        }
        if (value > 24) {
            return 24;
        }
        if (value < -24) {
            return -24;
        }
        return value;
    }

    private static int positivePreferredNonZero(int value) {
        if (value <= 0) {
            value = -value + 1;
        }
        return boundedNonZero(value);
    }

    private static int negativePreferredNonZero(int value) {
        if (value >= 0) {
            value = -(value + 1);
        }
        return boundedNonZero(value);
    }

    private static int nearBoundaryNonZeroDayStep(int value) {
        if (value == 0) {
            return 1;
        }
        if (value > 7) {
            return 7 + (value % 5);
        }
        if (value < -7) {
            return -7 - ((-value) % 5);
        }
        return value;
    }

    private static String two(int v) {
        return (v < 10 ? "0" : "") + v;
    }
}
