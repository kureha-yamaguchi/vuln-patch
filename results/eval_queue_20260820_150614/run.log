        String expected = expectedFor(pattern);

        if (!equalsNullable(before, after)) {
            throw new RuntimeException("[oracle:pattern-stability] metamorphic violation: input=" + pattern + " before=" + before + " after=" + after);
        }
        if (!equalsNullable(actual, expected)) {
