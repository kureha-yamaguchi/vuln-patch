    private static void checkLengthConsistency(Object[] array, String sep, int start, int end, String joined, String id) {
        int expected = 0;
        for (int i = start; i < end; i++) {
            if (i > start) {
                expected += StringUtils.length(sep);
            }
            if (array[i] != null) {
                String rendered = String.valueOf(array[i]);
                expected += StringUtils.length(rendered);
            }
