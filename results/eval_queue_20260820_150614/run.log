package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int cases = 1 + Math.abs(data.consumeInt(0, 3));
        for (int i = 0; i < cases; i++) {
            runExploreCase(data);
        }
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        double expectedRoot = Math.PI;
        double min = 3.0;
        double max = 3.2;
        double initial = 3.1;
        runValidCaseWithCacheConsistency(f, min, max, initial, expectedRoot);
    }

    private static void runExploreCase(FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-100, 100);
        double expectedRoot = k * Math.PI;

        int leftMilli = data.consumeInt(1, 1000);
        int rightMilli = data.consumeInt(1, 1000);

        double left = leftMilli / 1000.0;
        double right = rightMilli / 1000.0;

        double min = expectedRoot - left;
        double max = expectedRoot + right;

        double selector = data.consumeInt(-1000, 1000) / 1000.0;
        double initial = min + (max - min) * ((selector + 1000.0) / 2000.0);
        if (initial < min) {
            initial = min;
        } else if (initial > max) {
            initial = max;
        }

        runValidCaseWithCacheConsistency(f, min, max, initial, expectedRoot);
    }

    private static void runValidCaseWithCacheConsistency(
            UnivariateRealFunction f, double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        try {
            /*
             * Contract used for this oracle:
             * - solve(f, min, max, initial) is a public entry point for solving the same root-finding problem.
             * - On success, the solver stores the computed solution as its current result via setResult(...),
             *   so solver.getResult() must equal the returned value from the very same call.
             * A throw-deleting or shortcut patch can make the top-level call return some value without
             * updating the solver's cached state, so this cache/result consistency check remains meaningful
             * even if the known NullPointerException symptom is masked.
             */
            double returned = solver.solve(f, min, max, initial);

            double cached = solver.getResult();
            double tol = Math.max(solver.getAbsoluteAccuracy(), 1e-12);
            if (Math.abs(returned - cached) > tol) {
                throw new RuntimeException(
                        "[oracle:cache-sync] metamorphic violation: returned root disagrees with solver cached result"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " returned=" + returned
                                + " cached=" + cached
                                + " tol=" + tol);
            }

            double rootTol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;
            if (Math.abs(returned - expectedRoot) > rootTol) {
                throw new RuntimeException(
                        "[oracle:cache-sync] metamorphic violation: valid SinFunction solve missed constructed root"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " expectedRoot=" + expectedRoot
                                + " returned=" + returned
                                + " tol=" + rootTol);
            }

            int iterations = solver.getIterationCount();
            if (iterations < 0 || iterations > solver.getMaximalIterationCount()) {
                throw new RuntimeException(
                        "[oracle:iteration-range] metamorphic violation: iteration count outside solver bounds"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " iterations=" + iterations
                                + " maxIterations=" + solver.getMaximalIterationCount());
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:cache-sync] metamorphic violation: valid solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " expectedRoot=" + expectedRoot,
                        t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        } catch (Throwable t) {
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:cache-sync] metamorphic violation: valid solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " expectedRoot=" + expectedRoot,
                        t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof NullPointerException && hasBisectionSolveFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasBisectionSolveFrame(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("ConvergenceException")
                    || name.contains("MaxIterationsExceededException")
                    || name.contains("FunctionEvaluationException")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }
}
