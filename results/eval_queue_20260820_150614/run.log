public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor = "off";
        try {
            BooleanUtils.toBoolean(anchor);
        } catch (RuntimeException t) {
            boolean root = t instanceof StringIndexOutOfBoundsException;
            if (root) {
                StackTraceElement[] st = t.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                            && "toBoolean".equals(st[i].getMethodName())) {
                        throw t;
                    }
                }
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
        }

        int rounds = 1 + data.consumeInt(1, 6);
        for (int i = 0; i < rounds; i++) {
            String s;
            int strategy = data.consumeInt(0, 4);
            if (strategy == 0) {
                char c0 = (char) data.consumeByte();
                if (c0 == 'y' || c0 == 'Y') {
                    c0 = 'o';
                }
                char c1 = (char) data.consumeByte();
                char c2 = (char) data.consumeByte();
                s = new String(new char[] { c0, c1, c2 });
            } else if (strategy == 1) {
                String raw = data.consumeAsciiString(16);
                if (raw.length() < 3) {
                    raw = (raw + "off").substring(0, 3);
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
                if (s.charAt(0) == 'y' || s.charAt(0) == 'Y') {
                    s = "o" + s.substring(1);
                }
            } else if (strategy == 2) {
                String[] literals = new String[] {
                    "off", "oof", "yep", "tru", "abc", "no!", "000", "___", "   ", "tfx", "ofF", "On!"
                };
                s = literals[data.consumeInt(0, literals.length - 1)];
                if (s.length() != 3) {
                    s = "off";
                }
                if (s.charAt(0) == 'y' || s.charAt(0) == 'Y') {
                    s = "o" + s.substring(1);
                }
            } else if (strategy == 3) {
                String raw = data.consumeRemainingAsString();
                if (raw.length() == 0) {
                    raw = "off";
                }
                while (raw.length() < 3) {
                    raw = raw + "x";
                }
                int pick = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(pick, pick + 3);
                if (s.charAt(0) == 'y' || s.charAt(0) == 'Y') {
                    s = "o" + s.substring(1);
                }
            } else {
                char[] chars = new char[3];
                for (int j = 0; j < 3; j++) {
                    chars[j] = (char) ('A' + data.consumeInt(0, 25));
                }
                if (chars[0] == 'Y') {
                    chars[0] = 'O';
                }
                s = new String(chars);
            }

            try {
                boolean result = BooleanUtils.toBoolean(s);

                /* Contract/oracle:
                 * BooleanUtils.toBoolean(String) is a case-insensitive parser for the recognized
                 * true tokens ("true", "on", "yes"); all other strings return false. Therefore
                 * changing only the case of a non-null string must not change the result.
                 * A throw-deleting or branch-skipping patch that makes some 3-char inputs return
                 * an incorrect value would violate this relation without needing an exception.
                 */
                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                                "[oracle:casefold] metamorphic violation: case-insensitive agreement input="
                                        + s + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException relationEx) {
                    if (relationEx.getMessage() != null
                            && relationEx.getMessage().startsWith("[oracle:casefold]")) {
                        throw relationEx;
                    }
                }

                try {
                    String lower = s.toLowerCase();
                    boolean lowerResult = BooleanUtils.toBoolean(lower);
                    if (result != lowerResult) {
                        throw new RuntimeException(
                                "[oracle:lowerfold] metamorphic violation: case-insensitive agreement input="
                                        + s + " lhs=" + result + " rhs=" + lowerResult);
                    }
                } catch (RuntimeException relationEx) {
                    if (relationEx.getMessage() != null
                            && relationEx.getMessage().startsWith("[oracle:lowerfold]")) {
                        throw relationEx;
                    }
                }
            } catch (RuntimeException t) {
                boolean root = t instanceof StringIndexOutOfBoundsException;
                if (root) {
                    StackTraceElement[] st = t.getStackTrace();
                    for (int k = 0; k < st.length; k++) {
                        if ("org.apache.commons.lang.BooleanUtils".equals(st[k].getClassName())
                                && "toBoolean".equals(st[k].getMethodName())) {
                            throw t;
                        }
                    }
                }
                if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                    return;
                }
            }
        }
    }
