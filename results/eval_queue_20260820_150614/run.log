package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        final double epsilon = 1.0e-6;
        final int maxUlpsA = data.consumeInt(1, 8);
        final int maxUlpsB = data.consumeInt(1, 8);

        // ANCHOR-like deterministic case first: exact integer GEQ lower bounds with duplicates
        // create artificial variables and tie rows in phase 1; a correct solver must still find
        // the unique optimum at the constructed lower bounds.
        runScenario(4, 6, new int[] {1, 2, 3, 4}, epsilon, maxUlpsA, maxUlpsB);

        // EXPLORE: vary dimensions, duplicate count, and lower bounds while preserving validity.
        int n = data.consumeInt(2, 6);
        int dupCount = data.consumeInt(2, 10);
        int[] lbs = new int[n];
        for (int i = 0; i < n; i++) {
            lbs[i] = data.consumeInt(1, 7);
        }
        runScenario(n, dupCount, lbs, epsilon, maxUlpsA, maxUlpsB);

        // Additional explore pass with a different shape but the same triggering property:
        // many duplicate GEQ constraints on one variable -> phase-1 artificial variables and
        // minimum-ratio ties around the patched condition.
        int n2 = data.consumeInt(2, 5);
        int dupCount2 = data.consumeInt(3, 12);
        int[] lbs2 = new int[n2];
        for (int i = 0; i < n2; i++) {
            lbs2[i] = data.consumeInt(1, 5);
        }
        if (n2 > 0) {
            lbs2[0] = data.consumeInt(1, 3);
        }
        runScenario(n2, dupCount2, lbs2, epsilon, maxUlpsB, maxUlpsA);
    }

    private static void runScenario(int n, int duplicateFirstConstraintCount, int[] lowerBounds,
                                    double epsilon, int maxUlpsA, int maxUlpsB) {
        if (n < 2 || lowerBounds == null || lowerBounds.length != n || duplicateFirstConstraintCount < 1) {
            return;
        }

        double[] objective = new double[n];
        for (int i = 0; i < n; i++) {
            objective[i] = i + 1.0d;
        }
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0d);

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        for (int i = 0; i < n; i++) {
            double[] coeff = new double[n];
            coeff[i] = 1.0d;
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, lowerBounds[i]));
        }
        for (int k = 0; k < duplicateFirstConstraintCount; k++) {
            double[] coeff = new double[n];
            coeff[0] = 1.0d;
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, lowerBounds[0]));
        }

        // Boundedness helper that preserves the same unique optimum at x_i = lowerBounds[i].
        double[] sumCoeff = new double[n];
        double rhs = 0.0d;
        for (int i = 0; i < n; i++) {
            sumCoeff[i] = 1.0d;
            rhs += lowerBounds[i] + 10.0d;
        }
        constraints.add(new LinearConstraint(sumCoeff, Relationship.LEQ, rhs));

        // Independent consistency check on the initial tableau:
        // SimplexTableau construction installs artificial variables for GEQ constraints. For each
        // artificial column, getBasicRow(column) must agree with an independent scan of the matrix
        // entries for a unit column. A throw-deleting patch in pivot-row selection would not fix a
        // disagreement here.
        try {
            SimplexTableau tableauA =
                new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, epsilon, maxUlpsA);
            SimplexTableau tableauB =
                new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, epsilon, maxUlpsB);
            checkArtificialColumns(tableauA, maxUlpsA, "a");
            checkArtificialColumns(tableauB, maxUlpsB, "b");

            // Second identically-constructed object oracle: the same LP built twice must report
            // the same basic row for each artificial variable.
            int count = Math.min(tableauA.getNumArtificialVariables(), tableauB.getNumArtificialVariables());
            int offsetA = tableauA.getArtificialVariableOffset();
            int offsetB = tableauB.getArtificialVariableOffset();
            for (int i = 0; i < count; i++) {
                Integer rowA = tableauA.getBasicRow(offsetA + i);
                Integer rowB = tableauB.getBasicRow(offsetB + i);
                if (rowA == null ? rowB != null : !rowA.equals(rowB)) {
                    throw new RuntimeException("[oracle:basic-row-repeat] metamorphic violation: identical tableau construction disagrees for artificial column "
                        + i + " rowA=" + rowA + " rowB=" + rowB);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            return;
        }

        PointValuePair solA = null;
        PointValuePair solB = null;
        boolean okA = false;
        boolean okB = false;

        try {
            SimplexSolver solverA = new SimplexSolver(epsilon, maxUlpsA);
            solA = solverA.optimize(f, constraints, GoalType.MINIMIZE, true);
            okA = true;
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t)) {
                throw propagate(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }

        try {
            SimplexSolver solverB = new SimplexSolver(epsilon, maxUlpsB);
            solB = solverB.optimize(f, constraints, GoalType.MINIMIZE, true);
            okB = true;
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t)) {
                throw propagate(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }

        // Mandatory post-condition / metamorphic check:
        // For this LP family, we built a unique optimum by construction: positive objective
        // coefficients and independent lower bounds x_i >= lowerBounds[i]. Therefore a correct
        // implementation must return exactly that point (within tolerance), regardless of maxUlps,
        // when it returns any solution at all.
        if (okA) {
            verifyConstructedUniqueOptimum(f, constraints, solA, lowerBounds, epsilon, "A");
        }
        if (okB) {
            verifyConstructedUniqueOptimum(f, constraints, solB, lowerBounds, epsilon, "B");
        }

        // Equivalent-call relation: changing maxUlps should not change the optimum for this exact
        // integer LP family when both runs succeed.
        if (okA && okB) {
            double valueA = solA.getValue();
            double valueB = solB.getValue();
            if (!Precision.equals(valueA, valueB, 1.0e-7)) {
                throw new RuntimeException("[oracle:maxulps-value] metamorphic violation: identical LP solved with different maxUlps changed objective value lhs="
                    + valueA + " rhs=" + valueB + " ulpsA=" + maxUlpsA + " ulpsB=" + maxUlpsB);
            }
            double[] pointA = solA.getPoint();
            double[] pointB = solB.getPoint();
            if (pointA.length != pointB.length) {
                throw new RuntimeException("[oracle:maxulps-dim] metamorphic violation: point dimensions differ lhs="
                    + pointA.length + " rhs=" + pointB.length);
            }
            for (int i = 0; i < pointA.length; i++) {
                if (!Precision.equals(pointA[i], pointB[i], 1.0e-7)) {
                    throw new RuntimeException("[oracle:maxulps-point] metamorphic violation: identical LP solved with different maxUlps changed coordinate "
                        + i + " lhs=" + pointA[i] + " rhs=" + pointB[i] + " ulpsA=" + maxUlpsA + " ulpsB=" + maxUlpsB);
                }
            }
        }
    }

    private static void verifyConstructedUniqueOptimum(LinearObjectiveFunction f,
                                                       List<LinearConstraint> constraints,
                                                       PointValuePair solution,
                                                       int[] lowerBounds,
                                                       double epsilon,
                                                       String tag) {
        if (solution == null) {
            return;
        }
        double[] point = solution.getPoint();
        if (point == null || point.length != lowerBounds.length) {
            throw new RuntimeException("[oracle:point-shape] metamorphic violation: solution point has wrong dimension tag="
                + tag + " expected=" + lowerBounds.length + " actual=" + (point == null ? -1 : point.length));
        }

        if (!validSolution(solution, constraints, epsilon)) {
            throw new RuntimeException("[oracle:valid-constructed] metamorphic violation: solver returned a point that violates constraints tag="
                + tag + " value=" + solution.getValue());
        }

        double expectedValue = 0.0d;
        for (int i = 0; i < lowerBounds.length; i++) {
            if (!Precision.equals(point[i], lowerBounds[i], 1.0e-7)) {
                throw new RuntimeException("[oracle:known-optimum-point] metamorphic violation: constructed LP has unique optimum at lower bounds tag="
                    + tag + " index=" + i + " expected=" + lowerBounds[i] + " actual=" + point[i]);
            }
            expectedValue += (i + 1.0d) * lowerBounds[i];
        }

        double recomputedValue = f.getValue(point);
        if (!Precision.equals(recomputedValue, solution.getValue(), 1.0e-7)) {
            throw new RuntimeException("[oracle:objective-self] metamorphic violation: reported objective disagrees with objective evaluated at returned point tag="
                + tag + " reported=" + solution.getValue() + " recomputed=" + recomputedValue);
        }
        if (!Precision.equals(solution.getValue(), expectedValue, 1.0e-7)) {
            throw new RuntimeException("[oracle:known-optimum-value] metamorphic violation: constructed LP has unique optimum value derived from input tag="
                + tag + " expected=" + expectedValue + " actual=" + solution.getValue());
        }
    }

    private static void checkArtificialColumns(SimplexTableau tableau, int maxUlps, String tag) {
        int artificialCount = tableau.getNumArtificialVariables();
        int offset = tableau.getArtificialVariableOffset();
        int startRow = tableau.getNumObjectiveFunctions();
        int height = tableau.getHeight();
        int width = tableau.getWidth();

        if (artificialCount <= 0 || offset < 0 || offset + artificialCount > width - 1) {
            throw new RuntimeException("[oracle:artificial-range] metamorphic violation: invalid artificial variable range tag="
                + tag + " artificialCount=" + artificialCount + " offset=" + offset + " width=" + width);
        }

        for (int col = offset; col < offset + artificialCount; col++) {
            Integer reported = tableau.getBasicRow(col);
            Integer scanned = null;
            int unitMatches = 0;

            for (int row = startRow; row < height; row++) {
                boolean unitColumnAtRow = Precision.equals(tableau.getEntry(row, col), 1.0d, maxUlps);
                if (!unitColumnAtRow) {
                    continue;
                }
                boolean zerosElsewhere = true;
                for (int other = startRow; other < height; other++) {
                    if (other == row) {
                        continue;
                    }
                    if (!Precision.equals(tableau.getEntry(other, col), 0.0d, maxUlps)) {
                        zerosElsewhere = false;
                        break;
                    }
                }
                if (zerosElsewhere) {
                    unitMatches++;
                    scanned = row;
                }
            }

            if (unitMatches != 1) {
                throw new RuntimeException("[oracle:artificial-scan] metamorphic violation: expected exactly one basic unit row for artificial column tag="
                    + tag + " col=" + col + " matches=" + unitMatches + " reported=" + reported);
            }
            if (reported == null || !reported.equals(scanned)) {
                throw new RuntimeException("[oracle:basic-row-agree] metamorphic violation: getBasicRow disagrees with independent matrix scan tag="
                    + tag + " col=" + col + " reported=" + reported + " scanned=" + scanned);
            }
        }
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || t instanceof MathIllegalArgumentException;
    }

    private static boolean shouldPropagateRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getNumObjectiveFunctions".equals(m)
                        || "getHeight".equals(m)
                        || "getWidth".equals(m)
                        || "getEntry".equals(m)
                        || "getNumArtificialVariables".equals(m)
                        || "getArtificialVariableOffset".equals(m)
                        || "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.RealMatrix".equals(cls)
                    && ("getRowDimension".equals(m)
                        || "getColumnDimension".equals(m)
                        || "getEntry".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException propagate(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
