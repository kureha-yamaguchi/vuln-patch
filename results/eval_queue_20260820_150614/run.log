package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeAsciiString(8);
        char padChar = (char) (data.consumeByte() & 0xff);

        int base = data.consumeInt(10, 999999999);
        int value = data.consumeBoolean() ? -base : base;
        String asString = String.valueOf(value);
        if (asString.length() > 1) {
            int width = data.consumeInt(1, asString.length() - 1);
            runNullTextIntSibling(prefix, value, width, padChar);
        }

        String forced = data.consumeString(16);
        if (forced != null && forced.length() > 1) {
            int width = data.consumeInt(1, forced.length() - 1);
            runNullTextDirectVisibility(prefix, forced, width, padChar);
        }
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (IllegalArgumentException t) {
            return;
        } catch (NumberFormatException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (!"f".equals(sb.toString())) {
            throw new RuntimeException("[oracle:anchor-exact] metamorphic violation: exact trigger must produce leftmost width chars input=foo width=1 lhs=" + printable(sb.toString()) + " rhs=f");
        }
    }

    private static void runNullTextIntSibling(String prefix, int value, int width, char padChar) {
        String source = String.valueOf(value);
        if (width <= 0 || source.length() <= width) {
            return;
        }

        StrBuilder viaNull = new StrBuilder(1);
        StrBuilder viaInt = new StrBuilder(1);

        try {
            viaNull.append(prefix);
            viaNull.setNullText(source);
            viaNull.appendFixedWidthPadRight((Object) null, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (NumberFormatException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracle(t)) {
                throw t;
            }
            return;
        }

        try {
            viaInt.append(prefix);
            viaInt.appendFixedWidthPadRight(value, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (NumberFormatException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracle(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract used: both overloads append a fixed-width, right-padded representation
         * of the same textual value. The Object overload obtains its text from
         * (obj == null ? getNullText() : obj.toString()); therefore setting nullText to
         * String.valueOf(value) makes the null-object path represent exactly the same text
         * as the int overload's value. A throw-deleting or truncation-breaking patch in the
         * Object/nullText path will disagree with the sibling overload even if no exception
         * is thrown.
         */
        String lhs = viaNull.toString();
        String rhs = viaInt.toString();
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:int-null-sibling] metamorphic violation: nullText/Object overload disagrees with int overload prefix=" + printable(prefix) + " value=" + value + " width=" + width + " pad=" + (int) padChar + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
        }
    }

    private static void runNullTextDirectVisibility(String prefix, String source, int width, char padChar) {
        if (width <= 0 || source.length() <= width) {
            return;
        }

        StrBuilder sb = new StrBuilder(1);
        try {
            sb.append(prefix);
            sb.setNullText(source);
            sb.appendFixedWidthPadRight((Object) null, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (NumberFormatException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracle(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract used: when the source text is longer than width, appendFixedWidthPadRight
         * appends the leftmost width characters of that text. Here the text comes from
         * getNullText() on the real null-object path, so the resulting suffix must equal
         * source.substring(0, width) regardless of capacity growth.
         */
        String out = sb.toString();
        String suffix = out.substring(prefix.length());
        String expected = source.substring(0, width);
        if (!suffix.equals(expected)) {
            throw new RuntimeException("[oracle:nulltext-suffix] metamorphic violation: visible suffix must equal leftmost width chars from nullText prefix=" + printable(prefix) + " source=" + printable(source) + " width=" + width + " lhs=" + printable(suffix) + " rhs=" + printable(expected));
        }
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\u0000", "\\u0000");
    }
}
