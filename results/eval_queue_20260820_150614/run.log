package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        anchorExactFailingInput();

        double mean = data.consumeInt(-20, 20);
        double sigma = data.consumeInt(1, 10);

        // Property behind the patched line:
        // AbstractContinuousDistribution.inverseCumulativeProbability() brackets the root
        // starting from an initial guess. For NormalDistribution, the failing test reaches
        // bracket() with initial = mean + sigma, and the defect is exposed when the true
        // quantile is exactly at the first expanded endpoint initial + 1.
        //
        // We therefore construct valid probabilities as p = CDF(mean + sigma + 1), which
        // are accepted inputs by construction and steer execution through the real public API.
        double targetX = mean + sigma + 1.0;
        exerciseDistribution(mean, sigma, targetX);

        int extraCases = data.consumeInt(0, 4);
        for (int i = 0; i < extraCases; i++) {
            double mean2 = data.consumeInt(-50, 50);
            double sigma2 = data.consumeInt(1, 20);
            int offset = data.consumeInt(-3, 3);
            double targetX2 = mean2 + sigma2 + offset;

            // Fence to moderate magnitudes.
            if (targetX2 < -1_000_000.0 || targetX2 > 1_000_000.0) {
                continue;
            }
            exerciseDistribution(mean2, sigma2, targetX2);
        }
    }

    private static void anchorExactFailingInput() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);
            double p = 0.9772498680518209;
            double x;
            try {
                x = normal.inverseCumulativeProbability(p);
            } catch (MathException e) {
                if (isRootCauseFromInverseOrBracket(e)) {
                    throw new RuntimeException(
                            "[oracle:anchor-mass] valid standard-normal quantile rejected for p=" + p, e);
                }
                return;
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException e) {
                return;
            }

            // Contract used for this post-condition:
            // for a continuous distribution, cumulativeProbability(a, b) equals
            // cumulativeProbability(b) - cumulativeProbability(a). For the standard normal,
            // CDF(0) = 0.5, so on any successful inverse call with x = invCDF(p),
            // mass on [0, x] must equal p - 0.5 when x >= 0.
            // A throw-deleting patch that silently returns the wrong x would violate this.
            try {
                double intervalMass = normal.cumulativeProbability(0.0, x);
                double independentMass = p - normal.cumulativeProbability(0.0);
                if (!closeEnough(intervalMass, independentMass, 1.0e-12)) {
                    throw new RuntimeException(
                            "[oracle:anchor-mass] metamorphic violation: interval mass disagrees with CDF difference"
                                    + " p=" + p + " x=" + x
                                    + " intervalMass=" + intervalMass
                                    + " independentMass=" + independentMass);
                }
            } catch (MathException e) {
                return;
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException e) {
                throw e;
            }
        } catch (RuntimeException e) {
            throw e;
        }
    }

    private static void exerciseDistribution(double mean, double sigma, double targetX) {
        NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sigma);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        final double p;
        try {
            p = normal.cumulativeProbability(targetX);
        } catch (MathException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        if (!(p > 0.0 && p < 1.0)) {
            return;
        }

        final double x;
        try {
            x = normal.inverseCumulativeProbability(p);
        } catch (MathException e) {
            if (isRootCauseFromInverseOrBracket(e)) {
                throw new RuntimeException(
                        "[oracle:valid-inv] metamorphic violation: inverseCumulativeProbability rejected a probability "
                                + "constructed from the same distribution"
                                + " mean=" + mean + " sigma=" + sigma
                                + " targetX=" + targetX + " p=" + p, e);
            }
            return;
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        // Independent consistency cross-check:
        // For any normal distribution, CDF(mean) = 0.5.
        // Therefore the probability mass between mean and invCDF(p) must equal |p - 0.5|.
        // We obtain the SAME quantity two ways:
        //   1) cumulativeProbability(lo, hi)
        //   2) |cumulativeProbability(x) - cumulativeProbability(mean)|
        // If a band-aid patch suppresses the throw but returns a wrong quantile, these can disagree.
        try {
            double lo = Math.min(mean, x);
            double hi = Math.max(mean, x);
            double reportedMass = normal.cumulativeProbability(lo, hi);
            double independentMass = Math.abs(normal.cumulativeProbability(x) - normal.cumulativeProbability(mean));
            if (!closeEnough(reportedMass, independentMass, 1.0e-10)) {
                throw new RuntimeException(
                        "[oracle:interval-consistency] metamorphic violation: interval probability disagrees with CDF difference"
                                + " mean=" + mean + " sigma=" + sigma
                                + " targetX=" + targetX + " p=" + p + " x=" + x
                                + " reportedMass=" + reportedMass
                                + " independentMass=" + independentMass);
            }
        } catch (MathException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static boolean isRootCauseFromInverseOrBracket(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (hasRelevantFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.NormalDistributionImpl".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean closeEnough(double a, double b, double tol) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= tol * scale;
    }
}
