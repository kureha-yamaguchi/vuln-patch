                            + " min=" + c.min
                            + " max=" + c.max
                            + " initial=" + c.initial
                            + " result=" + lhs
                            + " tol=" + tol);
        }
    }

    private static void runCacheConsistencyCase(UnivariateRealFunction f, FuzzedDataProvider data) {
        IntervalCase c = buildValidCase(data);
        BisectionSolver solver = new BisectionSolver();

        try {
            /*
             * Contract/oracle:
             * A successful solve stores the computed solution as the solver's current result via setResult(...),
             * so solver.getResult() must equal the returned value from the same call. This is a consistency
             * cross-check obtained two ways from the real API: direct return value vs cached state.
             */
            double returned = solver.solve(f, c.min, c.max, c.initial);
            double cached = solver.getResult();
            double tol = Math.max(solver.getAbsoluteAccuracy(), 1e-12);

            if (Math.abs(returned - cached) > tol) {
                throw new RuntimeException(
                        "[oracle:cache-sync] metamorphic violation: returned root disagrees with solver cached result"
                                + " min=" + c.min
                                + " max=" + c.max
                                + " initial=" + c.initial
                                + " returned=" + returned
                                + " cached=" + cached
