            }
        }
        return true;
    }

    private static boolean approximatelyEqual(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            double av = a[i];
            double bv = b[i];
            if (Double.isNaN(av) || Double.isNaN(bv) || Double.isInfinite(av) || Double.isInfinite(bv)) {
