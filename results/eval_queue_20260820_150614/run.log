    private static void runBigExplore(FuzzedDataProvider data) {
        int cols = data.consumeInt(1, 4);
        int rows = cols + data.consumeInt(1, 4);

        BigDecimal[][] backing = new BigDecimal[rows][cols];
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                backing[r][c] = BigDecimal.valueOf(data.consumeInt(-20, 20));
            }
        }

        BigMatrixImpl m = new BigMatrixImpl(backing, false);

        if (m.getRowDimension() != rows || m.getColumnDimension() != cols) {
            throw new RuntimeException("[oracle:big-shape-ctor] metamorphic violation: constructor-reported shape input=" +
                rows + "x" + cols + " lhs=" + m.getRowDimension() + "x" + m.getColumnDimension() +
                " rhs=" + rows + "x" + cols);
        }

        /*
         * Contract used:
         * - BigMatrixImpl(BigDecimal[] v) creates a column matrix using v as data.
         * - operate(v) returns this * v.
         * - getEntry(row, col) exposes matrix entries.
         * With a one-hot vector e0 = [1,0,...,0], any correct implementation must return
         * the first column exactly, so out[row] == getEntry(row,0). Because copyArray=false
