        // if the string is longer than width, it is truncated to width.
        // A throw-deleting or branch-skipping patch would violate this observable result.
        String actual = sb.toString();
        if (!"f".equals(actual)) {
            throw new RuntimeException("[oracle:anchor] metamorphic violation: expected truncated fixed-width result input=foo width=1 lhs=" + actual + " rhs=f");
        }

        // Consistency cross-check on shared state: length()/toString()/toCharArray() all report the same size-backed content.
        int reportedLength = sb.length();
        int stringLength = actual.length();
        int arrayLength = sb.toCharArray().length;
        if (reportedLength != stringLength || reportedLength != arrayLength) {
            throw new RuntimeException("[oracle:state] consistency violation: reported=" + reportedLength + " string=" + stringLength + " array=" + arrayLength);
        }
