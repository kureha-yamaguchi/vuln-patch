        double x2 = data.consumeInt(-1000, 1000) / 16.0;
        double y2 = data.consumeInt(-1000, 1000) / 16.0;
        if (x1 == x2 && y1 == y2) {
            x2 += 1.0;
        }
        return new Line(new Vector2D(x1, y1), new Vector2D(x2, y2)).wholeHyperplane();
    }

    private static void verifyNoCutRegionContract(PolygonsSet polygon) {
        double size1 = polygon.getSize();
        Vector2D bary1 = (Vector2D) polygon.getBarycenter();
        double size2 = polygon.getSize();
        Vector2D bary2 = (Vector2D) polygon.getBarycenter();

        if (size1 != size2 || bary1.getX() != bary2.getX() || bary1.getY() != bary2.getY()) {
