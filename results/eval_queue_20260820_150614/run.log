package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException t) {
            if (isRootCauseNpeFromPatchedRegion(t) || isOracleFailure(t)) {
                throw t;
            }
        } catch (Throwable t) {
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throwUnchecked(t);
            }
        }

        int len = data.consumeInt(1, 8);
        Object[] array = new Object[len];

        boolean hasNull = false;
        boolean hasNonNull = false;

        for (int i = 0; i < len; i++) {
            int choice = data.consumeInt(0, 6);
            Object value;
            switch (choice) {
                case 0:
                    value = null;
                    break;
                case 1:
                    value = data.consumeString(24);
                    break;
                case 2:
                    value = Integer.valueOf(data.consumeInt(-1000000, 1000000));
                    break;
                case 3:
                    value = Double.valueOf((double) data.consumeInt(-1000000, 1000000));
                    break;
                case 4:
                    value = Long.valueOf((long) data.consumeInt(-1000000, 1000000));
                    break;
                case 5:
                    value = Boolean.valueOf(data.consumeBoolean());
                    break;
                default:
                    value = new StringBuilder(data.consumeAsciiString(16));
                    break;
            }
            array[i] = value;
            hasNull |= value == null;
            hasNonNull |= value != null;
        }

        if (!hasNull) {
            int idx = data.consumeInt(0, len - 1);
            array[idx] = null;
            hasNull = true;
        }
        if (!hasNonNull) {
            int idx = data.consumeInt(0, len - 1);
            array[idx] = "nonnull";
            hasNonNull = true;
        }

        try {
            exerciseToClassAndRoundTrip(array);
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCauseNpeFromPatchedRegion(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                return;
            }
        } catch (Throwable t) {
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runAnchor() {
        Class<?>[] nullArrayResult = ClassUtils.toClass(null);
        if (nullArrayResult != null) {
            throw new RuntimeException("[oracle:anchor-null-array] metamorphic violation: toClass(null) must return null lhs="
                    + String.valueOf(nullArrayResult) + " rhs=null");
        }

        Object[] anchor = new Object[] { "Test", null, Double.valueOf(99d) };
        Class<?>[] result = ClassUtils.toClass(anchor);

        if (result == null || result.length != 3
                || result[0] != String.class
                || result[1] != null
                || result[2] != Double.class) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: documented slot-preserving mapping for toClass failed");
        }

        roundTripClasses(result);
    }

    private static void exerciseToClassAndRoundTrip(Object[] array) {
        Class<?>[] result = ClassUtils.toClass(array);

        if (result == null) {
            throw new RuntimeException("[oracle:nonnull-array-result] metamorphic violation: non-null input array must not yield null result");
        }
        if (result.length != array.length) {
            throw new RuntimeException("[oracle:length-preserve] metamorphic violation: input length="
                    + array.length + " output length=" + result.length);
        }

        /*
         * Contract exercised by the upstream test:
         * ClassUtils.toClass(new Object[] {"Test", null, 99d})
         * must produce [String.class, null, Double.class].
         * Therefore, for every correct implementation, each output slot i is exactly
         * array[i].getClass() for non-null inputs and remains null for null inputs.
         * A throw-deleting or overfitted patch that merely suppresses the NPE but
         * drops/skips/misaligns null-adjacent elements violates this observable mapping.
         */
        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (result[i] != expected) {
                throw new RuntimeException("[oracle:slot-map] metamorphic violation: index=" + i
                        + " input=" + String.valueOf(array[i])
                        + " lhs=" + String.valueOf(result[i])
                        + " rhs=" + String.valueOf(expected));
            }
        }

        roundTripClasses(result);
    }

    private static void roundTripClasses(Class<?>[] classes) {
        ClassLoader contextCL = Thread.currentThread().getContextClassLoader();
        ClassLoader loader = contextCL == null ? ClassUtils.class.getClassLoader() : contextCL;

        for (int i = 0; i < classes.length; i++) {
            Class<?> cls = classes[i];
            if (cls == null) {
                continue;
            }
            String name = cls.getName();
            try {
                /*
                 * getClass(loader, name, initialize) delegates to Class.forName(...),
                 * so for a name obtained from a live Class object, all overloads must
                 * resolve back to that same Class object.
                 */
                Class<?> resolved1 = ClassUtils.getClass(name);
                Class<?> resolved2 = ClassUtils.getClass(loader, name, false);
                if (resolved1 != cls || resolved2 != cls) {
                    throw new RuntimeException("[oracle:getclass-roundtrip] metamorphic violation: index=" + i
                            + " name=" + name
                            + " lhs1=" + String.valueOf(resolved1)
                            + " lhs2=" + String.valueOf(resolved2)
                            + " rhs=" + String.valueOf(cls));
                }
            } catch (ClassNotFoundException e) {
                return;
            } catch (RuntimeException t) {
                if (isOracleFailure(t) || isRootCauseNpeFromPatchedRegion(t)) {
                    throw t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            } catch (Throwable t) {
                if (isRootCauseNpeFromPatchedRegion(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        }
    }

    private static boolean isRootCauseNpeFromPatchedRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("toClass".equals(m) || "getClass".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Validation") || name.contains("Invalid");
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static void throwUnchecked(Throwable t) {
        FuzzHarness.<RuntimeException>throwAny(t);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAny(Throwable t) throws T {
        throw (T) t;
    }
}
