package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorSeed();

        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-100, 100);
        double expectedRoot = k * Math.PI;

        int leftMilli = data.consumeInt(1, 1500);
        int rightMilli = data.consumeInt(1, 1500);
        double left = leftMilli / 10000.0 + 1.0e-6;
        double right = rightMilli / 10000.0 + 1.0e-6;

        double min = expectedRoot - left;
        double max = expectedRoot + right;
        if (!(min < max)) {
            return;
        }

        runEndpointExtremesCase(f, min, max);

        if (data.remainingBytes() >= 2) {
            int deltaL = data.consumeInt(0, 200);
            int deltaR = data.consumeInt(0, 200);
            double min2 = min + (deltaL / 100000.0);
            double max2 = max - (deltaR / 100000.0);
            if (min2 < expectedRoot && expectedRoot < max2 && min2 < max2) {
                runEndpointExtremesCase(f, min2, max2);
            }
        }
    }

    private static void runAnchorSeed() {
        UnivariateRealFunction f = new SinFunction();
        double min = 3.0;
        double max = 3.2;
        runEndpointExtremesCase(f, min, max);

        BisectionSolver solver = new BisectionSolver();
        try {
            double r = solver.solve(f, min, max, 3.1);
            double tol = solver.getAbsoluteAccuracy() * 4.0 + 1.0e-12;
            if (Math.abs(r - Math.PI) > tol) {
                throw new RuntimeException(
                        "[oracle:endpoint-anchor-pi] metamorphic violation: anchor seed should converge to the bracketed pi root"
                                + " min=" + min + " max=" + max + " initial=3.1"
                                + " result=" + r + " expected=" + Math.PI + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:endpoint-anchor-extremes] metamorphic violation: valid anchor solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min + " max=" + max + " initial=3.1",
                        t);
            }
        }
    }

    private static void runEndpointExtremesCase(UnivariateRealFunction f, double min, double max) {
        if (f == null || Double.isNaN(min) || Double.isNaN(max) || !(min < max)) {
            return;
        }

        final BisectionSolver leftSolver = new BisectionSolver();
        final double leftResult;
        try {
            leftResult = leftSolver.solve(f, min, max, min);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:endpoint-extremes] metamorphic violation: valid solve(f,min,max,min) threw NullPointerException"
                                + " min=" + min + " max=" + max,
                        t);
            }
            return;
        }

        final BisectionSolver rightSolver = new BisectionSolver();
        final double rightResult;
        try {
            rightResult = rightSolver.solve(f, min, max, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:endpoint-extremes] metamorphic violation: valid solve(f,min,max,max) threw NullPointerException"
                                + " min=" + min + " max=" + max,
                        t);
            }
            return;
        }

        /*
         * Contract used here: in BisectionSolver, solve(f,min,max,initial) delegates to the same
         * real bisection solve over (f,min,max). Therefore, choosing the initial guess at the left
         * endpoint or at the right endpoint must not change either the returned root or the amount
         * of work done. A throw-deleting or seed-special-casing patch can avoid the known crash yet
         * still make endpoint-adjacent inputs behave inconsistently.
         */
        double tol = Math.max(leftSolver.getAbsoluteAccuracy(), rightSolver.getAbsoluteAccuracy()) * 4.0 + 1.0e-12;
        if (Math.abs(leftResult - rightResult) > tol) {
            throw new RuntimeException(
                    "[oracle:endpoint-extremes] metamorphic violation: endpoint initial guesses disagreed on the same bracketed root"
                            + " min=" + min + " max=" + max
                            + " leftResult=" + leftResult
                            + " rightResult=" + rightResult
                            + " tol=" + tol);
        }

        int leftIterations = leftSolver.getIterationCount();
        int rightIterations = rightSolver.getIterationCount();
        if (leftIterations != rightIterations) {
            throw new RuntimeException(
                    "[oracle:endpoint-iterations] metamorphic violation: endpoint initial guesses changed deterministic bisection iteration count"
                            + " min=" + min + " max=" + max
                            + " leftIterations=" + leftIterations
                            + " rightIterations=" + rightIterations
                            + " leftResult=" + leftResult
                            + " rightResult=" + rightResult);
        }

        double leftCached = leftSolver.getResult();
        double rightCached = rightSolver.getResult();
        if (Math.abs(leftCached - leftResult) > tol || Math.abs(rightCached - rightResult) > tol) {
            throw new RuntimeException(
                    "[oracle:endpoint-cache-coherence] metamorphic violation: cached result disagreed with returned value after endpoint solve"
                            + " min=" + min + " max=" + max
                            + " leftReturned=" + leftResult + " leftCached=" + leftCached
                            + " rightReturned=" + rightResult + " rightCached=" + rightCached
                            + " tol=" + tol);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
                || name.contains("Invalid")
                || name.contains("NoData")
                || name.contains("NotPositive")
                || name.contains("OutOfRange")
                || name.contains("Argument");
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
