        cal.clear();
        cal.set(1970, Calendar.JANUARY, 1);
        cal.add(Calendar.DAY_OF_MONTH, epochOffset);
        return new Day(
                cal.get(Calendar.DAY_OF_MONTH),
                cal.get(Calendar.MONTH) + 1,
