    private static void checkExactMonthsAnchor(String id, MonthDay input, int amount, int expMonth, int expDay) {
        String before = input.toString();
        int beforeMonth = input.getMonthOfYear();
        int beforeDay = input.getDayOfMonth();
        try {
            MonthDay result = input.plusMonths(amount);
            if (result.getMonthOfYear() != expMonth || result.getDayOfMonth() != expDay) {
                throw new RuntimeException(
                        "[oracle:"
                                + id
                                + "] metamorphic violation: input="
                                + before
                                + " plusMonths("
                                + amount
                                + ") expected=--"
                                + two(expMonth)
                                + "-"
                                + two(expDay)
                                + " actual="
                                + result);
            }
            if (input.getMonthOfYear() != beforeMonth
                    || input.getDayOfMonth() != beforeDay
                    || !before.equals(input.toString())) {
                throw new RuntimeException(
                        "[oracle:"
                                + id
                                + "-immut] metamorphic violation: receiver mutated before="
                                + before
                                + " after="
                                + input.toString());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (stackHasPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:" + id + "] valid anchor input rejected: " + before + " amount=" + amount, t);
            }
        }
    }

