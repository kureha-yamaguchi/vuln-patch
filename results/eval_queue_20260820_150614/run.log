package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.chrono.ISOChronology;

public class FuzzHarness {
    private static final DateTimeZone LONDON = DateTimeZone.forID("Europe/London");
    private static final long TEST_TIME_NOW =
            (31L + 28L + 31L + 30L + 31L + 9L - 1L) * DateTimeConstants.MILLIS_PER_DAY;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone savedZone = DateTimeZone.getDefault();
        try {
            DateTimeUtils.setCurrentMillisFixed(TEST_TIME_NOW);
            DateTimeZone.setDefault(LONDON);

            runAnchorCases();

            int scenario = data.consumeInt(0, 5);
            MonthDay base;
            int amount;

            switch (scenario) {
                case 0:
                    base = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
                    amount = data.consumeInt(-24, 24);
                    exerciseMonths(base, amount);
                    break;
                case 1:
                    base = new MonthDay(3, 31, ISOChronology.getInstanceUTC());
                    amount = nonZero(data.consumeInt(-24, 24));
                    exerciseMonths(base, amount);
                    break;
                case 2:
                    base = new MonthDay(1, 31, ISOChronology.getInstanceUTC());
                    amount = nonZero(data.consumeInt(-24, 24));
                    exerciseMonths(base, amount);
                    break;
                case 3:
                    base = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
                    amount = nonZero(data.consumeInt(-370, 370));
                    exerciseDays(base, amount);
                    break;
                case 4:
                    base = buildValidMonthDay(data);
                    amount = data.consumeInt(-24, 24);
                    exerciseMonths(base, amount);
                    break;
                default:
                    base = buildValidMonthDay(data);
                    amount = data.consumeInt(-370, 370);
                    exerciseDays(base, amount);
                    break;
            }
        } finally {
            DateTimeZone.setDefault(savedZone);
            DateTimeUtils.setCurrentMillisSystem();
        }
    }

    private static void runAnchorCases() {
        MonthDay leap = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
        MonthDay march31 = new MonthDay(3, 31, ISOChronology.getInstanceUTC());

        checkExact(leap, leap.plusMonths(-1), new MonthDay(1, 29, ISOChronology.getInstance()), "anchor-plusMonths-negFromLeap");
        checkExact(leap, leap.minusDays(-1), new MonthDay(3, 1, ISOChronology.getInstance()), "anchor-minusDays-negFromLeap");
        checkExact(leap, leap.plusMonths(1), new MonthDay(3, 29, ISOChronology.getInstance()), "anchor-plusMonths-fromLeap");
        checkExact(march31, march31.plusMonths(-1), new MonthDay(2, 29, ISOChronology.getInstance()), "anchor-plusMonths-negEndOfMonth");
        checkExact(march31, march31.minusMonths(1), new MonthDay(2, 29, ISOChronology.getInstance()), "anchor-minusMonths-endOfMonth");
        checkExact(leap, leap.minusMonths(-1), new MonthDay(3, 29, ISOChronology.getInstance()), "anchor-minusMonths-negFromLeap");
        checkExact(leap, leap.minusMonths(1), new MonthDay(1, 29, ISOChronology.getInstance()), "anchor-minusMonths-fromLeap");
        checkExact(leap, leap.plusDays(1), new MonthDay(3, 1, ISOChronology.getInstance()), "anchor-plusDays-fromLeap");
    }

    private static void exerciseMonths(MonthDay base, int amount) {
        try {
            MonthDay viaConvenience = base.plusMonths(amount);
            MonthDay viaPatchedEntry = base.withFieldAdded(DurationFieldType.months(), amount);

            if (!viaConvenience.equals(viaPatchedEntry)) {
                throw new RuntimeException(
                        "[oracle:months-direct] metamorphic violation: plusMonths(amount) != withFieldAdded(months, amount)"
                                + " base=" + base + " amount=" + amount
                                + " lhs=" + viaConvenience + " rhs=" + viaPatchedEntry);
            }

            /*
             * Contract used for this check:
             * plusMonths(int) is defined in MonthDay as a convenience over the same month-addition semantics,
             * and withPeriodAdded(period, scalar) applies the supplied period. For a period containing only months,
             * both APIs must represent the same month adjustment for every valid MonthDay.
             * A patch that merely suppresses the throw or silently normalizes to the wrong date breaks this relation.
             */
            MonthDay viaPeriod = base.withPeriodAdded(Period.months(amount), 1);
            if (!viaConvenience.equals(viaPeriod)) {
                throw new RuntimeException(
                        "[oracle:months-period] metamorphic violation: plusMonths(amount) != withPeriodAdded(Period.months(amount), 1)"
                                + " base=" + base + " amount=" + amount
                                + " lhs=" + viaConvenience + " rhs=" + viaPeriod);
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            if (isOracle(e)) {
                throw e;
            }
        }
    }

    private static void exerciseDays(MonthDay base, int amount) {
        try {
            MonthDay viaConvenience = base.plusDays(amount);
            MonthDay viaPatchedEntry = base.withFieldAdded(DurationFieldType.days(), amount);

            if (!viaConvenience.equals(viaPatchedEntry)) {
                throw new RuntimeException(
                        "[oracle:days-direct] metamorphic violation: plusDays(amount) != withFieldAdded(days, amount)"
                                + " base=" + base + " amount=" + amount
                                + " lhs=" + viaConvenience + " rhs=" + viaPatchedEntry);
            }

            /*
             * Contract used for this check:
             * plusDays(int) and withPeriodAdded(Period.days(int), 1) express the same day adjustment on MonthDay.
             * This is an equivalent-input relation over real library APIs, so every correct implementation must agree.
             */
            MonthDay viaPeriod = base.withPeriodAdded(Period.days(amount), 1);
            if (!viaConvenience.equals(viaPeriod)) {
                throw new RuntimeException(
                        "[oracle:days-period] metamorphic violation: plusDays(amount) != withPeriodAdded(Period.days(amount), 1)"
                                + " base=" + base + " amount=" + amount
                                + " lhs=" + viaConvenience + " rhs=" + viaPeriod);
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            if (isOracle(e)) {
                throw e;
            }
        }
    }

    private static MonthDay buildValidMonthDay(FuzzedDataProvider data) {
        int month = data.consumeInt(1, 12);
        DateTime chronoDate = new DateTime(2004, month, 1, 0, 0, ISOChronology.getInstanceUTC());
        int maxDay = chronoDate.dayOfMonth().getMaximumValue();
        int day = data.consumeInt(1, maxDay);
        return new MonthDay(month, day, ISOChronology.getInstanceUTC());
    }

    private static int nonZero(int value) {
        return value == 0 ? 1 : value;
    }

    private static void checkExact(MonthDay input, MonthDay actual, MonthDay expected, String id) {
        if (!expected.equals(actual)) {
            throw new RuntimeException(
                    "[oracle:" + id + "] metamorphic violation: exact documented MonthDay result mismatch"
                            + " input=" + input + " expected=" + expected + " actual=" + actual);
        }
    }

    private static boolean isRootCause(RuntimeException e) {
        if (!(e instanceof IllegalFieldValueException)) {
            return false;
        }
        for (StackTraceElement ste : e.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.joda.time.MonthDay".equals(cls) && "withFieldAdded".equals(method)) {
                return true;
            }
            if ("org.joda.time.field.FieldUtils".equals(cls) && "verifyValueBounds".equals(method)) {
                return true;
            }
            if ("org.joda.time.DateTimeField".equals(cls) && "add".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(RuntimeException e) {
        return (e instanceof IllegalArgumentException)
                || (e instanceof NumberFormatException)
                || (e instanceof IllegalStateException && e.getClass().getName().startsWith("org.joda.time."));
    }

    private static boolean isOracle(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
}
