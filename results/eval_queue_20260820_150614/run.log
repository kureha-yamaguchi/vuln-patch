package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-100, 100);
        double root = k * Math.PI;

        double delta = 0.01 + (data.consumeInt(0, 1000) / 1000.0) * 0.75;
        double min = root - delta;
        double max = root + delta;

        double initial;
        switch (data.consumeInt(0, 6)) {
            case 0:
                initial = min;
                break;
            case 1:
                initial = max;
                break;
            case 2:
                initial = (min + max) / 2.0;
                break;
            case 3:
                initial = min + delta * 1e-12;
                break;
            case 4:
                initial = max - delta * 1e-12;
                break;
            case 5:
                initial = clampToInterval(root + scaledOffset(data.consumeInt(), delta), min, max);
                break;
            default:
                initial = clampToInterval(root + scaledOffset(data.consumeInt(), delta * 2.0), min, max);
                break;
        }

        runBoundaryCase(f, min, max, initial);
    }

    private static void runAnchor() {
        runBoundaryCase(new SinFunction(), 3.0, 3.2, 3.1);
    }

    private static void runBoundaryCase(UnivariateRealFunction f, double min, double max, double initial) {
        BisectionSolver solver = new BisectionSolver();
        final double result;
        try {
            result = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:boundary-membership] metamorphic violation: valid solve(f,min,max,initial) for SinFunction threw NullPointerException"
                                + " min=" + min + " max=" + max + " initial=" + initial,
                        t);
            }
            return;
        }

        /*
         * Post-condition: Bisection maintains a bracketing interval and returns the midpoint of the final
         * bracket, so a correct result must remain within the original interval (up to solver accuracy).
         * A band-aid patch that avoids the crash by skipping the real solve path or returning a stale/default
         * value can violate this even when no exception is thrown.
         */
        double tol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;
        if (result < min - tol || result > max + tol) {
            throw new RuntimeException(
                    "[oracle:boundary-membership] metamorphic violation: result escaped bracketing interval"
                            + " min=" + min + " max=" + max + " initial=" + initial + " result=" + result
                            + " tol=" + tol);
        }

        double mirroredInitial = clampToInterval(min + max - initial, min, max);
        BisectionSolver solver2 = new BisectionSolver();
        final double mirroredResult;
        try {
            mirroredResult = solver2.solve(f, min, max, mirroredInitial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:edge-flip] metamorphic violation: mirrored valid solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min + " max=" + max + " initial=" + initial
                                + " mirroredInitial=" + mirroredInitial,
                        t);
            }
            return;
        }

        /*
         * Metamorphic relation for this harness's strategy (flip the patched condition around the interval
         * boundary): for the same valid bracketing interval containing a unique SinFunction root, choosing an
         * initial guess near the left edge or its mirrored point near the right edge must still converge to
         * the same root within solver accuracy.
         */
        double pairTol = Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()) * 4.0 + 1e-12;
        if (Math.abs(result - mirroredResult) > pairTol) {
            throw new RuntimeException(
                    "[oracle:edge-flip] metamorphic violation: mirrored initial guesses disagreed on same bracketed root"
                            + " min=" + min + " max=" + max
                            + " initial=" + initial + " mirroredInitial=" + mirroredInitial
                            + " lhs=" + result + " rhs=" + mirroredResult
                            + " tol=" + pairTol);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || isNamedLikeValidationException(t);
    }

    private static boolean isNamedLikeValidationException(Throwable t) {
        String name = t.getClass().getName();
        return name.contains("Convergence")
                || name.contains("MaxIterationsExceeded")
                || name.contains("FunctionEvaluation")
                || name.contains("Invalid")
                || name.contains("NoBracketing");
    }

    private static boolean isRootCauseNpeFromPatchedRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                    && "solve".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static double clampToInterval(double v, double min, double max) {
        if (v < min) {
            return min;
        }
        if (v > max) {
            return max;
        }
        return v;
    }

    private static double scaledOffset(int raw, double scale) {
        long positive = raw & 0x7fffffffL;
        double unit = positive / (double) Integer.MAX_VALUE;
        return (unit * 2.0 - 1.0) * scale;
    }
}
