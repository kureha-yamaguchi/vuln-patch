    private static void runScenario(String prefix, String obj, int width, char padChar, int initialCapacity, boolean minimizeBeforeCall) {
        StrBuilder actual = new StrBuilder(initialCapacity);
        try {
            actual.append(prefix);
            if (minimizeBeforeCall) {
                actual.minimizeCapacity();
            }
            actual.appendFixedWidthPadRight((Object) obj, width, padChar);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
