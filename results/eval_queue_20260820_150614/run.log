package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            // Contract used below:
            // - deleteFirst(String): deletes the first occurrence if present.
            // - replaceFirst(String,String): if the search string is absent, the builder must be unchanged.
            // - replaceAll(String,String): if the search string is absent, the builder must be unchanged.
            // We build two logically identical builders with the same visible content:
            // one "stale" builder created via deleteFirst on "...<needle>", and one fresh builder
            // from the stale builder's visible toString(). Any correct implementation must make
            // subsequent replaceFirst/replaceAll behave identically on both. A throw-deleting patch
            // or a patch that merely hides one symptom but leaves stale-tail matching in indexOf
            // will violate this agreement.

            runReplaceAgreementCase("onetwo", "three", "X", true, "pad");

            int cases = 1 + (data.remainingBytes() > 0 ? data.consumeInt(1, 3) : 1);
            for (int i = 0; i < cases; i++) {
                String needle = data.consumeAsciiString(12);
                if (needle.length() == 0) {
                    needle = "X";
                }

                String prefix = data.consumeAsciiString(24);
                prefix = removeAllOccurrences(prefix, needle);
                if (prefix.length() == 0) {
                    prefix = "P";
                }

                String replacement = data.consumeAsciiString(8);
                if (replacement.length() == 0) {
                    replacement = "R";
                }

                boolean perturb = data.consumeBoolean();
                String extra = data.consumeAsciiString(12);
                runReplaceAgreementCase(prefix, needle, replacement, perturb, extra);
            }
        } catch (RuntimeException e) {
            if (isOracle(e) || isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
        } catch (Error e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void runReplaceAgreementCase(String prefix, String needle, String replacement,
                                                boolean perturbCapacity, String extraJunk) {
        if (needle == null || needle.length() == 0) {
            return;
        }
        if (prefix == null) {
            return;
        }
        prefix = removeAllOccurrences(prefix, needle);
        if (prefix.length() == 0) {
            prefix = "P";
        }
        if (replacement == null || replacement.length() == 0) {
            replacement = "R";
        }
        if (extraJunk == null) {
            extraJunk = "";
        }

        StrBuilder stale = new StrBuilder(prefix + needle);
        if (perturbCapacity) {
            stale.ensureCapacity(stale.length() + extraJunk.length() + 8);
            stale.append(extraJunk);
            stale.setLength(prefix.length() + needle.length());
        }

        stale.deleteFirst(needle);

        String visible = stale.toString();
        if (!prefix.equals(visible)) {
            throw new RuntimeException("[oracle:deletefirst-post] expected visible content after deleting unique tail needle to equal prefix; prefix="
                    + quote(prefix) + " needle=" + quote(needle) + " visible=" + quote(visible));
        }

        char[] chars = stale.toCharArray();
        if (chars.length != stale.length()) {
            throw new RuntimeException("[oracle:chararray-len] toCharArray length must equal builder length; len="
                    + stale.length() + " charArrayLen=" + chars.length);
        }

        StrBuilder freshForFirst = new StrBuilder(visible);
        String staleBeforeFirst = stale.toString();
        String freshBeforeFirst = freshForFirst.toString();

        stale.replaceFirst(needle, replacement);
        freshForFirst.replaceFirst(needle, replacement);

        String staleAfterFirst = stale.toString();
        String freshAfterFirst = freshForFirst.toString();
        if (!staleAfterFirst.equals(freshAfterFirst)) {
            throw new RuntimeException("[oracle:replacefirst-agree] stale and fresh builders with identical visible content diverged on replaceFirst; prefix="
                    + quote(prefix) + " needle=" + quote(needle) + " replacement=" + quote(replacement)
                    + " staleBefore=" + quote(staleBeforeFirst) + " freshBefore=" + quote(freshBeforeFirst)
                    + " staleAfter=" + quote(staleAfterFirst) + " freshAfter=" + quote(freshAfterFirst));
        }
        if (!staleBeforeFirst.equals(staleAfterFirst)) {
            throw new RuntimeException("[oracle:replacefirst-noop] replaceFirst on absent search string must not change content; prefix="
                    + quote(prefix) + " needle=" + quote(needle) + " replacement=" + quote(replacement)
                    + " before=" + quote(staleBeforeFirst) + " after=" + quote(staleAfterFirst));
        }

        StrBuilder staleAll = new StrBuilder(prefix + needle);
        if (perturbCapacity) {
            staleAll.ensureCapacity(staleAll.length() + extraJunk.length() + 8);
            staleAll.append(extraJunk);
            staleAll.setLength(prefix.length() + needle.length());
            staleAll.minimizeCapacity();
            staleAll.ensureCapacity(staleAll.length() + needle.length() + 4);
        }
        staleAll.deleteFirst(needle);

        StrBuilder freshForAll = new StrBuilder(staleAll.toString());
        String staleBeforeAll = staleAll.toString();
        String freshBeforeAll = freshForAll.toString();

        staleAll.replaceAll(needle, replacement);
        freshForAll.replaceAll(needle, replacement);

        String staleAfterAll = staleAll.toString();
        String freshAfterAll = freshForAll.toString();
        if (!staleAfterAll.equals(freshAfterAll)) {
            throw new RuntimeException("[oracle:replaceall-agree] stale and fresh builders with identical visible content diverged on replaceAll; prefix="
                    + quote(prefix) + " needle=" + quote(needle) + " replacement=" + quote(replacement)
                    + " staleBefore=" + quote(staleBeforeAll) + " freshBefore=" + quote(freshBeforeAll)
                    + " staleAfter=" + quote(staleAfterAll) + " freshAfter=" + quote(freshAfterAll));
        }
        if (!staleBeforeAll.equals(staleAfterAll)) {
            throw new RuntimeException("[oracle:replaceall-noop] replaceAll on absent search string must not change content; prefix="
                    + quote(prefix) + " needle=" + quote(needle) + " replacement=" + quote(replacement)
                    + " before=" + quote(staleBeforeAll) + " after=" + quote(staleAfterAll));
        }
    }

    private static String removeAllOccurrences(String s, String needle) {
        if (s == null || needle == null || needle.length() == 0) {
            return s;
        }
        while (s.indexOf(needle) >= 0) {
            s = s.replace(needle, "");
        }
        return s;
    }

    private static boolean isOracle(Throwable t) {
        return t != null && t.getMessage() != null && t.getMessage().contains("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())
                    && "indexOf".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
