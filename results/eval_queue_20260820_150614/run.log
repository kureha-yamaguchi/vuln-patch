            double p = data.consumeInt(1, 999) / 1000.0d;

            NormalDistributionImpl fresh = new NormalDistributionImpl(mean, sd);
            NormalDistributionImpl mutated = new NormalDistributionImpl(0, 1);
            mutated.setMean(mean);
            mutated.setStandardDeviation(sd);

