public class FuzzHarness {
    private static final class CountingPlotChangeListener implements PlotChangeListener {
        int count;
        public void plotChanged(PlotChangeEvent event) {
            count++;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String category = data.consumeAsciiString(32);
        if (category == null || category.length() == 0) {
            category = "Category 1";
        }
        int index = data.consumeInt(0, 3);
        double value = data.consumeInt(-1000, 1000) / 10.0d;
        boolean notify = data.consumeBoolean();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;

        anchorCategoryPlot(category, value);
        anchorXYPlot(value);

        exerciseCategoryPlotBoundary(category, value, index, layer, notify);
        exerciseXYPlotBoundary(value, index, layer, notify);
    }

    private static void anchorCategoryPlot(String category, double value) {
        CategoryPlot plot1 = new CategoryPlot();
        try {
            boolean removed = plot1.removeRangeMarker(new ValueMarker(value));
            if (removed) {
                throw new RuntimeException("[oracle:anchor-cat-range] metamorphic violation: removing a non-existent range marker from a fresh plot must return false");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

