package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeAsciiString(8);
        char pad = (char) (data.consumeByte() & 0xff);

        int value = data.consumeInt(100, 999999);
        String valueStr = String.valueOf(value);
        int width = data.consumeInt(1, Math.max(1, valueStr.length() - 1));
        runIntSibling(prefix, value, width, pad);

        String nullText = data.consumeAsciiString(16);
        if (nullText.length() == 0) {
