        if (isOracleFailure(t)) {
            throwUnchecked(t);
            return;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCauseThrowable(t)) {
            throwUnchecked(t);
            return;
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Validation")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCauseThrowable(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException) && !isAssertionFailureFamily(t)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("indexOf".equals(method) || "deleteImpl".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isAssertionFailureFamily(Throwable t) {
        String name = t.getClass().getName();
        return name.endsWith("AssertionFailedError") || name.endsWith("AssertionError");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static char mappedVisibleAscii(byte b) {
        int v = b & 0xff;
        return (char) (32 + (v % 95));
    }

    private static String repeat(char ch, int len) {
        StringBuffer sb = new StringBuffer(len);
        for (int i = 0; i < len; i++) {
            sb.append(ch);
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return String.valueOf(s).replace("\n", "\\n").replace("\r", "\\r");
    }
}
