package org.apache.commons.math.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runRealAnchor();
        runBigAnchor();

        int cols = data.consumeInt(1, 6);
        int extraRows = data.consumeInt(1, 6);
        int rows = cols + extraRows;

        double[][] realData = new double[rows][cols];
        BigDecimal[][] bigData = new BigDecimal[rows][cols];
        double[] realVec = new double[cols];
        BigDecimal[] bigVec = new BigDecimal[cols];

        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                int v = data.consumeInt(-20, 20);
                realData[r][c] = v;
                bigData[r][c] = BigDecimal.valueOf(v);
            }
        }
        for (int i = 0; i < cols; i++) {
            int v = data.consumeInt(-20, 20);
            realVec[i] = v;
            bigVec[i] = BigDecimal.valueOf(v);
        }

        runRealCase(realData, realVec);
        runBigCase(bigData, bigVec);
        checkBigRealOperateAgreement(bigData, bigVec, realData, realVec);
        checkRealNormConsistency(realData);
        checkBigNormConsistency(bigData);
    }

    private static void runRealAnchor() {
        double[][] m = new double[][] {
            { 1, 2 }, { 3, 4 }, { 5, 6 }
        };
        double[] v = new double[] { 1, 1 };
        runRealCase(m, v);
    }

    private static void runBigAnchor() {
        BigDecimal[][] m = new BigDecimal[][] {
            { BigDecimal.ONE, BigDecimal.valueOf(2) },
            { BigDecimal.valueOf(3), BigDecimal.valueOf(4) },
            { BigDecimal.valueOf(5), BigDecimal.valueOf(6) }
        };
        BigDecimal[] v = new BigDecimal[] { BigDecimal.ONE, BigDecimal.ONE };
        runBigCase(m, v);
    }

    private static void runRealCase(double[][] matrixData, double[] vector) {
        RealMatrixImpl m = new RealMatrixImpl(matrixData, false);
        try {
            double[] out = m.operate(vector);

            if (out.length != m.getRowDimension()) {
                throw new RuntimeException("[oracle:real-rowlen] metamorphic violation: operate output length must equal row dimension rows="
                        + m.getRowDimension() + " outLen=" + out.length);
            }

            if (isAnchorMatrix(matrixData, vector)) {
                requireClose(out.length > 0 ? out[0] : Double.NaN, 3.0, "[oracle:real-anchor]");
                requireClose(out.length > 1 ? out[1] : Double.NaN, 7.0, "[oracle:real-anchor]");
                requireClose(out.length > 2 ? out[2] : Double.NaN, 11.0, "[oracle:real-anchor]");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isRealOperateRootCause(e)) {
                throw e;
            }
        }
    }

    private static void runBigCase(BigDecimal[][] matrixData, BigDecimal[] vector) {
        BigMatrixImpl m = new BigMatrixImpl(matrixData, false);
        try {
            BigDecimal[] out = m.operate(vector);

            if (out.length != m.getRowDimension()) {
                throw new RuntimeException("[oracle:big-rowlen] metamorphic violation: operate output length must equal row dimension rows="
                        + m.getRowDimension() + " outLen=" + out.length);
            }

            if (isAnchorMatrix(matrixData, vector)) {
                requireBigEquals(out.length > 0 ? out[0] : null, BigDecimal.valueOf(3), "[oracle:big-anchor]");
                requireBigEquals(out.length > 1 ? out[1] : null, BigDecimal.valueOf(7), "[oracle:big-anchor]");
                requireBigEquals(out.length > 2 ? out[2] : null, BigDecimal.valueOf(11), "[oracle:big-anchor]");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
        }
    }

    private static void checkBigRealOperateAgreement(
            BigDecimal[][] bigMatrixData,
            BigDecimal[] bigVector,
            double[][] realMatrixData,
            double[] realVector) {
        BigMatrixImpl big = new BigMatrixImpl(bigMatrixData, false);
        RealMatrixImpl real = new RealMatrixImpl(realMatrixData, false);

        try {
            BigDecimal[] bigOut = big.operate(bigVector);
            double[] realOut = real.operate(realVector);

            if (bigOut.length != realOut.length) {
                throw new RuntimeException("[oracle:big-real-agree] metamorphic violation: equivalent Big/Real operate calls returned different lengths bigLen="
                        + bigOut.length + " realLen=" + realOut.length);
            }

            for (int i = 0; i < bigOut.length; i++) {
                double bd = bigOut[i].doubleValue();
                if (bd != realOut[i]) {
                    throw new RuntimeException("[oracle:big-real-agree] metamorphic violation: equivalent Big/Real operate calls disagreed at index="
                            + i + " big=" + bd + " real=" + realOut[i]);
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isRealOperateRootCause(e)) {
                throw e;
            }
        }
    }

    private static void checkRealNormConsistency(double[][] matrixData) {
        RealMatrixImpl m = new RealMatrixImpl(matrixData, false);
        try {
            double reported = m.getNorm();
            double independent = 0.0;
            for (int r = 0; r < matrixData.length; r++) {
                double rowSum = 0.0;
                for (int c = 0; c < matrixData[r].length; c++) {
                    rowSum += Math.abs(matrixData[r][c]);
                }
                if (rowSum > independent) {
                    independent = rowSum;
                }
            }
            if (Math.abs(reported - independent) > 1.0e-12) {
                throw new RuntimeException("[oracle:real-norm] consistency violation: reported=" + reported
                        + " independent=" + independent);
            }
