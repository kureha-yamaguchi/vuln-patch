                        "[oracle:cache-root] metamorphic violation: valid SinFunction solve missed constructed root"
                                + " min=" + c.min
                                + " max=" + c.max
                                + " initial=" + c.initial
                                + " expectedRoot=" + c.root
                                + " returned=" + returned
                                + " tol=" + rootTol);
