    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ANCHOR_DATA.length; i++) {
            fitter.addObservedPoint((double) i, ANCHOR_DATA[i]);
        }
        runChecksOnValidFitter(fitter, true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int n = data.consumeInt(3, 40);
        double amplitude = positiveFinite(data.consumeInt(-1000, 1000)) + 1.0;
        double xStart = data.consumeInt(-50, 50);
        double step = data.consumeBoolean() ? 1.0 : (positiveFinite(data.consumeInt(1, 10)) / 10.0);
        double maxX = xStart + step * (n - 1);
        double mean = maxX + positiveFinite(data.consumeInt(0, 120));
        double sigma = (positiveFinite(data.consumeInt(1, 200)) / 20.0) + 0.05;
        double noiseScale = positiveFinite(data.consumeInt(0, 20)) * 1e-6;

        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < n; i++) {
            double x = xStart + i * step;
            double y = amplitude * Math.exp(-((x - mean) * (x - mean)) / (2.0 * sigma * sigma));
            if (noiseScale > 0.0) {
                int s = data.consumeInt(-1000, 1000);
                y += Math.abs(s) * noiseScale;
            }
            if (!(y >= 0.0) || Double.isNaN(y) || Double.isInfinite(y)) {
                y = 0.0;
            }
            fitter.addObservedPoint(x, y);
        }
        runChecksOnValidFitter(fitter, false);
    }

    private static void runChecksOnValidFitter(GaussianFitter fitter, boolean allowRootCausePropagation) {
        try {
            // Contract from the reachable implementation:
            // ParameterGuesser.guess() caches parameters internally and returns parameters.clone().
            // Therefore repeated calls on the same observations must be stable, and mutating one returned
            // array must not affect later results. A throw-deleting patch elsewhere cannot fake this.
            WeightedObservedPoint[] observations = fitter.getObservations();
            GaussianFitter.ParameterGuesser guesser = new GaussianFitter.ParameterGuesser(observations);
            double[] g1 = guesser.guess();
            double[] g2 = guesser.guess();
            if (g1 == g2) {
                throw new RuntimeException("[oracle:guess-clone] metamorphic violation: guess() returned same array instance");
            }
            if (!sameArray(g1, g2, 0.0)) {
                throw new RuntimeException("[oracle:guess-stable] metamorphic violation: repeated guess() changed values");
            }
            if (g1.length > 0) {
                double old = g1[0];
                g1[0] = old + 123.456;
                double[] g3 = guesser.guess();
                if (g3.length > 0 && almostEqual(g3[0], g1[0], 0.0)) {
                    throw new RuntimeException("[oracle:guess-clone] metamorphic violation: external mutation of returned guess affected later guess()");
                }
                if (!sameArray(g2, g3, 0.0)) {
                    throw new RuntimeException("[oracle:guess-idempotent] metamorphic violation: guess() changed after external mutation of prior result");
                }
            }

            // Equivalent-overload relation from the patched code path:
            // fit() computes a ParameterGuesser guess from getObservations() and then delegates to fit(double[]).
            // For valid observation sets, both entrypoints should therefore agree when given the same initial guess.
            GaussianFitter fitterA = cloneFitter(fitter);
            GaussianFitter fitterB = cloneFitter(fitter);
            double[] initialGuess = new GaussianFitter.ParameterGuesser(fitterA.getObservations()).guess();

            double[] viaExplicit;
            try {
                viaExplicit = fitterA.fit(initialGuess);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (allowRootCausePropagation && isRootCause(t)) {
                    throwUnchecked(t);
                }
                return;
            }

            double[] viaImplicit;
            try {
                viaImplicit = fitterB.fit();
            } catch (Throwable t) {
                if (allowRootCausePropagation && isRootCause(t)) {
                    throwUnchecked(t);
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            }

            if (viaExplicit != null && viaImplicit != null && viaExplicit.length == viaImplicit.length) {
                if (!sameArray(viaExplicit, viaImplicit, 1.0e-6)) {
                    throw new RuntimeException(
                        "[oracle:fit-eq] metamorphic violation: fit() disagrees with fit(guess())"
                        + " lhs=" + arrayToString(viaImplicit)
                        + " rhs=" + arrayToString(viaExplicit));
                }
            }
        } catch (Throwable t) {
            if (allowRootCausePropagation && isRootCause(t)) {
                throwUnchecked(t);
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static GaussianFitter cloneFitter(GaussianFitter src) {
        GaussianFitter dst = new GaussianFitter(new LevenbergMarquardtOptimizer());
        WeightedObservedPoint[] pts = src.getObservations();
        for (int i = 0; i < pts.length; i++) {
            WeightedObservedPoint p = pts[i];
            dst.addObservedPoint(p.getWeight(), p.getX(), p.getY());
        }
        return dst;
    }

    private static boolean isRootCause(Throwable t) {
        if (t == null) {
            return false;
        }
        if (!"org.apache.commons.math.exception.NotStrictlyPositiveException".equals(t.getClass().getName())) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if (("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls) && "fit".equals(method))
                || ("org.apache.commons.math.optimization.fitting.GaussianFitter$ParameterGuesser".equals(cls) && "guess".equals(method))
                || ("org.apache.commons.math.optimization.fitting.CurveFitter".equals(cls) && "getObservations".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.startsWith("org.apache.commons.math.exception.")) {
            return true;
        }
        Throwable cause = t.getCause();
        if (cause != null && cause != t) {
            return isCleanRejection(cause);
        }
        return false;
    }

    private static boolean sameArray(double[] a, double[] b, double tol) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (!almostEqual(a[i], b[i], tol)) {
                return false;
            }
        }
        return true;
    }

    private static boolean almostEqual(double a, double b, double tol) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= tol * scale;
    }

    private static String arrayToString(double[] a) {
        if (a == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(a[i]);
        }
        sb.append(']');
        return sb.toString();
    }

    private static double positiveFinite(int v) {
        if (v == Integer.MIN_VALUE) {
            return 0.0;
        }
        return Math.abs((double) v);
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
