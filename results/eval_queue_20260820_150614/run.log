package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exactAnchorButDoNotDuplicateKnownCrash();
        probePatchedDispatchWithMismatchedCachedFunction(data);
    }

    private static void exactAnchorButDoNotDuplicateKnownCrash() {
        BisectionSolver solver = new BisectionSolver();
        UnivariateRealFunction f = new SinFunction();
        try {
            double r = solver.solve(f, 3.0, 3.2, 3.1);
            double tol = Math.max(1.0e-5, solver.getAbsoluteAccuracy() * 8.0);
            if (Math.abs(r - Math.PI) > tol) {
                throw new RuntimeException("[oracle:anchor-pi] metamorphic violation: canonical sin root not recovered input=[3.0,3.2], initial=3.1 result=" + r + " expected=" + Math.PI);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthRootCause(t)) {
                return;
            }
        }
    }

    private static void probePatchedDispatchWithMismatchedCachedFunction(FuzzedDataProvider data) {
        int k = data.consumeInt(-10, 10);
        double center = k * Math.PI;

        double left = 0.05 + (data.consumeInt(0, 350) / 1000.0);
        double right = 0.05 + (data.consumeInt(0, 350) / 1000.0);
        double min = center - left;
        double max = center + right;

        double room = Math.min(left, right);
        double shiftMag = Math.max(0.01, room * (0.25 + (data.consumeInt(0, 40) / 100.0)));
        double shift = data.consumeBoolean() ? shiftMag : -shiftMag;
        double cachedRoot = center + shift;

        double initial;
        switch (data.consumeInt(0, 4)) {
            case 0:
                initial = min + (max - min) * 0.01;
                break;
            case 1:
                initial = max - (max - min) * 0.01;
                break;
            case 2:
                initial = center;
                break;
            case 3:
                initial = (min + max) / 2.0;
                break;
            default:
                initial = center + (data.consumeBoolean() ? 1 : -1) * room * 0.49;
                if (initial <= min) {
                    initial = min + 1.0e-6;
                }
                if (initial >= max) {
                    initial = max - 1.0e-6;
                }
                break;
        }

        PolynomialFunction cachedLinear = new PolynomialFunction(new double[] { -cachedRoot, 1.0 });
        SinFunction requested = new SinFunction();

        BisectionSolver fieldSolver = new BisectionSolver();
        fieldSolver.f = cachedLinear;
        try {
            double fieldResult = fieldSolver.solve(min, max);
            double fieldTol = Math.max(1.0e-5, fieldSolver.getAbsoluteAccuracy() * 8.0);
            if (Math.abs(fieldResult - cachedRoot) > fieldTol) {
                throw new RuntimeException("[oracle:field-root] metamorphic violation: solve(min,max) with installed linear function did not recover constructed root interval=[" + min + "," + max + "] cachedRoot=" + cachedRoot + " result=" + fieldResult);
            }
        } catch (Throwable t) {
            if (isBenign(t)) {
                return;
            }
            return;
        }

        BisectionSolver dispatchSolver = new BisectionSolver();
        dispatchSolver.f = cachedLinear;
        try {
            double dispatched = dispatchSolver.solve(requested, min, max, initial);
            double tol = Math.max(1.0e-5, dispatchSolver.getAbsoluteAccuracy() * 8.0);

            /*
             * Contract used for this oracle:
             * solve(f, min, max, initial) must solve for the function argument f.
             * A throw-deleting or overfit patch that still consults the receiver's cached f
             * instead of the passed argument will return the cached linear root here,
             * not the known sin root center. Both sides are real library computations.
             */
            if (Math.abs(dispatched - center) > tol) {
                throw new RuntimeException("[oracle:dispatch-arg-wins] metamorphic violation: solve(f,min,max,initial) ignored the supplied function interval=[" + min + "," + max + "] initial=" + initial + " expectedSinRoot=" + center + " cachedLinearRoot=" + cachedRoot + " result=" + dispatched);
            }

            if (dispatched < min - tol || dispatched > max + tol) {
                throw new RuntimeException("[oracle:interval-bound] metamorphic violation: returned root left documented interval interval=[" + min + "," + max + "] result=" + dispatched);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && hasSolveFrame(t)) {
                throw (RuntimeException) t;
            }
            if (isGroundTruthRootCause(t)) {
                return;
            }
        }
    }

    private static boolean isGroundTruthRootCause(Throwable t) {
        return t instanceof NullPointerException && hasSolveFrame(t);
    }

    private static boolean hasSolveFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.endsWith("ConvergenceException")
                || n.endsWith("MathException")
                || n.contains("Invalid");
    }

    private static boolean isBenign(Throwable t) {
        return isCleanRejection(t)
                || t instanceof FunctionEvaluationException
                || t instanceof MaxIterationsExceededException
                || isGroundTruthRootCause(t);
    }
}
