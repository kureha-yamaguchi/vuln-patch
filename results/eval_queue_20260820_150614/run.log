package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction sin = new SinFunction();

        runAnchor(sin);

        int k = data.consumeInt(-50, 50);
        double root = k * Math.PI;

        double left = 0.01 + (data.consumeInt(0, 9900) / 10000.0);
        double right = 0.01 + (data.consumeInt(0, 9900) / 10000.0);

        double min = root - left;
        double max = root + right;

        double initial;
        if (data.consumeBoolean()) {
            initial = min + (max - min) * (data.consumeInt(0, 10000) / 10000.0);
        } else {
            initial = root;
        }

        runSolveWithFunctionArgument(sin, min, max, initial, root);
        runBoundSolverVariant(sin, min, max, root);
    }

    private static void runAnchor(UnivariateRealFunction sin) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(sin, 3.0, 3.2, 3.1);
            assertApproxRoot("anchor-initial", result, Math.PI, solver.getAbsoluteAccuracy(), 3.0, 3.2);
        } catch (Throwable t) {
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCauseNpe(t)) {
                throw new RuntimeException("[oracle:anchor-valid] unexpected NullPointerException on valid solve(f,min,max,initial) input", t);
            }
        }
    }

    private static void runSolveWithFunctionArgument(
            UnivariateRealFunction f, double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, min, max, initial);
            /*
             * Contract/oracle: for a valid interval bracketing a known root of sin(x),
             * the solver must return an approximation of that root. A throw-deleting patch
             * that silently skips using the provided function, or uses the wrong function
             * field, breaks this observable post-condition even if no exception is thrown.
             */
            assertApproxRoot("solve-f-min-max-initial", result, expectedRoot, solver.getAbsoluteAccuracy(), min, max);
        } catch (Throwable t) {
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCauseNpe(t)) {
                throw new RuntimeException(
                        "[oracle:valid-sin-root] unexpected NullPointerException on valid solve(f,min,max,initial)"
                                + " min=" + min + " max=" + max + " initial=" + initial + " expectedRoot=" + expectedRoot,
                        t);
            }
        }
    }

    private static void runBoundSolverVariant(
            UnivariateRealFunction f, double min, double max, double expectedRoot) {
        try {
            BisectionSolver solver = new BisectionSolver(f);
            double result = solver.solve(min, max);
            /*
             * Contract/oracle: the same valid bracketing interval around an exact sin root
             * must also solve correctly through the bound-function public API. This exercises
             * a different reachable function in the same region and checks a real post-condition.
             */
            assertApproxRoot("solve-min-max-bound", result, expectedRoot, solver.getAbsoluteAccuracy(), min, max);
        } catch (Throwable t) {
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCauseNpe(t)) {
                throw new RuntimeException(
                        "[oracle:bound-solver-root] unexpected NullPointerException on valid solve(min,max)"
                                + " min=" + min + " max=" + max + " expectedRoot=" + expectedRoot,
                        t);
            }
        }
    }

    private static void assertApproxRoot(
            String oracleId, double actual, double expected, double accuracy, double min, double max) {
        double tol = Math.max(accuracy * 4.0, 1.0e-6);
        if (actual < min - tol || actual > max + tol || Math.abs(actual - expected) > tol) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: expected known sin root"
                            + " input=[" + min + "," + max + "] expected=" + expected
                            + " actual=" + actual + " tol=" + tol);
        }
    }

    private static boolean isRootCauseNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationLike(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        if (t instanceof FunctionEvaluationException || t instanceof MaxIterationsExceededException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("convergence")
                || name.contains("argument")
                || name.contains("validation")
                || name.contains("invalid");
    }
}
