package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        runAnchor(f);

        int mode = data.consumeInt(0, 3);
        switch (mode) {
            case 0:
                runSiblingAgreementCase(f, data);
                break;
            case 1:
                runCacheConsistencyCase(f, data);
                break;
            case 2:
                runInitialIndependenceCase(f, data);
                break;
            default:
                runBoundaryFlipCase(f, data);
                break;
        }
    }

    private static void runAnchor(UnivariateRealFunction f) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, 3.0, 3.2, 3.1);

            /*
             * Contract/oracle:
             * - solve(f, min, max, initial) and solve(f, min, max) are sibling overloads for the same
             *   root-finding problem on the same function and interval.
             * - In BisectionSolver, the bisection iteration uses only f, min, and max, so the provided
             *   initial value must not change the computed root.
             * A throw-deleting or shortcut patch can avoid the buggy NPE yet still skip the real solve path,
             * so compare the result against the sibling overload and the solver's own cached result.
             */
            BisectionSolver solver2 = new BisectionSolver();
            double sibling = solver2.solve(f, 3.0, 3.2);
            double tol = Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()) * 4.0 + 1e-12;
            if (Math.abs(result - sibling) > tol) {
                throw new RuntimeException(
                        "[oracle:anchor-overload] metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                                + " min=3.0 max=3.2 initial=3.1 lhs=" + result + " rhs=" + sibling + " tol=" + tol);
            }

            double cached = solver.getResult();
            if (Math.abs(result - cached) > Math.max(solver.getAbsoluteAccuracy(), 1e-12)) {
                throw new RuntimeException(
                        "[oracle:anchor-cache] metamorphic violation: returned root disagrees with solver cached result"
                                + " returned=" + result + " cached=" + cached);
            }

            double expected = Math.PI;
            if (Math.abs(result - expected) > tol) {
                throw new RuntimeException(
                        "[oracle:anchor-root] metamorphic violation: solver missed known SinFunction root"
                                + " expected=" + expected + " result=" + result + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isOracleFailure(t)) {
                throw rethrow(t);
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw rethrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void runSiblingAgreementCase(UnivariateRealFunction f, FuzzedDataProvider data) {
        IntervalCase c = buildValidCase(data);

        BisectionSolver withInitial = new BisectionSolver();
        BisectionSolver withoutInitial = new BisectionSolver();

        final double lhs;
        try {
            lhs = withInitial.solve(f, c.min, c.max, c.initial);
        } catch (Throwable t) {
