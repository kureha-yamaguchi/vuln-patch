            coeffs[i] = data.consumeInt(-2, 2);
        }
        return coeffs;
    }

    private static void trySolve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints,
                                 GoalType goalType, boolean restrictToNonNegative,
                                 double epsilon, int maxUlps) {
        try {
            PointValuePair p1 = solve(f, constraints, goalType, restrictToNonNegative, epsilon, maxUlps);
            PointValuePair p2 = solve(f, constraints, goalType, restrictToNonNegative, epsilon, maxUlps);
            List<LinearConstraint> constraintList = toList(constraints);
            if (p1 != null && p2 != null
                    && validSolution(p1, constraintList, epsilon)
                    && validSolution(p2, constraintList, epsilon)) {
                double v1 = p1.getValue();
                double v2 = p2.getValue();
                double tol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(v1), Math.abs(v2)));
                if (Math.abs(v1 - v2) > tol) {
                    throw new RuntimeException(
                        "[oracle:repeatable] metamorphic violation: repeated optimization of the same LP on fresh solvers should agree"
                            + " lhs=" + v1 + " rhs=" + v2);
                }
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static List<LinearConstraint> toList(Collection<LinearConstraint> constraints) {
        if (constraints instanceof List) {
            return (List<LinearConstraint>) constraints;
        }
        return new ArrayList<LinearConstraint>(constraints);
    }

    private static PointValuePair solve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints,
                                        GoalType goalType, boolean restrictToNonNegative,
                                        double epsilon, int maxUlps) throws MaxCountExceededException {
        SimplexSolver solver = new SimplexSolver(epsilon, maxUlps);
        return solver.optimize(f, constraints, goalType, restrictToNonNegative);
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return false;
        }
        String name = t.getClass().getName();
        if (name.contains("Invalid") || name.contains("NoFeasibleSolutionException")
                || name.contains("UnboundedSolutionException")) {
            return false;
        }
        if (!(t instanceof MaxCountExceededException) && !(t instanceof RuntimeException) && !(t instanceof Error)) {
            return false;
        }
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                return true;
            }
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(method)) {
