private static void runNullCase(StrBuilder sb, String prefix, String nullText, int width, char padChar) {
        try {
            sb.setNullText(nullText);
            sb.append(prefix);
            sb.appendFixedWidthPadRight((Object) null, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String expected = prefix + expectedFixedWidthPadRight(nullText, width, padChar);
