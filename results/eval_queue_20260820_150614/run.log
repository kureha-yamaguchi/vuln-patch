public class FuzzHarness {
    private static final String ANCHOR_PATTERN = "it''s a {0,lower} 'test'!";
    private static final Object[] ANCHOR_ARGS = new Object[] { "DUMMY" };
    private static final String ANCHOR_EXPECTED = "it's a dummy test!";

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        Map registry = new HashMap();
        registry.put("lower", new LowerCaseFormatFactory());
        registry.put("upper", new UpperCaseFormatFactory());

        runAnchor(registry);

        String fuzzArg = data.consumeString(32);
        if (fuzzArg == null) {
            fuzzArg = "";
        }

        String pattern = buildPattern(data);
        exercisePattern(pattern, registry, fuzzArg);
    }

    private static void runAnchor(Map registry) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(ANCHOR_PATTERN, registry);

            String before = emf.toPattern();
            String formatted = emf.format(ANCHOR_ARGS);
            String after = emf.toPattern();

            if (!ANCHOR_EXPECTED.equals(formatted)) {
                throw new RuntimeException(
                    "[oracle:anchor-output] metamorphic violation: exact regression input formatted unexpectedly input="
                        + ANCHOR_PATTERN + " got=" + formatted + " expected=" + ANCHOR_EXPECTED);
            }

            // Contract used for this oracle:
            // formatting is observationally read-only for the pattern; toPattern() is a reader
            // and should not change across a call to format(...) on the same object.
            if (before != null ? !before.equals(after) : after != null) {
                throw new RuntimeException(
                    "[oracle:topattern-stable] metamorphic violation: format mutated pattern input="
                        + ANCHOR_PATTERN + " before=" + before + " after=" + after);
            }

            // Contract used for this oracle:
            // toPattern() should describe an equivalent pattern; rebuilding from it with the same
            // registry and formatting the same arguments must yield the same result.
            ExtendedMessageFormat roundTrip = new ExtendedMessageFormat(before, registry);
            String formatted2 = roundTrip.format(ANCHOR_ARGS);
            if (!formatted.equals(formatted2)) {
                throw new RuntimeException(
                    "[oracle:roundtrip] metamorphic violation: constructor/toPattern round-trip disagrees input="
                        + ANCHOR_PATTERN + " lhs=" + formatted + " rhs=" + formatted2);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void exercisePattern(String pattern, Map registry, String arg) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            String before = emf.toPattern();
            String formatted = emf.format(new Object[] { arg });
            String after = emf.toPattern();

            if (before != null ? !before.equals(after) : after != null) {
                throw new RuntimeException(
                    "[oracle:topattern-stable] metamorphic violation: format mutated pattern input="
                        + pattern + " before=" + before + " after=" + after);
            }

            ExtendedMessageFormat emf2 = new ExtendedMessageFormat(before, registry);
            String formatted2 = emf2.format(new Object[] { arg });
            if (!formatted.equals(formatted2)) {
                throw new RuntimeException(
                    "[oracle:roundtrip] metamorphic violation: constructor/toPattern round-trip disagrees input="
                        + pattern + " lhs=" + formatted + " rhs=" + formatted2);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

