package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeAsciiString(8);
        String source = data.consumeString(24);
        int width = data.consumeInt(1, 12);
        int initialCapacity = data.consumeInt(0, 4);
        char padChar = (char) (data.consumeByte() & 0xff);
        boolean useNullObject = data.consumeBoolean();

        if (source == null) {
            source = "";
        }
        source = ensureLongerThanWidth(source, width);

        runScenario(prefix, source, width, padChar, initialCapacity, false);
        runScenario(prefix, source, width, padChar, initialCapacity, true);

        int largerWidth = width + data.consumeInt(1, 6);
        String longerSource = ensureLongerThanWidth(source, largerWidth);
        runWidthPrefixRelation(prefix.length() == 0 ? "P" : prefix, longerSource, width, largerWidth, padChar, useNullObject);

        runSiblingConsistency(prefix, source, width, padChar, initialCapacity);
    }

    private static void runAnchor() {
        try {
            StrBuilder sb = new StrBuilder(1);
            sb.appendFixedWidthPadRight("foo", 1, '-');
            if (!"f".equals(sb.toString())) {
                throw new RuntimeException("[oracle:anchor-visible] metamorphic violation: appendFixedWidthPadRight should append the leftmost width chars for overlong input lhs="
                        + printable(sb.toString()) + " rhs=f");
            }
            checkConsistency(sb, "anchor");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runScenario(String prefix, String source, int width, char padChar, int initialCapacity, boolean useNullObject) {
        if (width <= 0 || source == null || source.length() <= width) {
            return;
        }

        StrBuilder actual = new StrBuilder(initialCapacity);
        try {
            if (prefix.length() > 0) {
                actual.append(prefix);
            }
            if (useNullObject) {
                actual.setNullText(source);
                actual.appendFixedWidthPadRight((Object) null, width, padChar);
            } else {
                actual.appendFixedWidthPadRight((Object) source, width, padChar);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        StrBuilder expected = new StrBuilder(prefix.length() + width);
        try {
            expected.append(prefix);
            expected.append(source, 0, width);
        } catch (RuntimeException t) {
            return;
        }

        String lhs;
        String rhs;
        try {
            lhs = actual.toString();
            rhs = expected.toString();
        } catch (RuntimeException t) {
            return;
        }

        /*
         * Contract from appendFixedWidthPadRight:
         * when source text is longer than width, the appended fixed-width field is the
         * leftmost width characters. expected.append(source, 0, width) constructs the
         * same quantity via a real sibling API, so a throw-deleting or wrong-copy patch
         * is observable as a mismatch.
         */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:truncate-equiv] metamorphic violation: fixed-width right pad disagrees with append(str,0,width) prefix="
                    + printable(prefix) + " width=" + width + " source=" + printable(source)
                    + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
        }

        checkConsistency(actual, useNullObject ? "nullText" : "nonnull");
    }

    private static void runWidthPrefixRelation(String prefix, String source, int smallWidth, int largeWidth, char padChar, boolean useNullObject) {
        if (smallWidth <= 0 || largeWidth <= smallWidth || source == null || source.length() <= largeWidth || prefix.length() == 0) {
            return;
        }

        StrBuilder small = new StrBuilder(prefix.length());
        StrBuilder large = new StrBuilder(prefix.length());

        try {
            small.append(prefix);
            if (useNullObject) {
                small.setNullText(source);
                small.appendFixedWidthPadRight((Object) null, smallWidth, padChar);
            } else {
                small.appendFixedWidthPadRight((Object) source, smallWidth, padChar);
