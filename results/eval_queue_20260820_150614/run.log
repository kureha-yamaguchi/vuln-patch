package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.lang.reflect.Array;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int lenA = data.consumeInt(1, 6);
        int lenB = data.consumeInt(0, 6);

        Object[] a = new Object[lenA];
        Object[] b = new Object[lenB];

        boolean insertedNull = false;
        for (int i = 0; i < lenA; i++) {
            if (!insertedNull && (i == lenA - 1 || data.consumeBoolean())) {
                a[i] = null;
                insertedNull = true;
            } else {
                a[i] = makeRealObject(data);
            }
        }
        if (!insertedNull) {
            a[data.consumeInt(0, lenA - 1)] = null;
        }

        for (int i = 0; i < lenB; i++) {
            b[i] = data.consumeBoolean() ? null : makeRealObject(data);
        }

        Class<?>[] ta;
        Class<?>[] tb;
        Class<?>[] tab;
        try {
            ta = ClassUtils.toClass(a);
            tb = ClassUtils.toClass(b);
            tab = ClassUtils.toClass(concat(a, b));
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        /* Contract/oracle:
         * toClass maps each input slot independently to either element.getClass() or null,
         * so for any correct implementation:
         *   toClass(concat(a, b)) == concat(toClass(a), toClass(b))
         * including arrays containing null elements.
         * A throw-deleting or null-skipping patch can avoid the crash yet still violate this relation.
         */
        Class<?>[] expectedConcat = concat(ta, tb);
        if (!Arrays.equals(tab, expectedConcat)) {
            throw new RuntimeException(
                    "[oracle:concat-map] metamorphic violation: toClass(concat(a,b)) != concat(toClass(a),toClass(b))");
        }

        /* Independent consistency check using reachable helper getClass:
         * For any non-null class c with a canonical name, resolving c's canonical array name
         * through ClassUtils.getClass must produce the same array Class object as the JDK's
         * Array.newInstance(c, 0).getClass().
         * This exercises ClassUtils.getClass on valid-by-construction names derived from real objects.
         */
        checkArrayNameResolution(ta);
        checkArrayNameResolution(tb);
        checkArrayNameResolution(tab);
    }

    private static void runAnchor() {
        try {
            if (ClassUtils.toClass((Object[]) null) != null) {
                throw new RuntimeException("[oracle:anchor-null-array] metamorphic violation: toClass(null) must return null");
            }

            Class<?>[] expected = new Class<?>[] { String.class, null, Double.class };
            Class<?>[] actual = ClassUtils.toClass(new Object[] { "Test", null, 99d });
            if (!Arrays.equals(expected, actual)) {
                throw new RuntimeException(
                        "[oracle:anchor-null-middle] metamorphic violation: expected "
                                + Arrays.toString(expected) + " but got " + Arrays.toString(actual));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkArrayNameResolution(Class<?>[] classes) {
        if (classes == null) {
            return;
        }
        for (Class<?> c : classes) {
            if (c == null) {
                continue;
            }
            String canonical = c.getCanonicalName();
            if (canonical == null) {
                continue;
            }
            String arrayName = canonical + "[]";
            try {
                Class<?> resolved = ClassUtils.getClass(arrayName, false);
                Class<?> independent = Array.newInstance(c, 0).getClass();
                if (resolved != independent) {
                    throw new RuntimeException(
                            "[oracle:array-name-resolve] metamorphic violation: input="
                                    + arrayName + " lhs=" + resolved + " rhs=" + independent);
                }
            } catch (ClassNotFoundException e) {
                return;
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            } catch (LinkageError e) {
                return;
            }
        }
    }

    private static Object makeRealObject(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 8)) {
            case 0:
                return data.consumeString(16);
            case 1:
                return Integer.valueOf(data.consumeInt());
            case 2:
                return Double.valueOf((double) data.consumeInt(-1000000, 1000000) / 10.0d);
            case 3:
                return Long.valueOf(data.consumeInt());
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            case 5:
                return data.consumeBytes(8);
            case 6:
                return new String[] { data.consumeAsciiString(8), data.consumeAsciiString(8) };
            case 7:
                return new int[] { data.consumeInt(-1000, 1000), data.consumeInt(-1000, 1000) };
            default:
                return Character.valueOf((char) (data.consumeInt(32, 126)));
        }
    }

    private static Object[] concat(Object[] a, Object[] b) {
        Object[] out = new Object[a.length + b.length];
        System.arraycopy(a, 0, out, 0, a.length);
        System.arraycopy(b, 0, out, a.length, b.length);
        return out;
    }

    private static Class<?>[] concat(Class<?>[] a, Class<?>[] b) {
        Class<?>[] out = new Class<?>[a.length + b.length];
        System.arraycopy(a, 0, out, 0, a.length);
        System.arraycopy(b, 0, out, a.length, b.length);
        return out;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && ("toClass".equals(ste.getMethodName()) || "getClass".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }
}
