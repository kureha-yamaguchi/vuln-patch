    private static boolean sameVector3D(
        org.apache.commons.math3.geometry.euclidean.threed.Vector3D a,
        org.apache.commons.math3.geometry.euclidean.threed.Vector3D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return sameDouble(a.getX(), b.getX())
            && sameDouble(a.getY(), b.getY())
            && sameDouble(a.getZ(), b.getZ());
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return true;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= 1.0e-12 * scale;
    }
