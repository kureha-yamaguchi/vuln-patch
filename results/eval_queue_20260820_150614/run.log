            }
        }
        return false;
    }

    private static final class ValidCase {
        final MonthDay base;
        final DurationFieldType fieldType;
        final int amount;
        final String expectedCanonical;
        final boolean validByConstruction;

        ValidCase(MonthDay base, DurationFieldType fieldType, int amount, String expectedCanonical) {
            this.base = base;
            this.fieldType = fieldType;
            this.amount = amount;
            this.expectedCanonical = expectedCanonical;
            this.validByConstruction = true;
        }
    }
