                coeff[i] = 1.0;
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, target[i]));
            }

            double[] upper = new double[dimension];
            upper[i] = 1.0;
            constraints.add(new LinearConstraint(upper, Relationship.LEQ, target[i]));
        }

        int denseConstraints = 1 + rnd.nextInt(4);
        for (int k = 0; k < denseConstraints; k++) {
            double[] coeff = new double[dimension];
            double rhs = 0.0;
            for (int i = 0; i < dimension; i++) {
                int c = rnd.nextInt(7) - 3;
                if (c == 0 && i == 0) {
