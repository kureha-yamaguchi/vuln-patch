            String prefix = data.consumeAsciiString(8);
            String body = data.consumeAsciiString(24);
            String str = forceLength(body, width + extra);

            runCase(prefix, str, false, null, width, padChar);
        } else if (mode == 1) {
            int width = data.consumeInt(1, 8);
            int totalLen = data.consumeInt(6, 16);
            if (totalLen <= width) {
                totalLen = width + 1;
            }
            String prefix = data.consumeAsciiString(8);
            String body = data.consumeString(24);
            String str = forceLength(body, totalLen);

            runCase(prefix, str, false, null, width, padChar);
        } else if (mode == 2) {
            int width = data.consumeInt(1, 6);
            int nullLen = data.consumeInt(6, 16);
            if (nullLen <= width) {
                nullLen = width + 1;
            }
            String prefix = data.consumeAsciiString(8);
            String nullText = forceLength(data.consumeString(24), nullLen);

            runCase(prefix, null, true, nullText, width, padChar);
        } else {
