private static void runStoredFunctionReuseCase(
            UnivariateRealFunction f, double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        final double withInitial;
        try {
            withInitial = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:stored-function-reuse] metamorphic violation: valid solve(f,min,max,initial) threw in patched region"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return;
        }

        final double reused;
        try {
            reused = solver.solve(min, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:stored-function-reuse] metamorphic violation: after successful solve(f,min,max,initial), solve(min,max) must solve the same stored function"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " first=" + withInitial,
                        t);
            }
            return;
        }

        final double fresh;
        BisectionSolver freshSolver = new BisectionSolver();
        try {
            fresh = freshSolver.solve(f, min, max);
        } catch (Throwable t) {
            return;
        }

        double tol = Math.max(solver.getAbsoluteAccuracy(), freshSolver.getAbsoluteAccuracy()) * 4.0 + 1e-12;

        /*
         * Contract used here:
         * - solve(f,min,max,initial), solve(f,min,max), and solve(min,max) are sibling public entry points
         *   for the same bisection problem.
         * - After a successful call that supplies f, the receiver must be able to solve the same stored function
         *   via solve(min,max). A band-aid patch that only avoids the original throw but fails to preserve the
         *   receiver's function state violates this relation even if no exception is thrown.
         */
        if (Math.abs(reused - fresh) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-function-reuse] metamorphic violation: receiver solve(min,max) disagreed with fresh solve(f,min,max)"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " reused=" + reused
                            + " fresh=" + fresh
                            + " tol=" + tol);
        }

        if (Math.abs(reused - withInitial) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-vs-initial] metamorphic violation: solve(min,max) after successful solve(f,min,max,initial) changed the root"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " first=" + withInitial
                            + " reused=" + reused
                            + " tol=" + tol);
        }

        if (Math.abs(reused - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-root] metamorphic violation: stored-function solve(min,max) missed constructed SinFunction root"
                            + " expectedRoot=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " reused=" + reused
                            + " tol=" + tol);
        }
    }
