            throw new RuntimeException("[oracle:real-shape-ctor] metamorphic violation: constructor-reported shape input=" +
                rows + "x" + cols + " lhs=" + m.getRowDimension() + "x" + m.getColumnDimension() +
                " rhs=" + rows + "x" + cols);
        }

        /*
         * Contract used:
         * - RealMatrixImpl(double[] v) creates a column matrix using v as data.
         * - operate(v) returns this * v.
         * - getEntry(row, col) exposes matrix entries.
         * With e0 = [1,0,...,0], operate(e0) must equal the first column exactly.
         * With copyArray=false, the matrix uses the provided backing array directly, so a
         * backing-array mutation must be visible through subsequent operate/getEntry calls.
         */
        double[] e0 = new double[cols];
        e0[0] = 1.0;

        double[] out1 = m.operate(e0);
        for (int r = 0; r < rows; r++) {
            double expected = m.getEntry(r, 0);
            if (out1.length <= r || !eq(out1[r], expected)) {
                throw new RuntimeException("[oracle:real-e0-col] metamorphic violation: operate(e0)==first-column input=row=" +
                    r + " lhs=" + (out1.length > r ? String.valueOf(out1[r]) : "<missing>") + " rhs=" + expected);
            }
        }

        RealMatrixImpl col = new RealMatrixImpl(e0);
