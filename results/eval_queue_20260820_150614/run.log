            if (Double.doubleToLongBits(result) != Double.doubleToLongBits(cached)) {
                throw new RuntimeException(
                        "[oracle:anchor-cache] metamorphic violation: returned value must equal cached solver result"
                                + " returned=" + result
                                + " cached=" + cached);
            }

            if (result < 3.0 || result > 3.2) {
                throw new RuntimeException(
                        "[oracle:anchor-interval] metamorphic violation: successful bisection result must stay inside anchor interval"
                                + " result=" + result);
            }
        } catch (MaxIterationsExceededException e) {
            throw new RuntimeException(e);
        } catch (FunctionEvaluationException e) {
            throw new RuntimeException(e);
        }
    }

    private static double chooseRoot(FuzzedDataProvider data) {
        int k = data.consumeInt(-64, 64);
        return k * Math.PI;
    }

    private static double chooseWidth(FuzzedDataProvider data) {
        int milli = data.consumeInt(1, 400);
        return milli / 1000.0;
    }
