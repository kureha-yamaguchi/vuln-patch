private static void runCase(String prefix, String str, boolean useNullObject, String nullText, int width, char padChar) {
        if (width <= 0) {
            return;
        }

        String effective = useNullObject ? nullText : str;
        if (effective == null || effective.length() <= width) {
            return;
        }

        StrBuilder sb = new StrBuilder(width);
        try {
            if (nullText != null || useNullObject) {
                sb.setNullText(nullText);
            }
            sb.append(prefix);
            if (useNullObject) {
                sb.appendFixedWidthPadRight((Object) null, width, padChar);
            } else {
                sb.appendFixedWidthPadRight((Object) str, width, padChar);
            }
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        StrBuilder expected = new StrBuilder(prefix.length() + width);
        try {
            expected.append(prefix);
            expected.append(effective, 0, width);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            return;
        }

        /* Contract asserted:
           when width > 0 and the source text is longer than width, appendFixedWidthPadRight
           appends a fixed-width field containing the leftmost width characters of that text.
           We obtain the same quantity independently using the real sibling API append(str, 0, width),
           then require the two StrBuilder results to stay equal. A patch that merely suppresses the
           exception but drops/corrupts the copy will violate this relation. */
        checkEquivalentBuilders("[case prefix=" + prefix + " width=" + width + " srcLen=" + effective.length() + "]", sb, expected);

        try {
            String before = sb.toString();
            int beforeLen = sb.length();
            sb.minimizeCapacity();
            String after = sb.toString();
            int afterLen = sb.length();
            if (beforeLen != afterLen || !before.equals(after)) {
                throw new RuntimeException("[oracle:minimize-stable] metamorphic violation: minimizeCapacity changed visible contents context="
                        + prefix + " beforeLen=" + beforeLen + " afterLen=" + afterLen
                        + " before=" + before + " after=" + after);
            }
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            throw t;
        }
    }
