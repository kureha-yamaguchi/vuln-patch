                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                            "[oracle:casefold-upper] metamorphic violation: case-insensitive agreement input="
                                + repr(s) + " lhs=" + result + " rhs=" + upperResult);
                    }
