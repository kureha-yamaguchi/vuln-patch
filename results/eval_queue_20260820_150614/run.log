package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchorAndMalformedExponent("1234.5");
        exerciseAnchorAndMalformedExponent("1eE");

        String malformed = buildMalformedDualExponent(data);
        if (malformed != null) {
            exerciseAnchorAndMalformedExponent(malformed);
        }

        String decimal = buildPlainDecimal(data);
        if (decimal != null) {
            checkPlainDecimalConsistency(decimal);
        }
    }

    private static void exerciseAnchorAndMalformedExponent(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        if (looksLikeInvalidDualExponent(s)) {
            /* Contract oracle from NumberUtilsTest.checkCreateNumber + LANG-638:
             * syntactically invalid inputs like "1eE" must be rejected cleanly so the helper returns false.
             * A throw-deleting / branch-skipping patch that returns a Number here is observably wrong.
             */
            boolean accepted;
            try {
                accepted = checkCreateNumber(s);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }
            if (accepted) {
                throw new RuntimeException("[oracle:invalid-exp] metamorphic violation: invalid dual-exponent input accepted input=" + s);
            }
        }
    }

    private static void checkPlainDecimalConsistency(String s) {
        /* Sound relation from createNumber's documented/visible selection logic:
         * for a plain decimal with no exponent or type suffix, if the explicit Float form (s + "F")
         * is accepted as a Float, then the un-suffixed form must pick the same Float value as its
         * first successful candidate as well. We cross-check the same quantity three real ways:
         *   createNumber(s), createNumber(s + "F"), and createFloat(s).
         */
        try {
            Number explicitFloatChoice = NumberUtils.createNumber(s + "F");
            if (!(explicitFloatChoice instanceof Float)) {
                return;
            }

            Float directFloat = NumberUtils.createFloat(s);
            Number plain = NumberUtils.createNumber(s);

            if (!(plain instanceof Float)) {
                throw new RuntimeException("[oracle:plain-vs-float] metamorphic violation: plain decimal did not select Float when explicit Float did input=" + s + " plainClass=" + plain.getClass().getName() + " explicitClass=" + explicitFloatChoice.getClass().getName());
            }

            int bitsPlain = Float.floatToIntBits(((Float) plain).floatValue());
            int bitsExplicit = Float.floatToIntBits(((Float) explicitFloatChoice).floatValue());
            int bitsDirect = Float.floatToIntBits(directFloat.floatValue());

            if (bitsPlain != bitsExplicit || bitsPlain != bitsDirect) {
                throw new RuntimeException("[oracle:plain-vs-float] metamorphic violation: inconsistent float parsing input=" + s + " plain=" + plain + " explicit=" + explicitFloatChoice + " direct=" + directFloat);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean checkCreateNumber(String val) {
        try {
            Object obj = NumberUtils.createNumber(val);
            if (obj == null) {
                return false;
            }
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    private static String buildMalformedDualExponent(FuzzedDataProvider data) {
        int leftLen = data.consumeInt(1, 6);
        int middleLen = data.consumeInt(0, 3);
        int rightLen = data.consumeInt(0, 3);
        boolean upperFirst = data.consumeBoolean();

        String left = digitsOnly(data.consumeAsciiString(leftLen), leftLen, false);
        String middle = digitsOnly(data.consumeAsciiString(middleLen), middleLen, true);
        String right = digitsOnly(data.consumeAsciiString(rightLen), rightLen, true);

        char first = upperFirst ? 'E' : 'e';
        char second = upperFirst ? 'e' : 'E';

        String s = left + first + middle + second + right;
        if (s.indexOf('.') >= 0) {
            return null;
        }
        return s;
    }

    private static String buildPlainDecimal(FuzzedDataProvider data) {
        int intLen = data.consumeInt(1, 5);
        int fracLen = data.consumeInt(1, 5);
        boolean negative = data.consumeBoolean();

        String whole = digitsOnly(data.consumeAsciiString(intLen), intLen, false);
        String frac = digitsOnly(data.consumeAsciiString(fracLen), fracLen, false);

        if (whole.length() == 0 || frac.length() == 0) {
            return null;
        }

        String s = (negative ? "-" : "") + whole + "." + frac;

        try {
            Float f = NumberUtils.createFloat(s);
            if (f == null || f.isInfinite()) {
                return null;
            }
            boolean allZeros = allZerosForHarness(whole) && allZerosForHarness(null);
            if (f.floatValue() == 0.0F && !allZeros) {
                return null;
            }
        } catch (RuntimeException e) {
            return null;
        }

        return s;
    }

    private static String digitsOnly(String raw, int targetLen, boolean allowEmpty) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length() && sb.length() < targetLen; i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        while (sb.length() < targetLen) {
            sb.append((char) ('0' + (sb.length() % 10)));
        }
        if (!allowEmpty && sb.length() == 0) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static boolean looksLikeInvalidDualExponent(String s) {
        if (s == null || s.length() == 0 || s.indexOf('.') >= 0) {
            return false;
        }
        return s.indexOf('e') >= 0 && s.indexOf('E') >= 0;
    }

    private static boolean allZerosForHarness(String str) {
        if (str == null) {
            return true;
        }
        for (int i = str.length() - 1; i >= 0; i--) {
            if (str.charAt(i) != '0') {
                return false;
            }
        }
        return str.length() > 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
