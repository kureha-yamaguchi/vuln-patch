package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.ParsePosition;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Object[] DUMMY_ARGS = new Object[] { "DUMMY" };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();
        registry.put("lower", new LowerCaseFormatFactory());
        registry.put("upper", new UpperCaseFormatFactory());

        // ANCHOR: exact failing test input.
        exerciseCase(
                "it''s a {0,lower} 'test'!",
                registry,
                DUMMY_ARGS,
                "it's a dummy test!",
                true);

        // EXPLORE: flip the patched condition by generating many valid patterns that
        // contain one or more escaped quotes ("''") in literal text before a real custom
        // format element. A correct implementation must accept these patterns and format
        // them as literal apostrophes plus the lower-cased argument.
        String arg = sanitizeLetters(data.consumeAsciiString(32));
        if (arg.length() == 0) {
            arg = "DUMMY";
        }

        int segmentCount = data.consumeInt(2, 5);
        String[] segments = new String[segmentCount];
        for (int i = 0; i < segmentCount; i++) {
            segments[i] = sanitizeLiteral(data.consumeAsciiString(16));
        }

        String trailer = sanitizeLiteral(data.consumeAsciiString(16));
        boolean addQuotedSuffix = data.consumeBoolean();
        String quotedSuffix = sanitizeLiteral(data.consumeAsciiString(12));

        StringBuilder pattern = new StringBuilder();
        StringBuilder expected = new StringBuilder();

        for (int i = 0; i < segmentCount; i++) {
            pattern.append(segments[i]);
            expected.append(segments[i]);
            if (i + 1 < segmentCount) {
                pattern.append("''");
                expected.append('\'');
            }
        }

        pattern.append(" {0,lower}");
        expected.append(' ').append(arg.toLowerCase(Locale.ROOT));

        pattern.append(trailer);
        expected.append(trailer);

        if (addQuotedSuffix && quotedSuffix.length() > 0) {
            pattern.append(" '").append(quotedSuffix).append("'");
            expected.append(' ').append(quotedSuffix);
        }

        exerciseCase(
                pattern.toString(),
                registry,
                new Object[] { arg },
                expected.toString(),
                true);

        // Additional direct boundary probes around the patched condition.
        exerciseCase("''{0,lower}", registry, new Object[] { arg }, "'" + arg.toLowerCase(Locale.ROOT), true);
        exerciseCase("a''{0,lower}", registry, new Object[] { arg }, "a'" + arg.toLowerCase(Locale.ROOT), true);
        exerciseCase("''a {0,lower}", registry, new Object[] { arg }, "'a " + arg.toLowerCase(Locale.ROOT), true);
    }

    private static void exerciseCase(String pattern, Map registry, Object[] args, String expected, boolean assertChecks) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            // Contract/oracle used here:
            // - ExtendedMessageFormat formats via MessageFormat semantics plus registered
            //   custom formats; for our valid-by-construction patterns, "''" denotes a
            //   literal apostrophe and {0,lower} applies lowercase formatting.
            // - format(...) is read-only with respect to the pattern representation; a
            //   throw-deleting patch that silently skips quote handling could leave output
            //   wrong while not crashing, so we assert both the concrete formatted result
            //   and that toPattern() is stable across formatting.
            String before = emf.toPattern();
            String actual = emf.format(args);
            String after = emf.toPattern();

            if (assertChecks && !before.equals(after)) {
                throw new RuntimeException(
                        "[oracle:topattern-stable] metamorphic violation: toPattern changed across format input="
                                + pattern + " before=" + before + " after=" + after);
            }

            if (assertChecks && !expected.equals(actual)) {
                throw new RuntimeException(
                        "[oracle:format-lower-quote] metamorphic violation: input=" + pattern
                                + " expected=" + expected + " actual=" + actual);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase(Locale.ROOT);
            if (name.contains("validation") || name.contains("invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("appendQuotedString".equals(m)
                        || "next".equals(m)
                        || "append".equals(m)
                        || "startsWith".equals(m)) {
                    return true;
                }
            }
            if ("org.apache.commons.lang.text.StrBuilder".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("append".equals(m) || "startsWith".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String sanitizeLiteral(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == ' '
                    || c == '!'
                    || c == '.'
                    || c == ','
                    || c == '_'
                    || c == '-') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String sanitizeLetters(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static final class LowerCaseFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new LowerCaseFormat(locale == null ? Locale.getDefault() : locale);
        }
