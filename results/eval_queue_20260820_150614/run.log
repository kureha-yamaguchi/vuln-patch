package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            exerciseUnchecked(anchors[i], false);
        }

        char suffix = data.consumeBoolean() ? 'L' : 'l';
        int mode = data.consumeInt(0, 4);

        if (mode == 0) {
            exerciseUnchecked(String.valueOf(suffix), false);
        } else if (mode == 1) {
            String bad = data.consumeAsciiString(8);
            if (bad.length() == 0) {
                bad = "x";
            }
            bad = sanitizeNonDigitPrefix(bad) + suffix;
            exerciseUnchecked(bad, false);
        } else if (mode == 2) {
            String numeric = buildSignedDigits(data, 32);
            String val = numeric + suffix;
            exerciseUnchecked(val, true);

            try {
                Number parsed = NumberUtils.createNumber(val);
                if (parsed == null) {
                    return;
                }
                BigInteger reported = NumberUtils.createBigInteger(parsed.toString());
                BigInteger independent = NumberUtils.createBigInteger(numeric);
                if (!reported.equals(independent)) {
                    throw new RuntimeException(
                        "[oracle:int-suffix] metamorphic violation: integral value changed input="
                            + val + " lhs=" + reported + " rhs=" + independent);
                }
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException t) {
                if (isRootCause(t) && isValidConstructedIntegral(numeric)) {
                    throw t;
                }
            }
        } else if (mode == 3) {
            String decimal = buildDecimal(data);
            String val = decimal + (data.consumeBoolean() ? 'F' : 'D');
            exerciseUnchecked(val, true);

            try {
                Number first = NumberUtils.createNumber(val);
                if (first == null) {
                    return;
                }
                String canonical = first.toString();
                Number second = NumberUtils.createNumber(canonical);
                if (second == null) {
                    return;
                }
                String reparsed = second.toString();
                // Visible contract/invariant from createNumber's code paths: for a valid constructed
                // numeric string, parsing the canonical numeric text emitted by the first parsed Number
                // must denote the same numeric value when parsed again. A throw-deleting or wrong-value
                // patch can avoid the original crash yet still break this round-trip.
                if (!canonical.equals(reparsed)) {
                    throw new RuntimeException(
                        "[oracle:canon-roundtrip] metamorphic violation: parse(toString(parse(x))) changed value input="
                            + val + " lhs=" + canonical + " rhs=" + reparsed);
                }
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
            }
        } else {
            String nearBoundary = data.consumeBoolean() ? "-" + suffix : "" + suffix;
            exerciseUnchecked(nearBoundary, false);

            String numeric = buildSignedDigits(data, 4);
            exerciseUnchecked(numeric + suffix, true);
        }
    }

    private static void exerciseUnchecked(String val, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(val);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "charAt".equals(method)
                    || "substring".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildSignedDigits(FuzzedDataProvider data, int maxDigits) {
        int len = data.consumeInt(1, maxDigits);
        String raw = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + Math.abs(c) % 10));
            }
        }
        if (sb.length() == 1 && sb.charAt(0) == '-') {
            sb.append('0');
        }
        if (sb.charAt(sb.length() - 1) == '-') {
            sb.append('0');
        }
        return sb.toString();
    }

    private static String buildDecimal(FuzzedDataProvider data) {
        String left = buildUnsignedDigits(data, 6);
        String right = buildUnsignedDigits(data, 6);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(left).append('.').append(right);
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'E' : 'e');
            if (data.consumeBoolean()) {
                sb.append('-');
            }
            sb.append(buildUnsignedDigits(data, 3));
        }
        return sb.toString();
    }

    private static String buildUnsignedDigits(FuzzedDataProvider data, int maxDigits) {
        int len = data.consumeInt(1, maxDigits);
        String raw = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + Math.abs(c) % 10));
            }
        }
        return sb.toString();
    }

    private static boolean isValidConstructedIntegral(String numeric) {
        if (numeric == null || numeric.length() == 0) {
            return false;
        }
        int start = 0;
        if (numeric.charAt(0) == '-') {
            if (numeric.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < numeric.length(); i++) {
            char c = numeric.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }

    private static String sanitizeNonDigitPrefix(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= '0' && c <= '9') || c == '-' || c == '.' || c == 'e' || c == 'E') {
                sb.append('x');
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('x');
        }
        return sb.toString();
    }
}
