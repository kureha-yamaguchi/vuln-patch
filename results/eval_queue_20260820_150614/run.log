package org.apache.commons.math.optimization.fitting;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.function.Gaussian;
import org.apache.commons.math.exception.NotStrictlyPositiveException;
import org.apache.commons.math.optimization.general.LevenbergMarquardtOptimizer;

public class FuzzHarness {
    private static final double[] ANCHOR_DATA = {
        1.1143831578403364E-29,
        4.95281403484594E-28,
        1.1171347211930288E-26,
        1.7044813962636277E-25,
        1.9784716574832164E-24,
        1.8630236407866774E-23,
        1.4820532905097742E-22,
        1.0241963854632831E-21,
        6.275077366673128E-21,
        3.461808994532493E-20,
        1.7407124684715706E-19,
        8.056687953553974E-19,
        3.460193945992071E-18,
        1.3883326374011525E-17,
        5.233894983671116E-17,
        1.8630791465263745E-16,
        6.288759227922111E-16,
        2.0204433920597856E-15,
        6.198768938576155E-15,
        1.821419346860626E-14,
        5.139176445538471E-14,
        1.3956427429045787E-13,
        3.655705706448139E-13,
        9.253753324779779E-13,
        2.267636001476696E-12,
        5.3880460095836855E-12,
        1.2431632654852931E-11
    };

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ANCHOR_DATA.length; i++) {
            fitter.addObservedPoint(i, ANCHOR_DATA[i]);
        }

        try {
            // Same-package access to the real helper path touched by fit().
            WeightedObservedPoint[] obs = fitter.getObservations();
            if (obs.length >= 3) {
                new GaussianFitter.ParameterGuesser(obs).guess();
            }
            fitter.fit();
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        int n = data.consumeInt(6, 32);
        double norm = 0.5 + data.consumeInt(1, 5000) / 10.0;
        double sigma = 0.5 + data.consumeInt(1, 80) / 10.0;
        double step = 0.25 + data.consumeInt(1, 20) / 4.0;
        double start = data.consumeInt(-20, 20);

        // Put the mean just beyond the sampled window so the observations form a one-sided
        // Gaussian tail, i.e. the regime from the bug report where the optimizer may probe
        // sigma <= 0 unless GaussianFitter.fit() routes through fit(double[]).
        double windowEnd = start + step * (n - 1);
        double mean = windowEnd + data.consumeInt(1, 8) * step;
        double shift = data.consumeInt(-20, 20);
        if (shift == 0.0) {
            shift = 3.0;
        }

        Gaussian g = new Gaussian(norm, mean, sigma);
        double[] y = new double[n];
        for (int i = 0; i < n; i++) {
            double x = start + i * step;
            y[i] = g.value(x);
        }

        GaussianFitter base = buildFitter(y, start, step);
        GaussianFitter shifted = buildFitter(y, start + shift, step);

        double[] baseGuess;
        double[] shiftedGuess;
        try {
            WeightedObservedPoint[] baseObs = base.getObservations();
            WeightedObservedPoint[] shiftedObs = shifted.getObservations();
            baseGuess = new GaussianFitter.ParameterGuesser(baseObs).guess();
            shiftedGuess = new GaussianFitter.ParameterGuesser(shiftedObs).guess();
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        // Drive the real overload touched by the patch as well.
        try {
            GaussianFitter fresh = buildFitter(y, start, step);
            fresh.fit(baseGuess.clone());
        } catch (Throwable t) {
            handleThrowable(t);
        }

        double[] p1;
        double[] p2;
        try {
            p1 = base.fit();
            p2 = shifted.fit();
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        if (p1 == null || p2 == null || p1.length < 3 || p2.length < 3) {
            return;
        }

        // Metamorphic oracle, outside the already-covered families:
        // A Gaussian model y = A * exp(-(x-m)^2 / (2*s^2)) is translation-invariant in x.
        // Shifting every observed x by a constant must shift only the fitted mean by the same
        // constant; amplitude and sigma should stay the same. If either fit had thrown, the
        // check would not apply and we already returned.
        double ampTol = Math.max(1e-6, 0.10 * Math.max(Math.abs(p1[0]), Math.abs(p2[0])));
        double sigmaTol = Math.max(1e-6, 0.10 * Math.max(Math.abs(p1[2]), Math.abs(p2[2])));
        double meanTol = Math.max(0.25, 0.10 * step * n);

        if (Math.abs(p1[0] - p2[0]) > ampTol ||
            Math.abs(p1[2] - p2[2]) > sigmaTol ||
            Math.abs((p2[1] - p1[1]) - shift) > meanTol) {
            throw new RuntimeException(
                "[oracle:x-shift] metamorphic violation: Gaussian fit must be translation-invariant" +
                " shift=" + shift +
                " p1=[" + p1[0] + "," + p1[1] + "," + p1[2] + "]" +
                " p2=[" + p2[0] + "," + p2[1] + "," + p2[2] + "]"
            );
        }
    }

    private static GaussianFitter buildFitter(double[] y, double start, double step) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < y.length; i++) {
            fitter.addObservedPoint(start + i * step, y[i]);
        }
        return fitter;
    }

    private static void handleThrowable(Throwable t) {
        if (isRootCause(t)) {
            throwUnchecked(t);
        }
        if (isCleanRejection(t)) {
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NotStrictlyPositiveException)) {
            return false;
        }
        boolean sawValidate = false;
        boolean sawReachable = false;
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.function.Gaussian$Parametric".equals(cls)
                    && "validateParameters".equals(method)) {
                sawValidate = true;
            }
            if (("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls) && "fit".equals(method))
                    || ("org.apache.commons.math.optimization.fitting.CurveFitter".equals(cls) && "getObservations".equals(method))
                    || ("org.apache.commons.math.optimization.fitting.GaussianFitter$ParameterGuesser".equals(cls) && "guess".equals(method))) {
                sawReachable = true;
            }
        }
        return sawValidate && sawReachable;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        Package p = t.getClass().getPackage();
        if (p != null) {
            String name = p.getName();
            if (name != null && name.startsWith("org.apache.commons.math.exception")) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
