    private static int adjustedStartIndex(TimeSeries s, RegularTimePeriod p) {
        int idx = s.getIndex(p);
        if (idx < 0) {
            idx = -(idx + 1);
        }
        return idx;
    }

    private static int adjustedEndIndex(TimeSeries s, RegularTimePeriod p) {
        int idx = s.getIndex(p);
        if (idx < 0) {
