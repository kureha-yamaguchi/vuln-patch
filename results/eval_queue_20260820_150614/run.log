package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor from the failing test/ground truth. We execute it first to drive the real
        // public API through the patched region, but we do not rely only on this already-known
        // crash signature.
        swallowKnownParsingFailure("1234.5");

        // Explore the same root-cause shape: valid decimal numbers with a dot and no exponent,
        // optionally with a real numeric type suffix that createNumber supports.
        String explored = buildDecimalNoExponent(data);
        swallowKnownParsingFailure(explored);

        // Also exercise blank/odd inputs to reach StringUtils.isBlank and nearby validation.
        swallowKnownParsingFailure(data.consumeAsciiString(32));

        // Oracle 1: exact recovery from an input we construct to be valid-by-construction.
        // Contract basis visible in NumberUtils tests/examples: createNumber parses decimal
        // strings and explicit D/F suffixes as the same numeric quantity. For strings of the
        // form "<moderate integer>.0", the mathematical value is exactly that integer, so a
        // correct implementation must recover it exactly.
        int n = data.consumeInt(-1_000_000, 1_000_000);
        String canonical = Integer.toString(n) + ".0";
        checkExactDecimalRecovery(canonical, (double) n);

        // Oracle 2: equivalent-input metamorphic check on the same exact quantity.
        // The library examples assert that unsuffixed decimal input and D/F-suffixed input
        // denote the same number; only the preferred return type may differ.
        checkEquivalentRepresentations(canonical);

        // Explore more variants of the same valid shape: leading zeros and sign decoration.
        String decorated = decorateWithLeadingZeros(n, data.consumeInt(0, 6), data.consumeBoolean());
        checkEquivalentRepresentations(decorated);
    }

    private static void swallowKnownParsingFailure(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isKnownRootCauseInScope(t)) {
                return;
            }
            return;
        }
    }

    private static void checkExactDecimalRecovery(String s, double expected) {
        try {
            Number parsed = NumberUtils.createNumber(s);
            Number parsedD = NumberUtils.createNumber(s + "D");
            Number parsedF = NumberUtils.createNumber(s + "F");
            if (parsed == null || parsedD == null || parsedF == null) {
                return;
            }

            double base = parsed.doubleValue();
            double asD = parsedD.doubleValue();
            double asF = parsedF.doubleValue();

            if (base != expected || asD != expected || asF != expected) {
                throw new RuntimeException(
                    "[oracle:exact-decimal] metamorphic violation: exact integer-valued decimal not recovered"
                        + " input=" + s
                        + " expected=" + expected
                        + " base=" + base
                        + " d=" + asD
                        + " f=" + asF);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isCleanRejection(t) || isKnownRootCauseInScope(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentRepresentations(String s) {
        try {
            Number plain = NumberUtils.createNumber(s);
            Number asD = NumberUtils.createNumber(s + "D");
            Number asF = NumberUtils.createNumber(s + "F");
            if (plain == null || asD == null || asF == null) {
                return;
            }

            double v0 = plain.doubleValue();
            double v1 = asD.doubleValue();
            double v2 = asF.doubleValue();

            if (v0 != v1 || v0 != v2) {
                throw new RuntimeException(
                    "[oracle:eq-repr] metamorphic violation: equivalent decimal representations disagree"
                        + " input=" + s
                        + " plain=" + v0
                        + " d=" + v1
                        + " f=" + v2);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isCleanRejection(t) || isKnownRootCauseInScope(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCauseInScope(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)
                && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(m) || "charAt".equals(m))) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && "isBlank".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String buildDecimalNoExponent(FuzzedDataProvider data) {
        String intPart = digitsOnly(data.consumeAsciiString(12), true);
        String fracPart = digitsOnly(data.consumeAsciiString(12), true);
        if (intPart.length() == 0) {
            intPart = "0";
        }
        if (fracPart.length() == 0) {
            fracPart = "0";
        }
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(intPart).append('.').append(fracPart);
        int suffixChoice = data.consumeInt(0, 4);
        switch (suffixChoice) {
            case 1:
                sb.append('D');
                break;
            case 2:
                sb.append('d');
                break;
            case 3:
                sb.append('F');
                break;
            case 4:
                sb.append('f');
                break;
            default:
                break;
        }
        return sb.toString();
    }

    private static String decorateWithLeadingZeros(int n, int zeroCount, boolean plusNegativeOnly) {
        String abs = Integer.toString(Math.abs(n));
        StringBuilder sb = new StringBuilder();
        if (n < 0) {
            sb.append('-');
        } else if (!plusNegativeOnly) {
            // no-op: keep it valid and simple, createNumber does not document '+' in its tests
        }
        for (int i = 0; i < zeroCount; i++) {
            sb.append('0');
        }
        sb.append(abs).append(".0");
        return sb.toString();
    }

    private static String digitsOnly(String s, boolean allowEmptyFallback) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0 && !allowEmptyFallback) {
            sb.append('0');
        }
        return sb.toString();
    }
}
