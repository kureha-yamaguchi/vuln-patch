    private static void runRealAnchor() {
        RealMatrixImpl a = new RealMatrixImpl(new double[][] {
            { 1, 2 }, { 3, 4 }, { 5, 6 }
        }, false);
        double[] b = a.operate(new double[] { 1, 1 });

        if (b.length != 3) {
            throw new RuntimeException("[oracle:real-anchor-val] metamorphic violation: testMath209 length input=anchor lhs=" + b.length + " rhs=3");
        }
        if (!eq(b[0], 3.0) || !eq(b[1], 7.0) || !eq(b[2], 11.0)) {
            throw new RuntimeException("[oracle:real-anchor-val] metamorphic violation: testMath209 values input=anchor lhs=[" +
                b[0] + "," + b[1] + "," + b[2] + "] rhs=[3.0,7.0,11.0]");
