package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-1000, 1000);
        double expectedRoot = k * Math.PI;

        double left = data.consumeInt(1, 1000) / 1000.0;
        double right = data.consumeInt(1, 1000) / 1000.0;

        if (left >= (Math.PI / 2.0)) {
            left = (Math.PI / 2.0) - 1e-3;
        }
        if (right >= (Math.PI / 2.0)) {
            right = (Math.PI / 2.0) - 1e-3;
        }

        double min = expectedRoot - left;
        double max = expectedRoot + right;
        if (!(min < max)) {
            return;
        }

        double initial;
        if (data.consumeBoolean()) {
            initial = min;
        } else if (data.consumeBoolean()) {
            initial = max;
        } else {
            int position = data.consumeInt(0, 1000);
            initial = min + (max - min) * (position / 1000.0);
        }

        if (initial < min) {
            initial = min;
        }
        if (initial > max) {
            initial = max;
        }

        runStoredFunctionReuseCase(f, min, max, initial, expectedRoot);

        double initial2;
        if (data.consumeBoolean()) {
            initial2 = min + max - initial;
            if (initial2 < min) {
                initial2 = min;
            }
            if (initial2 > max) {
                initial2 = max;
            }
        } else {
            int position2 = data.consumeInt(0, 1000);
            initial2 = min + (max - min) * (position2 / 1000.0);
        }

        runRepeatedReceiverCase(f, min, max, initial, initial2, expectedRoot);
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        runStoredFunctionReuseCase(f, 3.0, 3.2, 3.1, Math.PI);
        runRepeatedReceiverCase(f, 3.0, 3.2, 3.1, 3.05, Math.PI);
    }

    private static void runStoredFunctionReuseCase(
            UnivariateRealFunction f, double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        final double withInitial;
        try {
            withInitial = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:stored-function-reuse] metamorphic violation: valid solve(f,min,max,initial) threw in patched region"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return;
        }

        final double reused;
        try {
            reused = solver.solve(min, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:stored-function-reuse] metamorphic violation: after successful solve(f,min,max,initial), solve(min,max) must solve the same stored function"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " first=" + withInitial,
                        t);
            }
            return;
        }

        final double fresh;
        BisectionSolver freshSolver = new BisectionSolver();
        try {
            fresh = freshSolver.solve(f, min, max);
        } catch (Throwable t) {
            return;
        }

        double tol = Math.max(solver.getAbsoluteAccuracy(), freshSolver.getAbsoluteAccuracy()) * 4.0 + 1e-12;

        /*
         * Contract used here:
         * - solve(f,min,max,initial), solve(f,min,max), and solve(min,max) are sibling public entry points
         *   for the same bisection problem.
         * - After a successful call that supplies f, the receiver must be able to solve the same stored function
         *   via solve(min,max). A band-aid patch that only avoids the original throw but fails to preserve the
         *   receiver's function state violates this relation even if no exception is thrown.
         */
        if (Math.abs(reused - fresh) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-function-reuse] metamorphic violation: receiver solve(min,max) disagreed with fresh solve(f,min,max)"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " reused=" + reused
                            + " fresh=" + fresh
                            + " tol=" + tol);
        }

        if (Math.abs(reused - withInitial) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-vs-initial] metamorphic violation: solve(min,max) after successful solve(f,min,max,initial) changed the root"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " first=" + withInitial
                            + " reused=" + reused
                            + " tol=" + tol);
        }

        if (Math.abs(reused - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:stored-root] metamorphic violation: stored-function solve(min,max) missed constructed SinFunction root"
                            + " expectedRoot=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " reused=" + reused
                            + " tol=" + tol);
        }
    }

    private static void runRepeatedReceiverCase(
            UnivariateRealFunction f, double min, double max, double initial1, double initial2, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();

        final double first;
        try {
            first = solver.solve(f, min, max, initial1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:receiver-repeat] metamorphic violation: first valid solve(f,min,max,initial) threw in patched region"
                                + " min=" + min
                                + " max=" + max
                                + " initial1=" + initial1,
                        t);
            }
            return;
        }

        final double second;
        try {
            second = solver.solve(f, min, max, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:receiver-repeat] metamorphic violation: repeating solve(f,min,max,initial) on same receiver threw in patched region"
                                + " min=" + min
                                + " max=" + max
                                + " initial1=" + initial1
                                + " initial2=" + initial2,
                        t);
            }
            return;
        }

        double tol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;

        /*
         * Contract used here:
         * Bisection on the same real function and interval depends only on the bracketed problem, not on hidden
         * receiver state left behind by an earlier successful call. Repeating the public API on the same receiver
         * with another admissible initial value must therefore recover the same root within solver accuracy.
         * This catches state-corruption fixes that merely mask the original exception.
         */
        if (Math.abs(first - second) > tol) {
            throw new RuntimeException(
                    "[oracle:receiver-repeat] metamorphic violation: same receiver produced different roots across repeated valid solves"
                            + " min=" + min
                            + " max=" + max
                            + " initial1=" + initial1
                            + " initial2=" + initial2
                            + " first=" + first
                            + " second=" + second
                            + " tol=" + tol);
        }

        if (Math.abs(second - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:repeat-root] metamorphic violation: repeated valid solve missed constructed SinFunction root"
                            + " expectedRoot=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial1=" + initial1
                            + " initial2=" + initial2
                            + " result=" + second
                            + " tol=" + tol);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Convergence") || name.contains("Invalid") || name.contains("NoBracketing")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (!(cur instanceof NullPointerException)) {
                continue;
            }
            for (StackTraceElement ste : cur.getStackTrace()) {
                if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                        && "solve".equals(ste.getMethodName())) {
                    return true;
                }
            }
        }
        return false;
    }
}
