    private static void exerciseCategoryPlotBoundary(String category, double value, int index, Layer layer, boolean notify) {
        CategoryMarker domainMarker = new CategoryMarker(category);
        ValueMarker rangeMarker = new ValueMarker(value);

        CategoryPlot fresh = new CategoryPlot();
        try {
            boolean removed = fresh.removeDomainMarker(index, domainMarker, layer, notify);
            if (removed) {
                throw new RuntimeException("[oracle:cat-domain-fresh] metamorphic violation: fresh plot cannot report successful removal of an absent domain marker");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        CategoryPlot freshRange = new CategoryPlot();
        try {
            boolean removed = freshRange.removeRangeMarker(index, rangeMarker, layer, notify);
            if (removed) {
                throw new RuntimeException("[oracle:cat-range-fresh] metamorphic violation: fresh plot cannot report successful removal of an absent range marker");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /* Contract used for this oracle:
           remove*Marker(..., notify) removes the marker, returns whether removal happened,
           and if removed && notify then fireChangeEvent() is called.
           A throw-deleting patch that silently skips bookkeeping or notification breaks this. */
        try {
            CategoryPlot plot = new CategoryPlot();
            CountingPlotChangeListener listener = new CountingPlotChangeListener();
            plot.addChangeListener(listener);

            plot.addDomainMarker(index, domainMarker, layer, false);
            if (!containsMarker(plot.getDomainMarkers(index, layer), domainMarker)) {
                return;
            }

            int before = listener.count;
            boolean removed = plot.removeDomainMarker(index, domainMarker, layer, notify);
            int after = listener.count;
            if (!removed) {
                throw new RuntimeException("[oracle:cat-domain-event] metamorphic violation: added domain marker was not removed");
            }
            if (containsMarker(plot.getDomainMarkers(index, layer), domainMarker)) {
                throw new RuntimeException("[oracle:cat-domain-event] metamorphic violation: removed domain marker still present");
            }
            int expectedDelta = notify ? 1 : 0;
            if (after - before != expectedDelta) {
                throw new RuntimeException("[oracle:cat-domain-event] metamorphic violation: notify contract broken expectedDelta=" + expectedDelta + " actualDelta=" + (after - before));
            }

            before = listener.count;
            boolean removedAgain = plot.removeDomainMarker(index, domainMarker, layer, notify);
            after = listener.count;
            if (removedAgain) {
                throw new RuntimeException("[oracle:cat-domain-event] metamorphic violation: second removal of same domain marker must be false");
