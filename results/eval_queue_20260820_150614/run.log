package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        String candidate = buildThreeCharTrigger(data);
        exercise(candidate, false);

        int extraChecks = data.consumeInt(1, 6);
        for (int i = 0; i < extraChecks; i++) {
            exercise(buildThreeCharTrigger(data), false);
        }

        if (data.consumeBoolean()) {
            String noisy = data.consumeAsciiString(12);
            if (noisy != null && noisy.length() >= 3) {
                int start = data.consumeInt(0, noisy.length() - 3);
                String slice = noisy.substring(start, start + 3);
                if (isThreeCharNonYes(slice)) {
                    exercise(slice, false);
                }
            }
        }
    }

    private static void exercise(String s, boolean isAnchor) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            if (isThreeCharNonYes(s)) {
                /*
                 * Contract/oracle:
                 * From the shown implementation and the provided test cases, the only
                 * length-3 strings recognized as true are case-insensitive "yes".
                 * Any other 3-character string must therefore return false.
                 * This catches a "fixed" patch that merely suppresses the crash but
                 * returns the wrong boolean for the buggy input shape.
                 */
                if (result) {
                    throw new RuntimeException(
                        "[oracle:three-char-false] metamorphic violation: non-yes 3-char string must parse as false input="
                            + quote(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && (isAnchor || isThreeCharNonYes(s))) {
                throw t;
            }
        }
    }

    private static String buildThreeCharTrigger(FuzzedDataProvider data) {
        char c0 = chooseNonYFirst(data);
        char c1 = chooseAsciiChar(data);
        char c2 = chooseAsciiChar(data);
        String s = new String(new char[] { c0, c1, c2 });

        if (!isThreeCharNonYes(s)) {
            s = "off";
        }
        return s;
    }

    private static char chooseNonYFirst(FuzzedDataProvider data) {
        char c = chooseAsciiChar(data);
        if (c == 'y' || c == 'Y') {
            c = 'o';
        }
        return c;
    }

    private static char chooseAsciiChar(FuzzedDataProvider data) {
        return (char) data.consumeInt(32, 126);
    }

    private static boolean isThreeCharNonYes(String s) {
        if (s == null || s.length() != 3) {
            return false;
        }
        return !equalsIgnoreCase3(s, 'y', 'e', 's');
    }

    private static boolean equalsIgnoreCase3(String s, char a, char b, char c) {
        return sameIgnoreCase(s.charAt(0), a)
            && sameIgnoreCase(s.charAt(1), b)
            && sameIgnoreCase(s.charAt(2), c);
    }

    private static boolean sameIgnoreCase(char x, char y) {
        return x == y || Character.toLowerCase(x) == Character.toLowerCase(y);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
