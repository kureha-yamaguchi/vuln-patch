package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorExactRegressionInput();
        exploreConstructedValidInputs(data);
    }

    private static void anchorExactRegressionInput() {
        org.apache.commons.math.distribution.NormalDistributionImpl normal =
                new org.apache.commons.math.distribution.NormalDistributionImpl(0.0, 1.0);
        double p = 0.9772498680518209;
        try {
            normal.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isCleanRejection(t) || isKnownRootCause(t)) {
                return;
            }
        }
    }

    private static void exploreConstructedValidInputs(FuzzedDataProvider data) {
        org.apache.commons.math.distribution.NormalDistributionImpl standard =
                new org.apache.commons.math.distribution.NormalDistributionImpl(0.0, 1.0);

        int z = data.consumeInt(1, 6);
        int meanInt = data.consumeInt(-50, 50);
        int sdInt = data.consumeInt(1, 20);
        double mean = meanInt;
        double sd = sdInt;

        double p;
        try {
            p = standard.cumulativeProbability((double) z);
        } catch (Throwable t) {
            return;
        }

        if (!(p > 0.0 && p < 1.0) || Double.isNaN(p)) {
            return;
        }

        org.apache.commons.math.distribution.NormalDistributionImpl shifted =
                new org.apache.commons.math.distribution.NormalDistributionImpl(mean, sd);

        Double xStd = tryInverse(standard, p);
        Double xShifted = tryInverse(shifted, p);
        if (xStd != null && xShifted != null) {
            double expectedShifted = mean + sd * xStd.doubleValue();
            double tol = 1.0e-9 * Math.max(1.0, Math.abs(expectedShifted));
            if (Math.abs(xShifted.doubleValue() - expectedShifted) > tol) {
                throw new RuntimeException(
                        "[oracle:normal-affine] metamorphic violation: affine equivariance input="
                                + " z=" + z
                                + " p=" + p
                                + " mean=" + mean
                                + " sd=" + sd
                                + " stdInv=" + xStd
                                + " shiftedInv=" + xShifted
                                + " expected=" + expectedShifted);
            }
        }

        double pLow;
        double pHigh;
        try {
            pLow = standard.cumulativeProbability((double) (z - 1));
            pHigh = standard.cumulativeProbability((double) (z + 1));
        } catch (Throwable t) {
            return;
        }

        if (!(pLow < p && p < pHigh)) {
            return;
        }

        Double xLow = tryInverse(standard, pLow);
        Double xMid = tryInverse(standard, p);
        Double xHigh = tryInverse(standard, pHigh);
        if (xLow != null && xMid != null && xHigh != null) {
            if (!(xLow.doubleValue() <= xMid.doubleValue() && xMid.doubleValue() <= xHigh.doubleValue())) {
                throw new RuntimeException(
                        "[oracle:normal-monotone] metamorphic violation: inverse CDF must be non-decreasing input="
                                + " pLow=" + pLow
                                + " pMid=" + p
                                + " pHigh=" + pHigh
                                + " xLow=" + xLow
                                + " xMid=" + xMid
                                + " xHigh=" + xHigh);
            }
        }

        double pNeighbor = data.consumeBoolean() ? Math.nextAfter(p, 0.0) : Math.nextAfter(p, 1.0);
        if (pNeighbor > 0.0 && pNeighbor < 1.0 && pNeighbor != p) {
            Double x1 = tryInverse(standard, Math.min(p, pNeighbor));
            Double x2 = tryInverse(standard, Math.max(p, pNeighbor));
            if (x1 != null && x2 != null && x1.doubleValue() > x2.doubleValue()) {
                throw new RuntimeException(
                        "[oracle:normal-local-order] metamorphic violation: local inverse CDF order broken input="
                                + " p1=" + Math.min(p, pNeighbor)
                                + " p2=" + Math.max(p, pNeighbor)
                                + " x1=" + x1
                                + " x2=" + x2);
            }
        }
    }

    private static Double tryInverse(org.apache.commons.math.distribution.NormalDistributionImpl dist, double p) {
        try {
            return new Double(dist.inverseCumulativeProbability(p));
        } catch (Throwable t) {
            if (isCleanRejection(t) || isKnownRootCause(t)) {
                return null;
            }
            return null;
        }
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof org.apache.commons.math.MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if (("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method))
                || ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method))
                || ("org.apache.commons.math.ConvergenceException".equals(cls)
                    && "<init>".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("IllegalArgument")
                || name.contains("Invalid")
                || name.contains("OutOfRange")
                || name.contains("NoData")
                || name.contains("NullArgument");
    }
}
