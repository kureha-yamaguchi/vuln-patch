    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runFitOnly(ANCHOR_DATA, true);

        double[] generated = buildTailLikeDataset(data);
        runFitOnly(generated, true);
        checkFitOverloadConsistency(generated);

        if (data.consumeBoolean()) {
            double[] mutated = generated.clone();
            if (mutated.length > 0) {
                int idx = data.consumeInt(0, mutated.length - 1);
                int delta = data.consumeInt(0, 3);
                mutated[idx] *= (1.0 + (delta * 0.01));
            }
            runFitOnly(mutated, true);
            checkFitOverloadConsistency(mutated);
        }
    }

    private static double[] buildTailLikeDataset(FuzzedDataProvider data) {
        int len = data.consumeInt(3, 40);
        int scaleInt = data.consumeInt(1, 1_000_000);
        int sigmaTenths = data.consumeInt(1, 80);
        int offset = data.consumeInt(1, 80);
        boolean increasing = data.consumeBoolean();

        double norm = scaleInt / 1000.0;
        double sigma = sigmaTenths / 10.0;
        double mean = increasing ? (len - 1 + offset) : (-offset);

        Gaussian g = new Gaussian(norm, mean, sigma);
        double[] y = new double[len];
        for (int i = 0; i < len; i++) {
            double v = g.value(i);
            if (!(v >= 0.0) || Double.isNaN(v) || Double.isInfinite(v)) {
                v = 0.0;
            }
            y[i] = v;
        }
        return y;
    }

    private static void runFitOnly(double[] y, boolean validByConstruction) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        addObservations(fitter, y);
        try {
            fitter.fit();
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t, validByConstruction)) {
                rethrow(t);
            }
        }
    }

    private static void checkFitOverloadConsistency(double[] y) {
        GaussianFitter fitterA = new GaussianFitter(new LevenbergMarquardtOptimizer());
        GaussianFitter fitterB = new GaussianFitter(new LevenbergMarquardtOptimizer());
        addObservations(fitterA, y);
        addObservations(fitterB, y);

        double[] guess;
        try {
            guess = (new GaussianFitter.ParameterGuesser(fitterB.getObservations())).guess();
        } catch (Throwable t) {
            return;
        }

        double[] viaNoArg;
        try {
            viaNoArg = fitterA.fit();
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t, true)) {
                rethrow(t);
            }
            return;
        }

        double[] viaExplicitGuess;
        try {
            viaExplicitGuess = fitterB.fit(guess);
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t, true)) {
                rethrow(t);
            }
            return;
        }

        if (viaNoArg == null || viaExplicitGuess == null || viaNoArg.length != viaExplicitGuess.length) {
            throw new RuntimeException("[oracle:fit-overload] metamorphic violation: fit() and fit(guess()) should agree on result shape");
