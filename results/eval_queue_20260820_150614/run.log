package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        runCase(f, Math.PI, 3.0, 3.2, 3.1);

        int k = data.consumeInt(-1000, 1000);
        double expectedRoot = k * Math.PI;

        double left = boundedPositive(data.consumeInt(), 0.01, 1.0);
        double right = boundedPositive(data.consumeInt(), 0.01, 1.0);

        double min = expectedRoot - left;
        double max = expectedRoot + right;

        double t = boundedUnit(data.consumeInt());
        double initial = min + (max - min) * t;

        runCase(f, expectedRoot, min, max, initial);

        if (data.remainingBytes() > 0) {
            int k2 = data.consumeInt(-1000, 1000);
            double expectedRoot2 = k2 * Math.PI;
            double left2 = boundedPositive(data.consumeInt(), 0.01, 1.0);
            double right2 = boundedPositive(data.consumeInt(), 0.01, 1.0);
            double min2 = expectedRoot2 - left2;
            double max2 = expectedRoot2 + right2;
            double t2 = boundedUnit(data.consumeInt());
            double initial2 = min2 + (max2 - min2) * t2;
            runCase(f, expectedRoot2, min2, max2, initial2);
        }
    }

    private static void runCase(UnivariateRealFunction f, double expectedRoot, double min, double max, double initial) {
        if (!(f != null) || Double.isNaN(min) || Double.isNaN(max) || Double.isNaN(initial)) {
            return;
        }
        if (!(min < max) || initial < min || initial > max) {
            return;
        }

        BisectionSolver withInitial = new BisectionSolver();
        BisectionSolver withoutInitial = new BisectionSolver();

        double resultWithInitial;
        double resultWithoutInitial;

        try {
            resultWithInitial = withInitial.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw rethrow(t);
            }
            return;
        }

        try {
            resultWithoutInitial = withoutInitial.solve(f, min, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        double tol = Math.max(withInitial.getAbsoluteAccuracy(), withoutInitial.getAbsoluteAccuracy()) * 4.0 + 1e-12;

        /*
         * Contract/oracle: these are documented sibling solve overloads for the same function
         * and interval, so a correct implementation must agree up to solver accuracy. A patch
         * that merely suppresses the buggy throw or skips using the provided function breaks this.
         */
        if (Math.abs(resultWithInitial - resultWithoutInitial) > tol) {
            throw new RuntimeException(
                    "[oracle:overload-agree] metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " lhs=" + resultWithInitial
                            + " rhs=" + resultWithoutInitial
                            + " tol=" + tol);
        }

        /*
         * Contract/oracle from the input construction: min and max are built around a known zero
         * of the real library SinFunction, so the solver must return that same root within its
         * advertised absolute accuracy.
         */
        if (Math.abs(resultWithInitial - expectedRoot) > tol) {
            throw new RuntimeException(
                    "[oracle:known-root] metamorphic violation: solver missed constructed SinFunction root"
                            + " expected=" + expectedRoot
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " result=" + resultWithInitial
                            + " tol=" + tol);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseNpeFromPatchedRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        Throwable cur = t;
        while (cur != null) {
            StackTraceElement[] trace = cur.getStackTrace();
            if (trace != null) {
                for (int i = 0; i < trace.length; i++) {
                    StackTraceElement e = trace[i];
                    if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                            && "solve".equals(e.getMethodName())) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

    private static double boundedPositive(int raw, double min, double max) {
        long nonNegative = raw == Integer.MIN_VALUE ? 0L : Math.abs((long) raw);
        double fraction = (nonNegative % 1000000L) / 999999.0;
        return min + (max - min) * fraction;
    }

    private static double boundedUnit(int raw) {
        long nonNegative = raw == Integer.MIN_VALUE ? 0L : Math.abs((long) raw);
        return (nonNegative % 1000000L) / 999999.0;
    }
}
