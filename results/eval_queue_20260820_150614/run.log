public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            triggerBug();
            return;
        }

        int mode = data.consumeInt(0, 2);
        if (mode == 0) {
            triggerBug();
            return;
        }

        boolean inside = data.consumeBoolean();
        PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(inside)));

        if (data.consumeBoolean()) {
            Vector2D[][] vertices1 = set.getVertices();
            Vector2D[][] vertices2 = set.getVertices();
            if (vertices1.length != vertices2.length) {
                throw new RuntimeException("[oracle:vertices-repeat] metamorphic violation: repeated getVertices changed loop count");
            }
        }

        double size = set.getSize();
        Vector2D bary = (Vector2D) set.getBarycenter();
        double size2 = set.getSize();
        Vector2D bary2 = (Vector2D) set.getBarycenter();

        if (different(size, size2) || differentPoint(bary, bary2)) {
            throw new RuntimeException("[oracle:stable-geometry] metamorphic violation: repeated geometry reads changed results");
        }

        Vector2D probe = new Vector2D(
                data.consumeInt(-100000, 100000) / 100.0,
                data.consumeInt(-100000, 100000) / 100.0);
        Region.Location location = set.checkPoint(probe);

        /*
         * From computeGeometricalProperties:
         * - no-cut tree + Boolean.TRUE means whole space, so size is +infinity and barycenter is NaN.
         * - no-cut tree + Boolean.FALSE means empty space, so size is 0 and barycenter is (0,0).
         * Also, point classification must agree with whole-vs-empty space.
         */
        if (inside) {
            if (!(Double.isInfinite(size) && size > 0.0)) {
                throw new RuntimeException("[oracle:true-size] metamorphic violation: whole-space leaf must report +infinity, got " + size);
            }
            if (!(Double.isNaN(bary.getX()) && Double.isNaN(bary.getY()))) {
                throw new RuntimeException("[oracle:true-bary] metamorphic violation: whole-space leaf must report NaN barycenter, got " + bary);
            }
            if (location != Region.Location.INSIDE) {
                throw new RuntimeException("[oracle:true-location] metamorphic violation: whole-space leaf must classify every point as INSIDE, got " + location);
            }
        } else {
            if (size != 0.0) {
                throw new RuntimeException("[oracle:false-size] metamorphic violation: empty leaf must report size 0, got " + size);
            }
            if (bary.getX() != 0.0 || bary.getY() != 0.0) {
                throw new RuntimeException("[oracle:false-bary] metamorphic violation: empty leaf must report origin barycenter, got " + bary);
            }
            if (location != Region.Location.OUTSIDE) {
                throw new RuntimeException("[oracle:false-location] metamorphic violation: empty leaf must classify every point as OUTSIDE, got " + location);
            }
        }
    }

    private static void triggerBug() {
        SubHyperplane<Euclidean2D> plusOutside = null;
        SubHyperplane<Euclidean2D> plusInside = null;
        BoundaryAttribute<Euclidean2D> attribute =
                new BoundaryAttribute<Euclidean2D>(plusOutside, plusInside);
        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(attribute);
        PolygonsSet set = new PolygonsSet(tree);

        set.getVertices();
        set.computeGeometricalProperties();
    }

    private static boolean different(double a, double b) {
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a != b;
        }
        return Double.doubleToLongBits(a) != Double.doubleToLongBits(b);
    }

    private static boolean differentPoint(Vector2D a, Vector2D b) {
        return different(a.getX(), b.getX()) || different(a.getY(), b.getY());
    }
}
