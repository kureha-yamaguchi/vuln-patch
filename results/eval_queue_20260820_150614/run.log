package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int root = data.consumeInt(-50, 50);
        int step = data.consumeInt(1, 6);
        int maxIterations = data.consumeInt(1, 64);

        double r = root;
        double initial = r - step;
        double lower = initial - step;
        double upper = r;

        if (!(lower < initial && initial <= upper)) {
            return;
        }

        PolynomialFunction negativeAtA = new PolynomialFunction(new double[] { -r, 1.0 });
        PolynomialFunction positiveAtA = new PolynomialFunction(new double[] { r, -1.0 });

        double[] negWithOne = tryBracket(negativeAtA, initial, lower, upper, 1, "neg-max1");
        double[] negWithMany = tryBracket(negativeAtA, initial, lower, upper, maxIterations, "neg-maxN");
        double[] posWithOne = tryBracket(positiveAtA, initial, lower, upper, 1, "pos-max1");
        double[] posWithMany = tryBracket(positiveAtA, initial, lower, upper, maxIterations, "pos-maxN");

        /* Contract used for this oracle:
         * The documented sibling overloads of bracket are required to agree on equivalent inputs.
         * Here the root is reached in the first expansion step by construction, so any positive
         * maximumIterations value is sufficient; changing it must not change the returned bracket.
         * A throw-deleting or overfit patch that alters the loop/acceptance condition can violate
         * this even if it silences the known top-level MathException.
         */
        requireSameBracket(negWithOne, negWithMany, "overload-agree-neg", root, step, maxIterations);
        requireSameBracket(posWithOne, posWithMany, "overload-agree-pos", root, step, maxIterations);

        /* Metamorphic relation:
         * Replacing f by -f preserves every root and every endpoint-zero condition. The bracketing
         * loop uses only endpoint evaluations and their sign product, which is unchanged by a global
         * sign flip. Therefore a correct implementation must return the same bracket for x-r and r-x
         * on the same valid input.
         * This specifically probes the patched condition because the buggy variant depends on fa's
         * sign rather than on fa*fb, so the result changes when the function is negated.
         */
        requireSameBracket(negWithMany, posWithMany, "sign-flip-invariant", root, step, maxIterations);

        /* Post-condition on valid-by-construction input:
         * We built the interval so the upper endpoint is exactly the known root r, hence any correct
         * returned bracket must still include that root. This is checked only after both calls above
         * completed without exception.
         */
        requireContainsKnownRoot(negWithMany, r, "contains-known-root-neg");
        requireContainsKnownRoot(posWithMany, r, "contains-known-root-pos");
    }

    private static void anchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            normal.inverseCumulativeProbability(0.9772498680518209d);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthLikeButAlreadyCovered(t)) {
                return;
            }
        }
    }

    private static double[] tryBracket(PolynomialFunction function, double initial, double lower,
                                       double upper, int maximumIterations, String label) {
        try {
            return UnivariateRealSolverUtils.bracket(function, initial, lower, upper, maximumIterations);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (hasBracketFrame(t)) {
                throw new RuntimeException(
                    "[oracle:" + label + "] valid bracketing input was rejected: initial=" + initial
                        + " lower=" + lower + " upper=" + upper + " maxIterations=" + maximumIterations
                        + " throwable=" + t.getClass().getName() + ": " + String.valueOf(t.getMessage()),
                    t);
            }
            return null;
        }
    }

    private static void requireSameBracket(double[] a, double[] b, String oracle,
                                           int root, int step, int maximumIterations) {
        if (a == null || b == null) {
            return;
        }
        if (a.length != 2 || b.length != 2) {
            throw new RuntimeException(
                "[oracle:" + oracle + "] metamorphic violation: malformed bracket arrays"
                    + " root=" + root + " step=" + step + " maxIterations=" + maximumIterations);
        }
        if (Double.doubleToLongBits(a[0]) != Double.doubleToLongBits(b[0])
                || Double.doubleToLongBits(a[1]) != Double.doubleToLongBits(b[1])) {
            throw new RuntimeException(
                "[oracle:" + oracle + "] metamorphic violation: brackets disagree"
                    + " root=" + root + " step=" + step + " maxIterations=" + maximumIterations
                    + " lhs=[" + a[0] + "," + a[1] + "] rhs=[" + b[0] + "," + b[1] + "]");
        }
    }

    private static void requireContainsKnownRoot(double[] bracket, double root, String oracle) {
        if (bracket == null || bracket.length != 2) {
            return;
        }
        if (!(bracket[0] <= root && root <= bracket[1])) {
            throw new RuntimeException(
                "[oracle:" + oracle + "] metamorphic violation: returned bracket excludes known root"
                    + " root=" + root + " bracket=[" + bracket[0] + "," + bracket[1] + "]");
        }
    }

    private static boolean hasBracketFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(e.getClassName())
                    && "bracket".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.math.analysis.UnivariateRealFunction".equals(e.getClassName())
                    && "value".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.math.ConvergenceException".equals(e.getClassName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isGroundTruthLikeButAlreadyCovered(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(e.getClassName())
                    && "inverseCumulativeProbability".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
