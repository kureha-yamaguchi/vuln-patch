package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    /*
     * Contract asserted:
     * When str.length() >= width, appendFixedWidthPadRight(obj, width, padChar)
     * must append exactly the first width characters of obj.toString().
     * So for valid inputs it must agree with the real sibling API
     * append(str, 0, width) on a fresh builder.
     * A throw-deleting/band-aid patch can silence the original crash while still
     * producing wrong state/output; this sibling-equivalence oracle would catch that.
     */
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int mode = data.consumeInt(0, 2);
        int initialCapacity = data.consumeInt(1, 8);
        int prefixLen = data.consumeInt(0, 8);
        String prefix = data.consumeString(prefixLen);
        char pad = (char) (data.consumeByte() & 0xff);

        if (mode == 0) {
            String s = data.consumeString(32);
            if (s == null) {
                return;
            }
            if (s.length() == 0) {
                s = "A";
            }
            int width = data.consumeInt(1, Math.max(1, s.length()));
            if (s.length() < width) {
                s = s + repeat('X', width - s.length());
            }
            if (s.length() < width) {
                return;
            }
            runNonNullCase(initialCapacity, prefix, s, width, pad);
        } else {
            String nullText = data.consumeString(32);
            if (nullText == null) {
                return;
            }
            if (nullText.length() == 0) {
                nullText = "N";
            }
            int width = data.consumeInt(1, Math.max(1, nullText.length()));
            if (nullText.length() < width) {
                nullText = nullText + repeat('Z', width - nullText.length());
            }
            if (nullText.length() < width) {
                return;
            }
            runNullCase(initialCapacity, prefix, nullText, width, pad);
        }
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String actual = sb.toString();
        if (!"f".equals(actual)) {
            throw new RuntimeException("[oracle:anchor-output] expected=f actual=" + actual);
        }

        StrBuilder sibling = new StrBuilder(1);
        try {
            sibling.append("foo", 0, 1);
        } catch (RuntimeException ignored) {
            return;
        }
        if (!actual.equals(sibling.toString())) {
            throw new RuntimeException("[oracle:substr-equiv-anchor] lhs=" + actual + " rhs=" + sibling.toString());
        }
    }

    private static void runNonNullCase(int initialCapacity, String prefix, String s, int width, char pad) {
        StrBuilder lhs = new StrBuilder(initialCapacity);
        StrBuilder rhs = new StrBuilder(initialCapacity);
        try {
            lhs.append(prefix);
            lhs.appendFixedWidthPadRight((Object) s, width, pad);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            rhs.append(prefix);
            rhs.append(s, 0, width);
        } catch (RuntimeException ignored) {
            return;
        }

        checkEquivalent(prefix, width, lhs, rhs, "substr-equiv");
    }

    private static void runNullCase(int initialCapacity, String prefix, String nullText, int width, char pad) {
        StrBuilder lhs = new StrBuilder(initialCapacity);
        StrBuilder rhs = new StrBuilder(initialCapacity);
        try {
            lhs.setNullText(nullText);
            lhs.append(prefix);
            lhs.appendFixedWidthPadRight((Object) null, width, pad);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            rhs.append(prefix);
            rhs.append(nullText, 0, width);
        } catch (RuntimeException ignored) {
            return;
        }

        if (!nullText.equals(lhs.getNullText())) {
            throw new RuntimeException("[oracle:nulltext-stable] expected=" + escape(nullText) + " actual=" + escape(lhs.getNullText()));
        }

        checkEquivalent(prefix, width, lhs, rhs, "null-substr-equiv");
    }

    private static void checkEquivalent(String prefix, int width, StrBuilder lhs, StrBuilder rhs, String oracleId) {
        String l = lhs.toString();
        String r = rhs.toString();
        if (!l.equals(r)) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: appendFixedWidthPadRight vs append(str,0,width) prefix="
                    + escape(prefix) + " width=" + width + " lhs=" + escape(l) + " rhs=" + escape(r));
        }

        if (lhs.length() != rhs.length()) {
            throw new RuntimeException("[oracle:length-substr-equiv] lhsLen=" + lhs.length() + " rhsLen=" + rhs.length()
                    + " lhs=" + escape(l) + " rhs=" + escape(r));
        }

        char[] lchars = lhs.toCharArray();
        char[] rchars = rhs.toCharArray();
        if (lchars.length != rchars.length) {
            throw new RuntimeException("[oracle:tochar-length] lhs=" + lchars.length + " rhs=" + rchars.length);
        }
        for (int i = 0; i < lchars.length; i++) {
            if (lchars[i] != rchars[i]) {
                throw new RuntimeException("[oracle:tochar-equiv] index=" + i + " lhs=" + (int) lchars[i] + " rhs=" + (int) rchars[i]
                        + " lhsStr=" + escape(l) + " rhsStr=" + escape(r));
            }
        }

        char[] dst1 = new char[lhs.length()];
        char[] dst2 = new char[rhs.length()];
        try {
            lhs.getChars(0, lhs.length(), dst1, 0);
            rhs.getChars(0, rhs.length(), dst2, 0);
        } catch (RuntimeException ignored) {
            return;
        }
        for (int i = 0; i < dst1.length; i++) {
            if (dst1[i] != dst2[i]) {
                throw new RuntimeException("[oracle:getchars-range-equiv] index=" + i + " lhs=" + (int) dst1[i] + " rhs=" + (int) dst2[i]);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)) {
                if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String repeat(char c, int count) {
        if (count <= 0) {
            return "";
        }
        char[] out = new char[count];
        for (int i = 0; i < count; i++) {
            out[i] = c;
        }
        return new String(out);
    }

    private static String escape(String s) {
        return s == null ? "null" : s.replace("\u0000", "\\0");
    }
}
