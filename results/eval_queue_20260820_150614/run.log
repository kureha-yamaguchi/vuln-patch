package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchorScenario();
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        int dimension = data.consumeInt(1, 5);
        int pivot = data.consumeInt(0, dimension - 1);
        int duplicates = data.consumeInt(2, 5);
        int rhs = data.consumeInt(1, 20);
        int objective = data.consumeInt(1, 7);
        int maxUlps = data.consumeInt(1, 32);

        try {
            runScenario(dimension, pivot, duplicates, rhs, objective, maxUlps, data.consumeBoolean());
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runAnchorScenario() {
        runScenario(3, 1, 2, 1, 1, 10, false);
    }

    private static void runScenario(int dimension, int pivot, int duplicates, int rhs, int objectiveCoeff, int maxUlps, boolean reverseFirst) {
        LinearObjectiveFunction f = buildObjective(dimension, pivot, objectiveCoeff);
        List<LinearConstraint> constraints = buildUniquePointDegenerateConstraints(dimension, pivot, duplicates, rhs);

        checkTableauConsistency(f, constraints, GoalType.MAXIMIZE);

        List<LinearConstraint> reordered = new ArrayList<LinearConstraint>(constraints);
        if (reverseFirst) {
            Collections.reverse(reordered);
        } else {
            Collections.rotate(reordered, 1);
        }

        PointValuePair lhs;
        PointValuePair rhsResult;
        try {
            lhs = solve(f, constraints, maxUlps);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            rhsResult = solve(f, reordered, maxUlps);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (lhs == null || rhsResult == null) {
            return;
        }

        // Contract used for this oracle:
        // - The constraints are constructed to define a unique feasible point:
        //   pivot variable is forced by repeated GEQ and one LEQ to x[pivot] == rhs,
        //   all other variables are forced to 0 by non-negativity + LEQ 0.
        // - Reordering constraints is semantics-preserving for a linear program,
        //   so a correct solver must return the same unique point and value.
        // A throw-deleting or branch-skipping patch in pivot-row selection can silently
        // return a wrong basis/solution while no exception fires; this check still catches it.
        if (!validSolution(lhs, constraints, EPS) || !validSolution(rhsResult, reordered, EPS)) {
            throw new RuntimeException("[oracle:valid-solution] metamorphic violation: solver returned an invalid solution");
        }

        double[] p1 = lhs.getPoint();
        double[] p2 = rhsResult.getPoint();
        if (p1.length != dimension || p2.length != dimension) {
            throw new RuntimeException("[oracle:shape] metamorphic violation: unexpected point dimension lhs=" + p1.length + " rhs=" + p2.length + " expected=" + dimension);
        }

        for (int i = 0; i < dimension; i++) {
            double expected = (i == pivot) ? rhs : 0.0;
            if (!Precision.equals(p1[i], expected, 10) || !Precision.equals(p2[i], expected, 10)) {
                throw new RuntimeException("[oracle:unique-point] metamorphic violation: expected x[" + i + "]=" + expected + " lhs=" + p1[i] + " rhs=" + p2[i]);
            }
            if (!Precision.equals(p1[i], p2[i], 10)) {
                throw new RuntimeException("[oracle:reorder-point] metamorphic violation: reordering constraints changed point at index " + i + " lhs=" + p1[i] + " rhs=" + p2[i]);
            }
        }

        double expectedValue = objectiveCoeff * (double) rhs;
        if (!Precision.equals(lhs.getValue(), expectedValue, 10) || !Precision.equals(rhsResult.getValue(), expectedValue, 10)) {
            throw new RuntimeException("[oracle:objective] metamorphic violation: expected value=" + expectedValue + " lhs=" + lhs.getValue() + " rhs=" + rhsResult.getValue());
        }
        if (!Precision.equals(lhs.getValue(), rhsResult.getValue(), 10)) {
            throw new RuntimeException("[oracle:reorder-value] metamorphic violation: reordering constraints changed objective lhs=" + lhs.getValue() + " rhs=" + rhsResult.getValue());
        }
    }

    private static LinearObjectiveFunction buildObjective(int dimension, int pivot, int coeff) {
        double[] c = new double[dimension];
        c[pivot] = coeff;
        return new LinearObjectiveFunction(c, 0.0);
    }

    private static List<LinearConstraint> buildUniquePointDegenerateConstraints(int dimension, int pivot, int duplicates, int rhs) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        for (int k = 0; k < duplicates; k++) {
            double[] geq = new double[dimension];
            geq[pivot] = 1.0;
            constraints.add(new LinearConstraint(geq, Relationship.GEQ, rhs));
        }

        double[] leqPivot = new double[dimension];
        leqPivot[pivot] = 1.0;
        constraints.add(new LinearConstraint(leqPivot, Relationship.LEQ, rhs));

        for (int i = 0; i < dimension; i++) {
            if (i == pivot) {
                continue;
            }
            double[] zeroFix = new double[dimension];
            zeroFix[i] = 1.0;
            constraints.add(new LinearConstraint(zeroFix, Relationship.LEQ, 0.0));
        }

        return constraints;
    }

    private static PointValuePair solve(LinearObjectiveFunction f, List<LinearConstraint> constraints, int maxUlps) {
        SimplexSolver solver = new SimplexSolver(EPS, maxUlps);
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static void checkTableauConsistency(LinearObjectiveFunction f, List<LinearConstraint> constraints, GoalType goalType) {
        SimplexTableau t1 = new SimplexTableau(f, constraints, goalType, true, EPS);
        SimplexTableau t2 = new SimplexTableau(f, constraints, goalType, true, EPS);

        double[][] data1 = t1.getData();
        if (data1 == null || data1.length == 0 || data1[0] == null || data1[0].length == 0) {
            return;
        }

        int empiricalHeight = data1.length;
        int empiricalWidth = data1[0].length;
        if (t1.getHeight() != empiricalHeight || t1.getWidth() != empiricalWidth) {
            throw new RuntimeException("[oracle:tableau-dims] metamorphic violation: helper dimensions disagree with matrix dimensions height=" + t1.getHeight() + "/" + empiricalHeight + " width=" + t1.getWidth() + "/" + empiricalWidth);
        }

        int expectedObjectives = t1.getNumArtificialVariables() > 0 ? 2 : 1;
        if (t1.getNumObjectiveFunctions() != expectedObjectives) {
            throw new RuntimeException("[oracle:num-objectives] metamorphic violation: getNumObjectiveFunctions disagrees with numArtificialVariables helper=" + t1.getNumObjectiveFunctions() + " expected=" + expectedObjectives);
        }

        if (t1.getHeight() != t2.getHeight()
                || t1.getWidth() != t2.getWidth()
                || t1.getNumObjectiveFunctions() != t2.getNumObjectiveFunctions()
                || t1.getNumArtificialVariables() != t2.getNumArtificialVariables()
                || t1.getArtificialVariableOffset() != t2.getArtificialVariableOffset()) {
            throw new RuntimeException("[oracle:fresh-tableau] metamorphic violation: identically constructed tableaux disagree");
        }

        int art = t1.getNumArtificialVariables();
        int off = t1.getArtificialVariableOffset();
        for (int i = 0; i < art; i++) {
            int column = off + i;
            Integer basic = t1.getBasicRow(column);
            if (basic == null) {
                throw new RuntimeException("[oracle:basic-row] metamorphic violation: artificial column " + column + " has no basic row");
            }
            if (basic.intValue() < t1.getNumObjectiveFunctions() || basic.intValue() >= t1.getHeight()) {
                throw new RuntimeException("[oracle:basic-row-range] metamorphic violation: basic row out of range row=" + basic + " height=" + t1.getHeight());
            }
            double entry = t1.getEntry(basic.intValue(), column);
            if (!Precision.equals(entry, 1.0, 10)) {
                throw new RuntimeException("[oracle:basic-entry] metamorphic violation: basic row entry for artificial column is not 1.0 column=" + column + " row=" + basic + " entry=" + entry);
            }
        }
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

