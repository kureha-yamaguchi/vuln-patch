private static void runNullTextEquivalence(String prefix, String source, int width, char padChar) {
        if (width <= 0 || source == null || source.length() <= width || prefix.length() == 0) {
            return;
        }

        StrBuilder viaNull = new StrBuilder(prefix.length());
        StrBuilder viaObject = new StrBuilder(prefix.length());

        try {
            viaNull.append(prefix);
            viaNull.setNullText(source);
            viaNull.appendFixedWidthPadRight((Object) null, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            viaObject.append(prefix);
            viaObject.appendFixedWidthPadRight((Object) source, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract from the implementation:
         *   String str = (obj == null ? getNullText() : obj.toString());
         * Therefore, when nullText is set to the same String as a direct Object's toString(),
         * both calls must append the same fixed-width field. This exercises getNullText()
         * through the real public API and catches band-aid fixes that only special-case the
         * non-null branch.
         */
        String lhs = viaNull.toString();
        String rhs = viaObject.toString();
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:nulltext-equiv] metamorphic violation: nullText path disagrees with direct object path prefix="
                    + prefix + " width=" + width + " src=" + source + " lhs=" + lhs + " rhs=" + rhs);
        }
    }
