        double delta = data.consumeInt(1, 5);
        backing[rows - 1][0] = oldLast + delta;

        double[] out2 = m.operate(e0);
        double expectedUpdated = m.getEntry(rows - 1, 0);
        if (out2.length <= rows - 1 || !eq(out2[rows - 1], expectedUpdated)) {
            throw new RuntimeException("[oracle:real-alias-update] metamorphic violation: copyArray=false alias reflected in operate input=lastRow lhs=" +
                (out2.length > rows - 1 ? String.valueOf(out2[rows - 1]) : "<missing>") + " rhs=" + expectedUpdated);
        }
        if (eq(out2[rows - 1], oldLast)) {
            throw new RuntimeException("[oracle:real-alias-change] metamorphic violation: mutated backing must change last one-hot result input=lastRow lhs=" +
                out2[rows - 1] + " rhs_not=" + oldLast);
        }
    }

    private static boolean eq(double a, double b) {
        return Math.abs(a - b) <= 1.0e-12;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.endsWith("InvalidMatrixException");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
