private static void runValidCase(UnivariateRealFunction f, double expectedRoot, double min, double max, double initial) {
        try {
            BisectionSolver withInitial = new BisectionSolver();
            double resultWithInitial = withInitial.solve(f, min, max, initial);

            BisectionSolver withoutInitial = new BisectionSolver();
            double resultWithoutInitial = withoutInitial.solve(f, min, max);

            double tol = Math.max(withInitial.getAbsoluteAccuracy(), withoutInitial.getAbsoluteAccuracy()) * 4.0 + 1e-12;

            // Contract/oracle: these overloads are documented sibling entry points for the same solve
            // operation on the same function and interval. A correct implementation must agree up to
            // solver accuracy; deleting the throw or skipping the real call path would break this.
            if (Math.abs(resultWithInitial - resultWithoutInitial) > tol) {
                throw new RuntimeException(
                    "[oracle:overload-agree] metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                        + " min=" + min
                        + " max=" + max
                        + " initial=" + initial
                        + " lhs=" + resultWithInitial
                        + " rhs=" + resultWithoutInitial
                );
            }

            // Contract/oracle from the input itself: we constructed the interval around a known zero of
            // the real library SinFunction, so a correct solver must return that same root within its
            // advertised absolute accuracy.
            if (Math.abs(resultWithInitial - expectedRoot) > tol) {
                throw new RuntimeException(
                    "[oracle:known-root] metamorphic violation: solver missed constructed SinFunction root"
                        + " expected=" + expectedRoot
                        + " min=" + min
                        + " max=" + max
                        + " initial=" + initial
                        + " result=" + resultWithInitial
                        + " tol=" + tol
                );
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isRootCauseNpeFromPatchedRegion(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }
    }
</xref>
