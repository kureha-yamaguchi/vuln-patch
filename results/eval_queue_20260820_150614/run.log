    private static boolean equalsIgnoreAsciiCase(String a, String b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (toAsciiLower(ca) != toAsciiLower(cb)) {
                return false;
            }
        }
        return true;
    }

    private static String asciiToggleCase(String s, boolean upper) {
        if (s == null) {
            return null;
        }
        char[] out = new char[s.length()];
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            out[i] = upper ? toAsciiUpper(c) : toAsciiLower(c);
        }
        return new String(out);
    }

    private static char toAsciiLower(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char) (c - 'A' + 'a');
        }
        return c;
    }

    private static char toAsciiUpper(char c) {
        if (c >= 'a' && c <= 'z') {
            return (char) (c - 'a' + 'A');
        }
        return c;
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '"') {
                sb.append('\\').append(c);
            } else if (c == '\n') {
                sb.append("\\n");
            } else if (c == '\r') {
                sb.append("\\r");
            } else if (c == '\t') {
                sb.append("\\t");
            } else if (c < 32 || c > 126) {
                String hex = Integer.toHexString(c);
                sb.append("\\u");
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            } else {
                sb.append(c);
            }
        }
        sb.append('"');
        return sb.toString();
    }
