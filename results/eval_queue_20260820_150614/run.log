            try {
                Class<?> c1 = ClassUtils.getClass(name, true);
                Class<?> c2 = ClassUtils.getClass(name, false);
                if (c1 != cls || c2 != cls || c1 != c2) {
                    throw new RuntimeException("[oracle:getclass-init-flag] metamorphic violation: name="
                            + name + " true=" + c1 + " false=" + c2 + " expected=" + cls);
