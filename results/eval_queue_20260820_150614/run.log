                try {
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    /* Contract/oracle:
                       Examples in BooleanUtilsTest show the parser is case-insensitive for recognized tokens
                       ("true"/"TRUE", "on"/"ON", "yes"/"YES"). For unrecognized inputs, changing ASCII case
                       still leaves them unrecognized, so both calls must agree. A throw-deleting or branch-skipping
                       patch that silently changes parsing behavior will violate this sibling-equivalence relation. */
                    if (result != upperResult) {
                        throw new RuntimeException("[oracle:case-agree] metamorphic violation: toBoolean should agree on ASCII case variants input=" + s + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException ignored) {
                    return;
                }
            } catch (RuntimeException t) {
                boolean cleanRejection = t instanceof IllegalArgumentException || t instanceof NumberFormatException;
                if (cleanRejection) {
                    return;
                }

                boolean isRoot = t instanceof StringIndexOutOfBoundsException;
                boolean inTarget = false;
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
