package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.lang.reflect.Constructor;

public class FuzzHarness {
    private static final Object REFLECTIVE_NULL_TOSTRING = loadNullToStringObject();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString;
        if (data.consumeBoolean()) {
            sepString = null;
        } else if (data.consumeBoolean()) {
            sepString = String.valueOf(sepChar);
        } else {
            sepString = data.consumeString(8);
        }

        int len = data.consumeInt(1, 5);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            int kind = data.consumeInt(0, 4);
            switch (kind) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(16);
                    break;
                case 2:
                    array[i] = Long.valueOf(data.consumeInt(-1000, 1000));
                    break;
                case 3:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                default:
                    array[i] = REFLECTIVE_NULL_TOSTRING != null ? REFLECTIVE_NULL_TOSTRING : data.consumeAsciiString(12);
                    break;
            }
        }

        int start = data.consumeInt(0, len - 1);
        int end = data.consumeBoolean() ? start + 1 : data.consumeInt(start, len);

        if (REFLECTIVE_NULL_TOSTRING != null) {
            int specialIndex = data.consumeInt(0, len - 1);
            array[specialIndex] = REFLECTIVE_NULL_TOSTRING;
            if (data.consumeBoolean()) {
                start = specialIndex;
                end = data.consumeBoolean() ? specialIndex + 1 : data.consumeInt(specialIndex + 1, len);
            }
        }

        exerciseJoinChar(array, sepChar, start, end);
        exerciseJoinString(array, sepString, start, end);

        if (start + 1 <= len) {
            Object[] single = new Object[] { array[start] };
            exerciseJoinChar(single, sepChar, 0, 1);
            exerciseJoinString(single, sepString, 0, 1);
        }

        if (data.consumeBoolean()) {
            StringUtils.join((Object[]) null, sepChar);
            StringUtils.join((Object[]) null, sepString);
        }
    }

    private static void runAnchorChecks() {
        StringUtils.join((Object[]) null, '/');
        StringUtils.join((Object[]) null, (String) null);

        if (REFLECTIVE_NULL_TOSTRING == null) {
            return;
        }

        Object[] singleton = new Object[] { REFLECTIVE_NULL_TOSTRING };
        String expected = StringUtils.defaultString(String.valueOf(REFLECTIVE_NULL_TOSTRING), "null");

        try {
            String actualChar = StringUtils.join(singleton, '/', 0, 1);
            if (!safeEquals(expected, actualChar)) {
                throw new RuntimeException("[oracle:anchor-single-char] metamorphic violation: single-item join output input=" + describe(singleton) + " lhs=" + actualChar + " rhs=" + expected);
            }
            if (StringUtils.length(actualChar) != actualChar.length()) {
                throw new RuntimeException("[oracle:anchor-length-char] consistency violation: reported=" + StringUtils.length(actualChar) + " independent=" + actualChar.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-single-char] metamorphic violation: single-item join should equal rendered element", t);
            }
        }

        try {
            String actualString = StringUtils.join(singleton, "/", 0, 1);
            if (!safeEquals(expected, actualString)) {
                throw new RuntimeException("[oracle:anchor-single-string] metamorphic violation: single-item join output input=" + describe(singleton) + " lhs=" + actualString + " rhs=" + expected);
            }
            if (StringUtils.length(actualString) != actualString.length()) {
                throw new RuntimeException("[oracle:anchor-length-string] consistency violation: reported=" + StringUtils.length(actualString) + " independent=" + actualString.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-single-string] metamorphic violation: single-item join should equal rendered element", t);
            }
        }
    }

    private static void exerciseJoinChar(Object[] array, char separator, int start, int end) {
        try {
            String joined = StringUtils.join(array, separator, start, end);
            if (joined != null && StringUtils.length(joined) != joined.length()) {
                throw new RuntimeException("[oracle:length-char-live] consistency violation: reported=" + StringUtils.length(joined) + " independent=" + joined.length());
            }

            /*
             * Contract used: join(Object[] array, char separator, int startIndex, int endIndex)
             * appends exactly the elements in the requested range, separated by the separator.
             * For a one-element valid range, the separator is never appended, so the result must
             * be exactly the rendering of that sole element. Using
             * defaultString(String.valueOf(element), "null") matches StringBuilder.append(Object):
             * normal objects render via toString(), and a broken toString() returning null renders
             * as the literal "null". A throw-deleting patch that skips the element or returns EMPTY
             * would violate this.
             */
            if (end == start + 1 && array != null && start >= 0 && start < array.length && array[start] != null) {
                String expected = StringUtils.defaultString(String.valueOf(array[start]), "null");
                if (!safeEquals(expected, joined)) {
                    throw new RuntimeException("[oracle:single-item-char] metamorphic violation: single-item range input=" + describe(array) + " start=" + start + " end=" + end + " lhs=" + joined + " rhs=" + expected);
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && validIndices(array, start, end)) {
                throw new RuntimeException("[oracle:single-item-char] metamorphic violation: valid join threw on a renderable single-item range", t);
            }
        }
    }

    private static void exerciseJoinString(Object[] array, String separator, int start, int end) {
        try {
            String joined = StringUtils.join(array, separator, start, end);
            if (joined != null && StringUtils.length(joined) != joined.length()) {
                throw new RuntimeException("[oracle:length-string-live] consistency violation: reported=" + StringUtils.length(joined) + " independent=" + joined.length());
            }

            /*
             * Same contract as above for the String-separator overload. For a valid one-element
             * range, the separator value (including null, which the API treats as EMPTY) is
