    private static void runDeterministicAnchorSearch() {
        for (int seed = 0; seed < 24; seed++) {
            int vars = 4 + (seed % 3);
            int[] witness = new int[vars];
            double[] dup = new double[vars];
            double[] objective = new double[vars];
            for (int i = 0; i < vars; i++) {
                witness[i] = 1 + ((seed + i) % 3);
                dup[i] = 1 + ((seed * 3 + i * 5) % 7);
                objective[i] = (i == 0) ? 1.0 : 0.0;
            }
            runScenario(vars, witness, dup, objective, 2 + (seed % 3), true);
        }
    }

    private static void runFuzzedSearch(FuzzedDataProvider data) {
        int scenarios = 1 + data.consumeInt(1, 8);
        for (int s = 0; s < scenarios; s++) {
            int vars = data.consumeInt(3, 6);
            int[] witness = new int[vars];
            double[] dup = new double[vars];
            double[] objective = new double[vars];

            boolean anyObjective = false;
            for (int i = 0; i < vars; i++) {
                witness[i] = data.consumeInt(1, 4);
                dup[i] = data.consumeInt(1, 8);
                objective[i] = data.consumeInt(-2, 2);
                anyObjective |= objective[i] != 0.0;
            }
            if (!anyObjective) {
                objective[0] = 1.0;
            }

            int duplicateCount = data.consumeInt(2, 5);
            boolean addExtraEq = data.consumeBoolean();
            runScenario(vars, witness, dup, objective, duplicateCount, addExtraEq);
        }
    }

    private static void runScenario(int vars, int[] witness, double[] duplicateRow, double[] objective,
                                    int duplicateCount, boolean addExtraEq) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double duplicateRhs = dot(duplicateRow, witness);

        for (int i = 0; i < duplicateCount; i++) {
            constraints.add(new LinearConstraint(duplicateRow.clone(), Relationship.GEQ, duplicateRhs));
        }

        for (int i = 0; i < vars; i++) {
            double[] unit = new double[vars];
            unit[i] = 1.0;
            constraints.add(new LinearConstraint(unit, Relationship.LEQ, witness[i] + 2.0));
        }

        if (addExtraEq) {
            for (int i = 0; i < vars - 1; i++) {
                double[] eq = new double[vars];
                eq[i] = 1.0;
                eq[i + 1] = 1.0;
                constraints.add(new LinearConstraint(eq, Relationship.EQ, witness[i] + witness[i + 1]));
            }
        } else {
            for (int i = 0; i < vars - 1; i++) {
                double[] geq = new double[vars];
                geq[i] = 1.0;
                geq[i + 1] = 1.0;
                constraints.add(new LinearConstraint(geq, Relationship.GEQ, witness[i] + witness[i + 1]));
            }
        }

        // Post-condition / metamorphic check:
        // Re-adding exact duplicate constraints preserves the feasible region and optimum for any correct solver.
        PointValuePair base = new SimplexSolver(1.0e-6, 10).optimize(f, constraints, GoalType.MINIMIZE, true);

        ArrayList<LinearConstraint> duplicatedAgain = new ArrayList<LinearConstraint>(constraints);
        duplicatedAgain.addAll(copyConstraints(constraints));
        PointValuePair withMoreDuplicates =
                new SimplexSolver(1.0e-6, 10).optimize(f, duplicatedAgain, GoalType.MINIMIZE, true);

        if (Math.abs(base.getValue() - withMoreDuplicates.getValue()) > 1.0e-7) {
            throw new RuntimeException("[oracle:duplicate-optimum] metamorphic violation: duplicate constraints changed optimum lhs="
                    + base.getValue() + " rhs=" + withMoreDuplicates.getValue());
        }
    }

    private static ArrayList<LinearConstraint> copyConstraints(List<LinearConstraint> constraints) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(constraints.size());
        for (LinearConstraint c : constraints) {
            out.add(new LinearConstraint(c.getCoefficients().toArray(), c.getRelationship(), c.getValue()));
        }
        return out;
    }

    private static double dot(double[] a, int[] b) {
        double v = 0.0;
        for (int i = 0; i < a.length && i < b.length; i++) {
            v += a[i] * b[i];
        }
        return v;
    }
}
