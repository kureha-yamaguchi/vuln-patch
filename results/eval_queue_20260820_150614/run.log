private static void testInput(String s, boolean assertKnownFalseWhenApplicable) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            /* Contract asserted:
             * The public API examples/tests for BooleanUtils.toBoolean(String) specify that
             * invalid 3-char tokens such as "off", "oof", and "yep" return false.
             * A throw-deleting or branch-skipping patch that merely avoids the crash but returns
             * the wrong value would violate this observable result, so we assert false for
             * fuzz-generated inputs built to have the same valid shape.
             */
            if (assertKnownFalseWhenApplicable && s != null && s.length() == 3
                    && s.charAt(0) != 'y' && s.charAt(0) != 'Y'
                    && !equalsIgnoreAsciiCase(s, "yes")
                    && !equalsIgnoreAsciiCase(s, "on")
                    && !equalsIgnoreAsciiCase(s, "true")) {
                if (result) {
                    throw new RuntimeException("[oracle:false-3char] metamorphic violation: documented non-true token of length 3 should parse as false input=" + repr(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && s != null && s.length() == 3) {
                throw t;
            }
        }
    }
