                if (!Precision.equals(pivot, 1.0, 10)) {
                    throw new RuntimeException("[oracle:basic-row-entry] metamorphic violation: basic row does not contain 1 entry col=" + c + " row=" + basic + " val=" + pivot);
                }
            }
        }

        // For artificial-variable columns specifically, getBasicRow and getEntry must agree.
        for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
            int col = tableau.getArtificialVariableOffset() + i;
            if (col >= 0 && col < width - 1) {
                Integer basic = tableau.getBasicRow(col);
                if (basic != null) {
                    double entry = tableau.getEntry(basic.intValue(), col);
                    if (!Precision.equals(entry, 1.0, 10)) {
                        throw new RuntimeException("[oracle:art-basic-agree] metamorphic violation: artificial column basicRow disagrees with entry col=" + col + " row=" + basic + " val=" + entry);
                    }
                }
            }
        }
    }

    private static void checkFreshConstructionDeterminism(LinearObjectiveFunction f, Collection<LinearConstraint> constraints,
                                                          GoalType goal, boolean nonNegative, double epsilon,
                                                          int maxUlps, SimplexTableau first) {
