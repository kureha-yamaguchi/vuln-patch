public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            BooleanUtils.toBoolean("off");
        } catch (RuntimeException t) {
            boolean inTarget = false;
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                        && "toBoolean".equals(ste.getMethodName())) {
                    inTarget = true;
                    break;
                }
            }
            if (t instanceof StringIndexOutOfBoundsException && inTarget) {
                throw t;
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
        }

        int iterations = data.consumeInt(1, 8);
        for (int i = 0; i < iterations; i++) {
            String s;
            int strategy = data.consumeInt(0, 5);
            if (strategy == 0) {
                String[] literals = new String[] {
                    "off", "oof", "yep", "tru", "abc", "no!", "000", "___", "tfx", "ofF", "On!"
                };
                s = literals[data.consumeInt(0, literals.length - 1)];
            } else if (strategy == 1) {
                char[] chars = new char[3];
                for (int j = 0; j < 3; j++) {
                    chars[j] = (char) data.consumeByte();
                }
                s = new String(chars);
            } else if (strategy == 2) {
                String raw = data.consumeAsciiString(16);
                while (raw.length() < 3) {
                    raw = raw + "off";
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else if (strategy == 3) {
                String raw = data.consumeString(16);
                while (raw.length() < 3) {
                    raw = raw + "xyz";
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else if (strategy == 4) {
                String raw = data.consumeRemainingAsString();
                if (raw.length() == 0) {
                    raw = "off";
                }
                while (raw.length() < 3) {
                    raw = raw + "x";
                }
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else {
                byte[] bytes = data.consumeBytes(3);
                char[] chars = new char[3];
                for (int j = 0; j < 3; j++) {
                    chars[j] = (char) (j < bytes.length ? bytes[j] : ('a' + j));
                }
                s = new String(chars);
            }

            if (s.length() != 3) {
                continue;
            }

            boolean validForCrashCheck = true;

            try {
                boolean result = BooleanUtils.toBoolean(s);

                /*
                 * Contract/oracle: BooleanUtils.toBoolean(String) is a case-insensitive parser
                 * for the recognized true tokens ("true", "on", "yes"); other strings return false.
                 * Therefore changing only case must not change the result.
                 * A throw-deleting or branch-skipping patch that returns the wrong boolean for
                 * 3-char inputs would violate this observable relation.
                 */
                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                                "[oracle:casefold] metamorphic violation: case-insensitive agreement input="
                                        + String.valueOf(s) + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException relationEx) {
                    String msg = relationEx.getMessage();
                    if (msg != null && msg.startsWith("[oracle:casefold]")) {
                        throw relationEx;
                    }
                }

                try {
                    String lower = s.toLowerCase();
                    boolean lowerResult = BooleanUtils.toBoolean(lower);
                    if (result != lowerResult) {
                        throw new RuntimeException(
                                "[oracle:lowerfold] metamorphic violation: case-insensitive agreement input="
                                        + String.valueOf(s) + " lhs=" + result + " rhs=" + lowerResult);
                    }
                } catch (RuntimeException relationEx) {
                    String msg = relationEx.getMessage();
                    if (msg != null && msg.startsWith("[oracle:lowerfold]")) {
                        throw relationEx;
                    }
                }

                if (s.charAt(0) != 'y' && s.charAt(0) != 'Y'
                        && !"on".equalsIgnoreCase(s)
                        && !"yes".equalsIgnoreCase(s)
                        && !"true".equalsIgnoreCase(s)) {
                    if (result) {
                        throw new RuntimeException(
                                "[oracle:false-3char] metamorphic violation: documented non-true 3-char token must parse as false input="
                                        + String.valueOf(s) + " lhs=" + result + " rhs=false");
                    }
                }
            } catch (RuntimeException t) {
                String msg = t.getMessage();
                if (msg != null && msg.startsWith("[oracle:")) {
                    throw t;
                }

                boolean inTarget = false;
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                            && "toBoolean".equals(ste.getMethodName())) {
                        inTarget = true;
                        break;
                    }
                }

                if (t instanceof StringIndexOutOfBoundsException && inTarget && validForCrashCheck) {
                    throw t;
                }
                if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                    return;
                }
