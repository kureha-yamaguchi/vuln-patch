package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchorDeleteByRange();
        } catch (RuntimeException t) {
            if (isOracle(t) || isRootCause(t)) {
                throw t;
            }
        }

        try {
            exploreDeletedSuffixState(data);
        } catch (RuntimeException t) {
            if (isOracle(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorDeleteByRange() {
        String needle = "three";
        String prefix = "onetwo";
        StrBuilder sb = new StrBuilder(prefix + needle);
        sb.delete(prefix.length(), prefix.length() + needle.length());
        checkIndexConsistency(sb, needle, 0, "anchor-delrange");
        checkBoundaryStarts(sb, needle, prefix.length(), "anchor-boundary");
    }

    private static void exploreDeletedSuffixState(FuzzedDataProvider data) {
        String needle = data.consumeString(24);
        if (needle.length() == 0) {
            needle = "X";
        }

        String prefix = data.consumeString(24);
        if (prefix.length() == 0) {
            prefix = "P";
        }

        int extraCapacity = data.consumeInt(0, 32);
        int mode = data.consumeInt(0, 2);

        StrBuilder sb = new StrBuilder();
        sb.append(prefix);
        sb.ensureCapacity(prefix.length() + needle.length() + extraCapacity + 1);
        sb.append(needle);

        int deleteStart = prefix.length();
        int deleteEnd = deleteStart + needle.length();

        if (mode == 0) {
            sb.delete(deleteStart, deleteEnd);
        } else if (mode == 1) {
            sb.replace(deleteStart, deleteEnd, "");
        } else {
            sb.deleteCharAt(deleteStart);
            if (needle.length() > 1) {
                sb.delete(deleteStart, deleteStart + needle.length() - 1);
            }
        }

        int start = data.consumeInt(0, sb.length());
        checkIndexConsistency(sb, needle, start, "fuzz-delstate");

        int pivot = prefix.length();
        checkBoundaryStarts(sb, needle, pivot, "fuzz-boundary");

        int expectedLen = sb.toString().length();
        int charArrayLen = sb.toCharArray().length;
        if (expectedLen != charArrayLen) {
            throw new RuntimeException("[oracle:chararray-len] metamorphic violation: toCharArray length must equal current content length input="
                    + preview(prefix, needle) + " expected=" + expectedLen + " actual=" + charArrayLen);
        }

        try {
            sb.minimizeCapacity();
            checkIndexConsistency(sb, needle, start, "post-mincap");
        } catch (RuntimeException t) {
            if (isOracle(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkBoundaryStarts(StrBuilder sb, String needle, int pivot, String id) {
        int[] starts = new int[] {
                0,
                Math.max(0, pivot - 1),
                Math.max(0, pivot),
                Math.min(sb.length(), pivot + 1),
                sb.length()
        };
        for (int i = 0; i < starts.length; i++) {
            checkIndexConsistency(sb, needle, starts[i], id + "-" + i);
        }
    }

    private static void checkIndexConsistency(StrBuilder sb, String needle, int start, String id) {
        try {
            int normalizedStart = start < 0 ? 0 : start;
            String materialized = sb.toString();

            int reported = sb.indexOf(needle, start);
            int independent = materialized.indexOf(needle, normalizedStart);

            /* Contract/oracle:
             * StrBuilder.indexOf(String, int) is documented and tested to behave like String#indexOf.
             * We recompute the same quantity from the object's own output string, so any disagreement is
             * a sound consistency violation even if a patch merely suppresses an exception.
             */
            if (reported != independent) {
                throw new RuntimeException("[oracle:index-string-agree] metamorphic violation: StrBuilder.indexOf must agree with String.indexOf"
                        + " input=" + preview(materialized, needle)
                        + " start=" + start
                        + " lhs=" + reported
                        + " rhs=" + independent);
            }

            if (reported >= 0) {
                if (reported + needle.length() > sb.length()) {
                    throw new RuntimeException("[oracle:index-bounds] metamorphic violation: reported match exceeds builder length"
                            + " input=" + preview(materialized, needle)
                            + " start=" + start
                            + " idx=" + reported
                            + " len=" + sb.length()
                            + " needleLen=" + needle.length());
                }
                for (int i = 0; i < needle.length(); i++) {
                    char a = sb.charAt(reported + i);
                    char b = needle.charAt(i);
                    if (a != b) {
                        throw new RuntimeException("[oracle:index-substring] metamorphic violation: reported index does not point to the searched string"
                                + " input=" + preview(materialized, needle)
                                + " start=" + start
                                + " idx=" + reported
                                + " mismatchAt=" + i
                                + " actual=" + (int) a
                                + " expected=" + (int) b);
                    }
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException t) {
            if (isOracle(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(ste.getClassName())
                    && "indexOf".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static String preview(String a, String b) {
        return "{text=" + clip(a) + ", needle=" + clip(b) + "}";
    }

    private static String clip(String s) {
        if (s == null) {
            return "null";
        }
        if (s.length() <= 40) {
            return s;
        }
        return s.substring(0, 40) + "...";
    }
}
