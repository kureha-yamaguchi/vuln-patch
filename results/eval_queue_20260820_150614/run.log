package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.euclidean.twod.Vector2D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchorAndExplore(data);
        checkDefensiveCopyOracle(data);
    }

    private static void exerciseAnchorAndExplore(FuzzedDataProvider data) {
        try {
            PolygonsSet anchor = new PolygonsSet(makeBoundaryAttributeLeaf());
            anchor.getVertices();
            anchor.getSize();
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isKnownRootCause(t)) {
                return;
            }
        }

        int iters = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < iters; i++) {
            try {
                BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D> leaf = makeBoundaryAttributeLeaf();
                if (data.consumeBoolean()) {
                    leaf.setAttribute(new BoundaryAttribute<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>(null, null, null));
                }
                PolygonsSet s = new PolygonsSet(leaf);
                if (data.consumeBoolean()) {
                    s.getVertices();
                }
                if (data.consumeBoolean()) {
                    s.getBarycenter();
                } else {
                    s.getSize();
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isKnownRootCause(t)) {
                    continue;
                }
            }
        }
    }

    private static void checkDefensiveCopyOracle(FuzzedDataProvider data) {
        double x1 = orderedCoord(data);
        double x2 = orderedCoord(data);
        double y1 = orderedCoord(data);
        double y2 = orderedCoord(data);

        if (x1 == x2) {
            x2 = x1 + 1.0;
        }
        if (y1 == y2) {
            y2 = y1 + 1.0;
        }

        double minX = Math.min(x1, x2);
        double maxX = Math.max(x1, x2);
        double minY = Math.min(y1, y2);
        double maxY = Math.max(y1, y2);

        try {
            PolygonsSet a = new PolygonsSet(minX, maxX, minY, maxY);
            PolygonsSet b = new PolygonsSet(minX, maxX, minY, maxY);

            Vector2D[][] first = a.getVertices();
            Vector2D[][] baseline = b.getVertices();
            if (first.length == 0 || baseline.length == 0) {
                return;
            }

            Vector2D[][] snapshot = a.getVertices();

            first[0] = null;
            if (first.length > 1) {
                first[first.length - 1] = null;
            }

            Vector2D[][] after = a.getVertices();

            if (!sameVertices(snapshot, baseline) || !sameVertices(after, baseline)) {
                throw new RuntimeException(
                    "[oracle:defcopy] metamorphic violation: getVertices must return a defensive top-level copy; " +
                    "input=[" + minX + "," + maxX + "," + minY + "," + maxY + "] " +
                    "snapshot=" + verticesToString(snapshot) +
                    " baseline=" + verticesToString(baseline) +
                    " after=" + verticesToString(after)
                );
            }

            double sizeA = a.getSize();
            double sizeB = b.getSize();
            if (Double.isFinite(sizeA) && Double.isFinite(sizeB) && Math.abs(sizeA - sizeB) > 1e-9) {
                throw new RuntimeException(
                    "[oracle:defcopy-size] metamorphic violation: equivalent rectangles must keep equal size after mutating returned getVertices array; " +
                    "input=[" + minX + "," + maxX + "," + minY + "," + maxY + "] lhs=" + sizeA + " rhs=" + sizeB
                );
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw (RuntimeException) t;
            }
        }
    }

    private static double orderedCoord(FuzzedDataProvider data) {
        return data.consumeInt(-1000, 1000);
    }

    private static BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D> makeBoundaryAttributeLeaf() {
        return new BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>(
            new BoundaryAttribute<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>(null, null, null)
        );
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("MathIllegal") || n.contains("Invalid") || n.contains("NoData");
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String c = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(c)
                    && ("computeGeometricalProperties".equals(m)
                        || "getVertices".equals(m)
                        || "getTree".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameVertices(Vector2D[][] a, Vector2D[][] b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            Vector2D[] ai = a[i];
            Vector2D[] bi = b[i];
            if (ai == bi) {
                continue;
            }
            if (ai == null || bi == null || ai.length != bi.length) {
                return false;
            }
            for (int j = 0; j < ai.length; j++) {
                Vector2D av = ai[j];
                Vector2D bv = bi[j];
                if (av == bv) {
                    continue;
                }
                if (av == null || bv == null) {
                    return false;
                }
                if (Double.doubleToLongBits(av.getX()) != Double.doubleToLongBits(bv.getX())
                        || Double.doubleToLongBits(av.getY()) != Double.doubleToLongBits(bv.getY())) {
                    return false;
                }
            }
        }
        return true;
    }

    private static String verticesToString(Vector2D[][] v) {
        if (v == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < v.length; i++) {
            if (i > 0) {
                sb.append(';');
            }
            Vector2D[] row = v[i];
            if (row == null) {
                sb.append("null");
                continue;
            }
            sb.append('(');
            for (int j = 0; j < row.length; j++) {
                if (j > 0) {
                    sb.append(',');
                }
                Vector2D p = row[j];
                if (p == null) {
                    sb.append("null");
                } else {
                    sb.append(p.getX()).append('/').append(p.getY());
                }
            }
            sb.append(')');
        }
        sb.append(']');
        return sb.toString();
    }
}
