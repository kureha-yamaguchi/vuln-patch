        3.460193945992071E-18,
        1.3883326374011525E-17,
        5.233894983671116E-17,
        1.8630791465263745E-16,
        6.288759227922111E-16,
        2.0204433920597856E-15,
        6.198768938576155E-15,
        1.821419346860626E-14,
        5.139176445538471E-14,
        1.3956427429045787E-13,
        3.655705706448139E-13,
        9.253753324779779E-13,
        2.267636001476696E-12,
        5.3880460095836855E-12,
        1.2431632654852931E-11
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int mode = data.consumeInt(0, 2);
        if (mode == 0) {
            runExplorePartialFlank(data);
        } else if (mode == 1) {
            runExploreFullGaussian(data);
        } else {
            runExploreShiftedAndScaled(data);
        }
    }

    private static void runAnchor() {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ANCHOR_DATA.length; i++) {
            fitter.addObservedPoint(i, ANCHOR_DATA[i]);
        }
        runChecksOnValidFitter(fitter, true);
    }

    private static void runExplorePartialFlank(FuzzedDataProvider data) {
        int n = data.consumeInt(5, 40);
        double norm = positive(data.consumeInt(-3, 6), data.consumeInt(1, 999));
        double mean = data.consumeInt(-50, 50);
        double sigma = data.consumeInt(1, 200) / 20.0;
        double step = data.consumeInt(1, 40) / 20.0;
        boolean leftFlank = data.consumeBoolean();

        double far = sigma * (2.0 + data.consumeInt(0, 5));
        if (far <= (n + 1) * step) {
            far = (n + 2) * step + sigma;
        }

        Gaussian g = new Gaussian(norm, mean, sigma);
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < n; i++) {
            double x;
            if (leftFlank) {
                x = mean - far + i * step;
                if (x >= mean) {
                    x = mean - 0.1 - (n - i) * step;
                }
            } else {
                x = mean + far - i * step;
                if (x <= mean) {
                    x = mean + 0.1 + (n - i) * step;
                }
            }
            double y = g.value(x);
            fitter.addObservedPoint(x, y);
        }
        runChecksOnValidFitter(fitter, true);
    }

    private static void runExploreFullGaussian(FuzzedDataProvider data) {
        int n = data.consumeInt(5, 35);
        double norm = positive(data.consumeInt(-4, 5), data.consumeInt(1, 999));
        double mean = data.consumeInt(-30, 30);
        double sigma = data.consumeInt(1, 150) / 15.0;
        double step = Math.max(0.1, sigma / Math.max(2, data.consumeInt(2, 8)));
        double start = mean - (n / 2.0) * step;

        Gaussian g = new Gaussian(norm, mean, sigma);
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < n; i++) {
            double x = start + i * step;
            fitter.addObservedPoint(x, g.value(x));
        }
        runChecksOnValidFitter(fitter, true);
    }

    private static void runExploreShiftedAndScaled(FuzzedDataProvider data) {
        int n = data.consumeInt(6, 30);
        double norm = positive(data.consumeInt(-2, 6), data.consumeInt(1, 999));
        double mean = data.consumeInt(-80, 80) / 2.0;
        double sigma = data.consumeInt(2, 120) / 12.0;
        double step = data.consumeInt(1, 30) / 10.0;
        double offset = data.consumeInt(-20, 20);

        Gaussian g = new Gaussian(norm, mean, sigma);
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < n; i++) {
            double x = offset + i * step;
            double y = g.value(x);
            if (y < 0.0 || Double.isNaN(y) || Double.isInfinite(y)) {
                return;
            }
            fitter.addObservedPoint(x, y);
        }
        runChecksOnValidFitter(fitter, true);
    }

    private static void runChecksOnValidFitter(GaussianFitter fitter, boolean validByConstruction) {
        WeightedObservedPoint[] observations = fitter.getObservations();

        try {
            double[] guessed = new GaussianFitter.ParameterGuesser(observations).guess();
            GaussianFitter sameProblemViaGuess = rebuild(observations);
            try {
                sameProblemViaGuess.fit(guessed);
            } catch (Throwable t) {
                handleThrowable(t, validByConstruction);
            }
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
        }

        GaussianFitter first = rebuild(observations);
        GaussianFitter second = rebuild(observations);

        double[] p1;
        try {
            p1 = first.fit();
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
            return;
        }

        double[] p2;
        try {
            p2 = second.fit();
        } catch (Throwable t) {
            return;
        }

        if (p1 == null || p2 == null || p1.length != p2.length) {
            return;
        }

        /*
         * Contract/oracle:
         * CurveFitter.getObservations() returns all recorded observations, and fitting a freshly
         * reconstructed GaussianFitter with the same optimizer and the same observations defines
         * the same least-squares problem. A correct deterministic implementation must therefore
         * produce the same fitted parameters on both independently constructed objects.
         * A throw-deleting or masking patch can let one path continue with corrupted state or
         * wrong bookkeeping; this rebuild-consistency check still catches that wrong output.
         */
        for (int i = 0; i < p1.length; i++) {
            if (!approximatelyEqual(p1[i], p2[i])) {
                throw new RuntimeException(
                    "[oracle:rebuild-consistency] metamorphic violation: identical rebuilt fitters disagree"
                        + " index=" + i
                        + " lhs=" + p1[i]
                        + " rhs=" + p2[i]
                        + " nObs=" + observations.length);
            }
        }
    }

    private static GaussianFitter rebuild(WeightedObservedPoint[] observations) {
        GaussianFitter rebuilt = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < observations.length; i++) {
            WeightedObservedPoint p = observations[i];
            rebuilt.addObservedPoint(p.getWeight(), p.getX(), p.getY());
        }
        return rebuilt;
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                throw (RuntimeException) t;
            }
        }

        if (validByConstruction && isRootCause(t)) {
            sneakyThrow(t);
        }

        if (isCleanRejection(t)) {
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (t == null) {
            return false;
        }
        if (!"org.apache.commons.math.exception.NotStrictlyPositiveException".equals(t.getClass().getName())) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if (("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls) && "fit".equals(method))
                || ("org.apache.commons.math.optimization.fitting.CurveFitter".equals(cls)
                    && ("fit".equals(method) || "getObservations".equals(method)))
                || ("org.apache.commons.math.optimization.fitting.GaussianFitter$ParameterGuesser".equals(cls)
                    && "guess".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        Package p = t.getClass().getPackage();
        String pkg = p == null ? "" : p.getName();
        return pkg.startsWith("org.apache.commons.math.exception");
    }

    private static boolean approximatelyEqual(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b) || Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-6 * scale;
    }

    private static double positive(int exp10, int mantissa) {
        double value = mantissa / 100.0;
        return value * Math.pow(10.0, exp10);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
