package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("1234.5", true);

        int whole = data.consumeInt(-1_000_000, 1_000_000);
        String frac;
        switch (data.consumeInt(0, 3)) {
            case 0:
                frac = "0";
                break;
            case 1:
                frac = "5";
                break;
            case 2:
                frac = "25";
                break;
            default:
                frac = "125";
                break;
        }

        String validDecimal = Integer.toString(whole) + "." + frac;
        exercise(validDecimal, true);

        /*
         * Contract visible in NumberUtils.createNumber itself:
         * when the caller has "no preference on the return type", it will
         * "start small and go from there". For a small exact decimal like x.5,
         * x.25, x.125, the unsuffixed form and the explicit Float-suffixed form
         * should therefore agree, and createFloat provides an independent real
         * library computation of the same quantity. A throw-deleting or
         * branch-skipping patch could avoid the crash but return a wrong type or
         * wrong value; this relation catches that.
         */
        try {
            Number plain = NumberUtils.createNumber(validDecimal);
            Number suffixed = NumberUtils.createNumber(validDecimal + "F");
            Float viaFloat = NumberUtils.createFloat(validDecimal);
            if (plain != null && suffixed != null && viaFloat != null) {
                if (!(plain instanceof Float) || !(suffixed instanceof Float)) {
                    throw new RuntimeException(
                        "[oracle:smallest-float] metamorphic violation: expected Float results input="
                            + validDecimal + " plainType=" + plain.getClass().getName()
                            + " suffixedType=" + suffixed.getClass().getName());
                }
                String a = plain.toString();
                String b = suffixed.toString();
                String c = viaFloat.toString();
                if (!a.equals(b) || !a.equals(c)) {
                    throw new RuntimeException(
                        "[oracle:smallest-float] metamorphic violation: equivalent decimal parses disagree input="
                            + validDecimal + " plain=" + a + " suffixed=" + b + " createFloat=" + c);
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidConstructedExactDecimal(validDecimal)) {
                throw t;
            }
        }

        String digits = data.consumeAsciiString(12);
        if (digits.length() == 0) {
            digits = "1";
        }
        digits = onlyDigitsOrFallback(digits);
        String maybeTrailingExponent = (data.consumeBoolean() ? "-" : "") + digits + (data.consumeBoolean() ? "e" : "E");
        exercise(maybeTrailingExponent, false);

        String maybeExponentAndSuffix =
            (data.consumeBoolean() ? "-" : "") + digits + (data.consumeBoolean() ? "e" : "E")
                + (data.consumeBoolean() ? "F" : "D");
        exercise(maybeExponentAndSuffix, false);
    }

    private static void exercise(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(RuntimeException t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException)
                && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(method) || "charAt".equals(method))) {
                for (int j = i + 1; j < st.length; j++) {
                    if ("org.apache.commons.lang3.math.NumberUtils".equals(st[j].getClassName())
                            && "createNumber".equals(st[j].getMethodName())) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private static boolean isValidConstructedExactDecimal(String s) {
        if (s == null || s.length() < 3) {
            return false;
        }
        int dot = s.indexOf('.');
        if (dot <= 0 || dot != s.lastIndexOf('.')) {
            return false;
        }
        if (s.indexOf('e') >= 0 || s.indexOf('E') >= 0) {
            return false;
        }
        String frac = s.substring(dot + 1);
        return "0".equals(frac) || "5".equals(frac) || "25".equals(frac) || "125".equals(frac);
    }

    private static String onlyDigitsOrFallback(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length() && out.length() < 8; i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            return "1";
        }
        return out.toString();
    }
}
