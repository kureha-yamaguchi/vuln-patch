    private static int checkedLegendCount(LegendItemCollection items) {
        if (items == null) {
            return 0;
        }
        int reported = items.getItemCount();
        int recomputed = 0;
        for (int i = 0; i < reported; i++) {
            if (items.get(i) == null) {
                throw new RuntimeException("[oracle:legend-null-item] null legend item at index=" + i + " reportedCount=" + reported);
            }
            recomputed++;
        }
        if (reported != recomputed) {
            throw new RuntimeException("[oracle:legend-count] consistency violation: reported=" + reported + " recomputed=" + recomputed);
        }
        return reported;
    }

    private static boolean isOracleViolation(Throwable t) {
        return (t instanceof RuntimeException)
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if (("org.jfree.chart.plot.CategoryPlot".equals(cls) || "org.jfree.chart.plot.XYPlot".equals(cls))
                    && ("removeDomainMarker".equals(method) || "removeRangeMarker".equals(method))) {
                return true;
            }
            if ("org.jfree.chart.plot.CategoryPlot".equals(cls) && "fireChangeEvent".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.plot.XYPlot".equals(cls) && "fireChangeEvent".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.LegendItemCollection".equals(cls) && "get".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.renderer.AbstractRenderer".equals(cls) && "fireChangeEvent".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String nonEmpty(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static double boundedDouble(int raw) {
        return raw / 1024.0;
    }
