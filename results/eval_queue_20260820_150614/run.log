            String expected = "\nDo more stuff\neven more stuff\n";
            if (!expected.equals(actual)) {
                throw new RuntimeException("[oracle:anchor-deleteAll] deleteAll result mismatch expected=" + quote(expected) + " actual=" + quote(actual));
            }

            checkLengthConsistency(sb, "anchor-deleteAll");
            checkFreshBuilderIndexAgreement(sb, "\n%BLAH%", 0, "anchor-deleteAll");
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
