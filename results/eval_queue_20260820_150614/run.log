                boolean result = BooleanUtils.toBoolean(s);

                if (s.length() == 3 && s.charAt(0) != 'y' && s.charAt(0) != 'Y') {
                    if (result) {
                        throw new RuntimeException("[oracle:len3-false] metamorphic violation: non-yes 3-char input should not parse as true input=" + s + " lhs=" + result + " rhs=false");
                    }
