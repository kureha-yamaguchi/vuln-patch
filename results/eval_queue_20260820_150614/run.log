            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        try {
            dist.cumulativeProbability(x);
            double after = dist.getMean();
            if (Double.doubleToLongBits(before) != Double.doubleToLongBits(after)) {
                throw new RuntimeException(
                    "[oracle:cdf-mean-stable] metamorphic violation: cumulativeProbability(x) must not change getMean() x="
                        + x + " before=" + before + " after=" + after);
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        try {
            dist.sample();
            double after = dist.getMean();
            if (Double.doubleToLongBits(before) != Double.doubleToLongBits(after)) {
                throw new RuntimeException(
                    "[oracle:sample-mean-stable] metamorphic violation: sample() must not change getMean() before="
                        + before + " after=" + after);
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            // If sampling fails for unrelated reasons, skip the oracle.
        }
    }

    private static boolean isCleanArgumentRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.indexOf("NotStrictlyPositive") >= 0
            || name.indexOf(".exception.") >= 0
            || name.indexOf("MathRuntimeException") >= 0;
    }

    private static boolean isRootCauseFromPatchedRegion(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(cls)
                && "<init>".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                && "createIllegalArgumentException".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static double makeNonPositive(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 3);
        if (mode == 0) {
            return 0.0;
        }
        int raw = data.consumeInt(1, 1000000);
        double base = raw / 1000.0;
        if (mode == 1) {
            return -base;
        }
        if (mode == 2) {
            return -(base + 1.0e-9);
        }
        return -((data.consumeInt(1, 1000) * 1.0) / (data.consumeInt(1, 1000)));
    }

    private static double makePositive(FuzzedDataProvider data) {
        int numerator = data.consumeInt(1, 1000000);
        int denominator = data.consumeInt(1, 1000);
        return (numerator / (double) denominator) + 1.0e-9;
    }

    private static double makeModerateDouble(FuzzedDataProvider data, boolean allowNegative) {
        int whole = data.consumeInt(0, 1000000);
        int frac = data.consumeInt(0, 999999);
        double v = whole + (frac / 1000000.0);
        if (allowNegative && data.consumeBoolean()) {
            v = -v;
        }
        return v;
    }
}
