                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                                "[oracle:casefold] metamorphic violation: case-insensitive agreement input="
                                        + s + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException relationEx) {
                    if (relationEx.getMessage() != null
