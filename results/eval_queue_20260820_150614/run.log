package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchorSeed();

        if (data == null) {
            return;
        }

        runRetargetedStoredSolveCase(data);
        runSinRetargetedBracketCase(data);
    }

    private static void runAnchorSeed() {
        UnivariateRealFunction f = new SinFunction();
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, 3.0, 3.2, 3.1);
            BisectionSolver fresh = new BisectionSolver();
            double baseline = fresh.solve(f, 3.0, 3.2);
            double tol = Math.max(solver.getAbsoluteAccuracy(), fresh.getAbsoluteAccuracy()) * 4.0 + 1.0e-12;
            if (Math.abs(result - baseline) > tol) {
                throw new RuntimeException(
                        "[oracle:anchor-agreement] metamorphic violation: exact test seed disagreed with sibling solve(f,min,max)"
                                + " result=" + result
                                + " baseline=" + baseline
                                + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:anchor-seed] metamorphic violation: exact failing-test seed threw NullPointerException on valid input",
                        t);
            }
        }
    }

    private static void runRetargetedStoredSolveCase(FuzzedDataProvider data) {
        double root1 = boundedRoot(data.consumeInt());
        double delta = 0.5 + boundedPositive(data.consumeInt());
        double root2 = root1 + delta;
        if (Math.abs(root2 - root1) < 0.25) {
            root2 = root1 + 0.75;
        }

        PolynomialFunction f1 = linearRoot(root1);
        PolynomialFunction f2 = linearRoot(root2);

        double min1 = root1 - 1.0;
        double max1 = root1 + 1.0;
        double min2 = root2 - 1.0;
        double max2 = root2 + 1.0;

        double initial1 = clamp(root1 + scaledUnit(data.consumeInt()) * 0.8, min1, max1);
        double initial2 = clamp(root2 + scaledUnit(data.consumeInt()) * 0.8, min2, max2);

        BisectionSolver solver = new BisectionSolver();

        try {
            solver.solve(f1, min1, max1, initial1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:retarget-prime] metamorphic violation: valid first solve(f,min,max,initial) threw NullPointerException"
                                + " root1=" + root1
                                + " min1=" + min1
                                + " max1=" + max1
                                + " initial1=" + initial1,
                        t);
            }
            return;
        }

        final double second;
        try {
            second = solver.solve(f2, min2, max2, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:retarget-second] metamorphic violation: valid second solve(f,min,max,initial) threw NullPointerException"
                                + " root2=" + root2
                                + " min2=" + min2
                                + " max2=" + max2
                                + " initial2=" + initial2,
                        t);
            }
            return;
        }

        final double reused;
        try {
            reused = solver.solve(min2, max2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:retargeted-stored-solve] metamorphic violation: after a successful retargeting solve(f,min,max,initial), solve(min,max) threw from the same region"
                                + " root1=" + root1
                                + " root2=" + root2
                                + " min2=" + min2
                                + " max2=" + max2
                                + " initial2=" + initial2
                                + " second=" + second,
                        t);
            }
            return;
        }

        final double fresh;
        try {
            BisectionSolver freshSolver = new BisectionSolver();
            fresh = freshSolver.solve(f2, min2, max2);
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract used here:
         * The overloads that accept f and the overload solve(min,max) are sibling public entry points
         * for the same stored function on the receiver. After a successful second solve that supplies f2,
         * a correct implementation must have the receiver's subsequent solve(min2,max2) operate on that
         * current function as well, not a null/stale one.
         */
        double tol = Math.max(new BisectionSolver().getAbsoluteAccuracy(), 1.0e-12) * 6.0 + 1.0e-12;
        if (Math.abs(reused - fresh) > tol) {
            throw new RuntimeException(
                    "[oracle:retargeted-function] metamorphic violation: receiver solve(min,max) after retargeting disagreed with fresh solve on the second real function"
                            + " root1=" + root1
                            + " root2=" + root2
                            + " min2=" + min2
                            + " max2=" + max2
                            + " initial2=" + initial2
                            + " second=" + second
                            + " reused=" + reused
                            + " fresh=" + fresh
                            + " tol=" + tol);
        }

        /*
         * Independent consistency check:
         * For a successful solve(min,max), the returned value and the receiver's cached getResult()
         * are two exposed views of the same solution and must agree.
         */
        try {
            double cached = solver.getResult();
            if (Math.abs(cached - reused) > tol) {
                throw new RuntimeException(
                        "[oracle:retargeted-cached] consistency violation: cached getResult() disagreed with returned solve(min,max)"
                                + " reused=" + reused
                                + " cached=" + cached
                                + " tol=" + tol);
            }
        } catch (IllegalStateException e) {
            return;
        }
    }

    private static void runSinRetargetedBracketCase(FuzzedDataProvider data) {
        UnivariateRealFunction sin = new SinFunction();

        int k1 = data.consumeInt(-50, 50);
        int step = data.consumeInt(1, 5);
        int k2 = k1 + step;

        double root1 = k1 * Math.PI;
        double root2 = k2 * Math.PI;

        double width1 = 0.2 + data.consumeInt(0, 400) / 1000.0;
        double width2 = 0.2 + data.consumeInt(0, 400) / 1000.0;

        double min1 = root1 - width1;
        double max1 = root1 + width1;
        double min2 = root2 - width2;
        double max2 = root2 + width2;

        double initial1 = clamp(root1 + scaledUnit(data.consumeInt()) * width1 * 0.9, min1, max1);
        double initial2 = clamp(root2 + scaledUnit(data.consumeInt()) * width2 * 0.9, min2, max2);

        BisectionSolver solver = new BisectionSolver();

        try {
            solver.solve(sin, min1, max1, initial1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:sin-prime] metamorphic violation: valid SinFunction prime solve threw NullPointerException"
                                + " min1=" + min1
                                + " max1=" + max1
                                + " initial1=" + initial1,
                        t);
            }
            return;
        }

        final double second;
        try {
            second = solver.solve(sin, min2, max2, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:sin-second] metamorphic violation: valid SinFunction retarget solve threw NullPointerException"
                                + " min2=" + min2
                                + " max2=" + max2
                                + " initial2=" + initial2,
                        t);
            }
            return;
        }

        final double reused;
        try {
            reused = solver.solve(min2, max2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:sin-stored-throw] metamorphic violation: solve(min,max) after successful SinFunction solve(f,min,max,initial) threw in the reachable region"
                                + " min2=" + min2
                                + " max2=" + max2
                                + " initial2=" + initial2
                                + " second=" + second,
                        t);
            }
            return;
        }

        BisectionSolver fresh = new BisectionSolver();
        final double baseline;
        try {
            baseline = fresh.solve(sin, min2, max2);
        } catch (MaxIterationsExceededException e) {
            return;
        } catch (FunctionEvaluationException e) {
            return;
        } catch (Throwable t) {
            return;
        }

        double tol = Math.max(solver.getAbsoluteAccuracy(), fresh.getAbsoluteAccuracy()) * 6.0 + 1.0e-12;
        if (Math.abs(reused - baseline) > tol || Math.abs(reused - root2) > tol) {
            throw new RuntimeException(
                    "[oracle:sin-retargeted-bracket] metamorphic violation: solve(min,max) after a successful SinFunction solve on a new bracket did not recover that bracket's root"
                            + " root2=" + root2
                            + " min2=" + min2
                            + " max2=" + max2
                            + " initial2=" + initial2
                            + " second=" + second
                            + " reused=" + reused
                            + " baseline=" + baseline
                            + " tol=" + tol);
        }
    }

    private static PolynomialFunction linearRoot(double root) {
        return new PolynomialFunction(new double[] { -root, 1.0 });
    }

    private static double boundedRoot(int raw) {
        return (raw % 2000) / 10.0;
    }

    private static double boundedPositive(int raw) {
        int v = raw == Integer.MIN_VALUE ? 0 : Math.abs(raw);
        return (v % 1000) / 20.0;
    }

    private static double scaledUnit(int raw) {
        int v = raw == Integer.MIN_VALUE ? 0 : raw;
        return (v % 2001) / 1000.0 - 1.0;
    }

    private static double clamp(double x, double min, double max) {
        if (x < min) {
            return min;
        }
        if (x > max) {
            return max;
        }
        return x;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
                || name.contains("Invalid")
                || name.contains("NoBracketing")
                || name.contains("NotStrictlyPositive")
                || name.contains("OutOfRange");
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                    && "solve".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
