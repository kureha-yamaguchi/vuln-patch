        double rightWidth = chooseWidth(data);
        double min = expectedRoot - leftWidth;
        double max = expectedRoot + rightWidth;

        double initial;
        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            initial = expectedRoot;
        } else if (mode == 1) {
            initial = min;
        } else if (mode == 2) {
            initial = max;
        } else {
            double fraction = data.consumeInt(0, 1000) / 1000.0;
            initial = min + (max - min) * fraction;
        }

        if (min > max) {
            double tmp = min;
            min = max;
            max = tmp;
        }
        if (initial < min) {
            initial = min;
        } else if (initial > max) {
            initial = max;
        }

        try {
            double result = solver.solve(f, min, max, initial);

            /*
             * Post-condition from the real implementation path:
