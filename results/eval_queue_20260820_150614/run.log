            final double[][] outData = new double[nRows][nCols];
            for (int row = 0; row < nRows; row++) {
                final double[] dataRow    = data[row];
                final double[] outDataRow = outData[row];
                for (int col = 0; col < nCols; col++) {
                    double sum = 0;
                    for (int i = 0; i < nSum; i++) {
