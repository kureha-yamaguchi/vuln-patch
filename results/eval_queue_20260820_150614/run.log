            throw new RuntimeException(
                "[oracle:empty-nocut] metamorphic violation: no-cut polygon must behave like the empty region"
                    + " size=" + size1
                    + " bary=(" + bary1.getX() + "," + bary1.getY() + ")");
        }
    }

    private static BSPTree<Euclidean2D> makeBoundaryAttributeTree(Object plusOutside, Object plusInside) {
        BoundaryAttribute<Euclidean2D> attr =
            new BoundaryAttribute<Euclidean2D>(
                castSubHyperplane(plusOutside),
                castSubHyperplane(plusInside),
                null);
        return new BSPTree<Euclidean2D>(null, null, null, attr);
    }

    private static org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D> castSubHyperplane(Object o) {
        return (org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D>) o;
    }

    private static org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D> makeSimpleSubHyperplane(FuzzedDataProvider data) {
        double x1 = bounded(data.consumeInt(-1000, 1000));
        double y1 = bounded(data.consumeInt(-1000, 1000));
        double x2 = bounded(data.consumeInt(-1000, 1000));
        double y2 = bounded(data.consumeInt(-1000, 1000));

        if (x1 == x2 && y1 == y2) {
            x2 += 1.0;
        }

        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        return line.wholeHyperplane();
    }

    private static double bounded(int v) {
        return v / 16.0;
    }
