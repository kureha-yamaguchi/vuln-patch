package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchorIssue780Like();
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        boolean wholeSpace = data.consumeBoolean();
        int variantCount = data.consumeInt(1, 4);
        for (int i = 0; i < variantCount; i++) {
            exerciseLeafRegion(wholeSpace, data.consumeBoolean());
            wholeSpace = !wholeSpace;
        }

        try {
            runFuzzedPolyhedron(data);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void exerciseLeafRegion(boolean wholeSpace, boolean readVerticesFirst) {
        try {
            PolygonsSet region = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(wholeSpace)));

            if (readVerticesFirst) {
                Vector2D[][] vertices = region.getVertices();
                if (vertices == null || vertices.length != 0) {
                    throw new RuntimeException("[oracle:leaf-vertices] metamorphic violation: no-cut leaf must expose zero loops, got " + (vertices == null ? "null" : vertices.length));
                }
            }

            double size = region.getSize();
            Vector2D barycenter = (Vector2D) region.getBarycenter();

            if (wholeSpace) {
                /*
                 * Contract visible in computeGeometricalProperties():
                 * when getVertices().length == 0 and the leaf attribute is Boolean.TRUE,
                 * the region covers the whole space, so size must be +INF and barycenter NaN.
                 * A throw-deleting / branch-flipping patch breaks this observable state.
                 */
                if (!Double.isInfinite(size) || size < 0.0) {
                    throw new RuntimeException("[oracle:whole-space] metamorphic violation: whole-space leaf must report infinite size, got " + size);
                }
                if (barycenter == null || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                    throw new RuntimeException("[oracle:whole-space] metamorphic violation: whole-space leaf must report NaN barycenter, got " + barycenter);
                }
            } else {
                if (size != 0.0d) {
                    throw new RuntimeException("[oracle:empty-space] metamorphic violation: empty leaf must report size 0, got " + size);
                }
                if (barycenter == null || barycenter.getX() != 0.0d || barycenter.getY() != 0.0d) {
                    throw new RuntimeException("[oracle:empty-space] metamorphic violation: empty leaf must report barycenter (0,0), got " + barycenter);
                }
            }

            Vector2D[][] after = region.getVertices();
            if (after == null || after.length != 0) {
                throw new RuntimeException("[oracle:leaf-vertices] metamorphic violation: repeated getVertices on no-cut leaf must stay empty, got " + (after == null ? "null" : after.length));
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void runAnchorIssue780Like() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };
        buildPolyhedronAndQuery(coords, indices);
    }

    private static void runFuzzedPolyhedron(FuzzedDataProvider data) {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int chosenVertex = data.consumeInt(0, 7);
        int chosenAxis = data.consumeInt(0, 2);
        int coordIndex = chosenVertex * 3 + chosenAxis;
        int micro = data.consumeInt(-8, 8);
        coords[coordIndex] += micro / 1000000.0f;

        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };
        buildPolyhedronAndQuery(coords, indices);
    }

    private static void buildPolyhedronAndQuery(float[] coords, int[] indices) {
        Collection<SubHyperplane<Euclidean3D>> boundary = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;

            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            Plane plane = new Plane(v1, v2, v3);

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            ArrayList<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
            addTriangleEdge(edges, p1, p2, p3);
            addTriangleEdge(edges, p2, p3, p1);
            addTriangleEdge(edges, p3, p1, p2);

            PolygonsSet facet = new PolygonsSet(edges);
            boundary.add(new SubPlane(plane, facet));
        }

        PolyhedronsSet polyhedron = new PolyhedronsSet(boundary);
        polyhedron.getSize();
        polyhedron.getBarycenter();
    }

    private static void addTriangleEdge(Collection<SubHyperplane<Euclidean2D>> edges, Vector2D start, Vector2D end, Vector2D inside) {
        Line line = new Line(start, end);
        if (line.getOffset(inside) < 0.0) {
            line = new Line(end, start);
        }
        edges.add(line.wholeHyperplane());
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method)
                    || "getCut".equals(method)
                    || "visit".equals(method)
                    || "followLoop".equals(method)
                    || "getLine".equals(method)
                    || "getStart".equals(method)
                    || "toSpace".equals(method)
                    || "toSubSpace".equals(method)
                    || "getX".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cls)
                    && ("setBarycenter".equals(method) || "setSize".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
