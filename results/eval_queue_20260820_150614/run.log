private static void runPeriodicShiftCase(UnivariateRealFunction f, double min, double max, double initial, double shift) {
        if (f == null || Double.isNaN(min) || Double.isNaN(max) || Double.isNaN(initial) || Double.isNaN(shift)) {
            return;
        }
        if (!(min < max) || initial < min || initial > max) {
            return;
        }

        double min2 = min + shift;
        double max2 = max + shift;
        double initial2 = initial + shift;

        final double result1;
        try {
            BisectionSolver solver1 = new BisectionSolver();
            result1 = solver1.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:periodic-shift] metamorphic violation: valid SinFunction solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return;
        }

        final double result2;
        try {
            BisectionSolver solver2 = new BisectionSolver();
            result2 = solver2.solve(f, min2, max2, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:periodic-shift] metamorphic violation: 2pi-shifted valid SinFunction solve(f,min,max,initial) threw NullPointerException"
                                + " min=" + min2
                                + " max=" + max2
                                + " initial=" + initial2,
                        t);
            }
            return;
        }

        /*
         * Contract/oracle:
         * SinFunction is the real library function sin(x), which is 2*pi periodic. Therefore,
         * solving the same bracketing problem after shifting min/max/initial by 2*pi must shift
         * the computed root by 2*pi as well. A throw-deleting or seed-special-casing patch can
         * suppress the known NPE yet still return an inconsistent result on nearby valid inputs.
         */
        double tol = Math.max(new BisectionSolver().getAbsoluteAccuracy(), 1.0e-12) * 8.0 + 1.0e-12;
        double delta = result2 - result1;
        if (Math.abs(delta - shift) > tol) {
            throw new RuntimeException(
                    "[oracle:periodic-shift] metamorphic violation: SinFunction root did not translate by 2pi"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " shift=" + shift
                            + " lhs=" + result1
                            + " rhs=" + result2
                            + " delta=" + delta
                            + " tol=" + tol);
        }

        /*
         * Independent consistency check:
         * For a successful solve call, the solver stores the returned solution as its current
         * result. Recomputing the same valid problem on a fresh identically-constructed solver
         * must therefore produce the same returned value and the same cached value.
         */
        try {
            BisectionSolver solver3 = new BisectionSolver();
            double again = solver3.solve(f, min, max, initial);
            double cached = solver3.getResult();
            double tol2 = Math.max(solver3.getAbsoluteAccuracy(), 1.0e-12) * 4.0 + 1.0e-12;
            if (Math.abs(again - result1) > tol2 || Math.abs(again - cached) > tol2) {
                throw new RuntimeException(
                        "[oracle:fresh-recompute] metamorphic violation: repeated valid solve disagreed with prior/cached result"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " first=" + result1
                                + " second=" + again
                                + " cached=" + cached
                                + " tol=" + tol2);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isOracleRuntime((RuntimeException) t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:fresh-recompute] metamorphic violation: repeated valid solve threw NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
        }
    }
