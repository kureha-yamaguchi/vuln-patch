    private static ArrayList<LinearConstraint> copyConstraints(List<LinearConstraint> constraints) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(constraints.size());
        for (LinearConstraint c : constraints) {
            out.add(new LinearConstraint(c.getCoefficients().toArray(), c.getRelationship(), c.getValue()));
        }
        return out;
    }

    private static boolean samePointValue(PointValuePair a, PointValuePair b, double eps) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (!Precision.equals(a.getValue(), b.getValue(), eps)) {
            return false;
        }
        double[] p1 = a.getPoint();
        double[] p2 = b.getPoint();
        if (p1 == null || p2 == null || p1.length != p2.length) {
            return false;
        }
        for (int i = 0; i < p1.length; i++) {
            if (!Precision.equals(p1[i], p2[i], eps)) {
                return false;
            }
        }
        return true;
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }
            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math3.exception.");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getNumObjectiveFunctions".equals(m)
                        || "getHeight".equals(m)
                        || "getWidth".equals(m)
                        || "getEntry".equals(m)
                        || "getNumArtificialVariables".equals(m)
                        || "getArtificialVariableOffset".equals(m)
                        || "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls)
                    && ("getRowDimension".equals(m)
                        || "getColumnDimension".equals(m)
                        || "getEntry".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static int clamp(int v, int lo, int hi) {
        return Math.max(lo, Math.min(hi, v));
    }

    private static double smallCoeff(int v) {
        return (double) clamp(v, -10, 10);
