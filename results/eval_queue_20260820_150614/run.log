    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid")
                    || name.contains("Illegal")
                    || name.contains("OutOfRange")
                    || name.contains("NoBracketing")
                    || name.contains("NotStrictlyPositive")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isOracleRuntime(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static double scaledPositive(int raw, double min, double max) {
        if (max <= min) {
            return min;
        }
        double unit = (raw - 1) / 99999.0;
        return min + (max - min) * unit;
    }
