        try {
            classesFromObjects = ClassUtils.toClass(validObjects);
        } catch (RuntimeException t) {
            if (isRootCauseNpeFromToClass(t)) {
                throw t;
            }
            return;
        }

        Class<?>[] baseChoices = new Class<?>[] {
                String.class,
                Integer.class,
                Double.class,
                Object.class,
                int.class,
                boolean.class,
                long.class,
                java.util.Map.Entry.class
        };

        int dims = data.consumeInt(0, 2);
        Class<?> base = baseChoices[data.consumeInt(0, baseChoices.length - 1)];
        Class<?> expected = base;
        if (dims > 0) {
            expected = Array.newInstance(base, new int[dims]).getClass();
        }

        int extraCount = data.consumeInt(0, 3);
        Class<?>[] oracleInputs = new Class<?>[classesFromObjects.length + 1 + extraCount];
        System.arraycopy(classesFromObjects, 0, oracleInputs, 0, classesFromObjects.length);
        oracleInputs[classesFromObjects.length] = expected;
        for (int i = 0; i < extraCount; i++) {
            Class<?> extraBase = baseChoices[data.consumeInt(0, baseChoices.length - 1)];
            int extraDims = data.consumeInt(0, 2);
            oracleInputs[classesFromObjects.length + 1 + i] =
                    extraDims == 0 ? extraBase : Array.newInstance(extraBase, new int[extraDims]).getClass();
        }

        ClassLoader context = Thread.currentThread().getContextClassLoader();
        ClassLoader loader = context == null ? FuzzHarness.class.getClassLoader() : context;

        for (int i = 0; i < oracleInputs.length; i++) {
            Class<?> cls = oracleInputs[i];
            String canonicalName = cls.getCanonicalName();
            if (canonicalName == null || canonicalName.length() == 0) {
                continue;
            }

            try {
                /*
                 * Contract/oracle:
                 * For the canonical name of an actually existing class, ClassUtils.getClass(...)
                 * must resolve that same Class object. The initialize flag may affect side effects
                 * of class initialization, but never the class identity. The overloads therefore
                 * must agree on the returned Class for the same valid name and loader.
                 */
                Class<?> a = ClassUtils.getClass(canonicalName);
                Class<?> b = ClassUtils.getClass(canonicalName, false);
                Class<?> c = ClassUtils.getClass(loader, canonicalName);
                Class<?> d = ClassUtils.getClass(loader, canonicalName, false);

                if (a != cls || b != cls || c != cls || d != cls) {
                    throw new RuntimeException("[oracle:getclass-overload-agreement] metamorphic violation: name="
                            + canonicalName + " expected=" + cls + " got=[" + a + ", " + b + ", " + c + ", " + d + "]");
                }
            } catch (IllegalArgumentException e) {
                return;
            } catch (ClassNotFoundException e) {
                throw new RuntimeException("[oracle:getclass-roundtrip] metamorphic violation: valid canonical name rejected: "
                        + canonicalName + " expected=" + cls, e);
            } catch (RuntimeException t) {
                if (isRootCauseNpeFromToClass(t)) {
                    throw t;
                }
                return;
            }
        }
    }

    private static boolean isRootCauseNpeFromToClass(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && "toClass".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
