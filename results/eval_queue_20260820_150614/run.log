package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String seriesName = data.consumeAsciiString(16);
        if (seriesName == null || seriesName.length() == 0) {
            seriesName = "S";
        }

        TimeSeries series;
        try {
            series = new TimeSeries(seriesName, Day.class);
        } catch (RuntimeException e) {
            return;
        }

        int baseEpochDay = data.consumeInt(-20000, 20000);
        int gap = data.consumeInt(3, 400);
        int extrasBefore = data.consumeInt(0, 4);
        int extrasAfter = data.consumeInt(0, 4);

        Day first = toDay(baseEpochDay);
        Day second = toDay(baseEpochDay + gap);
        if (first == null || second == null) {
            return;
        }

        tryAdd(series, first, 1);
        tryAdd(series, second, 2);

        for (int i = 0; i < extrasBefore; i++) {
            int offset = data.consumeInt(1, 60);
            tryAdd(series, toDay(baseEpochDay - offset - i * 61), 10 + i);
        }
        for (int i = 0; i < extrasAfter; i++) {
            int offset = data.consumeInt(1, 60);
            tryAdd(series, toDay(baseEpochDay + gap + offset + i * 61), 20 + i);
        }

        if (series.getItemCount() < 2) {
            return;
        }

        checkSeriesCountConsistency(series, "source");

        int startOffset = data.consumeInt(1, gap - 2);
        int endOffset = data.consumeInt(startOffset, gap - 1);
        Day start = toDay(baseEpochDay + startOffset);
        Day end = toDay(baseEpochDay + endOffset);
        if (start == null || end == null) {
            return;
        }

        runScenario(series, start, end, true);

        if (data.consumeBoolean()) {
            Day exactStart = first;
            Day exactEnd = second;
            runScenario(series, exactStart, exactEnd, false);
        }

        if (data.consumeBoolean()) {
            int inside = data.consumeInt(0, series.getItemCount() - 1);
            RegularTimePeriod p = series.getTimePeriod(inside);
            if (p instanceof Day) {
                runScenario(series, (Day) p, (Day) p, false);
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s;
        try {
            s = new TimeSeries("S");
        } catch (RuntimeException e) {
            return;
        }
        tryAdd(s, new Day(19, 8, 2005), 1);
        tryAdd(s, new Day(31, 1, 2006), 1);
        runScenario(s, new Day(1, 12, 2005), new Day(18, 1, 2006), true);
    }

    private static void runScenario(TimeSeries series, Day start, Day end, boolean expectEmptyGap) {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int expectedCount = countItemsInRange(series, start, end);
        int rawStartIndex;
        int rawEndIndex;
        try {
            rawStartIndex = series.getIndex(start);
            rawEndIndex = series.getIndex(end);
        } catch (RuntimeException e) {
            return;
        }

        try {
            TimeSeries copy = series.createCopy(start, end);

            /* Contract asserted:
             * createCopy(start, end) must return a series containing the subset of items
             * in the requested period range. A throw-deleting patch could silently return
             * the wrong subset; therefore we compare the returned size against an
             * independent recomputation from the source series' own items.
             */
            checkSeriesCountConsistency(copy, "copy");
            if (copy.getItemCount() != expectedCount) {
                throw new RuntimeException("[oracle:subset-count] metamorphic violation: createCopy returned wrong item count input="
                        + start + ".." + end + " expected=" + expectedCount + " actual=" + copy.getItemCount());
            }
            if (copy.getItems().size() != expectedCount) {
                throw new RuntimeException("[oracle:list-size] metamorphic violation: getItems().size disagrees with recomputed subset count input="
                        + start + ".." + end + " expected=" + expectedCount + " actual=" + copy.getItems().size());
            }

            if (expectedCount > 0) {
                int adjustedStart = adjustStartIndex(rawStartIndex, series.getItemCount());
                int adjustedEnd = adjustEndIndex(rawEndIndex);
                if (adjustedStart >= 0 && adjustedEnd >= adjustedStart && adjustedEnd < series.getItemCount()) {
                    try {
                        TimeSeries byIndex = series.createCopy(adjustedStart, adjustedEnd);
                        checkSeriesCountConsistency(byIndex, "copyByIndex");
                        if (byIndex.getItemCount() != copy.getItemCount()) {
                            throw new RuntimeException("[oracle:overload-agree] metamorphic violation: createCopy overloads disagree input="
                                    + start + ".." + end + " byPeriod=" + copy.getItemCount() + " byIndex=" + byIndex.getItemCount());
                        }
                    } catch (RuntimeException ex) {
                        if (isRootCause(ex) && expectEmptyGap) {
                            throw ex;
                        }
                    } catch (CloneNotSupportedException ignored) {
                    }
                }
            }
        } catch (CloneNotSupportedException ignored) {
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            if (expectEmptyGap && expectedCount == 0 && hasPatchedConditionShape(series, rawStartIndex, rawEndIndex) && isRootCause(ex)) {
                throw ex;
            }
        }
    }

    private static boolean hasPatchedConditionShape(TimeSeries series, int rawStartIndex, int rawEndIndex) {
        int startIndex = adjustStartIndex(rawStartIndex, series.getItemCount());
        int endIndex = adjustEndIndex(rawEndIndex);
        return startIndex >= 0 && endIndex < startIndex;
    }

    private static int adjustStartIndex(int rawStartIndex, int size) {
        int startIndex = rawStartIndex;
        if (startIndex < 0) {
            startIndex = -(startIndex + 1);
            if (startIndex == size) {
                return Integer.MAX_VALUE;
            }
        }
        return startIndex;
    }

    private static int adjustEndIndex(int rawEndIndex) {
        int endIndex = rawEndIndex;
        if (endIndex < 0) {
            endIndex = -(endIndex + 1);
            endIndex = endIndex - 1;
        }
        return endIndex;
    }

    private static int countItemsInRange(TimeSeries series, Day start, Day end) {
        int count = 0;
        List items = series.getItems();
        for (int i = 0; i < items.size(); i++) {
            Object obj = items.get(i);
            if (!(obj instanceof TimeSeriesDataItem)) {
                continue;
            }
            TimeSeriesDataItem item = (TimeSeriesDataItem) obj;
            RegularTimePeriod p = item.getPeriod();
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static void checkSeriesCountConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        int size = series.getItems().size();
        if (count != size) {
            throw new RuntimeException("[oracle:count-consistency] consistency violation: " + label
                    + " getItemCount=" + count + " getItems().size=" + size);
        }
    }

    private static void tryAdd(TimeSeries s, Day d, Number n) {
        if (s == null || d == null) {
            return;
        }
        try {
            s.add(d, n);
        } catch (RuntimeException ignored) {
        }
    }

    private static Day toDay(int epochDay) {
        try {
            java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
            cal.clear();
            cal.set(1970, java.util.Calendar.JANUARY, 1);
            cal.add(java.util.Calendar.DAY_OF_MONTH, epochDay);
            int day = cal.get(java.util.Calendar.DAY_OF_MONTH);
            int month = cal.get(java.util.Calendar.MONTH) + 1;
            int year = cal.get(java.util.Calendar.YEAR);
            return new Day(day, month, year);
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls) && "createCopy".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeries".equals(cls) && "getIndex".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
