             * so the successful result must lie within the original interval.
             */
            if (result < min || result > max) {
                throw new RuntimeException(
                        "[oracle:interval-contained] metamorphic violation: successful bisection result must stay inside input interval"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " result=" + result);
