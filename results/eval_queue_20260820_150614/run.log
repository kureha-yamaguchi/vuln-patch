package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerAnchor();

        int variants = data.consumeInt(1, 6);
        for (int i = 0; i < variants; i++) {
            explore(data);
        }

        oracleEquivalentConstruction(data);
    }

    private static void triggerAnchor() {
        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(new BoundaryAttribute<Euclidean2D>(null, null));
        PolygonsSet set = new PolygonsSet(tree);
        set.computeGeometricalProperties();
    }

    private static void explore(FuzzedDataProvider data) {
        Object attribute;
        int mode = data.consumeInt(0, 3);
        if (mode == 0) {
            attribute = new BoundaryAttribute<Euclidean2D>(null, null);
        } else if (mode == 1) {
            attribute = Boolean.TRUE;
        } else if (mode == 2) {
            attribute = Boolean.FALSE;
        } else {
            attribute = data.consumeBoolean() ? new BoundaryAttribute<Euclidean2D>(null, null) : Boolean.FALSE;
        }

        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(attribute);
        PolygonsSet set = new PolygonsSet(tree);

        int action = data.consumeInt(0, 2);
        if (action == 0) {
            set.computeGeometricalProperties();
        } else if (action == 1) {
            set.getSize();
        } else {
            set.getBarycenter();
        }
    }

    private static void oracleEquivalentConstruction(FuzzedDataProvider data) {
        double x1 = data.consumeInt(-1000, 1000);
        double x2 = data.consumeInt(-1000, 1000);
        double y1 = data.consumeInt(-1000, 1000);
        double y2 = data.consumeInt(-1000, 1000);

        if (x1 == x2) {
            x2 = x1 + 1.0;
        }
        if (y1 == y2) {
            y2 = y1 + 1.0;
        }

        double minX = Math.min(x1, x2);
        double maxX = Math.max(x1, x2);
        double minY = Math.min(y1, y2);
        double maxY = Math.max(y1, y2);

        PolygonsSet a = new PolygonsSet(minX, maxX, minY, maxY);
        PolygonsSet b = new PolygonsSet(minX, maxX, minY, maxY);

        Vector2D[][] va = a.getVertices();
        Vector2D[][] vb = b.getVertices();

        if (!sameVertices(va, vb)) {
            throw new RuntimeException(
                "[oracle:eq-construct] metamorphic violation: identically constructed polygons disagree on vertices " +
                "input=[" + minX + "," + maxX + "," + minY + "," + maxY + "] " +
                "lhs=" + verticesToString(va) + " rhs=" + verticesToString(vb)
            );
        }

        double sizeA = a.getSize();
        double sizeB = b.getSize();
        if (Double.doubleToLongBits(sizeA) != Double.doubleToLongBits(sizeB)) {
            throw new RuntimeException(
                "[oracle:eq-size] metamorphic violation: identically constructed polygons disagree on size " +
                "input=[" + minX + "," + maxX + "," + minY + "," + maxY + "] lhs=" + sizeA + " rhs=" + sizeB
            );
        }

        Vector2D ba = (Vector2D) a.getBarycenter();
        Vector2D bb = (Vector2D) b.getBarycenter();
        if (!samePoint(ba, bb)) {
            throw new RuntimeException(
                "[oracle:eq-bary] metamorphic violation: identically constructed polygons disagree on barycenter " +
                "input=[" + minX + "," + maxX + "," + minY + "," + maxY + "] lhs=" + pointToString(ba) + " rhs=" + pointToString(bb)
            );
        }
    }

    private static boolean sameVertices(Vector2D[][] a, Vector2D[][] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            Vector2D[] ai = a[i];
            Vector2D[] bi = b[i];
            if (ai == null || bi == null || ai.length != bi.length) {
                return false;
            }
            for (int j = 0; j < ai.length; j++) {
                if (!samePoint(ai[j], bi[j])) {
                    return false;
                }
            }
        }
        return true;
    }

    private static boolean samePoint(Vector2D a, Vector2D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return Double.doubleToLongBits(a.getX()) == Double.doubleToLongBits(b.getX())
            && Double.doubleToLongBits(a.getY()) == Double.doubleToLongBits(b.getY());
    }

    private static String verticesToString(Vector2D[][] v) {
        if (v == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < v.length; i++) {
            if (i > 0) {
                sb.append(';');
            }
            Vector2D[] row = v[i];
            if (row == null) {
                sb.append("null");
            } else {
                sb.append('(');
                for (int j = 0; j < row.length; j++) {
                    if (j > 0) {
                        sb.append(',');
                    }
                    sb.append(pointToString(row[j]));
                }
                sb.append(')');
            }
        }
        sb.append(']');
        return sb.toString();
    }

    private static String pointToString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return p.getX() + "/" + p.getY();
    }
}
