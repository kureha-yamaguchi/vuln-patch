        try {
            actual = ClassUtils.toClass(input);
        } catch (RuntimeException t) {
            if (insertedNull && isRootCauseNpeInRegion(t)) {
                throw new RuntimeException("[oracle:null-slot-contract] toClass must accept arrays containing null elements and preserve null slots", t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (actual == null) {
            throw new RuntimeException("[oracle:null-slot-contract] metamorphic violation: non-null input array produced null result");
        }
        if (actual.length != expected.length) {
            throw new RuntimeException("[oracle:null-slot-contract] metamorphic violation: result length mismatch inputLen="
                    + expected.length + " actualLen=" + actual.length);
        }

        /*
         * Contract visible from the provided test/examples:
         * ClassUtils.toClass(new Object[] { "Test", null, 99d }) must yield
         * new Class[] { String.class, null, Double.class }.
         * A throw-deleting or overfit patch could avoid the NPE but still return
         * a wrong class array. We therefore cross-check the returned array through
         * a different public API: exact per-slot class arrays must be mutually
         * assignable via ClassUtils.isAssignable when they represent the same types.
         */
        boolean forward;
        boolean backward;
        try {
            forward = ClassUtils.isAssignable(actual, expected, true);
            backward = ClassUtils.isAssignable(expected, actual, true);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (!(forward && backward)) {
            throw new RuntimeException("[oracle:assignable-bidi] metamorphic violation: mutual assignability failed for exact class mapping");
        }

        for (int i = 0; i < expected.length; i++) {
            if (actual[i] != expected[i]) {
