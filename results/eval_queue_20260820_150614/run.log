public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runScenario(1.0, 1.0);

        double rhs = 1.0 + data.consumeInt(0, 20);
        runScenario(rhs, rhs);

        int extraRuns = data.consumeInt(1, 4);
        for (int i = 0; i < extraRuns; i++) {
            double v = 1.0 + data.consumeInt(0, 50);
            runScenario(v, v);
        }
    }

    private static void runScenario(double leqRhs, double geqRhs) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0 }, 0.0);

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, leqRhs));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, geqRhs));

        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, 1.0e-6, 10);
        SimplexSolver solver = new SimplexSolver(1.0e-6, 10);

        final int maxUlps = 10;
        final int enteringCol = tableau.getNumObjectiveFunctions();

        Integer expected = computeExpectedPatchedPivotRow(tableau, enteringCol, maxUlps);
        Integer buggyOnlyRow = computeBuggyArtificialPivotRow(tableau, enteringCol, maxUlps);

        if (expected == null || buggyOnlyRow == null || expected.equals(buggyOnlyRow)) {
            return;
        }

        solver.doIteration(tableau);

        Integer actual = tableau.getBasicRow(enteringCol);

        if (!expected.equals(actual)) {
            throw new RuntimeException(
                    "[oracle:bland] metamorphic violation: pivot row for entering column " + enteringCol
                            + " should follow Bland tie-break row=" + expected
                            + " but actual basic row after real doIteration is " + actual
                            + " (buggy artificial-preference row=" + buggyOnlyRow + ")");
        }
    }

    private static Integer computeExpectedPatchedPivotRow(SimplexTableau tableau, int col, int maxUlps) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;

        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            final double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            final double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, maxUlps) > 0) {
                final double ratio = rhs / entry;
                final int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(i);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(i);
                }
            }
        }

        if (minRatioPositions.isEmpty()) {
            return null;
        }
        if (minRatioPositions.size() == 1) {
            return minRatioPositions.get(0);
        }

        Integer minRow = null;
        int minIndex = tableau.getWidth();
        for (Integer row : minRatioPositions) {
            int i = tableau.getNumObjectiveFunctions();
            for (; i < tableau.getWidth() - 1 && minRow != row; i++) {
                if (row.equals(tableau.getBasicRow(i))) {
                    if (i < minIndex) {
                        minIndex = i;
                        minRow = row;
                    }
                }
            }
        }
        return minRow;
    }

    private static Integer computeBuggyArtificialPivotRow(SimplexTableau tableau, int col, int maxUlps) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;

        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            final double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            final double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, maxUlps) > 0) {
                final double ratio = rhs / entry;
                final int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(i);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(i);
                }
            }
        }

        if (minRatioPositions.size() <= 1) {
            return null;
        }

        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                final double entry = tableau.getEntry(row, column);
                if (Precision.equals(entry, 1d, maxUlps) && row.equals(tableau.getBasicRow(column))) {
                    return row;
                }
            }
        }

        return null;
    }
}
