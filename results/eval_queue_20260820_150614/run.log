package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        runCtorBoundAgreement(f, 3.0, 3.2, 3.1);

        int cases = 1 + Math.min(4, data.remainingBytes() / 4);
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-20, 20);
            double root = k * Math.PI;

            double left = scaledPositive(data.consumeInt(1, 1000), 0.01, 1.0);
            double right = scaledPositive(data.consumeInt(1, 1000), 0.01, 1.0);

            double min = root - left;
            double max = root + right;

            double initial;
            if (data.consumeBoolean()) {
                initial = root;
            } else {
                int pos = data.consumeInt(0, 1000);
                initial = min + (max - min) * (pos / 1000.0);
            }

            runCtorBoundAgreement(f, min, max, initial);

            double shift = (data.consumeInt(1, 10)) * Math.PI;
            double otherRoot = root + (data.consumeBoolean() ? shift : -shift);
            double left2 = scaledPositive(data.consumeInt(1, 1000), 0.01, 1.0);
            double right2 = scaledPositive(data.consumeInt(1, 1000), 0.01, 1.0);
            double min2 = otherRoot - left2;
            double max2 = otherRoot + right2;
            runCtorReuseSwitch(f, min, max, min2, max2);
        }
    }

    private static void runCtorBoundAgreement(UnivariateRealFunction f, double min, double max, double initial) {
        if (f == null || !isFinite(min) || !isFinite(max) || !isFinite(initial)) {
            return;
        }
        if (!(min < max) || initial < min || initial > max) {
            return;
        }

        final double withInitial;
        final BisectionSolver explicitSolver = new BisectionSolver();
        try {
            withInitial = explicitSolver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:ctor-bound-agree] metamorphic violation: valid solve(f,min,max,initial) threw root-cause NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return;
        }

        final double ctorBound;
        final BisectionSolver boundSolver;
        try {
            boundSolver = new BisectionSolver(f);
            ctorBound = boundSolver.solve(min, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:ctor-bound-agree] metamorphic violation: constructor-bound solve(min,max) threw root-cause NullPointerException"
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return;
        }

        /*
         * Contract used for this oracle:
         * the solver API exposes equivalent overload families for the same root-finding problem:
         * - solve(f, min, max, initial)
         * - solve(min, max) on a solver constructed with the same function.
         * For BisectionSolver, the iteration uses only the function and bracketing interval, so both
         * real library paths must compute the same root within solver accuracy.
         * A band-aid patch that merely suppresses the buggy throw or bypasses the real function path
         * can leave one entry point returning a different value while the other remains correct.
         */
        double tol = Math.max(explicitSolver.getAbsoluteAccuracy(), boundSolver.getAbsoluteAccuracy()) * 4.0 + 1e-12;
        if (Math.abs(withInitial - ctorBound) > tol) {
            throw new RuntimeException(
                    "[oracle:ctor-bound-agree] metamorphic violation: explicit-function and constructor-bound solver disagreed"
                            + " min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " lhs=" + withInitial
                            + " rhs=" + ctorBound
                            + " tol=" + tol);
        }
    }

    private static void runCtorReuseSwitch(UnivariateRealFunction f, double min1, double max1, double min2, double max2) {
        if (f == null || !isFinite(min1) || !isFinite(max1) || !isFinite(min2) || !isFinite(max2)) {
            return;
        }
        if (!(min1 < max1) || !(min2 < max2)) {
            return;
        }

        final BisectionSolver reused;
        final double secondResult;
        try {
            reused = new BisectionSolver(f);
            reused.solve(min1, max1);
            secondResult = reused.solve(min2, max2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:ctor-reuse-switch] metamorphic violation: valid constructor-bound helper solve threw root-cause NullPointerException"
                                + " firstMin=" + min1
                                + " firstMax=" + max1
                                + " secondMin=" + min2
                                + " secondMax=" + max2,
                        t);
            }
            return;
        }

        final BisectionSolver fresh;
        final double freshSecond;
        try {
            fresh = new BisectionSolver(f);
            freshSecond = fresh.solve(min2, max2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:ctor-reuse-switch] metamorphic violation: fresh constructor-bound helper solve threw root-cause NullPointerException"
                                + " secondMin=" + min2
                                + " secondMax=" + max2,
                        t);
            }
            return;
        }

        /*
         * Contract used for this oracle:
         * solve(min,max) on a constructor-bound BisectionSolver must depend on the stored function and
         * the current interval only. Reusing the same solver for one interval and then another must
         * produce the same second root as solving only the second interval on a fresh, identically
         * constructed solver. This cross-check exercises the real helper overload solve(min,max).
         */
        double tol = Math.max(reused.getAbsoluteAccuracy(), fresh.getAbsoluteAccuracy()) * 4.0 + 1e-12;
        if (Math.abs(secondResult - freshSecond) > tol) {
            throw new RuntimeException(
                    "[oracle:ctor-reuse-switch] metamorphic violation: reused and fresh constructor-bound helpers disagreed on second interval"
                            + " firstMin=" + min1
                            + " firstMax=" + max1
                            + " secondMin=" + min2
                            + " secondMax=" + max2
                            + " lhs=" + secondResult
                            + " rhs=" + freshSecond
                            + " tol=" + tol);
        }
    }

    private static boolean isRootCauseNpeFromBisectionSolve(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof NullPointerException && stackHasBisectionSolve(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean stackHasBisectionSolve(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.endsWith("ConvergenceException")
                    || name.endsWith("MathException")
                    || name.contains("Invalid")
                    || name.contains("NoBracketing")
                    || name.contains("OutOfRange")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isFinite(double v) {
        return !Double.isNaN(v) && !Double.isInfinite(v);
    }

    private static double scaledPositive(int value, double min, double max) {
        double fraction = value / 1000.0;
        return min + (max - min) * fraction;
    }
}
