        BigDecimal[] e0 = new BigDecimal[cols];
        for (int i = 0; i < cols; i++) {
            e0[i] = BD_ZERO;
        }
        e0[0] = BD_ONE;

        BigDecimal[] out1 = m.operate(e0);
        for (int r = 0; r < rows; r++) {
            BigDecimal expected = m.getEntry(r, 0);
            if (out1.length <= r || out1[r] == null || out1[r].compareTo(expected) != 0) {
