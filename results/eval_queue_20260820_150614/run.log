        BigDecimal delta = BigDecimal.valueOf(data.consumeInt(1, 5));
        backing[rows - 1][0] = oldLast.add(delta);

        BigDecimal[] out2 = m.operate(e0);
        BigDecimal expectedUpdated = m.getEntry(rows - 1, 0);
        if (out2.length <= rows - 1 || out2[rows - 1] == null || out2[rows - 1].compareTo(expectedUpdated) != 0) {
