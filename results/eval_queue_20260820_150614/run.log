package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;
import org.apache.commons.math.ConvergenceException;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MathException;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorThroughPublicApi();

        int initial = data.consumeInt(-1000, 1000);
        boolean rootAtUpperEndpoint = data.consumeBoolean();
        int spread = data.consumeInt(2, 8);
        int maxIterations = data.consumeInt(1, 8);

        int lower = initial - spread;
        int upper = initial + spread;
        int root = rootAtUpperEndpoint ? (initial + 1) : (initial - 1);

        if (!(lower < initial && initial < upper)) {
            return;
        }
        if (root <= lower || root >= upper) {
            return;
        }

        PolynomialFunction f = new PolynomialFunction(new double[] { -root, 1.0 });

        try {
            double[] withExplicitIterations =
                    UnivariateRealSolverUtils.bracket(f, initial, lower, upper, maxIterations);
            double[] withDefaultIterations =
                    UnivariateRealSolverUtils.bracket(f, initial, lower, upper);

            // Contract/oracle:
            // bracket(...) returns an interval bracketing a root; for a correct implementation
            // f(a) * f(b) must be <= 0 for the returned endpoints. Also the overloads are
            // documented analogues with the same semantics, so on the same valid input they
            // must agree on the bracket they return.
            verifyBracketOracle(f, root, lower, upper, withExplicitIterations, withDefaultIterations);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isBracketRootCause(t)) {
                throwAsUnchecked(t);
            }
            return;
        }

        exploreAroundBoundaryViaPublicApi(data);
    }

    private static void anchorThroughPublicApi() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            normal.inverseCumulativeProbability(0.9772498680518209d);
        } catch (Throwable t) {
            // Known already-covered symptom through inverseCumulativeProbability:
            // exercise the real production call chain, but do not report this duplicate signature.
        }
    }

    private static void exploreAroundBoundaryViaPublicApi(FuzzedDataProvider data) {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);

            int k = data.consumeInt(0, 6);
            double pExact = normal.cumulativeProbability((double) k);
            double xExact = normal.inverseCumulativeProbability(pExact);

            double delta = Math.abs(data.consumeInt(1, 1000)) * 1.0e-6;
            double pLow = clampProbability(pExact - delta);
            double pHigh = clampProbability(pExact + delta);

            double xLow = normal.inverseCumulativeProbability(pLow);
            double xHigh = normal.inverseCumulativeProbability(pHigh);

            if (!(xLow <= xExact && xExact <= xHigh)) {
                throw new RuntimeException(
                        "[oracle:inv-monotone] metamorphic violation: inverse CDF must be monotone"
                                + " k=" + k
                                + " pLow=" + pLow
                                + " pExact=" + pExact
                                + " pHigh=" + pHigh
                                + " xLow=" + xLow
                                + " xExact=" + xExact
                                + " xHigh=" + xHigh);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            // Do not report the already-covered inverseCumulativeProbability crash signature.
        }
    }

    private static double clampProbability(double p) {
        if (p <= 1.0e-12) {
            return 1.0e-12;
        }
        if (p >= 1.0 - 1.0e-12) {
            return 1.0 - 1.0e-12;
        }
        return p;
    }

    private static void verifyBracketOracle(
            PolynomialFunction f,
            int root,
            int lower,
            int upper,
            double[] a,
            double[] b) throws FunctionEvaluationException {
        if (a == null || b == null || a.length != 2 || b.length != 2) {
            throw new RuntimeException(
                    "[oracle:bracket-overloads] metamorphic violation: invalid bracket arrays"
                            + " explicit=" + Arrays.toString(a)
                            + " default=" + Arrays.toString(b));
        }

        if (a[0] != b[0] || a[1] != b[1]) {
            throw new RuntimeException(
                    "[oracle:bracket-overloads] metamorphic violation: overload disagreement"
                            + " explicit=" + Arrays.toString(a)
                            + " default=" + Arrays.toString(b)
                            + " root=" + root
                            + " bounds=[" + lower + "," + upper + "]");
        }

        double fa = f.value(a[0]);
        double fb = f.value(a[1]);

        if (!(a[0] >= lower && a[1] <= upper && a[0] <= root && root <= a[1] && fa * fb <= 0.0d)) {
            throw new RuntimeException(
                    "[oracle:bracket-post] metamorphic violation: returned interval does not bracket root"
                            + " bracket=" + Arrays.toString(a)
                            + " root=" + root
                            + " fa=" + fa
                            + " fb=" + fb
                            + " bounds=[" + lower + "," + upper + "]");
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
