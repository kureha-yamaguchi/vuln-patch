        double left = scaledPositive(data.consumeInt(1, 5000), 1.0e-4, 0.45);
        double right = scaledPositive(data.consumeInt(1, 5000), 1.0e-4, 0.45);

        double min = expectedRoot - left;
        double max = expectedRoot + right;
        double initial = chooseInitial(data, min, max);

        runNestedBracketCase(f, expectedRoot, min, max, initial, data);

        double edgeEpsilon = scaledPositive(data.consumeInt(1, 5000), 1.0e-12, 1.0e-3);
        double nearMin = clamp(min + edgeEpsilon, min, max);
        double nearMax = clamp(max - edgeEpsilon, min, max);
        runNestedBracketCase(f, expectedRoot, min, max, nearMin, data);
        runNestedBracketCase(f, expectedRoot, min, max, nearMax, data);
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        double expectedRoot = Math.PI;
        double min = 3.0;
        double max = 3.2;
        double initial = 3.1;
