public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorTrigger();

        TimeSeries s = new TimeSeries(nonEmptyName(data), Day.class);

        int leftEpoch = data.consumeInt(-15000, 15000);
        int gap = data.consumeInt(3, 800);

        Day left = toDay(leftEpoch);
        Day right = toDay(leftEpoch + gap);
        s.add(left, Integer.valueOf(1));
        s.add(right, Integer.valueOf(2));

        int beforeCount = data.consumeInt(0, 3);
        int afterCount = data.consumeInt(0, 3);

        for (int i = 0; i < beforeCount; i++) {
            Day extra = toDay(leftEpoch - data.consumeInt(1, 90) - (i * 100));
            if (s.getIndex(extra) < 0) {
                s.add(extra, Integer.valueOf(10 + i));
            }
        }
        for (int i = 0; i < afterCount; i++) {
            Day extra = toDay(leftEpoch + gap + data.consumeInt(1, 90) + (i * 100));
            if (s.getIndex(extra) < 0) {
                s.add(extra, Integer.valueOf(20 + i));
            }
        }

        int startInside = data.consumeInt(1, gap - 2);
        int endInside = data.consumeInt(startInside, gap - 1);

        Day start = toDay(leftEpoch + startInside);
        Day end = toDay(leftEpoch + endInside);

        int expected = countItemsInRange(s, start, end);

        try {
            TimeSeries copy = s.createCopy(start, end);

            /* Contract/post-condition:
             * createCopy(start, end) should return the subset of data items whose
             * periods lie within [start, end]. For the constructed inputs here,
             * start <= end and both lie strictly between two existing items, so the
             * correct result is an empty series. A patch that merely suppresses the
             * exception but returns the wrong contents would violate this check.
             */
            if (copy.getItemCount() != expected) {
                throw new RuntimeException("[oracle:subset-count] metamorphic violation: expected itemCount="
                        + expected + " actual=" + copy.getItemCount());
            }
            if (copy.getItems().size() != copy.getItemCount()) {
                throw new RuntimeException("[oracle:count-agree] consistency violation: getItems().size="
                        + copy.getItems().size() + " itemCount=" + copy.getItemCount());
            }

            int startIndex = adjustedStartIndex(s, start);
            int endIndex = adjustedEndIndex(s, end);
            if (expected == 0 && endIndex < startIndex) {
                TimeSeries byIndex = s.createCopy(startIndex, endIndex);
                if (byIndex.getItemCount() != copy.getItemCount()) {
                    throw new RuntimeException("[oracle:overload-agree] metamorphic violation: byIndex="
                            + byIndex.getItemCount() + " byPeriod=" + copy.getItemCount());
                }
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException(e);
        }
    }

    private static void anchorTrigger() {
