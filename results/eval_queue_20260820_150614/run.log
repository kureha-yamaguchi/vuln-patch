                break;
            case 4:
                pattern = left + " {" + 0 + ",upper} " + middle + "''" + right;
                break;
            case 5:
                pattern = left + "''" + middle + " {" + 0 + "} " + right;
                break;
            case 6:
                pattern = left + " '{0}' " + middle + " {" + 0 + ",lower} " + right + "''";
                break;
            default:
                pattern = left + " {" + 0 + ",lower} 'x' " + middle + "''" + right;
                break;
        }

        checkPattern(pattern, registry);
    }

    private static void checkPattern(String pattern, Map registry) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.US, registry);

        /*
         * Contract/oracle:
