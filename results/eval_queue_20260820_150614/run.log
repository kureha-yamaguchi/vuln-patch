private static void exercise(String s, boolean isAnchor) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            if (isThreeCharNonYes(s)) {
                /*
                 * Contract/oracle:
                 * From the shown implementation and the provided test cases, the only
                 * length-3 strings recognized as true are case-insensitive "yes".
                 * Any other 3-character string must therefore return false.
                 * This catches a "fixed" patch that merely suppresses the crash but
                 * returns the wrong boolean for the buggy input shape.
                 */
                if (result) {
                    throw new RuntimeException(
                        "[oracle:three-char-false] metamorphic violation: non-yes 3-char string must parse as false input="
                            + quote(s) + " lhs=" + result + " rhs=false");
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && (isAnchor || isThreeCharNonYes(s))) {
                throw t;
            }
        }
    }
