            sb.appendFixedWidthPadRight((Object) null, 1, '-');
            if (!"f".equals(sb.toString())) {
                throw new RuntimeException("[oracle:null-anchor-visible] metamorphic violation: nullText path should append leftmost width chars nullText=foo width=1 lhs=" + printable(sb.toString()) + " rhs=f");
