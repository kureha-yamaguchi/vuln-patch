package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String[] ARRAY_LIST = { "foo", "bar", "baz" };
    private static final String[] EMPTY_ARRAY_LIST = {};
    private static final String[] NULL_ARRAY_LIST = { null };
    private static final String[] MIXED_ARRAY_LIST = { null, "", "foo" };
    private static final Object[] MIXED_TYPE_LIST = { "foo", Long.valueOf(2L) };
    private static final char SEPARATOR_CHAR = ';';
    private static final String TEXT_LIST_CHAR = "foo;bar;baz";

    private static final Object NULL_TO_STRING = new Object() {
        @Override
        public String toString() {
            return null;
        }
    };

    private static final Object[] NULL_TO_STRING_LIST = { NULL_TO_STRING };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        int len = data.consumeInt(1, 6);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            int kind = data.consumeInt(0, 4);
            switch (kind) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeAsciiString(8);
                    break;
                case 2:
                    array[i] = Long.valueOf(data.consumeInt(-1000, 1000));
                    break;
                case 3:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                default:
                    array[i] = data.consumeString(8);
                    break;
            }
        }

        int badPos = data.consumeInt(0, len - 1);
        array[badPos] = NULL_TO_STRING;

        int startIndex = data.consumeInt(0, len - 1);
        int endIndex = data.consumeInt(startIndex + 1, len);
        char charSep = (char) (data.consumeByte() & 0xff);
        String stringSep = data.consumeBoolean() ? null : data.consumeString(4);

        exerciseCharJoin(array, charSep, startIndex, endIndex);
        exerciseStringJoin(array, stringSep, startIndex, endIndex);

        int boundaryStart = badPos;
        int boundaryEnd = Math.min(len, badPos + 1);
        if (boundaryEnd > boundaryStart) {
            exerciseCharJoin(array, '/', boundaryStart, boundaryEnd);
            exerciseStringJoin(array, "/", boundaryStart, boundaryEnd);
        }

        if (badPos + 1 < len) {
            exerciseCharJoin(array, '/', badPos + 1, len);
            exerciseStringJoin(array, "/", badPos + 1, len);
        }
    }

    private static void runAnchorChecks() {
        if (StringUtils.join((Object[]) null, ',') != null) {
            throw new RuntimeException("[oracle:anchor-null-array] expected null for null array");
        }

        if (!TEXT_LIST_CHAR.equals(StringUtils.join(ARRAY_LIST, SEPARATOR_CHAR))) {
            throw new RuntimeException("[oracle:anchor-text-list] unexpected join result");
        }

        if (!"".equals(StringUtils.join(EMPTY_ARRAY_LIST, SEPARATOR_CHAR))) {
            throw new RuntimeException("[oracle:anchor-empty-array] unexpected empty-array result");
        }

        if (!"foo".equals(StringUtils.join(MIXED_ARRAY_LIST))) {
            throw new RuntimeException("[oracle:anchor-mixed-varargs-check] unexpected mixed varargs result");
        }

        if (!"".equals(StringUtils.join(NULL_ARRAY_LIST))) {
            throw new RuntimeException("[oracle:anchor-null-element-varargs] unexpected null-array result");
        }

        try {
            String got = StringUtils.join(NULL_TO_STRING_LIST, '/', 0, 1);
            if (!"null".equals(got)) {
                throw new RuntimeException("[oracle:anchor-null-tostring-char-value] input=NULL_TO_STRING_LIST lhs=" + got + " rhs=null");
            }
            checkJoinedLengthOracle(NULL_TO_STRING_LIST, String.valueOf('/'), 0, 1, got, "anchor-char");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            String got = StringUtils.join(NULL_TO_STRING_LIST, "/", 0, 1);
            if (!"null".equals(got)) {
                throw new RuntimeException("[oracle:anchor-null-tostring-string-value] input=NULL_TO_STRING_LIST lhs=" + got + " rhs=null");
            }
            checkJoinedLengthOracle(NULL_TO_STRING_LIST, "/", 0, 1, got, "anchor-string");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            String got = StringUtils.join(NULL_TO_STRING_LIST);
            if (!"null".equals(got)) {
                throw new RuntimeException("[oracle:anchor-null-tostring-varargs-value] input=NULL_TO_STRING_LIST lhs=" + got + " rhs=null");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        if (!"foo;2".equals(StringUtils.join(MIXED_TYPE_LIST, ';'))) {
            throw new RuntimeException("[oracle:anchor-mixed-type-char] unexpected mixed-type result");
        }
    }

    private static void exerciseCharJoin(Object[] array, char sep, int startIndex, int endIndex) {
        try {
            String joined = StringUtils.join(array, sep, startIndex, endIndex);

            /* Contract used for this oracle:
             * join appends the selected elements in order, inserting exactly one separator between
             * consecutive selected positions, and for a non-null element it appends the same text
             * StringBuilder.append(Object) would append. Therefore the joined string's length must
             * equal the sum of independently-rendered element lengths plus separator count.
             * A patch that merely suppresses the old throw but silently drops or mangles an element
             * will violate this even if no exception is thrown.
             */
            checkJoinedLengthOracle(array, String.valueOf(sep), startIndex, endIndex, joined, "char-len");

            if (joined != null && StringUtils.length(joined) != joined.length()) {
                throw new RuntimeException("[oracle:char-length-api] input=" + startIndex + ":" + endIndex
                        + " api=" + StringUtils.length(joined) + " jdk=" + joined.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exerciseStringJoin(Object[] array, String sep, int startIndex, int endIndex) {
        try {
            String joined = StringUtils.join(array, sep, startIndex, endIndex);

            /* Same documented guarantee as above for the String-separator overload:
             * selected elements are joined in order with the separator placed between items.
             * The result length can be recomputed independently from per-element rendering plus
             * separator count, so this catches wrong-output repairs that only hide the exception.
             */
            checkJoinedLengthOracle(array, sep == null ? "" : sep, startIndex, endIndex, joined, "string-len");

            if (joined != null && StringUtils.length(joined) != joined.length()) {
                throw new RuntimeException("[oracle:string-length-api] input=" + startIndex + ":" + endIndex
                        + " api=" + StringUtils.length(joined) + " jdk=" + joined.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkJoinedLengthOracle(Object[] array, String separator, int startIndex, int endIndex,
                                                String joined, String oracleId) {
        if (joined == null || array == null) {
            return;
        }
        if (startIndex < 0 || endIndex < startIndex || endIndex > array.length) {
            return;
        }

        int expected = 0;
        int items = endIndex - startIndex;
        if (items <= 0) {
            expected = 0;
        } else {
            for (int i = startIndex; i < endIndex; i++) {
                if (i > startIndex) {
                    expected += separator.length();
                }
                if (array[i] != null) {
                    String rendered = new StringBuilder().append(array[i]).toString();
                    expected += StringUtils.length(rendered);
                }
            }
        }

        int actual = joined.length();
        if (expected != actual) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: length(join) mismatch "
                    + "start=" + startIndex + " end=" + endIndex
                    + " expected=" + expected + " actual=" + actual
                    + " joined=" + joined);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException) && !(t instanceof RuntimeException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "join".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
