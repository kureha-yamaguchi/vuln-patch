                if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                    return false;
                }
                break;
                
            case LEQ:
                if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                    return false;
                }
                break;
            }
        }
        
        return true;
    }
