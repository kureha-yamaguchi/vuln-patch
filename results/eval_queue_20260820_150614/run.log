                        && "toBoolean".equals(ste.getMethodName())) {
                    inTarget = true;
                    break;
                }
            }
            if (t instanceof StringIndexOutOfBoundsException && inTarget) {
                throw t;
            }
        }

        int iterations = data.consumeInt(1, 8);
        for (int i = 0; i < iterations; i++) {
            String raw;
            if (data.consumeBoolean()) {
                raw = data.consumeAsciiString(12);
            } else {
                raw = data.consumeString(12);
            }

            String s;
            if (raw.length() >= 3) {
                int start = data.consumeInt(0, raw.length() - 3);
                s = raw.substring(start, start + 3);
            } else {
                String pad = raw + data.consumeAsciiString(3) + "abc";
                s = pad.substring(0, 3);
            }

            char c0 = s.charAt(0);
            if (c0 == 'y' || c0 == 'Y') {
                char replacement;
                if (data.consumeBoolean()) {
                    replacement = 'o';
                } else {
                    replacement = (char) ('a' + Math.abs((int) data.consumeByte()) % 26);
                    if (replacement == 'y') {
                        replacement = 'o';
                    }
                }
                s = replacement + s.substring(1);
            }

            if (s.length() != 3) {
                continue;
            }
            if (s.charAt(0) == 'y' || s.charAt(0) == 'Y') {
                continue;
            }

            try {
                boolean result = BooleanUtils.toBoolean(s);

                /*
                 * Contract/oracle: from the documented behavior and tests for BooleanUtils.toBoolean(String),
                 * the only 3-character token accepted as true is "yes" (case-insensitive). Therefore any
