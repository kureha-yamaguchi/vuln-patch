    private static String replaceCustomFormats(String pattern) {
        String p = pattern;
        int idx = p.indexOf(",lower}");
        while (idx >= 0) {
            p = p.substring(0, idx) + "}" + p.substring(idx + ",lower}".length());
            idx = p.indexOf(",lower}");
        }
        idx = p.indexOf(",upper}");
        while (idx >= 0) {
            p = p.substring(0, idx) + "}" + p.substring(idx + ",upper}".length());
            idx = p.indexOf(",upper}");
        }
        return p;
    }

