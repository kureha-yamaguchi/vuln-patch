package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runNullAnchor();

        String prefix = data.consumeAsciiString(8);
        String src = data.consumeString(16);
        String nullText = data.consumeString(16);
        char pad = (char) (data.consumeByte() & 0x7f);
        boolean useNullObject = data.consumeBoolean();

        if (src == null || src.length() == 0) {
            src = "X";
        }
        if (nullText == null || nullText.length() == 0) {
            nullText = "N";
        }

        String effective = useNullObject ? nullText : src;
        if (effective.length() == 0) {
            return;
        }

        int len = effective.length();
        int selector = data.consumeInt(0, 2);
        int width;
        if (selector == 0) {
            width = (len == 1) ? 1 : len - 1;
        } else if (selector == 1) {
            width = len;
        } else {
            width = len + 1;
        }

        int initialCapacity = prefix.length() + effective.length() + 8;
        runSetLengthExposureOracle(prefix, src, nullText, width, pad, initialCapacity, useNullObject);

        if (len > 1) {
            runSetLengthExposureOracle(prefix, src, nullText, len - 1, pad, initialCapacity + 1, useNullObject);
        }
        runSetLengthExposureOracle(prefix, src, nullText, len, pad, initialCapacity + 2, useNullObject);
        runSetLengthExposureOracle(prefix, src, nullText, len + 1, pad, initialCapacity + 3, useNullObject);
    }

