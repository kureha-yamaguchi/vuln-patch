    private static void checkXYDomainConsistency(int index, Layer layer, boolean notify, double value) {
        try {
            XYPlot plot = new XYPlot();
            ValueMarker marker = new ValueMarker(value);

            plot.addDomainMarker(index, marker, layer, false);
            Collection afterAdd = plot.getDomainMarkers(index, layer);
            if (afterAdd == null || !afterAdd.contains(marker)) {
                return;
            }

            int beforeSize = afterAdd.size();
            boolean removed = plot.removeDomainMarker(index, marker, layer, notify);
            Collection afterRemove = plot.getDomainMarkers(index, layer);

            /* Contract used: addDomainMarker and getDomainMarkers describe the same stored marker set.
               A successful removeDomainMarker must be visible through getDomainMarkers and size accounting. */
            if (!removed) {
                throw new RuntimeException("[oracle:xy-domain-remove] metamorphic violation: added marker was not removed index=" + index + " layer=" + layer + " beforeSize=" + beforeSize);
            }
            if (afterRemove != null && afterRemove.contains(marker)) {
                throw new RuntimeException("[oracle:xy-domain-state] consistency violation: getDomainMarkers still contains removed marker index=" + index + " layer=" + layer);
            }
            int afterSize = (afterRemove == null) ? 0 : afterRemove.size();
            if (afterSize != beforeSize - 1) {
                throw new RuntimeException("[oracle:xy-domain-size] consistency violation: size mismatch before=" + beforeSize + " after=" + afterSize + " index=" + index + " layer=" + layer);
