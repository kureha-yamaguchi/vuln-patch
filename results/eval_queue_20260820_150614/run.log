package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorEndpointSandwich();

        int trials = 1 + data.consumeInt(1, 6);
        for (int i = 0; i < trials; i++) {
            double mean = data.consumeInt(-5, 5);
            double sd = data.consumeInt(1, 5);

            int step = data.consumeInt(2, 6);
            if (data.consumeBoolean()) {
                step = -step;
            }

            double x = mean + step * sd;

            int pow = data.consumeInt(6, 10);
            double delta = Math.pow(10.0, -pow);

            exerciseEndpointSandwich(mean, sd, x, delta);
        }
    }

    private static void anchorEndpointSandwich() {
        exerciseEndpointSandwich(0.0, 1.0, 2.0, 1.0e-8);
    }

    private static void exerciseEndpointSandwich(double mean, double sd, double x, double delta) {
        if (!(sd > 0.0) || Double.isNaN(mean) || Double.isNaN(sd) || Double.isNaN(x) || Double.isNaN(delta) || !(delta > 0.0)) {
            return;
        }

        NormalDistributionImpl dist = new NormalDistributionImpl(mean, sd);

        try {
            double pLo = dist.cumulativeProbability(x - delta);
            double pExact = dist.cumulativeProbability(x);
            double pHi = dist.cumulativeProbability(x + delta);

            if (!isStrictProbability(pLo) || !isStrictProbability(pExact) || !isStrictProbability(pHi)) {
                return;
            }
            if (!(pLo < pExact && pExact < pHi)) {
                return;
            }

            double invLo;
            double invHi;
            try {
                invLo = dist.inverseCumulativeProbability(pLo);
                invHi = dist.inverseCumulativeProbability(pHi);
            } catch (Throwable t) {
                return;
            }

            double invExact;
            try {
                invExact = dist.inverseCumulativeProbability(pExact);
            } catch (Throwable t) {
                if (isRootCauseMathException(t)) {
                    throw new RuntimeException(
                            "[oracle:endpoint-sandwich] metamorphic violation: inverse at exact CDF point threw while nearby probabilities succeeded"
                                    + " mean=" + mean
                                    + " sd=" + sd
                                    + " x=" + x
                                    + " delta=" + delta
                                    + " pLo=" + pLo
                                    + " pExact=" + pExact
                                    + " pHi=" + pHi
                                    + " invLo=" + invLo
                                    + " invHi=" + invHi,
                            t);
                }
                return;
            }

            if (!(invLo <= invExact && invExact <= invHi)) {
                throw new RuntimeException(
                        "[oracle:endpoint-sandwich] metamorphic violation: exact inverse must lie between inverses of neighboring probabilities"
                                + " mean=" + mean
                                + " sd=" + sd
                                + " x=" + x
                                + " delta=" + delta
                                + " pLo=" + pLo
                                + " pExact=" + pExact
                                + " pHi=" + pHi
                                + " invLo=" + invLo
                                + " invExact=" + invExact
                                + " invHi=" + invHi);
            }

            double tol = Math.max(1.0e-6, Math.max(Math.abs(x), Math.abs(invExact)) * 1.0e-6);
            if (Math.abs(invExact - x) > tol) {
                throw new RuntimeException(
                        "[oracle:endpoint-sandwich] metamorphic violation: inverse(CDF(x)) disagrees with the constructed endpoint-root x"
                                + " mean=" + mean
                                + " sd=" + sd
                                + " x=" + x
                                + " delta=" + delta
                                + " pExact=" + pExact
                                + " invExact=" + invExact
                                + " tol=" + tol);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            if (isRootCauseMathException(e)) {
                throw new RuntimeException(
                        "[oracle:endpoint-sandwich] metamorphic violation: valid standard distribution query rejected unexpectedly"
                                + " mean=" + mean
                                + " sd=" + sd
                                + " x=" + x
                                + " delta=" + delta,
                        e);
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }
    }

    private static boolean isStrictProbability(double p) {
        return !Double.isNaN(p) && !Double.isInfinite(p) && p > 0.0 && p < 1.0;
    }

    private static boolean isRootCauseMathException(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
