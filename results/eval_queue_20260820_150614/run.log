package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor from the failing test: a negative mean must be rejected, and the buggy build
        // rejects it through MathRuntimeException.createIllegalArgumentException instead of the
        // library's strict-positivity validation path.
        try {
            new PoissonDistributionImpl(-1);
            throw new RuntimeException(
                "[oracle:anchor-reject] metamorphic violation: negative mean must be rejected input=-1");
        } catch (RuntimeException t) {
            if (isLegacyGenericPoissonMeanRejection(t)) {
                throw new RuntimeException(
                    "[oracle:anchor-type] metamorphic violation: negative mean rejected through generic MathRuntimeException path input=-1 throwable="
                        + t.getClass().getName(),
                    t);
            }
            if (!isCleanRejection(t)) {
                // Out-of-scope runtime failure.
            }
        }

        // Explore the root-cause property: any p <= 0 should be rejected cleanly through the real
        // public API path, not via the legacy generic MathRuntimeException factory.
        double invalidMean;
        int raw = data.consumeInt(-1_000_000, 1_000_000);
        if (data.consumeBoolean()) {
            invalidMean = 0.0;
        } else {
            invalidMean = -Math.abs(raw) - (data.consumeBoolean() ? 0.0 : 0.5);
        }
        try {
            new PoissonDistributionImpl(invalidMean);
            throw new RuntimeException(
                "[oracle:invalid-accept] metamorphic violation: constructor accepted non-positive mean input="
                    + invalidMean);
        } catch (RuntimeException t) {
            if (isLegacyGenericPoissonMeanRejection(t)) {
                throw new RuntimeException(
                    "[oracle:invalid-type] metamorphic violation: non-positive mean rejected through generic MathRuntimeException path input="
                        + invalidMean + " throwable=" + t.getClass().getName(),
                    t);
            }
            if (!isCleanRejection(t)) {
                // Out-of-scope runtime failure.
            }
        }

        // Valid-by-construction exercise of the touched constructor and shared state.
        // Contract asserted:
        // - getMean() "Get the Poisson mean for the distribution."
        //   Therefore it must equal the constructor argument exactly.
        // - cumulativeProbability(0) is P(X <= 0) and probability(0) is P(X = 0),
        //   so for any correct Poisson distribution these are equal.
        int meanInt = Math.abs(data.consumeInt(-1000, 1000)) + 1;
        double mean = meanInt + (data.consumeBoolean() ? 0.0 : 0.5);
        int epsScale = data.consumeInt(1, 1_000_000);
        double epsilon = epsScale / 1_000_000.0;
        int maxIterations = data.consumeInt(1, 1000);

        PoissonDistributionImpl dist;
        try {
            dist = new PoissonDistributionImpl(mean, epsilon, maxIterations);
        } catch (RuntimeException t) {
            if (isLegacyGenericPoissonMeanRejection(t)) {
                throw t;
            }
            return;
        }

        double observedMean = dist.getMean();
        if (Double.doubleToLongBits(observedMean) != Double.doubleToLongBits(mean)) {
            throw new RuntimeException(
                "[oracle:getMean] metamorphic violation: constructor-established mean not reported inputMean="
                    + mean + " observedMean=" + observedMean);
        }

        double before = dist.getMean();
        int x = data.consumeInt(0, 20);
        try {
            dist.probability(x);
            dist.cumulativeProbability(x);
            double after = dist.getMean();
            if (Double.doubleToLongBits(after) != Double.doubleToLongBits(before)) {
                throw new RuntimeException(
                    "[oracle:mean-stable] metamorphic violation: read-only probability/cumulativeProbability changed mean before="
                        + before + " after=" + after + " x=" + x);
            }
        } catch (MathException e) {
            return;
        } catch (RuntimeException t) {
            if (isLegacyGenericPoissonMeanRejection(t)) {
                throw t;
            }
            return;
        }

        try {
            double p0 = dist.probability(0);
            double c0 = dist.cumulativeProbability(0);
            if (Math.abs(p0 - c0) > 1.0e-12) {
                throw new RuntimeException(
                    "[oracle:p0-cdf0] metamorphic violation: cumulativeProbability(0) must equal probability(0) mean="
                        + mean + " probability0=" + p0 + " cumulative0=" + c0);
            }
        } catch (MathException e) {
            return;
        } catch (RuntimeException t) {
            if (isLegacyGenericPoissonMeanRejection(t)) {
                throw t;
            }
            return;
        }

        try {
