package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        int rounds = data.consumeInt(1, 8);
        for (int i = 0; i < rounds; i++) {
            String s;
            int strategy = data.consumeInt(0, 5);
            if (strategy == 0) {
                s = buildThreeCharNonYes(data);
            } else if (strategy == 1) {
                String raw = data.consumeAsciiString(16);
                s = takeOrPadToThree(raw, data);
                s = forceFirstCharNotY(s, data);
            } else if (strategy == 2) {
                String raw = data.consumeString(16);
                s = takeOrPadToThree(raw, data);
                s = forceFirstCharNotY(s, data);
            } else if (strategy == 3) {
                String[] literals = new String[] {
                    "off", "oof", "abc", "tru", "___", "000", "xYz", "NO!", "   ", "ofF"
                };
                s = literals[data.consumeInt(0, literals.length - 1)];
                s = forceFirstCharNotY(s, data);
            } else if (strategy == 4) {
                String surrounding = data.consumeRemainingAsString();
                if (surrounding.length() == 0) {
                    surrounding = "off";
                }
                while (surrounding.length() < 3) {
                    surrounding = surrounding + "xyz";
                }
                int start = data.consumeInt(0, surrounding.length() - 3);
                s = surrounding.substring(start, start + 3);
                s = forceFirstCharNotY(s, data);
            } else {
                byte[] bytes = data.consumeBytes(3);
                char[] chars = new char[3];
                for (int j = 0; j < 3; j++) {
                    int v = j < bytes.length ? bytes[j] : 0;
                    chars[j] = (char) ('a' + (Math.abs(v) % 26));
                }
                if (chars[0] == 'y') {
                    chars[0] = 'o';
                }
                s = new String(chars);
            }

            if (s != null && s.length() == 3 && !equalsIgnoreAsciiCase(s, "yes")) {
                exercise(s, false);
            }

            String nearMiss = mutateKeepingLengthThreeAndNonYes(s, data);
            if (nearMiss != null && nearMiss.length() == 3 && !equalsIgnoreAsciiCase(nearMiss, "yes")) {
                exercise(nearMiss, false);
            }
        }
    }

    private static void exercise(String s, boolean anchor) {
        try {
            boolean result = BooleanUtils.toBoolean(s);

            /*
             * Contract/oracle:
             * BooleanUtils.toBoolean(String) recognizes case-insensitive true tokens "true", "on", "yes";
             * all other strings return false. Therefore any non-null 3-character string other than "yes"
             * must parse as false. A throw-deleting or branch-skipping patch that avoids the crash but
             * returns true for these inputs violates this observable result.
             */
            if (isThreeCharNonYes(s) && result) {
                throw new RuntimeException(
                    "[oracle:three-char-false] metamorphic violation: non-yes 3-char token must parse as false input="
                        + repr(s) + " lhs=" + result + " rhs=false");
            }

            /*
             * Contract/oracle:
             * The parser is case-insensitive for the recognized textual forms, so changing only case
             * must not change the boolean result.
             */
            if (s != null) {
                try {
                    String upper = s.toUpperCase();
                    boolean upperResult = BooleanUtils.toBoolean(upper);
                    if (result != upperResult) {
                        throw new RuntimeException(
                            "[oracle:casefold-upper] metamorphic violation: case-only change must preserve result input="
                                + repr(s) + " lhs=" + result + " rhs=" + upperResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                    if (isRootCause(t) && (anchor || isThreeCharNonYes(upperSafe(s)))) {
                        throw t;
                    }
                    if (isCleanRejection(t)) {
                        return;
                    }
                }

                try {
                    String lower = s.toLowerCase();
                    boolean lowerResult = BooleanUtils.toBoolean(lower);
                    if (result != lowerResult) {
                        throw new RuntimeException(
                            "[oracle:casefold-lower] metamorphic violation: case-only change must preserve result input="
                                + repr(s) + " lhs=" + result + " rhs=" + lowerResult);
                    }
                } catch (RuntimeException t) {
                    if (isOracleViolation(t)) {
                        throw t;
                    }
                    if (isRootCause(t) && (anchor || isThreeCharNonYes(lowerSafe(s)))) {
                        throw t;
                    }
                    if (isCleanRejection(t)) {
                        return;
                    }
                }
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && (anchor || isThreeCharNonYes(s))) {
                throw t;
            }
        }
    }

    private static boolean isThreeCharNonYes(String s) {
        return s != null && s.length() == 3 && !equalsIgnoreAsciiCase(s, "yes");
    }

    private static boolean equalsIgnoreAsciiCase(String a, String b) {
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (ca == cb) {
                continue;
            }
            if ('A' <= ca && ca <= 'Z') {
                ca = (char) (ca - 'A' + 'a');
            }
            if ('A' <= cb && cb <= 'Z') {
                cb = (char) (cb - 'A' + 'a');
            }
            if (ca != cb) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                    && "toBoolean".equals(st[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String buildThreeCharNonYes(FuzzedDataProvider data) {
        char[] chars = new char[3];
        for (int i = 0; i < 3; i++) {
            if (data.consumeBoolean()) {
                chars[i] = (char) ('a' + data.consumeInt(0, 25));
            } else {
                chars[i] = (char) ('A' + data.consumeInt(0, 25));
            }
        }
        if (chars[0] == 'y' || chars[0] == 'Y') {
            chars[0] = data.consumeBoolean() ? 'o' : 'n';
        }
        String s = new String(chars);
        if (equalsIgnoreAsciiCase(s, "yes")) {
            s = "off";
        }
        return s;
    }

    private static String takeOrPadToThree(String raw, FuzzedDataProvider data) {
        if (raw == null) {
            raw = "";
        }
        if (raw.length() >= 3) {
            int start = data.consumeInt(0, raw.length() - 3);
            return raw.substring(start, start + 3);
        }
        StringBuilder sb = new StringBuilder(raw);
        while (sb.length() < 3) {
            char c = (char) ('a' + data.consumeInt(0, 25));
            sb.append(c);
        }
        return sb.substring(0, 3);
    }

    private static String forceFirstCharNotY(String s, FuzzedDataProvider data) {
        if (s == null || s.length() != 3) {
            return "off";
        }
        char c0 = s.charAt(0);
        if (c0 == 'y' || c0 == 'Y') {
            char replacement = data.consumeBoolean() ? 'o' : 'n';
            s = replacement + s.substring(1);
        }
        if (equalsIgnoreAsciiCase(s, "yes")) {
            s = "off";
        }
        return s;
    }

    private static String mutateKeepingLengthThreeAndNonYes(String s, FuzzedDataProvider data) {
        if (s == null || s.length() != 3) {
            return buildThreeCharNonYes(data);
        }
        char[] chars = s.toCharArray();
        int idx = data.consumeInt(0, 2);
        char replacement;
        if (data.consumeBoolean()) {
            replacement = (char) ('a' + data.consumeInt(0, 25));
        } else {
            replacement = (char) ('A' + data.consumeInt(0, 25));
        }
        chars[idx] = replacement;
        if (chars[0] == 'y' || chars[0] == 'Y') {
            chars[0] = 'o';
        }
        String out = new String(chars);
        if (equalsIgnoreAsciiCase(out, "yes")) {
            out = "o" + out.substring(1);
        }
        return out;
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '\\' || ch == '"') {
                sb.append('\\').append(ch);
            } else if (ch == '\n') {
                sb.append("\\n");
            } else if (ch == '\r') {
                sb.append("\\r");
            } else if (ch == '\t') {
                sb.append("\\t");
            } else {
                sb.append(ch);
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static String upperSafe(String s) {
        return s == null ? null : s.toUpperCase();
    }

    private static String lowerSafe(String s) {
        return s == null ? null : s.toLowerCase();
    }
}
