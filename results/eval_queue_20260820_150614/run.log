        // the valid call below must either return a real bracket satisfying the sign condition, or it is wrong.
        int root = data.consumeInt(1, 1000);
        int extraUpper = data.consumeInt(0, 10);
        double initial = root;
        double lower = root - 1.0d;
        double upper = root + 1.0d + extraUpper;
        int maxIterations = Math.max(1, data.consumeInt(1, 1000));

        PolynomialFunction decreasingLinear = new PolynomialFunction(new double[]{root, -1.0d}); // f(x)=root-x

        try {
            double[] bracketed = UnivariateRealSolverUtils.bracket(
                    decreasingLinear, initial, lower, upper, maxIterations);

            if (bracketed == null || bracketed.length != 2) {
                throw new RuntimeException("[oracle:bracket-shape] metamorphic violation: bracket must return exactly two endpoints inputRoot=" + root);
            }

