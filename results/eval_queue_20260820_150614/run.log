    private static Object makeRealObject(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 7)) {
            case 0:
                return data.consumeString(16);
            case 1:
                return Integer.valueOf(data.consumeInt(-1000000, 1000000));
            case 2:
                return Double.valueOf((double) data.consumeInt(-1000000, 1000000) / 10.0d);
            case 3:
                return Long.valueOf((long) data.consumeInt(-1000000, 1000000));
            case 4:
                return data.consumeAsciiString(12);
            case 5:
                return data.consumeBytes(8);
            case 6:
                return new int[] { data.consumeInt(-16, 16), data.consumeInt(-16, 16) };
            default:
                return new Object();
        }
    }

    private static boolean isRootCauseNpeInRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("toClass".equals(m) || "getClass".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }
