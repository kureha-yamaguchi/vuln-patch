        int mode = data.consumeInt(0, 7);
        int index = data.consumeInt(0, 8);
        boolean background = data.consumeBoolean();
        boolean notify = data.consumeBoolean();
        Layer layer = background ? Layer.BACKGROUND : Layer.FOREGROUND;

        String categoryLabel = data.consumeString(32);
        if (categoryLabel == null || categoryLabel.length() == 0) {
            categoryLabel = "C";
        }
        double value = data.consumeInt(-1000, 1000) / 10.0;

