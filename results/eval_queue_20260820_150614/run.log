private static Double solveValid(
            UnivariateRealFunction f,
            double min,
            double max,
            double initial,
            double expectedRoot,
            String label) {

        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, min, max, initial);
            double tol = solver.getAbsoluteAccuracy() * 6.0 + 1.0e-12;

            if (Math.abs(result - expectedRoot) > tol) {
                throw new RuntimeException(
                        "[oracle:nested-bracket] metamorphic violation: valid SinFunction bracket missed the constructed root"
                                + " label=" + label
                                + " expectedRoot=" + expectedRoot
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial
                                + " result=" + result
                                + " tol=" + tol);
            }

            return Double.valueOf(result);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCauseNpeFromBisectionSolve(t)) {
                throw new RuntimeException(
                        "[oracle:nested-bracket] metamorphic violation: valid solve(f,min,max,initial) threw NullPointerException"
                                + " label=" + label
                                + " expectedRoot=" + expectedRoot
                                + " min=" + min
                                + " max=" + max
                                + " initial=" + initial,
                        t);
            }
            return null;
        }
    }
