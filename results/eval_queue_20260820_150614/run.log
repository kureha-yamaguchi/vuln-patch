package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorDeleteFirst();
        runBoundaryReplaceAllAbsent(data);
    }

    private static void runAnchorDeleteFirst() {
        try {
            StrBuilder sb = new StrBuilder("onetwothree");
            sb.deleteFirst("three");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isArrayIssue(t) && passesThroughRegion(t)) {
                throw t;
            }
        }
    }

    private static void runBoundaryReplaceAllAbsent(FuzzedDataProvider data) {
        String visible = data.consumeAsciiString(16);
        if (visible.length() == 0) {
            visible = "A";
        }

        char sentinel = pickSentinelNotIn(visible);
        if (sentinel == 0) {
            return;
        }

        int overlap = data.consumeInt(1, Math.min(4, visible.length()));
        String search = visible.substring(visible.length() - overlap) + sentinel;
        String staleTail = data.consumeAsciiString(8);
        String replacement = data.consumeAsciiString(8);

        StrBuilder sb = new StrBuilder();
        sb.append(visible);
        sb.append(String.valueOf(sentinel));
        sb.append(staleTail);

        sb.setLength(visible.length());

        String before = sb.toString();

        try {
            /*
             * Contract relied on:
             * - setLength(int) "drops the last characters", so the logical contents become exactly `visible`.
             * - replaceAll(searchStr, replaceStr) replaces occurrences of searchStr; if searchStr is absent,
             *   the builder must remain unchanged.
             *
             * We build `search` so it contains a sentinel character that is guaranteed absent from `visible`,
             * therefore a correct implementation must treat it as absent after truncation.
             * Buggy indexOf can still "find" it by reading stale characters just past length().
             */
            sb.replaceAll(search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isArrayIssue(t) && passesThroughRegion(t)) {
                throw t;
            }
            return;
        }

        String after = sb.toString();
        if (!before.equals(after)) {
            throw new RuntimeException(
                "[oracle:replaceall-boundary] metamorphic violation: replaceAll must be a no-op for an absent search string "
                    + "visible=" + quote(visible)
                    + " search=" + quote(search)
                    + " replacement=" + quote(replacement)
                    + " before=" + quote(before)
                    + " after=" + quote(after));
        }

        StrBuilder fresh = new StrBuilder();
        fresh.append(visible);
        String freshString = fresh.toString();
        if (!after.equals(freshString)) {
            throw new RuntimeException(
                "[oracle:fresh-recompute] consistency violation: truncated builder disagrees with a fresh builder built from the same logical contents "
                    + "visible=" + quote(visible)
                    + " search=" + quote(search)
                    + " after=" + quote(after)
                    + " fresh=" + quote(freshString));
        }
    }

    private static char pickSentinelNotIn(String s) {
        char[] candidates = new char[] {'#', '@', '!', '$', '%', '^', '&', '*', '~', '?', '|', ':'};
        for (int i = 0; i < candidates.length; i++) {
            if (s.indexOf(candidates[i]) < 0) {
                return candidates[i];
            }
        }
        return 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isArrayIssue(Throwable t) {
        return t instanceof ArrayIndexOutOfBoundsException;
    }

    private static boolean passesThroughRegion(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())
                    && "indexOf".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return "\"" + s.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r").replace("\"", "\\\"") + "\"";
    }
}
