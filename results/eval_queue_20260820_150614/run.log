package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor from the failing test. Swallow the already-known crash signature here so this harness
        // can still contribute a post-condition / metamorphic oracle rather than only duplicate it.
        try {
            StrBuilder anchor = new StrBuilder(1);
            anchor.appendFixedWidthPadRight("foo", 1, '-');
            if (!"f".equals(anchor.toString()) || anchor.length() != 1) {
                throw new RuntimeException("[oracle:anchor-out] metamorphic violation: exact regression seed produced wrong visible result actual="
                        + anchor.toString() + " len=" + anchor.length());
            }
            try {
                String full = anchor.substring(0, anchor.length());
                if (!anchor.toString().equals(full)) {
                    throw new RuntimeException("[oracle:sub-full-anchor] metamorphic violation: full-range substring must equal visible contents actual="
                            + anchor.toString() + " sub=" + full);
                }
            } catch (RuntimeException ignored) {
                // If the read-back helper itself rejects, the relation does not apply for this input.
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (!isKnownRootCause(t)) {
                return;
            }
        }

        int prefixLen = data.consumeInt(0, 8);
        String prefix = data.consumeAsciiString(prefixLen);

        int slack = data.consumeInt(0, 4);
        int width = data.consumeInt(1, 4);
        char pad = (char) (data.consumeByte() & 0xff);

        boolean useNullPath = data.consumeBoolean();

        int payloadLen = data.consumeInt(6, 20);
        String payload = data.consumeAsciiString(payloadLen);
        if (payload.length() < 6) {
            payload = payload + "ABCDEF";
        }

        exercise(prefix, slack, payload, width, pad, useNullPath);
    }

    private static void exercise(String prefix, int slack, String payload, int width, char pad, boolean useNullPath) {
        StrBuilder subject = new StrBuilder(prefix.length() + slack);
        subject.append(prefix);

        String effectiveInput = payload;
        if (useNullPath) {
            subject.setNullText(payload);
        }

        StrBuilder expected = new StrBuilder();
        expected.append(prefix);
        if (effectiveInput.length() >= width) {
            expected.append(effectiveInput, 0, width);
        } else {
            expected.append(effectiveInput);
            expected.appendPadding(width - effectiveInput.length(), pad);
        }

        try {
            if (useNullPath) {
                subject.appendFixedWidthPadRight(null, width, pad);
            } else {
                subject.appendFixedWidthPadRight(payload, width, pad);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isKnownRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        // Contract asserted: appendFixedWidthPadRight appends exactly "width" characters:
        // either the value truncated to width, or the value followed by pad chars.
        // A throw-deleting or branch-skipping patch would violate this visible result.
        String actual = subject.toString();
        String want = expected.toString();
        if (!want.equals(actual)) {
            throw new RuntimeException("[oracle:visible-fixed-right] metamorphic violation: visible contents disagree expected="
                    + want + " actual=" + actual + " prefix=" + prefix + " payload=" + payload
                    + " width=" + width + " slack=" + slack + " nullPath=" + useNullPath);
        }
        int expectedLen = prefix.length() + width;
        if (subject.length() != expectedLen) {
            throw new RuntimeException("[oracle:length-fixed-right] metamorphic violation: appended width must change length by exactly width expectedLen="
                    + expectedLen + " actualLen=" + subject.length() + " prefixLen=" + prefix.length()
                    + " width=" + width + " payload=" + payload + " slack=" + slack + " nullPath=" + useNullPath);
        }

        // Independent read-back oracle outside the covered families:
        // substring over the full reported range must equal the object's own visible contents.
        try {
            String full = subject.substring(0, subject.length());
            if (!actual.equals(full)) {
                throw new RuntimeException("[oracle:sub-full] metamorphic violation: full-range substring must equal visible contents actual="
                        + actual + " sub=" + full + " payload=" + payload + " width=" + width
                        + " slack=" + slack + " nullPath=" + useNullPath);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
