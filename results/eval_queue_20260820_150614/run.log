package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String[] ARRAY_LIST = { "foo", "bar", "baz" };
    private static final String[] EMPTY_ARRAY_LIST = {};
    private static final String[] NULL_ARRAY_LIST = { null };
    private static final String[] MIXED_ARRAY_LIST = { null, "", "foo" };
    private static final Object[] MIXED_TYPE_LIST = { "foo", Long.valueOf(2L) };
    private static final char SEPARATOR_CHAR = ';';
    private static final String TEXT_LIST_CHAR = "foo;bar;baz";

    private static final Object[] NULL_TO_STRING_LIST = {
        new Object() {
            @Override
            public String toString() {
                return null;
            }
        }
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        int mode = data.consumeInt(0, 4);
        try {
            switch (mode) {
                case 0:
                    exploreCharJoin(data);
                    break;
                case 1:
                    exploreStringJoin(data);
                    break;
                case 2:
                    exploreObjectArrayJoin(data);
                    break;
                case 3:
                    crossCheckEquivalentOverloads(data);
                    break;
                default:
                    emptyStateAgreement(data);
                    break;
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorChecks() {
        try {
            if (StringUtils.join((Object[]) null, ',') != null) {
                throw new RuntimeException("[oracle:anchor-null-array] metamorphic violation: join((Object[])null, ',') must return null");
            }
            String text = StringUtils.join(ARRAY_LIST, SEPARATOR_CHAR);
            if (!TEXT_LIST_CHAR.equals(text)) {
                throw new RuntimeException("[oracle:anchor-array-char] metamorphic violation: expected=" + TEXT_LIST_CHAR + " actual=" + text);
            }
            String empty = StringUtils.join(EMPTY_ARRAY_LIST, SEPARATOR_CHAR);
            if (!"".equals(empty)) {
                throw new RuntimeException("[oracle:anchor-empty-char] metamorphic violation: expected empty actual=" + empty);
            }
            String mixed = StringUtils.join(MIXED_ARRAY_LIST, '/', 0, MIXED_ARRAY_LIST.length - 1);
            if (!"/".equals(mixed)) {
                throw new RuntimeException("[oracle:anchor-mixed-char] metamorphic violation: expected=/ actual=" + mixed);
            }

            // Contract exercised by the original tests: joining an object whose real toString() returns null must
            // yield the literal "null" through StringBuilder.append(Object), not crash or silently drop it.
            String s1 = StringUtils.join(NULL_TO_STRING_LIST, '/', 0, 1);
            if (!"null".equals(s1)) {
                throw new RuntimeException("[oracle:anchor-null-tostring-char] metamorphic violation: expected=null actual=" + s1);
            }

            String s2 = StringUtils.join(NULL_TO_STRING_LIST);
            if (!"null".equals(s2)) {
                throw new RuntimeException("[oracle:anchor-null-tostring-varargs] metamorphic violation: expected=null actual=" + s2);
            }

            if (StringUtils.join((Object[]) null) != null) {
                throw new RuntimeException("[oracle:anchor-null-varargs] metamorphic violation: join((Object[])null) must return null");
            }
            if (!"".equals(StringUtils.join((Object) null))) {
                throw new RuntimeException("[oracle:anchor-object-null] metamorphic violation: join((Object)null) must be empty");
            }
            if (!"foo".equals(StringUtils.join(MIXED_ARRAY_LIST))) {
                throw new RuntimeException("[oracle:anchor-mixed-varargs] metamorphic violation: expected=foo actual=" + StringUtils.join(MIXED_ARRAY_LIST));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                throw t;
            }
        }
    }

    private static void exploreCharJoin(FuzzedDataProvider data) {
        Object[] array = buildArrayWithNullToStringTrigger(data, true);
        char sep = (char) data.consumeInt(0, 127);

        int len = array.length;
        int start = data.consumeInt(0, len == 0 ? 0 : len - 1);
        int end = data.consumeBoolean() ? len : data.consumeInt(start, len);

        String result = StringUtils.join(array, sep, start, end);

        // Documented/illustrated sibling guarantee: single-char String separator and char separator must agree.
        try {
            String sibling = StringUtils.join(array, String.valueOf(sep), start, end);
            if (result != null && sibling != null && !result.equals(sibling)) {
                throw new RuntimeException("[oracle:char-vs-string] metamorphic violation: input produced different results lhs=" + result + " rhs=" + sibling);
            }
        } catch (RuntimeException ignored) {
        }

        if (start == 0 && end > 0 && containsNullToString(array, start, end)) {
            if (!result.contains("null")) {
                throw new RuntimeException("[oracle:null-render-char] metamorphic violation: valid join over toString()->null element must contain literal null result=" + result);
            }
        }
    }

    private static void exploreStringJoin(FuzzedDataProvider data) {
        Object[] array = buildArrayWithNullToStringTrigger(data, true);
        String sep = data.consumeBoolean() ? null : data.consumeAsciiString(4);

        int len = array.length;
        int start = data.consumeInt(0, len == 0 ? 0 : len - 1);
        int end = data.consumeBoolean() ? len : data.consumeInt(start, len);

        String result = StringUtils.join(array, sep, start, end);

        // Documented contract: null separator is treated as EMPTY.
        try {
            String equivalent = StringUtils.join(array, sep == null ? "" : sep, start, end);
            if (result != null && equivalent != null && !result.equals(equivalent)) {
                throw new RuntimeException("[oracle:null-separator] metamorphic violation: null separator should behave like empty separator lhs=" + result + " rhs=" + equivalent);
            }
        } catch (RuntimeException ignored) {
        }

        if (start == 0 && end > 0 && containsNullToString(array, start, end)) {
            if (!result.contains("null")) {
                throw new RuntimeException("[oracle:null-render-string] metamorphic violation: valid join over toString()->null element must contain literal null result=" + result);
            }
        }
    }

    private static void exploreObjectArrayJoin(FuzzedDataProvider data) {
        Object[] array = buildArrayWithNullToStringTrigger(data, false);
        String result = StringUtils.join(array);

        // Composition guarantee from the API examples: join(array) is the same as join(array, "", 0, array.length).
        try {
            String equivalent = StringUtils.join(array, "", 0, array.length);
            if (result != null && equivalent != null && !result.equals(equivalent)) {
                throw new RuntimeException("[oracle:varargs-vs-range] metamorphic violation: lhs=" + result + " rhs=" + equivalent);
            }
        } catch (RuntimeException ignored) {
        }

        if (array.length > 0 && containsNullToString(array, 0, array.length) && !result.contains("null")) {
            throw new RuntimeException("[oracle:null-render-varargs] metamorphic violation: valid join over toString()->null element must contain literal null result=" + result);
        }
    }

    private static void crossCheckEquivalentOverloads(FuzzedDataProvider data) {
        Object[] array = buildArrayWithNullToStringTrigger(data, true);
        char sep = (char) data.consumeInt(1, 126);
        int len = array.length;
        int start = data.consumeInt(0, len == 0 ? 0 : len - 1);
        int end = data.consumeInt(start, len);

        String a = StringUtils.join(array, sep, start, end);
        String b = StringUtils.join(array, String.valueOf(sep), start, end);
        if (a != null && b != null && !a.equals(b)) {
            throw new RuntimeException("[oracle:overload-agreement] metamorphic violation: char and String overloads disagree lhs=" + a + " rhs=" + b);
        }

        // Independent quantity cross-check: the helper StringUtils.length must agree with the actual String length.
        int reported = StringUtils.length(a);
        int independent = (a == null) ? 0 : a.length();
        if (reported != independent) {
            throw new RuntimeException("[oracle:length-helper] consistency violation: reported=" + reported + " independent=" + independent);
        }
    }

    private static void emptyStateAgreement(FuzzedDataProvider data) {
        Object[] array = data.consumeBoolean() ? EMPTY_ARRAY_LIST : NULL_ARRAY_LIST;
        String r1 = StringUtils.join(array, '/', 0, 0);
        String r2 = StringUtils.join(array, "", 0, 0);
        String empty1 = StringUtils.trimToEmpty(null);
        String empty2 = StringUtils.stripToEmpty(null);
        String empty3 = StringUtils.substring("", 0);
        String empty4 = StringUtils.substring("", 0, 0);
        String empty5 = StringUtils.left("x", -1);

        if (!r1.equals(empty1) || !r2.equals(empty2) || !empty1.equals(empty3) || !empty2.equals(empty4) || !empty3.equals(empty5)) {
            throw new RuntimeException("[oracle:empty-agreement] consistency violation: EMPTY-backed APIs disagree");
        }
    }

    private static Object[] buildArrayWithNullToStringTrigger(FuzzedDataProvider data, boolean ensureRangeCanStartAtZero) {
        int len = data.consumeInt(1, 8);
        Object[] array = new Object[len];

        int triggerIndex = ensureRangeCanStartAtZero ? 0 : data.consumeInt(0, len - 1);
        array[triggerIndex] = NULL_TO_STRING_LIST[0];

        for (int i = 0; i < len; i++) {
            if (i == triggerIndex) {
                continue;
            }
            int choice = data.consumeInt(0, 4);
            switch (choice) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeAsciiString(8);
                    break;
                case 2:
                    array[i] = Long.valueOf(data.consumeInt(-1000, 1000));
                    break;
                case 3:
                    array[i] = ArrayUtils.toString(data.consumeBytes(6));
                    break;
                default:
                    array[i] = BooleanUtils.toString(Boolean.valueOf(data.consumeBoolean()), "T", "F", "N");
                    break;
            }
        }
        return array;
    }

    private static boolean containsNullToString(Object[] array, int start, int end) {
        for (int i = start; i < end; i++) {
            if (array[i] == NULL_TO_STRING_LIST[0]) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "join".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
