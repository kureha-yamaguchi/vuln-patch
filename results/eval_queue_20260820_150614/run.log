private static void runWidthPrefixRelation(String prefix, String source, int smallWidth, int largeWidth, char padChar, boolean useNullObject) {
        if (smallWidth <= 0 || largeWidth <= smallWidth || source == null || source.length() <= largeWidth || prefix.length() == 0) {
            return;
        }

        StrBuilder small = new StrBuilder(prefix.length());
        StrBuilder large = new StrBuilder(prefix.length());

        try {
            small.append(prefix);
            if (useNullObject) {
                small.setNullText(source);
                small.appendFixedWidthPadRight((Object) null, smallWidth, padChar);
            } else {
                small.appendFixedWidthPadRight((Object) source, smallWidth, padChar);
            }
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            large.append(prefix);
            if (useNullObject) {
                large.setNullText(source);
                large.appendFixedWidthPadRight((Object) null, largeWidth, padChar);
            } else {
                large.appendFixedWidthPadRight((Object) source, largeWidth, padChar);
            }
        } catch (IllegalArgumentException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /*
         * Visible contract:
         * appendFixedWidthPadRight appends a fixed-width field; when the source text is longer
         * than width, that field is the leftmost width characters of the text.
         * Hence for the same prefix and same source with source.length() > largeWidth,
         * the result produced with smallWidth must be exactly a prefix of the result produced
         * with largeWidth. A patch that merely suppresses the throw but copies the wrong count
         * or damages shared state will violate this relation.
         */
        String smallOut = small.toString();
        String largeOut = large.toString();
        if (smallOut.length() != prefix.length() + smallWidth || largeOut.length() != prefix.length() + largeWidth) {
            throw new RuntimeException("[oracle:width-prefix] metamorphic violation: wrong fixed widths prefix="
                    + prefix + " smallWidth=" + smallWidth + " largeWidth=" + largeWidth
                    + " smallLen=" + smallOut.length() + " largeLen=" + largeOut.length());
        }
        if (!largeOut.substring(0, smallOut.length()).equals(smallOut)) {
            throw new RuntimeException("[oracle:width-prefix] metamorphic violation: smaller-width result is not a prefix of larger-width result prefix="
                    + prefix + " src=" + source + " smallWidth=" + smallWidth + " largeWidth=" + largeWidth
                    + " lhs=" + smallOut + " rhs=" + largeOut);
        }
    }
