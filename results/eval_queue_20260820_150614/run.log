package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeString(16);
        String base = data.consumeString(24);
        char pad = (char) (data.consumeByte() & 0xff);
        boolean useNullObject = data.consumeBoolean();

        if (base == null) {
            return;
        }

        if (base.length() == 0) {
            base = "A";
        }

        int width;
        if (data.consumeBoolean()) {
            width = Math.max(1, base.length() - 1);
        } else {
            int delta = data.consumeInt(0, 3);
            width = Math.max(1, base.length() - 1 - delta);
            if (width >= base.length()) {
                width = Math.max(1, base.length() - 1);
            }
        }

        String longer = maybeExtend(base, data.consumeAsciiString(8));
        if (longer.length() <= width) {
            longer = longer + "XYZ";
        }
        if (longer.length() <= width) {
            return;
        }

        runBoundaryCases(prefix, longer, pad, useNullObject);
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isValidation(t)) {
                return;
            }
            return;
        }
        String out = sb.toString();
        if (!"f".equals(out)) {
            throw new RuntimeException("[oracle:anchor-visible] metamorphic violation: exact trigger should yield f lhs=" + printable(out) + " rhs=f");
        }
        checkDefensiveCopy(sb);
    }

    private static void runBoundaryCases(String prefix, String source, char pad, boolean useNullObject) {
        int[] widths = new int[] {
                Math.max(1, source.length() - 1),
                source.length(),
                Math.max(1, source.length() - 2)
        };

        for (int i = 0; i < widths.length; i++) {
            int width = widths[i];
            if (width <= 0) {
                continue;
            }
            runCase(prefix, source, width, pad, useNullObject);
        }
    }

    private static void runCase(String prefix, String source, int width, char pad, boolean useNullObject) {
        if (source == null || width <= 0) {
            return;
        }

        String effective = useNullObject ? source : source;
        if (effective.length() < width) {
            return;
        }

        StrBuilder actual = new StrBuilder(Math.max(1, prefix.length()));
        try {
            actual.append(prefix);
            if (useNullObject) {
                actual.setNullText(source);
                actual.appendFixedWidthPadRight((Object) null, width, pad);
            } else {
                actual.appendFixedWidthPadRight((Object) source, width, pad);
            }
        } catch (RuntimeException t) {
            if (isValidation(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(source, width)) {
                throw t;
            }
            return;
        }

        StrBuilder expected = new StrBuilder(prefix.length() + width);
        try {
            expected.append(prefix);
            if (source.length() >= width) {
                expected.append(source, 0, width);
            } else {
                expected.append(source);
                for (int i = source.length(); i < width; i++) {
                    expected.append(pad);
                }
            }
        } catch (RuntimeException t) {
            return;
        }

        String actualOut;
        String expectedOut;
        try {
            actualOut = actual.toString();
            expectedOut = expected.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (!actualOut.equals(expectedOut)) {
            throw new RuntimeException("[oracle:boundary-eq] metamorphic violation: fixed-width result disagrees at strLen/width boundary prefix="
                    + printable(prefix) + " src=" + printable(source) + " width=" + width
                    + " useNullObject=" + useNullObject + " lhs=" + printable(actualOut) + " rhs=" + printable(expectedOut));
        }

        if (actual.length() != prefix.length() + width) {
            throw new RuntimeException("[oracle:boundary-size] metamorphic violation: result length must equal prefix length plus width prefixLen="
                    + prefix.length() + " width=" + width + " actualLen=" + actual.length());
        }

        checkDefensiveCopy(actual);
    }

    /*
     * Contract used: toCharArray() "Copies the builder's character array into a new character array."
     * Therefore mutating the returned array must not change the builder's visible contents.
     * A throw-deleting or state-corrupting patch can leave top-level append output looking right while
     * aliasing/copy state is wrong; this independent post-condition still detects that.
     */
    private static void checkDefensiveCopy(StrBuilder sb) {
        String before;
        char[] copy;
        try {
            before = sb.toString();
            copy = sb.toCharArray();
        } catch (RuntimeException t) {
            return;
        }
        if (copy.length == 0) {
            return;
        }
        copy[0] = (char) (copy[0] == 'Z' ? 'Y' : 'Z');
        String after;
        try {
            after = sb.toString();
        } catch (RuntimeException t) {
            return;
        }
        if (!before.equals(after)) {
            throw new RuntimeException("[oracle:chararray-copy] metamorphic violation: mutating toCharArray result changed builder before="
                    + printable(before) + " after=" + printable(after));
        }
    }

    private static boolean isValidByConstruction(String source, int width) {
        return source != null && width > 0 && source.length() > width;
    }

    private static boolean isValidation(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if (!"org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                continue;
            }
            String m = e.getMethodName();
            if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String maybeExtend(String base, String suffix) {
        if (suffix == null || suffix.length() == 0) {
            return base + "Q";
        }
        return base + suffix;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\u0000", "\\0");
    }
}
