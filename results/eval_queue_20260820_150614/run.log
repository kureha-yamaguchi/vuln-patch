package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int branch = data.consumeInt(0, 2);
        if (branch == 0) {
            runValidSolveDoubleDoubleConsistency(data);
        } else if (branch == 1) {
            runPresetFieldAndRepeatability(data);
        } else {
            runExactRootEndpointCase(data);
        }
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        UnivariateRealSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, 3.0, 3.2, 3.1);
            double acc = solver.getAbsoluteAccuracy();
            if (Math.abs(result - Math.PI) > acc * 4.0 + 1e-12) {
                throw new RuntimeException(
                        "[oracle:anchor-root] metamorphic violation: exact regression input should solve sin(x)=0 near pi"
                                + " result=" + result + " expected=" + Math.PI + " acc=" + acc);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isNpeFromBisectionSolve(t)) {
                return;
            }
        }
    }

    private static void runValidSolveDoubleDoubleConsistency(FuzzedDataProvider data) {
        double expectedRoot = chooseRoot(data);
        double width = chooseWidth(data);
        double min = expectedRoot - width;
        double max = expectedRoot + width;

        BisectionSolver solver = new BisectionSolver();
        solver.f = new SinFunction();

        try {
            double reported = solver.solve(min, max);

            /*
             * Contract from BisectionSolver.solve(f,min,max): on successful termination it calls
             * setResult(m, i) and returns the same m. Therefore, after solve(min,max) succeeds,
             * the solver's cached result must equal the returned value. A band-aid patch that
             * suppresses failures but skips/changes the real solve path can violate this.
             */
            double cached = solver.getResult();
            if (Double.doubleToLongBits(reported) != Double.doubleToLongBits(cached)) {
                throw new RuntimeException(
                        "[oracle:result-cache] metamorphic violation: returned root must equal cached solver result"
                                + " min=" + min + " max=" + max
                                + " expectedRoot=" + expectedRoot
                                + " returned=" + reported + " cached=" + cached);
            }

            double tol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;
            if (Math.abs(reported - expectedRoot) > tol) {
                throw new RuntimeException(
                        "[oracle:root-window] metamorphic violation: solve(min,max) with preset real function missed known sin root"
                                + " min=" + min + " max=" + max
                                + " expectedRoot=" + expectedRoot
                                + " result=" + reported + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isNpeFromBisectionSolve(t)) {
                throw t instanceof RuntimeException ? (RuntimeException) t : new RuntimeException(t);
            }
        }
    }

    private static void runPresetFieldAndRepeatability(FuzzedDataProvider data) {
        double expectedRoot = chooseRoot(data);
        double width = chooseWidth(data);
        double min = expectedRoot - width;
        double max = expectedRoot + width;

        BisectionSolver solver1 = new BisectionSolver();
        BisectionSolver solver2 = new BisectionSolver();
        solver1.f = new SinFunction();
        solver2.f = new SinFunction();

        try {
            double r1 = solver1.solve(min, max);
            double r2 = solver2.solve(min, max);

            /*
             * Consistency check: two fresh, identically configured solvers running the same real
             * algorithm on the same real function and interval must report the same root up to
             * solver accuracy. This is a second, independent way to obtain the same quantity.
             */
            double tol = Math.max(solver1.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()) * 4.0 + 1e-12;
            if (Math.abs(r1 - r2) > tol) {
                throw new RuntimeException(
                        "[oracle:repeatable] metamorphic violation: identical solver instances disagreed on same interval"
                                + " min=" + min + " max=" + max
                                + " lhs=" + r1 + " rhs=" + r2 + " tol=" + tol);
            }

            double c1 = solver1.getResult();
            double c2 = solver2.getResult();
            if (Double.doubleToLongBits(r1) != Double.doubleToLongBits(c1)
                    || Double.doubleToLongBits(r2) != Double.doubleToLongBits(c2)) {
                throw new RuntimeException(
                        "[oracle:repeat-cache] metamorphic violation: each successful solve must cache exactly its returned root"
                                + " r1=" + r1 + " c1=" + c1
                                + " r2=" + r2 + " c2=" + c2);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isNpeFromBisectionSolve(t)) {
                throw t instanceof RuntimeException ? (RuntimeException) t : new RuntimeException(t);
            }
        }
    }

    private static void runExactRootEndpointCase(FuzzedDataProvider data) {
        double expectedRoot = chooseRoot(data);
        double width = chooseWidth(data);
        boolean putRootAtMin = data.consumeBoolean();
        double min = putRootAtMin ? expectedRoot : expectedRoot - width;
        double max = putRootAtMin ? expectedRoot + width : expectedRoot;

        BisectionSolver solver = new BisectionSolver();
        solver.f = new SinFunction();

        try {
            double result = solver.solve(min, max);

            /*
             * For a valid interval whose endpoint is itself a known zero of sin(x), the returned
             * root must still lie at that same known zero within the advertised accuracy.
             */
            double tol = solver.getAbsoluteAccuracy() * 4.0 + 1e-12;
            if (Math.abs(result - expectedRoot) > tol) {
                throw new RuntimeException(
                        "[oracle:endpoint-root] metamorphic violation: solve(min,max) drifted away from endpoint root"
                                + " min=" + min + " max=" + max
                                + " expectedRoot=" + expectedRoot
                                + " result=" + result + " tol=" + tol);
            }

            double cached = solver.getResult();
            if (Double.doubleToLongBits(result) != Double.doubleToLongBits(cached)) {
                throw new RuntimeException(
                        "[oracle:endpoint-cache] metamorphic violation: successful endpoint-root solve must cache returned value"
                                + " result=" + result + " cached=" + cached);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isNpeFromBisectionSolve(t)) {
                throw t instanceof RuntimeException ? (RuntimeException) t : new RuntimeException(t);
            }
        }
    }

    private static double chooseRoot(FuzzedDataProvider data) {
        int k = data.consumeInt(-100, 100);
        return k * Math.PI;
    }

    private static double chooseWidth(FuzzedDataProvider data) {
        int milli = data.consumeInt(1, 500);
        return milli / 1000.0;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
                || name.contains("FunctionEvaluationException")
                || name.contains("MathException")
                || name.contains("MaxIterationsExceededException");
    }

    private static boolean isNpeFromBisectionSolve(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
