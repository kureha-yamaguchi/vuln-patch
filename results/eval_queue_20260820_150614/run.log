package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callCreateNumber("1234.5", true);

        String boundaryInput = buildBoundaryInput(data);
        callCreateNumber(boundaryInput, isValidByConstruction(boundaryInput));

        String secondBoundaryInput = buildBoundaryInput(data);
        callCreateNumber(secondBoundaryInput, isValidByConstruction(secondBoundaryInput));

        /*
         * Contract/oracle:
         * For a canonical base-10 integer string within Integer range, createNumber(String)
         * first tries createInteger(str) when there is no decimal point and no exponent.
         * Therefore, for such inputs, createNumber(s) must agree with createInteger(s).
         * A patch that merely suppresses the crash but misroutes parsing would violate this.
         */
        int canonicalInt = data.consumeInt(-1_000_000, 1_000_000);
        String intString = Integer.toString(canonicalInt);
        try {
            Number parsed = NumberUtils.createNumber(intString);
            Integer direct = NumberUtils.createInteger(intString);
            if (parsed == null || direct == null || parsed.intValue() != direct.intValue() || !(parsed instanceof Integer)) {
                throw new RuntimeException("[oracle:int-create] metamorphic violation: createNumber/createInteger disagree input="
                        + intString + " lhs=" + parsed + " rhs=" + direct);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && isValidByConstruction(intString)) {
                throw e;
            }
        }

        /*
         * Contract/oracle:
         * For a decimal-less digit string with an explicit 'L' suffix and magnitude inside
         * Long range, createNumber(s + "L") must parse the same numeric value as createLong(s).
         * This follows directly from the specific-type branch in createNumber.
         */
        int longLike = data.consumeInt(-1_000_000, 1_000_000);
        String longDigits = Integer.toString(longLike);
        String longInput = longDigits + (data.consumeBoolean() ? "L" : "l");
        try {
            Number parsed = NumberUtils.createNumber(longInput);
            Long direct = NumberUtils.createLong(longDigits);
            if (parsed == null || direct == null || parsed.longValue() != direct.longValue() || !(parsed instanceof Long)) {
                throw new RuntimeException("[oracle:long-suffix] metamorphic violation: createNumber/createLong disagree input="
                        + longInput + " lhs=" + parsed + " rhs=" + direct);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && isValidByConstruction(longInput)) {
                throw e;
            }
        }

        /*
         * Contract/oracle:
         * Scientific notation with 'e' and 'E' are equivalent spellings of the same number.
         * For a valid, moderate-magnitude numeric literal constructed here, createNumber(lower)
         * and createNumber(upper) must produce the same numeric value.
         */
        String sciLower = buildValidScientific(data, false);
        String sciUpper = sciLower.replace('e', 'E');
        try {
            Number lower = NumberUtils.createNumber(sciLower);
            Number upper = NumberUtils.createNumber(sciUpper);
            if (lower != null && upper != null) {
                double dl = lower.doubleValue();
                double du = upper.doubleValue();
                if (Double.doubleToLongBits(dl) != Double.doubleToLongBits(du)) {
                    throw new RuntimeException("[oracle:exp-case] metamorphic violation: exponent case changed value inputLower="
                            + sciLower + " inputUpper=" + sciUpper + " lhs=" + lower + " rhs=" + upper);
                }
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && isValidByConstruction(sciLower) && isValidByConstruction(sciUpper)) {
                throw e;
            }
        }
    }

    private static Number callCreateNumber(String s, boolean validByConstruction) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return null;
            }
            if (validByConstruction && isRootCause(e)) {
                throw e;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)
                        || "charAt".equals(method)
                        || "substring".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildBoundaryInput(FuzzedDataProvider data) {
        String mant = nonEmptyDigits(data.consumeAsciiString(6));
        String sign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';
        int variant = data.consumeInt(0, 7);

        switch (variant) {
            case 0:
                return sign + mant + expMarker;
            case 1:
                return sign + mant + expMarker + (data.consumeBoolean() ? "+" : "-");
            case 2:
                return sign + mant + expMarker + oneDigit(data.consumeInt(0, 9));
            case 3:
                return sign + mant + expMarker + (data.consumeBoolean() ? "+" : "-") + oneDigit(data.consumeInt(0, 9));
            case 4:
                return sign + mant + "." + nonEmptyDigits(data.consumeAsciiString(6));
            case 5:
                return sign + mant + "." + nonEmptyDigits(data.consumeAsciiString(6)) + expMarker;
            case 6:
                return sign + mant + "." + nonEmptyDigits(data.consumeAsciiString(6)) + expMarker
                        + oneDigit(data.consumeInt(0, 9));
            default:
                return sign + mant + expMarker + oneDigit(data.consumeInt(0, 9))
                        + (data.consumeBoolean() ? "F" : "D");
        }
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int e = Math.max(s.indexOf('e'), s.indexOf('E'));
        if (e >= 0) {
            if (e == s.length() - 1) {
                return false;
            }
            int p = e + 1;
            if (p < s.length() && (s.charAt(p) == '+' || s.charAt(p) == '-')) {
                p++;
            }
            if (p >= s.length()) {
                return false;
            }
            char tail = s.charAt(s.length() - 1);
            if (tail == 'F' || tail == 'f' || tail == 'D' || tail == 'd' || tail == 'L' || tail == 'l') {
                if (p >= s.length() - 1) {
                    return false;
                }
            }
        }
        return true;
    }

    private static String buildValidScientific(FuzzedDataProvider data, boolean upper) {
        String sign = data.consumeBoolean() ? "-" : "";
        String intPart = nonEmptyDigits(data.consumeAsciiString(4));
        String fracPart = nonEmptyDigits(data.consumeAsciiString(4));
        String expSign = data.consumeBoolean() ? "+" : "-";
        String expDigits = Integer.toString(data.consumeInt(0, 20));
        return sign + intPart + "." + fracPart + (upper ? "E" : "e") + expSign + expDigits;
    }

    private static String nonEmptyDigits(String s) {
        if (s == null || s.length() == 0) {
            return "1";
        }
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                b.append(c);
            } else {
                b.append((char) ('0' + (c & 7)));
            }
        }
        if (b.length() == 0) {
            return "1";
        }
        return b.toString();
    }

    private static String oneDigit(int d) {
        int v = d;
        if (v < 0) {
            v = -v;
        }
        v = v % 10;
        return Character.toString((char) ('0' + v));
    }
}
