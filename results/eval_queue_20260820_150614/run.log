package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorScenario();

        int year = data.consumeInt(1995, 2030);
        int extraBefore = data.consumeInt(0, 3);
        int extraAfter = data.consumeInt(0, 3);

        TimeSeries series = new TimeSeries("FuzzSeries", "domain", "range", Day.class);
        try {
            // Keep one guaranteed gap: data at Jan 1 and Mar 1, nothing in February.
            addDay(series, 1, 1, year, 1);
            addDay(series, 1, 3, year, 2);

            // Surrounding real content to vary state while preserving the gap property.
            for (int i = 0; i < extraBefore; i++) {
                int day = data.consumeInt(1, 28);
                int month = data.consumeBoolean() ? 11 : 12;
                int y = year - 1;
                safeAdd(series, new Day(day, month, y), new Integer(data.consumeInt(-1000, 1000)));
            }
            for (int i = 0; i < extraAfter; i++) {
                int day = data.consumeInt(1, 28);
                int month = data.consumeBoolean() ? 4 : 5;
                int y = year;
                safeAdd(series, new Day(day, month, y), new Integer(data.consumeInt(-1000, 1000)));
            }

            // Valid-by-construction query: both dates exist as valid Day instances and start <= end.
            int d1 = data.consumeInt(1, 28);
            int d2 = data.consumeInt(1, 28);
            int startDay = Math.min(d1, d2);
            int endDay = Math.max(d1, d2);
            Day start = new Day(startDay, 2, year);
            Day end = new Day(endDay, 2, year);

            exerciseGapCopy(series, start, end);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        } catch (CloneNotSupportedException e) {
            // Rejection/clone failures are not findings for this harness.
        }
    }

    private static void anchorScenario() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));
            exerciseGapCopy(s, new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        } catch (CloneNotSupportedException e) {
            // Not a finding.
        }
    }

    private static void exerciseGapCopy(TimeSeries series, Day start, Day end)
            throws CloneNotSupportedException {
        if (start.compareTo(end) > 0) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException t) {
            // Valid-by-construction input: start/end are non-null Day values with start <= end.
            // If createCopy rejects this with the historical root-cause exception from the patched
            // region, surface it as an oracle violation instead of relying on the already-known
            // raw crash signature.
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "[oracle:gap-copy-valid] metamorphic violation: valid empty-range copy rejected"
                                + " start=" + start + " end=" + end + " count=" + series.getItemCount(),
                        t);
            }
            return;
        }

        if (copy == null) {
            throw new RuntimeException("[oracle:gap-copy-valid] metamorphic violation: createCopy returned null");
        }

        // Contract/invariant from the implementation shown: empty-range createCopy clones the series
        // and only replaces 'data' with a new empty list. Therefore metadata such as name and
        // timePeriodClass must be preserved on any correct implementation, even when a band-aid fix
        // merely suppresses the throw.
        if (!safeEquals(series.getKey(), copy.getKey())
                || !safeEquals(series.getDomainDescription(), copy.getDomainDescription())
                || !safeEquals(series.getRangeDescription(), copy.getRangeDescription())
                || series.getTimePeriodClass() != copy.getTimePeriodClass()) {
            throw new RuntimeException(
                    "[oracle:clone-meta] metamorphic violation: copied series lost metadata"
                            + " origKey=" + series.getKey()
                            + " copyKey=" + copy.getKey()
                            + " origTPC=" + series.getTimePeriodClass()
                            + " copyTPC=" + copy.getTimePeriodClass());
        }

        // Independent consistency check on a different reachable function:
        // after obtaining the copy, adding one Day to that copy must make getIndex(period)
        // report a valid position for the inserted period, and the object at that position must
        // be the inserted period. This cross-checks TimeSeries.getIndex against the series' own
        // observable contents via getDataItem().
        try {
            copy.add(start, new Integer(123));
            int idx = copy.getIndex(start);
            if (idx < 0 || idx >= copy.getItemCount()) {
                throw new RuntimeException(
                        "[oracle:index-after-add] consistency violation: getIndex out of bounds"
                                + " idx=" + idx + " count=" + copy.getItemCount() + " start=" + start);
            }
            TimeSeriesDataItem item = copy.getDataItem(idx);
            if (item == null || item.getPeriod() == null || item.getPeriod().compareTo(start) != 0) {
                throw new RuntimeException(
                        "[oracle:index-after-add] consistency violation: indexed item mismatch"
                                + " idx=" + idx + " item=" + item + " start=" + start);
            }
        } catch (RuntimeException t) {
            if (isValidation(t)) {
                return;
            }
            throw t;
        }
    }

    private static void addDay(TimeSeries s, int d, int m, int y, int value) {
        safeAdd(s, new Day(d, m, y), new Integer(value));
    }

    private static void safeAdd(TimeSeries s, Day day, Integer value) {
        try {
            s.add(day, value);
        } catch (RuntimeException e) {
            // Duplicate or other validation while building exploration state is not a finding.
        }
    }

    private static boolean isValidation(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls)
                    && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls)
                    && "clone".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls)
                    && "compareTo".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean safeEquals(Object a, Object b) {
        return a == b || (a != null && a.equals(b));
    }
}
