package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // - Constructor javadoc: "@throws IllegalArgumentException if p <= 0".
        //   Therefore ANY correct implementation must reject non-positive means.
        //   A patch that merely deletes or bypasses the throw would let construction succeed,
        //   which we report via [oracle:reject-neg].
        // - getMean() reports the constructor-established mean, and probability/cumulativeProbability
        //   are read-only queries. A correct implementation must not let those readers change mean;
        //   we check that via [oracle:mean-state].

        // ANCHOR: exact failing test input first.
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(-1);
            throw new RuntimeException(
                    "[oracle:reject-neg] metamorphic violation: constructor accepted non-positive mean input=-1 gotMean="
                            + dist.getMean());
        } catch (RuntimeException t) {
            if (isBuggyRootCause(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }

        // Exact positive control from the failing test.
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(10.0);
            if (dist.getMean() != 10.0) {
                throw new RuntimeException(
                        "[oracle:mean-echo] metamorphic violation: getMean must echo constructor mean input=10.0 lhs="
                                + dist.getMean() + " rhs=10.0");
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isBuggyRootCause((RuntimeException) t)) {
                throw (RuntimeException) t;
            }
            return;
        }

        // EXPLORE: many real invalid means satisfying the root-cause property p <= 0.
        double invalidMean;
        if (data.consumeBoolean()) {
            invalidMean = 0.0;
        } else {
            int magnitude = data.consumeInt(0, 1_000_000);
            int frac = data.consumeInt(0, 999);
            invalidMean = -(magnitude + (frac / 1000.0));
            if (invalidMean == 0.0) {
                invalidMean = -0.001;
            }
        }
        double epsilon = data.consumeInt(1, 1_000_000) / 1_000_000.0;
        int maxIterations = data.consumeInt(1, 100_000);

        try {
            PoissonDistribution dist = new PoissonDistributionImpl(invalidMean, epsilon, maxIterations);
            throw new RuntimeException(
                    "[oracle:reject-neg] metamorphic violation: constructor accepted non-positive mean input="
                            + invalidMean + " epsilon=" + epsilon + " maxIterations=" + maxIterations
                            + " gotMean=" + dist.getMean());
        } catch (RuntimeException t) {
            if (isBuggyRootCause(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }

        // Valid-by-construction positive input: constructor must succeed and getMean must match.
        double validMean = data.consumeInt(1, 1_000_000) + (data.consumeInt(0, 999) / 1000.0);
        double validEpsilon = data.consumeInt(1, 1_000_000) / 1_000_000.0;
        int validMaxIterations = data.consumeInt(1, 100_000);
        int x = data.consumeInt(-1000, 1000);

        PoissonDistributionImpl validDist;
        try {
            validDist = new PoissonDistributionImpl(validMean, validEpsilon, validMaxIterations);
        } catch (RuntimeException t) {
            if (isBuggyRootCause(t)) {
                throw t;
            }
            return;
        }

        if (validDist.getMean() != validMean) {
            throw new RuntimeException(
                    "[oracle:mean-echo] metamorphic violation: getMean must echo constructor mean input="
                            + validMean + " lhs=" + validDist.getMean() + " rhs=" + validMean);
        }

        double before = validDist.getMean();
        try {
            validDist.probability(x);
            validDist.cumulativeProbability(x);
        } catch (Throwable t) {
            return;
        }
        double after = validDist.getMean();
        if (before != after || after != validMean) {
            throw new RuntimeException(
                    "[oracle:mean-state] metamorphic violation: read-only probability/cumulativeProbability changed mean inputMean="
                            + validMean + " x=" + x + " before=" + before + " after=" + after);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math.exception.")
                || name.contains("NotStrictlyPositive")
                || name.contains("IllegalArgument");
    }

    private static boolean isBuggyRootCause(RuntimeException t) {
        boolean sawFactory = false;
        boolean sawCtor = false;
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.MathRuntimeException".equals(ste.getClassName())
                    && "createIllegalArgumentException".equals(ste.getMethodName())) {
                sawFactory = true;
            }
            if ("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(ste.getClassName())) {
                sawCtor = true;
            }
        }
        return sawFactory && sawCtor;
    }
}
