        try {
            expected.append(prefix);
            if (minimizeBeforeCall) {
                expected.minimizeCapacity();
            }
            /*
             * Contract used for this oracle:
             * appendFixedWidthPadRight(Object, width, padChar) appends either the
             * leftmost `width` chars of obj.toString() when the string is longer
             * than width, or the full string followed by padding when shorter.
             * We compute the same result using OTHER real StrBuilder APIs:
