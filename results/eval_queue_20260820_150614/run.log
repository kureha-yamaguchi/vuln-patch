package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final DateTimeZone LONDON = DateTimeZone.forID("Europe/London");
    private static final long TEST_TIME_NOW =
            (31L + 28L + 31L + 30L + 31L + 9L - 1L) * DateTimeConstants.MILLIS_PER_DAY;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone originalZone = DateTimeZone.getDefault();
        try {
            DateTimeUtils.setCurrentMillisFixed(TEST_TIME_NOW);
            DateTimeZone.setDefault(LONDON);

            runAnchorCases();
            runExplore(data);
        } finally {
            DateTimeZone.setDefault(originalZone);
            DateTimeUtils.setCurrentMillisSystem();
        }
    }

    private static void runAnchorCases() {
        tryLibraryCall(new MonthDay(2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 0, 1);
        tryLibraryCall(new MonthDay(2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 0, -1);
        tryLibraryCall(new MonthDay(2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 1, 1);
        tryLibraryCall(new MonthDay(2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 1, -1);
        tryLibraryCall(new MonthDay(3, 31, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 0, -1);
        tryLibraryCall(new MonthDay(3, 31, org.joda.time.chrono.ISOChronology.getInstanceUTC()), 1, -1);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int[] leapYears = new int[] {2000, 2004, 2008, 2012, 2016, 2020};
        int year = leapYears[data.consumeInt(0, leapYears.length - 1)];

        int selector = data.consumeInt(0, 5);
        LocalDate baseDate;
        int amount;
        boolean monthOp;

        switch (selector) {
            case 0:
                baseDate = new LocalDate(year, 3, 31, org.joda.time.chrono.ISOChronology.getInstanceUTC());
                amount = -1;
                monthOp = true;
                break;
            case 1:
                baseDate = new LocalDate(year, 1, 31, org.joda.time.chrono.ISOChronology.getInstanceUTC());
                amount = 1;
                monthOp = true;
                break;
            case 2:
                baseDate = new LocalDate(year, 2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC());
                amount = data.consumeBoolean() ? 1 : -1;
                monthOp = true;
                break;
            case 3:
                baseDate = new LocalDate(year, 2, 29, org.joda.time.chrono.ISOChronology.getInstanceUTC());
                amount = data.consumeBoolean() ? 1 : -1;
                monthOp = false;
                break;
            default:
                int month = data.consumeInt(1, 12);
                int maxDay = new LocalDate(year, month, 1, org.joda.time.chrono.ISOChronology.getInstanceUTC()).dayOfMonth().getMaximumValue();
                int day = data.consumeInt(1, maxDay);
                baseDate = new LocalDate(year, month, day, org.joda.time.chrono.ISOChronology.getInstanceUTC());
                amount = data.consumeInt(-24, 24);
                if (amount == 0) {
                    amount = 1;
                }
                monthOp = data.consumeBoolean();
                break;
        }

        MonthDay base = new MonthDay(baseDate.getMonthOfYear(), baseDate.getDayOfMonth(),
                org.joda.time.chrono.ISOChronology.getInstanceUTC());

        MonthDay actual;
        try {
            actual = monthOp ? base.plusMonths(amount) : base.plusDays(amount);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        LocalDate expectedDate;
        try {
            expectedDate = monthOp ? baseDate.plusMonths(amount) : baseDate.plusDays(amount);
        } catch (RuntimeException t) {
            return;
        }

        MonthDay expected = new MonthDay(expectedDate.getMonthOfYear(), expectedDate.getDayOfMonth(),
                org.joda.time.chrono.ISOChronology.getInstance());

        // Contract/oracle: MonthDay arithmetic on a valid MonthDay should agree with the same arithmetic
        // performed on a valid LocalDate in a leap year and then projected back to month/day.
        // A throw-deleting or branch-skipping patch can return a MonthDay object, but if it computes the
        // wrong wrapped partial result this equivalence breaks.
        if (actual.getMonthOfYear() != expected.getMonthOfYear() || actual.getDayOfMonth() != expected.getDayOfMonth()) {
            throw new RuntimeException(
                    "[oracle:localdate-projection] metamorphic violation: projected LocalDate arithmetic disagrees"
                            + " op=" + (monthOp ? "months" : "days")
                            + " amount=" + amount
                            + " base=" + base
                            + " actual=" + actual
                            + " expected=" + expected);
        }

        checkGetterConsistency(actual, monthOp, amount, base);
        checkRoundTripFormatting(actual);
    }

    private static void checkGetterConsistency(MonthDay actual, boolean monthOp, int amount, MonthDay base) {
        // Sound consistency checks over the object's own exposed state:
        // reported size must match the number of field types and stored values,
        // and typed/indexed/property getters must agree on the same quantity.
        int size = actual.size();
        int[] values = actual.getValues();
        DateTimeFieldType[] fieldTypes = actual.getFieldTypes();

        if (size != values.length || size != fieldTypes.length) {
            throw new RuntimeException(
