package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    private static final char TRIGGER_CHAR = 0x7f;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        assertPrintedEquals("var x ='\\x0f';", "var x=\"\\u000f\"", "\u000f");
        assertPrintedEquals("var x ='\\x68';", "var x=\"h\"", "h");
        assertPrintedEquals("var x ='\\x7f';", "var x=\"\\u007f\"", String.valueOf(TRIGGER_CHAR));

        String prefix = sanitizeSafeAscii(data.consumeAsciiString(32));
        String suffix = sanitizeSafeAscii(data.consumeAsciiString(32));
        String familyValue = prefix + TRIGGER_CHAR + suffix;
        String familyActual = printVarAssignment(familyValue);
        assertDelIsUnicodeEscaped(familyActual, "family input");

        int maxLen = data.remainingBytes();
        if (maxLen > 64) {
            maxLen = 64;
        }
        String arbitraryValue = data.consumeString(maxLen);
        String arbitraryActual = printVarAssignment(arbitraryValue);
        if (arbitraryValue.indexOf(TRIGGER_CHAR) >= 0) {
            assertDelIsUnicodeEscaped(arbitraryActual, "arbitrary input containing U+007F");
        }
    }

    private static void assertPrintedEquals(String liftedInput, String expected, String value) {
        String actual = printVarAssignment(value);
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: CodePrinter for " + liftedInput
                    + " expected [" + expected + "] but got [" + visible(actual) + "]");
        }
    }

    private static void assertDelIsUnicodeEscaped(String actual, String context) {
        if (actual.indexOf(TRIGGER_CHAR) >= 0 || actual.indexOf("\\u007f") < 0) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: " + context
                    + " should escape U+007F as \\u007f, got [" + visible(actual) + "]");
        }
    }

    private static String printVarAssignment(String value) {
        Node script = new Node(Token.SCRIPT);

        Node var = new Node(Token.VAR);
        Node name = Node.newString(Token.NAME, "x");
        Node string = Node.newString(Token.STRING, value);

        name.addChildToBack(string);
        var.addChildToBack(name);
        script.addChildToBack(var);

        String printed = new CodePrinter.Builder(script).build();
        return normalizePrintedJs(printed);
    }

    private static String normalizePrintedJs(String s) {
        int end = s.length();
        while (end > 0) {
            char c = s.charAt(end - 1);
            if (c == '\n' || c == '\r') {
                end--;
            } else {
                break;
            }
        }
        if (end > 0 && s.charAt(end - 1) == ';') {
            end--;
        }
        return s.substring(0, end);
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')) {
                sb.append(c);
            } else {
                sb.append((char) ('a' + (c % 26)));
            }
        }
        return sb.toString();
    }

    private static String visible(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 0x20 && c < 0x7f) {
                sb.append(c);
            } else {
                sb.append("\\u");
                sb.append(hex((c >>> 12) & 0xf));
                sb.append(hex((c >>> 8) & 0xf));
                sb.append(hex((c >>> 4) & 0xf));
                sb.append(hex(c & 0xf));
            }
        }
        return sb.toString();
    }

    private static char hex(int v) {
        return (char) (v < 10 ? ('0' + v) : ('a' + (v - 10)));
    }
}
