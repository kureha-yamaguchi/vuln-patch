        JSSourceFile[] seedInputs = new JSSourceFile[] {
                JSSourceFile.fromCode("seed0.js", "goog.require('x');"),
                JSSourceFile.fromCode("seed1.js", "goog.provide('x');"),
        };
        seedCompiler.compile(seedExterns, seedInputs, seedOptions);
        String[] expected = new String[] {
                "goog.provide('x');",
                "goog.require('x');",
                "",
        };
        String[] actual = seedCompiler.toSourceArray();
        if (actual == null || !Arrays.equals(actual, expected)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + Arrays.toString(expected) + " but got "
                            + (actual == null ? "null" : Arrays.toString(actual)));
