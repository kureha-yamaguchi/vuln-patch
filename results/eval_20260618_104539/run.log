                stack.push(child);
            }
        }

        if (!sawNew) {
            return;
        }
    }

    private static List<String> collectMarkedCalls(Node root) {
        List<String> actual = new ArrayList<String>();
        ArrayDeque<Node> stack = new ArrayDeque<Node>();
        stack.push(root);

        while (!stack.isEmpty()) {
            Node n = stack.pop();
            int type = n.getType();

            if (type == Token.CALL) {
                if (!NodeUtil.functionCallHasSideEffects(n)) {
                    Node callee = n.getFirstChild();
                    if (callee != null && callee.getType() == Token.NAME) {
                        actual.add(callee.getString());
