    private static List<String> analyzeMarkedCalls(String source) {
        Compiler compiler = new Compiler();
        compiler.initOptions(new CompilerOptions());

        Node externs = new Node(Token.SCRIPT);
        Node root = compiler.parseTestCode(source);

        PureFunctionIdentifier pass = new PureFunctionIdentifier(compiler);
        pass.process(externs, root);

        List<String> marked = new ArrayList<String>();
        collectMarkedCalls(root, marked);
        Collections.sort(marked);
        return marked;
    }

    private static void collectMarkedCalls(Node n, List<String> marked) {
        if (n == null) {
            return;
        }

        int type = n.getType();
        if (type == Token.CALL) {
            if (!NodeUtil.functionCallHasSideEffects(n)) {
                String name = getCallName(n);
                if (name != null) {
                    marked.add(name);
                }
            }
        } else if (type == Token.NEW) {
            if (!NodeUtil.constructorCallHasSideEffects(n)) {
                String name = getCallName(n);
                if (name != null) {
                    marked.add(name);
                }
            }
        }

        for (Node child = n.getFirstChild(); child != null; child = child.getNext()) {
            collectMarkedCalls(child, marked);
        }
    }

    private static String getCallName(Node callOrNew) {
        Node callee = callOrNew.getFirstChild();
        if (callee == null) {
            return null;
        }

        if (callee.getType() == Token.NAME || callee.getType() == Token.STRING) {
            return callee.getString();
        }

        if (callee.getType() == Token.GETPROP) {
            Node prop = callee.getLastChild();
            if (prop != null) {
                return prop.getString();
            }
        }

        return null;
    }

    private static String sanitizeIdentifier(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }

        StringBuilder out = new StringBuilder();
        char first = s.charAt(0);
        if (isIdentifierStart(first)) {
            out.append(first);
        } else {
            out.append(fallback.charAt(0));
        }

        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            if (isIdentifierPart(c)) {
                out.append(c);
            } else {
                out.append('x');
            }
        }

        if (out.length() == 0) {
            return fallback;
        }
        return out.toString();
    }

    private static boolean isIdentifierStart(char c) {
        return (c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || c == '_'
                || c == '$';
    }

    private static boolean isIdentifierPart(char c) {
        return isIdentifierStart(c) || (c >= '0' && c <= '9');
    }
}
