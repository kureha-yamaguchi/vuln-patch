package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import com.google.javascript.rhino.InputId;
import com.google.javascript.rhino.Node;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        CompilerOptions options = createCompilerOptions();
        options.setDependencyOptions(
            new DependencyOptions()
            .setDependencySorting(true));
        String[] actualSeed = compileAndCollectSources(
            options,
            new String[] {
              "goog.require('x');",
              "goog.provide('x');",
            });
        String[] expectedSeed = new String[] {
          "goog.provide('x');",
          "goog.require('x');",

          "",
        };
        if (!Arrays.equals(actualSeed, expectedSeed)) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: dependency sorting seed output differed");
        }

        String namespace = sanitizeNamespace(data.consumeString(32));
        String requirePrefix = sanitizeWhitespace(data.consumeAsciiString(16));
        String requireSuffix = sanitizeWhitespace(data.consumeAsciiString(16));
        String providePrefix = sanitizeWhitespace(data.consumeAsciiString(16));
        String provideSuffix = sanitizeWhitespace(data.consumeAsciiString(16));

        String requireSource = requirePrefix + "goog.require('" + namespace + "');" + requireSuffix;
        String provideSource = providePrefix + "goog.provide('" + namespace + "');" + provideSuffix;

        CompilerOptions familyOptions = createCompilerOptions();
        familyOptions.setDependencyOptions(
            new DependencyOptions()
            .setDependencySorting(true));
        String[] actualFamily = compileAndCollectSources(
            familyOptions,
            new String[] {
              requireSource,
              provideSource,
            });

        if (!matchesExpectedOrdering(actualFamily, provideSource, requireSource)) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: dependency sorting failed to place goog.provide before goog.require");
        }
    }

    private static CompilerOptions createCompilerOptions() {
        return new CompilerOptions();
    }

    private static String[] compileAndCollectSources(CompilerOptions options, String[] sources) {
        Compiler compiler = new Compiler();
        List<SourceFile> inputs = new ArrayList<SourceFile>();
        String[] names = new String[sources.length];
        for (int i = 0; i < sources.length; i++) {
            names[i] = "input" + i + ".js";
            inputs.add(SourceFile.fromCode(names[i], sources[i]));
        }

        compiler.compile(Collections.<SourceFile>emptyList(), inputs, options);

        Node root = compiler.getRoot();
        if (root == null) {
            return new String[0];
        }
        Node jsRoot = root.getLastChild();
        if (jsRoot == null) {
            return new String[0];
        }

        List<String> orderedSources = new ArrayList<String>();
        for (Node script = jsRoot.getFirstChild(); script != null; script = script.getNext()) {
            String name = getInputName(script);
            String code = "";
            if (name != null) {
                for (int i = 0; i < names.length; i++) {
                    if (name.equals(names[i])) {
                        code = sources[i];
                        break;
                    }
                }
            }
            orderedSources.add(code);
        }
        return orderedSources.toArray(new String[orderedSources.size()]);
    }

    private static String getInputName(Node script) {
        InputId inputId = script.getInputId();
        if (inputId != null) {
            return inputId.getIdName();
        }
        return script.getSourceFileName();
    }

    private static boolean matchesExpectedOrdering(String[] actual, String provideSource, String requireSource) {
        return actual.length == 3
            && provideSource.equals(actual[0])
            && requireSource.equals(actual[1])
            && "".equals(actual[2]);
    }

    private static String sanitizeNamespace(String raw) {
        if (raw == null || raw.length() == 0) {
            return "x";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '_'
                || c == '$') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            return "x";
        }
        char first = sb.charAt(0);
        if ((first >= '0' && first <= '9')) {
            sb.insert(0, 'x');
        }
        return sb.toString();
    }

    private static String sanitizeWhitespace(String raw) {
        if (raw == null || raw.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(raw.length());
        for (int i = 0; i < raw.length(); i++) {
