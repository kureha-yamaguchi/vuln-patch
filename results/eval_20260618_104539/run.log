package org.jfree.chart.renderer.category;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static void fail(String message) {
        throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(message);
    }

    private static void assertNotNull(Object obj, String what) {
        if (obj == null) {
            fail("semantic mismatch: " + what + " was null");
        }
    }

    private static void assertEqualsInt(int expected, int actual, String what) {
        if (expected != actual) {
            fail("semantic mismatch: " + what + " expected " + expected + " but was " + actual);
        }
    }

    private static void assertEqualsString(String expected, String actual, String what) {
        if (expected == null ? actual != null : !expected.equals(actual)) {
            fail("semantic mismatch: " + what + " expected \"" + expected + "\" but was \"" + actual + "\"");
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        AbstractCategoryItemRenderer r = new LineAndShapeRenderer();

