package org.apache.commons.math.complex;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        double nan = Double.NaN;

        Complex x = new Complex(3.0, 4.0);
        Complex z = x.add(Complex.NaN);
        if (!z.isNaN()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: x.add(Complex.NaN) should satisfy z.isNaN()"
            );
        }

        z = new Complex(1, nan);
        Complex w = x.add(z);
        if (!Double.isNaN(w.getReal())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: Double.isNaN(w.getReal()) was false for x.add(new Complex(1, nan))"
            );
        }
        if (!Double.isNaN(w.getImaginary())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: Double.isNaN(w.getImaginary()) was false for x.add(new Complex(1, nan))"
            );
        }

        double leftReal = (double) data.consumeInt();
        double leftImaginary = (double) data.consumeInt();
        double rightReal = (double) data.consumeInt();
        double rightImaginary = (double) data.consumeInt();

        boolean makeLeftNaN = data.consumeBoolean();
        boolean makeRightNaN = data.consumeBoolean();
        int leftNaNMode = data.consumeInt(0, 2);
        int rightNaNMode = data.consumeInt(0, 2);
        boolean useLeftConstantNaN = data.consumeBoolean();
        boolean useRightConstantNaN = data.consumeBoolean();

        Complex lhs;
        if (makeLeftNaN && useLeftConstantNaN) {
            lhs = Complex.NaN;
        } else {
            if (makeLeftNaN) {
                if (leftNaNMode == 0) {
                    leftReal = Double.NaN;
                } else if (leftNaNMode == 1) {
                    leftImaginary = Double.NaN;
                } else {
                    leftReal = Double.NaN;
                    leftImaginary = Double.NaN;
                }
            }
            lhs = new Complex(leftReal, leftImaginary);
        }

        Complex rhs;
        if (makeRightNaN && useRightConstantNaN) {
            rhs = Complex.NaN;
        } else {
            if (makeRightNaN) {
                if (rightNaNMode == 0) {
                    rightReal = Double.NaN;
                } else if (rightNaNMode == 1) {
                    rightImaginary = Double.NaN;
                } else {
                    rightReal = Double.NaN;
                    rightImaginary = Double.NaN;
                }
            }
            rhs = new Complex(rightReal, rightImaginary);
        }

        Complex sum = lhs.add(rhs);

        if (lhs.isNaN() || rhs.isNaN()) {
            if (!sum.isNaN()) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: add with a NaN operand should produce a NaN Complex"
                );
            }
            if (!Double.isNaN(sum.getReal())) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: add with a NaN operand should produce Double.isNaN(sum.getReal())"
                );
            }
            if (!Double.isNaN(sum.getImaginary())) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: add with a NaN operand should produce Double.isNaN(sum.getImaginary())"
                );
            }
        }
    }
}
