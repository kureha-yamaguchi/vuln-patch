package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Node seed = makeExactSeed();
        boolean seedActual = NodeUtil.evaluatesToLocalValue(seed);
        if (seedActual != false) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: NodeUtil.evaluatesToLocalValue(new x()) expected false but got true");
        }

        Node familyMember = makeFuzzedNewExpression(data, 0);
        boolean familyActual = NodeUtil.evaluatesToLocalValue(familyMember);
        if (familyActual != false) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: NodeUtil.evaluatesToLocalValue(new-expression) expected false but got true");
        }
    }

    private static Node makeExactSeed() {
        Node n = new Node(Token.NEW);
        n.addChildToBack(Node.newString(Token.NAME, "x"));
        return n;
    }

    private static Node makeFuzzedNewExpression(FuzzedDataProvider data, int depth) {
        Node n = new Node(Token.NEW);
        n.addChildToBack(makeCallee(data, depth));

        int argc = data.consumeInt(0, 4);
        for (int i = 0; i < argc; i++) {
            n.addChildToBack(makeArgument(data, depth + 1));
        }
        return n;
    }

    private static Node makeCallee(FuzzedDataProvider data, int depth) {
        if (depth < 2 && data.consumeBoolean()) {
            Node getProp = new Node(Token.GETPROP);
            getProp.addChildToBack(Node.newString(Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16))));
            getProp.addChildToBack(Node.newString(Token.STRING, sanitizeIdentifier(data.consumeAsciiString(16))));
            return getProp;
        }
        return Node.newString(Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16)));
    }

    private static Node makeArgument(FuzzedDataProvider data, int depth) {
        switch (data.consumeInt(0, 6)) {
            case 0:
                return Node.newString(Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16)));
            case 1:
                return new Node(Token.NULL);
            case 2:
                return new Node(data.consumeBoolean() ? Token.TRUE : Token.FALSE);
            case 3:
                return new Node(Token.ARRAYLIT);
            case 4:
                return new Node(Token.OBJECTLIT);
            case 5:
                if (depth < 2) {
                    return makeFuzzedNewExpression(data, depth);
                }
                return Node.newString(Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16)));
            default:
                return Node.newString(Token.STRING, data.consumeString(16));
        }
    }

    private static String sanitizeIdentifier(String s) {
        if (s == null || s.length() == 0) {
            return "x";
        }

        StringBuilder out = new StringBuilder();
        char first = s.charAt(0);
        if (isIdentifierStart(first)) {
            out.append(first);
        } else {
            out.append('x');
        }

        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            out.append(isIdentifierPart(c) ? c : '_');
        }

        return out.toString();
    }

    private static boolean isIdentifierStart(char c) {
        return (c >= 'a' && c <= 'z')
            || (c >= 'A' && c <= 'Z')
            || c == '_'
            || c == '$';
