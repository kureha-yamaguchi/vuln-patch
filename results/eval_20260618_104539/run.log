    private static List<String> analyzeMarkedCalls(String source) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();

        JSSourceFile[] externs = new JSSourceFile[] {
            JSSourceFile.fromCode("externs.js", EXTERNS)
        };
        JSSourceFile[] inputs = new JSSourceFile[] {
            JSSourceFile.fromCode("input.js", source)
        };

        compiler.compile(externs, inputs, options);

        Node root = compiler.getRoot();
        if (root == null) {
            return ImmutableList.<String>of();
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = externsRoot == null ? null : externsRoot.getNext();
        if (externsRoot == null || jsRoot == null) {
            return ImmutableList.<String>of();
        }

        new PureFunctionIdentifier.Driver(compiler).process(externsRoot, jsRoot);

        List<String> markedCalls = new ArrayList<String>();
        collectMarkedCalls(jsRoot, markedCalls);
        return markedCalls;
    }

    private static void collectMarkedCalls(Node node, List<String> out) {
        if (node == null) {
            return;
        }

        if (node.getType() == Token.CALL && !NodeUtil.functionCallHasSideEffects(node)) {
            out.add(String.valueOf(node));
        }

        for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
            collectMarkedCalls(child, out);
        }
    }

    private static String toIdentifier(String raw, String fallback) {
        if (raw == null || raw.length() == 0) {
            return fallback;
        }

        StringBuilder sb = new StringBuilder();
        char first = raw.charAt(0);
        if (isIdentifierStart(first)) {
            sb.append(first);
        } else {
            sb.append(fallback);
        }

        for (int i = 1; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (isIdentifierPart(c)) {
                sb.append(c);
            }
        }

        if (sb.length() == 0) {
            return fallback;
        }
        return sb.toString();
    }

    private static boolean isIdentifierStart(char c) {
        return (c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || c == '_'
                || c == '$';
    }

    private static boolean isIdentifierPart(char c) {
        return isIdentifierStart(c) || (c >= '0' && c <= '9');
    }

    private static String escapeJsString(String s) {
        if (s == null) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '\'') {
                sb.append('\\');
                sb.append(c);
            } else if (c == '\n') {
                sb.append("\\n");
            } else if (c == '\r') {
                sb.append("\\r");
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }
}
