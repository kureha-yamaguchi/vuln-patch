            } else if (type == Token.NEW) {
                if (!NodeUtil.constructorCallHasSideEffects(n)) {
                    Node callee = n.getFirstChild();
                    if (callee != null && callee.getType() == Token.NAME) {
                        actual.add(callee.getString());
                    }
                }
            }

            for (Node child = n.getLastChild(); child != null; child = child.getPrevious()) {
                stack.push(child);
            }
        }

        return actual;
    }

    private static String sanitizeIdentifierSuffix(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == '_'
                    || c == '$') {
                sb.append(c);
            } else {
                sb.append('_');
            }
        }
        return sb.toString();
    }
}
