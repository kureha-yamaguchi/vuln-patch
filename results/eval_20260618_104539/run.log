    private static void runExplore3D(FuzzedDataProvider data) {
        Vector3D p1 = new Vector3D(
                data.consumeInt(-50, 50),
                data.consumeInt(-50, 50),
                data.consumeInt(-50, 50));

        Vector3D d1 = consumeNonZeroVector3(data);
        int len1 = data.consumeInt(1, 10);
        int len2 = data.consumeInt(1, 10);
        int shift = data.consumeInt(-10, 10);
        int offsetScale = signedNonZero(data, 1, 10);
        boolean makeSkew = data.consumeBoolean();

        Vector3D e1 = p1.add(d1.scalarMultiply(len1));
        Vector3D offset = perpendicular3(d1);
        Vector3D p2 = p1.add(offset.scalarMultiply(offsetScale)).add(d1.scalarMultiply(shift));

        Vector3D d2;
        if (makeSkew) {
            d2 = Vector3D.crossProduct(d1, offset);
            if (d2.getNorm() == 0.0) {
                return;
            }
        } else {
            d2 = d1;
        }

        Vector3D e2 = p2.add(d2.scalarMultiply(len2));

        SubLine sub1 = new SubLine(p1, e1);
        SubLine sub2 = new SubLine(p2, e2);

        Vector3D rTrue = sub1.intersection(sub2, true);
        Vector3D rFalse = sub1.intersection(sub2, false);

        if (rTrue != null || rFalse != null) {
            throw new RuntimeException("expected null for constructed non-intersecting 3D lines");
