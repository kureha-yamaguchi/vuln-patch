public class FuzzHarness {
    private static final String SEED_SOURCE =
        "/** @constructor */ function F() {" +
        "  var self = this;" +
        "  window.setTimeout(function() {" +
        "    window.location = self.location;" +
        "  }, 0);" +
        "}" +
        "F.prototype.setLocation = function(x) {" +
        "  this.location = x;" +
        "};" +
        "(new F()).setLocation('http://www.google.com/');";

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        assertMarkedCallsMatchExpected(SEED_SOURCE);

        String ctorName = toIdentifier(data.consumeAsciiString(12), "FuzzCtor");
        String aliasName = toIdentifier(data.consumeAsciiString(12), "self");
        String methodName = toIdentifier(data.consumeAsciiString(12), "setLocation");
        String paramName = toIdentifier(data.consumeAsciiString(12), "x");
        String propName = toIdentifier(data.consumeAsciiString(12), "location");
        String sinkPropName = toIdentifier(data.consumeAsciiString(12), "location");
        String payload = jsStringLiteralContent(data.consumeString(32));
        int delay = data.consumeInt(-10, 10);

        StringBuilder source = new StringBuilder();
        source.append("/** @constructor */ function ").append(ctorName).append("() {");
        source.append("var ").append(aliasName).append(" = this;");
        if (data.consumeBoolean()) {
            source.append("var ").append(toIdentifier(data.consumeAsciiString(8), "unused")).append(" = 0;");
        }
        source.append("window.setTimeout(function() {");
        source.append("window.").append(sinkPropName).append(" = ").append(aliasName).append(".").append(propName).append(";");
        if (data.consumeBoolean()) {
            source.append("return;");
        }
        source.append("}, ").append(delay).append(");");
        source.append("}");
        source.append(ctorName).append(".prototype.").append(methodName).append(" = function(").append(paramName).append(") {");
        if (data.consumeBoolean()) {
            source.append("var ").append(toIdentifier(data.consumeAsciiString(8), "tmp")).append(" = ").append(paramName).append(";");
        }
        source.append("this.").append(propName).append(" = ").append(paramName).append(";");
        source.append("};");
        source.append("(new ").append(ctorName).append("()).").append(methodName).append("('").append(payload).append("');");

        assertMarkedCallsMatchExpected(source.toString());
    }

    private static void assertMarkedCallsMatchExpected(String source) {
        List<String> actual = getMarkedCalls(source);
        if (!actual.equals(ImmutableList.<String>of())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: checkMarkedCalls(...) returned " + actual + " instead of " +
                ImmutableList.<String>of());
        }
    }

    private static List<String> getMarkedCalls(String source) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        List<SourceFile> externs = Collections.singletonList(
            SourceFile.fromCode("externs.js", ""));
        List<SourceFile> inputs = Collections.singletonList(
            SourceFile.fromCode("input.js", source));

        compiler.init(externs, inputs, options);
        compiler.parseInputs();

        Node root = compiler.getRoot();
        if (root == null) {
            List<String> failed = new ArrayList<String>();
            failed.add("no_root");
            return failed;
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = root.getLastChild();

        new PureFunctionIdentifier.Driver(compiler).process(externsRoot, jsRoot);

        List<String> marked = new ArrayList<String>();
        collectMarkedCalls(jsRoot, marked);
        return marked;
    }

    private static void collectMarkedCalls(Node n, List<String> marked) {
        if (n == null) {
            return;
        }

        int type = n.getType();
        if (type == Token.CALL) {
            if (!NodeUtil.functionCallHasSideEffects(n)) {
                marked.add(n.toString());
            }
        } else if (type == Token.NEW) {
            if (!NodeUtil.constructorCallHasSideEffects(n)) {
                marked.add(n.toString());
            }
        }

        for (Node child = n.getFirstChild(); child != null; child = child.getNext()) {
            collectMarkedCalls(child, marked);
        }
    }

    private static String toIdentifier(String raw, String fallback) {
        StringBuilder out = new StringBuilder();
        out.append('a');
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if ((c >= 'a' && c <= 'z') ||
                    (c >= 'A' && c <= 'Z') ||
                    (c >= '0' && c <= '9') ||
                    c == '_' || c == '$') {
                    out.append(c);
                } else {
                    out.append('_');
                }
            }
        }
        if (out.length() == 1) {
            return fallback;
        }
        return out.toString();
    }

    private static String jsStringLiteralContent(String s) {
        if (s == null) {
            return "";
        }
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '\'':
                    out.append("\\'");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        out.append('_');
                    } else {
                        out.append(c);
                    }
            }
        }
        return out.toString();
    }
}
