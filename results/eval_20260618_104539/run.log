package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    private static final String SEED_EXPECTED = "alert(baz(foo(1+2)))";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = normalize(runInlineFunctions(buildProgramAst("BAR_FN", 1, 2, name("baz"))));
        String seedExpected = normalize(SEED_EXPECTED);
        if (!seedExpected.equals(seedActual)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + SEED_EXPECTED + " but got " + seedActual);
        }

        boolean sharesTriggeringProperty = data.consumeBoolean();
        String fnName = sanitizeIdentifier(data.consumeAsciiString(12), "FN");
        int left = data.consumeInt();
        int right = data.consumeInt();

        Node thirdArg;
        if (sharesTriggeringProperty) {
            String calleeName = sanitizeIdentifier(data.consumeAsciiString(12), "arg");
            thirdArg = name(calleeName);
        } else {
            thirdArg = Node.newNumber(data.consumeInt());
        }

        String familyActual = normalize(runInlineFunctions(buildProgramAst(fnName, left, right, thirdArg)));
        if (sharesTriggeringProperty && familyActual.contains(fnName)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: helper function was not inlined, output=" + familyActual);
        }
    }

    private static String runInlineFunctions(Node jsRoot) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        compiler.initOptions(options);

        Node externsRoot = new Node(Token.SCRIPT);

        InlineFunctions pass =
                new InlineFunctions(
                        compiler,
                        compiler.getUniqueNameIdSupplier(),
                        FunctionInjector.Reach.ALL,
                        false);
        pass.process(externsRoot, jsRoot);

        return compiler.toSource(jsRoot);
    }

    private static Node buildProgramAst(String fnName, int leftValue, int rightValue, Node thirdArg) {
        Node script = new Node(Token.SCRIPT);
        script.addChildToBack(buildFunction(fnName));
        script.addChildToBack(expr(call(name(fnName), Node.newNumber(leftValue), Node.newNumber(rightValue), thirdArg)));
        return script;
    }

    private static Node buildFunction(String fnName) {
        Node function = new Node(Token.FUNCTION);
        function.addChildToBack(name(fnName));

        Node params = new Node(Token.LP);
        params.addChildToBack(name("x"));
        params.addChildToBack(name("y"));
        params.addChildToBack(name("z"));
        function.addChildToBack(params);

        Node body = new Node(Token.BLOCK);
        Node sum = new Node(Token.ADD);
        sum.addChildToBack(name("x"));
        sum.addChildToBack(name("y"));

        Node fooCall = call(name("foo"), sum);
        Node zCall = call(name("z"), fooCall);

        Node ret = new Node(Token.RETURN);
        ret.addChildToBack(zCall);
        body.addChildToBack(ret);

        function.addChildToBack(body);
        return function;
    }

    private static Node expr(Node child) {
        Node expr = new Node(Token.EXPR_RESULT);
        expr.addChildToBack(child);
        return expr;
    }

    private static Node call(Node callee, Node... args) {
        Node call = new Node(Token.CALL);
        call.addChildToBack(callee);
        for (Node arg : args) {
            call.addChildToBack(arg);
        }
        return call;
    }

    private static Node name(String s) {
        return Node.newString(Token.NAME, s);
    }

    private static String sanitizeIdentifier(String raw, String prefix) {
        StringBuilder sb = new StringBuilder(prefix);
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
                    sb.append(c);
                } else if ((c >= '0' && c <= '9') || c == '_' || c == '$') {
                    if (sb.length() > prefix.length()) {
                        sb.append(c);
                    }
                }
            }
        }
        if (sb.length() == prefix.length()) {
            sb.append('x');
        }
        return sb.toString();
    }

    private static String normalize(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (!Character.isWhitespace(c) && c != ';') {
                out.append(c);
            }
        }
        return out.toString();
    }
}
