    private static String normalizeJs(String js) {
        if (js == null) {
            return null;
        }
        StringBuilder sb = new StringBuilder(js.length());
        for (int i = 0; i < js.length(); i++) {
            char c = js.charAt(i);
            if (!Character.isWhitespace(c) && c != ';') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String makeIdentifier(String raw, String fallbackPrefix) {
        StringBuilder sb = new StringBuilder(fallbackPrefix);
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = Character.toLowerCase(raw.charAt(i));
                if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '$') {
