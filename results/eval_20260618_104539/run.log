package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String SEED_INPUT =
            "var foo = function(a) { return getWindow(a); };" +
            "var bar = function(b) { return b; };" +
            "foo(bar(x));";
    private static final String SEED_EXPECTED = "getWindow(x)";
    private static final String EXTERNS = "function getWindow(a){}";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String actual = compileAndNormalize(SEED_INPUT);
        if (!SEED_EXPECTED.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + SEED_EXPECTED + " but got " + actual);
        }

        String familyInput = buildFamilyInput(data);
        try {
            compileAndNormalize(familyInput);
        } catch (Throwable ignored) {
        }
    }

    private static String compileAndNormalize(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);

        JSSourceFile externs = JSSourceFile.fromCode("externs.js", EXTERNS);
        JSSourceFile input = JSSourceFile.fromCode("input.js", js);
        compiler.compile(externs, input, options);

        return normalizeJs(compiler.toSource());
    }

    private static String normalizeJs(String js) {
        if (js == null) {
            return "";
        }
        String normalized = js.replaceAll("\\s+", "");
        while (normalized.endsWith(";")) {
            normalized = normalized.substring(0, normalized.length() - 1);
        }
        return normalized;
    }

    private static String buildFamilyInput(FuzzedDataProvider data) {
        String foo = makeIdentifier(data.consumeAsciiString(12), "foo");
        String bar = makeIdentifier(data.consumeAsciiString(12), "bar");
        String outerParam = makeIdentifier(data.consumeAsciiString(12), "a");
        String innerParam = makeIdentifier(data.consumeAsciiString(12), "b");
        String argName = makeIdentifier(data.consumeAsciiString(12), "x");

        int outerExtraParams = data.consumeInt(0, 3);
        int innerExtraParams = data.consumeInt(0, 3);
        int outerExtraArgs = data.consumeInt(0, 3);
        int innerExtraArgs = data.consumeInt(0, 3);

        StringBuilder js = new StringBuilder();

        js.append("var ").append(foo).append(" = function(").append(outerParam);
        for (int i = 0; i < outerExtraParams; i++) {
            js.append(",").append("op").append(i).append("_").append(makeIdentifier(data.consumeAsciiString(8), "p"));
        }
        js.append(") { return getWindow(").append(outerParam).append("); };");

        js.append("var ").append(bar).append(" = function(").append(innerParam);
        for (int i = 0; i < innerExtraParams; i++) {
            js.append(",").append("ip").append(i).append("_").append(makeIdentifier(data.consumeAsciiString(8), "q"));
        }
        js.append(") { return ").append(innerParam).append("; };");

        js.append(foo).append("(");
        js.append(bar).append("(").append(makeLeafExpression(data, argName));
        for (int i = 0; i < innerExtraArgs; i++) {
            js.append(",").append(makeLeafExpression(data, "ix" + i));
        }
        js.append(")");
        for (int i = 0; i < outerExtraArgs; i++) {
            js.append(",").append(makeLeafExpression(data, "ox" + i));
        }
        js.append(");");

        return js.toString();
    }

    private static String makeLeafExpression(FuzzedDataProvider data, String fallbackName) {
        switch (data.consumeInt(0, 3)) {
            case 0:
                return makeIdentifier(data.consumeAsciiString(12), fallbackName);
            case 1:
                return Integer.toString(data.consumeInt());
            case 2:
                return data.consumeBoolean() ? "true" : "false";
            default:
                return "null";
        }
    }

    private static String makeIdentifier(String raw, String fallback) {
        StringBuilder sb = new StringBuilder();
        sb.append(fallback).append("_");
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if ((c >= 'a' && c <= 'z') ||
                    (c >= 'A' && c <= 'Z') ||
                    (c >= '0' && c <= '9') ||
                    c == '_' || c == '$') {
                    sb.append(c);
                }
            }
        }
        if (!isIdentifierStart(sb.charAt(0))) {
            sb.insert(0, 'v');
        }
        return sb.toString();
    }

    private static boolean isIdentifierStart(char c) {
        return (c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || c == '_'
                || c == '$';
    }
}
