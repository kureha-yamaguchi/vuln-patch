        String[] familyActual = familyCompiler.toSourceArray();

        if (familyActual == null) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: compiler returned null output for dependency-sorted inputs");
        }

        int provideIndex = -1;
        int requireIndex = -1;
        for (int i = 0; i < familyActual.length; i++) {
            if (provideSource.equals(familyActual[i]) && provideIndex == -1) {
                provideIndex = i;
            }
            if (requireSource.equals(familyActual[i]) && requireIndex == -1) {
                requireIndex = i;
