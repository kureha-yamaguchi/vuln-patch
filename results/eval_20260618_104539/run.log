package org.apache.commons.math3.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final int N = 43130568;
        final int m = 42976365;
        final int n = 50;
        final HypergeometricDistribution seedDist = new HypergeometricDistribution(N, m, n);

        seedDist.reseedRandomGenerator(0L);
        for (int i = 0; i < 100; i++) {
            final int sample = seedDist.sample();
            if (!(0 <= sample)) {
                throw new FuzzerSecurityIssueLow("semantic mismatch: sample=" + sample + " violates 0 <= sample");
            }
            if (!(sample <= n)) {
                throw new FuzzerSecurityIssueLow("semantic mismatch: sample=" + sample + " violates sample <= n");
            }
        }

        final int seedQuantile = seedDist.inverseCumulativeProbability(0.99);
        if (!(0 <= seedQuantile)) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: inverseCumulativeProbability(0.99)=" + seedQuantile + " violates 0 <= result");
        }
        if (!(seedQuantile <= n)) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: inverseCumulativeProbability(0.99)=" + seedQuantile + " violates result <= n");
        }

        final int cases = 1 + data.consumeInt(0, 3);
        for (int i = 0; i < cases; i++) {
            final int sampleSize = data.consumeInt(1, 128);
            final int failures = data.consumeInt(1, 500000);
            final int extraSuccesses = data.consumeInt(0, 20000000);

            final int successes = sampleSize + extraSuccesses;
            final int population = successes + failures;

            if (successes <= 0 || population <= 0 || successes > population || sampleSize > population) {
                continue;
            }

            final HypergeometricDistribution dist =
                    new HypergeometricDistribution(population, successes, sampleSize);

            dist.reseedRandomGenerator(data.consumeInt());
            final int sample = dist.sample();

            final int lower = dist.getSupportLowerBound();
            final int upper = dist.getSupportUpperBound();

            final int pNumerator = data.consumeInt(500001, 999999);
            final double p = pNumerator / 1000000.0;
            final int quantile = dist.inverseCumulativeProbability(p);

            final double mu = dist.getNumericalMean();
            final double variance = dist.getNumericalVariance();
            boolean sharesTriggeringProperty = false;
            if (!Double.isInfinite(mu) && !Double.isNaN(mu)
                    && !Double.isInfinite(variance) && !Double.isNaN(variance)
                    && variance != 0.0) {
                final double sigma = Math.sqrt(variance);
                final double k = Math.sqrt((1.0 - p) / p);
                final double tmp = mu + (1.0 / k) * sigma;
                sharesTriggeringProperty = tmp > upper;
            }

            if (sharesTriggeringProperty) {
                if (sample < lower || sample > upper) {
                    throw new FuzzerSecurityIssueLow(
                            "semantic mismatch: sample=" + sample + " outside support [" + lower + ", " + upper + "]");
                }
                if (quantile < lower || quantile > upper) {
                    throw new FuzzerSecurityIssueLow(
                            "semantic mismatch: inverseCumulativeProbability(" + p + ")=" + quantile
                                    + " outside support [" + lower + ", " + upper + "]");
                }
            }
        }
    }
}
