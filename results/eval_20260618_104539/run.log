package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        StrBuilder anchor = new StrBuilder("onetwothree");
        anchor.deleteFirst("three");
        int anchorIndex = anchor.indexOf("three");
        if (anchorIndex != -1) {
            throw new RuntimeException("anchor violation: expected -1 but was " + anchorIndex);
        }

        String needle = makeNeedle(data.consumeAsciiString(24));
        String prefix = mapToAlphabet(data.consumeAsciiString(48), "XYZ");
        if (prefix.length() == 0) {
            prefix = "X";
        }
        String middle = mapToAlphabet(data.consumeAsciiString(48), "MN");
        int startIndex = data.consumeInt(-3, prefix.length() - 1);

        StrBuilder afterDeleteFirst = new StrBuilder(prefix + needle);
        afterDeleteFirst.deleteFirst(needle);

        int idx = afterDeleteFirst.indexOf(needle);
        if (idx != -1) {
            throw new RuntimeException("oracle violation after deleteFirst/indexOf(String): expected -1 but was " + idx);
        }

        int idxFromStart = afterDeleteFirst.indexOf(needle, startIndex);
        if (idxFromStart != -1) {
            throw new RuntimeException("oracle violation after deleteFirst/indexOf(String,int): expected -1 but was " + idxFromStart);
        }

        StrBuilder freshEquivalent = new StrBuilder(afterDeleteFirst.toString());
        int freshIdxFromStart = freshEquivalent.indexOf(needle, startIndex);
        if (idxFromStart != freshIdxFromStart) {
            throw new RuntimeException("metamorphic violation: equivalent StrBuilders disagree on indexOf(String,int)");
        }

        StrBuilder afterDeleteAll = new StrBuilder(prefix + needle + middle + needle);
        afterDeleteAll.deleteAll(needle);

        String expected = prefix + middle;
        if (!expected.equals(afterDeleteAll.toString())) {
            throw new RuntimeException("oracle violation after deleteAll: unexpected content");
        }

        int idxAfterDeleteAll = afterDeleteAll.indexOf(needle, 0);
        if (idxAfterDeleteAll != -1) {
            throw new RuntimeException("oracle violation after deleteAll/indexOf(String,int): expected -1 but was " + idxAfterDeleteAll);
        }
    }

    private static String makeNeedle(String raw) {
        String needle = mapToAlphabet(raw, "ab");
        while (needle.length() < 2) {
            needle += "ab";
        }
        return needle;
    }

    private static String mapToAlphabet(String input, String alphabet) {
        if (input == null || input.length() == 0) {
            return "";
        }
        StringBuilder out = new StringBuilder(input.length());
        int len = alphabet.length();
        for (int i = 0; i < input.length(); i++) {
            out.append(alphabet.charAt(input.charAt(i) % len));
        }
        return out.toString();
    }
}
