        org.apache.commons.math3.geometry.euclidean.twod.Vector2D rFalse = sub1.intersection(sub2, false);

        if (rTrue != null || rFalse != null) {
            throw new RuntimeException("expected null for constructed parallel 2D lines");
        }

        org.apache.commons.math3.geometry.euclidean.twod.Vector2D rTrueSwap = sub2.intersection(sub1, true);
        org.apache.commons.math3.geometry.euclidean.twod.Vector2D rFalseSwap = sub2.intersection(sub1, false);

        if (!samePoint2D(rTrue, rTrueSwap) || !samePoint2D(rFalse, rFalseSwap)) {
            throw new RuntimeException("metamorphic violation: 2D intersection symmetry");
        }
    }

    private static Vector3D consumeNonZeroVector3(FuzzedDataProvider data) {
        int x = data.consumeInt(-5, 5);
        int y = data.consumeInt(-5, 5);
        int z = data.consumeInt(-5, 5);
        if (x == 0 && y == 0 && z == 0) {
            x = 1;
        }
        return new Vector3D(x, y, z);
    }

    private static org.apache.commons.math3.geometry.euclidean.twod.Vector2D consumeNonZeroVector2(FuzzedDataProvider data) {
        int x = data.consumeInt(-5, 5);
        int y = data.consumeInt(-5, 5);
        if (x == 0 && y == 0) {
            x = 1;
        }
        return new org.apache.commons.math3.geometry.euclidean.twod.Vector2D(x, y);
    }

    private static int signedNonZero(FuzzedDataProvider data, int minAbs, int maxAbs) {
        int value = data.consumeInt(minAbs, maxAbs);
        return data.consumeBoolean() ? value : -value;
    }

    private static Vector3D perpendicular3(Vector3D v) {
        if (v.getX() != 0.0 || v.getY() != 0.0) {
            return new Vector3D(-v.getY(), v.getX(), 0.0);
        }
        return new Vector3D(1.0, 0.0, 0.0);
    }

    private static boolean samePoint3D(Vector3D a, Vector3D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return close(a.getX(), b.getX()) && close(a.getY(), b.getY()) && close(a.getZ(), b.getZ());
    }

    private static boolean samePoint2D(org.apache.commons.math3.geometry.euclidean.twod.Vector2D a,
                                       org.apache.commons.math3.geometry.euclidean.twod.Vector2D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return close(a.getX(), b.getX()) && close(a.getY(), b.getY());
    }

    private static boolean close(double a, double b) {
        return Math.abs(a - b) <= 1.0e-9;
    }
}
