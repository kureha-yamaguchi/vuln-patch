package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final char[] HEX = "0123456789abcdef".toCharArray();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        assertPrinted("var x ='\\x0f';", "var x=\"\\u000f\"");
        assertPrinted("var x ='\\x68';", "var x=\"h\"");
        assertPrinted("var x ='\\x7f';", "var x=\"\\u007f\"");

        int c = data.consumeInt(0, 127);
        String prefix = data.consumeAsciiString(32);
        String suffix = data.consumeAsciiString(32);

        String source =
                "var x=\"" + escapeForDoubleQuotedJsString(prefix) + hexEscape(c)
                        + escapeForDoubleQuotedJsString(suffix) + "\";";

        String actual = print(source);

        if (c == 0x7f) {
            if (actual.indexOf('\u007f') != -1 || actual.indexOf("\\u007f") == -1) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: DEL character was not unicode-escaped in printed output: "
                                + display(actual));
            }
        }
    }

    private static void assertPrinted(String source, String expected) {
        String actual = print(source);
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + display(expected) + " but got " + display(actual)
                            + " for source " + display(source));
        }
    }

    private static String print(String source) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        compiler.initOptions(options);
        com.google.javascript.rhino.Node root = compiler.parseTestCode(source);
        return new CodePrinter.Builder(root).setCompilerOptions(options).build();
    }

    private static String hexEscape(int c) {
        return "\\x" + HEX[(c >>> 4) & 0xf] + HEX[c & 0xf];
    }

    private static String escapeForDoubleQuotedJsString(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
