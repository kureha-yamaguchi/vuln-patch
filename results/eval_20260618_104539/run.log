    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        List<String> seedActual = analyzeMarkedCalls(SEED_SOURCE);
        if (!EXPECTED_MARKED_CALLS.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + EXPECTED_MARKED_CALLS + " but got " + seedActual
                            + " for source: " + SEED_SOURCE);
        }

        boolean sharesTriggeringProperty = data.consumeBoolean();
        String source;
        if (sharesTriggeringProperty) {
            source = buildTriggeredFamilySource(data);
        } else {
            source = buildNonTriggeredSource(data);
        }

        List<String> actual = analyzeMarkedCalls(source);
        if (sharesTriggeringProperty && !EXPECTED_MARKED_CALLS.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + EXPECTED_MARKED_CALLS + " but got " + actual
                            + " for source: " + source);
        }
    }

    private static List<String> analyzeMarkedCalls(String source) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();

        List<JSSourceFile> externs =
                Collections.singletonList(JSSourceFile.fromCode("externs.js", EXTERNS));
        List<JSSourceFile> inputs =
                Collections.singletonList(JSSourceFile.fromCode("input.js", source));

        compiler.init(externs, inputs, options);
        compiler.parseInputs();
        Node root = compiler.getRoot();
        if (root == null) {
            return Collections.emptyList();
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = externsRoot == null ? null : externsRoot.getNext();
        if (externsRoot == null || jsRoot == null) {
            return Collections.emptyList();
        }

        new PureFunctionIdentifier.Driver(compiler, "input.js", false).process(externsRoot, jsRoot);

        ArrayList<String> marked = new ArrayList<String>();
        collectMarkedCalls(jsRoot, marked);
        return marked;
    }

    private static void collectMarkedCalls(Node n, List<String> marked) {
        for (Node c = n.getFirstChild(); c != null; c = c.getNext()) {
            collectMarkedCalls(c, marked);
        }

        if (n.getType() == Token.NEW) {
            if (isTargetConstructor(n) && !NodeUtil.constructorCallHasSideEffects(n)) {
                marked.add("externObjSEThis");
            }
        } else if (n.getType() == Token.CALL) {
            if (isTargetMethodCall(n) && !NodeUtil.functionCallHasSideEffects(n)) {
                marked.add("NEW STRING externObjSEThisMethod");
            }
        }
    }

    private static boolean isTargetConstructor(Node n) {
        Node callee = n.getFirstChild();
        return callee != null
                && callee.getType() == Token.NAME
                && "externObjSEThis".equals(callee.getString());
    }

    private static boolean isTargetMethodCall(Node n) {
        Node callee = n.getFirstChild();
        if (callee == null || callee.getType() != Token.GETPROP) {
            return false;
        }

        Node receiver = callee.getFirstChild();
        Node prop = callee.getLastChild();
        return prop != null
                && prop.getType() == Token.STRING
                && "externObjSEThisMethod".equals(prop.getString())
                && receiver != null
                && receiver.getType() == Token.NEW
                && isTargetConstructor(receiver);
    }

    private static String buildTriggeredFamilySource(FuzzedDataProvider data) {
        String argument = jsStringLiteral(data.consumeAsciiString(32));
        int leadingNoops = data.consumeInt(0, 3);
        int outerParens = data.consumeInt(0, 3);
        int trailingSemicolons = data.consumeInt(0, 2);

        String expr = "new externObjSEThis().externObjSEThisMethod(" + argument + ")";
        for (int i = 0; i < outerParens; i++) {
            expr = "(" + expr + ")";
        }

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < leadingNoops; i++) {
            sb.append("0;");
        }
        sb.append(expr).append(";");
        for (int i = 0; i < trailingSemicolons; i++) {
            sb.append(";");
        }
        return sb.toString();
    }

    private static String buildNonTriggeredSource(FuzzedDataProvider data) {
        String argument = jsStringLiteral(data.consumeAsciiString(32));
        switch (data.consumeInt(0, 4)) {
            case 0:
                return "new externObjSEThis();";
            case 1:
                return "externObjSEThis.prototype.externObjSEThisMethod(" + argument + ");";
            case 2:
                return "new externObjSEThis().toString();";
            case 3:
                return "externObjSEThis();";
            default:
                return "0;";
        }
    }

    private static String jsStringLiteral(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('\'');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '\'':
                    sb.append("\\'");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                case '\b':
                    sb.append("\\b");
                    break;
                case '\f':
                    sb.append("\\f");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        sb.append("\\x");
                        String hex = Integer.toHexString(ch & 0xff).toUpperCase();
                        if (hex.length() < 2) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
                    break;
            }
        }
        sb.append('\'');
        return sb.toString();
    }
}
