            .append("=function(").append(paramName).append("){")
            .append("this.").append(propName).append("=").append(paramName).append(";")
            .append("};");
        source.append("(new ").append(ctorName).append("(").append(newArgs).append(")).")
            .append(methodName).append("('").append(payload).append("');");
        return source.toString();
    }

    private static String toIdentifier(String raw, String fallback) {
        if (raw == null || raw.length() == 0) {
            return fallback;
        }
        StringBuilder out = new StringBuilder();
        out.append('a');
        for (int i = 0; i < raw.length(); i++) {
