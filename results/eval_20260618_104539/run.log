    private static boolean familySharesTriggeringProperty(String js) {
        return js.contains("return ") &&
               js.contains("goog$component$DomServices.get(") &&
               js.contains(".getDomHelper().getWindow()") &&
               js.contains("new goog.Uri(") &&
