            boolean isDigit = c >= '0' && c <= '9';
            if (symbolBuilder.length() == 0) {
                if (isLetter || c == '_' || c == '$') {
                    symbolBuilder.append(c);
                }
            } else {
                if (isLetter || isDigit || c == '_' || c == '$') {
                    symbolBuilder.append(c);
                }
            }
        }
        if (symbolBuilder.length() == 0) {
            symbolBuilder.append('x');
        }
        String symbol = symbolBuilder.toString();

        String requireSource = "goog.require('" + symbol + "');";
        String provideSource = "goog.provide('" + symbol + "');";

        int fillerCount = data.consumeInt(0, 3);
        JSSourceFile[] familyInputs = new JSSourceFile[2 + fillerCount];
        familyInputs[0] = JSSourceFile.fromCode("family_require.js", requireSource);
        familyInputs[1] = JSSourceFile.fromCode("family_provide.js", provideSource);
        for (int i = 0; i < fillerCount; i++) {
            String fillerName = "f" + i;
            familyInputs[2 + i] = JSSourceFile.fromCode(
                    "family_filler_" + i + ".js",
                    "var " + fillerName + " = " + data.consumeInt() + ";");
