        StringBuilder sb = new StringBuilder(s.length() + 8);
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '\'') {
                sb.append('\\').append(c);
            } else if (c >= 0x20 && c <= 0x7e) {
                sb.append(c);
            } else {
                sb.append('_');
            }
        }
        return sb.toString();
    }

    private static String safeCommentText(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == '_') {
                sb.append(c);
            } else {
                sb.append('_');
            }
        }
        return sb.toString();
    }

    private static ImmutableList<String> getMarkedCalls(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();

        JSSourceFile externs = JSSourceFile.fromCode(
                "externs.js",
                "var window; window.setTimeout = function(a,b) {}; window.location = '';");
        JSSourceFile input = JSSourceFile.fromCode("input.js", js);

        compiler.init(ImmutableList.of(externs), ImmutableList.of(input), options);
        compiler.parseInputs();

        Node root = compiler.getRoot();
        if (root == null) {
            return ImmutableList.of("null-root");
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = root.getLastChild();
        if (externsRoot == null || jsRoot == null) {
            return ImmutableList.of("missing-roots");
        }

        new PureFunctionIdentifier.Driver(compiler, null, false).process(externsRoot, jsRoot);

        ImmutableList.Builder<String> marked = ImmutableList.builder();
        ArrayDeque<Node> stack = new ArrayDeque<Node>();
        stack.push(jsRoot);

        while (!stack.isEmpty()) {
            Node n = stack.pop();

            if (n.getType() == Token.NEW) {
