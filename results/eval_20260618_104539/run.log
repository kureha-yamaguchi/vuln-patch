import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static final String[] ANCHORS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (String anchor : ANCHORS) {
            String escaped = StringEscapeUtils.escapeCsv(anchor);
            if (!anchor.equals(escaped)) {
                throw new RuntimeException("anchor mismatch");
            }
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!anchor.equals(roundTrip)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x");
            }
        }

        String candidateA = buildCandidate(data, false);
        String candidateB = buildCandidate(data, true);
        String candidateC = buildSupplementaries(data, data.consumeInt(1, 3)) + data.consumeAsciiString(12);
        String candidateD = data.consumeAsciiString(12) + buildSupplementaries(data, data.consumeInt(1, 3));

        exercise(candidateA);
        exercise(candidateB);
        exercise(candidateC);
        exercise(candidateD);
    }

    private static void exercise(String input) {
        String escaped = StringEscapeUtils.escapeCsv(input);
        String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
        if (!input.equals(roundTrip)) {
            throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x");
        }
    }

    private static String buildCandidate(FuzzedDataProvider data, boolean forceCsvSpecial) {
        StringBuilder sb = new StringBuilder();

        String prefix = data.consumeAsciiString(12);
        String middle = data.consumeAsciiString(12);
        String suffix = data.consumeAsciiString(12);

        int placement = data.consumeInt(0, 2);
        int supplementaryCount = data.consumeInt(1, 4);

        if (placement == 0) {
            sb.append(buildSupplementaries(data, supplementaryCount));
        }
        sb.append(prefix);

        if (forceCsvSpecial || data.consumeBoolean()) {
            sb.append(pickCsvSpecial(data));
        }

        if (placement == 1) {
            sb.append(buildSupplementaries(data, supplementaryCount));
        }
        sb.append(middle);

        if (!forceCsvSpecial && data.consumeBoolean()) {
            sb.append(pickCsvSpecial(data));
        }

        if (placement == 2) {
            sb.append(buildSupplementaries(data, supplementaryCount));
        }
        sb.append(suffix);

        if (sb.length() == 0) {
            sb.append(buildSupplementary(data));
        }

        return sb.toString();
    }

    private static String buildSupplementaries(FuzzedDataProvider data, int count) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < count; i++) {
            if (data.consumeBoolean()) {
                sb.append(data.consumeAsciiString(6));
            }
            sb.append(buildSupplementary(data));
            if (data.consumeBoolean()) {
                sb.append(data.consumeAsciiString(6));
            }
        }
        return sb.toString();
    }

    private static String buildSupplementary(FuzzedDataProvider data) {
        int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x100000);
        return new String(Character.toChars(cp));
    }

    private static String pickCsvSpecial(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 4)) {
            case 0:
                return ",";
            case 1:
                return "\"";
            case 2:
                return "\r";
            case 3:
                return "\n";
            default:
                return ",\"\r\n";
        }
    }
}
