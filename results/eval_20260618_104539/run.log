package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        com.google.javascript.jscomp.CompilerOptions seedOptions =
                new com.google.javascript.jscomp.CompilerOptions();
        com.google.javascript.jscomp.Compiler seedCompiler =
                new com.google.javascript.jscomp.Compiler();
        seedCompiler.initOptions(seedOptions);

        String seedSource = "var x ='\\x7f';";
        String expectedSeed = "var x=\"\\u007f\"";
        com.google.javascript.rhino.Node seedAst = seedCompiler.parseTestCode(seedSource);
        String actualSeed = seedCompiler.toSource(seedAst);
        if (!expectedSeed.equals(actualSeed)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: seed output differed, expected "
                            + expectedSeed + " but got " + actualSeed);
        }

        String prefix = data.consumeString(32);
        String suffix = data.consumeString(32);
        String hex = "0123456789abcdef";
        StringBuilder literal = new StringBuilder(prefix.length() + suffix.length() + 16);
        String[] parts = new String[] {prefix, suffix};

        for (int partIndex = 0; partIndex < parts.length; partIndex++) {
            String part = parts[partIndex];
            for (int i = 0; i < part.length(); i++) {
                char ch = part.charAt(i);
                switch (ch) {
                    case '\\':
                        literal.append("\\\\");
                        break;
                    case '\'':
                        literal.append("\\'");
                        break;
                    case '\n':
                        literal.append("\\n");
                        break;
                    case '\r':
                        literal.append("\\r");
                        break;
                    case '\t':
                        literal.append("\\t");
                        break;
                    case '\b':
                        literal.append("\\b");
                        break;
                    case '\f':
                        literal.append("\\f");
                        break;
                    default:
                        if (ch < 0x20 || ch == 0x7f || ch > 0x7e) {
                            literal.append("\\u")
                                    .append(hex.charAt((ch >>> 12) & 0xf))
                                    .append(hex.charAt((ch >>> 8) & 0xf))
                                    .append(hex.charAt((ch >>> 4) & 0xf))
                                    .append(hex.charAt(ch & 0xf));
                        } else {
                            literal.append(ch);
                        }
                        break;
                }
            }
            if (partIndex == 0) {
                literal.append("\\x7f");
            }
        }

        String familySource = "var x ='" + literal.toString() + "';";
        com.google.javascript.jscomp.CompilerOptions familyOptions =
                new com.google.javascript.jscomp.CompilerOptions();
        com.google.javascript.jscomp.Compiler familyCompiler =
                new com.google.javascript.jscomp.Compiler();
        familyCompiler.initOptions(familyOptions);
        com.google.javascript.rhino.Node familyAst = familyCompiler.parseTestCode(familySource);
        String actualFamily = familyCompiler.toSource(familyAst);

        if (actualFamily.indexOf('\u007f') != -1 || actualFamily.indexOf("\\u007f") == -1) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: DEL character was not unicode-escaped in printed output: "
                            + actualFamily);
        }
    }
}
