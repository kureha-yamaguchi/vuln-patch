package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    private static final String[] SEED_INPUTS = new String[] {
        "goog.require('x');",
        "goog.provide('x');",
    };

    private static final String[] SEED_EXPECTED = new String[] {
        "goog.provide('x');",
        "goog.require('x');",
        "",
    };

    private static boolean seedChecked;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        if (!seedChecked) {
            String[] seedActual = compileToSourceArray(SEED_INPUTS);
            if (!Arrays.equals(SEED_EXPECTED, seedActual)) {
                throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + Arrays.toString(SEED_EXPECTED)
                        + " but got " + Arrays.toString(seedActual));
            }
            seedChecked = true;
        }

        String namespace = buildNamespace(data);
        String require = "goog.require('" + namespace + "');";
        String provide = "goog.provide('" + namespace + "');";

        List<String> sources = new ArrayList<String>();
        String extra = buildExtraSource(data);
        int extraPosition = data.consumeInt(0, 3);
        if (extraPosition == 1) {
            sources.add(extra);
        }
        sources.add(require);
        if (extraPosition == 2) {
            sources.add(extra);
        }
        sources.add(provide);
        if (extraPosition == 3) {
            sources.add(extra);
        }

        String[] actual = compileToSourceArray(sources.toArray(new String[sources.size()]));
        int provideIndex = indexOf(actual, provide);
        int requireIndex = indexOf(actual, require);
        if (provideIndex == -1 || requireIndex == -1 || provideIndex > requireIndex) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: dependency sorting did not place provider before requirer: "
                    + Arrays.toString(actual));
        }

        if (data.remainingBytes() > 0) {
            String arbitrary1 = data.consumeString(Math.min(32, data.remainingBytes()));
            String arbitrary2 = data.consumeRemainingAsString();
            compileOnly(new String[] { arbitrary1, arbitrary2 });
        }
    }

    private static CompilerOptions newOptions() {
        CompilerOptions options = new CompilerOptions();
        options.setClosurePass(false);
        options.setDependencyOptions(
            new DependencyOptions()
                .setDependencySorting(true));
        return options;
    }

    private static String[] compileToSourceArray(String[] sources) {
        Compiler compiler = new Compiler();
        List<SourceFile> externs = Collections.emptyList();
        List<SourceFile> inputs = new ArrayList<SourceFile>(sources.length);
        for (int i = 0; i < sources.length; i++) {
            inputs.add(SourceFile.fromCode("input" + i + ".js", sources[i]));
        }
        compiler.compile(externs, inputs, newOptions());
        return compiler.toSourceArray();
    }

    private static void compileOnly(String[] sources) {
        Compiler compiler = new Compiler();
        List<SourceFile> externs = Collections.emptyList();
        List<SourceFile> inputs = new ArrayList<SourceFile>(sources.length);
        for (int i = 0; i < sources.length; i++) {
            inputs.add(SourceFile.fromCode("extra" + i + ".js", sources[i]));
        }
        compiler.compile(externs, inputs, newOptions());
    }

    private static int indexOf(String[] values, String target) {
        if (values == null) {
            return -1;
        }
