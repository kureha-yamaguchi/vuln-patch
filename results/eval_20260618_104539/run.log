package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    private static final char DEL = 0x7f;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final String liftedInput = "var x ='\\x7f';";
        final String expected = "var x=\"\\u007f\"";

        String actual = printVarAssignmentString(String.valueOf(DEL));
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: for " + liftedInput + " expected "
                    + quoteForMessage(expected) + " but got " + quoteForMessage(actual));
        }

        String arbitrary = data.consumeString(32);
        printVarAssignmentString(arbitrary);

        int repeat = data.consumeInt(1, 4);
        String prefix = data.consumeString(16);
        String middle = data.consumeString(16);
        boolean[] before = new boolean[repeat];
        boolean[] after = new boolean[repeat];
        for (int i = 0; i < repeat; i++) {
            before[i] = data.consumeBoolean();
            after[i] = data.consumeBoolean();
        }
        String suffix = data.consumeRemainingAsString();

        StringBuilder familyValue = new StringBuilder();
        familyValue.append(prefix);
        for (int i = 0; i < repeat; i++) {
            if (before[i]) {
                familyValue.append(middle);
            }
            familyValue.append(DEL);
            if (after[i]) {
                familyValue.append(middle);
            }
        }
        familyValue.append(suffix);

        String familyActual = printVarAssignmentString(familyValue.toString());
        if (familyActual.indexOf(DEL) != -1) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: DEL character should be escaped, but printer emitted raw U+007F in "
                    + quoteForMessage(familyActual));
        }
    }

    private static String printVarAssignmentString(String value) {
        Node script = new Node(Token.SCRIPT);
        Node var = new Node(Token.VAR);
        Node name = Node.newString(Token.NAME, "x");
        name.addChildToBack(Node.newString(Token.STRING, value));
        var.addChildToBack(name);
        script.addChildToBack(var);
        return new CodePrinter.Builder(script).build();
    }

    private static String quoteForMessage(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder out = new StringBuilder(s.length() + 2);
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c == 0x7f) {
                        appendUnicodeEscape(out, c);
                    } else {
                        out.append(c);
                    }
                    break;
            }
        }
        out.append('"');
        return out.toString();
    }

    private static void appendUnicodeEscape(StringBuilder out, char c) {
        out.append("\\u");
        String hex = Integer.toHexString(c);
        for (int i = hex.length(); i < 4; i++) {
            out.append('0');
        }
        out.append(hex);
    }
