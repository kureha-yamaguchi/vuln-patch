package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String SEED_INPUT = "function f(a){return a.x=2}f(o)";
    private static final String EXPECTED = "o.x=2";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = normalizeJs(runCompiler(SEED_INPUT));
        if (!EXPECTED.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: expected " + EXPECTED + " but got " + abbreviate(seedActual));
        }

        String familyInput = buildFamilyInput(data);
        String familyActual = normalizeJs(runCompiler(familyInput));
        if (!EXPECTED.equals(familyActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: expected " + EXPECTED + " for family input but got "
                    + abbreviate(familyActual) + " from " + abbreviate(normalizeJs(familyInput)));
        }

        String exploratoryInput = buildExploratoryInput(data);
        runCompiler(exploratoryInput);
    }

    private static String runCompiler(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);

        compiler.compile(
            java.util.Collections.singletonList(SourceFile.fromCode("externs.js", "")),
            java.util.Collections.singletonList(SourceFile.fromCode("input.js", js)),
            options);

        String out = compiler.toSource();
        return out == null ? "" : out;
    }

    private static String buildFamilyInput(FuzzedDataProvider data) {
        String functionName = makeIdentifier("f", data.consumeAsciiString(12));
        String paramName = makeIdentifier("p", data.consumeAsciiString(12));

        int extraParams = data.consumeInt(0, 3);
        int extraArgsWithoutParams = data.consumeInt(0, 2);

        StringBuilder js = new StringBuilder();
