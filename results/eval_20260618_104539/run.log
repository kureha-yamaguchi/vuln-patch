import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedSource = "var x ='\\x7f';";
        String expectedSeed = "var x=\"\\u007f\"";

        Compiler seedCompiler = new Compiler();
        seedCompiler.initOptions(new CompilerOptions());
        com.google.javascript.rhino.Node seedRoot = seedCompiler.parseTestCode(seedSource);
        String seedActual = new CodePrinter.Builder(seedRoot).build();
        if (!expectedSeed.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + expectedSeed + " but got " + seedActual);
        }

        String raw = data.consumeAsciiString(32);
        int insertPos = raw.length() == 0 ? 0 : data.consumeInt(0, raw.length());

        StringBuilder familySourceBuilder = new StringBuilder("var x='");
        for (int i = 0; i <= raw.length(); i++) {
            if (i == insertPos) {
                familySourceBuilder.append("\\x7f");
            }
            if (i == raw.length()) {
                break;
            }

            char ch = raw.charAt(i);
            switch (ch) {
                case '\\':
                    familySourceBuilder.append("\\\\");
                    break;
                case '\'':
                    familySourceBuilder.append("\\'");
                    break;
                case '\n':
                    familySourceBuilder.append("\\n");
                    break;
                case '\r':
                    familySourceBuilder.append("\\r");
                    break;
                case '\t':
                    familySourceBuilder.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch == 0x7f) {
                        String hex = Integer.toHexString(ch);
                        while (hex.length() < 4) {
                            hex = "0" + hex;
                        }
                        familySourceBuilder.append("\\u").append(hex);
                    } else {
                        familySourceBuilder.append(ch);
                    }
                    break;
            }
        }
        familySourceBuilder.append("';");
        String familySource = familySourceBuilder.toString();

        Compiler familyCompiler = new Compiler();
        familyCompiler.initOptions(new CompilerOptions());
        com.google.javascript.rhino.Node familyRoot = familyCompiler.parseTestCode(familySource);
        String familyActual = new CodePrinter.Builder(familyRoot).build();

        if (familyActual.indexOf("\\u007f") < 0 || familyActual.indexOf('\u007f') >= 0) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: DEL character was not unicode-escaped in " + familyActual);
        }
    }
}
