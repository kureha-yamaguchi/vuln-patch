    private static void assertNewIsNotLocal(Node newNode, String what) {
        boolean actualDefault = NodeUtil.evaluatesToLocalValue(newNode);
        if (actualDefault != false) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: " + what
                    + " expected evaluatesToLocalValue(...) == false but got true");
        }

        boolean actualAlwaysFalse =
            NodeUtil.evaluatesToLocalValue(newNode, Predicates.<Node>alwaysFalse());
        if (actualAlwaysFalse != false) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: " + what
                    + " expected evaluatesToLocalValue(..., alwaysFalse()) == false but got true");
        }

        boolean actualAlwaysTrue =
            NodeUtil.evaluatesToLocalValue(newNode, Predicates.<Node>alwaysTrue());
        if (actualAlwaysTrue != false) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: " + what
                    + " expected evaluatesToLocalValue(..., alwaysTrue()) == false but got true");
        }
    }

    private static Node buildNewNode(String ctorName, int argCount, FuzzedDataProvider data, int depth) {
        Node n = new Node(Token.NEW);
        n.addChildToBack(buildCallee(ctorName, data));
        for (int i = 0; i < argCount; i++) {
            n.addChildToBack(buildArgument(data, depth + 1));
        }
        return n;
    }

    private static Node buildCallee(String ctorName, FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            return Node.newString(Token.NAME, ctorName);
