        assertNewIsNotLocal(seedNew, "seed new A");

        if (data.consumeBoolean()) {
            String ctorName = sanitizeIdentifier(data.consumeAsciiString(24), "A");
            int argCount = data.consumeInt(0, 4);
            Node fuzzedNew = buildNewNode(ctorName, argCount, data, 0);
            assertNewIsNotLocal(fuzzedNew, "fuzzed new-expression");
        } else {
