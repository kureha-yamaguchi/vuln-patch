        definitions.process(externs, root);

        PureFunctionIdentifier pass = new PureFunctionIdentifier(compiler, definitions);
        pass.process(externs, root);

        List<String> marked = new ArrayList<String>();
        collectMarkedCalls(root, marked);
        Collections.sort(marked);
        return marked;
    }

    private static void collectMarkedCalls(Node n, List<String> marked) {
        if (n == null) {
            return;
        }

        int type = n.getType();
        if (type == Token.CALL) {
            if (!NodeUtil.functionCallHasSideEffects(n)) {
                String name = getCallName(n);
                if (name != null) {
                    marked.add(name);
                }
            }
        } else if (type == Token.NEW) {
            if (!NodeUtil.constructorCallHasSideEffects(n)) {
                String name = getCallName(n);
                if (name != null) {
                    marked.add(name);
                }
            }
        }

        for (Node child = n.getFirstChild(); child != null; child = child.getNext()) {
            collectMarkedCalls(child, marked);
        }
    }

