    private static String compileWithInlineFunctions(String js) throws Exception {
        Object compiler = newInstance("com.google.javascript.jscomp.Compiler");
        Object options = newInstance("com.google.javascript.jscomp.CompilerOptions");
        Object extern = newSourceFile("externs.js", "");
        Object input = newSourceFile("input.js", js);

        invokeCompatible(compiler, "init",
            Collections.singletonList(extern),
            Collections.singletonList(input),
            options);

        Object parsed = invokeCompatibleIfPresent(compiler, "parseInputs");
        Node root = parsed instanceof Node ? (Node) parsed : (Node) invokeCompatibleIfPresent(compiler, "getRoot");

        Node externsRoot = (Node) invokeCompatibleIfPresent(compiler, "getExternsRoot");
        Node jsRoot = (Node) invokeCompatibleIfPresent(compiler, "getJsRoot");

        if ((externsRoot == null || jsRoot == null) && root != null) {
            externsRoot = root.getFirstChild();
            jsRoot = root.getLastChild();
        }

        if (externsRoot == null || jsRoot == null) {
            return null;
        }

        runPassIfPossible("com.google.javascript.jscomp.Normalize", compiler, externsRoot, jsRoot, null, false);

        Supplier<String> nameSupplier = new Supplier<String>() {
            private int nextId = 0;
            @Override
            public String get() {
                return String.valueOf(nextId++);
            }
        };

        for (int i = 0; i < 6; i++) {
            runPassIfPossible("com.google.javascript.jscomp.InlineFunctions", compiler, externsRoot, jsRoot, nameSupplier, true);
        }

        Object out = invokeCompatibleIfPresent(compiler, "toSource");
        if (out instanceof String) {
            return (String) out;
        }

        out = invokeCompatibleIfPresent(compiler, "toSource", jsRoot);
        return out instanceof String ? (String) out : null;
    }

    private static void runPassIfPossible(
        String className, Object compiler, Node externsRoot, Node jsRoot,
        Supplier<String> supplier, boolean booleanValue) throws Exception {

        Class<?> passClass;
        try {
            passClass = Class.forName(className);
        } catch (ClassNotFoundException e) {
            return;
        }

        Constructor<?> chosen = null;
        Object[] chosenArgs = null;

        for (Constructor<?> ctor : passClass.getDeclaredConstructors()) {
            Class<?>[] types = ctor.getParameterTypes();
            Object[] args = new Object[types.length];
            boolean usedCompiler = false;
            boolean usedSupplier = false;
            boolean ok = true;

            for (int i = 0; i < types.length; i++) {
                Class<?> t = wrap(types[i]);
                if (!usedCompiler && t.isAssignableFrom(compiler.getClass())) {
                    args[i] = compiler;
                    usedCompiler = true;
                } else if (!usedCompiler &&
                           ("com.google.javascript.jscomp.AbstractCompiler".equals(t.getName())
                            || "com.google.javascript.jscomp.Compiler".equals(t.getName())
                            || t.isAssignableFrom(compiler.getClass()))) {
                    args[i] = compiler;
                    usedCompiler = true;
                } else if (supplier != null &&
                           !usedSupplier &&
                           "com.google.common.base.Supplier".equals(t.getName())) {
                    args[i] = supplier;
                    usedSupplier = true;
                } else if (t == Boolean.class) {
                    args[i] = Boolean.valueOf(booleanValue);
                } else {
                    ok = false;
                    break;
                }
            }

            if (ok && usedCompiler && (supplier == null || usedSupplier)) {
                if (chosen == null || ctor.getParameterTypes().length > chosen.getParameterTypes().length) {
                    chosen = ctor;
                    chosenArgs = args;
                }
            }
        }

        if (chosen == null) {
            return;
        }

        chosen.setAccessible(true);
        Object pass = chosen.newInstance(chosenArgs);
        invokeCompatible(pass, "process", externsRoot, jsRoot);
    }

    private static Object newSourceFile(String name, String code) throws Exception {
        for (String className : new String[] {
                "com.google.javascript.jscomp.SourceFile",
                "com.google.javascript.jscomp.JSSourceFile"}) {
            try {
                Class<?> cls = Class.forName(className);
                Method m = cls.getMethod("fromCode", String.class, String.class);
                return m.invoke(null, name, code);
            } catch (ClassNotFoundException e) {
                // Try next class name.
            }
        }
        throw new ClassNotFoundException("No SourceFile/JSSourceFile class available");
    }

    private static Object newInstance(String className) throws Exception {
        Class<?> cls = Class.forName(className);
        Constructor<?> ctor = cls.getDeclaredConstructor();
        ctor.setAccessible(true);
        return ctor.newInstance();
    }

    private static Object invokeCompatibleIfPresent(Object target, String name, Object... args) throws Exception {
        Method m = findCompatibleMethod(target.getClass(), name, args);
        if (m == null) {
            return null;
        }
        m.setAccessible(true);
        return m.invoke(target, args);
    }

    private static Object invokeCompatible(Object target, String name, Object... args) throws Exception {
        Method m = findCompatibleMethod(target.getClass(), name, args);
        if (m == null) {
            throw new NoSuchMethodException(target.getClass().getName() + "." + name);
        }
        m.setAccessible(true);
        return m.invoke(target, args);
    }

    private static Method findCompatibleMethod(Class<?> cls, String name, Object... args) {
        for (Class<?> c = cls; c != null; c = c.getSuperclass()) {
            Method[] methods = c.getDeclaredMethods();
            for (Method m : methods) {
                if (!m.getName().equals(name)) {
                    continue;
                }
                Class<?>[] params = m.getParameterTypes();
                if (params.length != args.length) {
                    continue;
                }
                boolean ok = true;
                for (int i = 0; i < params.length; i++) {
                    if (!isAssignable(params[i], args[i])) {
                        ok = false;
                        break;
                    }
                }
                if (ok) {
                    return m;
                }
            }
        }
        for (Method m : cls.getMethods()) {
            if (!m.getName().equals(name)) {
                continue;
            }
            Class<?>[] params = m.getParameterTypes();
            if (params.length != args.length) {
                continue;
            }
            boolean ok = true;
            for (int i = 0; i < params.length; i++) {
                if (!isAssignable(params[i], args[i])) {
                    ok = false;
                    break;
                }
            }
            if (ok) {
                return m;
            }
        }
        return null;
    }

    private static boolean isAssignable(Class<?> paramType, Object arg) {
        if (arg == null) {
            return !paramType.isPrimitive();
        }
        return wrap(paramType).isAssignableFrom(arg.getClass());
    }

    private static Class<?> wrap(Class<?> c) {
        if (!c.isPrimitive()) {
            return c;
        }
        if (c == boolean.class) {
            return Boolean.class;
        }
        if (c == byte.class) {
            return Byte.class;
        }
        if (c == short.class) {
            return Short.class;
        }
        if (c == int.class) {
            return Integer.class;
        }
        if (c == long.class) {
            return Long.class;
        }
        if (c == float.class) {
            return Float.class;
        }
        if (c == double.class) {
            return Double.class;
        }
        if (c == char.class) {
            return Character.class;
        }
        return c;
    }

    private static String ident(String raw, String prefix) {
        StringBuilder sb = new StringBuilder(prefix);
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char ch = raw.charAt(i);
                if ((ch >= 'a' && ch <= 'z') ||
                    (ch >= 'A' && ch <= 'Z') ||
                    (ch >= '0' && ch <= '9') ||
                    ch == '_' || ch == '$') {
                    sb.append(ch);
                } else {
                    sb.append('_');
                }
            }
        }
        return sb.toString();
    }

    private static String normalizeJs(String s) {
        if (s == null) {
            return "";
        }
        String normalized = s.replaceAll("\\s+", " ").trim();
        while (normalized.endsWith(";")) {
            normalized = normalized.substring(0, normalized.length() - 1).trim();
        }
        return normalized;
    }
}
