        }

        if (callee.getType() == Token.NAME || callee.getType() == Token.STRING) {
            return callee.getString();
        }

        if (callee.getType() == Token.GETPROP) {
            Node prop = callee.getLastChild();
            if (prop != null) {
                return prop.getString();
            }
        }

        return null;
    }

