            + "externObjSEThis.prototype.externObjSEThisMethod = function(x) {};\n";

    private static final String SEED_JS =
        "function f() {"
            + "  new externObjSEThis().externObjSEThisMethod('') "
            + "};"
            + "f();";

    private static final List<String> EXPECTED = Arrays.asList("externObjSEThis");

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        assertMarkedCalls(SEED_JS, EXPECTED, "seed");

        String arg = escapeJsString(data.consumeString(64));
        int prefixStatements = data.consumeInt(0, 4);
        int suffixStatements = data.consumeInt(0, 4);
        int globalStatements = data.consumeInt(0, 4);

        StringBuilder family = new StringBuilder();
        family.append("function f(){");
        for (int i = 0; i < prefixStatements; i++) {
            family.append("0;");
        }
        family.append("new externObjSEThis().externObjSEThisMethod('");
        family.append(arg);
        family.append("');");
        for (int i = 0; i < suffixStatements; i++) {
            family.append("0;");
        }
        family.append("}");
        for (int i = 0; i < globalStatements; i++) {
            family.append("0;");
        }
        family.append("f();");

        assertMarkedCalls(family.toString(), EXPECTED, "family");
    }

    private static void assertMarkedCalls(String js, List<String> expected, String label) {
        List<String> actual = analyzeMarkedCalls(js);
        if (!expected.equals(actual)) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: " + label + " expected " + expected + " but got " + actual);
        }
    }

    private static List<String> analyzeMarkedCalls(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();

        List<JSSourceFile> externs = Arrays.asList(JSSourceFile.fromCode("externs.js", EXTERNS));
        List<JSSourceFile> inputs = Arrays.asList(JSSourceFile.fromCode("input.js", js));

        compiler.init(externs, inputs, options);
        Node root = compiler.parseInputs();
        if (root == null || compiler.getErrorCount() != 0) {
            return new ArrayList<String>();
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = root.getLastChild();
        if (externsRoot == null || jsRoot == null) {
            return new ArrayList<String>();
        }

        new PureFunctionIdentifier.Driver(compiler).process(externsRoot, jsRoot);

        ArrayList<String> marked = new ArrayList<String>();
        collectMarkedCalls(jsRoot, marked);
        return marked;
    }

    private static void collectMarkedCalls(Node node, List<String> out) {
        for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
            collectMarkedCalls(child, out);
        }

        int type = node.getType();
        if ((type == Token.CALL || type == Token.NEW) && node.getSideEffectFlags() != 0) {
            out.add(renderCallTarget(node.getFirstChild()));
        }
    }

    private static String renderCallTarget(Node callee) {
        if (callee == null) {
            return "";
        }

        switch (callee.getType()) {
            case Token.NAME:
                return callee.getString();
            case Token.GETPROP:
                Node target = callee.getFirstChild();
                Node prop = callee.getLastChild();
                return renderCallTarget(target) + " " + renderProperty(prop);
            case Token.NEW:
                return "NEW";
            default:
                return callee.toString();
        }
    }

    private static String renderProperty(Node prop) {
        if (prop == null) {
            return "";
        }
        if (prop.getType() == Token.STRING) {
            return "STRING " + prop.getString();
        }
        return prop.toString();
    }

    private static String escapeJsString(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '\'':
                    out.append("\\'");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                case '\b':
                    out.append("\\b");
                    break;
                case '\f':
                    out.append("\\f");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        out.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            out.append('0');
                        }
                        out.append(hex);
                    } else {
                        out.append(c);
                    }
                    break;
            }
        }
        return out.toString();
    }
}
