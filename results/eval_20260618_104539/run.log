                    break;
                default:
                    newArgs.append("null");
                    break;
            }
        }

        StringBuilder source = new StringBuilder();
        source.append("/** @constructor */ function ").append(ctorName)
            .append("(").append(ctorParam1).append(",").append(ctorParam2).append("){")
            .append(ctorBody)
            .append("}");
