package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.io.IOException;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] seedActual = compileAndCollectOrderedSources(new String[] {
            "goog.require('x');",
            "goog.provide('x');",
        });
        String[] seedExpected = new String[] {
            "goog.provide('x');",
            "goog.require('x');",
            "",
        };
        if (!Arrays.equals(seedActual, seedExpected)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: expected dependency-sorted order [goog.provide('x');, goog.require('x');, \"\"]");
        }

        if (data.consumeBoolean()) {
            String symbol = sanitizeIdentifier(data.consumeAsciiString(32));
            String require = "goog.require('" + symbol + "');";
            String provide = "goog.provide('" + symbol + "');";

            String[] actual = compileAndCollectOrderedSources(new String[] { require, provide });
            int provideIndex = indexOf(actual, provide);
            int requireIndex = indexOf(actual, require);

            if (provideIndex < 0 || requireIndex < 0 || provideIndex >= requireIndex) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: dependency sorting did not place goog.provide before goog.require");
            }
        } else {
            compileAndCollectOrderedSources(new String[] {
                data.consumeString(64),
                data.consumeRemainingAsString(),
            });
        }
    }

    private static CompilerOptions makeDependencySortingOptions() {
        CompilerOptions options = new CompilerOptions();
        options.closurePass = false;
        options.setDependencyOptions(
            new DependencyOptions()
                .setDependencySorting(true));
        return options;
    }

    private static String[] compileAndCollectOrderedSources(String[] sources) {
        Compiler compiler = new Compiler();
        List<SourceFile> inputs = new ArrayList<SourceFile>(sources.length);
        for (int i = 0; i < sources.length; i++) {
            inputs.add(SourceFile.fromCode("input" + i + ".js", sources[i]));
        }

        compiler.compile(
            Collections.<SourceFile>emptyList(),
            inputs,
            makeDependencySortingOptions());

        ArrayList<String> orderedSources = new ArrayList<String>();
        Iterable<CompilerInput> orderedInputs = compiler.getInputsInOrder();
        if (orderedInputs != null) {
            for (CompilerInput input : orderedInputs) {
                orderedSources.add(getCode(input));
            }
        }
        return orderedSources.toArray(new String[orderedSources.size()]);
    }

    private static String getCode(CompilerInput input) {
        if (input == null || input.getSourceFile() == null) {
            return "";
        }
        try {
            String code = input.getSourceFile().getCode();
            return code == null ? "" : code;
        } catch (IOException e) {
            return "";
        }
    }

    private static int indexOf(String[] values, String target) {
        for (int i = 0; i < values.length; i++) {
            if (target.equals(values[i])) {
                return i;
            }
        }
        return -1;
    }

    private static String sanitizeIdentifier(String raw) {
        if (raw == null || raw.length() == 0) {
            return "x";
        }

        StringBuilder out = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            boolean isLetter =
                (c >= 'a' && c <= 'z') ||
                (c >= 'A' && c <= 'Z');
            boolean isDigit = c >= '0' && c <= '9';
            if (isLetter || c == '_' || c == '$' || (out.length() > 0 && isDigit)) {
                out.append(c);
            }
        }

        if (out.length() == 0) {
            return "x";
        }
        char first = out.charAt(0);
        if (first >= '0' && first <= '9') {
            out.insert(0, 'x');
        }
        return out.toString();
    }
}
