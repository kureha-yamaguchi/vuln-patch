package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    private static final char DEL = 0x7f;
    private static final String SEED_EXPECTED = "var x=\"\\u007f\"";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = printVarAssignment(String.valueOf(DEL));
        if (!SEED_EXPECTED.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: expected " + SEED_EXPECTED + " but got " + escapeForMessage(seedActual));
        }

        // Exercise the real CodePrinter path on an arbitrary non-seed input without asserting.
        String arbitrary = data.consumeString(64);
        printVarAssignment(arbitrary);

        // Family of inputs sharing the triggering property:
        // the string contains U+007F and is otherwise made only of safe ASCII alphanumerics.
        String safe = toSafeAlnum(data.consumeAsciiString(64));
        int insertAt = data.consumeInt(0, safe.length());
        String familyValue = safe.substring(0, insertAt) + DEL + safe.substring(insertAt);

        String familyActual = printVarAssignment(familyValue);
        if (familyActual.indexOf(DEL) != -1 || countOccurrences(familyActual, "\\u007f") != 1) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: DEL was not escaped as \\u007f exactly once; got "
                    + escapeForMessage(familyActual));
        }
    }

    private static String printVarAssignment(String value) {
        Node name = Node.newString(Token.NAME, "x");
        name.addChildToBack(Node.newString(value));

        Node var = new Node(Token.VAR);
        var.addChildToBack(name);

        Node script = new Node(Token.SCRIPT);
        script.addChildToBack(var);

        return new CodePrinter.Builder(script).build();
    }

    private static String toSafeAlnum(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')) {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static int countOccurrences(String s, String needle) {
        int count = 0;
        int from = 0;
        while (true) {
            int idx = s.indexOf(needle, from);
            if (idx < 0) {
                return count;
            }
            count++;
            from = idx + needle.length();
        }
    }

    private static String escapeForMessage(String s) {
        StringBuilder sb = new StringBuilder(s.length() + 16);
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 0x20 && c <= 0x7e) {
                sb.append(c);
            } else {
                sb.append("\\u");
                appendHex(sb, (c >>> 12) & 0xf);
                appendHex(sb, (c >>> 8) & 0xf);
                appendHex(sb, (c >>> 4) & 0xf);
                appendHex(sb, c & 0xf);
            }
        }
        return sb.toString();
    }

    private static void appendHex(StringBuilder sb, int nibble) {
        sb.append((char) (nibble < 10 ? ('0' + nibble) : ('a' + (nibble - 10))));
    }
}
