        "var window = {};" +
        "window.location = '';" +
        "window.setTimeout = function(f,t){};";

    private static final String SEED_SOURCE =
        "/** @constructor */ function F() {" +
        "  var self = this;" +
        "  window.setTimeout(function() {" +
        "    window.location = self.location;" +
        "  }, 0);" +
        "}" +
        "F.prototype.setLocation = function(x) {" +
        "  this.location = x;" +
        "};" +
        "(new F()).setLocation('http://www.google.com/');";

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        analyzeSource(SEED_SOURCE);
        analyzeSource(buildFuzzedSource(data));
    }

    private static void analyzeSource(String source) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        JSSourceFile[] externs = new JSSourceFile[] {
            JSSourceFile.fromCode("externs.js", EXTERNS_SOURCE)
        };
        JSSourceFile[] inputs = new JSSourceFile[] {
            JSSourceFile.fromCode("input.js", source)
        };

        compiler.init(externs, inputs, options);
        compiler.parseInputs();

        Node root = compiler.getRoot();
        if (root == null) {
            throw new RuntimeException("Compiler returned null root");
        }

        Node externsRoot = root.getFirstChild();
        Node jsRoot = externsRoot != null ? externsRoot.getNext() : null;
        if (jsRoot == null) {
            throw new RuntimeException("Compiler returned null js root");
        }

        new PureFunctionIdentifier.Driver(compiler, "", true).process(externsRoot, jsRoot);

        Node newNode = findFirstNodeOfType(jsRoot, Token.NEW);
        if (newNode == null) {
            throw new RuntimeException("No NEW node found");
        }

        boolean actual = NodeUtil.evaluatesToLocalValue(newNode);
        if (actual != false) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: NodeUtil.evaluatesToLocalValue(NEW) returned " +
                actual + " instead of false");
        }
    }

    private static Node findFirstNodeOfType(Node n, int type) {
        if (n == null) {
            return null;
        }
        if (n.getType() == type) {
            return n;
        }
        for (Node child = n.getFirstChild(); child != null; child = child.getNext()) {
            Node found = findFirstNodeOfType(child, type);
            if (found != null) {
                return found;
            }
        }
        return null;
    }

    private static String buildFuzzedSource(FuzzedDataProvider data) {
        String ctorName = toIdentifier(data.consumeAsciiString(12), "F");
        String aliasName = toIdentifier(data.consumeAsciiString(12), "self");
        String methodName = toIdentifier(data.consumeAsciiString(12), "setLocation");
        String paramName = toIdentifier(data.consumeAsciiString(12), "x");
        String propName = toIdentifier(data.consumeAsciiString(12), "location");
        String sinkPropName = toIdentifier(data.consumeAsciiString(12), "location");
        String ctorParam1 = toIdentifier(data.consumeAsciiString(12), "a");
        String ctorParam2 = toIdentifier(data.consumeAsciiString(12), "b");
        String localName = toIdentifier(data.consumeAsciiString(12), "tmp");
        String payload = jsStringLiteralContent(data.consumeString(32));
        int delay = data.consumeInt(-20, 20);
        int extraStatements = data.consumeInt(0, 2);
        int argc = data.consumeInt(0, 3);

        StringBuilder ctorBody = new StringBuilder();
        ctorBody.append("var ").append(aliasName).append("=this;");
        for (int i = 0; i < extraStatements; i++) {
            ctorBody.append("var ").append(localName).append(i).append("=").append(i).append(";");
        }
        ctorBody.append("window.setTimeout(function(){");
        ctorBody.append("window.").append(sinkPropName).append("=").append(aliasName).append(".").append(propName).append(";");
        ctorBody.append("},").append(delay).append(");");

        StringBuilder newArgs = new StringBuilder();
        for (int i = 0; i < argc; i++) {
            if (i != 0) {
