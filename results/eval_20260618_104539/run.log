package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import com.google.javascript.rhino.Node;
import java.lang.reflect.Constructor;
import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    private static final String SEED_INPUT =
            "function BAR_FN(x, y, z) { return z(foo(x + y)) }alert(BAR_FN(1, 2, baz))";
    private static final String SEED_EXPECTED =
            "alert(baz(foo(1+2)))";
    private static final Object UNSUPPORTED = new Object();

    private static final class ProgramCase {
        final String js;
        final String fnName;
        final boolean sharesTriggeringProperty;

        ProgramCase(String js, String fnName, boolean sharesTriggeringProperty) {
            this.js = js;
            this.fnName = fnName;
            this.sharesTriggeringProperty = sharesTriggeringProperty;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = normalizeSource(runInlineFunctions(SEED_INPUT));
        String seedExpected = normalizeSource(SEED_EXPECTED);
        if (!seedExpected.equals(seedActual)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + SEED_EXPECTED + " but got " + seedActual);
        }

        ProgramCase program = buildProgram(data);
        String familyActual = normalizeSource(runInlineFunctions(program.js));

        if (program.sharesTriggeringProperty) {
            if (familyActual.contains(program.fnName)) {
                throw new FuzzerSecurityIssueLow(
                        "semantic mismatch: helper function was not inlined for " + program.fnName);
            }
        }
    }

    private static ProgramCase buildProgram(FuzzedDataProvider data) {
        String fnName = makeIdentifier(data.consumeAsciiString(12), "fn");
        String sideEffectableName = makeIdentifier(data.consumeAsciiString(12), "v");
        int a = data.consumeInt();
        int b = data.consumeInt();
        boolean sharesTriggeringProperty = data.consumeBoolean();

        String thirdArg;
        if (sharesTriggeringProperty) {
            thirdArg = sideEffectableName;
        } else {
            thirdArg = Integer.toString(data.consumeInt());
        }

        String js =
                "function " + fnName + "(x,y,z){return z(foo(x+y))}"
                        + "alert(" + fnName + "(" + a + "," + b + "," + thirdArg + "))";

        return new ProgramCase(js, fnName, sharesTriggeringProperty);
    }

    private static String makeIdentifier(String raw, String prefix) {
        StringBuilder sb = new StringBuilder(prefix);
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if ((c >= 'a' && c <= 'z')
                        || (c >= 'A' && c <= 'Z')
                        || (c >= '0' && c <= '9')
                        || c == '_'
                        || c == '$') {
                    sb.append(Character.toLowerCase(c));
                }
            }
        }
        if (sb.length() == prefix.length()) {
            sb.append('x');
        }
        return sb.toString();
    }

    private static String normalizeSource(String src) {
        if (src == null) {
            return "";
        }
        StringBuilder sb = new StringBuilder(src.length());
        for (int i = 0; i < src.length(); i++) {
            char c = src.charAt(i);
            if (!Character.isWhitespace(c) && c != ';') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String runInlineFunctions(String js) {
        try {
            Object compiler = newInstance("com.google.javascript.jscomp.Compiler");
            Class<?> optionsClass = Class.forName("com.google.javascript.jscomp.CompilerOptions");
            Object options = optionsClass.getConstructor().newInstance();

            tryInvoke(compiler, "initOptions", options);

            Object externsFile = createSourceFile("externs.js", "");
            Object inputFile = createSourceFile("input.js", js);

            List<Object> externs = new ArrayList<Object>();
            externs.add(externsFile);
            List<Object> inputs = new ArrayList<Object>();
            inputs.add(inputFile);

            invoke(compiler, "init", externs, inputs, options);
            tryInvoke(compiler, "parseInputs");

            Node externsRoot = getExternsRoot(compiler);
            Node jsRoot = getJsRoot(compiler);

            Object inlineFunctions = newInlineFunctionsPass(compiler);
            invoke(inlineFunctions, "process", externsRoot, jsRoot);

            Object source = invoke(compiler, "toSource");
            return source == null ? "" : source.toString();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            throw new RuntimeException(t);
        }
    }

    private static Object newInlineFunctionsPass(Object compiler) throws Exception {
        Class<?> inlineClass = Class.forName("com.google.javascript.jscomp.InlineFunctions");
        Constructor<?>[] ctors = inlineClass.getDeclaredConstructors();

        List<Constructor<?>> sorted = new ArrayList<Constructor<?>>();
        Collections.addAll(sorted, ctors);
        Collections.sort(sorted, (a, b) -> a.getParameterTypes().length - b.getParameterTypes().length);

        for (Constructor<?> ctor : sorted) {
            Class<?>[] paramTypes = ctor.getParameterTypes();
            Object[] args = new Object[paramTypes.length];
            boolean ok = true;
            for (int i = 0; i < paramTypes.length; i++) {
                Object arg = buildConstructorArg(paramTypes[i], compiler);
                if (arg == UNSUPPORTED) {
                    ok = false;
                    break;
                }
                args[i] = arg;
            }
            if (!ok) {
                continue;
            }
            try {
                ctor.setAccessible(true);
                return ctor.newInstance(args);
            } catch (ReflectiveOperationException ignored) {
            }
        }

        throw new IllegalStateException("Unable to instantiate InlineFunctions");
    }

    private static Object buildConstructorArg(Class<?> type, Object compiler) throws Exception {
        if (type.isPrimitive()) {
            if (type == boolean.class) {
                return Boolean.FALSE;
            }
            if (type == int.class) {
                return Integer.valueOf(0);
            }
            if (type == long.class) {
                return Long.valueOf(0L);
            }
            if (type == double.class) {
                return Double.valueOf(0.0d);
            }
            if (type == float.class) {
                return Float.valueOf(0.0f);
            }
            if (type == short.class) {
                return Short.valueOf((short) 0);
            }
            if (type == byte.class) {
                return Byte.valueOf((byte) 0);
            }
            if (type == char.class) {
                return Character.valueOf((char) 0);
            }
        }

        if (type.isAssignableFrom(compiler.getClass())
                || "com.google.javascript.jscomp.AbstractCompiler".equals(type.getName())) {
            return compiler;
        }

        if ("com.google.common.base.Supplier".equals(type.getName())) {
            Object supplier = tryInvoke(compiler, "getUniqueNameIdSupplier");
            return supplier != null ? supplier : UNSUPPORTED;
        }

        if (type.isEnum()) {
            Object[] constants = type.getEnumConstants();
            if (constants == null || constants.length == 0) {
                return UNSUPPORTED;
            }
            for (Object constant : constants) {
                if ("ALL".equals(String.valueOf(constant))) {
                    return constant;
                }
            }
            return constants[0];
        }

        if (String.class.equals(type)) {
            return "";
        }

        if (java.util.Set.class.isAssignableFrom(type)) {
            return Collections.emptySet();
        }
        if (java.util.Map.class.isAssignableFrom(type)) {
            return Collections.emptyMap();
        }
        if (java.util.List.class.isAssignableFrom(type)) {
            return Collections.emptyList();
        }
        if (java.util.Collection.class.isAssignableFrom(type)) {
            return Collections.emptyList();
        }

        return UNSUPPORTED;
    }

    private static Object createSourceFile(String name, String code) throws Exception {
        try {
            Class<?> sourceFile = Class.forName("com.google.javascript.jscomp.SourceFile");
            return invoke(sourceFile, "fromCode", name, code);
        } catch (ClassNotFoundException e) {
            Class<?> jsSourceFile = Class.forName("com.google.javascript.jscomp.JSSourceFile");
            return invoke(jsSourceFile, "fromCode", name, code);
        }
    }

    private static Node getExternsRoot(Object compiler) throws Exception {
        Object externsRoot = tryInvoke(compiler, "getExternsRoot");
        if (externsRoot instanceof Node) {
            return (Node) externsRoot;
        }
        Node root = (Node) invoke(compiler, "getRoot");
        return root.getFirstChild();
    }

    private static Node getJsRoot(Object compiler) throws Exception {
        Object jsRoot = tryInvoke(compiler, "getJsRoot");
        if (jsRoot instanceof Node) {
            return (Node) jsRoot;
        }
        Node root = (Node) invoke(compiler, "getRoot");
        Node first = root.getFirstChild();
        return first != null && first.getNext() != null ? first.getNext() : root.getLastChild();
    }

    private static Object newInstance(String className) throws Exception {
        Class<?> cls = Class.forName(className);
        Constructor<?> ctor = cls.getDeclaredConstructor();
        ctor.setAccessible(true);
        return ctor.newInstance();
    }

    private static Object tryInvoke(Object target, String methodName, Object... args) {
        try {
            return invoke(target, methodName, args);
        } catch (Throwable t) {
            return null;
        }
    }

    private static Object invoke(Object target, String methodName, Object... args) throws Exception {
        Class<?> cls = target instanceof Class<?> ? (Class<?>) target : target.getClass();
        Method method = findCompatibleMethod(cls, methodName, args);
        if (method == null) {
            throw new NoSuchMethodException(cls.getName() + "." + methodName);
        }
        method.setAccessible(true);
        return method.invoke(target instanceof Class<?> ? null : target, args);
    }

    private static Method findCompatibleMethod(Class<?> cls, String methodName, Object[] args) {
        Method found = null;
        for (Method m : cls.getMethods()) {
            if (isCompatible(m, methodName, args)) {
                found = m;
                if (m.getDeclaringClass() == cls) {
                    return m;
                }
            }
        }
        for (Method m : cls.getDeclaredMethods()) {
            if (isCompatible(m, methodName, args)) {
                return m;
            }
        }
        return found;
    }

    private static boolean isCompatible(Method m, String methodName, Object[] args) {
        if (!m.getName().equals(methodName)) {
            return false;
        }
        Class<?>[] params = m.getParameterTypes();
        if (params.length != args.length) {
            return false;
        }
        for (int i = 0; i < params.length; i++) {
            if (!isAssignable(params[i], args[i])) {
                return false;
            }
        }
        return true;
    }

    private static boolean isAssignable(Class<?> paramType, Object arg) {
        if (arg == null) {
            return !paramType.isPrimitive();
        }
        Class<?> argType = arg.getClass();
        if (paramType.isPrimitive()) {
            if (paramType == boolean.class) {
                return argType == Boolean.class;
            }
            if (paramType == int.class) {
                return argType == Integer.class;
            }
            if (paramType == long.class) {
                return argType == Long.class;
            }
            if (paramType == double.class) {
                return argType == Double.class;
            }
            if (paramType == float.class) {
                return argType == Float.class;
            }
            if (paramType == short.class) {
                return argType == Short.class;
            }
            if (paramType == byte.class) {
                return argType == Byte.class;
            }
            if (paramType == char.class) {
                return argType == Character.class;
            }
            return false;
        }
        return paramType.isAssignableFrom(argType);
    }
}
