                new org.jfree.data.category.DefaultCategoryDataset();
        org.jfree.chart.plot.CategoryPlot plot = new org.jfree.chart.plot.CategoryPlot();
        plot.setDataset(dataset);
        plot.setRenderer(r);
        assertEqualsInt(0, r.getLegendItems().getItemCount(), "empty dataset legend item count");

        dataset.addValue(1.0, "S1", "C1");
        org.jfree.chart.LegendItemCollection lic = r.getLegendItems();
        assertNotNull(lic, "legend items after adding seed value");
        assertEqualsInt(1, lic.getItemCount(), "seed legend item count");
        assertEqualsString("S1", lic.get(0).getLabel(), "seed legend label");

        LineAndShapeRenderer familyRenderer = new LineAndShapeRenderer();
        org.jfree.data.category.DefaultCategoryDataset familyDataset =
