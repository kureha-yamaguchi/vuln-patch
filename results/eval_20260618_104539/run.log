package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedSource =
                "var foo = function(a) { return getWindow(a); };"
                        + "var bar = function(b) { return b; };"
                        + "foo(bar(x));";
        String seedActual = compileAndNormalize(seedSource, "x");
        String seedExpected = "getWindow(x)";
        if (!seedExpected.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + seedExpected + " but got " + seedActual);
        }

        String foo = makeIdentifier("foo", data.consumeAsciiString(12));
        String bar = makeIdentifier("bar", data.consumeAsciiString(12));
        String a = makeIdentifier("a", data.consumeAsciiString(12));
        String b = makeIdentifier("b", data.consumeAsciiString(12));
        String x = makeIdentifier("x", data.consumeAsciiString(12));

        String sp = data.consumeBoolean() ? " " : "";
        String nl = data.consumeBoolean() ? "\n" : "";

        String familySource =
                "var" + sp + foo + sp + "=" + sp + "function(" + a + "){" + nl
                        + "return" + sp + "getWindow(" + a + ");" + nl + "};"
                        + "var" + sp + bar + sp + "=" + sp + "function(" + b + "){" + nl
                        + "return" + sp + b + ";" + nl + "};"
                        + foo + "(" + bar + "(" + x + "));";

        String familyActual = compileAndNormalize(familySource, x);
        String familyExpected = "getWindow(" + x + ")";
        if (!familyExpected.equals(familyActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected " + familyExpected + " but got " + familyActual);
        }
    }

    private static String compileAndNormalize(String source, String argName) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);

        java.util.List<SourceFile> externs =
                java.util.Collections.singletonList(
                        SourceFile.fromCode(
                                "externs.js",
                                "function getWindow(a) {}\nvar " + argName + ";"));
        java.util.List<SourceFile> inputs =
                java.util.Collections.singletonList(
                        SourceFile.fromCode("input.js", source));

        compiler.compile(externs, inputs, options);
        return normalizeSource(compiler.toSource());
    }

    private static String normalizeSource(String source) {
        if (source == null) {
            return null;
        }
        String s = source.trim();
        while (s.endsWith(";")) {
            s = s.substring(0, s.length() - 1).trim();
        }
        return s;
    }

    private static String makeIdentifier(String prefix, String raw) {
        StringBuilder sb = new StringBuilder(prefix);
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if ((c >= 'a' && c <= 'z')
                        || (c >= 'A' && c <= 'Z')
                        || (c >= '0' && c <= '9')
                        || c == '_'
                        || c == '$') {
                    sb.append(c);
                }
            }
        }
        if (sb.length() == prefix.length()) {
            sb.append('0');
        }
        return sb.toString();
    }
}
