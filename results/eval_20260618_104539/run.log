package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        CompilerOptions seedOptions = new CompilerOptions();
        seedOptions.setDependencyOptions(
                new DependencyOptions()
                        .setDependencySorting(true));
        seedOptions.closurePass = false;

        String[] seedActual = compileSources(
                new String[] {
                        "goog.require('x');",
                        "goog.provide('x');"
                },
                seedOptions);

        String[] seedExpected = new String[] {
                "goog.provide('x');",
                "goog.require('x');",
                ""
        };

        if (!java.util.Arrays.equals(seedExpected, seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: dependency sorting seed expected "
                            + java.util.Arrays.toString(seedExpected)
                            + " but got "
                            + java.util.Arrays.toString(seedActual));
        }

        String namespace = sanitizeNamespace(data.consumeAsciiString(32));

        String requireSource = "goog.require('" + namespace + "');";
        String provideSource = "goog.provide('" + namespace + "');";

        CompilerOptions familyOptions = new CompilerOptions();
        familyOptions.setDependencyOptions(
                new DependencyOptions()
                        .setDependencySorting(true));
        familyOptions.closurePass = false;

        String[] familyActual = compileSources(
                new String[] {
                        requireSource,
                        provideSource
                },
                familyOptions);

        String[] familyExpected = new String[] {
                provideSource,
                requireSource,
                ""
        };

        if (!java.util.Arrays.equals(familyExpected, familyActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: dependency sorting family expected provider before requirer; expected "
                            + java.util.Arrays.toString(familyExpected)
                            + " but got "
                            + java.util.Arrays.toString(familyActual));
        }

        if (data.remainingBytes() > 0) {
            boolean closurePass = data.consumeBoolean();

            CompilerOptions extraOptions = new CompilerOptions();
            extraOptions.setDependencyOptions(
                    new DependencyOptions()
                            .setDependencySorting(true));
            extraOptions.closurePass = closurePass;

            compileSources(
                    new String[] {
                            requireSource,
                            provideSource
                    },
                    extraOptions);
        }
    }

    private static String[] compileSources(String[] sources, CompilerOptions options) {
        Compiler compiler = new Compiler();

        java.util.List<JSSourceFile> externs =
                java.util.Collections.singletonList(
                        JSSourceFile.fromCode("externs.js", ""));

        java.util.List<JSSourceFile> inputs = new java.util.ArrayList<JSSourceFile>();
        for (int i = 0; i < sources.length; i++) {
            inputs.add(JSSourceFile.fromCode("input" + i + ".js", sources[i]));
        }

        compiler.compile(externs, inputs, options);
        return compiler.toSourceArray();
    }

    private static String sanitizeNamespace(String raw) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
                sb.append(c);
            } else if (c >= '0' && c <= '9') {
                if (sb.length() == 0) {
                    sb.append('x');
                }
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            return "x";
        }
        return sb.toString();
    }
}
