        org.apache.commons.math3.geometry.euclidean.twod.Vector2D p2 =
                p1.add(offset.scalarMultiply(offsetScale)).add(d.scalarMultiply(shift));
        org.apache.commons.math3.geometry.euclidean.twod.Vector2D e2 =
                p2.add(d.scalarMultiply(len2));

        org.apache.commons.math3.geometry.euclidean.twod.SubLine sub1 =
                new org.apache.commons.math3.geometry.euclidean.twod.SubLine(p1, e1);
