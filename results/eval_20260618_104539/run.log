package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import com.google.common.collect.ImmutableList;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;
import java.util.ArrayDeque;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class Helper {
            String id(String prefix, int value) {
                return prefix + Integer.toHexString(value);
            }

            String jsEscaped(String s) {
                StringBuilder sb = new StringBuilder(s.length() + 8);
                for (int i = 0; i < s.length(); i++) {
                    char c = s.charAt(i);
                    if (c == '\\' || c == '\'') {
                        sb.append('\\').append(c);
                    } else if (c >= 0x20 && c <= 0x7e) {
                        sb.append(c);
                    } else {
                        sb.append('_');
                    }
                }
                return sb.toString();
            }

            ImmutableList<String> getMarkedCalls(String js) {
                Compiler compiler = new Compiler();
                CompilerOptions options = new CompilerOptions();
                SourceFile externs = SourceFile.fromCode("externs.js", "var window;");
                SourceFile input = SourceFile.fromCode("input.js", js);

                compiler.init(ImmutableList.of(externs), ImmutableList.of(input), options);
                compiler.parseInputs();

                Node externsRoot = compiler.getExternsRoot();
                Node root = compiler.getRoot();
                if (root == null) {
                    return ImmutableList.of("null-root");
                }

                Node srcRoot = root;
                if (externsRoot != null && root.getFirstChild() == externsRoot && externsRoot.getNext() != null) {
                    srcRoot = externsRoot.getNext();
                }

                new PureFunctionIdentifier.Driver(compiler).process(externsRoot, srcRoot);

                ImmutableList.Builder<String> marked = ImmutableList.builder();
                ArrayDeque<Node> stack = new ArrayDeque<Node>();
                stack.push(srcRoot);

                while (!stack.isEmpty()) {
                    Node n = stack.pop();

                    if (n.getType() == Token.NEW) {
                        NodeUtil.evaluatesToLocalValue(n);
                    }

                    if (n.getType() == Token.CALL) {
                        if (!NodeUtil.functionCallHasSideEffects(n)) {
                            String rendered;
                            try {
                                rendered = compiler.toSource(n);
                            } catch (Throwable t) {
                                rendered = n.toString();
                            }
                            marked.add(rendered);
                        }
                    } else if (n.getType() == Token.NEW) {
                        if (!NodeUtil.constructorCallHasSideEffects(n)) {
                            String rendered;
                            try {
                                rendered = compiler.toSource(n);
                            } catch (Throwable t) {
                                rendered = n.toString();
                            }
                            marked.add(rendered);
                        }
                    }

                    for (Node c = n.getLastChild(); c != null; c = c.getPrevious()) {
                        stack.push(c);
                    }
                }

                return marked.build();
            }
        }

        Helper helper = new Helper();
        ImmutableList<String> expected = ImmutableList.<String>of();

        String seed =
                "/** @constructor */ function F() {" +
                "  var self = this;" +
                "  window.setTimeout(function() {" +
                "    window.location = self.location;" +
                "  }, 0);" +
                "}" +
                "F.prototype.setLocation = function(x) {" +
                "  this.location = x;" +
                "};" +
                "function x() {" +
                "  (new F()).setLocation('http://www.google.com/');" +
                "} window['x'] = x;";

        ImmutableList<String> actualSeed = helper.getMarkedCalls(seed);
        if (!actualSeed.equals(expected)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: checkMarkedCalls(seed, ImmutableList.<String>of()) returned " + actualSeed);
        }

        String ctor = helper.id("F", data.consumeInt());
        String alias = helper.id("self", data.consumeInt());
        String method = helper.id("setLocation", data.consumeInt());
        String param = helper.id("x", data.consumeInt());
        String exportedFn = helper.id("x", data.consumeInt());
        int delay = data.consumeInt(0, 1000);

        String url = helper.jsEscaped(data.consumeAsciiString(64));
        if (url.length() == 0) {
            url = "http://www.google.com/";
        }

        String exportKey = helper.jsEscaped(data.consumeAsciiString(24));
        if (exportKey.length() == 0) {
            exportKey = exportedFn;
        }

        String noise = helper.jsEscaped(data.consumeAsciiString(24));

        String js =
                "/** @constructor */ function " + ctor + "() {" +
                "  var " + alias + " = this;" +
                "  window.setTimeout(function() {" +
                "    window.location = " + alias + ".location;" +
                "  }, " + delay + ");" +
                "}" +
                ctor + ".prototype." + method + " = function(" + param + ") {" +
                "  this.location = " + param + ";" +
                "};" +
                "function " + exportedFn + "() {" +
                "  (new " + ctor + "())." + method + "('" + url + "');" +
                "} window['" + exportKey + "'] = " + exportedFn + ";" +
                "/*" + noise + "*/";

        ImmutableList<String> actual = helper.getMarkedCalls(js);
        if (!actual.equals(expected)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: expected ImmutableList.<String>of() but got " + actual);
        }
    }
}
