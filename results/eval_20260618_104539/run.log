package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] liftedCalls = new String[] {
            "var x ='\\x0f';",
            "var x ='\\x68';",
            "var x ='\\x7f';"
        };
        String[] liftedValues = new String[] {
            "\u000f",
            "h",
            "\u007f"
        };
        String[] liftedExpected = new String[] {
            "var x=\"\\u000f\"",
            "var x=\"h\"",
            "var x=\"\\u007f\""
        };

        for (int i = 0; i < liftedValues.length; i++) {
            Node script = new Node(Token.SCRIPT);
            Node var = new Node(Token.VAR);
            Node name = Node.newString(Token.NAME, "x");
            name.addChildToBack(Node.newString(liftedValues[i]));
            var.addChildToBack(name);
            script.addChildToBack(var);

            String actual = new CodePrinter.Builder(script).build();
            if (!liftedExpected[i].equals(actual)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: CodePrinter output for " + liftedCalls[i]
                        + " expected [" + liftedExpected[i] + "] but got [" + actual + "]"
                );
            }
        }

        String exploratoryValue = data.consumeString(64);
        {
            Node script = new Node(Token.SCRIPT);
            Node var = new Node(Token.VAR);
            Node name = Node.newString(Token.NAME, "x");
            name.addChildToBack(Node.newString(exploratoryValue));
            var.addChildToBack(name);
            script.addChildToBack(var);
            new CodePrinter.Builder(script).build();
        }

        int delCount = data.consumeInt(1, 4);
        String prefix = data.consumeString(32);
        String middle = data.consumeString(32);
        String suffix = data.consumeRemainingAsString();

        StringBuilder familyValueBuilder = new StringBuilder(
            prefix.length() + middle.length() + suffix.length() + delCount
        );
        familyValueBuilder.append(prefix);
        familyValueBuilder.append('\u007f');
        familyValueBuilder.append(middle);
        for (int i = 1; i < delCount; i++) {
            familyValueBuilder.append('\u007f');
            familyValueBuilder.append((i & 1) == 0 ? prefix : suffix);
        }
        familyValueBuilder.append(suffix);
        String familyValue = familyValueBuilder.toString();

        Node familyScript = new Node(Token.SCRIPT);
        Node familyVar = new Node(Token.VAR);
        Node familyName = Node.newString(Token.NAME, "x");
        familyName.addChildToBack(Node.newString(familyValue));
        familyVar.addChildToBack(familyName);
        familyScript.addChildToBack(familyVar);

        String familyActual = new CodePrinter.Builder(familyScript).build();
        if (familyValue.indexOf('\u007f') != -1) {
            if (familyActual.indexOf('\u007f') != -1 || familyActual.indexOf("\\u007f") < 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: DEL (0x7f) in string literal was not unicode-escaped by CodePrinter"
                );
            }
        }
    }
}
