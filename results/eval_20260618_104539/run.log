package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] expected = new String[] {
            "goog.provide('x');",
            "goog.require('x');",
            "",
        };

        String[] seedActual = compileToSourceArray("goog.require('x');", "goog.provide('x');");
        if (!java.util.Arrays.equals(expected, seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: dependency sorting seed output differed, expected "
                    + java.util.Arrays.toString(expected)
                    + " but got "
                    + describe(seedActual));
        }

        String ws1 = toWhitespace(data.consumeAsciiString(32));
        String ws2 = toWhitespace(data.consumeAsciiString(32));
        String ws3 = toWhitespace(data.consumeAsciiString(32));
        String ws4 = toWhitespace(data.consumeAsciiString(32));

        String requireSource = ws1 + "goog.require('x');" + ws2;
        String provideSource = ws3 + "goog.provide('x');" + ws4;

        String[] familyActual = compileToSourceArray(requireSource, provideSource);
        if (!java.util.Arrays.equals(expected, familyActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: dependency sorting family output differed, expected "
                    + java.util.Arrays.toString(expected)
                    + " but got "
                    + describe(familyActual));
        }
    }

    private static String[] compileToSourceArray(String firstInput, String secondInput) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        options.setClosurePass(false);
        options.setDependencyOptions(
            new DependencyOptions().setDependencySorting(true));

        java.util.List<SourceFile> inputs = new java.util.ArrayList<SourceFile>();
        inputs.add(SourceFile.fromCode("input0.js", firstInput));
        inputs.add(SourceFile.fromCode("input1.js", secondInput));

        compiler.compile(
            java.util.Collections.<SourceFile>emptyList(),
            inputs,
            options);

        return compiler.toSourceArray();
    }

    private static String toWhitespace(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            switch (s.charAt(i) % 4) {
                case 0:
                    sb.append(' ');
                    break;
                case 1:
                    sb.append('\t');
                    break;
                case 2:
                    sb.append('\n');
                    break;
                default:
                    sb.append('\r');
                    break;
            }
        }
        return sb.toString();
    }

    private static String describe(String[] value) {
        return value == null ? "null" : java.util.Arrays.toString(value);
    }
}
