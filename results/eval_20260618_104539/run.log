import java.awt.geom.GeneralPath;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 4);

        if (mode == 0) {
            GeneralPath g1 = new GeneralPath();
            g1.moveTo(1.0f, 2.0f);
            g1.lineTo(3.0f, 4.0f);
            g1.curveTo(5.0f, 6.0f, 7.0f, 8.0f, 9.0f, 10.0f);
            g1.quadTo(1.0f, 2.0f, 3.0f, 4.0f);
            g1.closePath();

            GeneralPath g2 = new GeneralPath();
            g2.moveTo(11.0f, 22.0f);
            g2.lineTo(3.0f, 4.0f);
            g2.curveTo(5.0f, 6.0f, 7.0f, 8.0f, 9.0f, 10.0f);
            g2.quadTo(1.0f, 2.0f, 3.0f, 4.0f);
            g2.closePath();

            if (ShapeUtilities.equal(g1, g2) != false) {
                throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: ShapeUtilities.equal(g1, g2) expected false"
                );
            }
            return;
        }

        int rule1 = data.consumeBoolean() ? GeneralPath.WIND_EVEN_ODD : GeneralPath.WIND_NON_ZERO;
        boolean close = data.consumeBoolean();

        float[] coords = new float[14];
        for (int i = 0; i < coords.length; i++) {
            coords[i] = (float) data.consumeInt(-1_000_000, 1_000_000);
        }

        GeneralPath p1;
        GeneralPath p2;
        boolean assertFalse = false;

        switch (mode) {
            case 1: {
                float[] coords2 = coords.clone();
                int diffIndex = data.consumeInt(0, coords2.length - 1);
                coords2[diffIndex] = coords2[diffIndex] + (data.consumeBoolean() ? 1.0f : -1.0f);

                p1 = buildPath(rule1, coords, close, false, 0.0f, 0.0f);
                p2 = buildPath(rule1, coords2, close, false, 0.0f, 0.0f);
                assertFalse = true;
                break;
            }
            case 2: {
                float extraX = (float) data.consumeInt(-1_000_000, 1_000_000);
                float extraY = (float) data.consumeInt(-1_000_000, 1_000_000);

                p1 = buildPath(rule1, coords, close, false, 0.0f, 0.0f);
                p2 = buildPath(rule1, coords, close, true, extraX, extraY);
                assertFalse = true;
                break;
            }
            case 3: {
                p1 = buildPath(rule1, coords, close, false, 0.0f, 0.0f);
                p2 = buildPath(rule1, coords.clone(), close, false, 0.0f, 0.0f);
                break;
            }
            default: {
                int rule2 = (rule1 == GeneralPath.WIND_EVEN_ODD)
                    ? GeneralPath.WIND_NON_ZERO
                    : GeneralPath.WIND_EVEN_ODD;
                p1 = buildPath(rule1, coords, close, false, 0.0f, 0.0f);
                p2 = buildPath(rule2, coords.clone(), close, false, 0.0f, 0.0f);
                break;
            }
        }

        boolean actual = ShapeUtilities.equal(p1, p2);
        if (assertFalse && actual != false) {
            throw new FuzzerSecurityIssueLow(
                "semantic mismatch: ShapeUtilities.equal(p1, p2) expected false for different GeneralPaths with the same winding rule"
            );
        }
    }

    private static GeneralPath buildPath(
            int windingRule,
            float[] c,
            boolean close,
            boolean extraLine,
            float extraX,
            float extraY) {
        GeneralPath p = new GeneralPath(windingRule);
        p.moveTo(c[0], c[1]);
        p.lineTo(c[2], c[3]);
        p.curveTo(c[4], c[5], c[6], c[7], c[8], c[9]);
        p.quadTo(c[10], c[11], c[12], c[13]);
        if (extraLine) {
            p.lineTo(extraX, extraY);
        }
        if (close) {
            p.closePath();
        }
        return p;
    }
}
