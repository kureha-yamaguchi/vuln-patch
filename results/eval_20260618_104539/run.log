        Node getProp = new Node(Token.GETPROP);
        getProp.addChildToBack(Node.newString(
            Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16), "ns")));
        getProp.addChildToBack(Node.newString(Token.STRING, ctorName));
        return getProp;
    }

    private static Node buildArgument(FuzzedDataProvider data, int depth) {
        if (depth > 1) {
            return buildLeaf(data);
        }

        switch (data.consumeInt(0, 6)) {
            case 0:
                return buildLeaf(data);
            case 1:
                return new Node(Token.ARRAYLIT);
            case 2:
                return new Node(Token.OBJECTLIT);
            case 3:
                return buildCallNode(data);
            case 4:
                return new Node(Token.THIS);
            case 5:
                return buildLeaf(data);
            default:
                return buildNewNode(
                    sanitizeIdentifier(data.consumeAsciiString(12), "Ctor"),
                    data.consumeInt(0, 2),
                    data,
                    depth + 1);
        }
    }

    private static Node buildLeaf(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 3)) {
            case 0:
                return Node.newString(Token.NAME,
                    sanitizeIdentifier(data.consumeAsciiString(20), "x"));
            case 1:
                return Node.newString(Token.STRING, data.consumeAsciiString(20));
            case 2:
                return Node.newNumber((double) data.consumeInt());
            default:
                return Node.newString(Token.NAME, "undefined");
        }
    }

    private static Node buildCallNode(FuzzedDataProvider data) {
        Node call = new Node(Token.CALL);
        call.addChildToBack(Node.newString(
            Token.NAME, sanitizeIdentifier(data.consumeAsciiString(16), "fn")));
        int argc = data.consumeInt(0, 2);
        for (int i = 0; i < argc; i++) {
            call.addChildToBack(buildLeaf(data));
        }
        return call;
    }

    private static Node buildNonTriggeringNode(FuzzedDataProvider data, int depth) {
        switch (data.consumeInt(0, 6)) {
            case 0:
                return buildLeaf(data);
            case 1:
                return new Node(Token.ARRAYLIT);
            case 2:
                return new Node(Token.OBJECTLIT);
            case 3:
                return buildCallNode(data);
            case 4:
                return new Node(Token.THIS);
            case 5:
                if (depth > 1) {
                    return buildLeaf(data);
                }
                Node comma = new Node(Token.COMMA);
                comma.addChildToBack(buildLeaf(data));
                comma.addChildToBack(buildNonTriggeringNode(data, depth + 1));
                return comma;
            default:
                if (depth > 1) {
                    return buildLeaf(data);
                }
                Node hook = new Node(Token.HOOK);
                hook.addChildToBack(buildLeaf(data));
                hook.addChildToBack(buildNonTriggeringNode(data, depth + 1));
                hook.addChildToBack(buildNonTriggeringNode(data, depth + 1));
                return hook;
        }
    }

    private static String sanitizeIdentifier(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }

        StringBuilder out = new StringBuilder(s.length());
        char first = s.charAt(0);
        if (isIdentifierStart(first)) {
            out.append(first);
        } else {
            out.append('_');
        }

        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            out.append(isIdentifierPart(c) ? c : '_');
        }
        return out.toString();
    }

    private static boolean isIdentifierStart(char c) {
        return (c >= 'a' && c <= 'z')
            || (c >= 'A' && c <= 'Z')
            || c == '_'
            || c == '$';
    }

    private static boolean isIdentifierPart(char c) {
        return isIdentifierStart(c) || (c >= '0' && c <= '9');
    }
}
