    private static String sanitizeIdentifier(String raw, char fallback) {
        StringBuilder sb = new StringBuilder();
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if (sb.length() == 0) {
                    if (Character.isLetter(c) || c == '_' || c == '$') {
