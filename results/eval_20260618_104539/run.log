package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        CompilerOptions seedOptions = new CompilerOptions();
        seedOptions.setDependencyOptions(
                new DependencyOptions()
                        .setDependencySorting(true));

        String[] seedActual = parseAndCollectSources(
                new String[]{
                        "goog.require('x');",
                        "goog.provide('x');",
                },
                seedOptions);

        String[] seedExpected = new String[]{
                "goog.provide('x');",
                "goog.require('x');",

                "",
        };

        if (!java.util.Arrays.equals(seedActual, seedExpected)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected "
                            + java.util.Arrays.toString(seedExpected)
                            + " but got "
                            + java.util.Arrays.toString(seedActual));
        }

        String namespace = sanitizeNamespace(data.consumeAsciiString(64));
        String requirePaddingPrefix = whitespace(data.consumeInt(0, 8), data.consumeBoolean());
        String requirePaddingSuffix = whitespace(data.consumeInt(0, 8), data.consumeBoolean());
        String providePaddingPrefix = whitespace(data.consumeInt(0, 8), data.consumeBoolean());
        String providePaddingSuffix = whitespace(data.consumeInt(0, 8), data.consumeBoolean());

        String requireSource =
                requirePaddingPrefix + "goog.require('" + namespace + "');" + requirePaddingSuffix;
        String provideSource =
                providePaddingPrefix + "goog.provide('" + namespace + "');" + providePaddingSuffix;

        CompilerOptions familyOptions = new CompilerOptions();
        familyOptions.setDependencyOptions(
                new DependencyOptions()
                        .setDependencySorting(true));

        String[] familyActual = parseAndCollectSources(
                new String[]{
                        requireSource,
                        provideSource,
                },
                familyOptions);

        String[] familyExpected = new String[]{
                provideSource,
                requireSource,
                "",
        };

        if (!java.util.Arrays.equals(familyActual, familyExpected)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: dependency sorting did not place provide before require; expected "
                            + java.util.Arrays.toString(familyExpected)
                            + " but got "
                            + java.util.Arrays.toString(familyActual));
        }
    }

    private static String[] parseAndCollectSources(String[] sources, CompilerOptions options) {
        Compiler compiler = new Compiler();

        java.util.List<SourceFile> externs =
                java.util.Collections.singletonList(SourceFile.fromCode("externs.js", ""));

        java.util.List<SourceFile> inputs = new java.util.ArrayList<SourceFile>(sources.length);
        for (int i = 0; i < sources.length; i++) {
            inputs.add(SourceFile.fromCode("input" + i + ".js", sources[i]));
        }

        compiler.init(externs, inputs, options);
        compiler.parseInputs();

        java.util.ArrayList<String> ordered = new java.util.ArrayList<String>();
        for (CompilerInput input : compiler.getInputsInOrder()) {
            try {
                ordered.add(input.getCode());
            } catch (java.io.IOException e) {
                throw new RuntimeException(e);
            }
        }

        return ordered.toArray(new String[ordered.size()]);
    }

    private static String sanitizeNamespace(String raw) {
        if (raw == null || raw.length() == 0) {
            return "x";
        }

        StringBuilder out = new StringBuilder();
        boolean segmentStart = true;

        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);

            if (c == '.') {
                if (!segmentStart && out.length() > 0 && out.charAt(out.length() - 1) != '.') {
                    out.append('.');
                    segmentStart = true;
                }
                continue;
            }

            boolean isLetter =
                    (c >= 'a' && c <= 'z')
                            || (c >= 'A' && c <= 'Z');
            boolean isDigit = (c >= '0' && c <= '9');
            boolean isIdentStart = isLetter || c == '_' || c == '$';
            boolean isIdentPart = isIdentStart || isDigit;

            if (segmentStart) {
                if (isIdentStart) {
                    out.append(c);
                    segmentStart = false;
                } else if (isDigit) {
                    out.append('x');
                    out.append(c);
                    segmentStart = false;
                }
            } else {
                if (isIdentPart) {
                    out.append(c);
                } else {
                    out.append('_');
                }
            }
        }

        while (out.length() > 0 && out.charAt(out.length() - 1) == '.') {
            out.deleteCharAt(out.length() - 1);
        }

        if (out.length() == 0) {
            return "x";
        }

        return out.toString();
    }

    private static String whitespace(int count, boolean multiline) {
        StringBuilder sb = new StringBuilder(count);
        for (int i = 0; i < count; i++) {
            if (multiline) {
                sb.append((i & 1) == 0 ? '\n' : '\t');
            } else {
                sb.append((i & 1) == 0 ? ' ' : '\r');
            }
        }
        return sb.toString();
    }
}
