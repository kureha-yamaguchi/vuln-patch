package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static final String[] ANCHORS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (String anchor : ANCHORS) {
            String escaped = StringEscapeUtils.escapeCsv(anchor);
            if (!anchor.equals(escaped)) {
                throw new RuntimeException("anchor mismatch");
            }
        }

        String explored1 = buildExplorationInput(data);
        String explored2 = buildExplorationInput(data);

        StringEscapeUtils.escapeCsv(explored1);
        StringEscapeUtils.escapeCsv(explored2);

        String metamorphicInput = buildExplorationInput(data);
        String roundTrip = StringEscapeUtils.unescapeCsv(StringEscapeUtils.escapeCsv(metamorphicInput));
        if (!metamorphicInput.equals(roundTrip)) {
            throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x");
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        String prefix = data.consumeAsciiString(12);
        String middle = data.consumeAsciiString(12);
        String suffix = data.consumeAsciiString(12);
        int pairCount = data.consumeInt(1, 3);
        boolean includeCsvSpecials = data.consumeBoolean();
        int layout = data.consumeInt(0, 2);

        String pairs = buildSupplementaryBlock(data, pairCount, includeCsvSpecials);

        StringBuilder sb = new StringBuilder();
        switch (layout) {
            case 0:
                sb.append(pairs).append(prefix).append(middle).append(suffix);
                break;
            case 1:
                sb.append(prefix).append(pairs).append(middle).append(suffix);
                break;
            default:
                sb.append(prefix).append(middle).append(suffix).append(pairs);
                break;
        }

        if (sb.length() == 0) {
            sb.append(toSupplementary(data.consumeInt(0x10000, 0x10FFFF)));
        }
        return sb.toString();
    }

    private static String buildSupplementaryBlock(FuzzedDataProvider data, int pairCount, boolean includeCsvSpecials) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            if (includeCsvSpecials && data.consumeBoolean()) {
                sb.append(randomCsvSpecial(data));
            }
            sb.append(toSupplementary(data.consumeInt(0x10000, 0x10FFFF)));
            if (includeCsvSpecials && data.consumeBoolean()) {
                sb.append(randomCsvSpecial(data));
            }
            if (i + 1 < pairCount) {
                sb.append(data.consumeAsciiString(4));
            }
        }
        return sb.toString();
    }

    private static char randomCsvSpecial(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 3)) {
            case 0:
                return ',';
            case 1:
                return '"';
            case 2:
                return '\r';
            default:
                return '\n';
        }
    }

    private static String toSupplementary(int codePoint) {
        return new String(Character.toChars(codePoint));
    }
}
