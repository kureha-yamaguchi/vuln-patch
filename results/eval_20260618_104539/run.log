        Node seedName = Node.newString(Token.NAME, "x");
        seedName.addChildToBack(seedString);
        Node seedVar = new Node(Token.VAR);
        seedVar.addChildToBack(seedName);
        Node seedScript = new Node(Token.SCRIPT);
        seedScript.addChildToBack(seedVar);

        String actualSeed = new CodePrinter.Builder(seedScript).build();
        if (!expected.equals(actualSeed)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: expected " + expected + " but got "
                    + actualSeed.replace("\u007f", "\\u007f"));
        }

        String prefix = data.consumeString(16);
        String middle = data.consumeString(16);
        String suffix = data.consumeString(16);
        boolean sharesTriggerProperty = data.consumeBoolean();

        String fuzzValue;
        if (sharesTriggerProperty) {
