package org.apache.commons.math3.complex;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Complex actual = Complex.ZERO.reciprocal();
        Complex expected = Complex.INF;
        if (!actual.equals(expected)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: Complex.ZERO.reciprocal() != Complex.INF"
            );
        }

        boolean zeroFamily = data.consumeBoolean();
        double real;
        double imaginary;

        if (zeroFamily) {
            real = data.consumeBoolean() ? 0.0d : -0.0d;
            imaginary = data.consumeBoolean() ? 0.0d : -0.0d;
        } else {
            real = (double) data.consumeInt();
            imaginary = (double) data.consumeInt();
        }

        Complex candidate = new Complex(real, imaginary);
        candidate.abs();
        Complex reciprocal = candidate.reciprocal();

        if (real == 0.0d && imaginary == 0.0d) {
            if (!reciprocal.equals(Complex.INF)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: reciprocal of a zero-valued Complex did not equal Complex.INF"
                );
            }
        }

        double secondaryReal = (double) data.consumeInt();
        double secondaryImaginary = (double) data.consumeInt();
        if (secondaryReal == 0.0d && secondaryImaginary == 0.0d) {
            secondaryReal = 1.0d;
        }
        Complex secondary = new Complex(secondaryReal, secondaryImaginary);
        secondary.abs();
        secondary.reciprocal();
    }
}
