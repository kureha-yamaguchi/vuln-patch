            Collections.singletonMap("lower", new LowerFormatFactory());

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchorPattern = "it''s a {0,lower} 'test'!";
        ExtendedMessageFormat anchor = new ExtendedMessageFormat(anchorPattern, REGISTRY);
        String anchorOut = anchor.format(new Object[] { "DUMMY" });
        if (!"it's a dummy test!".equals(anchorOut)) {
            throw new RuntimeException("metamorphic violation: anchor output pattern=" + anchorPattern + " out=" + anchorOut);
        }

        String left = sanitize(data.consumeAsciiString(32));
        String right = sanitize(data.consumeAsciiString(32));
        String tail = sanitize(data.consumeAsciiString(32));
        String arg = data.consumeString(32);

        String pattern1 = left + "''" + right + " {0,lower}";
        ExtendedMessageFormat emf1 = new ExtendedMessageFormat(pattern1, REGISTRY);
        String out1 = emf1.format(new Object[] { arg });
        String expected1 = left + "'" + right + " " + lower(arg);
        if (!expected1.equals(out1)) {
            throw new RuntimeException("metamorphic violation: escaped-quote literal recovery pattern=" + pattern1 + " expected=" + expected1 + " actual=" + out1);
        }

        String pattern2 = "'" + tail + "' " + left + "''" + right + " {0,lower} '" + tail + "'";
        ExtendedMessageFormat emf2 = new ExtendedMessageFormat(pattern2, REGISTRY);
        String out2 = emf2.format(new Object[] { arg });
        String expected2 = tail + " " + left + "'" + right + " " + lower(arg) + " " + tail;
        if (!expected2.equals(out2)) {
            throw new RuntimeException("metamorphic violation: quoted and escaped sections pattern=" + pattern2 + " expected=" + expected2 + " actual=" + out2);
        }

        String pattern3 = left + " {0,lower} " + right + "''" + tail;
        ExtendedMessageFormat emf3 = new ExtendedMessageFormat(pattern3, REGISTRY);
        String out3 = emf3.format(new Object[] { arg });
        String expected3 = left + " " + lower(arg) + " " + right + "'" + tail;
        if (!expected3.equals(out3)) {
            throw new RuntimeException("metamorphic violation: escaped quote after format element pattern=" + pattern3 + " expected=" + expected3 + " actual=" + out3);
        }

        MessageFormat mf = new MessageFormat(left + "''" + right + " {0}");
        String baseline = mf.format(new Object[] { lower(arg) });
        if (!baseline.equals(out1)) {
            throw new RuntimeException("metamorphic violation: ExtendedMessageFormat must agree with MessageFormat on standard quoting semantics pattern=" + pattern1 + " baseline=" + baseline + " actual=" + out1);
        }
    }

    private static String sanitize(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '{' || ch == '}' || ch == '\'') {
                b.append('x');
            } else {
                b.append(ch);
            }
        }
        return b.toString();
    }

    private static String lower(String s) {
        return s == null ? "null" : s.toLowerCase(Locale.ROOT);
    }

    private static final class LowerFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return LowerFormat.INSTANCE;
        }
    }

    private static final class LowerFormat extends Format {
        private static final LowerFormat INSTANCE = new LowerFormat();

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            toAppendTo.append(lower(String.valueOf(obj)));
            return toAppendTo;
        }

        public Object parseObject(String source, ParsePosition pos) {
            pos.setIndex(source.length());
            return source;
        }
    }
}
