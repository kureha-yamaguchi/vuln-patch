package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Collections;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = Collections.EMPTY_MAP;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        String arg = data.consumeString(32);
        int index = data.consumeInt(0, 2);

        String prefix = sanitizeLiteral(data.consumeString(24));
        String infix = sanitizeLiteral(data.consumeString(24));
        String quoted = sanitizeQuotedLiteral(data.consumeString(24));
        String suffix = sanitizeLiteral(data.consumeRemainingAsString());

        if (quoted.length() == 0) {
            quoted = "test";
        }

        String patternA = prefix + "''" + infix + " {" + index + "} '" + quoted + "'" + suffix;
        String patternB = prefix + "''" + infix + " {" + index + "} " + quoted + suffix;

        String[] args = new String[index + 1];
        for (int i = 0; i < args.length; i++) {
            args[i] = (i == index) ? arg : "";
        }

        tryFormat(patternA, args);

        String lhs;
        try {
            lhs = format(patternA, args);
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        String rhs;
        try {
            rhs = format(patternB, args);
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        /*
         * Contract asserted: in MessageFormat-style patterns, quoting ordinary literal text
         * that contains no syntax characters is semantically unnecessary; therefore
         * "... 'abc' ..." and "... abc ..." must format identically. A "fix" that merely
         * skips the quoted-string branch or drops its bookkeeping can stop crashing while
         * producing the wrong formatted output, and this relation detects that.
         */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                "metamorphic violation: quoted plain literal should equal unquoted literal input=" +
                patternA + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void exerciseAnchor() {
        String pattern = "it''s a {0,lower} 'test'!";
        Object[] args = new Object[] { "DUMMY" };
        try {
            format(pattern, args);
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static String format(String pattern, Object[] args) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, REGISTRY);
        return emf.format(args);
    }

    private static void tryFormat(String pattern, Object[] args) {
        try {
            format(pattern, args);
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void handleThrowable(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:")) {
            throw (RuntimeException) t;
        }
        if (t instanceof IllegalArgumentException) {
            return;
        }
        if (isRootCause(t)) {
            sneakyThrow(t);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
