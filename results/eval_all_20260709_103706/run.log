package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

/*
 * Metamorphic contract asserted:
 * Reordering the same set of linear constraints must not change the optimal solution/value
 * for a correct linear-programming solver. A patch that merely deletes or bypasses the
 * artificial-variable tie-breaking logic in getPivotRow can avoid the original throw yet
 * still pivot differently, cycle, or silently return a different answer. We therefore solve
 * the same LP twice with the same real API but different constraint order and require the
 * returned optimum to agree whenever both calls succeed.
 */
public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.LEQ, 2.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0}, Relationship.LEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 1.0}, Relationship.LEQ, 2.0));

        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] {1.0, 0.0}, 0.0);
        runAndCheck(f, constraints, true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 5);
        double[] objective = new double[vars];
        for (int i = 0; i < vars; i++) {
            objective[i] = data.consumeInt(-3, 6);
        }
        boolean maximize = data.consumeBoolean();
        boolean nonNegative = true;

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] duplicateRow = new double[vars];
        boolean anyPositive = false;
        for (int i = 0; i < vars; i++) {
            int c = data.consumeInt(0, 4);
            duplicateRow[i] = c;
            if (c > 0) {
                anyPositive = true;
            }
        }
        if (!anyPositive) {
            duplicateRow[0] = 1.0;
        }

        double geqRhs = data.consumeInt(0, 3);
        constraints.add(new LinearConstraint(duplicateRow.clone(), Relationship.GEQ, geqRhs));
        constraints.add(new LinearConstraint(duplicateRow.clone(), Relationship.GEQ, geqRhs));

        for (int i = 0; i < vars; i++) {
            double[] unit = new double[vars];
            unit[i] = 1.0;
            constraints.add(new LinearConstraint(unit, Relationship.LEQ, data.consumeInt(1, 8)));
        }

        int extra = data.consumeInt(0, 4);
        for (int k = 0; k < extra; k++) {
            double[] row = new double[vars];
            boolean pos = false;
            for (int i = 0; i < vars; i++) {
                int c = data.consumeInt(0, 3);
                row[i] = c;
                if (c > 0) {
                    pos = true;
                }
            }
            if (!pos) {
                row[data.consumeInt(0, vars - 1)] = 1.0;
            }
            Relationship rel = data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ;
            double rhs = rel == Relationship.LEQ ? data.consumeInt(0, 12) : data.consumeInt(0, 4);
            constraints.add(new LinearConstraint(row, rel, rhs));
        }

        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, data.consumeInt(-2, 2));
        runAndCheck(f, constraints, nonNegative, maximize);
    }

    private static void runAndCheck(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean nonNegative) {
        runAndCheck(f, constraints, nonNegative, true);
    }

    private static void runAndCheck(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean nonNegative, boolean maximize) {
        GoalType goal = maximize ? GoalType.MAXIMIZE : GoalType.MINIMIZE;

        try {
            PointValuePair lhs = runProblem(f, constraints, goal, nonNegative);
            PointValuePair rhs = null;
            try {
                List<LinearConstraint> reordered = new ArrayList<LinearConstraint>(constraints);
                Collections.reverse(reordered);
                rhs = runProblem(f, reordered, goal, nonNegative);
            } catch (Throwable t) {
                if (shouldPropagate(t)) {
                    throw rethrow(t);
                }
                return;
            }

            if (lhs != null && rhs != null && !sameSolution(lhs, rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: constraint-order invariance lhsValue=" + lhs.getValue() +
                    " rhsValue=" + rhs.getValue() +
                    " lhsPoint=" + formatPoint(lhs.getPoint()) +
                    " rhsPoint=" + formatPoint(rhs.getPoint()));
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throw rethrow(t);
            }
        }
    }

    private static PointValuePair runProblem(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, GoalType goal, boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        return solver.optimize(f, constraints, goal, nonNegative);
    }

    private static boolean sameSolution(PointValuePair a, PointValuePair b) {
        if (Math.abs(a.getValue() - b.getValue()) > 1.0e-7) {
            return false;
        }
        double[] ap = a.getPoint();
        double[] bp = b.getPoint();
        if (ap == null || bp == null) {
            return ap == bp;
        }
        if (ap.length != bp.length) {
            return false;
        }
        for (int i = 0; i < ap.length; i++) {
            if (Math.abs(ap[i] - bp[i]) > 1.0e-7) {
                return false;
            }
        }
        return true;
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
            return true;
        }
        if (t instanceof MaxCountExceededException && passesThroughRootCauseRegion(t)) {
            return true;
        }
        if (isCleanRejection(t)) {
            return false;
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
