public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runProblem(buildBealeCyclingLikeProblem());
        runProblem(buildMath828ShapedProblem(data));
