package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.MessageFormat;
import java.util.HashMap;
import java.util.Map;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        String anchorPattern = "it''s a {0,lower} 'test'!";
        tryExtendedMessageFormat(anchorPattern, registry, "DUMMY", false);

        String prefix = sanitize(data.consumeAsciiString(32));
        String middle = sanitize(data.consumeAsciiString(32));
        String quoted = sanitize(data.consumeAsciiString(32));
        String suffix = sanitize(data.consumeAsciiString(32));
        String arg = sanitizeArg(data.consumeRemainingAsString());

        String pattern1 = prefix + "''" + middle + "{0}" + "'" + quoted + "'" + suffix;
        tryExtendedMessageFormat(pattern1, registry, arg, true);

        String pattern2 = "'" + prefix + "'" + "''" + middle + "{0}" + suffix;
        tryExtendedMessageFormat(pattern2, registry, arg, true);

        String pattern3 = prefix + "{0}" + middle + "''" + suffix;
        tryExtendedMessageFormat(pattern3, registry, arg, true);

        String pattern4 = "''" + prefix + "'" + middle + "'" + "{0}" + suffix;
        tryExtendedMessageFormat(pattern4, registry, arg, true);

        String pattern5 = prefix + "''" + middle + " " + "{0}" + " " + "'" + quoted + " " + suffix + "'";
        tryExtendedMessageFormat(pattern5, registry, arg, true);
    }

    private static void tryExtendedMessageFormat(String pattern, Map registry, String arg, boolean checkMetamorphic) {
        String emfResult = null;
        boolean emfOk = false;
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);
            emfResult = emf.format(new Object[] { arg });
            emfOk = true;
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (!checkMetamorphic) {
            return;
        }

        String mfResult;
        try {
            mfResult = new MessageFormat(pattern).format(new Object[] { arg });
        } catch (Throwable t) {
            return;
        }

        if (!emfOk) {
            return;
        }

        /*
         * Contract asserted: for patterns without any registered custom format usage,
         * ExtendedMessageFormat must behave like MessageFormat. Our explore patterns
         * contain only standard {0} elements plus quoting, so deleting the patched
         * bookkeeping step would either crash or silently mis-handle escaped quotes,
         * causing a disagreement with the real MessageFormat result.
         */
        if (!safeEquals(emfResult, mfResult)) {
            throw new RuntimeException(
                "metamorphic violation: ExtendedMessageFormat vs MessageFormat"
                    + " input=" + pattern
                    + " lhs=" + emfResult
                    + " rhs=" + mfResult);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(e.getClassName())
                    && "appendQuotedString".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidation(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Validation")
                || name.contains("Invalid")
                || name.contains("Malformed")
                || name.contains("Parse");
    }

    private static String sanitize(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == ' ' || c == '_' || c == '-' || c == '.') {
                out.append(c);
            } else {
                out.append('x');
            }
        }
        return out.toString();
    }

    private static String sanitizeArg(String s) {
        if (s == null) {
            return "";
        }
        return s.replace('{', 'x').replace('}', 'x');
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
