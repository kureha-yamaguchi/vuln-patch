                    || "getHeight".equals(m)
                    || "getWidth".equals(m)
                    || "getEntry".equals(m)
                    || "getNumArtificialVariables".equals(m)
                    || "getArtificialVariableOffset".equals(m)
                    || "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls)
                    && ("getRowDimension".equals(m) || "getColumnDimension".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.BlockRealMatrix".equals(cls)
                    && ("getRowDimension".equals(m) || "getColumnDimension".equals(m))) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
