        // and proportional RHS, a property that encourages a tie in the minimum-ratio test while
        // phase 1 artificial variables are present.
        int pivotCol = data.consumeInt(0, n - 1);
        for (int i = 0; i < positiveCount; i++) {
            double[] row = new double[n];
            row[pivotCol] = 1.0;
            for (int j = 0; j < n; j++) {
                if (j == pivotCol) {
                    continue;
                }
                int v = data.consumeInt(-4, 9);
                row[j] = v;
