package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        int vars = 6;
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective(vars), 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(eqPair(vars, 1, 2.0, true));
        constraints.add(eqPair(vars, 1, 2.0, false));
        constraints.add(eqPair(vars, 2, 3.0, true));
        constraints.add(eqPair(vars, 2, 3.0, false));
        constraints.add(eqPair(vars, 3, 5.0, true));
        constraints.add(eqPair(vars, 3, 5.0, false));
        constraints.add(eqPair(vars, 4, 7.0, true));
        constraints.add(eqPair(vars, 4, 7.0, false));
        constraints.add(eqPair(vars, 5, 11.0, true));
        constraints.add(eqPair(vars, 5, 11.0, false));

        for (int i = 1; i < vars; i++) {
            double[] ub = new double[vars];
            ub[i] = 1.0;
            constraints.add(new LinearConstraint(ub, Relationship.LEQ, 1.0));
        }

        if (reachesChangedBranch(f, constraints)) {
            new SimplexSolver().optimize(f, constraints, GoalType.MAXIMIZE, true);
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        int vars = data.consumeInt(4, 10);
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective(vars), 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        int pairs = data.consumeInt(2, vars - 1);
        for (int i = 0; i < pairs; i++) {
            int var = 1 + (i % (vars - 1));
            double a = data.consumeInt(1, 20);
            double b = data.consumeBoolean() ? 1.0 : data.consumeInt(1, 3);
            constraints.add(boundPair(vars, var, a, b, true));
            constraints.add(boundPair(vars, var, a, b, false));
        }

        int extras = data.consumeInt(0, vars);
        for (int i = 0; i < extras; i++) {
            int var = data.consumeInt(1, vars - 1);
            double[] ub = new double[vars];
            ub[var] = 1.0;
            constraints.add(new LinearConstraint(ub, Relationship.LEQ, data.consumeBoolean() ? 1.0 : 0.0));
        }

        if (reachesChangedBranch(f, constraints)) {
            new SimplexSolver().optimize(f, constraints, GoalType.MAXIMIZE, true);
        }
    }

    private static double[] objective(int vars) {
        double[] c = new double[vars];
        c[0] = 1.0;
        return c;
    }

    private static LinearConstraint eqPair(int vars, int var, double a, boolean geq) {
        double[] row = new double[vars];
        row[0] = 1.0;
        row[var] = a;
        return new LinearConstraint(row, geq ? Relationship.GEQ : Relationship.LEQ, 1.0);
    }

    private static LinearConstraint boundPair(int vars, int var, double a, double rhs, boolean geq) {
        double[] row = new double[vars];
        row[0] = 1.0;
        row[var] = a;
        return new LinearConstraint(row, geq ? Relationship.GEQ : Relationship.LEQ, rhs);
    }

    private static boolean reachesChangedBranch(LinearObjectiveFunction f, Collection<LinearConstraint> constraints) {
        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, 10);
        int pivotCol = initialPivotColumn(tableau);
        if (pivotCol < 0) {
            return false;
        }

        List<Integer> tiedRows = minRatioRows(tableau, pivotCol);
        if (tiedRows.size() < 2) {
            return false;
        }

        boolean hasArtificialBasic = false;
        boolean hasNonArtificialBasic = false;
        for (Integer row : tiedRows) {
            if (isArtificialBasicRow(tableau, row.intValue())) {
                hasArtificialBasic = true;
            } else {
                hasNonArtificialBasic = true;
            }
        }
        return hasArtificialBasic && hasNonArtificialBasic;
    }

    private static int initialPivotColumn(SimplexTableau tableau) {
        double minValue = 0.0;
        int minPos = -1;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (entry < minValue) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos;
    }

    private static List<Integer> minRatioRows(SimplexTableau tableau, int col) {
        List<Integer> rows = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);
            if (entry > 0.0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    rows.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    rows.clear();
                    rows.add(Integer.valueOf(i));
                }
            }
        }
        return rows;
    }

