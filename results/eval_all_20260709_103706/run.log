        constraints.add(new LinearConstraint(
                new double[] { -0.5, 1.5, 0.5, -1.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(
                new double[] { -1.0, 0.0, 0.0, 0.0 }, Relationship.GEQ, -1.0));

        return new Problem(f, constraints, GoalType.MAXIMIZE, true);
