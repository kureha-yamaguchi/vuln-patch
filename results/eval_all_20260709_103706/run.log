            constraints.add(new LinearConstraint(row, Relationship.GEQ, rhs));
            if (data.consumeBoolean()) {
                constraints.add(new LinearConstraint(row.clone(), Relationship.GEQ, rhs));
            }
        }

        // Add dense mostly-negative GEQ rows, mirroring the shape of the regression trigger.
        for (int i = 0; i < negativeCount; i++) {
            double[] row = new double[n];
            row[0] = 70.0 + data.consumeInt(0, 30);
            for (int j = 1; j < n; j++) {
                row[j] = -1.0 * (1 + data.consumeInt(0, 99));
            }
            double rhs = -1.0 * (1 + data.consumeInt(0, 60));
            constraints.add(new LinearConstraint(row, Relationship.GEQ, rhs));
        }

        // Force artificial variables to exist regardless of random choices.
        if (constraints.isEmpty()) {
            double[] row = new double[n];
            row[0] = 1.0;
            constraints.add(new LinearConstraint(row, Relationship.GEQ, 1.0));
        }

        boolean nonNegative = data.consumeBoolean();
        return new Problem(new LinearObjectiveFunction(objective, 0.0), constraints, nonNegative);
    }

    private static final class Problem {
        final LinearObjectiveFunction objective;
        final List<LinearConstraint> constraints;
        final boolean restrictToNonNegative;

        Problem(LinearObjectiveFunction objective, List<LinearConstraint> constraints, boolean restrictToNonNegative) {
