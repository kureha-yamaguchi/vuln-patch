package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCandidate(anchorProblem());
        runCandidate(exploreProblem(data));
    }

    private static void runCandidate(Problem p) {
        if (p == null) {
            return;
        }

        try {
            PointValuePair a = solve(p.objective, p.constraints, p.restrictToNonNegative);
            if (a != null) {
                // Metamorphic relation:
                // The feasible region defined by a set of linear constraints is independent of the
                // order in which the constraints are supplied, so a correct optimizer must return
                // the same optimum value for the same problem after reordering the constraints.
                // A "fix" that merely skips the problematic branch in pivot-row selection can silently
                // change the pivot path and produce a different answer instead of throwing.
                List<LinearConstraint> reversed = new ArrayList<LinearConstraint>(p.constraints);
                Collections.reverse(reversed);
                PointValuePair b = solve(p.objective, reversed, p.restrictToNonNegative);
                if (b != null) {
                    double va = a.getValue();
                    double vb = b.getValue();
                    if (Double.isNaN(va) != Double.isNaN(vb)
                            || (!Double.isNaN(va) && !Double.isInfinite(va) && !Double.isInfinite(vb)
                                    && Math.abs(va - vb) > 1.0e-7 * Math.max(1.0, Math.max(Math.abs(va), Math.abs(vb))))
                            || (Double.isInfinite(va) != Double.isInfinite(vb))) {
                        throw new RuntimeException("metamorphic violation: constraint-order objective mismatch lhs=" + va + " rhs=" + vb);
                    }
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static PointValuePair solve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean nonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver();
            solver.setMaxIterations(100);
            return solver.optimize(f, constraints, GoalType.MINIMIZE, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        return (t instanceof MathIllegalArgumentException) || (t instanceof MathIllegalStateException && !(t instanceof MaxCountExceededException));
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:");
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(c)
                    && ("getPivotRow".equals(m) || "doIteration".equals(m) || "solvePhase1".equals(m) || "doOptimize".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(c)
                    && ("getNumObjectiveFunctions".equals(m) || "getHeight".equals(m) || "getWidth".equals(m)
                            || "getEntry".equals(m) || "getNumArtificialVariables".equals(m)
                            || "getArtificialVariableOffset".equals(m) || "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(c)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(c)
                    && ("getEntry".equals(m) || "getRowDimension".equals(m) || "getColumnDimension".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

