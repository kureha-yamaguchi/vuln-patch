    private static void runProblem(Problem p) {
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        PointValuePair lhs = solver.optimize(p.f, p.constraints, p.goalType, p.nonNegative);

        // Metamorphic relation:
        // Reordering constraints does not change the feasible region of a linear program,
        // so any correct simplex implementation must compute the same optimum value.
        // A patch that merely makes the buggy pivot-row branch unreachable can still return
        // a wrong optimum; this observable check catches that silent misbehavior.
        List<LinearConstraint> reversed = new ArrayList<LinearConstraint>(p.constraints);
        Collections.reverse(reversed);

        SimplexSolver solver2 = new SimplexSolver();
        solver2.setMaxIterations(100);
        PointValuePair rhs = solver2.optimize(p.f, reversed, p.goalType, p.nonNegative);

        double a = lhs.getValue();
        double b = rhs.getValue();
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        if (Double.isNaN(a) != Double.isNaN(b)
                || Double.isInfinite(a) != Double.isInfinite(b)
                || (!Double.isNaN(a) && !Double.isInfinite(a) && Math.abs(a - b) > 1.0e-8 * scale)) {
            throw new RuntimeException("metamorphic violation: constraint order changed optimum lhs=" + a + " rhs=" + b);
        }
    }

