package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;

public class FuzzHarness {
    private static final double EPS = 1e-7;

    private static final class Problem {
        final LinearObjectiveFunction objective;
        final Collection<LinearConstraint> constraints;
        final boolean restrictToNonNegative;

        Problem(LinearObjectiveFunction objective, Collection<LinearConstraint> constraints, boolean restrictToNonNegative) {
            this.objective = objective;
            this.constraints = constraints;
            this.restrictToNonNegative = restrictToNonNegative;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAndCheck(anchorProblem());
        runAndCheck(explorationProblem(data));
    }

    private static void runAndCheck(Problem p) {
        try {
            runProblem(p);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseCrash(t)) {
                throwUnchecked(t);
            }
            return;
        }

        // Contract asserted: a linear program is defined by its objective and set of constraints;
        // permuting the constraints does not change the optimization problem, so any correct solver
        // must return the same optimum for the original and permuted collections when both calls succeed.
        // A "fix" that merely skips the artificial-variable tie-breaking branch can silently steer the
        // simplex down a different path and produce a wrong optimum or wrong basic solution even if it no
        // longer throws, which this permutation-invariance check detects.
        Problem permuted = permuteProblem(p);
        org.apache.commons.math3.optimization.PointValuePair lhs;
        org.apache.commons.math3.optimization.PointValuePair rhs;
        try {
            lhs = runProblem(p);
            rhs = runProblem(permuted);
        } catch (Throwable t) {
            return;
        }
        if (!sameSolution(lhs, rhs)) {
            throw new RuntimeException(
                    "metamorphic violation: constraint permutation changed optimum lhsValue=" + lhs.getValue() +
                    " rhsValue=" + rhs.getValue());
        }
    }

    private static org.apache.commons.math3.optimization.PointValuePair runProblem(Problem p) {
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        return solver.optimize(
                p.objective,
                p.constraints,
                org.apache.commons.math3.optimization.GoalType.MINIMIZE,
                p.restrictToNonNegative);
    }

    private static Problem permuteProblem(Problem p) {
        ArrayList<LinearConstraint> src = new ArrayList<LinearConstraint>(p.constraints);
        ArrayList<LinearConstraint> dst = new ArrayList<LinearConstraint>(src.size());
        if (src.size() <= 1) {
            dst.addAll(src);
        } else {
            dst.add(src.get(src.size() - 1));
            for (int i = 0; i < src.size() - 1; i++) {
                dst.add(src.get(i));
            }
        }
        return new Problem(p.objective, dst, p.restrictToNonNegative);
    }

    private static boolean sameSolution(org.apache.commons.math3.optimization.PointValuePair a,
                                        org.apache.commons.math3.optimization.PointValuePair b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (Math.abs(a.getValue() - b.getValue()) > EPS) {
            return false;
        }
        double[] ap = a.getPoint();
        double[] bp = b.getPoint();
        if (ap == null || bp == null) {
            return ap == bp;
        }
        if (ap.length != bp.length) {
            return false;
        }
        for (int i = 0; i < ap.length; i++) {
            if (Math.abs(ap[i] - bp[i]) > EPS) {
                return false;
            }
        }
        return true;
    }

