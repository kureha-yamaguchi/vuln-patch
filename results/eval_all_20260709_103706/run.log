package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.MessageFormat;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor1 = "it''s a {0} 'test'!";
        checkPattern(anchor1, "DUMMY");

        String anchor2 = "a''b {0}";
        checkPattern(anchor2, "X");

        String anchor3 = "''{0}";
        checkPattern(anchor3, "Y");

        String a = cleanLiteral(data.consumeAsciiString(24));
        String b = cleanLiteral(data.consumeAsciiString(24));
        String c = cleanLiteral(data.consumeAsciiString(24));
        String d = cleanLiteral(data.consumeAsciiString(24));
        String arg = cleanArgument(data.consumeRemainingAsString());

        String pattern1 = a + "''" + b + "{0}" + c;
        checkPattern(pattern1, arg);

        String pattern2 = a + "''" + b + " {0} '" + c + "' " + d;
        checkPattern(pattern2, arg);

        String pattern3 = "'" + a + "' " + b + "''" + c + " {0} " + d;
        checkPattern(pattern3, arg);

        String pattern4 = a + "''" + b + "''" + c + "{0}" + d;
        checkPattern(pattern4, arg);

        String pattern5 = a + "{0}" + b + "''" + c + " '" + d + "'";
        checkPattern(pattern5, arg);
    }

    private static void checkPattern(String pattern, String arg) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern);
        String emfResult = emf.format(new Object[] { arg });

        MessageFormat mf = new MessageFormat(pattern);
        String mfResult = mf.format(new Object[] { arg });

        /*
         * Contract: with no custom registry involved, ExtendedMessageFormat must behave
         * like MessageFormat for the same valid pattern. The patched branch handles an
         * escaped quote and advances the parse position; deleting that advancement can
         * make parsing loop or corrupt reconstruction, so comparing to MessageFormat
         * detects silent wrong-output fixes as well as crashes.
         */
        if (!emfResult.equals(mfResult)) {
            throw new RuntimeException(
                "metamorphic violation: pattern=" + pattern + " lhs=" + emfResult + " rhs=" + mfResult);
        }
    }

    private static String cleanLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '\'' || ch == '{' || ch == '}') {
                out.append('x');
            } else {
                out.append(ch);
            }
        }
        return out.toString();
    }

    private static String cleanArgument(String s) {
        if (s == null) {
            return "";
        }
        return s.replace('{', 'x').replace('}', 'x');
    }
}
