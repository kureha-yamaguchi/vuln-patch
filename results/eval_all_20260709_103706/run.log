package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    /*
     * Metamorphic guarantee asserted below:
     * Adding an exact duplicate linear constraint does not change the feasible set,
     * therefore a correct optimizer must return the same optimal objective value.
     * A "fix" that merely avoids the problematic branch or silently picks a wrong pivot
     * can still terminate but produce a different objective value, which this detects.
     * Per the harness rules, if either side throws, the relation is skipped.
     */

    private static void runAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 1.0}, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 1.0}, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0, 0.0}, Relationship.LEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 0.0}, Relationship.LEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 0.0, 1.0}, Relationship.LEQ, 1.0));

        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] {1.0, 0.0, 0.0}, 0.0);
        runAndCheck(f, constraints);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 8);

        double[] objective = new double[vars];
        objective[0] = 1.0;

        double[] duplicate = new double[vars];
        duplicate[0] = 0.0;
        double rhs = 0.0;

        for (int i = 1; i < vars; i++) {
            int coeff = data.consumeInt(1, 5);
            duplicate[i] = coeff;
            rhs += data.consumeInt(0, coeff);
        }

        if (rhs <= 0.0) {
            rhs = 1.0;
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(duplicate.clone(), Relationship.GEQ, rhs));
        constraints.add(new LinearConstraint(duplicate.clone(), Relationship.GEQ, rhs));

        double x0ub = data.consumeInt(0, 10);
        constraints.add(new LinearConstraint(unit(vars, 0), Relationship.LEQ, x0ub));

        for (int i = 1; i < vars; i++) {
            double ub = data.consumeInt((int) Math.ceil(rhs / Math.max(1.0, duplicate[i])), 10 + (int) rhs);
            constraints.add(new LinearConstraint(unit(vars, i), Relationship.LEQ, ub));
        }

        if (data.consumeBoolean()) {
            double[] sum = new double[vars];
            for (int i = 0; i < vars; i++) {
                sum[i] = data.consumeInt(0, 3);
            }
            double sumUb = 0.0;
            for (int i = 0; i < vars; i++) {
                if (sum[i] > 0) {
                    sumUb += sum[i] * data.consumeInt(0, 5);
                }
            }
            constraints.add(new LinearConstraint(sum, Relationship.LEQ, sumUb + x0ub + rhs + 1.0));
        }

        if (data.consumeBoolean()) {
            Collections.rotate(constraints, data.consumeInt(0, constraints.size() - 1));
        }

        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, data.consumeInt(-3, 3));
        runAndCheck(f, constraints);
    }

    private static double[] unit(int n, int idx) {
        double[] v = new double[n];
        v[idx] = 1.0;
        return v;
    }

    private static void runAndCheck(LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        try {
            runProblem(f, constraints);
        } catch (RuntimeException t) {
            if (isMetamorphicViolation(t)) {
                throw t;
            }
        }

        try {
            PointValuePair lhs = runProblem(f, constraints);

            ArrayList<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(constraints);
            if (!constraints.isEmpty()) {
                duplicated.add(constraints.get(0));
            }

            PointValuePair rhs = runProblem(f, duplicated);

            if (lhs != null && rhs != null) {
                double lv = lhs.getValue();
                double rv = rhs.getValue();
                if (Double.isNaN(lv) != Double.isNaN(rv) || Math.abs(lv - rv) > 1.0e-8) {
                    throw new RuntimeException(
                        "metamorphic violation: duplicate-constraint objective invariance lhs=" + lv +
                        " rhs=" + rv +
                        " constraints=" + constraints.size() +
                        " duplicated=" + duplicated.size());
                }
            }
        } catch (RuntimeException t) {
            if (isMetamorphicViolation(t)) {
                throw t;
            }
        }
    }

    private static PointValuePair runProblem(LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static boolean isMetamorphicViolation(RuntimeException t) {
        String m = t.getMessage();
        return m != null && m.startsWith("metamorphic violation:");
    }
}
