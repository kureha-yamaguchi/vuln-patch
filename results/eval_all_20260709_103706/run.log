    private static void runAndCheck(double[] objective, ArrayList<LinearConstraint> constraints, boolean anchor) {
        PointValuePair first;
        try {
            first = solve(objective, constraints);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        ArrayList<LinearConstraint> reversed = new ArrayList<LinearConstraint>(constraints);
        Collections.reverse(reversed);

        PointValuePair second;
        try {
            second = solve(objective, reversed);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        /* Contract used for this metamorphic check:
           A linear program's feasible set and optimum are defined by the set of constraints,
           not by the iteration order of that set. Reordering the same constraints must not
           change the returned optimum when both calls succeed. A patch that merely makes the
           buggy branch unreachable or picks the wrong pivot row can silently return a different
           solution or objective under a different constraint order, which this detects. */
        double v1 = first.getValue();
        double v2 = second.getValue();
        if (!sameDouble(v1, v2)) {
            throw new RuntimeException("metamorphic violation: constraint-order objective changed anchor=" + anchor
                    + " lhs=" + v1 + " rhs=" + v2 + " constraints=" + constraints.size()
                    + " vars=" + objective.length);
        }

        double[] p1 = first.getPoint();
        double[] p2 = second.getPoint();
        if (p1 != null && p2 != null && p1.length == p2.length) {
            for (int i = 0; i < p1.length; i++) {
                if (!sameDouble(p1[i], p2[i])) {
                    throw new RuntimeException("metamorphic violation: constraint-order point changed anchor=" + anchor
                            + " index=" + i + " lhs=" + p1[i] + " rhs=" + p2[i]
                            + " value1=" + v1 + " value2=" + v2);
                }
            }
        }
    }

    private static PointValuePair solve(double[] objective, List<LinearConstraint> constraints) {
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= 1.0e-7 * scale;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        return t instanceof org.apache.commons.math3.exception.MathIllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof org.apache.commons.math3.exception.MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(m)) {
