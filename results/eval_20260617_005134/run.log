    private static List<SubHyperplane> buildSubHyperplanes(double[] coords, int[] indices) throws Exception {
        List<SubHyperplane> list = new ArrayList<>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;
            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            SubHyperplane polyFace = buildPolygon(new Vector3D[]{v1, v2, v3});
            list.add(polyFace);
        }
        return list;
    }

    private static SubHyperplane buildPolygon(Vector3D[] vertices) throws Exception {
        Class<?> polygonCls = Class.forName("org.apache.commons.math3.geometry.euclidean.threed.Polygon");
        // Try various constructors
        try {
            Constructor<?> ctor = polygonCls.getConstructor(Vector3D[].class);
            return (SubHyperplane) ctor.newInstance((Object) vertices);
        } catch (NoSuchMethodException e1) {
            try {
                Constructor<?> ctor = polygonCls.getConstructor(Vector3D.class, Vector3D.class, Vector3D.class);
                return (SubHyperplane) ctor.newInstance(vertices[0], vertices[1], vertices[2]);
            } catch (NoSuchMethodException e2) {
                try {
                    Constructor<?> ctor = polygonCls.getConstructor(List.class);
                    return (SubHyperplane) ctor.newInstance(Arrays.asList(vertices));
                } catch (NoSuchMethodException e3) {
                    throw new RuntimeException("Polygon class not found or cannot instantiate", e3);
                }
            }
        }
    }

    private static Object instantiatePolyhedronsSet(List<SubHyperplane> subHyperplaneList) throws Exception {
        Class<?> polySetCls = Class.forName("org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet");
        try {
            Constructor<?> ctor = polySetCls.getConstructor(Collection.class);
            return ctor.newInstance((Object) subHyperplaneList);
        } catch (NoSuchMethodException e) {
            try {
                Constructor<?> ctor = polySetCls.getConstructor(List.class);
                return ctor.newInstance((Object) subHyperplaneList);
            } catch (NoSuchMethodException e2) {
                throw new RuntimeException("Unable to instantiate PolyhedronsSet", e2);
            }
        }
    }

    private static double invokeSizeOrVolume(Object polyhedronsObj) throws Exception {
        try {
            Method m = polyhedronsObj.getClass().getMethod("getSize");
            Object res = m.invoke(polyhedronsObj);
            return ((Number) res).doubleValue();
        } catch (NoSuchMethodException e) {
            Method m = polyhedronsObj.getClass().getMethod("getVolume");
            Object res = m.invoke(polyhedronsObj);
            return ((Number) res).doubleValue();
        }
    }
