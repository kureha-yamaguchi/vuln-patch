package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String raw = data.consumeString(16);
        String ascii = data.consumeAsciiString(16);
        String tail = data.consumeRemainingAsString();

        String len3 = forceLength(ascii, 3, 'x');
        String len4 = forceLength(raw, 4, 'x');

        invokeRealEntryPoint(raw, false);
        invokeRealEntryPoint(ascii, false);
        invokeRealEntryPoint(tail, false);

        invokeRealEntryPoint(len3, false);
        invokeRealEntryPoint(len4, false);

        invokeRealEntryPoint("o" + safeChar(ascii, 0, 'f') + safeChar(ascii, 1, 'f'), false);
        invokeRealEntryPoint("y" + safeChar(ascii, 0, 'e') + safeChar(ascii, 1, 'p'), false);
        invokeRealEntryPoint("t" + safeChar(ascii, 0, 'r') + safeChar(ascii, 1, 'u') + safeChar(ascii, 2, 'x'), false);

        invokeRealEntryPoint(pickObservedLiteral(data), false);

        checkEqualContentOracle(raw);
        checkEqualContentOracle(ascii);
        checkEqualContentOracle(len3);
        checkEqualContentOracle(len4);

        String truthy = buildTruthyToken(data);
        checkTruthyOracle(truthy);
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s == null ? null : new StringBuffer(s).toString());
            /*
             * Contract asserted: this parser is defined by String content, not object identity.
             * The implementation only special-cases the interned literal "true" as an optimization,
             * so equal-content distinct String instances must parse identically.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
