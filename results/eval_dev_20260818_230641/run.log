package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off");
        invokeRealEntryPoint("tru");

        String candidate;
        if (data.consumeBoolean()) {
            String seed = data.consumeAsciiString(8);
            if (seed == null) {
                seed = "";
            }
            if (seed.length() == 0) {
                seed = "a";
            }
            char first;
            if (data.consumeBoolean()) {
                first = data.consumeBoolean() ? 't' : 'T';
            } else {
                first = seed.charAt(0);
                if (first == 'y' || first == 'Y') {
                    first = 'x';
                }
            }
            char c1 = seed.length() > 1 ? seed.charAt(1) : (char) ('a' + Math.abs(data.consumeByte()) % 26);
            char c2 = seed.length() > 2 ? seed.charAt(2) : (char) ('a' + Math.abs(data.consumeByte()) % 26);
            candidate = new String(new char[] { first, c1, c2 });
        } else {
            String s = data.consumeAsciiString(3);
            if (s == null) {
                s = "";
            }
            while (s.length() < 3) {
                s += "x";
            }
            if (s.length() > 3) {
                s = s.substring(0, 3);
            }
            if (s.charAt(0) == 'y' || s.charAt(0) == 'Y') {
                s = "x" + s.substring(1);
            }
            candidate = s;
        }

        invokeRealEntryPoint(candidate);

        String contentEquivalent = new StringBuffer(candidate).toString();
        try {
            boolean lhs = BooleanUtils.toBoolean(candidate);
            boolean rhs = BooleanUtils.toBoolean(contentEquivalent);
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(candidate) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
            return;
        }

        String truthy = buildTruthyToken(data);
        try {
            boolean parsed = BooleanUtils.toBoolean(truthy);
            boolean reparsed = BooleanUtils.toBoolean(new StringBuffer(truthy).toString());
            if (parsed != reparsed) {
                throw new RuntimeException("[oracle:truthy-eq] metamorphic violation: equal-content truthy token must parse identically input=" + quote(truthy) + " lhs=" + parsed + " rhs=" + reparsed);
            }
            /*
             * Contract asserted: the implementation explicitly recognizes case-insensitive
             * "on", "yes", and "true". For a token we build from one of those accepted
             * literals by only changing letter case, a correct implementation must return true.
             * A patch that merely blocks the buggy branch or silently returns false would violate
             * this observable API result without throwing.
             */
            if (!parsed) {
                throw new RuntimeException("[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input=" + quote(truthy) + " lhs=" + parsed);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void invokeRealEntryPoint(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.contains("invalid") || lower.contains("validation")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String base;
        if (which == 0) {
            base = "on";
        } else if (which == 1) {
            base = "yes";
        } else {
            base = "true";
        }

        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
