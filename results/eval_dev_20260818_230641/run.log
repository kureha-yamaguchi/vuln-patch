package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String[] ANCHOR_PAIRS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LookupTranslator translator = new LookupTranslator(new CharSequence[][] {
            new CharSequence[] { ANCHOR_PAIRS[0], ANCHOR_PAIRS[0] },
            new CharSequence[] { ANCHOR_PAIRS[1], ANCHOR_PAIRS[1] },
            new CharSequence[] { ANCHOR_PAIRS[2], ANCHOR_PAIRS[2] },
            new CharSequence[] { ANCHOR_PAIRS[3], ANCHOR_PAIRS[3] }
        });

        for (int i = 0; i < ANCHOR_PAIRS.length; i++) {
            try {
                translator.translate(ANCHOR_PAIRS[i]);
            } catch (RuntimeException t) {
                if (!isCleanRejection(t) && !isRootCause(t)) {
                    return;
                }
            }
        }

        for (int i = 0; i < ANCHOR_PAIRS.length; i++) {
            checkIdentityOracle(translator, ANCHOR_PAIRS[i] + "A");
        }

        String pair = ANCHOR_PAIRS[data.consumeInt(0, ANCHOR_PAIRS.length - 1)];
        String prefix = data.consumeString(16);
        String tail = data.consumeRemainingAsString();
        if (tail.length() == 0) {
            tail = "A";
        }

        checkIdentityOracle(translator, prefix + pair + tail);

        if (prefix.length() > 0) {
            checkIdentityOracle(translator, prefix + pair + "A");
        }

        if (tail.length() > 1) {
            checkIdentityOracle(translator, pair + tail);
        }
    }

    private static void checkIdentityOracle(LookupTranslator translator, String input) {
        final String output;
        try {
            output = translator.translate(input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                return;
            }
            return;
        }

        /*
         * Contract used for this oracle:
         * - CharSequenceTranslator.translate copies characters unchanged when no translator consumes them.
         * - LookupTranslator.translate writes the mapped replacement and returns the number of consumed chars.
         * This translator is constructed as an identity mapping for a specific surrogate-pair substring:
