package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.Point;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            PolygonsSet anchorWhole = buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, true, false);
            exerciseAndCheck(anchorWhole, true, "anchor-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet anchorEmpty = buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, false, true);
            exerciseAndCheck(anchorEmpty, false, "anchor-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());
            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            boolean plusLeaf = data.consumeBoolean();
            boolean minusLeaf = data.consumeBoolean();

            PolygonsSet poly;
            try {
                poly = buildRootCausePolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                continue;
            }

            exerciseAndCheck(poly, plusLeaf, "fuzz-" + i);

            try {
                PolygonsSet twin = buildRootCausePolygon(x1, y1, x2, y2, !plusLeaf, minusLeaf);
                compareWholeVsEmptyMetamorphic(poly, plusLeaf, twin, !plusLeaf, x1, y1, x2, y2, minusLeaf);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "valid-leaf-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "valid-leaf-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static PolygonsSet buildRootCausePolygon(double x1, double y1, double x2, double y2,
                                                     boolean plusLeaf, boolean minusLeaf) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        SubHyperplane<Euclidean2D> cut = line.wholeHyperplane();
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusLeaf));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusLeaf));
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(null, null, null);
        BSPTree<Euclidean2D> root = new BSPTree<Euclidean2D>(cut, plus, minus, attribute);
        return new PolygonsSet(root);
    }

    private static void exerciseAndCheck(PolygonsSet poly, boolean expectWhole, String tag) {
        try {
            poly.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = poly.getVertices();
            if (vertices == null) {
                return;
            }
            if (vertices.length == 0) {
                /*
                 * Contract asserted from computeGeometricalProperties():
                 * when getVertices().length == 0, the method must set either
                 * (+INF, NaN barycenter) for whole-space or (0, (0,0)) otherwise.
                 * A patch that merely deletes or bypasses the bookkeeping after the
                 * cast site would violate this observable post-condition.
                 */
                if (expectWhole) {
                    assertWholeGeometry(poly, tag);
                } else {
                    assertEmptyGeometry(poly, tag);
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void compareWholeVsEmptyMetamorphic(PolygonsSet a, boolean aWhole,
                                                       PolygonsSet b, boolean bWhole,
                                                       double x1, double y1, double x2, double y2,
                                                       boolean minusLeaf) {
        try {
            a.computeGeometricalProperties();
            b.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        Vector2D[][] av;
        Vector2D[][] bv;
        try {
            av = a.getVertices();
            bv = b.getVertices();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (av == null || bv == null || av.length != 0 || bv.length != 0) {
            return;
        }

        double as = a.getSize();
        double bs = b.getSize();
        Point<Euclidean2D> abc = a.getBarycenter();
        Point<Euclidean2D> bbc = b.getBarycenter();

        boolean aLooksWhole = looksWhole(as, abc);
        boolean bLooksWhole = looksWhole(bs, bbc);
        boolean aLooksEmpty = looksEmpty(as, abc);
        boolean bLooksEmpty = looksEmpty(bs, bbc);

        if (aWhole != bWhole && aLooksWhole == bLooksWhole && aLooksEmpty == bLooksEmpty) {
            throw new RuntimeException(
                "[oracle:plus-leaf-switch] metamorphic violation: flipping only plus-leaf on an empty-vertices tree must flip whole-space vs empty bookkeeping input=line(("
                    + x1 + "," + y1 + "),(" + x2 + "," + y2 + ")),minus=" + minusLeaf
                    + " lhs=plus=" + aWhole + ",size=" + as + ",bc=" + pointToString(abc)
                    + " rhs=plus=" + bWhole + ",size=" + bs + ",bc=" + pointToString(bbc));
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Point<Euclidean2D> bc = poly.getBarycenter();
        if (!looksWhole(size, bc)) {
            throw new RuntimeException(
                "[oracle:whole-space] metamorphic violation: empty-vertices whole-space case must map to infinite size and NaN barycenter input="
                    + label + " lhs=size=" + size + ",bc=" + pointToString(bc)
                    + " rhs=expected(+INF,NaN,NaN)");
        }
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Point<Euclidean2D> bc = poly.getBarycenter();
        if (!looksEmpty(size, bc)) {
            throw new RuntimeException(
                "[oracle:empty-space] metamorphic violation: empty-vertices non-whole-space case must map to zero size and (0,0) barycenter input="
                    + label + " lhs=size=" + size + ",bc=" + pointToString(bc)
                    + " rhs=expected(0.0,0.0,0.0)");
        }
    }

    private static boolean looksWhole(double size, Point<Euclidean2D> bc) {
        if (!Double.isInfinite(size)) {
            return false;
        }
        if (!(bc instanceof Vector2D)) {
            return false;
        }
        Vector2D v = (Vector2D) bc;
        return Double.isNaN(v.getX()) && Double.isNaN(v.getY());
    }

    private static boolean looksEmpty(double size, Point<Euclidean2D> bc) {
        if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0d)) {
            return false;
        }
        if (!(bc instanceof Vector2D)) {
            return false;
        }
        Vector2D v = (Vector2D) bc;
        return Double.doubleToLongBits(v.getX()) == Double.doubleToLongBits(0.0d)
            && Double.doubleToLongBits(v.getY()) == Double.doubleToLongBits(0.0d);
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        if (t instanceof org.apache.commons.math3.exception.MathIllegalArgumentException) {
            return true;
        }
        if (t instanceof org.apache.commons.math3.exception.MathIllegalNumberException) {
            return true;
        }
        if (t instanceof org.apache.commons.math3.exception.MathParseException) {
            return true;
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cn = ste.getClassName();
            String mn = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cn)) {
                if ("computeGeometricalProperties".equals(mn)
                    || "getVertices".equals(mn)
