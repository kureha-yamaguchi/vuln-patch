package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off");

        String arbitrary = data.consumeString(16);
        invokeRealEntryPoint(arbitrary);
        checkEqualContentOracle(arbitrary);

        String asciiArbitrary = data.consumeAsciiString(16);
        invokeRealEntryPoint(asciiArbitrary);
        checkEqualContentOracle(asciiArbitrary);

        String three = buildExactLengthString(data, 3);
        invokeRealEntryPoint(three);
        checkEqualContentOracle(three);

        String propertyThree = buildThreeCharPropertyInput(data);
        invokeRealEntryPoint(propertyThree);
        checkEqualContentOracle(propertyThree);

        String seedLike = buildSeedLikeInput(data);
        invokeRealEntryPoint(seedLike);
        checkEqualContentOracle(seedLike);

        String truthy = buildTruthyToken(data);
        checkTruthyOracle(truthy);

        String bufferDerived = new StringBuffer(buildExactLengthString(data, data.consumeInt(0, 8))).toString();
        invokeRealEntryPoint(bufferDerived);
        checkEqualContentOracle(bufferDerived);
    }

    private static void invokeRealEntryPoint(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract asserted: BooleanUtils.toBoolean is a content-based parser.
               The implementation only special-cases the interned literal "true" as an optimization,
               so equal-content distinct String objects must parse identically. A throw-deleting or
               representation-sensitive patch would violate this observable behavior without throwing. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract asserted: documented accepted truthy tokens ("on", "yes", "true") are parsed
               case-insensitively by this API, and equal-content distinct String objects must agree.
               For a valid-by-construction mixed-case truthy token, parsing must return true. A patch
               that merely suppresses a crash by returning false on some reachable path would break this. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildThreeCharPropertyInput(FuzzedDataProvider data) {
        char first;
        switch (data.consumeInt(0, 7)) {
            case 0:
                first = 'o';
                break;
            case 1:
                first = 'O';
                break;
            case 2:
                first = 't';
                break;
            case 3:
                first = 'T';
                break;
            case 4:
                first = 'y';
                break;
            case 5:
                first = 'Y';
                break;
            default:
                first = toAscii(data.consumeByte());
                break;
        }
        char second = toAscii(data.consumeByte());
        char third = toAscii(data.consumeByte());
        return new String(new char[] { first, second, third });
    }

    private static String buildSeedLikeInput(FuzzedDataProvider data) {
        String[] seeds = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "yes?", "tru", "on", "yes"
        };
        String base = seeds[data.consumeInt(0, seeds.length - 1)];
        if (base.length() == 0) {
            return base;
        }
        char[] chars = base.toCharArray();
        int idx = data.consumeInt(0, chars.length - 1);
        if (data.consumeBoolean()) {
            chars[idx] = flipAsciiCase(chars[idx]);
        } else {
            chars[idx] = toAscii(data.consumeByte());
        }
        return new String(chars);
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        String[] truths = new String[] { "on", "yes", "true" };
        String base = truths[data.consumeInt(0, truths.length - 1)];
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String buildExactLengthString(FuzzedDataProvider data, int len) {
        char[] chars = new char[len];
        for (int i = 0; i < len; i++) {
            chars[i] = toAscii(data.consumeByte());
        }
        return new String(chars);
    }

    private static char toAscii(byte b) {
        int v = b & 0x7f;
        if (v < 32) {
            v += 32;
        }
        return (char) v;
    }

    private static char flipAsciiCase(char c) {
        if (c >= 'a' && c <= 'z') {
            return (char) (c - ('a' - 'A'));
        }
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
