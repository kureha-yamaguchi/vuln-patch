    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static Day addDays(Day day, int delta) {
        if (day == null) {
            return null;
        }
        Day current = day;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                current = (Day) current.next();
                if (current == null) {
                    throw new IllegalArgumentException("day overflow");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                current = (Day) current.previous();
                if (current == null) {
                    throw new IllegalArgumentException("day underflow");
                }
            }
        }
        return current;
    }

    private static int daysBetween(Day left, Day right) {
        int d = 0;
        Day cur = left;
        while (cur != null && cur.compareTo(right) < 0) {
            cur = (Day) cur.next();
            d++;
            if (d > 10000) {
                throw new IllegalArgumentException("distance too large");
            }
        }
        if (cur == null || cur.compareTo(right) != 0) {
            throw new IllegalArgumentException("daysBetween requires ordered reachable days");
        }
        return d;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static boolean numbersEqual(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return a.equals(b);
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String m = t.getMessage();
        return m != null && m.startsWith("[oracle:");
    }

    private static boolean isCleanValidation(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof IllegalArgumentException || c instanceof NumberFormatException) {
                return true;
            }
            String n = c.getClass().getName();
            if (n.indexOf("SeriesException") >= 0 || n.indexOf("Validation") >= 0 || n.indexOf("Invalid") >= 0) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        return hasRelevantFrame(t);
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
