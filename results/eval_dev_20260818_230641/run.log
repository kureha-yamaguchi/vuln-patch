package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        if (data.consumeBoolean()) {
            invokeRealEntryPoint("oof", false);
        }
        if (data.consumeBoolean()) {
            invokeRealEntryPoint("yep", false);
        }
        if (data.consumeBoolean()) {
            invokeRealEntryPoint("trux", false);
        }

        String explore = buildLength3NonYesInput(data);
        invokeRealEntryPoint(explore, false);

        String arbitrary = data.consumeString(16);
        checkEqualContentOracle(arbitrary);

        String truthyYesVariant = buildTruthyYesVariant(data);
        checkTruthyOracle(truthyYesVariant);
    }

    private static String buildLength3NonYesInput(FuzzedDataProvider data) {
        char first;
        switch (data.consumeInt(0, 5)) {
            case 0:
                first = 'o';
                break;
            case 1:
                first = 'O';
                break;
            case 2:
                first = 't';
                break;
            case 3:
                first = 'T';
                break;
            case 4:
                first = 'a';
                break;
            default:
                first = randomAsciiButNot(data, 'y', 'Y');
                break;
        }
        char second = randomAscii(data);
        char third = randomAscii(data);
        return new String(new char[] { first, second, third });
    }

    private static String buildTruthyYesVariant(FuzzedDataProvider data) {
        char y = data.consumeBoolean() ? 'y' : 'Y';
        char e = data.consumeBoolean() ? 'e' : 'E';
        char s = data.consumeBoolean() ? 's' : 'S';
        return new String(new char[] { y, e, s });
    }

    private static char randomAscii(FuzzedDataProvider data) {
        return (char) data.consumeInt(32, 126);
    }

    private static char randomAsciiButNot(FuzzedDataProvider data, char a, char b) {
        char c = randomAscii(data);
        if (c == a || c == b) {
            return 'x';
        }
        return c;
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (shouldPropagate(t, validByConstruction)) {
                throw t;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        Boolean lhs;
        Boolean rhs;
        try {
            lhs = Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (shouldPropagate(t, false)) {
                throw t;
            }
            return;
        }
        try {
            rhs = Boolean.valueOf(BooleanUtils.toBoolean(new StringBuffer(s).toString()));
        } catch (RuntimeException t) {
            if (shouldPropagate(t, false)) {
                throw t;
            }
            return;
        }

        /* Contract/oracle: toBoolean(String) is a pure parser of String content.
           Therefore two distinct String instances with identical characters must yield
           the same boolean result. A patch that special-cases only one object shape
           (or accidentally makes a branch unreachable for non-interned strings) breaks this. */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void checkTruthyOracle(String s) {
        Boolean lhs;
        Boolean rhs;
        try {
            lhs = Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            return;
        }
        try {
            rhs = Boolean.valueOf(BooleanUtils.toBoolean("yes"));
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            return;
        }

        /* Contract/oracle from the public API behavior and tests: any case-variant of the
           accepted token "yes" must parse as true, just like canonical "yes". A "fix" that
           merely blocks the crashing length-3 path by returning false for all such inputs
           would violate this observable result without throwing. */
        if (!lhs.equals(rhs) || !lhs.booleanValue()) {
            throw new RuntimeException("[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static boolean shouldPropagate(RuntimeException t, boolean validByConstruction) {
        if (isOracleSignal(t)) {
            return true;
        }
        if (isCleanRejection(t) && !validByConstruction) {
            return false;
        }
        return isRootCause(t);
    }

    private static boolean isOracleSignal(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
