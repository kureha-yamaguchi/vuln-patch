private static void verifyEmptyGapContract(TimeSeries series, Day left, Day right, Day start, Day end,
                                               FuzzedDataProvider data) throws CloneNotSupportedException {
        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: chosen ordered range lies inside a real gap so it must contain no source items"
                            + " manualCount=" + manualCount
                            + " start=" + start
                            + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException(
                    "[oracle:gap-absent] metamorphic violation: both endpoints chosen strictly inside the gap must be absent from the series"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by the ordered,
         * non-null periods. When both bounds are inside a real gap and no source item lies in [start,end],
         * the result must be empty. A patch that only suppresses the exception or skips empty-range handling
         * would violate this observable API post-condition.
         */
        TimeSeries copy = series.createCopy(start, end);
        checkSeriesViewConsistency(copy, "empty-gap-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " copyItems=" + copy.getItems().size()
                            + " copyPeriods=" + copy.getTimePeriods().size()
                            + " start=" + start
                            + " end=" + end
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex);
        }

        Day innerStart = start;
        Day innerEnd = end;
        if (start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
            int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
            innerStart = addDays(left, innerStartOffset);
            innerEnd = addDays(left, innerEndOffset);
        }

        TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
        checkSeriesViewConsistency(innerCopy, "inner-gap-copy");
        if (innerCopy.getItemCount() != 0
                || innerCopy.getItems().size() != 0
                || innerCopy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:subgap-empty] metamorphic violation: any ordered subrange wholly inside the same real gap must also copy to an empty series"
                            + " outer=[" + start + "," + end + "]"
                            + " inner=[" + innerStart + "," + innerEnd + "]"
                            + " innerCount=" + innerCopy.getItemCount()
                            + " innerItems=" + innerCopy.getItems().size()
                            + " innerPeriods=" + innerCopy.getTimePeriods().size());
        }

        checkBoundaryStepRight(series, start, right);
        checkBoundaryStepLeft(series, left, end);

        int chosen = data.consumeInt(0, series.getItemCount() - 1);
        RegularTimePeriod exact = series.getTimePeriod(chosen);
        TimeSeries byPeriod = series.createCopy(exact, exact);
        TimeSeries byIndex = series.createCopy(chosen, chosen);
        checkSeriesViewConsistency(byPeriod, "singleton-by-period");
        checkSeriesViewConsistency(byIndex, "singleton-by-index");
        assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
    }
