package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String[] observed = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };

        invokeRealEntryPoint(observed[Math.abs(data.consumeInt()) % observed.length], false);

        String s;
        switch (data.consumeInt(0, 5)) {
            case 0:
                s = data.consumeAsciiString(3);
                break;
            case 1:
                s = (data.consumeBoolean() ? "t" : "T") + data.consumeAsciiString(2);
                break;
            case 2:
                s = (data.consumeBoolean() ? "y" : "Y") + data.consumeAsciiString(2);
                break;
            case 3:
                s = data.consumeAsciiString(data.consumeInt(0, 8));
                break;
            case 4:
                s = new StringBuffer(data.consumeAsciiString(1))
                        .append(data.consumeAsciiString(1))
                        .append(data.consumeAsciiString(1))
                        .toString();
                break;
            default:
                s = observed[Math.abs(data.consumeInt()) % observed.length];
                break;
        }

        invokeRealEntryPoint(s, false);
        checkEqualContentOracle(s);

        String token;
        switch (data.consumeInt(0, 2)) {
            case 0:
                token = "on";
                break;
            case 1:
                token = "yes";
                break;
            default:
                token = "true";
                break;
        }
        String truthy = randomCase(token, data);
        checkTruthyOracle(truthy);
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: this API parses by String content, not by object identity.
               The implementation's fast-path for the interned literal "true" is only an optimization,
               so equal-content distinct String instances must produce the same result. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract: accepted truthy tokens ("on", "yes", "true") are parsed case-insensitively.
               For a valid-by-construction mixed-case truthy token, parsing it and its lowercase form
               must agree, and the result must be true. A throw-deleting or overfitted patch that simply
               returns false on this path would violate this observable behavior. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
            boolean contentEq = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != contentEq) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + contentEq);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && hasBooleanUtilsToBooleanFrame(t);
    }

    private static boolean hasBooleanUtilsToBooleanFrame(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(ch) : Character.toLowerCase(ch));
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
