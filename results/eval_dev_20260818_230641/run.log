        h.checkEquivalent(scientific, scientificOppCase, "exp-marker-case-integral");
        h.checkEquivalent(decimalScientific, decimalScientificOppCase, "exp-marker-case-decimal");
        h.checkEquivalent(scientific, redundantPointScientific, "redundant-decimal-before-exponent");

        String maybeSuffixJunk = data.consumeString(6);
        if (maybeSuffixJunk != null && maybeSuffixJunk.length() > 0) {
