    }

    private static void compareWholeVsEmptyMetamorphic(PolygonsSet a, boolean aWhole,
                                                       PolygonsSet b, boolean bWhole,
                                                       double x1, double y1, double x2, double y2,
                                                       boolean minusLeaf) {
        try {
