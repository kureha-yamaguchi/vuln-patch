private static void exerciseAndCheck(PolygonsSet poly, boolean anchor) {
        try {
            poly.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = poly.getVertices();
            if (vertices == null) {
                return;
            }

            if (vertices.length == 0) {
                boolean plusInside = plusAttribute(poly);
                if (plusInside) {
                    assertWholeGeometry(poly, anchor ? "anchor-empty-whole" : "fuzz-empty-whole");
                } else {
                    assertEmptyGeometry(poly, anchor ? "anchor-empty-false" : "fuzz-empty-false");
                }
            }

            // Contract visible in computeGeometricalProperties(): for any successful call,
            // re-running it on the same region must preserve the observable geometry summary.
            // A throw-deleting or bookkeeping-skipping patch can violate this by leaving stale
            // size/barycenter state. Both sides use the real library code.
            double beforeSize = poly.getSize();
            Vector2D beforeBc = asVector(poly.getBarycenter());

            try {
                poly.computeGeometricalProperties();
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }

            double afterSize = poly.getSize();
            Vector2D afterBc = asVector(poly.getBarycenter());

            if (!sameDouble(beforeSize, afterSize) || !sameVector(beforeBc, afterBc)) {
                throw new RuntimeException("[oracle:idempotence] metamorphic violation: computeGeometricalProperties must be idempotent on the same region input="
                        + describe(poly) + " lhs=size=" + beforeSize + ",bc=" + pointToString(beforeBc)
                        + " rhs=size=" + afterSize + ",bc=" + pointToString(afterBc));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }
