package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runOne("\uD83D\uDE30");
        runOne("\uD800\uDC00");
        runOne("\uD834\uDD1E");
        runOne("\uDBFF\uDFFD");

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

        int pairCount = data.consumeInt(1, 4);
        StringBuilder mid = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            int cp = nextSupplementaryCodePoint(data);
            mid.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                mid.append(sanitizeCsvSafe(data.consumeAsciiString(4)));
            }
        }

        String candidate1 = prefix + mid.toString() + suffix;
        runOne(candidate1);

        String candidate2 = sanitizeCsvSafe(data.consumeRemainingAsString());
        if (candidate2.indexOf(',') < 0 && candidate2.indexOf('"') < 0
                && candidate2.indexOf('\r') < 0 && candidate2.indexOf('\n') < 0) {
            int cp = nextSupplementaryCodePoint(data);
            int insertAt = candidate2.length() == 0 ? 0 : data.consumeInt(0, candidate2.length());
            String pair = new String(Character.toChars(cp));
            String candidate3 = candidate2.substring(0, insertAt) + pair + candidate2.substring(insertAt);
            runOne(candidate3);
        }
    }

    private static void runOne(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle: CSV escaping leaves inputs unchanged when they contain none of
            // comma, double-quote, CR, or LF. A throw-deleting or bookkeeping-breaking patch
            // could avoid the crash yet silently drop/duplicate characters, violating identity.
            if (isCsvSafe(input) && !input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv identity on CSV-safe input input="
                        + repr(input) + " lhs=" + repr(out) + " rhs=" + repr(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCsvSafe(String s) {
        return s.indexOf(',') < 0 && s.indexOf('"') < 0 && s.indexOf('\r') < 0 && s.indexOf('\n') < 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                b.append('a');
            } else {
                b.append(c);
            }
        }
        return b.toString();
    }

    private static int nextSupplementaryCodePoint(FuzzedDataProvider data) {
        return data.consumeInt(0x10000, 0x10FFFF);
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        b.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(c);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }
}
