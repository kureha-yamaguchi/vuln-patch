package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String derived = buildExplorationInput(data);
        invokeRealEntryPoint(derived, false);

        if (data.consumeBoolean()) {
            String fromLonger = data.consumeAsciiString(12);
            if (fromLonger != null && fromLonger.length() >= 3) {
                int start = data.consumeInt(0, fromLonger.length() - 3);
                invokeRealEntryPoint(fromLonger.substring(start, start + 3), false);
            }
        }

        if (data.consumeBoolean()) {
            String arbitrary = data.consumeString(8);
            invokeRealEntryPoint(arbitrary, false);
        }

        checkTruthyOracle(buildTruthyToken(data));
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            String longer = data.consumeAsciiString(16);
            if (longer != null && longer.length() >= 3) {
                int start = data.consumeInt(0, longer.length() - 3);
                String sub = longer.substring(start, start + 3);
                if (sub.charAt(0) != 'y' && sub.charAt(0) != 'Y') {
                    return sub;
                }
            }
        }

        char c0 = asciiChar(data);
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = asciiChar(data);
        char c2 = asciiChar(data);
        return new String(new char[] { c0, c1, c2 });
    }

    private static char asciiChar(FuzzedDataProvider data) {
        return (char) data.consumeInt(32, 126);
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String base = which == 0 ? "on" : (which == 1 ? "yes" : "true");
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }

            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract: BooleanUtils.toBoolean accepts the documented truthy tokens "on", "yes", and "true"
               case-insensitively (as shown by the implementation and test corpus). Therefore a mixed-case token
               constructed from one of those accepted literals must parse the same as its lowercase equivalent,
               and must parse to true. A patch that only suppresses the crash by making a reachable branch return
               false would violate this observable behavior without throwing. */
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || (t != null
                && t.getClass().getName().startsWith("org.apache.commons.lang.")
                && classNameSuggestsValidation(t.getClass().getName()));
    }

    private static boolean classNameSuggestsValidation(String name) {
        return name.endsWith("IllegalArgumentException")
            || name.endsWith("NumberFormatException")
            || name.indexOf("Invalid") >= 0
            || name.indexOf("Validation") >= 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
