    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int rawStartIndex = s.getIndex(start);
        int rawEndIndex = s.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException(
                    "[oracle:anchor-gap-absent] metamorphic violation: failing-test endpoints must be absent from the source series"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex);
        }

        int manualCount = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
        }
        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:anchor-gap-shape] metamorphic violation: failing-test range must lie wholly inside a real gap"
                            + " manualCount=" + manualCount);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:anchor-gap-empty] metamorphic violation: failing-test createCopy must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " copyItems=" + copy.getItems().size()
                            + " copyPeriods=" + copy.getTimePeriods().size());
        }
    }

    private static Day addDays(Day base, int delta) {
        RegularTimePeriod p = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                p = p.next();
                if (p == null) {
                    throw new IllegalArgumentException("Date overflow");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                p = p.previous();
                if (p == null) {
                    throw new IllegalArgumentException("Date underflow");
                }
            }
        }
        return (Day) p;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static void checkSeriesViewConsistency(TimeSeries s, String label) {
        int count = s.getItemCount();
        java.util.List items = s.getItems();
        java.util.Collection periods = s.getTimePeriods();

        if (items.size() != count || periods.size() != count) {
            throw new RuntimeException(
                    "[oracle:view-consistency] metamorphic violation: public series views must agree on size"
                            + " label=" + label
                            + " count=" + count
                            + " items=" + items.size()
                            + " periods=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = s.getDataItem(i);
            RegularTimePeriod period = s.getTimePeriod(i);
            Number value = s.getValue(i);

            if (item == null || period == null) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: indexed accessors must not return null for stored items"
                                + " label=" + label
                                + " index=" + i);
            }
            if (!period.equals(item.getPeriod())) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: getDataItem/getTimePeriod must expose the same period"
                                + " label=" + label
                                + " index=" + i
                                + " itemPeriod=" + item.getPeriod()
                                + " period=" + period);
            }

            Number itemValue = item.getValue();
            if (value == null ? itemValue != null : !value.equals(itemValue)) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: getDataItem/getValue must expose the same value"
                                + " label=" + label
                                + " index=" + i
                                + " itemValue=" + itemValue
                                + " value=" + value);
            }

            if (s.getIndex(period) != i) {
                throw new RuntimeException(
                        "[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must round-trip to i"
                                + " label=" + label
                                + " index=" + i
                                + " roundTrip=" + s.getIndex(period)
                                + " period=" + period);
            }
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String label) {
        if (a.getItemCount() != b.getItemCount()
                || a.getItems().size() != b.getItems().size()
                || a.getTimePeriods().size() != b.getTimePeriods().size()) {
            throw new RuntimeException(
                    "[oracle:" + label + "] metamorphic violation: createCopy overloads must agree on result size"
                            + " aCount=" + a.getItemCount()
                            + " bCount=" + b.getItemCount()
                            + " aItems=" + a.getItems().size()
                            + " bItems=" + b.getItems().size()
                            + " aPeriods=" + a.getTimePeriods().size()
                            + " bPeriods=" + b.getTimePeriods().size());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod ap = a.getTimePeriod(i);
            RegularTimePeriod bp = b.getTimePeriod(i);
            if (!ap.equals(bp)) {
                throw new RuntimeException(
                        "[oracle:" + label + "] metamorphic violation: createCopy overloads must copy the same periods"
                                + " index=" + i
                                + " lhs=" + ap
                                + " rhs=" + bp);
            }
            Number av = a.getValue(i);
            Number bv = b.getValue(i);
            if (av == null ? bv != null : !av.equals(bv)) {
                throw new RuntimeException(
                        "[oracle:" + label + "] metamorphic violation: createCopy overloads must copy the same values"
                                + " index=" + i
                                + " lhs=" + av
                                + " rhs=" + bv);
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanValidation(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
