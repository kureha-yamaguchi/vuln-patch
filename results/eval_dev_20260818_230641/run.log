package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String valid = buildValidSafeCsvString(data);
        checkEscapeCsvIdentity(valid);

        if (data.consumeBoolean()) {
            String prefix = buildValidSafeCsvString(data);
            String suffix = buildValidSafeCsvString(data);
            String combined = prefix + suffix;
            checkEscapeCsvIdentity(combined);
            checkComposition(prefix, suffix);
        }
    }

    private static void runAnchor() {
        checkEscapeCsvIdentity("\uD83D\uDE30");
        checkEscapeCsvIdentity("\uD800\uDC00");
        checkEscapeCsvIdentity("\uD834\uDD1E");
        checkEscapeCsvIdentity("\uDBFF\uDFFD");
    }

    private static void checkEscapeCsvIdentity(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            /*
             * Contract used for this oracle:
             * escapeCsv only adds CSV quoting/escaping when the input contains CSV special
             * characters (comma, quote, CR, LF). For inputs constructed here, none of those
             * characters are present, so a correct implementation must return the input
             * unchanged. A throw-deleting or bookkeeping-skipping patch could silently drop
             * part of a surrogate pair or surrounding text, violating this observable result.
             */
            if (!input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv should be identity on CSV-safe input input=" + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            throwOrSwallowOracle(t);
        }
    }

    private static void checkComposition(String a, String b) {
        String lhs;
        String ra;
        String rb;
        try {
            lhs = StringEscapeUtils.escapeCsv(a + b);
            ra = StringEscapeUtils.escapeCsv(a);
            rb = StringEscapeUtils.escapeCsv(b);
        } catch (RuntimeException t) {
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
        /*
         * Contract used for this oracle:
         * for CSV-safe strings a and b, escapeCsv(a) == a and escapeCsv(b) == b, hence
         * escapeCsv(a + b) must equal a + b and also equal escapeCsv(a) + escapeCsv(b).
         * This catches silent truncation/skipping in the patched loop even when no exception
         * is thrown.
         */
        String rhs = ra + rb;
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:csv-compose] metamorphic violation: escapeCsv(a+b) must equal escapeCsv(a)+escapeCsv(b) for CSV-safe inputs input=" + printable(a + b) + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
        }
    }

    private static void throwOrSwallowOracle(RuntimeException t) {
        String msg = t.getMessage();
        if (msg != null && msg.startsWith("[oracle:")) {
            throw t;
        }
    }

