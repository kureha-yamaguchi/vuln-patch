import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int base = data.consumeInt(-10000, 10000);
        int delta = data.consumeInt(2, 400);

        Day left = makeDay(base);
        Day right = makeDay(base + delta);
        if (left == null || right == null) {
            return;
        }

        TimeSeries series = new TimeSeries(data.consumeAsciiString(16));
        try {
            series.add(left, 1);
            series.add(right, 2);

            int extraCount = data.consumeInt(0, 3);
            for (int i = 0; i < extraCount; i++) {
                int extraOffset = data.consumeInt(delta + 1, delta + 50 + i);
                Day extra = makeDay(base + extraOffset);
                if (extra != null) {
                    try {
                        series.add(extra, data.consumeInt());
                    } catch (RuntimeException ignored) {
                    }
                }
            }
        } catch (RuntimeException e) {
            return;
        }

        int startOffset = data.consumeInt(1, delta - 1);
        int endOffset = data.consumeInt(startOffset, delta - 1);
        Day start = makeDay(base + startOffset);
        Day end = makeDay(base + endOffset);
        if (start == null || end == null) {
            return;
        }

        try {
            TimeSeries copy = series.createCopy(start, end);
            if (copy != null && copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "[oracle:gap-empty] metamorphic violation: createCopy(start,end) for a range wholly inside a real gap must be empty"
                        + " start=" + start + " end=" + end
                        + " count=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        try {
            if (series.getItemCount() > 1) {
                RegularTimePeriod exact = series.getTimePeriod(1);
                if (exact != null) {
                    TimeSeries byPeriod = series.createCopy(exact, exact);
                    TimeSeries byIndex = series.createCopy(1, 1);

                    /*
                     * Contract asserted: both createCopy(exact, exact) and createCopy(index, index)
                     * denote the same singleton subseries for an exact existing item, so their
                     * observable contents must match. A patch that returns the wrong slice (for
                     * example, the whole series) violates this without throwing.
                     */
