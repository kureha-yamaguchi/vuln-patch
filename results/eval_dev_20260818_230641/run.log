    private static String chooseSeedLike(FuzzedDataProvider data) {
        String[] seeds = new String[] {
            "off", "oof", "yep", "tru", "yes?", "trux", "false", "a", "true", "YES", "ON"
        };
        int idx = data.consumeInt(0, seeds.length - 1);
        String s = seeds[idx];
        if (s.length() == 3) {
            return new StringBuffer(s).toString();
        }
        return forceLength3(s, data);
    }

    private static String deriveThreeCharWindow(String surrounding, FuzzedDataProvider data) {
        if (surrounding == null) {
            surrounding = "";
        }
        if (surrounding.length() >= 3) {
            int start = data.consumeInt(0, surrounding.length() - 3);
            return surrounding.substring(start, start + 3);
        }
        return forceLength3(surrounding, data);
    }

    private static String forceLength3(String s, FuzzedDataProvider data) {
        String base = s == null ? "" : s;
        StringBuilder sb = new StringBuilder(base);
        while (sb.length() < 3) {
            char c;
            if (data.remainingBytes() > 0) {
                c = (char) ('A' + (data.consumeByte() & 15));
            } else {
                c = 'x';
            }
            sb.append(c);
        }
        if (sb.length() > 3) {
            int start = 0;
            if (sb.length() > 3) {
                start = data.consumeInt(0, sb.length() - 3);
            }
            return sb.substring(start, start + 3);
        }
        return sb.toString();
    }

    private static String buildMixedCaseTruthy(FuzzedDataProvider data) {
        String[] tokens = new String[] { "on", "yes", "true" };
        String token = tokens[data.consumeInt(0, tokens.length - 1)];
        StringBuilder sb = new StringBuilder(token.length());
        for (int i = 0; i < token.length(); i++) {
            char ch = token.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(ch) : Character.toLowerCase(ch));
        }
        return new StringBuffer(sb.toString()).toString();
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder(s.length() + 2);
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
