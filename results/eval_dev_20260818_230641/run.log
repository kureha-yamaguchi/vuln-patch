package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        String text = data.consumeBoolean() ? null : data.consumeString(32);

        // Steer execution through the uncovered reachable sibling function.
        StringUtils.length(text);

        int pairCount = data.consumeInt(0, 4);
        String[] search = new String[pairCount];
        String[] replacement = new String[pairCount];
        for (int i = 0; i < pairCount; i++) {
            String s = data.consumeAsciiString(6);
            if (s.length() == 0) {
                s = "a";
            }
            search[i] = s;
            replacement[i] = data.consumeString(6);
        }

        tryReplaceEach(text, search, replacement);

        if (text == null) {
            return;
        }

        String absent = buildAbsentToken(text);

        String[] extendedSearch = Arrays.copyOf(search, search.length + 1);
        String[] extendedReplacement = Arrays.copyOf(replacement, replacement.length + 1);
        extendedSearch[search.length] = absent;
        extendedReplacement[replacement.length] = null;

        // Contract/oracle:
        // The provided tests show null replacement entries are ignored:
        //   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
        //   replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc"
        // Therefore, adding one extra pair whose search token is guaranteed absent from the text
        // must not change the result for any correct implementation. A patch that merely suppresses
        // the crash by skipping work or corrupting bookkeeping would violate this observable relation.
        String lhs;
        String rhs;
        try {
            lhs = StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
        try {
            rhs = StringUtils.replaceEach(text, extendedSearch, extendedReplacement);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "[oracle:null-repl-ignored] metamorphic violation: adding an absent search with null replacement changed result"
                    + " input=" + safe(text)
                    + " search=" + Arrays.toString(search)
                    + " replacement=" + Arrays.toString(replacement)
                    + " absent=" + safe(absent)
                    + " lhs=" + safe(lhs)
                    + " rhs=" + safe(rhs));
        }
    }

    private static void exerciseAnchor() {
        checkAnchor(null, new String[]{"a"}, new String[]{"b"}, null);
        checkAnchor("aba", null, null, "aba");
        checkAnchor("aba", new String[0], null, "aba");
        checkAnchor("aba", null, new String[0], "aba");
        checkAnchor("aba", new String[]{"a"}, null, "aba");
        checkAnchor("aba", new String[]{null}, new String[]{"a"}, "aba");
        checkAnchor("aba", new String[]{"a"}, new String[]{null}, "aba");
        checkAnchor("aba", new String[]{"a", "b"}, new String[]{"c", null}, "cbc");
    }

    private static void checkAnchor(String text, String[] search, String[] replacement, String expected) {
        String actual;
        try {
            actual = StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
        if (expected == null ? actual != null : !expected.equals(actual)) {
            throw new RuntimeException(
                "[oracle:anchor] metamorphic violation: anchor output mismatch"
                    + " input=" + safe(text)
                    + " search=" + Arrays.toString(search)
                    + " replacement=" + Arrays.toString(replacement)
                    + " expected=" + safe(expected)
                    + " actual=" + safe(actual));
        }
    }

    private static void tryReplaceEach(String text, String[] search, String[] replacement) {
        try {
            StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validation") || name.contains("Invalid") || name.contains("Format")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String buildAbsentToken(String text) {
        int len = StringUtils.length(text);
        for (char c = 1; c < 128; c++) {
            String s = String.valueOf(c);
            if (text.indexOf(s) < 0) {
                return s;
            }
        }
        String base = "\u0000";
        if (text.indexOf(base) < 0) {
            return base;
        }
        String candidate = "\u0000" + len + "\u0001";
        while (text.indexOf(candidate) >= 0) {
            candidate = candidate + "\u0002";
        }
        return candidate;
    }

    private static String safe(String s) {
        return String.valueOf(s);
    }
}
