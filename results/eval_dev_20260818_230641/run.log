        char other = marker == 'e' ? 'E' : 'e';

        String integralScientific = sign + mant + marker + expSign + exp;
        String integralScientificOther = sign + mant + other + expSign + exp;
        String redundantDecimal = sign + mant + ".0" + marker + expSign + exp;
        String redundantDecimalOther = sign + mant + ".0" + other + expSign + exp;

