package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();
        runMetamorphicCheck(data);
    }

    private static void runAnchorChecks() {
        checkExpected(null, new String[]{"a"}, new String[]{"b"}, null);
        checkExpected("", new String[]{"a"}, new String[]{"b"}, "");
        checkExpected("aba", null, null, "aba");
        checkExpected("aba", new String[0], null, "aba");
        checkExpected("aba", null, new String[0], "aba");
        checkExpected("aba", new String[]{"a"}, null, "aba");
        checkExpected("aba", new String[]{null}, new String[]{"a"}, "aba");
        checkExpected("aba", new String[]{"a"}, new String[]{null}, "aba");
        checkExpected("aba", new String[]{"a", "b"}, new String[]{"c", null}, "cbc");
    }

    private static void runMetamorphicCheck(FuzzedDataProvider data) {
        String text = data.consumeString(32);
        int n = data.consumeInt(0, 5);

        String[] search = new String[n];
        String[] replacement = new String[n];
        for (int i = 0; i < n; i++) {
            search[i] = data.consumeString(6);
            replacement[i] = data.consumeString(6);
        }

        String absent = findAbsentToken(text, search);
        if (absent == null) {
            return;
        }

        String[] extendedSearch = new String[n + 1];
        String[] extendedReplacement = new String[n + 1];
        for (int i = 0; i < n; i++) {
            extendedSearch[i] = search[i];
            extendedReplacement[i] = replacement[i];
        }
        extendedSearch[n] = absent;
        extendedReplacement[n] = null;

        String base;
        String extended;
        try {
            base = StringUtils.replaceEach(text, search, replacement);
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isOurOracle(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
            return;
        }

        try {
            extended = StringUtils.replaceEach(text, extendedSearch, extendedReplacement);
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isOurOracle(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
            return;
        }

        /* Contract used for this oracle:
           The method's own matching loops skip entries with replacementList[i] == null,
           and the tests require null replacement entries to be tolerated. Therefore,
           appending an extra pair whose search token is absent from the input and whose
           replacement is null must not change the result. A patch that merely suppresses
           the crash but changes replacement behavior would violate this equivalence. */
        int baseLen = StringUtils.length(base);
        int extendedLen = StringUtils.length(extended);
        if (baseLen != extendedLen || !safeEquals(base, extended)) {
            throw new RuntimeException(
                "[oracle:ignored-null-pair] metamorphic violation: adding an absent search with null replacement changed result"
                    + " input=" + String.valueOf(text)
                    + " lhs=" + String.valueOf(base)
                    + " rhs=" + String.valueOf(extended)
                    + " absent=" + absent
            );
        }
    }

    private static void checkExpected(String text, String[] search, String[] replacement, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, search, replacement);
            int actualLen = StringUtils.length(actual);
            int expectedLen = StringUtils.length(expected);
            if (actualLen != expectedLen || !safeEquals(actual, expected)) {
                throw new RuntimeException(
                    "[oracle:anchor-expectation] metamorphic violation: documented example returned unexpected result"
                        + " input=" + String.valueOf(text)
                        + " actual=" + String.valueOf(actual)
                        + " expected=" + String.valueOf(expected)
                );
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isOurOracle(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
        }
    }

    private static boolean isOurOracle(Throwable t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("replaceEach".equals(m) || "length".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String findAbsentToken(String text, String[] search) {
        String candidates = "~!@#$%^&*|";
        for (int i = 0; i < candidates.length(); i++) {
            char c = candidates.charAt(i);
            if (text != null && text.indexOf(c) >= 0) {
                continue;
            }
            boolean seen = false;
            if (search != null) {
                for (int j = 0; j < search.length; j++) {
                    String s = search[j];
                    if (s != null && s.indexOf(c) >= 0) {
                        seen = true;
                        break;
                    }
                }
            }
            if (!seen) {
                return String.valueOf(c) + c;
            }
        }
        return null;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
