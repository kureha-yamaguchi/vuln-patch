package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.Point;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            PolygonsSet anchor = buildMalformedEmptyPolygon(0.0, 0.0, 1.0, 0.0, true, false);
            exerciseViaPublicApi(anchor, "anchor");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet validWhole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            assertWholeGeometry(validWhole, "valid-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet validEmpty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            assertEmptyGeometry(validEmpty, "valid-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 16);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());
            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            boolean plusLeaf = data.consumeBoolean();
            boolean minusLeaf = data.consumeBoolean();

            try {
                PolygonsSet poly = buildMalformedEmptyPolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
                exerciseViaPublicApi(poly, "fuzz-" + i);

                try {
                    PolygonsSet twin = buildMalformedEmptyPolygon(x1, y1, x2, y2, !plusLeaf, !minusLeaf);
                    compareEquivalentMalformedInputs(poly, twin, "equiv-" + i);
                } catch (RuntimeException t) {
                    if (isCleanRejection(t)) {
                        continue;
                    }
                    if (isRootCause(t) || isOracleFailure(t)) {
                        throw t;
                    }
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }
    }

    private static PolygonsSet buildMalformedEmptyPolygon(double x1, double y1, double x2, double y2,
                                                          boolean plusLeaf, boolean minusLeaf) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        SubHyperplane<Euclidean2D> cut = line.wholeHyperplane();
        BoundaryAttribute<Euclidean2D> attr = new BoundaryAttribute<Euclidean2D>(null, null, null);
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusLeaf));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusLeaf));
        BSPTree<Euclidean2D> root = new BSPTree<Euclidean2D>(cut, plus, minus, attr);
        return new PolygonsSet(root);
    }

    private static void exerciseViaPublicApi(PolygonsSet poly, String label) {
        Vector2D[][] vertices;
        try {
            vertices = poly.getVertices();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        double size;
        Vector2D barycenter;
        try {
            size = poly.getSize();
            barycenter = asVector(poly.getBarycenter());
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (vertices == null) {
            return;
        }

        if (vertices.length == 0) {
            Object rootAttr = poly.getTree(false).getAttribute();
            if (rootAttr instanceof Boolean && Boolean.TRUE.equals(rootAttr)) {
                assertWholeGeometryFromValues(size, barycenter, label + "-whole");
            } else {
                assertEmptyGeometryFromValues(size, barycenter, label + "-empty");
            }
        }

        /* Contract asserted:
           computeGeometricalProperties() sets the observable size/barycenter summary from the region.
           For v.length == 0, the code explicitly chooses either whole-space (+INF, NaN) or empty (0, (0,0)).
           A throw-deleting or bookkeeping-skipping patch would leave stale or inconsistent values, which this
           idempotence check catches through only real library calls on the same object. */
        try {
            double size2 = poly.getSize();
            Vector2D barycenter2 = asVector(poly.getBarycenter());
            if (!sameDouble(size, size2) || !sameVector(barycenter, barycenter2)) {
