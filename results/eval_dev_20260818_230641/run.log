    private static boolean equivalentSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        int count = a.getItemCount();
        if (count != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod ap = a.getTimePeriod(i);
            RegularTimePeriod bp = b.getTimePeriod(i);
            if (ap == null ? bp != null : (bp == null || ap.compareTo(bp) != 0 || bp.compareTo(ap) != 0)) {
                return false;
            }
            Number av = a.getValue(i);
            Number bv = b.getValue(i);
            if (av == null ? bv != null : !av.equals(bv)) {
                return false;
            }
        }
        return true;
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start,
                                                  RegularTimePeriod end) {
        int c = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p != null && p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                c++;
            }
        }
        return c;
    }

    private static int insertionPoint(int rawBinarySearchResult) {
        return -(rawBinarySearchResult + 1);
    }

    private static Day addDays(Day base, int delta) {
        if (base == null) {
            return null;
        }
        SerialDate sd = base.getSerialDate();
        if (sd == null) {
            return null;
        }
        return new Day(sd);
    }

    private static int daysBetween(Day left, Day right) {
        if (left == null || right == null) {
            return 0;
        }
        int a = left.getSerialDate().toSerial();
        int b = right.getSerialDate().toSerial();
        return b - a;
    }

    private static boolean isValidationException(Throwable t) {
        if (t == null) {
