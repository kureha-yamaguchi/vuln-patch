package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            String input = anchors[i];
            try {
                String out = StringEscapeUtils.escapeCsv(input);

                // Contract used as oracle:
                // escapeCsv only quotes/escapes fields containing CSV metacharacters
                // (comma, double quote, CR, LF). These anchor inputs contain none, so a
                // correct implementation must return the input unchanged. A "fix" that
                // merely avoids the crash by skipping bookkeeping or characters would
                // violate this observable post-condition.
                if (!out.equals(input)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                            + String.valueOf(input) + " lhs=" + String.valueOf(out) + " rhs=" + String.valueOf(input));
                }
            } catch (RuntimeException t) {
                boolean cleanRejection =
                        t instanceof IllegalArgumentException ||
                        t instanceof NumberFormatException;
                if (cleanRejection) {
                    return;
                }

                boolean rootCause = t instanceof StringIndexOutOfBoundsException;
                if (rootCause) {
                    StackTraceElement[] st = t.getStackTrace();
                    for (int j = 0; j < st.length; j++) {
                        if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(st[j].getClassName())
                                && "translate".equals(st[j].getMethodName())) {
                            throw t;
                        }
                    }
                }
                return;
            }
        }

        String prefix = data.consumeAsciiString(32);
        prefix = prefix.replace(',', 'a').replace('"', 'b').replace('\r', 'c').replace('\n', 'd');

        String suffix = data.consumeAsciiString(32);
        suffix = suffix.replace(',', 'e').replace('"', 'f').replace('\r', 'g').replace('\n', 'h');

        int cp1 = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
        String pair1 = new String(Character.toChars(cp1));

        String middle = "";
