package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class H {
            boolean isOracleFailure(Throwable t) {
                String msg = t.getMessage();
                return t instanceof RuntimeException && msg != null && msg.startsWith("[oracle:");
            }

            boolean hasRelevantStack(Throwable t) {
                StackTraceElement[] frames = t.getStackTrace();
                if (frames == null) {
                    return false;
                }
                for (int i = 0; i < frames.length; i++) {
                    StackTraceElement f = frames[i];
                    if (!"org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                        continue;
                    }
                    String m = f.getMethodName();
                    if ("createNumber".equals(m)
                            || "createInteger".equals(m)
                            || "isAllZeros".equals(m)
                            || "isDigits".equals(m)
                            || "createLong".equals(m)
                            || "createBigInteger".equals(m)
                            || "createFloat".equals(m)
                            || "createDouble".equals(m)
                            || "createBigDecimal".equals(m)) {
                        return true;
                    }
                }
                return false;
            }

            boolean isRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
            }

            boolean isCleanReject(Throwable t) {
                return t instanceof IllegalArgumentException;
            }

            java.math.BigDecimal toBigDecimal(Number n) {
                if (n == null) {
                    return null;
                }
                if (n instanceof Double) {
                    double d = ((Double) n).doubleValue();
                    if (Double.isNaN(d) || Double.isInfinite(d)) {
                        return null;
                    }
                }
                if (n instanceof Float) {
                    float f = ((Float) n).floatValue();
                    if (Float.isNaN(f) || Float.isInfinite(f)) {
                        return null;
                    }
                }
                try {
                    return new java.math.BigDecimal(n.toString());
                } catch (RuntimeException e) {
                    return null;
                }
            }

            boolean sameNumericValue(Number a, Number b) {
                java.math.BigDecimal left = toBigDecimal(a);
                java.math.BigDecimal right = toBigDecimal(b);
                return left != null && right != null && left.compareTo(right) == 0;
            }

            Number parseOrNull(String s) {
                try {
                    return NumberUtils.createNumber(s);
                } catch (RuntimeException t) {
                    if (isOracleFailure(t) || isRootCause(t)) {
                        throw t;
                    }
                    return null;
                }
            }

            void exerciseSilently(String s) {
                try {
                    NumberUtils.createNumber(s);
                } catch (RuntimeException t) {
                    if (isRootCause(t)) {
                        throw t;
                    }
                }
            }

            void checkEquivalent(String a, String b, String oracleId) {
                try {
                    Number left = NumberUtils.createNumber(a);
                    Number right = NumberUtils.createNumber(b);
                    if (left == null || right == null) {
                        return;
                    }
                    if (!sameNumericValue(left, right)) {
                        throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                                + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
                    }
                } catch (RuntimeException t) {
                    if (isOracleFailure(t) || isRootCause(t)) {
                        throw t;
                    }
                    if (isCleanReject(t)) {
                        return;
                    }
                }
            }
        }

        H h = new H();

        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (h.isRootCause(t)) {
                throw t;
            }
            if (!h.isCleanReject(t)) {
                return;
            }
        }

        String[] anchors = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                " ",
                ""
        };
        for (int i = 0; i < anchors.length; i++) {
            h.exerciseSilently(anchors[i]);
        }

        String sign = data.consumeBoolean() ? "-" : "";

        int mantLen = data.consumeInt(1, 8);
        String rawMant = data.consumeAsciiString(mantLen);
        StringBuilder mantDigits = new StringBuilder();
        for (int i = 0; i < rawMant.length(); i++) {
            char c = rawMant.charAt(i);
            mantDigits.append((c >= '0' && c <= '9') ? c : (char) ('0' + (c & 7)));
        }
        if (mantDigits.length() == 0) {
            mantDigits.append('1');
        }
        boolean allZeroMant = true;
        for (int i = 0; i < mantDigits.length(); i++) {
            if (mantDigits.charAt(i) != '0') {
                allZeroMant = false;
                break;
            }
        }
        if (allZeroMant) {
            mantDigits.setCharAt(mantDigits.length() - 1, '1');
        }

        int fracLen = data.consumeInt(1, 6);
        String rawFrac = data.consumeAsciiString(fracLen);
        StringBuilder fracDigits = new StringBuilder();
        for (int i = 0; i < rawFrac.length(); i++) {
            char c = rawFrac.charAt(i);
            fracDigits.append((c >= '0' && c <= '9') ? c : (char) ('0' + (c & 7)));
        }
        if (fracDigits.length() == 0) {
            fracDigits.append('0');
        }

        int expLen = data.consumeInt(1, 4);
        String rawExp = data.consumeAsciiString(expLen);
        StringBuilder expDigits = new StringBuilder();
        for (int i = 0; i < rawExp.length(); i++) {
            char c = rawExp.charAt(i);
            expDigits.append((c >= '0' && c <= '9') ? c : (char) ('0' + (c & 7)));
        }
        if (expDigits.length() == 0) {
            expDigits.append('0');
        }

        String expSign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';

        String suffix = "";
        switch (data.consumeInt(0, 6)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            case 5:
                suffix = "l";
                break;
            case 6:
                suffix = "L";
                break;
            default:
                break;
        }

        String integerOnly = sign + mantDigits.toString();
        String decimalOnly = sign + mantDigits.toString() + "." + fracDigits.toString();
        String decimalWithSuffix = decimalOnly + suffix;
        String scientificIntegral = sign + mantDigits.toString() + expMarker + expSign + expDigits.toString();
        String scientificIntegralOppCase = sign + mantDigits.toString() + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits.toString();
        String scientificDecimal = sign + mantDigits.toString() + "." + fracDigits.toString() + expMarker + expSign + expDigits.toString();
        String scientificDecimalOppCase = sign + mantDigits.toString() + "." + fracDigits.toString() + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits.toString();
        String scientificDecimalWithSuffix = scientificDecimal + suffix;
        String redundantFractionScientific = sign + mantDigits.toString() + ".0" + expMarker + expSign + expDigits.toString();
        String trailingDot = sign + mantDigits.toString() + ".";
        String hex = (data.consumeBoolean() ? "-" : "") + "0x" + Integer.toHexString(data.consumeInt());

        h.exerciseSilently(integerOnly);
        h.exerciseSilently(decimalOnly);
        h.exerciseSilently(decimalWithSuffix);
        h.exerciseSilently(scientificIntegral);
        h.exerciseSilently(scientificDecimal);
        h.exerciseSilently(scientificDecimalWithSuffix);
        h.exerciseSilently(trailingDot);
        h.exerciseSilently(hex);

        String maybeBlank = data.consumeBoolean() ? " " : "";
        h.exerciseSilently(maybeBlank);

        Number parsedInteger = h.parseOrNull(integerOnly);
        if (parsedInteger != null) {
            try {
                Number withLongSuffix = NumberUtils.createNumber(integerOnly + "L");
                if (withLongSuffix != null && !h.sameNumericValue(parsedInteger, withLongSuffix)) {
                    throw new RuntimeException("[oracle:integer-long-suffix] metamorphic violation: integral string and same string with long suffix must denote the same numeric value inputA="
                            + integerOnly + " inputB=" + integerOnly + "L lhs=" + parsedInteger + " rhs=" + withLongSuffix);
                }
            } catch (RuntimeException t) {
                if (h.isOracleFailure(t) || h.isRootCause(t)) {
                    throw t;
                }
            }
        }

        /* Contract exercised by these checks:
         * createNumber parses numeric strings, so changing only exponent-marker case ('e' vs 'E'),
         * or adding a redundant ".0" before an exponent, or adding an explicit floating suffix to a
         * decimal, must not change the numeric value for accepted inputs. A patch that merely avoids
         * the crashing substring but computes mantissa/exponent boundaries incorrectly can silently
         * produce a different Number/value; these relations detect that wrong-output behavior.
         */
        h.checkEquivalent(scientificIntegral, scientificIntegralOppCase, "exp-marker-case-integral");
        h.checkEquivalent(scientificDecimal, scientificDecimalOppCase, "exp-marker-case-decimal");
        h.checkEquivalent(scientificIntegral, redundantFractionScientific, "redundant-decimal-before-exponent");

        if ("d".equals(suffix) || "D".equals(suffix) || "f".equals(suffix) || "F".equals(suffix)) {
            h.checkEquivalent(decimalOnly, decimalWithSuffix, "decimal-floating-suffix");
            h.checkEquivalent(scientificDecimal, scientificDecimalWithSuffix, "scientific-floating-suffix");
        }

        String maybeGarbage = data.consumeString(6);
        if (maybeGarbage != null && maybeGarbage.length() > 0) {
            h.parseOrNull(decimalOnly + maybeGarbage);
            h.parseOrNull(scientificDecimal + maybeGarbage);
