package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true",
            "truE", "trUe", "trUE", "tRue", "tRuE", "tRUe", "tRUE",
            "TRUE", "TRUe", "TRuE", "TRue", "TrUE", "TrUe", "TruE", "True",
            "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES",
            "yes?", "tru"
        };

        String seed = literals[data.consumeInt(0, literals.length - 1)];
        invokeRealEntryPoint(new StringBuffer(seed).toString(), false);
        checkEqualContentOracle(seed);

        String len3 = makeLengthThreeCandidate(data);
        invokeRealEntryPoint(len3, false);
        checkEqualContentOracle(len3);

        String fuzz = data.consumeString(8);
        invokeRealEntryPoint(fuzz, false);
        checkEqualContentOracle(fuzz);

        String ascii = data.consumeAsciiString(8);
        invokeRealEntryPoint(ascii, false);
        checkEqualContentOracle(ascii);

        String truthy = makeTruthyToken(data);
        invokeRealEntryPoint(truthy, true);
        checkTruthyOracle(truthy);

        if (data.consumeBoolean()) {
            String yesLike = mutateAroundYes(data);
            invokeRealEntryPoint(yesLike, false);
            checkEqualContentOracle(yesLike);
        }

        if (data.consumeBoolean()) {
            String tLike = mutateAroundTrue(data);
            invokeRealEntryPoint(tLike, false);
            checkEqualContentOracle(tLike);
        }
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static String makeLengthThreeCandidate(FuzzedDataProvider data) {
        char first;
        switch (data.consumeInt(0, 5)) {
            case 0:
                first = 'o';
                break;
            case 1:
                first = 't';
                break;
            case 2:
                first = 'T';
                break;
            case 3:
                first = 'Y';
                break;
            case 4:
                first = 'y';
                break;
            default:
                String s = data.consumeAsciiString(1);
                first = s.length() == 0 ? 'x' : s.charAt(0);
                break;
        }
        String tail = data.consumeAsciiString(2);
        while (tail.length() < 2) {
            tail = tail + "x";
        }
        return new StringBuffer().append(first).append(tail.charAt(0)).append(tail.charAt(1)).toString();
    }

    private static String makeTruthyToken(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String base = which == 0 ? "on" : (which == 1 ? "yes" : "true");
        StringBuffer sb = new StringBuffer(base.length());
        for (int i = 0; i < base.length(); i++) {
            char c = base.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(c) : Character.toLowerCase(c));
        }
        return new StringBuffer(sb.toString()).toString();
    }

    private static String mutateAroundYes(FuzzedDataProvider data) {
        String base = data.consumeBoolean() ? "yes" : "YES";
        if (data.consumeBoolean()) {
            return new StringBuffer(base).append(data.consumeAsciiString(1)).toString();
        }
        return new StringBuffer(base).reverse().toString();
    }

    private static String mutateAroundTrue(FuzzedDataProvider data) {
        String base = makeTruthyTokenFromBase("true", data);
        if (data.consumeBoolean()) {
            return base.substring(0, 3);
        }
        if (data.consumeBoolean()) {
            return new StringBuffer(base).append(data.consumeAsciiString(1)).toString();
        }
        return base;
    }

    private static String makeTruthyTokenFromBase(String base, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer(base.length());
        for (int i = 0; i < base.length(); i++) {
            char c = base.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(c) : Character.toLowerCase(c));
        }
        return new StringBuffer(sb.toString()).toString();
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /*
             * Contract: this parser is defined by String content, not object identity.
             * The implementation only special-cases the interned literal "true" as an optimization,
             * so equal-content distinct String instances must parse identically. A patch that merely
             * avoids the crash by changing behavior based on representation would violate this.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /*
             * Contract: BooleanUtils.toBoolean accepts the documented truthy tokens "on", "yes", and "true"
             * case-insensitively; equal-content distinct String objects must also agree. For a token we built
             * directly from one of those documented truthy values, parsing must return true. A throw-deleting
             * or overfitted patch that merely suppresses the crash by returning false breaks this observable API.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (isValidationFamily(t)) {
            return true;
        }
        String name = t.getClass().getName();
        return name.indexOf("Invalid") >= 0
            || name.indexOf("Validation") >= 0
            || name.indexOf("Malformed") >= 0;
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
