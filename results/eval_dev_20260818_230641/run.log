    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:truthy-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
