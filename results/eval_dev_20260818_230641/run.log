package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            anchorScenario();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        try {
            exploreScenarios(data);
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }
    }

    private static void anchorScenario() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        s.add(left, 1);
        s.add(right, 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        verifyValidGapAcceptsAndIsEmpty(s, start, end, "anchor");
        verifySingletonOverloadAgreement(s, 0, "anchor-left");
        verifySingletonOverloadAgreement(s, 1, "anchor-right");
    }

    private static void exploreScenarios(FuzzedDataProvider data) throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries(data.consumeAsciiString(16));

        int year = normalizeYear(data.consumeInt());
        int month = normalizeMonth(data.consumeInt());
        int day = normalizeSafeDay(data.consumeInt());

        int beforeCount = data.consumeInt(0, 3);
        int afterCount = data.consumeInt(0, 3);
        int gapWidth = data.consumeInt(2, 40);

        Day left = makeDay(year, month, day);
        if (left == null) {
            return;
        }
        Day right = shiftDay(left, gapWidth + 1);
        if (right == null) {
            return;
        }

        for (int i = beforeCount; i >= 1; i--) {
            Day d = shiftDay(left, -i);
            if (d == null) {
                return;
            }
            s.add(d, data.consumeInt());
        }

        s.add(left, data.consumeInt());
        s.add(right, data.consumeInt());

        for (int i = 1; i <= afterCount; i++) {
            Day d = shiftDay(right, i);
            if (d == null) {
                return;
            }
            s.add(d, data.consumeInt());
        }

        int startOffset = data.consumeInt(1, gapWidth);
        int endOffset = data.consumeInt(startOffset, gapWidth);

        Day start = shiftDay(left, startOffset);
        Day end = shiftDay(left, endOffset);
        if (start == null || end == null) {
            return;
        }

        verifyValidGapAcceptsAndIsEmpty(s, start, end, "fuzz-gap");

        if (gapWidth >= 3) {
            int innerStartOffset = data.consumeInt(1, gapWidth);
            int innerEndOffset = data.consumeInt(innerStartOffset, gapWidth);
            Day innerStart = shiftDay(left, innerStartOffset);
            Day innerEnd = shiftDay(left, innerEndOffset);
            if (innerStart != null && innerEnd != null) {
                verifyValidGapAcceptsAndIsEmpty(s, innerStart, innerEnd, "fuzz-subgap");
            }
        }

        if (s.getItemCount() > 0) {
            int idx = data.consumeInt(0, s.getItemCount() - 1);
            verifySingletonOverloadAgreement(s, idx, "fuzz-singleton");
        }
    }

    private static void verifyValidGapAcceptsAndIsEmpty(TimeSeries series, Day start, Day end, String tag)
            throws CloneNotSupportedException {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex;
        int rawEndIndex;
        try {
            rawStartIndex = series.getIndex(start);
            rawEndIndex = series.getIndex(end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-index] metamorphic violation: valid ordered non-null gap endpoints must be indexable without root-cause rejection"
                                + " tag=" + tag + " start=" + start + " end=" + end,
                        e);
            }
            return;
        }

        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        if (countItemsInInclusiveRange(series, start, end) != 0) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null bounds wholly inside a real gap"
                                + " tag=" + tag
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            if (isCleanValidation(e)) {
                return;
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for ordered,
         * non-null bounds. When no source item lies in [start,end], the returned series must be empty.
         * A patch that only suppresses the historical exception but returns a non-empty slice breaks
         * this observable API post-condition.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        if (series.getItemCount() > 0) {
            verifySingletonOverloadAgreement(series, 0, tag + "-leftmost");
            verifySingletonOverloadAgreement(series, series.getItemCount() - 1, tag + "-rightmost");
        }
    }

    private static void verifySingletonOverloadAgreement(TimeSeries series, int index, String tag)
            throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree for an exact existing item"
                                + " tag=" + tag + " index=" + index + " period=" + exact,
                        e);
            }
            return;
        }

        /*
         * Contract asserted: both overloads denote the same singleton slice of the same source series,
         * so their observable contents must match. A patch that changes emptiness bookkeeping or index
         * handling can avoid throwing yet still return the wrong copy.
         */
        assertEquivalentSeries(byPeriod, byIndex, "singleton-overloads", tag, exact);
    }

    private static void assertEmptySeries(TimeSeries copy, String oracleId, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: createCopy returned null"
                            + " start=" + start + " end=" + end);
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: gap-bounded copy must be empty"
                            + " start=" + start
                            + " end=" + end
                            + " count=" + copy.getItemCount());
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String oracleId, String tag,
                                               RegularTimePeriod period) {
        if (a == null || b == null) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: compared series must both be non-null"
                            + " tag=" + tag + " period=" + period + " lhs=" + a + " rhs=" + b);
        }
        int ac = a.getItemCount();
        int bc = b.getItemCount();
        if (ac != bc) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: equivalent singleton overloads must have same item count"
                            + " tag=" + tag + " period=" + period + " lhsCount=" + ac + " rhsCount=" + bc);
        }
        for (int i = 0; i < ac; i++) {
            RegularTimePeriod ap = a.getTimePeriod(i);
            RegularTimePeriod bp = b.getTimePeriod(i);
            Number av = a.getValue(i);
            Number bv = b.getValue(i);

            boolean samePeriod = (ap == null ? bp == null : ap.equals(bp));
            boolean sameValue;
            if (av == null || bv == null) {
                sameValue = (av == bv);
            } else {
                sameValue = av.equals(bv) || av.doubleValue() == bv.doubleValue();
            }

            if (!samePeriod || !sameValue) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: equivalent singleton overloads must expose identical contents"
                                + " tag=" + tag
                                + " period=" + period
                                + " i=" + i
                                + " lhsPeriod=" + ap
                                + " rhsPeriod=" + bp
                                + " lhsValue=" + av
                                + " rhsValue=" + bv);
            }
        }
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p == null) {
                continue;
            }
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int insertionPoint(int rawBinarySearchResult) {
        return -(rawBinarySearchResult + 1);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if (("org.jfree.data.time.TimeSeries".equals(cls) && ("createCopy".equals(m) || "getIndex".equals(m)))
                    || ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(m))
                    || ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(m))
                    || ("org.jfree.data.general.Series".equals(cls) && "clone".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanValidation(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static int normalizeYear(int v) {
        int y = 1900 + Math.abs(v % 200);
        if (y < 1900) {
            y = 1900;
        }
        if (y > 2099) {
            y = 2099;
        }
        return y;
    }

    private static int normalizeMonth(int v) {
        return 1 + Math.abs(v % 12);
    }

    private static int normalizeSafeDay(int v) {
        return 1 + Math.abs(v % 28);
    }

    private static Day makeDay(int year, int month, int day) {
        try {
            return new Day(day, month, year);
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static Day shiftDay(Day base, int deltaDays) {
        if (base == null) {
            return null;
        }
        try {
            Date baseDate = base.getStart();
            Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
            cal.setTime(baseDate);
            cal.add(Calendar.DAY_OF_MONTH, deltaDays);
            return new Day(cal.getTime());
        } catch (RuntimeException e) {
            return null;
        }
    }
