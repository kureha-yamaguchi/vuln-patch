    private static void tryMetamorphicFilterNullAndEmptyEntries(String text, String[] searchList, String[] replacementList) {
        if (searchList == null || replacementList == null || searchList.length != replacementList.length) {
            return;
        }

        String[] filteredSearch = filterSearch(searchList, replacementList);
        String[] filteredReplacement = filterReplacement(searchList, replacementList);

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String rhs;
