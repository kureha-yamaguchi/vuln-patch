                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: whole-space leaf barycenter must be a Vector2D input=" + attribute + " lhs=" + bary1 + " rhs=" + bary2);
                }
                Vector2D v1 = (Vector2D) bary1;
                Vector2D v2 = (Vector2D) bary2;
                if (!(Double.isNaN(v1.getX()) && Double.isNaN(v1.getY()) && Double.isNaN(v2.getX()) && Double.isNaN(v2.getY()))) {
                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: whole-space leaf barycenter must be NaN input=" + attribute + " lhs=(" + v1.getX() + "," + v1.getY() + ") rhs=(" + v2.getX() + "," + v2.getY() + ")");
                }
            } else {
                if (!sameDouble(size1, 0.0) || !sameDouble(size2, 0.0)) {
                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: empty leaf must have zero size input=" + attribute + " lhs=" + size1 + " rhs=" + size2);
                }
                if (!(bary1 instanceof Vector2D) || !(bary2 instanceof Vector2D)) {
                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: empty leaf barycenter must be a Vector2D input=" + attribute + " lhs=" + bary1 + " rhs=" + bary2);
                }
