package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.TimeZone;

public class FuzzHarness {
    private static final TimeZone UTC = TimeZone.getTimeZone("UTC");

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        try {
            runExplore(data);
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOracleFailure(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (Throwable t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            TimeSeries copy = s.createCopy(start, end);
            /*
             * Contract: createCopy(start,end) returns the inclusive subseries in [start,end].
             * This anchor range lies wholly inside the real gap between the only two source items,
             * so a correct implementation must return an empty copy. A throw-deleting or
             * wrong-bookkeeping patch that returns the original/non-empty series violates this.
             */
            assertEmptySeries(copy, "anchor-gap-empty", start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }

        try {
            /*
             * Contract: for an exact existing item, createCopy(period,period) and
             * createCopy(index,index) denote the same singleton subseries.
             */
            TimeSeries byPeriod = s.createCopy(s.getTimePeriod(1), s.getTimePeriod(1));
            TimeSeries byIndex = s.createCopy(1, 1);
            assertEquivalentSeries(byPeriod, byIndex, "anchor-singleton-overloads");
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOracleFailure(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void runExplore(FuzzedDataProvider data) throws CloneNotSupportedException {
        int itemCount = 2 + data.consumeInt(0, 4);
        int firstOffset = data.consumeInt(0, 10000);
        int firstGap = 2 + data.consumeInt(0, 60);

        int[] offsets = new int[itemCount];
        offsets[0] = firstOffset;
        offsets[1] = firstOffset + firstGap;
        for (int i = 2; i < itemCount; i++) {
            offsets[i] = offsets[i - 1] + 1 + data.consumeInt(0, 30);
        }

        TimeSeries series = new TimeSeries(data.consumeAsciiString(20));
        for (int i = 0; i < itemCount; i++) {
            series.add(dayFromOffset(offsets[i]), data.consumeInt());
        }

        int gapStartOffset = offsets[0] + 1;
        int gapEndOffset = offsets[1] - 1;
        Day gapStart = dayFromOffset(data.consumeInt(gapStartOffset, gapEndOffset));
        Day gapEnd = dayFromOffset(data.consumeInt(offsetOf(gapStart), gapEndOffset));

        try {
            TimeSeries gapCopy = series.createCopy(gapStart, gapEnd);
            /*
             * Contract: createCopy(start,end) returns the inclusive subseries bounded by ordered,
             * non-null periods. We constructed [gapStart,gapEnd] wholly inside the real gap between
             * the first and second items, so no source item lies in the range and the copy must be empty.
             */
            assertEmptySeries(gapCopy, "gap-empty", gapStart, gapEnd);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        int chosenIndex = 1;
        RegularTimePeriod exact = series.getTimePeriod(chosenIndex);
        if (exact != null) {
            try {
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosenIndex, chosenIndex);
                /*
                 * Contract: both overloads denote the same singleton slice for an exact existing item,
                 * so their observable contents must agree for every correct implementation.
                 */
                assertEquivalentSeries(byPeriod, byIndex, "singleton-overloads");
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
            }
        }
    }

    private static Day dayFromOffset(int offset) {
        Calendar c = Calendar.getInstance(UTC);
        c.clear();
        c.setLenient(false);
        c.set(2000, Calendar.JANUARY, 1, 0, 0, 0);
        c.add(Calendar.DAY_OF_MONTH, offset);
        return new Day(c.getTime(), UTC);
    }

    private static int offsetOf(Day d) {
        Calendar base = Calendar.getInstance(UTC);
        base.clear();
        base.setLenient(false);
        base.set(2000, Calendar.JANUARY, 1, 0, 0, 0);

        Calendar cur = Calendar.getInstance(UTC);
        cur.clear();
        cur.setTime(d.getStart());
        long diff = cur.getTimeInMillis() - base.getTimeInMillis();
        return (int) (diff / 86400000L);
    }

    private static void assertEmptySeries(TimeSeries copy, String tag, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: createCopy returned null"
                    + " start=" + start + " end=" + end);
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: gap range must produce empty copy"
                    + " start=" + start + " end=" + end + " count=" + copy.getItemCount());
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String tag) {
        if (!sameObservableSeries(a, b)) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree"
                    + " lhsCount=" + countOf(a) + " rhsCount=" + countOf(b));
        }
    }

    private static boolean sameObservableSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a.getItemCount() != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null || pb == null) {
                if (pa != pb) {
                    return false;
                }
            } else if (pa.compareTo(pb) != 0 || pb.compareTo(pa) != 0) {
                return false;
            }

            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null || vb == null) {
                if (va != vb) {
                    return false;
                }
            } else if (!va.equals(vb)) {
                return false;
            }
        }
        return true;
    }

    private static int countOf(TimeSeries s) {
        return s == null ? -1 : s.getItemCount();
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement ste : stack) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
