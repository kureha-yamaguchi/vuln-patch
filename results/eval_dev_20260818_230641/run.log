package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        CharSequence[][] anchorMap = new CharSequence[][] {
            { "\uD83D\uDE30", "\uD83D\uDE30" },
            { "\uD800\uDC00", "\uD800\uDC00" },
            { "\uD834\uDD1E", "\uD834\uDD1E" },
            { "\uDBFF\uDFFD", "\uDBFF\uDFFD" }
        };
        LookupTranslator anchorTranslator = new LookupTranslator(anchorMap);

        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            try {
                anchorTranslator.translate(anchors[i]);
            } catch (RuntimeException t) {
                boolean inPatchedRegion = false;
                StackTraceElement[] st = t.getStackTrace();
                for (int j = 0; j < st.length; j++) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(st[j].getClassName())
                            && "translate".equals(st[j].getMethodName())) {
                        inPatchedRegion = true;
                        break;
                    }
                }
                if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                    return;
                }
                if (inPatchedRegion) {
                    break;
                }
                return;
            }
        }

        char high = (char) data.consumeInt(0xD800, 0xDBFF);
        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
        String pair = new String(new char[] { high, low });

        String prefix = data.consumeAsciiString(8);
        if (prefix.indexOf(high) >= 0 || prefix.indexOf(low) >= 0) {
            prefix = prefix.replace(high, 'A').replace(low, 'B');
        }

        String suffix = data.consumeAsciiString(8);
        if (suffix.length() == 0) {
            suffix = "Z";
        }
        if (suffix.indexOf(high) >= 0 || suffix.indexOf(low) >= 0) {
            suffix = suffix.replace(high, 'C').replace(low, 'D');
            if (suffix.length() == 0) {
                suffix = "Z";
            }
        }

        int repeats = data.consumeInt(1, 3);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < repeats; i++) {
            middle.append(pair);
            if (data.consumeBoolean()) {
                String sep = data.consumeAsciiString(3);
                if (sep.indexOf(high) >= 0 || sep.indexOf(low) >= 0) {
                    sep = sep.replace(high, 'E').replace(low, 'F');
                }
                middle.append(sep);
            }
        }

        String input = prefix + middle.toString() + suffix;
        LookupTranslator translator = new LookupTranslator(new CharSequence[][] { { pair, pair } });

        String translated;
        try {
            translated = translator.translate(input);
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            return;
        }

        /*
         * Contract/oracle:
         * - CharSequenceTranslator.translate copies any untranslated code point unchanged.
         * - LookupTranslator writes the configured replacement when it matches.
         * - We configure an identity mapping pair -> pair.
         * Therefore every correct implementation must preserve the entire input exactly.
         * A throw-deleting or bookkeeping-skipping patch can silently drop/skip surrounding
         * characters after a matched surrogate pair, violating this observable post-condition.
         */
        if (!input.equals(translated)) {
            throw new RuntimeException("[oracle:identity-lookup] metamorphic violation: identity mapping must preserve input input="
                    + printable(input) + " lhs=" + printable(translated) + " rhs=" + printable(input));
        }
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        b.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(c);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }
}
