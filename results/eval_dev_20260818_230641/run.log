package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryAnchor("\uD83D\uDE30");
        tryAnchor("\uD800\uDC00");
        tryAnchor("\uD834\uDD1E");
        tryAnchor("\uDBFF\uDFFD");

        String fuzzed = buildValidCsvIdentityInput(data);

        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(fuzzed);

            /*
             * Contract/oracle:
             * CSV escaping only adds quoting/escaping when the input contains CSV meta characters
             * (comma, double quote, CR, LF). For inputs constructed here to contain none of those
             * characters, a correct implementation must return the original string unchanged.
             * A throw-deleting or bookkeeping-breaking patch could silently drop or duplicate
             * characters instead of throwing; this equality check catches that wrong-output case.
             */
            if (!fuzzed.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for inputs without CSV meta characters input="
                        + repr(fuzzed) + " lhs=" + repr(escaped) + " rhs=" + repr(fuzzed));
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (isOracleViolation(t) || isRootCause(t)) {
                throw t;
            }
        } catch (Throwable t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
        }
    }

    private static void tryAnchor(String s) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
            if (!s.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-anchor-identity] metamorphic violation: escapeCsv must preserve surrogate-pair input without CSV meta characters input="
                        + repr(s) + " lhs=" + repr(escaped) + " rhs=" + repr(s));
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (isOracleViolation(t) || isRootCause(t)) {
                throw t;
            }
        } catch (Throwable t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
        }
    }

    private static String buildValidCsvIdentityInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        String prefix = sanitizeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeAscii(data.consumeAsciiString(16));
        sb.append(prefix);

        int pairs = data.consumeInt(1, 4);
        for (int i = 0; i < pairs; i++) {
            int high = 0xD800 + data.consumeInt(0, 0xDBFF - 0xD800);
            int low = 0xDC00 + data.consumeInt(0, 0xDFFF - 0xDC00);
            sb.append((char) high).append((char) low);

            String mid = sanitizeAscii(data.consumeAsciiString(8));
            sb.append(mid);
        }

        sb.append(suffix);

        if (sb.length() == 0) {
            sb.append('A').append('\uD83D').append('\uDE30');
        }

        return sb.toString();
    }

    private static String sanitizeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            } else {
                sb.append('A');
            }
        }
        return sb.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || Character.isSurrogate(c)) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
