package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            anchorCase();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        int rounds = data.consumeInt(1, 8);
        for (int r = 0; r < rounds; r++) {
            try {
                TimeSeries series = new TimeSeries("Fuzz-" + r + "-" + data.consumeAsciiString(8));

                int year = data.consumeInt(1901, 2099);
                int month = data.consumeInt(1, 12);
                int leftDayNum = data.consumeInt(1, 20);
                int gapSize = data.consumeInt(1, 40);
                int beforeCount = data.consumeInt(0, 6);
                int afterCount = data.consumeInt(0, 6);

                Day left = new Day(leftDayNum, month, year);
                Day right = shiftDay(left, gapSize + 1);

                if (left == null || right == null) {
                    continue;
                }

                for (int i = beforeCount; i > 0; i--) {
                    Day d = shiftDay(left, -i);
                    if (d != null) {
                        series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
                    }
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    Day d = shiftDay(right, i);
                    if (d != null) {
                        series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
                    }
                }

                int startOffset = data.consumeInt(1, gapSize);
                int endOffset = data.consumeInt(startOffset, gapSize);
                Day start = shiftDay(left, startOffset);
                Day end = shiftDay(left, endOffset);
                if (start == null || end == null || start.compareTo(end) > 0) {
                    continue;
                }

                probeGapContract(series, left, right, start, end, data);
                checkSingletonOverloads(series, data);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isValidationFamily(e) || isRootCause(e)) {
                    return;
                }
                return;
            }
        }
    }

    private static void anchorCase() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        s.add(left, Integer.valueOf(1));
        s.add(right, Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        probeGapContract(s, left, right, start, end, null);
        checkSingletonOverloads(s, null);
    }

    private static void probeGapContract(TimeSeries series, Day left, Day right, Day start, Day end,
                                         FuzzedDataProvider data) throws CloneNotSupportedException {
        if (series == null || start == null || end == null || left == null || right == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStart;
        int rawEnd;
        try {
            rawStart = series.getIndex(start);
            rawEnd = series.getIndex(end);
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        int manualCount = countInclusive(series, start, end);
        if (manualCount != 0) {
            return;
        }
        if (!(rawStart < 0 && rawEnd < 0)) {
            return;
        }

        int startIndex = insertionPoint(rawStart);
        int endIndex = insertionPoint(rawEnd) - 1;
        if (!(endIndex < startIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-accept] metamorphic violation: ordered non-null bounds wholly inside a real gap must be accepted and copy to an empty series"
                                + " start=" + start
                                + " end=" + end
                                + " rawStart=" + rawStart
                                + " rawEnd=" + rawEnd,
                        e);
            }
            if (isValidationFamily(e)) {
                return;
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by the
         * requested ordered periods. When the range lies wholly inside a real gap, there are no
         * source items in that inclusive range, so the observable copy must be empty. A patch that
         * merely suppresses the historical exception but skips the empty-range path would violate
         * this post-condition.
         */
        assertEmptyCopy(copy, "gap-empty", start, end);

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = spanDays(left, start);
            int outerEndOffset = spanDays(left, end);
            if (outerStartOffset <= outerEndOffset) {
                innerStart = shiftDay(left, data.consumeInt(outerStartOffset, outerEndOffset));
                if (innerStart == null) {
                    innerStart = start;
                }
                int innerStartOffset = spanDays(left, innerStart);
                innerEnd = shiftDay(left, data.consumeInt(innerStartOffset, outerEndOffset));
                if (innerEnd == null) {
                    innerEnd = end;
                }
            }
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            assertEmptyCopy(innerCopy, "subgap-empty", innerStart, innerEnd);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:subgap-accept] metamorphic violation: any ordered subrange within the same real gap must also be accepted"
                                + " outer=[" + start + "," + end + "]"
                                + " inner=[" + innerStart + "," + innerEnd + "]",
                        e);
            }
            if (isValidationFamily(e)) {
                return;
            }
            return;
        }

        stepBoundaryChecks(series, left, right, start, end);
    }

    private static void checkSingletonOverloads(TimeSeries series, FuzzedDataProvider data)
            throws CloneNotSupportedException {
        if (series == null || series.getItemCount() <= 0) {
            return;
        }
        int idx = (data == null) ? 0 : data.consumeInt(0, series.getItemCount() - 1);
        RegularTimePeriod exact = series.getTimePeriod(idx);

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(idx, idx);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:singleton-overloads] metamorphic violation: copying one exact existing item by period and by index must agree"
                                + " idx=" + idx
                                + " period=" + exact,
                        e);
            }
            return;
        }

        /*
         * Contract asserted: both createCopy overloads denote the same inclusive singleton subseries
         * when given an exact existing item. A throw-deleting or bookkeeping-breaking patch in the
         * period-based overload could return the wrong copy even when it no longer throws.
         */
        if (!equivalentSeries(byPeriod, byIndex)) {
            throw new RuntimeException(
                    "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) must equal createCopy(index,index)"
                            + " idx=" + idx
                            + " periodCount=" + byPeriod.getItemCount()
                            + " indexCount=" + byIndex.getItemCount()
                            + " period=" + exact);
        }
    }

    private static void stepBoundaryChecks(TimeSeries series, Day left, Day right, Day start, Day end)
            throws CloneNotSupportedException {
        Day stepLeft = shiftDay(start, -1);
        if (stepLeft != null) {
            try {
                TimeSeries c = series.createCopy(stepLeft, stepLeft);
                if (stepLeft.compareTo(left) > 0) {
                    assertEmptyCopy(c, "left-step-gap", stepLeft, stepLeft);
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:left-step] metamorphic violation: stepping inside the same gap must remain acceptable"
                                    + " period=" + stepLeft,
                            e);
                }
            }
        }

        Day stepRight = shiftDay(end, 1);
        if (stepRight != null) {
            try {
                TimeSeries c = series.createCopy(stepRight, stepRight);
                if (stepRight.compareTo(right) < 0) {
                    assertEmptyCopy(c, "right-step-gap", stepRight, stepRight);
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:right-step] metamorphic violation: stepping inside the same gap must remain acceptable"
                                    + " period=" + stepRight,
                            e);
                }
            }
        }
    }

    private static void assertEmptyCopy(TimeSeries copy, String oracleId, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: createCopy returned null"
                            + " start=" + start + " end=" + end);
        }
        int count = copy.getItemCount();
        int items = copy.getItems().size();
        int periods = copy.getTimePeriods().size();
        if (count != 0 || items != 0 || periods != 0) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: empty-gap copy must expose no items"
                            + " count=" + count
                            + " items=" + items
                            + " periods=" + periods
                            + " start=" + start
                            + " end=" + end);
        }
    }

    private static boolean equivalentSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a.getItemCount() != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null) {
                if (pb != null) {
                    return false;
                }
            } else if (!pa.equals(pb)) {
                return false;
            }

            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null) {
                if (vb != null) {
                    return false;
                }
            } else if (!va.equals(vb)) {
                return false;
            }
        }
        return true;
    }

    private static int countInclusive(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        int n = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                n++;
            }
            int roundTrip = s.getIndex(p);
            if (roundTrip != i) {
                throw new RuntimeException(
                        "[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                                + " i=" + i
                                + " roundTrip=" + roundTrip
                                + " period=" + p);
            }
        }
        return n;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static Day shiftDay(Day base, int delta) {
        if (base == null) {
            return null;
        }
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(base.getYear(), base.getMonth() - 1, base.getDayOfMonth(), 12, 0, 0);
        cal.add(Calendar.DAY_OF_MONTH, delta);
        try {
            return new Day(cal.getTime());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static int spanDays(Day a, Day b) {
        Calendar ca = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        ca.clear();
        ca.set(a.getYear(), a.getMonth() - 1, a.getDayOfMonth(), 12, 0, 0);
        Calendar cb = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cb.clear();
        cb.set(b.getYear(), b.getMonth() - 1, b.getDayOfMonth(), 12, 0, 0);
        long diff = cb.getTimeInMillis() - ca.getTimeInMillis();
        return (int) (diff / (24L * 60L * 60L * 1000L));
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationFamily(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid")
                || name.contains("validation")
                || name.contains("format")
                || name.contains("parse");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
        }
        return false;
    }
