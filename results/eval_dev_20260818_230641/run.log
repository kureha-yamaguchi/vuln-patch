package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            if (isOracleFailure(e) || isRootCause(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        TimeSeries series = new TimeSeries("Fuzz-" + data.consumeAsciiString(8));
        Day left;
        Day right;
        try {
            int year = data.consumeInt(1901, 2099);
            int month = data.consumeInt(1, 12);
            int leftDay = data.consumeInt(1, 20);
            int gapSize = data.consumeInt(1, 40);
            int beforeCount = data.consumeInt(0, 6);
            int afterCount = data.consumeInt(0, 6);

            left = new Day(leftDay, month, year);
            right = addDays(left, gapSize + 1);
            if (right == null) {
                return;
            }

            for (int i = beforeCount; i > 0; i--) {
                Day d = addDays(left, -i);
                if (d == null) {
                    return;
                }
                series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
            }
            series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
            series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
            for (int i = 1; i <= afterCount; i++) {
                Day d = addDays(right, i);
                if (d == null) {
                    return;
                }
                series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = addDays(left, startOffset);
            Day end = addDays(left, endOffset);
            if (start == null || end == null) {
                return;
            }

            verifyEmptyGapCopy(series, start, end);

            if (startOffset < endOffset) {
                int innerStartOffset = data.consumeInt(startOffset, endOffset);
                int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
                Day innerStart = addDays(left, innerStartOffset);
                Day innerEnd = addDays(left, innerEndOffset);
                if (innerStart != null && innerEnd != null) {
                    verifyEmptyGapCopy(series, innerStart, innerEnd);
                }
            }

            if (series.getItemCount() > 0) {
                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                verifySingletonOverloadAgreement(series, chosen);
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e) || isRootCause(e)) {
                throw e;
            }
            if (isValidationException(e)) {
                return;
            }
            return;
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            verifyEmptyGapCopy(s, start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:anchor-gap-accept] metamorphic violation: ordered non-null periods wholly inside a real gap must be accepted and copy to an empty series",
                        e);
            }
            throw e;
        }

        verifySingletonOverloadAgreement(s, 0);
        verifySingletonOverloadAgreement(s, 1);
    }

    private static void verifyEmptyGapCopy(TimeSeries series, Day start, Day end)
            throws CloneNotSupportedException {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: a range chosen wholly inside the constructed gap must contain no source items"
                            + " manualCount=" + manualCount
                            + " start=" + start
                            + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-accept] metamorphic violation: valid ordered non-null periods wholly inside a real gap must not be rejected"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            throw e;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for the ordered
         * bounds. When no source item lies in [start,end], the copied series must be empty. A patch
         * that merely deletes the historical throw or skips the empty-range bookkeeping would still
         * return a non-empty or inconsistent copy, which is observable through the public API below.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        int count = series.getItemCount();
        for (int i = 0; i < count; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (series.getIndex(p) != i) {
                throw new RuntimeException(
                        "[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                                + " index=" + i
                                + " roundTrip=" + series.getIndex(p)
                                + " period=" + p);
            }
        }
    }

    private static void verifySingletonOverloadAgreement(TimeSeries series, int index)
            throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree for an exact existing item",
                        e);
            }
            throw e;
        }

        /*
         * Contract asserted: both overloads describe the same singleton slice of the same source
         * series, so their observable contents must match. A patch that alters index bookkeeping or
         * emptiness handling can avoid an exception yet return the wrong copy.
         */
        assertEquivalentSeries(byPeriod, byIndex, "singleton-overloads");
    }

