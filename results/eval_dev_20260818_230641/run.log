        }
        return (t instanceof IllegalArgumentException)
                || (t instanceof NumberFormatException)
                || (t instanceof org.jfree.data.general.SeriesException);
    }

    private static boolean isFromReachableRegion(Throwable t) {
        if (t == null) {
