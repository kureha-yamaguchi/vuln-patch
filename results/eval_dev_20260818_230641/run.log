        String maybePostfix = data.consumeRemainingAsString();
        if (maybePrefix == null) {
            maybePrefix = "";
        }
        if (maybePostfix == null) {
            maybePostfix = "";
        }
        h.parseOrNull(maybePrefix + scientific + maybePostfix);
    }
