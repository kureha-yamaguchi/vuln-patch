package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            triggerAndCheck(new BoundaryAttribute<Euclidean2D>(null, null), "anchor-null-boundary");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 16);
        for (int i = 0; i < cases; i++) {
            Object attr = buildAttribute(data, i);
            try {
                triggerAndCheck(attr, "fuzz-" + i + "-" + safeType(attr));
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "valid-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "valid-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static Object buildAttribute(FuzzedDataProvider data, int i) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                return new BoundaryAttribute<Euclidean2D>(null, null);
            case 1:
                return new Vector2D(finiteCoord(data.consumeInt()), finiteCoord(data.consumeInt()));
            case 2:
                return Integer.valueOf(data.consumeInt());
            case 3:
                return data.consumeAsciiString(16);
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            default:
                if ((i & 1) == 0) {
                    return new BoundaryAttribute<Euclidean2D>(null, null);
                }
                return new Vector2D(finiteCoord(data.consumeInt()), finiteCoord(data.consumeInt()));
        }
    }

    private static void triggerAndCheck(Object attr, String label) {
        PolygonsSet malformed = new PolygonsSet(new BSPTree<Euclidean2D>(attr));
        PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));

        try {
            empty.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        double emptySize = empty.getSize();
        Vector2D emptyBc = asVector(empty.getBarycenter());

        try {
            malformed.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] malformedVertices = malformed.getVertices();
            Vector2D[][] emptyVertices = empty.getVertices();
            if (malformedVertices == null || emptyVertices == null) {
                return;
            }

            if (malformedVertices.length != 0 || emptyVertices.length != 0) {
                return;
            }

            /* Contract asserted:
             * In computeGeometricalProperties(), when getVertices().length == 0, only a Boolean.TRUE
             * tree attribute denotes whole space; otherwise the region is empty and the method must set
             * size=0 and barycenter=(0,0). A throw-deleting/branch-skipping patch would violate this by
             * leaving stale geometry or reporting whole-space for a non-TRUE attribute.
             */
            if (!(attr instanceof Boolean) || !Boolean.TRUE.equals(attr)) {
                double malformedSize = malformed.getSize();
                Vector2D malformedBc = asVector(malformed.getBarycenter());
                if (!sameDouble(malformedSize, emptySize) || !sameVector(malformedBc, emptyBc)) {
                    throw new RuntimeException(
                            "[oracle:empty-leaf-equivalence] metamorphic violation: no-cut tree with non-TRUE attribute must behave like explicit empty leaf"
                                    + " input=" + label
                                    + " lhs=size=" + malformedSize + ",bc=" + pointToString(malformedBc)
                                    + " rhs=size=" + emptySize + ",bc=" + pointToString(emptyBc));
                }
            } else {
                assertWholeGeometry(malformed, label + "-whole");
            }

            try {
                double beforeSize = malformed.getSize();
                Vector2D beforeBc = asVector(malformed.getBarycenter());
                malformed.computeGeometricalProperties();
                double afterSize = malformed.getSize();
                Vector2D afterBc = asVector(malformed.getBarycenter());
                if (!sameDouble(beforeSize, afterSize) || !sameVector(beforeBc, afterBc)) {
                    throw new RuntimeException(
                            "[oracle:idempotence] metamorphic violation: computeGeometricalProperties must be idempotent on the same region"
                                    + " input=" + label
                                    + " lhs=size=" + beforeSize + ",bc=" + pointToString(beforeBc)
                                    + " rhs=size=" + afterSize + ",bc=" + pointToString(afterBc));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Vector2D bc = asVector(poly.getBarycenter());
        if (!Double.isInfinite(size) || bc == null || !Double.isNaN(bc.getX()) || !Double.isNaN(bc.getY())) {
            throw new RuntimeException(
                    "[oracle:whole-space] metamorphic violation: whole-space leaf must map to infinite size and NaN barycenter"
                            + " input=" + label
                            + " lhs=size=" + size + ",bc=" + pointToString(bc)
                            + " rhs=expected(+INF,NaN,NaN)");
        }
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Vector2D bc = asVector(poly.getBarycenter());
        if (!sameDouble(size, 0.0) || bc == null || !sameDouble(bc.getX(), 0.0) || !sameDouble(bc.getY(), 0.0)) {
            throw new RuntimeException(
                    "[oracle:empty-space] metamorphic violation: empty leaf must map to zero size and origin barycenter"
                            + " input=" + label
                            + " lhs=size=" + size + ",bc=" + pointToString(bc)
                            + " rhs=expected(0.0,0.0,0.0)");
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cn = e.getClassName();
            String mn = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cn)
                    && ("computeGeometricalProperties".equals(mn)
                    || "getVertices".equals(mn)
                    || "followLoop".equals(mn))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.Region".equals(cn) && "getTree".equals(mn)) {
                return true;
            }
            if ("org.apache.commons.math3.util.FastMath".equals(cn)
                    && ("abs".equals(mn) || "max".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation")
                    || name.contains("invalid")
                    || name.contains("argument")
                    || name.contains("parse")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static Vector2D asVector(Object o) {
        return (o instanceof Vector2D) ? (Vector2D) o : null;
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        return (Double.isNaN(a) && Double.isNaN(b))
                || (a == b)
                || (Double.doubleToLongBits(a) == Double.doubleToLongBits(b));
    }

    private static String pointToString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return "(" + p.getX() + "," + p.getY() + ")";
    }

    private static String safeType(Object o) {
        return o == null ? "null" : o.getClass().getSimpleName();
    }

    private static double finiteCoord(int v) {
        return (v % 20001) / 100.0;
    }
}
