package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.GregorianCalendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        try {
            TimeSeries series = buildFuzzSeries(data);
            verifySingletonOverloadAgreement(series, 1, "explore");
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isHarnessOracle(e)) {
                throw e;
            }
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        } catch (Throwable t) {
            return;
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        try {
            s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
        }

        try {
            verifySingletonOverloadAgreement(s, 1, "anchor");
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static TimeSeries buildFuzzSeries(FuzzedDataProvider data) {
        String name = data.consumeAsciiString(16);
        if (name == null || name.length() == 0) {
            name = "S";
        }
        TimeSeries series = new TimeSeries(name);

        int count = data.consumeInt(2, 8);
        int year = 1970 + Math.abs(data.consumeInt()) % 120;
        int month = data.consumeInt(0, 11);
        int dayOfMonth = data.consumeInt(1, 28);

        Calendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(year, month, dayOfMonth, 0, 0, 0);

        for (int i = 0; i < count; i++) {
            if (i > 0) {
                cal.add(Calendar.DAY_OF_MONTH, data.consumeInt(1, 20));
            }
            Day day = new Day(cal.getTime());
            Number value = Integer.valueOf(data.consumeInt());
            series.add(day, value);
        }

        return series;
    }

    private static void verifySingletonOverloadAgreement(TimeSeries series, int index, String tag)
            throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }

        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        /*
         * Contract asserted: createCopy(period,period) and createCopy(index,index) denote the same
         * singleton slice when 'period' is exactly the item at that index, so their observable
         * contents must agree for every correct implementation. A throw-deleting or guard-based patch
         * that returns the wrong series when startIndex == 1 breaks this real-library equivalence.
         */
        if (!sameObservableSeries(byPeriod, byIndex)) {
            throw new RuntimeException(
                    "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree"
                            + " tag=" + tag
                            + " index=" + index
                            + " period=" + exact
                            + " periodCount=" + safeCount(byPeriod)
                            + " indexCount=" + safeCount(byIndex));
        }
    }

    private static boolean sameObservableSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a.getItemCount() != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null ? pb != null : pa.compareTo(pb) != 0) {
                return false;
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                return false;
            }
        }
        return true;
    }

    private static int safeCount(TimeSeries s) {
        return s == null ? -1 : s.getItemCount();
    }

    private static boolean isHarnessOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCauseValidation(Throwable t) {
        if (!(t instanceof IllegalArgumentException) && !(t instanceof NumberFormatException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls) && "createCopy".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeries".equals(cls) && "getIndex".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
