            Number lower = NumberUtils.createNumber(numeric + "l");
            Number upper = NumberUtils.createNumber(numeric + "L");

            /*
             * Contract visible in NumberUtils.createNumber: for a valid integral payload with an explicit
             * l/L suffix, createNumber parses the same numeric text that createLong(numeric) would parse;
             * lower/upper case suffixes share the same logic; the unsuffixed integral parse denotes the
             * same quantity. A patch that merely suppresses the crash but makes l/L inputs unreachable or
             * rejected will violate this relation.
             */
            if (!(lower instanceof Long)
                    || !(upper instanceof Long)
                    || !(unsuffixed instanceof Long)
                    || lower.longValue() != helperLong.longValue()
                    || upper.longValue() != helperLong.longValue()
                    || unsuffixed.longValue() != helperLong.longValue()) {
                throw new RuntimeException(
                        "[oracle:plus-signed-long-consistency] metamorphic violation: explicit plus-signed long suffix parsing must agree with createLong and unsuffixed createNumber input="
                                + numeric
                                + " lower=" + lower
                                + " upper=" + upper
                                + " unsuffixed=" + unsuffixed
                                + " helper=" + helperLong);
            }
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                throw new RuntimeException(
                        "[oracle:plus-signed-long-rejection] metamorphic violation: helper-valid plus-signed decimal with explicit l/L suffix must not be rejected input="
                                + numeric,
                        e);
            }
            return;
        }

        String overflowDigits = buildOverflowDigits(data);
        String overflowNumeric = "+" + overflowDigits;

        BigInteger helperBig;
        Number overflowUnsuffixed;
        try {
            helperBig = NumberUtils.createBigInteger(overflowNumeric);
            overflowUnsuffixed = NumberUtils.createNumber(overflowNumeric);
        } catch (RuntimeException e) {
            return;
        }

        try {
            Number explicit = NumberUtils.createNumber(overflowNumeric + (data.consumeBoolean() ? "L" : "l"));

            /*
             * Contract visible in NumberUtils.createNumber: in the explicit l/L branch, if createLong
             * overflows, parsing falls back to createBigInteger on the same numeric payload. Therefore the
             * explicit-suffix parse and the unsuffixed parse must preserve exactly the same BigInteger value.
             */
            if (!(explicit instanceof BigInteger)
                    || !(overflowUnsuffixed instanceof BigInteger)
                    || !helperBig.equals(explicit)
                    || !helperBig.equals(overflowUnsuffixed)) {
                throw new RuntimeException(
                        "[oracle:plus-signed-bigint-consistency] metamorphic violation: overflow plus-signed explicit l/L parsing must agree with createBigInteger and unsuffixed createNumber input="
                                + overflowNumeric
                                + " explicit=" + explicit
                                + " unsuffixed=" + overflowUnsuffixed
                                + " helper=" + helperBig);
            }
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                throw new RuntimeException(
                        "[oracle:plus-signed-bigint-rejection] metamorphic violation: overflow plus-signed decimal with explicit l/L suffix must fall back to BigInteger, not be rejected input="
                                + overflowNumeric,
                        e);
            }
        }
    }
