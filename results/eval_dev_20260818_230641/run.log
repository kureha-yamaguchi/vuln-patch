package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String s : anchors) {
            try {
                String out = StringEscapeUtils.escapeCsv(s);
                // Contract: CSV escaping only quotes fields containing comma, quote, CR, or LF.
                // These anchor inputs contain none of those characters, so a correct implementation
                // must return them unchanged. A throw-deleting or bookkeeping-breaking patch could
                // silently drop or alter characters; this post-condition detects that.
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: valid CSV-safe input must be unchanged input=" + quote(s) + " lhs=" + quote(out) + " rhs=" + quote(s));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }

        String safePrefix = filterCsvSafe(data.consumeAsciiString(32));
        String safeSuffix = filterCsvSafe(data.consumeAsciiString(32));

        int cp1 = data.consumeInt(0x10000, 0x10FFFF);
        while (!Character.isValidCodePoint(cp1) || Character.isSurrogate((char) cp1)) {
            cp1 = data.consumeInt(0x10000, 0x10FFFF);
        }
        String pair1 = new String(Character.toChars(cp1));

        String pair2 = "";
        if (data.consumeBoolean()) {
            int cp2 = data.consumeInt(0x10000, 0x10FFFF);
            while (!Character.isValidCodePoint(cp2) || Character.isSurrogate((char) cp2)) {
                cp2 = data.consumeInt(0x10000, 0x10FFFF);
            }
            pair2 = new String(Character.toChars(cp2));
        }

        String mid = filterCsvSafe(data.consumeAsciiString(32));
        String candidate;
        switch (data.consumeInt(0, 4)) {
            case 0:
                candidate = safePrefix + pair1 + safeSuffix;
                break;
            case 1:
                candidate = pair1 + safeSuffix;
                break;
            case 2:
                candidate = safePrefix + pair1;
                break;
            case 3:
                candidate = safePrefix + pair1 + mid + pair2 + safeSuffix;
                break;
            default:
                candidate = safePrefix + pair1 + mid;
                break;
        }

        try {
            String out = StringEscapeUtils.escapeCsv(candidate);
            // Contract: for inputs with no comma, quote, CR, or LF, escapeCsv returns the input unchanged.
            // We build candidate from CSV-safe ASCII plus valid supplementary code points, so it is valid
            // by construction and must be accepted unchanged by any correct implementation.
            if (!candidate.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: valid CSV-safe input must be unchanged input=" + quote(candidate) + " lhs=" + quote(out) + " rhs=" + quote(candidate));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String left = filterCsvSafe(data.consumeAsciiString(24)) + pair1;
        String right = pair2 + filterCsvSafe(data.consumeAsciiString(24));

        try {
            String whole = StringEscapeUtils.escapeCsv(left + right);
            String split = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);
            // Contract: since both halves and their concatenation are CSV-safe (no special CSV chars),
            // each call must be identity; therefore escaping the concatenation must equal concatenating
            // the escaped halves. This catches silent output corruption even if no exception is thrown.
            if (!whole.equals(split)) {
                throw new RuntimeException("[oracle:csv-compose] metamorphic violation: escapeCsv(a+b) must equal escapeCsv(a)+escapeCsv(b) for CSV-safe inputs input=" + quote(left + right) + " lhs=" + quote(whole) + " rhs=" + quote(split));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("malformed") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String filterCsvSafe(String in) {
        StringBuilder sb = new StringBuilder(in.length());
        for (int i = 0; i < in.length(); i++) {
            char c = in.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }
}
