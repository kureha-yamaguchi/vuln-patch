                    + " lhsCount=" + a.getItemCount() + " rhsCount=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            Number va = a.getValue(i);
            Number vb = b.getValue(i);

            boolean samePeriod = (pa == null && pb == null)
                    || (pa != null && pb != null && pa.compareTo(pb) == 0 && pb.compareTo(pa) == 0);
            boolean sameValue = (va == null && vb == null)
