    private static void runExplore(FuzzedDataProvider data) {
        int year = 1990 + data.consumeInt(0, 80);
        int month = data.consumeInt(1, 12);
        int day = data.consumeInt(1, 28);

        java.util.Calendar cal = new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(year, month - 1, day, 0, 0, 0);

        int firstToSecondGap = data.consumeInt(2, 120);

        TimeSeries s = new TimeSeries(data.consumeAsciiString(16));

        Day first = dayFromCalendar(cal);
        s.add(first, 1.0);

        java.util.Calendar secondCal = (java.util.Calendar) cal.clone();
        secondCal.add(java.util.Calendar.DAY_OF_MONTH, firstToSecondGap);
        Day second = dayFromCalendar(secondCal);
        s.add(second, 2.0);

        int extra = data.consumeInt(0, 5);
        java.util.Calendar cursor = (java.util.Calendar) secondCal.clone();
        for (int i = 0; i < extra; i++) {
            cursor.add(java.util.Calendar.DAY_OF_MONTH, data.consumeInt(1, 40));
            Day d = dayFromCalendar(cursor);
            s.add(d, 3.0 + i);
        }

        int startOffset = data.consumeInt(1, firstToSecondGap - 1);
        int endOffset = data.consumeInt(startOffset, firstToSecondGap - 1);

        java.util.Calendar startCal = (java.util.Calendar) cal.clone();
        startCal.add(java.util.Calendar.DAY_OF_MONTH, startOffset);
        Day start = dayFromCalendar(startCal);

        java.util.Calendar endCal = (java.util.Calendar) cal.clone();
        endCal.add(java.util.Calendar.DAY_OF_MONTH, endOffset);
        Day end = dayFromCalendar(endCal);

        if (start.compareTo(end) > 0) {
            return;
        }

        try {
            TimeSeries copy = s.createCopy(start, end);
            /*
             * Contract asserted: createCopy(start,end) returns the inclusive subseries in the
             * ordered range [start,end]. We construct start/end wholly inside the real gap between
             * the first and second data items, so no source item lies in the range and the result
             * must be empty. A throw-deleting or wrong-slice patch violates this observable result.
             */
            assertEmptySeries(copy, "gap-empty", start, end);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            return;
        }

        try {
            /*
             * Contract asserted: for any exact existing item, createCopy(period,period) and
             * createCopy(index,index) denote the same singleton subseries. A patch that special-cases
             * startIndex bookkeeping can make the period overload return the wrong slice.
             */
            verifySingletonOverloadAgreement(s, 1, "singleton-overloads");
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static Day dayFromCalendar(java.util.Calendar cal) {
        return new Day(
                cal.get(java.util.Calendar.DAY_OF_MONTH),
                cal.get(java.util.Calendar.MONTH) + 1,
                cal.get(java.util.Calendar.YEAR));
    }

    private static void verifySingletonOverloadAgreement(TimeSeries series, int index, String tag)
            throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        if (!sameObservableSeries(byPeriod, byIndex)) {
            throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree"
                            + " index=" + index
                            + " period=" + exact
                            + " periodCount=" + byPeriod.getItemCount()
                            + " indexCount=" + byIndex.getItemCount());
        }
    }

    private static void assertEmptySeries(TimeSeries copy, String tag, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: createCopy returned null"
                            + " start=" + start + " end=" + end);
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: gap-bounded createCopy must be empty"
                            + " start=" + start + " end=" + end
                            + " itemCount=" + copy.getItemCount());
        }
    }

    private static boolean sameObservableSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        int count = a.getItemCount();
        if (count != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null ? pb != null : pa.compareTo(pb) != 0) {
                return false;
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (!sameNumber(va, vb)) {
                return false;
            }
        }
        return true;
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        double da = a.doubleValue();
        double db = b.doubleValue();
        long la = Double.doubleToLongBits(da);
        long lb = Double.doubleToLongBits(db);
        return la == lb;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }
}
