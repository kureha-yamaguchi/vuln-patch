package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final class CallResult {
        final boolean success;
        final String value;

        CallResult(boolean success, String value) {
            this.success = success;
            this.value = value;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        int n = data.consumeInt(1, 6);
        String[] searchList = new String[n];
        String[] replacementList = new String[n];

        int ensuredMatchIndex = data.consumeInt(0, n - 1);
        int invalidIndex = data.consumeInt(0, n - 1);

        for (int i = 0; i < n; i++) {
            int searchKind = data.consumeInt(0, 3);
            if (i == ensuredMatchIndex) {
                String token = data.consumeAsciiString(4);
                if (StringUtils.length(token) == 0) {
                    token = "a";
                }
                searchList[i] = token;
            } else if (searchKind == 0) {
                searchList[i] = null;
            } else if (searchKind == 1) {
                searchList[i] = "";
            } else {
                searchList[i] = data.consumeAsciiString(4);
            }

            int replKind = data.consumeInt(0, 2);
            if (replKind == 0) {
                replacementList[i] = null;
            } else if (replKind == 1) {
                replacementList[i] = "";
            } else {
                replacementList[i] = data.consumeString(6);
            }
        }

        if (n > 1 || data.consumeBoolean()) {
            if (data.consumeBoolean()) {
                replacementList[invalidIndex] = null;
            } else {
                searchList[invalidIndex] = data.consumeBoolean() ? null : "";
                if (invalidIndex == ensuredMatchIndex) {
                    int fallback = (ensuredMatchIndex + 1) % n;
                    String token = data.consumeAsciiString(4);
                    if (StringUtils.length(token) == 0) {
                        token = "a";
                    }
                    searchList[fallback] = token;
                    ensuredMatchIndex = fallback;
                }
            }
        }

        String ensured = searchList[ensuredMatchIndex];
        if (StringUtils.length(ensured) == 0) {
            ensured = "a";
            searchList[ensuredMatchIndex] = ensured;
        }
        if (replacementList[ensuredMatchIndex] == null && n == 1) {
            replacementList[ensuredMatchIndex] = "";
        }

        String prefix = data.consumeString(8);
        String infix = data.consumeString(8);
        String suffix = data.consumeRemainingAsString();
        String text = prefix + ensured + infix + suffix;

        StringUtils.length(text);
        for (int i = 0; i < n; i++) {
            StringUtils.length(searchList[i]);
            StringUtils.length(replacementList[i]);
        }

        CallResult original = tryReplaceEach(text, searchList, replacementList);

        String[][] filtered = filterInvalidPairs(searchList, replacementList);
        CallResult normalized = tryReplaceEach(text, filtered[0], filtered[1]);

        // Contract asserted from the StringUtils tests:
        // entries with null replacement, null search, or empty search are ignored
        // (e.g. replaceEach("aba", {"a"}, {null}) == "aba" and
        // replaceEach("aba", {"a","b"}, {"c",null}) == "cbc").
        // Therefore removing those inert pairs must not change the result.
        // A throw-deleting or over-broad guard patch could silently skip valid replacements
        // or mishandle bookkeeping; this oracle catches that as wrong output.
        if (original.success && normalized.success) {
            if (!safeEquals(original.value, normalized.value)) {
                throw new RuntimeException(
                    "[oracle:ignore-invalid-pairs] metamorphic violation: removing null/empty search-replace pairs changed result"
                        + " input=" + String.valueOf(text)
                        + " lhs=" + String.valueOf(original.value)
                        + " rhs=" + String.valueOf(normalized.value));
            }
        }
    }

    private static void exerciseAnchor() {
        tryReplaceEach(null, new String[] {"a"}, new String[] {"b"});
        tryReplaceEach("aba", null, null);
        tryReplaceEach("aba", new String[0], null);
        tryReplaceEach("aba", null, new String[0]);
        tryReplaceEach("aba", new String[] {"a"}, null);
        tryReplaceEach("aba", new String[] {null}, new String[] {"a"});
        tryReplaceEach("aba", new String[] {"a"}, new String[] {null});
        tryReplaceEach("aba", new String[] {"a", "b"}, new String[] {"c", null});
    }

    private static CallResult tryReplaceEach(String text, String[] searchList, String[] replacementList) {
        try {
            return new CallResult(true, StringUtils.replaceEach(text, searchList, replacementList));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return new CallResult(false, null);
            }
            if (isRootCause(t)) {
                throw t;
            }
            return new CallResult(false, null);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String[][] filterInvalidPairs(String[] searchList, String[] replacementList) {
        if (searchList == null || replacementList == null || searchList.length != replacementList.length) {
            return new String[][] {searchList, replacementList};
        }

        int keep = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && StringUtils.length(searchList[i]) != 0 && replacementList[i] != null) {
                keep++;
            }
        }

        String[] filteredSearch = new String[keep];
        String[] filteredReplacement = new String[keep];
        int j = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && StringUtils.length(searchList[i]) != 0 && replacementList[i] != null) {
                filteredSearch[j] = searchList[i];
                filteredReplacement[j] = replacementList[i];
                j++;
            }
        }
        return new String[][] {filteredSearch, filteredReplacement};
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
