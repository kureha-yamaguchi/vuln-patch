package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class H {
            boolean isOracleFailure(Throwable t) {
                return t instanceof RuntimeException
                        && t.getMessage() != null
                        && t.getMessage().startsWith("[oracle:");
            }

            boolean hasRelevantStack(Throwable t) {
                StackTraceElement[] frames = t.getStackTrace();
                if (frames == null) {
                    return false;
                }
                for (int i = 0; i < frames.length; i++) {
                    StackTraceElement f = frames[i];
                    if (!"org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                        continue;
                    }
                    String m = f.getMethodName();
                    if ("createNumber".equals(m)
                            || "createInteger".equals(m)
                            || "isAllZeros".equals(m)
                            || "isDigits".equals(m)
                            || "createLong".equals(m)
                            || "createBigInteger".equals(m)
                            || "createFloat".equals(m)
                            || "createDouble".equals(m)
                            || "createBigDecimal".equals(m)) {
                        return true;
                    }
                }
                return false;
            }

            boolean isCleanReject(Throwable t) {
                return t instanceof IllegalArgumentException;
            }

            boolean isKnownRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
            }

            BigDecimal toBigDecimal(Number n) {
                if (n == null) {
                    return null;
                }
                if (n instanceof Double) {
                    double d = ((Double) n).doubleValue();
                    if (Double.isNaN(d) || Double.isInfinite(d)) {
                        return null;
                    }
                }
                if (n instanceof Float) {
                    float f = ((Float) n).floatValue();
                    if (Float.isNaN(f) || Float.isInfinite(f)) {
                        return null;
                    }
                }
                try {
                    return new BigDecimal(n.toString());
                } catch (RuntimeException e) {
                    return null;
                }
            }

            boolean sameNumericValue(Number a, Number b) {
                BigDecimal left = toBigDecimal(a);
                BigDecimal right = toBigDecimal(b);
                return left != null && right != null && left.compareTo(right) == 0;
            }

            void exercise(String s) {
                try {
                    NumberUtils.createNumber(s);
                } catch (RuntimeException t) {
                    if (isOracleFailure(t)) {
                        throw t;
                    }
                }
            }

            void checkEquivalent(String a, String b, String oracleId) {
                try {
                    Number left = NumberUtils.createNumber(a);
                    Number right = NumberUtils.createNumber(b);
                    if (left == null || right == null) {
                        return;
                    }
                    if (!sameNumericValue(left, right)) {
                        throw new RuntimeException("[oracle:" + oracleId
                                + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                                + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
                    }
                } catch (RuntimeException t) {
                    if (isOracleFailure(t)) {
                        throw t;
                    }
                }
            }

            String digitsOnly(String s, int minLen, boolean forceNonZero) {
                StringBuilder out = new StringBuilder();
                if (s != null) {
                    for (int i = 0; i < s.length(); i++) {
                        char c = s.charAt(i);
                        if (c >= '0' && c <= '9') {
                            out.append(c);
                        } else {
                            out.append((char) ('0' + (c & 7)));
                        }
                    }
                }
                while (out.length() < minLen) {
                    out.append('0');
                }
                if (forceNonZero) {
                    boolean allZero = true;
                    for (int i = 0; i < out.length(); i++) {
                        if (out.charAt(i) != '0') {
                            allZero = false;
                            break;
                        }
                    }
                    if (allZero) {
                        out.setCharAt(out.length() - 1, '1');
                    }
                }
                return out.toString();
            }
        }

        H h = new H();

        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (h.isOracleFailure(t)) {
                throw t;
            }
        }

        String[] anchors = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2."
        };
        for (int i = 0; i < anchors.length; i++) {
            h.exercise(anchors[i]);
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String intDigits = h.digitsOnly(data.consumeAsciiString(data.consumeInt(1, 8)), 1, true);
        String fracDigits = h.digitsOnly(data.consumeAsciiString(data.consumeInt(1, 5)), 1, false);
        String expDigits = h.digitsOnly(data.consumeAsciiString(data.consumeInt(1, 3)), 1, false);
        String expSign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';
        char oppositeExpMarker = expMarker == 'e' ? 'E' : 'e';

        String integerOnly = sign + intDigits;
        String decimalOnly = sign + intDigits + "." + fracDigits;
        String scientificInt = integerOnly + expMarker + expSign + expDigits;
        String scientificIntOpp = integerOnly + oppositeExpMarker + expSign + expDigits;
        String scientificDec = decimalOnly + expMarker + expSign + expDigits;
        String scientificDecOpp = decimalOnly + oppositeExpMarker + expSign + expDigits;
        String scientificIntZero = integerOnly + expMarker + "0";
        String scientificDecZero = decimalOnly + expMarker + "0";
        String redundantPointScientific = integerOnly + ".0" + expMarker + expSign + expDigits;

        h.exercise(integerOnly);
        h.exercise(decimalOnly);
        h.exercise(scientificInt);
        h.exercise(scientificDec);
        h.exercise(scientificDec + "D");
        h.exercise(scientificDec + "d");
        h.exercise(scientificDec + "F");
        h.exercise(scientificDec + "f");

        /*
         * Contract used for these oracles:
         * createNumber parses numeric strings. Therefore inputs that differ only in
         * exponent-marker case ('e' vs 'E'), in adding a redundant exponent of 0,
         * in adding a redundant ".0" before an exponent, or in floating suffix case
         * ('D' vs 'd', 'F' vs 'f') must denote the same numeric value.
         * A patch that merely suppresses the original substring failure or routes the
         * parser down the wrong branch can silently change the computed mantissa /
         * exponent split and violate these equivalences without throwing.
         */
        h.checkEquivalent(scientificInt, scientificIntOpp, "exp-marker-case-integral");
        h.checkEquivalent(scientificDec, scientificDecOpp, "exp-marker-case-decimal");
        h.checkEquivalent(integerOnly, scientificIntZero, "integral-vs-exp-zero");
        h.checkEquivalent(decimalOnly, scientificDecZero, "decimal-vs-exp-zero");
        h.checkEquivalent(scientificInt, redundantPointScientific, "redundant-decimal-before-exponent");
        h.checkEquivalent(decimalOnly + "D", decimalOnly + "d", "double-suffix-case-decimal");
        h.checkEquivalent(scientificDec + "D", scientificDec + "d", "double-suffix-case-scientific");
        h.checkEquivalent(decimalOnly + "F", decimalOnly + "f", "float-suffix-case-decimal");
        h.checkEquivalent(scientificDec + "F", scientificDec + "f", "float-suffix-case-scientific");

        String extraPrefix = data.consumeString(4);
        String extraSuffix = data.consumeRemainingAsString();
        if (extraPrefix == null) {
            extraPrefix = "";
        }
        if (extraSuffix == null) {
            extraSuffix = "";
        }
        h.exercise(extraPrefix + scientificDec + extraSuffix);
    }
}
