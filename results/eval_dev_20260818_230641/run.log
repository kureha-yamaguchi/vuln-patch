package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            runOne(anchors[i]);
        }

        String prefix = sanitizeAsciiNoCsv(data.consumeAsciiString(16));
        String suffix = sanitizeAsciiNoCsv(data.consumeAsciiString(16));
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder(prefix.length() + suffix.length() + pairCount * 2 + 8);
        sb.append(prefix);

        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                sb.append(sanitizeAsciiNoCsv(data.consumeAsciiString(8)));
            }
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(codePoint));
        }

        sb.append(suffix);
        runOne(sb.toString());

        if (data.consumeBoolean()) {
            StringBuilder alt = new StringBuilder();
            alt.append(Character.toChars(data.consumeInt(0x10000, 0x10FFFF)));
            alt.append(sanitizeAsciiNoCsv(data.consumeRemainingAsString()));
            runOne(alt.toString());
        }
    }

    private static void runOne(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract asserted:
            // escapeCsv returns the input unchanged when the value contains no CSV-special
            // characters requiring quoting (comma, quote, CR, LF). Our generated inputs are
            // valid UTF-16 strings built from ASCII with those characters removed plus valid
            // supplementary code points, so every correct implementation must return them
            // unchanged. A "fix" that merely skips/crushes bookkeeping or silently mangles
            // surrogate-pair handling would violate this observable post-condition.
            if (!hasCsvSpecialChars(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-unchanged] metamorphic violation: escapeCsv must leave no-special-char input unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean hasCsvSpecialChars(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeAsciiNoCsv(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
