    private static void anchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        if (s.getIndex(start) >= 0 || s.getIndex(end) >= 0) {
            throw new RuntimeException(
                    "[oracle:anchor-absent] metamorphic violation: bug trigger endpoints must lie inside a real gap");
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:anchor-empty] metamorphic violation: anchored valid empty-gap copy must be empty"
                            + " count=" + copy.getItemCount()
                            + " items=" + copy.getItems().size()
                            + " periods=" + copy.getTimePeriods().size());
        }
    }

    private static Day addDays(Day base, int delta) {
        RegularTimePeriod cur = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                cur = cur.next();
                if (cur == null) {
                    throw new IllegalArgumentException("day overflow");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                cur = cur.previous();
                if (cur == null) {
                    throw new IllegalArgumentException("day underflow");
                }
            }
        }
        return (Day) cur;
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        List items = series.getItems();
        List periods = series.getTimePeriods();

        if (items.size() != count || periods.size() != count) {
            throw new RuntimeException(
