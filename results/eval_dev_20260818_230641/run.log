                StringBuilder out = new StringBuilder();
                if (s != null) {
                    for (int i = 0; i < s.length(); i++) {
                        char c = s.charAt(i);
                        if (c >= '0' && c <= '9') {
                            out.append(c);
                        } else {
                            out.append((char) ('0' + (c & 7)));
                        }
                    }
                }
                while (out.length() < minLen) {
                    out.append('0');
                }
                if (nonZeroLast) {
                    boolean allZero = true;
                    for (int i = 0; i < out.length(); i++) {
                        if (out.charAt(i) != '0') {
                            allZero = false;
                            break;
                        }
                    }
                    if (allZero) {
                        if (out.length() == 0) {
                            out.append('1');
                        } else {
                            out.setCharAt(out.length() - 1, '1');
                        }
                    }
                }
                return out.toString();
            }
