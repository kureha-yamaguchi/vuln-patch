package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true);
        }

        String candidate = buildValidNonSpecialInput(data);
        exerciseEscapeCsv(candidate, true);

        if (data.consumeBoolean()) {
            String a = buildValidNonSpecialInput(data);
            String b = buildValidNonSpecialInput(data);
            try {
                String ab = StringEscapeUtils.escapeCsv(a + b);
                String ea = StringEscapeUtils.escapeCsv(a);
                String eb = StringEscapeUtils.escapeCsv(b);
                if (!ab.equals(ea + eb)) {
                    throw new RuntimeException("[oracle:csv-compose] metamorphic violation: composition for CSV-safe inputs input=" + printable(a + "|" + b) + " lhs=" + printable(ab) + " rhs=" + printable(ea + eb));
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            }
        }
    }

    private static void exerciseEscapeCsv(String s, boolean assertIdentity) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            /*
             * Contract asserted: StringEscapeUtils.escapeCsv returns the input unchanged
             * when the input contains none of the CSV-special characters comma, quote,
             * CR, or LF. The failing test demonstrates this for surrogate pairs.
             * Therefore, for valid-by-construction inputs made only of non-special
             * characters (including supplementary code points), a correct implementation
             * must not throw and must return exactly the original string. A patch that
             * merely deletes the throwing statement or skips consumed characters would
             * violate this observable post-condition.
             */
            if (assertIdentity && isCsvSafe(s) && !out.equals(s)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }
    }

    private static String buildValidNonSpecialInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        sb.append(sanitizeCsvSafe(data.consumeAsciiString(data.consumeInt(0, 8))));

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp) || Character.isSurrogate((char) cp)) {
                cp = 0x10000 + Math.floorMod(cp, 0x10FFFF - 0x10000 + 1);
            }
            sb.append(Character.toChars(cp));
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(data.consumeInt(0, 8))));
        }

        if (sb.length() == 0) {
            sb.append("A").append(Character.toChars(0x1F630)).append("B");
        }
        return sb.toString();
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCsvSafe(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
