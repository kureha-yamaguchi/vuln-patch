package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            if (!"org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                continue;
            }
            String m = f.getMethodName();
            if ("createNumber".equals(m)
                    || "createInteger".equals(m)
                    || "isAllZeros".equals(m)
                    || "isDigits".equals(m)
                    || "createLong".equals(m)
                    || "createBigInteger".equals(m)
                    || "createFloat".equals(m)
                    || "createDouble".equals(m)
                    || "createBigDecimal".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal left = toBigDecimal(a);
        BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static Number parseOrNull(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanReject(t) || isRootCause(t)) {
                return null;
            }
            return null;
        }
    }

    private static void exerciseSilently(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                return;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void assertEquivalent(String a, String b, String oracleId) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (t instanceof RuntimeException
                    && t.getMessage() != null
                    && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isRootCause(t) || isCleanReject(t)) {
                return;
            }
        }
    }

    private static String digitsOnly(String s, int minLen, boolean forceNonZero) {
        StringBuilder out = new StringBuilder();
        if (s != null) {
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if (c >= '0' && c <= '9') {
                    out.append(c);
                } else {
                    out.append((char) ('0' + (c & 7)));
                }
            }
        }
        while (out.length() < minLen) {
            out.append('0');
        }
        if (forceNonZero) {
            boolean allZero = true;
            for (int i = 0; i < out.length(); i++) {
                if (out.charAt(i) != '0') {
                    allZero = false;
                    break;
                }
            }
            if (allZero) {
                if (out.length() == 0) {
                    out.append('1');
                } else {
                    out.setCharAt(out.length() - 1, '1');
                }
            }
        }
        return out.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (!isRootCause(t) && !isCleanReject(t)) {
                return;
            }
        }

        String[] anchors = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                "",
                " ",
                "\t"
        };
        for (int i = 0; i < anchors.length; i++) {
            exerciseSilently(anchors[i]);
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String intDigits = digitsOnly(data.consumeAsciiString(10), 1, true);
        String fracDigits = digitsOnly(data.consumeAsciiString(8), 1, false);
        String expDigits = digitsOnly(data.consumeAsciiString(4), 1, false);
        String expSign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';

        String suffix = "";
        switch (data.consumeInt(0, 6)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            case 5:
                suffix = "l";
                break;
            case 6:
                suffix = "L";
                break;
            default:
                break;
        }

        String integerOnly = sign + intDigits;
        String decimalOnly = sign + intDigits + "." + fracDigits;
        String decimalSuffixD = decimalOnly + "D";
        String decimalSuffixF = decimalOnly + "F";
        String scientificInt = sign + intDigits + expMarker + expSign + expDigits;
        String scientificIntOpp = sign + intDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String scientificDecimal = sign + intDigits + "." + fracDigits + expMarker + expSign + expDigits;
        String scientificDecimalOpp = sign + intDigits + "." + fracDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String scientificDecimalWithSuffix = scientificDecimal + suffix;
        String scientificDecimalOppWithSuffix = scientificDecimalOpp + suffix;
        String redundantPoint = sign + intDigits + ".0" + expMarker + expSign + expDigits;
        String doubleExpWeird = intDigits + "e" + digitsOnly(data.consumeAsciiString(3), 0, false) + "E";
        String decimalJunk = decimalOnly + data.consumeString(4);

        exerciseSilently(integerOnly);
        exerciseSilently(decimalOnly);
        exerciseSilently(decimalSuffixD);
        exerciseSilently(decimalSuffixF);
        exerciseSilently(scientificInt);
        exerciseSilently(scientificDecimal);
        exerciseSilently(scientificDecimalWithSuffix);
        exerciseSilently(doubleExpWeird);
        exerciseSilently(decimalJunk);

        Number parsedInt = parseOrNull(integerOnly);
        if (parsedInt != null) {
            assertEquivalent(integerOnly, integerOnly + "L", "integral-vs-explicit-long");
        }

        Number parsedDec = parseOrNull(decimalOnly);
        if (parsedDec != null) {
            assertEquivalent(decimalOnly, decimalOnly + "D", "decimal-vs-explicit-double");
            assertEquivalent(decimalOnly, decimalOnly + "F", "decimal-vs-explicit-float-when-accepted");
        }

        /*
         * Contract asserted here: createNumber parses numeric strings, so representations that
         * denote the same numeric quantity must agree on value when both are accepted. Changing
         * only the exponent marker case ('e' vs 'E'), adding a redundant ".0" before the exponent,
         * or adding an explicit numeric type suffix does not change the numeric value described by
         * the input string. A patch that merely avoids the substring crash but computes mantissa or
         * exponent boundaries incorrectly can silently produce a different Number/value; these
         * relations catch that wrong-output behavior.
         */
        assertEquivalent(scientificInt, scientificIntOpp, "scientific-exp-case-integral");
        assertEquivalent(scientificDecimal, scientificDecimalOpp, "scientific-exp-case-decimal");
        assertEquivalent(scientificInt, redundantPoint, "redundant-decimal-before-exponent");
        if (suffix.length() > 0 && !"l".equals(suffix) && !"L".equals(suffix)) {
            assertEquivalent(scientificDecimalWithSuffix, scientificDecimalOppWithSuffix, "scientific-exp-case-suffix");
        }

        String observed = anchors[data.consumeInt(0, anchors.length - 1)];
        exerciseSilently(observed);

        String prefix = data.consumeString(3);
        String postfix = data.consumeRemainingAsString();
        if (prefix == null) {
            prefix = "";
        }
        if (postfix == null) {
            postfix = "";
        }
        exerciseSilently(prefix + scientificDecimal + postfix);
    }
