        checkExpected(null, new String[] { "a" }, new String[] { "b" }, null, "anchor-null-text");
        checkExpected("aba", null, null, "aba", "anchor-null-lists");
        checkExpected("aba", new String[0], null, "aba", "anchor-empty-search");
        checkExpected("aba", null, new String[0], "aba", "anchor-empty-repl");
        checkExpected("aba", new String[] { "a" }, null, "aba", "anchor-null-repl-list");
        checkExpected("aba", new String[] { null }, new String[] { "a" }, "aba", "anchor-null-search-element");
        checkExpected("aba", new String[] { "a" }, new String[] { null }, "aba", "anchor-null-repl-element");
        checkExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "anchor-mixed-null-repl");

        int pairCount = data.consumeInt(0, 8);
        String text;
        if (data.consumeBoolean()) {
            text = null;
        } else {
            text = data.consumeString(24);
        }

        String[] searchList = new String[pairCount];
        String[] replacementList = new String[pairCount];

        for (int i = 0; i < pairCount; i++) {
            if (data.consumeInt(0, 4) == 0) {
                searchList[i] = null;
            } else if (data.consumeInt(0, 4) == 0) {
                searchList[i] = "";
            } else {
                searchList[i] = data.consumeString(8);
            }

            if (data.consumeInt(0, 3) == 0) {
                replacementList[i] = null;
            } else {
                replacementList[i] = data.consumeString(8);
            }
        }

        // Contract/oracle:
        // The implementation explicitly skips any pair where searchList[i] is null,
        // searchList[i].length() == 0, or replacementList[i] is null. Therefore a
        // correct implementation must behave the same as one where those ignored
        // pairs are removed entirely. A throw-deleting or seed-special-casing patch
        // can violate this without crashing, so compare the two real library calls.
        String[] filteredSearch = new String[pairCount];
        String[] filteredReplacement = new String[pairCount];
        int kept = 0;
        for (int i = 0; i < pairCount; i++) {
            String s = searchList[i];
            String r = replacementList[i];
            if (s != null && s.length() != 0 && r != null) {
                filteredSearch[kept] = s;
                filteredReplacement[kept] = r;
                kept++;
            }
        }

        String[] compactSearch = new String[kept];
        String[] compactReplacement = new String[kept];
        for (int i = 0; i < kept; i++) {
            compactSearch[i] = filteredSearch[i];
            compactReplacement[i] = filteredReplacement[i];
        }

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, compactSearch, compactReplacement);
        } catch (RuntimeException t) {
            return;
        }

        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:ignored-pairs] metamorphic violation: replaceEach should ignore null/empty search pairs and null replacements"
                    + " input=" + debug(text, searchList, replacementList)
                    + " lhs=" + String.valueOf(lhs)
                    + " rhs=" + String.valueOf(rhs));
        }
    }

    private static void checkExpected(String text, String[] searchList, String[] replacementList, String expected, String tag) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (!safeEquals(actual, expected)) {
                throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: documented replaceEach result mismatch"
                        + " input=" + debug(text, searchList, replacementList)
                        + " lhs=" + String.valueOf(actual)
                        + " rhs=" + String.valueOf(expected));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String debug(String text, String[] searchList, String[] replacementList) {
        return "text=" + String.valueOf(text)
            + ", searchList=" + arrayToString(searchList)
            + ", replacementList=" + arrayToString(replacementList);
    }

    private static String arrayToString(String[] array) {
        if (array == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < array.length; i++) {
            if (i != 0) {
                sb.append(", ");
            }
            sb.append(String.valueOf(array[i]));
        }
        sb.append(']');
        return sb.toString();
    }
}
