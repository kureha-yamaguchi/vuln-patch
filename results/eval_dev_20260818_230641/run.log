package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            executeAnchorSeed();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            if (isBenign(t)) {
                return;
            }
        }

        try {
            exploreGapFamilies(data);
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            if (isBenign(t)) {
                return;
            }
        }
    }

    private static void executeAnchorSeed() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        inspectValidGapRange(s, start, end, "anchor-seed");
        checkSingletonEquivalence(s, 0, "anchor-left-singleton");
        checkSingletonEquivalence(s, 1, "anchor-right-singleton");
    }

    private static void exploreGapFamilies(FuzzedDataProvider data) throws CloneNotSupportedException {
        String name = data.consumeAsciiString(20);
        if (name == null || name.length() == 0) {
            name = "F";
        }
        TimeSeries series = new TimeSeries(name);

        Day left = makeValidDay(
                boundedYear(data.consumeInt(1900, 2100)),
                data.consumeInt(1, 12),
                data.consumeInt(1, 28));
        if (left == null) {
            return;
        }

        int gapWidth = data.consumeInt(2, 1200);
        Day right = shiftDay(left, gapWidth);
        if (right == null) {
            return;
        }

        safeAdd(series, left, data.consumeInt());
        safeAdd(series, right, data.consumeInt());

        int extrasBefore = data.consumeInt(0, 4);
        for (int i = 0; i < extrasBefore; i++) {
            int off = data.consumeInt(1, 400);
            Day d = shiftDay(left, -off);
            if (d != null) {
                safeAdd(series, d, data.consumeInt());
            }
        }

        int extrasAfter = data.consumeInt(0, 4);
        for (int i = 0; i < extrasAfter; i++) {
            int off = data.consumeInt(1, 400);
            Day d = shiftDay(right, off);
            if (d != null) {
                safeAdd(series, d, data.consumeInt());
            }
        }

        if (gapWidth < 2) {
            return;
        }

        int startOffset = data.consumeInt(1, gapWidth - 1);
        int endOffset = data.consumeInt(startOffset, gapWidth - 1);

        Day start = shiftDay(left, startOffset);
        Day end = shiftDay(left, endOffset);
        if (start == null || end == null) {
            return;
        }

        inspectValidGapRange(series, start, end, "fuzz-gap");

        if (start.compareTo(end) < 0) {
            int innerStartOffset = data.consumeInt(startOffset, endOffset);
            int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
            Day innerStart = shiftDay(left, innerStartOffset);
            Day innerEnd = shiftDay(left, innerEndOffset);
            if (innerStart != null && innerEnd != null) {
                inspectValidGapRange(series, innerStart, innerEnd, "fuzz-subgap");
            }
        }

        if (series.getItemCount() > 0) {
            int idx = data.consumeInt(0, series.getItemCount() - 1);
            checkSingletonEquivalence(series, idx, "fuzz-singleton");
        }
    }

    private static void inspectValidGapRange(TimeSeries series, Day start, Day end, String tag)
            throws CloneNotSupportedException {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

