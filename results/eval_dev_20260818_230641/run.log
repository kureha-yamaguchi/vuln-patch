                    break;
                case 9:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + suffix;
                    break;
                case 10:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + suffix;
                    break;
                case 11:
                    probe = "0x" + data.consumeAsciiString(1) + suffix;
                    break;
