        String decimalOnly = sign + intDigits.toString() + "." + fracDigits.toString();
        String scientific = sign + intDigits.toString() + expMarker + expSign + expDigits.toString();
        String scientificOppCase = sign + intDigits.toString() + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits.toString();
        String decimalScientific = sign + intDigits.toString() + "." + fracDigits.toString() + expMarker + expSign + expDigits.toString();
        String decimalScientificOppCase = sign + intDigits.toString() + "." + fracDigits.toString() + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits.toString();
        String redundantPointScientific = sign + intDigits.toString() + ".0" + expMarker + expSign + expDigits.toString();

        h.exercise(integerOnly);
        h.exercise(decimalOnly);
        h.exercise(scientific);
        h.exercise(decimalScientific);
        h.exercise(decimalScientific + suffix);
        h.exercise(scientific + suffix);

        Number parsedInteger = h.parseOrNull(integerOnly);
        if (parsedInteger != null) {
            try {
