package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        String fuzzText = data.consumeString(32);
        int pairCount = data.consumeInt(1, 4);

        String[] baseSearch = new String[pairCount];
        String[] baseReplacement = new String[pairCount];

        int activeIndex = data.consumeInt(0, pairCount - 1);
        String activeNeedle = data.consumeString(8);
        if (activeNeedle == null || activeNeedle.length() == 0) {
            activeNeedle = "A";
        }
        String activeReplacement = data.consumeString(8);
        if (activeReplacement == null) {
            activeReplacement = "";
        }

        for (int i = 0; i < pairCount; i++) {
            boolean makeNullSearch = data.consumeBoolean();
            boolean makeEmptySearch = data.consumeBoolean();
            boolean makeNullReplacement = data.consumeBoolean();

            if (i == activeIndex) {
                baseSearch[i] = activeNeedle;
                baseReplacement[i] = activeReplacement;
            } else {
                if (makeNullSearch) {
                    baseSearch[i] = null;
                } else if (makeEmptySearch) {
                    baseSearch[i] = "";
                } else {
                    String s = data.consumeString(8);
                    baseSearch[i] = s;
                }

                if (makeNullReplacement) {
                    baseReplacement[i] = null;
                } else {
                    baseReplacement[i] = data.consumeString(8);
                }
            }
        }

        int insertPos = 0;
        if (fuzzText != null && fuzzText.length() > 0) {
            insertPos = data.consumeInt(0, fuzzText.length());
        }
        String text = fuzzText.substring(0, insertPos) + activeNeedle + fuzzText.substring(insertPos);

        String ignoredSearch = data.consumeString(8);
        if (ignoredSearch == null || ignoredSearch.length() == 0) {
            ignoredSearch = "Z";
        }

        String[] extendedSearch = new String[pairCount + 1];
        String[] extendedReplacement = new String[pairCount + 1];
        System.arraycopy(baseSearch, 0, extendedSearch, 0, pairCount);
        System.arraycopy(baseReplacement, 0, extendedReplacement, 0, pairCount);
        extendedSearch[pairCount] = ignoredSearch;
        extendedReplacement[pairCount] = null;

        try {
            String lhs = StringUtils.replaceEach(text, baseSearch, baseReplacement);
            String rhs = StringUtils.replaceEach(text, extendedSearch, extendedReplacement);

            /*
             * Contract asserted: pairs with a null replacement are ignored.
             * This is visible in the real API examples:
             *   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
             *   replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc"
             * Therefore, appending one extra (non-empty search -> null replacement) pair
             * must not change the observable result for any correct implementation.
             * A "fix" that merely suppresses the crash but mishandles the ignored pair
             * would violate this relation.
             */
            if (!equalsNullable(lhs, rhs)) {
                throw new RuntimeException("[oracle:null-repl-ignored] metamorphic violation: appending ignored null-replacement pair changed result input="
                        + String.valueOf(text)
                        + " lhs=" + String.valueOf(lhs)
                        + " rhs=" + String.valueOf(rhs));
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runAnchorChecks() {
        checkExpected(null, new String[] { "a" }, new String[] { "b" }, null, "anchor-null-text");
        checkExpected("aba", null, null, "aba", "anchor-null-arrays");
        checkExpected("aba", new String[0], null, "aba", "anchor-empty-search");
        checkExpected("aba", null, new String[0], "aba", "anchor-empty-replacement");
        checkExpected("aba", new String[] { "a" }, null, "aba", "anchor-null-replacement-array");
        checkExpected("aba", new String[] { null }, new String[] { "a" }, "aba", "anchor-null-search-element");
        checkExpected("aba", new String[] { "a" }, new String[] { null }, "aba", "anchor-null-replacement-element");
        checkExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "anchor-mixed-null-replacement");
    }

    private static void checkExpected(String text, String[] search, String[] replacement, String expected, String oracleId) {
        try {
            String actual = StringUtils.replaceEach(text, search, replacement);
            if (!equalsNullable(expected, actual)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: documented replaceEach result mismatch input="
                        + String.valueOf(text)
                        + " lhs=" + String.valueOf(actual)
                        + " rhs=" + String.valueOf(expected));
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                return true;
            }
        }
        if (isCleanRejection(t)) {
            return false;
        }
        return isRootCause(t);
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Validation");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())) {
                String method = ste.getMethodName();
                if ("replaceEach".equals(method) || "length".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean equalsNullable(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
