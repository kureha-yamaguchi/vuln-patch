            if (!"aba".equals(r1)) {
                throw new RuntimeException("[oracle:anchor-contract] metamorphic violation: null lists must leave text unchanged input=aba lhs=" + r1 + " rhs=aba");
            }

            String r2 = StringUtils.replaceEach("aba", new String[0], null);
            if (!"aba".equals(r2)) {
                throw new RuntimeException("[oracle:anchor-contract] metamorphic violation: empty search list must leave text unchanged input=aba lhs=" + r2 + " rhs=aba");
            }

            String r3 = StringUtils.replaceEach("aba", null, new String[0]);
            if (!"aba".equals(r3)) {
                throw new RuntimeException("[oracle:anchor-contract] metamorphic violation: null search list must leave text unchanged input=aba lhs=" + r3 + " rhs=aba");
            }

            String r4 = StringUtils.replaceEach("aba", new String[] { "a" }, null);
            if (!"aba".equals(r4)) {
                throw new RuntimeException("[oracle:anchor-contract] metamorphic violation: null replacement list must leave text unchanged input=aba lhs=" + r4 + " rhs=aba");
            }

            String r5 = StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" });
            if (!"aba".equals(r5)) {
