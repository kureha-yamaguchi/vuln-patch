package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("\uD83D\uDE30");
        exercise("\uD800\uDC00");
        exercise("\uD834\uDD1E");
        exercise("\uDBFF\uDFFD");

        StringBuilder sb = new StringBuilder();
        sb.append(data.consumeAsciiString(8));
        int pairs = data.consumeInt(1, 3);
        for (int i = 0; i < pairs; i++) {
            char high = (char) data.consumeInt(0xD800, 0xDBFF);
            char low = (char) data.consumeInt(0xDC00, 0xDFFF);
            sb.append(high).append(low);
            sb.append(data.consumeAsciiString(8));
        }
        if (data.consumeBoolean()) {
            int mode = data.consumeInt(0, 5);
            switch (mode) {
                case 0:
                    sb.append(',');
                    break;
                case 1:
                    sb.append('"');
                    break;
                case 2:
                    sb.append('\n');
                    break;
                case 3:
                    sb.append('\r');
                    break;
                case 4:
                    sb.insert(0, "\"");
                    sb.append(",\n");
                    break;
                default:
                    break;
            }
        }

        exercise(sb.toString());
    }

    private static void exercise(String input) {
        final String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrow(t);
            }
            return;
        }

        /* Oracle: CSV unescaping is the inverse of CSV escaping for any accepted string.
           This round-trip must hold for every correct implementation of the public API.
           A "fix" that merely skips/bypasses the crashing bookkeeping in CharSequenceTranslator
           can silently drop or duplicate chars, especially surrogate pairs; then the round-trip
           observable result differs from the original input even though no exception is thrown. */
        try {
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException(
                    "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(s)) != s input="
                        + repr(input) + " lhs=" + repr(roundTrip) + " rhs=" + repr(input));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                rethrow(t);
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }

    private static String repr(String s) {
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || Character.isSurrogate(c)) {
                        String hex = Integer.toHexString(c);
                        out.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            out.append('0');
                        }
                        out.append(hex);
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }
}
