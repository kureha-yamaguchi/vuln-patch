                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cn = ste.getClassName();
            String mn = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cn)
                    && ("computeGeometricalProperties".equals(mn)
                    || "getVertices".equals(mn)
                    || "followLoop".equals(mn)
                    || "getTree".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Class<?> c = t.getClass(); c != null; c = c.getSuperclass()) {
            String n = c.getName();
            if ("java.lang.IllegalArgumentException".equals(n)
                    || "java.lang.NumberFormatException".equals(n)
                    || n.startsWith("org.apache.commons.math3.exception.")) {
                return true;
            }
        }
        return false;
    }

    private static String pointToString(Object p) {
        if (p instanceof Vector2D) {
            Vector2D v = (Vector2D) p;
            return "(" + v.getX() + "," + v.getY() + ")";
        }
        return String.valueOf(p);
    }
