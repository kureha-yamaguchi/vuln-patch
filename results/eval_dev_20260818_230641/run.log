package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-gap-accept] metamorphic violation: valid ordered gap range from the regression test must be accepted and yield an empty copy", t);
            }
        }

        TimeSeries series = null;
        try {
            String name = data.consumeAsciiString(20);
            if (name == null || name.length() == 0) {
                name = "S";
            }
            series = new TimeSeries(name);

            int baseOffset = data.consumeInt(-20000, 20000);
            int gapDays = data.consumeInt(2, 600);

            Day left = dayAt(baseOffset);
            Day right = dayAt(baseOffset + gapDays);
            if (left == null || right == null || left.compareTo(right) >= 0) {
                return;
            }

            series.add(left, 1.0);
            series.add(right, 2.0);

            int beforeCount = data.consumeInt(0, 4);
            for (int i = 0; i < beforeCount; i++) {
                int off = data.consumeInt(1, 365);
                Day d = dayAt(baseOffset - off);
                if (d != null) {
                    try {
                        series.add(d, data.consumeInt());
                    } catch (RuntimeException ignore) {
                    }
                }
            }

            int afterCount = data.consumeInt(0, 4);
            for (int i = 0; i < afterCount; i++) {
                int off = data.consumeInt(1, 365);
                Day d = dayAt(baseOffset + gapDays + off);
                if (d != null) {
                    try {
                        series.add(d, data.consumeInt());
                    } catch (RuntimeException ignore) {
                    }
                }
            }

            int startOff = data.consumeInt(1, gapDays - 1);
            int endOff = data.consumeInt(startOff, gapDays - 1);
            Day start = dayAt(baseOffset + startOff);
            Day end = dayAt(baseOffset + endOff);
            if (start == null || end == null || start.compareTo(end) > 0) {
                return;
            }

            verifyGapCopy(series, start, end);

            if (series.getItemCount() > 0) {
                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                verifySingletonOverloadAgreement(series, chosen);
            }
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null periods wholly inside a real gap", e);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null periods wholly inside a real gap", t);
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        s.add(left, 1.0);
        s.add(right, 1.0);
        verifyGapCopy(s, start, end);
        verifySingletonOverloadAgreement(s, 0);
    }

    private static void verifyGapCopy(TimeSeries series, Day start, Day end) throws CloneNotSupportedException {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        if (countItemsInInclusiveRange(series, start, end) != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: ordered range built wholly inside a real gap must contain no source items"
                            + " start=" + start + " end=" + end);
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null periods wholly inside a real gap"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for the ordered,
         * non-null bounds. When both bounds lie wholly inside a real gap and no source item lies in
         * [start,end], the returned series must be empty. A throw-deleting or bookkeeping-skipping
         * patch could avoid the historical exception yet return the wrong slice, so we check itemCount.
         */
        assertEmptySeries(copy, "gap-empty", start, end);
    }

    private static void verifySingletonOverloadAgreement(TimeSeries series, int index) throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }

        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree for an exact existing item"
                                + " index=" + index
                                + " period=" + exact,
                        e);
            }
            return;
        }

        /*
         * Contract asserted: for an exact existing item, createCopy(period,period) and createCopy(index,index)
         * denote the same singleton slice, so their observable contents must match. A patch that suppresses a
         * failure by returning the wrong subseries breaks this equivalence without necessarily throwing.
         */
        if (!equivalentSeries(byPeriod, byIndex)) {
            throw new RuntimeException(
                    "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree"
                            + " index=" + index
                            + " period=" + exact
                            + " lhsCount=" + byPeriod.getItemCount()
                            + " rhsCount=" + byIndex.getItemCount());
        }
    }

    private static void assertEmptySeries(TimeSeries copy, String tag, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: createCopy returned null"
                            + " start=" + start + " end=" + end);
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException(
                    "[oracle:" + tag + "] metamorphic violation: gap-bounded copy must be empty"
                            + " start=" + start
                            + " end=" + end
                            + " itemCount=" + copy.getItemCount());
        }
    }

    private static boolean equivalentSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a.getItemCount() != b.getItemCount()) {
            return false;
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            TimeSeriesDataItem ai = a.getDataItem(i);
            TimeSeriesDataItem bi = b.getDataItem(i);
            if (ai == null || bi == null) {
                return false;
            }
            RegularTimePeriod ap = ai.getPeriod();
            RegularTimePeriod bp = bi.getPeriod();
            if (ap == null ? bp != null : ap.compareTo(bp) != 0) {
                return false;
            }
            Number av = ai.getValue();
            Number bv = bi.getValue();
            if (av == null ? bv != null : !av.equals(bv)) {
                return false;
            }
        }
        return true;
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p != null && p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static Day dayAt(int offsetDays) {
        try {
            Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
            c.clear();
            c.set(2000, Calendar.JANUARY, 1, 12, 0, 0);
            c.add(Calendar.DAY_OF_MONTH, offsetDays);
            return new Day(c.get(Calendar.DAY_OF_MONTH), c.get(Calendar.MONTH) + 1, c.get(Calendar.YEAR));
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls) && "compareTo".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls) && "clone".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls) && "<init>".equals(method)) {
                return true;
            }
        }
        return false;
