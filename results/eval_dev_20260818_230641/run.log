private static void verifyValidEmptyGap(TimeSeries series, Day left, Day right, Day start, Day end,
                                            FuzzedDataProvider data, String tag)
            throws CloneNotSupportedException {
        if (series == null || left == null || right == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        if (countItemsInInclusiveRange(series, start, end) != 0) {
            throw new RuntimeException("[oracle:gap-shape] metamorphic violation: ordered range built wholly inside a real gap must contain no source items"
                    + " tag=" + tag + " start=" + start + " end=" + end);
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isCleanValidation(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null periods wholly inside a real gap"
                        + " tag=" + tag
                        + " start=" + start
                        + " end=" + end
                        + " rawStartIndex=" + rawStartIndex
                        + " rawEndIndex=" + rawEndIndex, e);
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for the ordered,
         * non-null bounds. When no source item lies in [start,end], the returned series must be empty.
         * A throw-deleting or bookkeeping-skipping patch could avoid the historical exception yet return
         * a non-empty or inconsistent copy, so we check observable emptiness through the public API.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
            int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
            Day s = addDays(left, innerStartOffset);
            Day e = addDays(left, innerEndOffset);
            if (s != null && e != null && s.compareTo(e) <= 0) {
                innerStart = s;
                innerEnd = e;
            }
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            assertEmptySeries(innerCopy, "subgap-empty", innerStart, innerEnd);
        } catch (RuntimeException e) {
            if (isCleanValidation(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:subgap-accept] metamorphic violation: any ordered non-null subrange within the same real gap must also be accepted"
                        + " tag=" + tag
                        + " outer=[" + start + "," + end + "]"
                        + " inner=[" + innerStart + "," + innerEnd + "]", e);
            }
            return;
        }

        if (series.getItemCount() > 0) {
            int chosen = (data == null) ? 0 : data.consumeInt(0, series.getItemCount() - 1);
            try {
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (RuntimeException e) {
                if (isCleanValidation(e)) {
                    return;
                }
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree on an exact existing item"
                            + " tag=" + tag + " chosen=" + chosen, e);
                }
            }
        }
    }
