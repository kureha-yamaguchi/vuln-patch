        String prefix = data.consumeString(3);
        String suffixJunk = data.consumeRemainingAsString();
        if (prefix == null) {
            prefix = "";
        }
        if (suffixJunk == null) {
            suffixJunk = "";
        }
        h.parseOrNull(prefix + scientificIntegral + suffixJunk);
    }
}
