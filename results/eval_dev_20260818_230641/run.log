    private static void verifyEmptyGapContractWithoutFuzzer(TimeSeries series, Day left, Day right, Day start, Day end)
            throws CloneNotSupportedException {
        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException("[oracle:anchor-gap-shape] metamorphic violation: anchor range is constructed inside a real gap so it must contain no items"
                    + " manualCount=" + manualCount
                    + " start=" + start
                    + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException("[oracle:anchor-gap-absent] metamorphic violation: anchor endpoints inside the gap must be absent"
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor must exercise the empty-range path"
                    + " computedStartIndex=" + computedStartIndex
                    + " computedEndIndex=" + computedEndIndex);
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:anchor-valid-empty-gap] metamorphic violation: documented bug input is a valid ordered empty-gap range and must be accepted"
                        + " start=" + start
                        + " end=" + end, e);
            }
            throw e;
        }

        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: exact regression-test input must produce an empty copied series"
                    + " copyCount=" + copy.getItemCount()
                    + " copyItems=" + copy.getItems().size()
                    + " copyPeriods=" + copy.getTimePeriods().size());
        }

        checkBoundaryStepRight(series, start, right);
        checkBoundaryStepLeft(series, left, end);

        TimeSeries byPeriod = series.createCopy(left, left);
        TimeSeries byIndex = series.createCopy(series.getIndex(left), series.getIndex(left));
        checkSeriesViewConsistency(byPeriod, "anchor-singleton-period");
        checkSeriesViewConsistency(byIndex, "anchor-singleton-index");
        assertEquivalentSeries(byPeriod, byIndex, "anchor-overload-singleton");
