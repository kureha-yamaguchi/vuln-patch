            boolean minusLeaf = data.consumeBoolean();

            PolygonsSet poly = null;
            try {
                poly = buildRootCausePolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                continue;
            }

            exerciseAndCheck(poly, false);
        }

        // Additional valid-by-construction sanity cases for the observable bookkeeping contract.
        // These are accepted inputs: leaf trees with null cut and Boolean attribute.
        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>(Boolean.TRUE));
