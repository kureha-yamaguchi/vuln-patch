public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class Util {
            boolean isCleanReject(Throwable t) {
                return t instanceof IllegalArgumentException;
            }

            boolean hasRelevantStack(Throwable t) {
                StackTraceElement[] frames = t.getStackTrace();
                if (frames == null) {
                    return false;
                }
                for (StackTraceElement f : frames) {
                    if ("org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                        String m = f.getMethodName();
                        if ("createNumber".equals(m)
                                || "createInteger".equals(m)
                                || "isAllZeros".equals(m)
                                || "isDigits".equals(m)
                                || "createLong".equals(m)
                                || "createBigInteger".equals(m)
                                || "createFloat".equals(m)
                                || "createDouble".equals(m)
                                || "createBigDecimal".equals(m)) {
                            return true;
                        }
                    }
                }
                return false;
            }

            boolean isRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
            }

            java.math.BigDecimal toBigDecimal(Number n) {
                if (n == null) {
                    return null;
                }
                if (n instanceof Double) {
                    double d = ((Double) n).doubleValue();
                    if (Double.isNaN(d) || Double.isInfinite(d)) {
                        return null;
                    }
                }
                if (n instanceof Float) {
                    float f = ((Float) n).floatValue();
                    if (Float.isNaN(f) || Float.isInfinite(f)) {
                        return null;
                    }
                }
                try {
                    return new java.math.BigDecimal(n.toString());
                } catch (RuntimeException e) {
                    return null;
                }
            }

            boolean sameNumericValue(Number a, Number b) {
                java.math.BigDecimal left = toBigDecimal(a);
                java.math.BigDecimal right = toBigDecimal(b);
                return left != null && right != null && left.compareTo(right) == 0;
            }

            Number parseValidOrSkip(String s) {
                try {
                    return NumberUtils.createNumber(s);
                } catch (RuntimeException t) {
                    if (isRootCause(t)) {
                        throw t;
                    }
                    if (isCleanReject(t)) {
                        return null;
                    }
                    return null;
                }
            }

            void checkEquivalent(String a, String b, String oracleId) {
                try {
                    Number left = NumberUtils.createNumber(a);
                    Number right = NumberUtils.createNumber(b);
                    if (left == null || right == null) {
                        return;
                    }
                    if (!sameNumericValue(left, right)) {
                        throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA=" + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
                    }
                } catch (RuntimeException t) {
                    if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                        throw t;
                    }
                    if (isRootCause(t)) {
                        throw t;
                    }
                    if (isCleanReject(t)) {
                        return;
                    }
                }
            }
        }

        Util u = new Util();

        try {
            Number anchor = NumberUtils.createNumber("1234.5");
            if (anchor != null) {
                Number anchorEquivalent = NumberUtils.createNumber("1234.5D");
                if (anchorEquivalent != null && !u.sameNumericValue(anchor, anchorEquivalent)) {
                    throw new RuntimeException("[oracle:anchor-equivalence] metamorphic violation: plain decimal and explicit double suffix must denote the same numeric value inputA=1234.5 inputB=1234.5D lhs=" + anchor + " rhs=" + anchorEquivalent);
                }
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (u.isRootCause(t)) {
                throw t;
            }
            if (!u.isCleanReject(t)) {
                return;
            }
        }

        String sign = data.consumeBoolean() ? "-" : "";
        int mantLen = data.consumeInt(1, 6);
        String rawMant = data.consumeAsciiString(mantLen);
        StringBuilder mantDigits = new StringBuilder();
        for (int i = 0; i < rawMant.length(); i++) {
            char c = rawMant.charAt(i);
            if (c >= '0' && c <= '9') {
                mantDigits.append(c);
            } else {
                mantDigits.append((char) ('0' + (c & 7)));
            }
        }
        if (mantDigits.length() == 0) {
            mantDigits.append('1');
        }
        boolean allZeroMant = true;
        for (int i = 0; i < mantDigits.length(); i++) {
            if (mantDigits.charAt(i) != '0') {
                allZeroMant = false;
                break;
            }
        }
        if (allZeroMant) {
            mantDigits.setCharAt(mantDigits.length() - 1, '1');
        }

        boolean expNegative = data.consumeBoolean();
        int expLen = data.consumeInt(1, 3);
        String rawExp = data.consumeAsciiString(expLen);
        StringBuilder expDigits = new StringBuilder();
        for (int i = 0; i < rawExp.length(); i++) {
            char c = rawExp.charAt(i);
            if (c >= '0' && c <= '9') {
                expDigits.append(c);
            } else {
                expDigits.append((char) ('0' + (c & 7)));
            }
        }
        if (expDigits.length() == 0) {
            expDigits.append('0');
        }

        String expSign = expNegative ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';
        String suffix = "";
        switch (data.consumeInt(0, 4)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            default:
                break;
        }

        String baseNoDecimal = sign + mantDigits + expMarker + expSign + expDigits;
        String equivalentWithDecimal = sign + mantDigits + ".0" + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String withSuffix = baseNoDecimal + suffix;
        String equivalentWithDecimalAndSuffix = equivalentWithDecimal + suffix;

        u.parseValidOrSkip(baseNoDecimal);
        u.parseValidOrSkip(withSuffix);

        /*
         * Contract asserted by the oracle below:
         * createNumber parses a numeric string; therefore two syntactically different
         * strings that denote the same number (integer mantissa scientific notation vs
         * the same notation with a redundant ".0" before the exponent, and exponent
         * marker case changes) must produce equal numeric values. A throw-deleting or
         * branch-skipping patch could avoid the crash yet parse one form differently,
         * so this observable equivalence check catches silent wrong-output fixes.
         */
        u.checkEquivalent(baseNoDecimal, equivalentWithDecimal, "redundant-decimal-before-exponent");
        if (!suffix.isEmpty()) {
            u.checkEquivalent(withSuffix, equivalentWithDecimalAndSuffix, "redundant-decimal-before-exponent-suffix");
        }

        String lowerNoSuffix = sign + mantDigits + "e" + expSign + expDigits;
        String upperNoSuffix = sign + mantDigits + "E" + expSign + expDigits;
        u.checkEquivalent(lowerNoSuffix, upperNoSuffix, "scientific-exp-case-equivalence");
        u.checkEquivalent(lowerNoSuffix, sign + mantDigits + ".0E" + expSign + expDigits, "exp-case-plus-decimal-boundary");
    }
