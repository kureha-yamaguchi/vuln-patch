package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        int rounds = data.consumeInt(1, 8);
        for (int r = 0; r < rounds; r++) {
            try {
                exerciseGapCase(data, r);
            } catch (RuntimeException e) {
                throw e;
            } catch (Throwable t) {
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        s.add(left, Integer.valueOf(1));
        s.add(right, Integer.valueOf(1));
        verifyValidEmptyGap(s, left, right, start, end, null, "anchor");
    }

    private static void exerciseGapCase(FuzzedDataProvider data, int round) throws CloneNotSupportedException {
        TimeSeries series = new TimeSeries("Fuzz-" + round + "-" + data.consumeAsciiString(12));

        int year = data.consumeInt(1901, 2099);
        int month = data.consumeInt(1, 12);
        int leftDay = data.consumeInt(1, 20);
        int gapSize = data.consumeInt(1, 40);
        int beforeCount = data.consumeInt(0, 6);
        int afterCount = data.consumeInt(0, 6);

        Day left;
        Day right;
        try {
            left = new Day(leftDay, month, year);
            right = addDays(left, gapSize + 1);
        } catch (RuntimeException e) {
            return;
        }

        try {
            for (int i = beforeCount; i > 0; i--) {
                Day d = addDays(left, -i);
                if (d == null) {
                    return;
                }
                series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
            }
            series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
            series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
            for (int i = 1; i <= afterCount; i++) {
                Day d = addDays(right, i);
                if (d == null) {
                    return;
                }
                series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        int startOffset = data.consumeInt(1, gapSize);
        int endOffset = data.consumeInt(startOffset, gapSize);

        Day start = addDays(left, startOffset);
        Day end = addDays(left, endOffset);
        if (start == null || end == null) {
            return;
        }

        verifyValidEmptyGap(series, left, right, start, end, data, "fuzz");
    }

    private static void verifyValidEmptyGap(TimeSeries series, Day left, Day right, Day start, Day end,
                                            FuzzedDataProvider data, String tag)
            throws CloneNotSupportedException {
        if (series == null || left == null || right == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        if (countItemsInInclusiveRange(series, start, end) != 0) {
            throw new RuntimeException("[oracle:gap-shape] metamorphic violation: ordered range built wholly inside a real gap must contain no source items"
                    + " tag=" + tag + " start=" + start + " end=" + end);
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isCleanValidation(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:gap-accept] metamorphic violation: createCopy(start,end) must accept valid ordered non-null periods wholly inside a real gap"
                        + " tag=" + tag
                        + " start=" + start
                        + " end=" + end
                        + " rawStartIndex=" + rawStartIndex
                        + " rawEndIndex=" + rawEndIndex, e);
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for the ordered,
         * non-null bounds. When no source item lies in [start,end], the returned series must be empty.
         * A throw-deleting or bookkeeping-skipping patch could avoid the historical exception yet return
         * a non-empty or inconsistent copy, so we check observable emptiness through the public API.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
            int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
            Day s = addDays(left, innerStartOffset);
            Day e = addDays(left, innerEndOffset);
            if (s != null && e != null && s.compareTo(e) <= 0) {
                innerStart = s;
                innerEnd = e;
            }
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            assertEmptySeries(innerCopy, "subgap-empty", innerStart, innerEnd);
        } catch (RuntimeException e) {
            if (isCleanValidation(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:subgap-accept] metamorphic violation: any ordered non-null subrange within the same real gap must also be accepted"
                        + " tag=" + tag
                        + " outer=[" + start + "," + end + "]"
                        + " inner=[" + innerStart + "," + innerEnd + "]", e);
            }
            return;
        }

        if (series.getItemCount() > 0) {
            int chosen = (data == null) ? 0 : data.consumeInt(0, series.getItemCount() - 1);
            try {
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (RuntimeException e) {
                if (isCleanValidation(e)) {
                    return;
                }
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree on an exact existing item"
                            + " tag=" + tag + " chosen=" + chosen, e);
                }
            }
        }
    }

    private static void assertEmptySeries(TimeSeries copy, String id, RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: createCopy returned null"
                    + " start=" + start + " end=" + end);
        }
        checkSeriesViewConsistency(copy, id);
        if (copy.getItemCount() != 0 || copy.getItems().size() != 0 || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: copying an empty inclusive range must yield an empty series"
                    + " start=" + start
                    + " end=" + end
                    + " itemCount=" + copy.getItemCount()
                    + " itemsSize=" + copy.getItems().size()
                    + " periodsSize=" + copy.getTimePeriods().size());
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String id) {
        if (a == null || b == null) {
            return;
        }
        checkSeriesViewConsistency(a, id + "-lhs");
        checkSeriesViewConsistency(b, id + "-rhs");
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: equivalent createCopy overloads must produce the same item count"
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            boolean samePeriod = (pa == null) ? (pb == null) : pa.equals(pb);
            boolean sameValue = (va == null) ? (vb == null) : va.equals(vb);
            if (!samePeriod || !sameValue) {
                throw new RuntimeException("[oracle:" + id + "] metamorphic violation: equivalent createCopy overloads must produce identical singleton content"
                        + " index=" + i
                        + " lhsPeriod=" + pa
                        + " rhsPeriod=" + pb
                        + " lhsValue=" + va
                        + " rhsValue=" + vb);
            }
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String id) {
        int count = series.getItemCount();
        List items = series.getItems();
        List periods = series.getTimePeriods();
        if (items.size() != count || periods.size() != count) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: public series views must agree on item count"
                    + " count=" + count + " items=" + items.size() + " periods=" + periods.size());
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (series.getIndex(p) != i) {
                throw new RuntimeException("[oracle:" + id + "] metamorphic violation: getIndex(getTimePeriod(i)) must round-trip to i"
                        + " index=" + i + " roundTrip=" + series.getIndex(p) + " period=" + p);
            }
        }
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int c = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                c++;
            }
        }
        return c;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static Day addDays(Day day, int delta) {
        if (day == null) {
            return null;
        }
        Day cur = day;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                RegularTimePeriod next = cur.next();
                if (!(next instanceof Day)) {
                    return null;
                }
                cur = (Day) next;
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                RegularTimePeriod prev = cur.previous();
                if (!(prev instanceof Day)) {
                    return null;
                }
                cur = (Day) prev;
            }
        }
        return cur;
    }

    private static int daysBetween(Day left, Day right) {
        int days = 0;
        Day cur = left;
        while (cur != null && cur.compareTo(right) < 0 && days < 10000) {
            cur = addDays(cur, 1);
            days++;
        }
        return days;
    }

    private static boolean isCleanValidation(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException || cur instanceof ClassCastException) {
