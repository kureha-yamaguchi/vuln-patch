private static void verifySingletonOverloadAgreement(TimeSeries series, int index)
            throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree for an exact existing item",
                        e);
            }
            throw e;
        }

        /*
         * Contract asserted: both overloads describe the same singleton slice of the same source
         * series, so their observable contents must match. A patch that alters index bookkeeping or
         * emptiness handling can avoid an exception yet return the wrong copy.
         */
        assertEquivalentSeries(byPeriod, byIndex, "singleton-overloads");
    }
