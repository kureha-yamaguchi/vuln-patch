        String mantissa = digitsOnly(data.consumeAsciiString(12));
        String exponent = digitsOnly(data.consumeAsciiString(6));
        String exponentSign = data.consumeBoolean() ? "-" : "";
        char marker = data.consumeBoolean() ? 'e' : 'E';
        char suffix = data.consumeBoolean() ? 'F' : 'D';

        String scientific = sign + mantissa + marker + exponentSign + exponent + suffix;
        String equivalent = sign + mantissa + ".0" + (marker == 'e' ? 'E' : 'e') + exponentSign + exponent + suffix;

        checkEquivalentScientificNotation(scientific, equivalent);

        String plainScientific = sign + mantissa + marker + exponentSign + exponent;
        String plainEquivalent = sign + mantissa + ".0" + (marker == 'e' ? 'E' : 'e') + exponentSign + exponent;
        checkEquivalentScientificNotation(plainScientific, plainEquivalent);
