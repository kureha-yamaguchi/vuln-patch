private static void requireSingletonOverloadAgreement(TimeSeries series, int index) throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        /*
         * Metamorphic relation: for any exact existing item, createCopy(period,period) and
         * createCopy(index,index) denote the same singleton subseries, so both public views must agree.
         * A patch that dodges the buggy branch by returning the wrong slice breaks this equivalence.
