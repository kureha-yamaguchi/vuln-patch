    private static void checkBoundaryStepRight(TimeSeries series, Day gapPoint, Day right)
            throws CloneNotSupportedException {
        TimeSeries rightBoundary = series.createCopy(gapPoint, right);
        TimeSeries singleton = series.createCopy(right, right);
        checkSeriesViewConsistency(rightBoundary, "boundary-right");
        checkSeriesViewConsistency(singleton, "boundary-right-singleton");
        assertEquivalentSeries(rightBoundary, singleton, "boundary-step-right");
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day left, Day gapPoint)
            throws CloneNotSupportedException {
        TimeSeries leftBoundary = series.createCopy(left, gapPoint);
        TimeSeries singleton = series.createCopy(left, left);
        checkSeriesViewConsistency(leftBoundary, "boundary-left");
        checkSeriesViewConsistency(singleton, "boundary-left-singleton");
        assertEquivalentSeries(leftBoundary, singleton, "boundary-step-left");
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String label) {
        if (a.getItemCount() != b.getItemCount()
                || a.getItems().size() != b.getItems().size()
                || a.getTimePeriods().size() != b.getTimePeriods().size()) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: equivalent createCopy calls must expose equal sizes"
                    + " aCount=" + a.getItemCount()
                    + " bCount=" + b.getItemCount()
                    + " aItems=" + a.getItems().size()
                    + " bItems=" + b.getItems().size()
                    + " aPeriods=" + a.getTimePeriods().size()
                    + " bPeriods=" + b.getTimePeriods().size());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!(pa == null ? pb == null : pa.equals(pb))) {
                throw new RuntimeException("[oracle:" + label + "] metamorphic violation: equivalent createCopy calls must copy the same periods"
                        + " index=" + i
                        + " lhs=" + pa
                        + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (!(va == null ? vb == null : va.equals(vb))) {
                throw new RuntimeException("[oracle:" + label + "] metamorphic violation: equivalent createCopy calls must copy the same values"
                        + " index=" + i
                        + " lhs=" + va
                        + " rhs=" + vb);
            }
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();
        if (count != itemsSize || count != periodsSize) {
            throw new RuntimeException("[oracle:view-consistency] metamorphic violation: TimeSeries public views must agree on item count"
                    + " label=" + label
                    + " count=" + count
                    + " itemsSize=" + itemsSize
                    + " periodsSize=" + periodsSize);
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (series.getIndex(p) != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must round-trip to i"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + series.getIndex(p)
                        + " period=" + p);
            }
            if (series.getDataItem(i) == null) {
                throw new RuntimeException("[oracle:dataitem] metamorphic violation: existing indices must expose a non-null data item"
                        + " label=" + label
                        + " index=" + i);
            }
        }
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
