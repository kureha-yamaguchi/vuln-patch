package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor("aba", new String[]{"a", "b"}, new String[]{"c", null}, "cbc");
        exerciseAnchor("aba", new String[]{null}, new String[]{"a"}, "aba");
        exerciseAnchor("aba", new String[]{"a"}, new String[]{null}, "aba");

        String prefix = data.consumeAsciiString(12);
        String needle = data.consumeAsciiString(4);
        if (needle.length() == 0) {
            needle = "a";
        }
        String suffix = data.consumeAsciiString(12);
        String text = prefix + needle + suffix;

        int len = data.consumeInt(2, 5);
        String[] searchList = new String[len];
        String[] replacementList = new String[len];

        for (int i = 0; i < len; i++) {
            searchList[i] = uniqueMissingToken(text, i);
            replacementList[i] = data.consumeAsciiString(6);
        }

        int validIndex = data.consumeInt(0, len - 1);
        int invalidIndex = data.consumeInt(0, len - 1);
        if (invalidIndex == validIndex) {
            invalidIndex = (invalidIndex + 1) % len;
        }

        searchList[validIndex] = needle;
        replacementList[validIndex] = data.consumeAsciiString(6);

        if (data.consumeBoolean()) {
            searchList[invalidIndex] = uniqueMissingToken(text, invalidIndex + 100);
            replacementList[invalidIndex] = null;
        } else {
            searchList[invalidIndex] = null;
            replacementList[invalidIndex] = data.consumeAsciiString(6);
        }

        if (data.consumeBoolean()) {
            int extra = data.consumeInt(0, len - 1);
            if (extra != validIndex && extra != invalidIndex) {
                searchList[extra] = data.consumeBoolean() ? "" : null;
                replacementList[extra] = data.consumeBoolean() ? null : data.consumeAsciiString(4);
            }
        }

        checkIgnoredInvalidPairsMetamorphic(text, searchList, replacementList);
    }

    private static void exerciseAnchor(String text, String[] searchList, String[] replacementList, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (!eq(expected, actual)) {
                throw new RuntimeException("[oracle:anchor] metamorphic violation: documented replaceEach result mismatch input="
                        + describe(text, searchList, replacementList) + " lhs=" + actual + " rhs=" + expected);
            }
        } catch (RuntimeException t) {
            if (isOracle(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkIgnoredInvalidPairsMetamorphic(String text, String[] searchList, String[] replacementList) {
        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        int keep = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                keep++;
            }
        }

        String[] filteredSearch = new String[keep];
        String[] filteredReplacement = new String[keep];
        int j = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                filteredSearch[j] = searchList[i];
                filteredReplacement[j] = replacementList[i];
                j++;
            }
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException t) {
            return;
        }

        /*
         * Contract/oracle: the implementation itself treats pairs with null search strings,
         * empty search strings, or null replacement strings as ignored entries in the matching loops.
         * The regression test for this bug also documents examples such as:
         *   replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba"
         *   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
         * Therefore, adding ignored invalid pairs must not change the observable result compared to
         * removing those pairs. A "fix" that merely suppresses the crash but drops or mangles valid
         * replacements would violate this relation.
         */
        if (!eq(lhs, rhs)) {
            throw new RuntimeException("[oracle:ignore-invalid-pairs] metamorphic violation: removing ignored null/empty pairs changed result input="
                    + describe(text, searchList, replacementList) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("replaceEach".equals(m) || "length".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean eq(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String uniqueMissingToken(String text, int salt) {
        String token = "#" + salt + "#";
        while (text.indexOf(token) >= 0) {
            token = token + "x";
        }
        return token;
    }

    private static String describe(String text, String[] searchList, String[] replacementList) {
        return "text=" + text
                + " search=" + ArrayUtils.toString(searchList)
                + " replacement=" + ArrayUtils.toString(replacementList);
    }
}
