package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            anchor();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int year = data.consumeInt(1990, 2020);
            int month = data.consumeInt(1, 12);
            int leftDay = data.consumeInt(1, 20);
            int gapSize = data.consumeInt(1, 40);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);

            Day left;
            Day right;
            try {
                left = new Day(leftDay, month, year);
                right = addDays(left, gapSize + 1);
            } catch (RuntimeException e) {
                return;
            }

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(addDays(left, -i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(addDays(right, i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                checkSeriesViewConsistency(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);

            Day start;
            Day end;
            try {
                start = addDays(left, startOffset);
                end = addDays(left, endOffset);
            } catch (RuntimeException e) {
                return;
            }

            if (start == null || end == null || start.compareTo(end) > 0) {
                return;
            }

            try {
                verifyEmptyGapContract(series, left, start, end, data);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void anchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        verifyEmptyGapContract(s, new Day(19, 8, 2005), start, end, null);
    }

    private static void verifyEmptyGapContract(TimeSeries series, Day left, Day start, Day end,
            FuzzedDataProvider data) throws CloneNotSupportedException {
        int rawStartIndex;
        int rawEndIndex;
        int manualCount = 0;

        try {
            rawStartIndex = series.getIndex(start);
            rawEndIndex = series.getIndex(end);
            for (int i = 0; i < series.getItemCount(); i++) {
                RegularTimePeriod p = series.getTimePeriod(i);
                if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                    manualCount++;
                }
                if (series.getIndex(p) != i) {
                    throw new RuntimeException(
                            "[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                                    + " index=" + i
                                    + " roundTrip=" + series.getIndex(p)
                                    + " period=" + p);
                }
            }
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: a range chosen wholly inside the constructed real gap must contain no source items"
                            + " manualCount=" + manualCount
                            + " start=" + start
                            + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException(
                    "[oracle:gap-absent] metamorphic violation: both endpoints chosen strictly inside the real gap must be absent from the series"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            throw new RuntimeException(
                    "[oracle:empty-index-range] metamorphic violation: a valid empty-gap input must map to endIndex before startIndex"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " computedStartIndex=" + computedStartIndex
                            + " computedEndIndex=" + computedEndIndex
                            + " start=" + start
                            + " end=" + end);
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isValidationException(e) && isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:valid-empty-gap] metamorphic violation: createCopy(start,end) must accept ordered non-null periods wholly inside a real gap and return an empty series"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by the
         * ordered, non-null periods. When start and end lie wholly inside a real gap, there are no
         * source items in that inclusive range, so the copy must be empty. A throw-deleting or
         * bookkeeping-skipping patch can avoid the historical exception yet still return a non-empty
         * or internally inconsistent copy, so we assert emptiness and consistency of the public views.
         */
        checkSeriesViewConsistency(copy, "empty-gap-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " copyItems=" + copy.getItems().size()
                            + " copyPeriods=" + copy.getTimePeriods().size()
                            + " start=" + start
                            + " end=" + end
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex);
        }

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
            int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
            innerStart = addDays(left, innerStartOffset);
            innerEnd = addDays(left, innerEndOffset);
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            checkSeriesViewConsistency(innerCopy, "inner-gap-copy");
            if (innerCopy.getItemCount() != 0
                    || innerCopy.getItems().size() != 0
                    || innerCopy.getTimePeriods().size() != 0) {
                throw new RuntimeException(
                        "[oracle:subgap-empty] metamorphic violation: any ordered subrange within the same real gap must also copy to an empty series"
                                + " outer=[" + start + "," + end + "]"
                                + " inner=[" + innerStart + "," + innerEnd + "]"
                                + " innerCount=" + innerCopy.getItemCount()
                                + " innerItems=" + innerCopy.getItems().size()
                                + " innerPeriods=" + innerCopy.getTimePeriods().size());
            }
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (isValidationException(e) && isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:subgap-accept] metamorphic violation: any ordered non-null subrange within the same real gap must also be accepted"
                                + " outer=[" + start + "," + end + "]"
                                + " inner=[" + innerStart + "," + innerEnd + "]",
                        e);
            }
            return;
        }

        if (series.getItemCount() > 0) {
            int chosen = (data == null)
                    ? 0
                    : data.consumeInt(0, series.getItemCount() - 1);
            try {
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                checkSeriesViewConsistency(byPeriod, "singleton-by-period");
                checkSeriesViewConsistency(byIndex, "singleton-by-index");
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
            }
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String tag) {
        int count = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();
        if (count != itemsSize || count != periodsSize) {
            throw new RuntimeException(
                    "[oracle:view-consistency] metamorphic violation: public series views must agree on size"
                            + " tag=" + tag
                            + " count=" + count
                            + " itemsSize=" + itemsSize
                            + " periodsSize=" + periodsSize);
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod period = series.getTimePeriod(i);
            Number value = series.getValue(i);
            TimeSeriesDataItem item = series.getDataItem(i);
            if (period == null || item == null) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: non-empty series indices must expose non-null period/item"
                                + " tag=" + tag
                                + " index=" + i);
            }
            if (period.compareTo(item.getPeriod()) != 0) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: getTimePeriod(i) and getDataItem(i).getPeriod() must agree"
                                + " tag=" + tag
                                + " index=" + i
                                + " period=" + period
                                + " itemPeriod=" + item.getPeriod());
            }
            Number itemValue = item.getValue();
            if (!numbersEqual(value, itemValue)) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: getValue(i) and getDataItem(i).getValue() must agree"
                                + " tag=" + tag
                                + " index=" + i
                                + " value=" + value
                                + " itemValue=" + itemValue);
            }
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String tag) {
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                    "[oracle:equivalent-series] metamorphic violation: equivalent createCopy overloads must produce the same length"
                            + " tag=" + tag
                            + " aCount=" + a.getItemCount()
                            + " bCount=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod ap = a.getTimePeriod(i);
            RegularTimePeriod bp = b.getTimePeriod(i);
            Number av = a.getValue(i);
            Number bv = b.getValue(i);
            if (ap.compareTo(bp) != 0 || !numbersEqual(av, bv)) {
                throw new RuntimeException(
                        "[oracle:equivalent-series] metamorphic violation: equivalent createCopy overloads must produce the same items"
                                + " tag=" + tag
                                + " index=" + i
                                + " aPeriod=" + ap
                                + " bPeriod=" + bp
                                + " aValue=" + av
                                + " bValue=" + bv);
            }
        }
    }

    private static boolean numbersEqual(Number a, Number b) {
        if (a == null) {
            return b == null;
        }
        return a.equals(b);
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static Day addDays(Day base, int delta) {
        RegularTimePeriod p = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                p = p.next();
                if (p == null) {
                    throw new IllegalArgumentException("Day overflow");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                p = p.previous();
                if (p == null) {
                    throw new IllegalArgumentException("Day underflow");
                }
            }
        }
        return (Day) p;
    }

    private static int daysBetween(Day left, Day right) {
        int n = 0;
        Day cur = left;
        while (cur.compareTo(right) < 0) {
            cur = addDays(cur, 1);
            n++;
            if (n > 10000) {
                throw new IllegalArgumentException("distance too large");
            }
        }
        return n;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationException(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("org.jfree.data.time.TimeSeriesDataItem".equals(cls)
                    && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.data.time.RegularTimePeriod".equals(cls)
                    && "compareTo".equals(method)) {
                return true;
            }
            if ("org.jfree.data.general.Series".equals(cls)
                    && "clone".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
