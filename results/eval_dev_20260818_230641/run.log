package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAndCheck(buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, true, false), true, true);
        exerciseAndCheck(buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, false, true), true, false);

        int cases = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());
            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            boolean plusLeaf = data.consumeBoolean();
            boolean minusLeaf = data.consumeBoolean();

            try {
                PolygonsSet poly = buildRootCausePolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
                exerciseAndCheck(poly, false, plusLeaf);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "valid-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "valid-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static PolygonsSet buildRootCausePolygon(double x1, double y1, double x2, double y2,
                                                     boolean plusLeaf, boolean minusLeaf) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        SubHyperplane<Euclidean2D> cut = line.wholeHyperplane();
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusLeaf));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusLeaf));
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(null, null);
        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(cut, plus, minus, attribute);
        return new PolygonsSet(tree);
    }

    private static void exerciseAndCheck(PolygonsSet poly, boolean anchor, boolean expectedWholeFromPlusLeaf) {
        Vector2D[][] verticesBefore;
        try {
            verticesBefore = poly.getVertices();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            poly.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        Vector2D[][] verticesAfter;
        try {
            verticesAfter = poly.getVertices();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (verticesBefore == null || verticesAfter == null) {
            return;
        }

        if (verticesBefore.length != verticesAfter.length) {
            throw new RuntimeException("[oracle:vertices-idempotent] metamorphic violation: getVertices length changed across computeGeometricalProperties input="
                    + pointPair(poly) + " lhs=" + verticesBefore.length + " rhs=" + verticesAfter.length);
        }

        if (verticesAfter.length == 0) {
            /*
             * Contract visible in computeGeometricalProperties():
             * when getVertices().length == 0, the method must set either
             *   (+INF, NaN barycenter) iff the region covers the whole space,
             * or
             *   (0, (0,0)) otherwise.
             * For the crafted internal-node trees here, the patched line decides this
             * from tree.getPlus().getAttribute(). A throw-deleting or bookkeeping-skipping
             * patch would leave a different observable state, which this oracle catches.
             */
            if (expectedWholeFromPlusLeaf) {
                assertWholeGeometry(poly, anchor ? "anchor-empty-whole" : "fuzz-empty-whole");
            } else {
                assertEmptyGeometry(poly, anchor ? "anchor-empty-finite" : "fuzz-empty-finite");
            }
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Object bc = poly.getBarycenter();
        if (!(bc instanceof Vector2D)) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: whole-space case must expose Vector2D barycenter input="
                    + pointPair(poly) + " lhs=type:" + pointToString(bc) + " rhs=Vector2D(NaN,NaN)");
        }
        Vector2D v = (Vector2D) bc;
        if (!Double.isInfinite(size) || !Double.isNaN(v.getX()) || !Double.isNaN(v.getY())) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: empty-vertices whole-space case must map to infinite size and NaN barycenter input="
                    + pointPair(poly) + " lhs=size=" + size + ",bc=" + pointToString(bc) + " rhs=expected(+INF,NaN,NaN)");
        }
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
        Object bc = poly.getBarycenter();
        if (!(bc instanceof Vector2D)) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: empty finite case must expose Vector2D barycenter input="
                    + pointPair(poly) + " lhs=type:" + pointToString(bc) + " rhs=Vector2D(0,0)");
        }
        Vector2D v = (Vector2D) bc;
        if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0)
                || Double.doubleToLongBits(v.getX()) != Double.doubleToLongBits(0.0)
                || Double.doubleToLongBits(v.getY()) != Double.doubleToLongBits(0.0)) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: empty-vertices non-whole-space case must map to zero size and (0,0) barycenter input="
                    + pointPair(poly) + " lhs=size=" + size + ",bc=" + pointToString(bc) + " rhs=expected(0,0,0)");
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                return true;
            }
        }
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)) {
                if ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "followLoop".equals(method)
                        || "getTree".equals(method)
                        || "setSize".equals(method)
                        || "setBarycenter".equals(method)
                        || "isEmpty".equals(method)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.util.FastMath".equals(cls) && ("abs".equals(method) || "max".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.euclidean.twod.Vector2D".equals(cls)
                    && ("<init>".equals(method) || "getX".equals(method) || "getY".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.euclidean.oned.Vector1D".equals(cls) && "<init>".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        Package p = t.getClass().getPackage();
        if (p != null) {
            String pn = p.getName();
            if (pn != null && pn.startsWith("org.apache.commons.math3.exception")) {
                return true;
            }
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            if (cls != null && cls.startsWith("org.apache.commons.math3.exception")) {
                return true;
            }
        }
        return false;
    }

    private static double finiteCoord(int raw) {
        return (raw % 2000001) / 1000.0;
    }

    private static String pointPair(PolygonsSet poly) {
        try {
            BSPTree<Euclidean2D> tree = poly.getTree(false);
            if (tree == null || tree.getCut() == null) {
                return "leaf";
            }
            return "cut=" + tree.getCut().getClass().getName()
                    + ",plus=" + String.valueOf(tree.getPlus() == null ? null : tree.getPlus().getAttribute())
                    + ",minus=" + String.valueOf(tree.getMinus() == null ? null : tree.getMinus().getAttribute())
                    + ",attr=" + String.valueOf(tree.getAttribute());
        } catch (RuntimeException t) {
            return "unprintable:" + t.getClass().getName();
        }
    }

    private static String pointToString(Object p) {
        if (p == null) {
            return "null";
        }
        if (p instanceof Vector2D) {
            Vector2D v = (Vector2D) p;
            return "(" + v.getX() + "," + v.getY() + ")";
        }
        return p.getClass().getName();
    }
}
