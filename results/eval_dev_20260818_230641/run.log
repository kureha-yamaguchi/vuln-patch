package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorExamples();
        exploreNullElementProperty(data);
    }

    private static void anchorExamples() {
        try {
            if (StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" }) != null) {
                throw new RuntimeException("[oracle:anchor-null] metamorphic violation: expected null result for null text");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-null] metamorphic violation: null text should be accepted and return null", t);
            }
        }

        checkExpected("aba", null, null, "aba", "anchor-nulls-1");
        checkExpected("aba", new String[0], null, "aba", "anchor-nulls-2");
        checkExpected("aba", null, new String[0], "aba", "anchor-nulls-3");
        checkExpected("aba", new String[] { "a" }, null, "aba", "anchor-nulls-4");
        checkExpected("aba", new String[] { null }, new String[] { "a" }, "aba", "anchor-nulls-5");
        checkExpected("aba", new String[] { "a" }, new String[] { null }, "aba", "anchor-nulls-6");
        checkExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "anchor-trigger");

        StringUtils.length("aba");
        StringUtils.length(StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { "c" }));
    }

    private static void exploreNullElementProperty(FuzzedDataProvider data) {
        String prefix = data.consumeAsciiString(16);
        String suffix = data.consumeRemainingAsString();

        String needle = data.consumeAsciiString(8);
        if (needle.length() == 0) {
            needle = "a";
        }

        String replacement = data.consumeString(8);
        String ignoredSearch = data.consumeAsciiString(8);
        if (ignoredSearch.length() == 0) {
            ignoredSearch = "z";
        }

        String text = prefix + needle + suffix;
        boolean useNullReplacement = data.consumeBoolean();

        String[] searchList;
        String[] replacementList;
        String[] filteredSearchList;
        String[] filteredReplacementList;

        if (useNullReplacement) {
            searchList = new String[] { needle, ignoredSearch };
            replacementList = new String[] { replacement, null };
            filteredSearchList = new String[] { needle };
            filteredReplacementList = new String[] { replacement };
        } else {
            searchList = new String[] { needle, null };
            replacementList = new String[] { replacement, ignoredSearch };
            filteredSearchList = new String[] { needle };
            filteredReplacementList = new String[] { replacement };
        }

        // Contract relied on:
        // replaceEach skips entries whose search string is null/empty or whose replacement is null.
        // The regression tests explicitly require:
        //   replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba"
        //   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
        //   replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc"
        // Therefore, adding an ignored null-containing pair must not change the result compared to
        // filtering that pair out. A throw-deleting or over-guarding patch that silently skips valid
        // replacements, or a crash on these valid inputs, violates this observable API contract.
        String expected;
        try {
            expected = StringUtils.replaceEach(text, filteredSearchList, filteredReplacementList);
        } catch (Throwable t) {
            return;
        }

        String actual;
        try {
            actual = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:null-element-filter] metamorphic violation: valid null-containing entries should be ignored input="
                        + describe(text, searchList, replacementList)
                        + " expected=" + expected,
                    t);
            }
            return;
        }

        StringUtils.length(text);
        StringUtils.length(actual);

        if (!equalsNullable(expected, actual)) {
            throw new RuntimeException(
                "[oracle:null-element-filter] metamorphic violation: adding ignored null-containing pair changed result input="
                    + describe(text, searchList, replacementList)
                    + " lhs=" + actual
                    + " rhs=" + expected);
        }
    }

    private static void checkExpected(String text, String[] searchList, String[] replacementList, String expected, String oracleId) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            StringUtils.length(actual);
            if (!equalsNullable(expected, actual)) {
                throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: expected documented result input="
                        + describe(text, searchList, replacementList)
                        + " lhs=" + actual
                        + " rhs=" + expected);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: documented valid input should not crash input="
                        + describe(text, searchList, replacementList)
                        + " expected=" + expected,
                    t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean equalsNullable(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String describe(String text, String[] searchList, String[] replacementList) {
        return "text=" + text + " search=" + ArrayUtils.toString(searchList) + " repl=" + ArrayUtils.toString(replacementList);
    }
}
