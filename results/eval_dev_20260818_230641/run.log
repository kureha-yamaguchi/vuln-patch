package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            exerciseIdentityLookup("", anchors[i], "");
            exerciseIdentityLookup("A", anchors[i], "");
            exerciseIdentityLookup("", anchors[i], "Z");
            exerciseIdentityLookup("prefix", anchors[i], "suffix");
        }

        String pair = buildValidSurrogatePair(data);
        String prefix = data.consumeAsciiString(data.consumeInt(0, 16));
        String suffix = data.consumeAsciiString(data.consumeInt(0, 16));

        exerciseIdentityLookup(prefix, pair, suffix);

        if (data.consumeBoolean()) {
            String prefix2 = data.consumeAsciiString(data.consumeInt(0, 8));
            String suffix2 = data.consumeAsciiString(data.consumeInt(0, 8));
            exerciseIdentityLookup(prefix + prefix2, pair, suffix2 + suffix);
        }

        if (data.consumeBoolean()) {
            String pair2 = buildValidSurrogatePair(data);
            exerciseIdentityLookup(prefix, pair + pair2, suffix);
        }

        if (data.consumeBoolean()) {
            String repeated = prefix + pair + suffix + pair + data.consumeAsciiString(data.consumeInt(0, 8));
            exerciseIdentityLookup("", pair, repeated);
        }
    }

    private static String buildValidSurrogatePair(FuzzedDataProvider data) {
        char high = (char) data.consumeInt(0xD800, 0xDBFF);
        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
        return new String(new char[] { high, low });
    }

    private static void exerciseIdentityLookup(String prefix, String mappedToken, String suffix) {
        if (mappedToken == null || mappedToken.length() == 0) {
            return;
        }

        String input = prefix + mappedToken + suffix;
        LookupTranslator translator = new LookupTranslator(new CharSequence[][] {
            { mappedToken, mappedToken }
        });

        try {
            String output = translator.translate(input);

            /*
             * Contract asserted:
             * - In CharSequenceTranslator.translate, when a sub-translation consumes 0,
             *   the original code point is copied to the output.
             * - In LookupTranslator.translate, when the mapped token is found, it writes
             *   the mapped value. Here we deliberately use an identity mapping token->token.
             * Therefore every character/code point of input must be preserved, so the whole
             * translation result must equal the original input. A buggy bookkeeping "fix"
             * that merely suppresses the crash but skips/duplicates trailing content violates
             * this observable post-condition.
             */
            if (!input.equals(output)) {
                throw new RuntimeException(
                    "[oracle:identity-lookup] metamorphic violation: identity lookup must preserve input input="
                        + printable(input) + " lhs=" + printable(output) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '\\' && c != '"') {
                sb.append(c);
            } else {
                String hex = Integer.toHexString(c);
                sb.append("\\u");
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
