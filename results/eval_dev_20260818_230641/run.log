package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String fuzz = buildExplorationInput(data);
        invokeRealEntryPoint(fuzz, false);

        String extra = data.consumeString(8);
        invokeRealEntryPoint(extra, false);

        checkEqualContentOracle(fuzz);
        checkEqualContentOracle(extra);

        String truthy = buildTruthyToken(data);
        checkTruthyOracle(truthy);
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 7);
        switch (mode) {
            case 0:
                return "off";
            case 1:
                return mutateThreeCharNonTruthy(data);
            case 2:
                return "Y" + data.consumeAsciiString(2);
            case 3:
                return "T" + data.consumeAsciiString(2);
            case 4:
                return "y" + data.consumeAsciiString(2);
            case 5:
                return data.consumeAsciiString(3);
            case 6:
                return data.consumeAsciiString(data.consumeInt(0, 6));
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static String mutateThreeCharNonTruthy(FuzzedDataProvider data) {
        char[] chars = new char[3];
        chars[0] = (char) (data.consumeByte() & 0x7f);
        chars[1] = (char) (data.consumeByte() & 0x7f);
        chars[2] = (char) (data.consumeByte() & 0x7f);

        if ((chars[0] == 'o' || chars[0] == 'O') &&
            (chars[1] == 'n' || chars[1] == 'N')) {
            chars[2] = 'f';
        }
        if ((chars[0] == 'y' || chars[0] == 'Y') &&
            (chars[1] == 'e' || chars[1] == 'E') &&
            (chars[2] == 's' || chars[2] == 'S')) {
            chars[2] = 'p';
        }
        return new String(chars);
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String base = which == 0 ? "on" : (which == 1 ? "yes" : "true");
        StringBuilder sb = new StringBuilder(base.length());
        for (int i = 0; i < base.length(); i++) {
            char c = base.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(c) : c);
        }
        return new StringBuffer(sb.toString()).toString();
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s == null ? null : new StringBuffer(s).toString());
            /*
             * Contract asserted: this parser is defined by String content, not object identity.
             * The implementation only special-cases the interned literal "true" as an optimization,
             * so equal-content distinct String instances must parse identically. A patch that merely
             * suppresses a crash by changing behavior based on representation would violate this.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /*
             * Contract asserted: documented accepted truthy tokens ("on", "yes", "true")
             * are parsed case-insensitively by this API, and equal-content distinct String
             * objects must also agree. A throw-deleting or overfitted patch that simply
             * returns false on a reachable path would break this observable result.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (isValidationFamily(t)) {
            return true;
        }
        String name = t.getClass().getName();
        String simple = t.getClass().getSimpleName();
        String lower = (name + " " + simple).toLowerCase();
        return lower.contains("invalid")
            || lower.contains("validation")
            || lower.contains("malformed")
            || lower.contains("parse");
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
