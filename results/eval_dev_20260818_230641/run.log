        for (int i = 0; i < cases; i++) {
            double sx = 1.0 + data.consumeInt(0, 1000) / 100.0;
            double sy = 1.0 + data.consumeInt(0, 1000) / 100.0;
            double sz = 1.0 + data.consumeInt(0, 1000) / 100.0;
            double delta = data.consumeInt(0, 1000) / 1000000.0;
            int perturbedVertex = 4 + data.consumeInt(0, 3);
            int perturbedAxis = data.consumeInt(0, 2);
            boolean subtract = data.consumeBoolean();

            double[] coords = new double[] {
                 sx, -sy, -sz,
                 sx, -sy,  sz,
                -sx, -sy,  sz,
                -sx, -sy, -sz,
                 sx,  sy, -sz,
                 sx,  sy,  sz,
                -sx,  sy,  sz,
                -sx,  sy, -sz
            };

            int coordIndex = perturbedVertex * 3 + perturbedAxis;
            coords[coordIndex] += subtract ? -delta : delta;

            exerciseAndCheck(coords);
        }
    }

    private static void exerciseAndCheck(double[] coords) {
        PolyhedronsSet forward;
        PolyhedronsSet reversed;
        try {
            forward = buildPolyhedron(coords, false);
            reversed = buildPolyhedron(coords, true);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: valid closed triangular mesh unexpectedly triggered root-cause failure",
                    t
                );
            }
            return;
        }

        try {
            double size1 = forward.getSize();
            double size1Again = forward.getSize();
            Vector3D bary1 = (Vector3D) forward.getBarycenter();

            double size2 = reversed.getSize();
            Vector3D bary2 = (Vector3D) reversed.getBarycenter();

            /* Contract asserted:
             * A closed bounded polyhedron described by the same triangular facets must have
             * a finite positive volume and the same geometrical properties regardless of
             * collection order. Also, repeated reads of geometrical properties must be stable.
             * A throw-deleting or branch-skipping patch in computeGeometricalProperties could
             * silently leave size/barycenter uninitialized or wrong, violating these checks.
             */
            if (!Double.isFinite(size1) || size1 <= 0.0) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: bounded closed mesh must have finite positive volume input="
                        + summarize(coords) + " size=" + size1
                );
            }
            if (!closeEnough(size1, size1Again)) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: getSize() must be stable across repeated reads input="
                        + summarize(coords) + " lhs=" + size1 + " rhs=" + size1Again
                );
            }
            if (!Double.isFinite(size2) || size2 <= 0.0) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: reversed facet order produced non-finite/non-positive volume input="
                        + summarize(coords) + " size=" + size2
                );
            }
            if (!closeEnough(size1, size2)
                    || !vectorCloseEnough(bary1, bary2)
                    || !vectorFinite(bary1)
                    || !vectorFinite(bary2)) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: same closed mesh with reordered facets must preserve volume and barycenter input="
                        + summarize(coords) + " lhsSize=" + size1 + " rhsSize=" + size2
                        + " lhsBary=" + bary1 + " rhsBary=" + bary2
                );
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:closed-mesh] metamorphic violation: valid closed mesh unexpectedly triggered root-cause failure during geometry computation",
                    t
                );
            }
            throw t;
        }
    }

    private static PolyhedronsSet buildPolyhedron(double[] coords, boolean reverseOrder) {
        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        int triangleCount = TRIANGLE_INDICES.length / 3;
        for (int tri = 0; tri < triangleCount; tri++) {
            int base = reverseOrder ? (triangleCount - 1 - tri) * 3 : tri * 3;

            Vector3D v1 = vertex(coords, TRIANGLE_INDICES[base]);
            Vector3D v2 = vertex(coords, TRIANGLE_INDICES[base + 1]);
            Vector3D v3 = vertex(coords, TRIANGLE_INDICES[base + 2]);

            Plane plane = new Plane(v1, v2, v3);

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>();
            edges.add(new SubLine(p1, p2));
            edges.add(new SubLine(p2, p3));
            edges.add(new SubLine(p3, p1));

            PolygonsSet polygon = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, polygon));
        }
        return new PolyhedronsSet(facets);
    }

    private static Vector3D vertex(double[] coords, int index) {
        int i = index * 3;
        return new Vector3D(coords[i], coords[i + 1], coords[i + 2]);
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("MathIllegal")
                    || name.contains("Invalid")
                    || name.contains("Parse")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof ClassCastException) {
                for (StackTraceElement ste : cur.getStackTrace()) {
                    String cls = ste.getClassName();
                    String m = ste.getMethodName();
                    if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                            && ("computeGeometricalProperties".equals(m)
                                || "getVertices".equals(m)
                                || "getTree".equals(m))) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private static boolean closeEnough(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (!Double.isFinite(a) || !Double.isFinite(b)) {
            return false;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-9 * scale;
    }

    private static boolean vectorFinite(Vector3D v) {
        return Double.isFinite(v.getX()) && Double.isFinite(v.getY()) && Double.isFinite(v.getZ());
    }

    private static boolean vectorCloseEnough(Vector3D a, Vector3D b) {
        return closeEnough(a.getX(), b.getX())
            && closeEnough(a.getY(), b.getY())
            && closeEnough(a.getZ(), b.getZ());
    }

    private static String summarize(double[] coords) {
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < coords.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(coords[i]);
        }
        sb.append(']');
        return sb.toString();
    }
}
