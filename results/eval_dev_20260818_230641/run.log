package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e) || isRootCause(e)) {
                throw e;
            }
            return;
        }

        int rounds = 1;
        if (data.remainingBytes() > 0) {
            rounds = data.consumeInt(1, 8);
        }

        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries("Fuzz-" + r + "-" + data.consumeAsciiString(8));

            int year = data.consumeInt(1901, 2099);
            int month = data.consumeInt(1, 12);
            int leftDayNum = data.consumeInt(1, 20);
            int gapSize = data.consumeInt(1, 40);
            int beforeCount = data.consumeInt(0, 6);
            int afterCount = data.consumeInt(0, 6);

            Day left;
            Day right;
            try {
                left = new Day(leftDayNum, month, year);
                right = addDays(left, gapSize + 1);
            } catch (RuntimeException e) {
                return;
            }
            if (left == null || right == null) {
                return;
            }

            try {
                for (int i = beforeCount; i > 0; i--) {
                    Day d = addDays(left, -i);
                    if (d == null) {
                        return;
                    }
                    series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    Day d = addDays(right, i);
                    if (d == null) {
                        return;
                    }
                    series.add(d, Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                checkSeriesViewConsistency(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);

            Day start;
            Day end;
            try {
                start = addDays(left, startOffset);
                end = addDays(left, endOffset);
            } catch (RuntimeException e) {
                return;
            }
            if (start == null || end == null || start.compareTo(end) > 0) {
                return;
            }

            try {
                verifyGapInputAndCopy(series, left, right, start, end, data);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        verifyGapInputAndCopy(s, left, right, start, end, null);
    }

    private static void verifyGapInputAndCopy(TimeSeries series, Day left, Day right, Day start, Day end,
                                              FuzzedDataProvider data) throws CloneNotSupportedException {
        if (series == null || left == null || right == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: constructed ordered range lies inside a real gap so it must contain no source items"
                            + " manualCount=" + manualCount
                            + " start=" + start
                            + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException(
                    "[oracle:gap-absent] metamorphic violation: both endpoints chosen strictly inside the gap must be absent"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanValidation(e)) {
                return;
            }
            throw e;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries for ordered,
         * non-null bounds. When both bounds lie wholly inside a real gap, no source item is in the
         * requested interval, so the returned series must be empty. A patch that merely suppresses
         * the historical exception or skips the empty-range bookkeeping would violate this
         * observable post-condition without throwing.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            if (outerStartOffset <= outerEndOffset) {
                int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
                int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
                Day s = addDays(left, innerStartOffset);
                Day e = addDays(left, innerEndOffset);
                if (s != null && e != null) {
                    innerStart = s;
                    innerEnd = e;
                }
            }
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            assertEmptySeries(innerCopy, "subgap-empty", innerStart, innerEnd);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanValidation(e)) {
                return;
            }
            throw e;
        }

        if (series.getItemCount() > 0) {
            int chosen = (data == null) ? 0 : data.consumeInt(0, series.getItemCount() - 1);
            try {
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
            }
        }

        checkBoundaryStepRight(series, start, right);
        checkBoundaryStepLeft(series, left, end);
    }

    private static void assertEmptySeries(TimeSeries copy, String oracleId, RegularTimePeriod start,
                                          RegularTimePeriod end) {
        checkSeriesViewConsistency(copy, oracleId);
        int itemCount = copy.getItemCount();
        int itemsSize = copy.getItems().size();
        int periodsSize = copy.getTimePeriods().size();
        if (itemCount != 0 || itemsSize != 0 || periodsSize != 0) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: empty-gap createCopy must return an empty series"
                            + " itemCount=" + itemCount
                            + " itemsSize=" + itemsSize
                            + " periodsSize=" + periodsSize
                            + " start=" + start
                            + " end=" + end);
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String oracleId) {
        checkSeriesViewConsistency(a, oracleId + "-lhs");
        checkSeriesViewConsistency(b, oracleId + "-rhs");

        if (a.getItemCount() != b.getItemCount()
                || a.getItems().size() != b.getItems().size()
                || a.getTimePeriods().size() != b.getTimePeriods().size()) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: equivalent createCopy overloads disagree"
                            + " lhsCount=" + a.getItemCount()
                            + " rhsCount=" + b.getItemCount()
                            + " lhsItems=" + a.getItems().size()
                            + " rhsItems=" + b.getItems().size()
                            + " lhsPeriods=" + a.getTimePeriods().size()
                            + " rhsPeriods=" + b.getTimePeriods().size());
        }

        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa.compareTo(pb) != 0) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: equivalent createCopy overloads disagree on period"
                                + " index=" + i
                                + " lhs=" + pa
                                + " rhs=" + pb);
            }
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String tag) {
        if (series == null) {
            throw new RuntimeException("[oracle:view-consistency] metamorphic violation: series is null tag=" + tag);
        }
        int itemCount = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();
        if (itemCount != itemsSize || itemCount != periodsSize) {
            throw new RuntimeException(
                    "[oracle:view-consistency] metamorphic violation: public series views must agree"
                            + " tag=" + tag
                            + " itemCount=" + itemCount
                            + " itemsSize=" + itemsSize
                            + " periodsSize=" + periodsSize);
        }
        for (int i = 0; i < itemCount; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (series.getIndex(p) != i) {
                throw new RuntimeException(
                        "[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                                + " tag=" + tag
                                + " index=" + i
                                + " roundTrip=" + series.getIndex(p)
                                + " period=" + p);
            }
        }
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day start, Day right) {
        if (series == null || start == null || right == null) {
            return;
        }
        Day neighbor = addDays(start, 1);
        if (neighbor == null || neighbor.compareTo(right) > 0) {
            return;
        }
        try {
            TimeSeries copy = series.createCopy(neighbor, right);
            if (copy.getItemCount() <= 0) {
                throw new RuntimeException(
                        "[oracle:boundary-right] metamorphic violation: extending empty-gap end to the first real item on the right must yield a non-empty copy"
                                + " start=" + neighbor
                                + " end=" + right
                                + " count=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day left, Day end) {
        if (series == null || left == null || end == null) {
            return;
        }
        Day neighbor = addDays(end, -1);
        if (neighbor == null || left.compareTo(neighbor) > 0) {
            return;
        }
        try {
            TimeSeries copy = series.createCopy(left, neighbor);
            if (copy.getItemCount() <= 0) {
                throw new RuntimeException(
                        "[oracle:boundary-left] metamorphic violation: extending empty-gap start to the first real item on the left must yield a non-empty copy"
                                + " start=" + left
                                + " end=" + neighbor
                                + " count=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static int countItemsInInclusiveRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int insertionPoint(int rawBinarySearchResult) {
        if (rawBinarySearchResult >= 0) {
            return rawBinarySearchResult;
        }
        return -(rawBinarySearchResult + 1);
    }

    private static Day addDays(Day base, int delta) {
        if (base == null) {
            return null;
        }
        Day current = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
