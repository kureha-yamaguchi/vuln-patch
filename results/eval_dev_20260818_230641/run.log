package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        double[] anchor = new double[] {
            1.000000d, -1.000000d, -1.000000d,
            1.000000d, -1.000000d,  1.000000d,
           -1.000000d, -1.000000d,  1.000000d,
           -1.000000d, -1.000000d, -1.000000d,
            1.000000d,  1.000000d, -1.000000d,
            0.999999d,  1.000000d,  1.000000d,
           -1.000000d,  1.000000d,  1.000000d,
           -1.000000d,  1.000000d, -1.000000d
        };
        exerciseAndCheck(anchor);

        double[] coords = new double[] {
            1.0d, -1.0d, -1.0d,
            1.0d, -1.0d,  1.0d,
           -1.0d, -1.0d,  1.0d,
           -1.0d, -1.0d, -1.0d,
            1.0d,  1.0d, -1.0d,
            1.0d,  1.0d,  1.0d,
           -1.0d,  1.0d,  1.0d,
           -1.0d,  1.0d, -1.0d
        };

        int movedVertex = data.consumeInt(0, 7);
        int movedAxis = data.consumeInt(0, 2);
        int rawDelta = data.consumeInt(-2000000, 2000000);
        double delta = rawDelta / 1000000000.0d;
        if (delta == 0.0d) {
            delta = 0.000001d;
        }

        double scale = data.consumeInt(1, 1000) / 100.0d;
        double tx = data.consumeInt(-1000, 1000) / 100.0d;
        double ty = data.consumeInt(-1000, 1000) / 100.0d;
        double tz = data.consumeInt(-1000, 1000) / 100.0d;

        coords[movedVertex * 3 + movedAxis] += delta;

        for (int i = 0; i < coords.length; i += 3) {
            coords[i] = coords[i] * scale + tx;
            coords[i + 1] = coords[i + 1] * scale + ty;
            coords[i + 2] = coords[i + 2] * scale + tz;
        }

        exerciseAndCheck(coords);
    }

    private static void exerciseAndCheck(double[] coords) {
        List<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
                buildFacets(coords);
        if (facets == null || facets.isEmpty()) {
            return;
        }

        PolyhedronsSet forward;
        try {
            forward = new PolyhedronsSet(facets);
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        List<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> reversed =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>(facets);
        Collections.reverse(reversed);

        PolyhedronsSet backward;
        try {
            backward = new PolyhedronsSet(reversed);
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        double size1;
        Vector3D bary1;
        try {
            size1 = forward.getSize();
            bary1 = (Vector3D) forward.getBarycenter();
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        double size2;
        Vector3D bary2;
        try {
            size2 = backward.getSize();
            bary2 = (Vector3D) backward.getBarycenter();
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        /*
         * Contract/oracle:
         * PolyhedronsSet(Collection<SubHyperplane<Euclidean3D>>) represents a region
         * defined by a boundary collection; the iteration order of that collection is
         * not part of the geometry. Therefore, reversing the facet order must not
         * change observable geometric properties such as size or barycenter.
         * A "fix" that merely skips/loses bookkeeping in the patched path can stop
         * crashing yet silently compute order-dependent wrong geometry; this oracle
         * catches that.
         */
        if (!sameDouble(size1, size2) || !sameVector(bary1, bary2)) {
            throw new RuntimeException(
                "[oracle:facet-order] metamorphic violation: reversing boundary facet order changed geometry "
                + "input=" + coordsToString(coords)
                + " lhsSize=" + size1
                + " rhsSize=" + size2
                + " lhsBary=" + vectorToString(bary1)
                + " rhsBary=" + vectorToString(bary2));
        }
    }

    private static List<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> buildFacets(double[] coords) {
        int[] indices = new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();
        try {
            for (int idx = 0; idx < indices.length; idx += 3) {
                Vector3D a = vertex(coords, indices[idx]);
                Vector3D b = vertex(coords, indices[idx + 1]);
                Vector3D c = vertex(coords, indices[idx + 2]);

                Plane plane = new Plane(a, b, c);
                org.apache.commons.math3.geometry.euclidean.twod.Vector2D p1 = plane.toSubSpace(a);
                org.apache.commons.math3.geometry.euclidean.twod.Vector2D p2 = plane.toSubSpace(b);
                org.apache.commons.math3.geometry.euclidean.twod.Vector2D p3 = plane.toSubSpace(c);

                PolygonsSet region = new PolygonsSet(p1, p2, p3);
                facets.add(new SubPlane(plane, region));
            }
        } catch (Throwable t) {
            handleThrowable(t);
            return null;
        }
        return facets;
    }

    private static Vector3D vertex(double[] coords, int vertexIndex) {
        int i = vertexIndex * 3;
        return new Vector3D(coords[i], coords[i + 1], coords[i + 2]);
    }

    private static void handleThrowable(Throwable t) {
        if (isOracleViolation(t)) {
            throw (RuntimeException) t;
        }
        if (isRootCause(t)) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            throw new RuntimeException(t);
        }
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)) {
                if ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method)
                    || "setSize".equals(method)
                    || "setBarycenter".equals(method)
                    || "followLoop".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean sameVector(Vector3D a, Vector3D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameDouble(a.getX(), b.getX())
            && sameDouble(a.getY(), b.getY())
            && sameDouble(a.getZ(), b.getZ());
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return Double.isNaN(a) && Double.isNaN(b);
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(1.0d, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= 1.0e-8d * scale;
    }

    private static String coordsToString(double[] coords) {
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < coords.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(coords[i]);
        }
        sb.append(']');
        return sb.toString();
    }

    private static String vectorToString(Vector3D v) {
        if (v == null) {
            return "null";
        }
        return "[" + v.getX() + "," + v.getY() + "," + v.getZ() + "]";
    }
}
