        s.add(existingRight, Integer.valueOf(1));

        checkSeriesViewConsistency(s, "anchor-source");
        verifyEmptyGapContractWithoutFuzzer(s, existingLeft, existingRight, start, end);
    }

    private static void verifyEmptyGapContract(TimeSeries series, Day left, Day right, Day start, Day end,
            FuzzedDataProvider data) throws CloneNotSupportedException {
        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException("[oracle:gap-shape] metamorphic violation: chosen ordered range lies inside a real gap so it must contain no source items"
                    + " manualCount=" + manualCount
                    + " start=" + start
                    + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException("[oracle:gap-absent] metamorphic violation: both endpoints chosen strictly inside the gap must be absent from the series"
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex
                    + " start=" + start
                    + " end=" + end);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:valid-empty-gap] metamorphic violation: createCopy(start,end) must accept ordered non-null periods wholly inside a real gap and return an empty series"
                        + " start=" + start
                        + " end=" + end
                        + " rawStartIndex=" + rawStartIndex
                        + " rawEndIndex=" + rawEndIndex, e);
            }
            throw e;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by the
         * ordered, non-null periods. When start and end are both inside a real gap and there are no
         * source items in [start,end], the inclusive subseries is empty. A throw-deleting patch or a
         * patch that skips the empty-range bookkeeping can return a non-empty copy instead; the copy's
         * public views must also agree on that emptiness.
         */
        checkSeriesViewConsistency(copy, "empty-gap-copy");
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException("[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                    + " copyCount=" + copy.getItemCount()
                    + " copyItems=" + copy.getItems().size()
                    + " copyPeriods=" + copy.getTimePeriods().size()
                    + " start=" + start
                    + " end=" + end
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex);
        }

