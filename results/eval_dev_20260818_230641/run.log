package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runOne("\uD83D\uDE30", true);
        runOne("\uD800\uDC00", true);
        runOne("\uD834\uDD1E", true);
        runOne("\uDBFF\uDFFD", true);

        String fuzzed = buildSafeCsvField(data);
        runOne(fuzzed, true);

        String left = buildSafeCsvField(data);
        String right = buildSafeCsvField(data);
        runConcatOracle(left, right);
    }

    private static String buildSafeCsvField(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int parts = data.consumeInt(0, 8);
        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                String ascii = data.consumeAsciiString(8);
                for (int j = 0; j < ascii.length(); j++) {
                    char c = ascii.charAt(j);
                    if (c != '"' && c != ',' && c != '\r' && c != '\n') {
                        sb.append(c);
                    }
                }
            } else {
                int codePoint = data.consumeInt(0x10000, 0x10FFFF);
                if (Character.isValidCodePoint(codePoint)) {
                    sb.append(Character.toChars(codePoint));
                }
            }
        }
        if (sb.length() == 0 && data.consumeBoolean()) {
            sb.append("A");
        }
        return sb.toString();
    }

    private static void runOne(String input, boolean expectIdentity) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: escapeCsv "Returns a String value for a CSV column enclosed in double quotes, if required".
             * Therefore, for a field we construct to contain none of the CSV-trigger characters
             * (double quote, comma, CR, LF), quoting is not required and the result must be identical
             * to the input. A throw-deleting or bookkeeping-skipping patch could silently truncate or
             * otherwise alter surrogate-containing inputs instead of preserving them.
             */
            if (expectIdentity && out != null && !out.equals(input)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV field must be unchanged input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runConcatOracle(String left, String right) {
        String whole;
        String lhs;
        String rhs;
        try {
            whole = StringEscapeUtils.escapeCsv(left + right);
            lhs = StringEscapeUtils.escapeCsv(left);
