        String maybeBadMant = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 6)), 0, false);
        String trailingExp = (data.consumeBoolean() ? "-" : "") + maybeBadMant + (data.consumeBoolean() ? "e" : "E");
        exerciseSilently(trailingExp);
    }
