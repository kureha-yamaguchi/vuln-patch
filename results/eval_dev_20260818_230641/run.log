private static void checkEquivalentScientificNotation(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            /*
             * Contract used for this oracle:
             * both strings denote the same numeric quantity because they differ only by exponent-marker
             * case and by inserting a redundant ".0" before the exponent. A correct numeric parser must
             * assign the same value to both accepted inputs. A patch that merely suppresses the throw but
             * computes the mantissa/exponent split incorrectly will violate this relation.
             */
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:scientific-equivalence] metamorphic violation: equivalent scientific notations parsed to different values inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException ignored) {
            // Rejections of fuzz-generated inputs do not imply a bug and are skipped.
        }
    }
