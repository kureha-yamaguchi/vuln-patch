package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (StackTraceElement f : frames) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                String m = f.getMethodName();
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static void exerciseSilently(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (hasRelevantStack(t) || isCleanReject(t)) {
                return;
            }
        }
    }

    private static Number parseOrNull(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (hasRelevantStack(t) || isCleanReject(t)) {
                return null;
            }
            return null;
        }
    }

    private static java.math.BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new java.math.BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        java.math.BigDecimal left = toBigDecimal(a);
        java.math.BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static void checkEquivalent(String a, String b, String oracleId) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (hasRelevantStack(t) || isCleanReject(t)) {
                return;
            }
        }
    }

    private static String digitsOnly(String s, int minLen, boolean forceNonZero) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            } else {
                out.append((char) ('0' + (c & 7)));
            }
        }
        while (out.length() < minLen) {
            out.append('0');
        }
        if (forceNonZero) {
            boolean allZero = true;
            for (int i = 0; i < out.length(); i++) {
                if (out.charAt(i) != '0') {
                    allZero = false;
                    break;
                }
            }
            if (allZero) {
                out.setCharAt(out.length() - 1, '1');
            }
        }
        return out.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseSilently("1234.5");
        exerciseSilently("12345");
        exerciseSilently("1234.5D");
        exerciseSilently("1234.5d");
        exerciseSilently("1234.5F");
        exerciseSilently("1234.5f");
        exerciseSilently("-1234.5");
        exerciseSilently("-12345");
        exerciseSilently("0xFADE");
        exerciseSilently("-0xFADE");
        exerciseSilently("1.1E200");
        exerciseSilently("1.1E20");
        exerciseSilently("-1.1E200");
        exerciseSilently("1.1E-200");
        exerciseSilently("12345678901234567890L");
        exerciseSilently("1.1E-700F");
        exerciseSilently("2.");

        /* Contract asserted below:
         * createNumber parses numeric strings, so syntactic variants that denote the same
         * number must yield equal numeric values: exponent-marker case ('e' vs 'E'),
         * redundant ".0" before an exponent, and an explicit long suffix for an integral
         * value. A throw-deleting or branch-skipping patch could avoid the historical
         * crash yet silently parse one equivalent form differently; these checks expose
         * such wrong-output fixes through observable API results.
         */
        checkEquivalent("1234.5", "1234.5D", "anchor-decimal-explicit-double");
        checkEquivalent("12345", "12345L", "anchor-integer-explicit-long");
        checkEquivalent("1e2", "1E2", "anchor-exp-case");
        checkEquivalent("1e2", "1.0E2", "anchor-redundant-decimal");

        String sign = data.consumeBoolean() ? "-" : "";
        String mantDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 8)), 1, true);

        String expSign = data.consumeBoolean() ? "-" : "";
        String expDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 4)), 1, false);

        char expMarker = data.consumeBoolean() ? 'e' : 'E';

        String suffix = "";
        switch (data.consumeInt(0, 4)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            default:
                break;
        }

        String sci = sign + mantDigits + expMarker + expSign + expDigits;
        String sciCaseFlip = sign + mantDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String sciWithDecimal = sign + mantDigits + ".0" + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String sciWithSuffix = sci + suffix;
        String sciWithDecimalAndSuffix = sciWithDecimal + suffix;

        exerciseSilently(sci);
        exerciseSilently(sciWithSuffix);

        checkEquivalent(sci, sciCaseFlip, "scientific-exp-case-equivalence");
        checkEquivalent(sci, sciWithDecimal, "redundant-decimal-before-exponent");
        if (!suffix.isEmpty()) {
            checkEquivalent(sciWithSuffix, sciWithDecimalAndSuffix, "redundant-decimal-before-exponent-suffix");
        }

        String integralSign = data.consumeBoolean() ? "-" : "";
        String integralDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 18)), 1, true);
        String integral = integralSign + integralDigits;
        String integralLong = integral + (data.consumeBoolean() ? "L" : "l");
        checkEquivalent(integral, integralLong, "integral-vs-explicit-long");

        String hugeDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(19, 40)), 19, true);
        String hugeIntegral = (data.consumeBoolean() ? "-" : "") + hugeDigits;
        exerciseSilently(hugeIntegral);
        exerciseSilently(hugeIntegral + "L");

        if (data.consumeBoolean()) {
            String hexDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 8)), 1, true);
            StringBuilder hex = new StringBuilder();
            for (int i = 0; i < hexDigits.length(); i++) {
                char d = hexDigits.charAt(i);
                hex.append("0123456789ABCDEF".charAt((d - '0') & 0xF));
            }
            exerciseSilently((data.consumeBoolean() ? "-" : "") + "0x" + hex.toString());
