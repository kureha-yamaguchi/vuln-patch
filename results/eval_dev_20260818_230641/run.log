package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            String s = anchors[i];
            try {
                String out = StringEscapeUtils.escapeCsv(s);
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity-safe] metamorphic violation: escapeCsv must leave strings without CSV special characters unchanged input=" + s + " lhs=" + out + " rhs=" + s);
                }
            } catch (RuntimeException t) {
                boolean validation = t instanceof IllegalArgumentException || t instanceof NumberFormatException;
                if (validation) {
                    return;
                }
                boolean rootCause = t instanceof StringIndexOutOfBoundsException;
                if (rootCause) {
                    StackTraceElement[] st = t.getStackTrace();
                    for (int j = 0; j < st.length; j++) {
                        if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(st[j].getClassName())
                                && "translate".equals(st[j].getMethodName())) {
                            throw t;
                        }
                    }
                }
                return;
            }
        }

        int prefixLen = data.consumeInt(0, 16);
        int suffixLen = data.consumeInt(0, 16);
        String rawPrefix = data.consumeAsciiString(prefixLen);
        String rawSuffix = data.consumeAsciiString(suffixLen);

        StringBuilder prefix = new StringBuilder();
        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                prefix.append(c);
            }
        }

        StringBuilder suffix = new StringBuilder();
        for (int i = 0; i < rawSuffix.length(); i++) {
            char c = rawSuffix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                suffix.append(c);
            }
        }

        int pairCount = data.consumeInt(1, 8);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            int cp;
            if (data.consumeBoolean()) {
                cp = data.consumeInt(0x10000, 0x10FFFF);
            } else {
                int plane = data.consumeInt(1, 16);
                int low = data.consumeInt(0, 0xFFFF);
                cp = (plane << 16) | low;
                if (cp > 0x10FFFF) {
                    cp = 0x10FFFF;
                }
                if (cp < 0x10000) {
                    cp = 0x10000;
                }
            }
            middle.append(Character.toChars(cp));

            String gap = data.consumeAsciiString(data.consumeInt(0, 4));
            for (int j = 0; j < gap.length(); j++) {
                char c = gap.charAt(j);
                if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                    middle.append(c);
                }
            }
        }

        String candidate = prefix.toString() + middle.toString() + suffix.toString();

        try {
            String out = StringEscapeUtils.escapeCsv(candidate);

            /*
             * Contract used for this oracle:
             * CSV escaping only needs to modify inputs containing CSV-special characters
             * such as comma, quote, CR, or LF. This candidate is built to exclude all of
             * those characters while still containing one or more real supplementary code
             * points (surrogate pairs), so every correct implementation must return the
             * original string unchanged. A throw-deleting or bookkeeping-breaking patch
             * could silently drop or duplicate chars and violate this observable result.
             */
            if (!candidate.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity-safe] metamorphic violation: escapeCsv must leave strings without CSV special characters unchanged input=" + candidate + " lhs=" + out + " rhs=" + candidate);
            }

            String out2 = StringEscapeUtils.escapeCsv(out);
            if (!out.equals(out2)) {
                throw new RuntimeException("[oracle:csv-idempotent-safe] metamorphic violation: escapeCsv should be idempotent on already-safe output input=" + candidate + " lhs=" + out + " rhs=" + out2);
            }
        } catch (RuntimeException t) {
            boolean validation = t instanceof IllegalArgumentException || t instanceof NumberFormatException;
            if (validation) {
                return;
            }
            boolean rootCause = t instanceof StringIndexOutOfBoundsException;
            if (rootCause) {
                StackTraceElement[] st = t.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(st[i].getClassName())
                            && "translate".equals(st[i].getMethodName())) {
                        throw t;
                    }
                }
            }
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            return;
        }
    }
}
