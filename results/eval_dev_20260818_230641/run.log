package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runOne("\uD83D\uDE30");
        runOne("\uD800\uDC00");
        runOne("\uD834\uDD1E");
        runOne("\uDBFF\uDFFD");

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(data.consumeInt(0, 16)));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(data.consumeInt(0, 16)));

        int pairs = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder(prefix.length() + suffix.length() + pairs * 2);
        sb.append(prefix);
        for (int i = 0; i < pairs; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafe(data.consumeAsciiString(data.consumeInt(0, 4))));
            }
        }
        sb.append(suffix);

        runOne(sb.toString());
    }

    private static void runOne(String input) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle:
             * escapeCsv only adds CSV quoting/escaping when the input contains ',', '"', '\r', or '\n'.
             * For inputs constructed to contain none of those characters, a correct implementation must
             * return the input unchanged. This catches throw-deleting or bookkeeping-corrupt patches that
             * silently skip/duplicate/drop characters instead of crashing.
             */
            if (isCsvSafe(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-safe-identity] metamorphic violation: escapeCsv must be identity on CSV-safe input"
                        + " input=" + printable(input)
                        + " lhs=" + printable(escaped)
                        + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                out.append('a');
            } else {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static boolean isCsvSafe(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static String printable(String s) {
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        b.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(c);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }
}
