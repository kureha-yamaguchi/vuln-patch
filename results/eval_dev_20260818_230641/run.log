package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchors();

        String text = data.consumeString(40);
        int pairCount = data.consumeInt(1, 4);

        String[] activeSearch = new String[pairCount];
        String[] activeReplacement = new String[pairCount];

        for (int i = 0; i < pairCount; i++) {
            String s = data.consumeString(8);
            if (StringUtils.length(s) == 0) {
                s = "a";
            }
            activeSearch[i] = s;

            String r = data.consumeString(8);
            activeReplacement[i] = r;
        }

        if (StringUtils.length(text) == 0) {
            String seed = activeSearch[0];
            text = seed + data.consumeString(6) + seed;
        }

        int insertAt = data.consumeInt(0, pairCount);
        String[] augmentedSearch = new String[pairCount + 1];
        String[] augmentedReplacement = new String[pairCount + 1];

        for (int i = 0, j = 0; i < augmentedSearch.length; i++) {
            if (i == insertAt) {
                boolean useNullSearch = data.consumeBoolean();
                augmentedSearch[i] = useNullSearch ? null : "";
                augmentedReplacement[i] = data.consumeBoolean() ? null : data.consumeString(8);
            } else {
                augmentedSearch[i] = activeSearch[j];
                augmentedReplacement[i] = activeReplacement[j];
                j++;
            }
        }

        String baseline;
        try {
            baseline = StringUtils.replaceEach(text, activeSearch, activeReplacement);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:valid-active] metamorphic violation: valid active replaceEach unexpectedly crashed input=" + describe(text, activeSearch, activeReplacement), e);
            }
            return;
        }

        String augmented;
        try {
            augmented = StringUtils.replaceEach(text, augmentedSearch, augmentedReplacement);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:ignore-inert] metamorphic violation: adding an inert entry (null replacement or null/empty search) must be ignored by replaceEach input=" + describe(text, augmentedSearch, augmentedReplacement) + " baseline=" + baseline, e);
            }
            return;
        }

        /*
         * Contract used for this oracle: the implementation explicitly skips any entry where
         * searchList[i] == null, searchList[i].length() == 0, or replacementList[i] == null.
         * Therefore adding such an inert entry must not change the observable result.
         * A patch that merely deletes the throw or bails out on null elements can violate this
         * by returning the input or some other wrong output without throwing.
         */
        if (!safeEquals(baseline, augmented)) {
            throw new RuntimeException("[oracle:ignore-inert] metamorphic violation: adding an inert entry changed the result input="
                    + describe(text, augmentedSearch, augmentedReplacement)
                    + " lhs=" + baseline
                    + " rhs=" + augmented);
        }
    }

    private static void runAnchors() {
        checkEquals(null, StringUtils.replaceEach(null, new String[] {"a"}, new String[] {"b"}),
                "[oracle:anchor-null-text] valid null text must return null");
        checkEquals("aba", callAnchor("aba", new String[] {null}, new String[] {"a"}),
                "[oracle:anchor-null-search] null search entries must be ignored");
        checkEquals("aba", callAnchor("aba", new String[] {"a"}, new String[] {null}),
                "[oracle:anchor-null-replacement] null replacement entries must be ignored");
        checkEquals("cbc", callAnchor("aba", new String[] {"a", "b"}, new String[] {"c", null}),
                "[oracle:anchor-mixed-null-replacement] mixed active and null replacement entries must still replace the active ones");
    }

    private static String callAnchor(String text, String[] search, String[] replacement) {
        try {
            return StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return null;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:anchor-root-cause] metamorphic violation: valid documented anchor input crashed input="
                        + describe(text, search, replacement), e);
            }
            return null;
        }
    }

    private static void checkEquals(String expected, String actual, String prefix) {
        if (!safeEquals(expected, actual)) {
            throw new RuntimeException(prefix + " input-result mismatch expected=" + expected + " actual=" + actual);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("replaceEach".equals(m) || "length".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String describe(String text, String[] search, String[] replacement) {
        return "text=" + text
                + " search=" + ArrayUtils.toString(search)
                + " replacement=" + ArrayUtils.toString(replacement);
    }
}
