package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            checkCsvIdentityOnSafeInput(anchors[i]);
        }

        String explored = buildSafeCsvInputWithSurrogates(data);
        checkCsvIdentityOnSafeInput(explored);

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));
        String pairOnlyMiddle = prefix + randomSurrogatePair(data) + suffix;
        checkCsvIdentityOnSafeInput(pairOnlyMiddle);
    }

    /*
     * Contract/oracle used:
     * For CSV-safe inputs (no comma, quote, CR, or LF), escaping must be the identity:
     * escapeCsv(s) == s. The failing test itself asserts this for surrogate pairs.
     * A throw-deleting or branch-skipping patch would violate this by dropping/changing
     * characters instead of returning the original string unchanged.
     */
    private static void checkCsvIdentityOnSafeInput(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv threw from CharSequenceTranslator.translate on valid CSV-safe input input="
                        + printable(input), t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildSafeCsvInputWithSurrogates(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int segments = data.consumeInt(1, 4);
        for (int i = 0; i < segments; i++) {
            sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(12)));
            sb.append(randomSurrogatePair(data));
            if (data.consumeBoolean()) {
                sb.append(safeBmpChar(data));
            }
        }
        sb.append(sanitizeCsvSafeAscii(data.consumeRemainingAsString()));
        return sb.toString();
    }

    private static String randomSurrogatePair(FuzzedDataProvider data) {
        char high = (char) data.consumeInt(0xD800, 0xDBFF);
        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
        return new String(new char[] { high, low });
    }

    private static char safeBmpChar(FuzzedDataProvider data) {
        int c = data.consumeInt(0x20, 0x7E);
        if (c == ',' || c == '"' || c == '\r' || c == '\n') {
            c = 'X';
        }
        return (char) c;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('X');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
