    private static Day addDays(Day start, int offset) {
        if (start == null || offset < 0) {
            return null;
        }
        Day d = start;
        for (int i = 0; i < offset; i++) {
            RegularTimePeriod next = d.next();
            if (!(next instanceof Day)) {
                return null;
            }
            d = (Day) next;
        }
        return d;
    }

    private static int daysBetween(Day left, Day right) {
        if (left == null || right == null) {
