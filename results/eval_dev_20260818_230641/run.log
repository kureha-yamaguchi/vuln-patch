            }
        }
        return false;
    }

    private static boolean isValidationLike(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildValidSafeCsvString(FuzzedDataProvider data) {
        int parts = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder();
        boolean hasSupplementary = false;
        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                sb.append(safeBmpChar(data));
            } else {
                int codePoint = randomSupplementaryCodePoint(data);
                sb.append(Character.toChars(codePoint));
                hasSupplementary = true;
            }
        }
        if (!hasSupplementary) {
            sb.append(Character.toChars(randomSupplementaryCodePoint(data)));
        }
        return sb.toString();
    }

    private static char safeBmpChar(FuzzedDataProvider data) {
        char[] choices = new char[] {
                'a', 'b', 'c', 'X', 'Y', 'Z', '0', '1', '2', ' ', '_', '-', '.', ';', ':', '/', '@'
        };
        return choices[data.consumeInt(0, choices.length - 1)];
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp)) {
                return cp;
            }
        }
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        sb.append("\\u");
                        String hex = Integer.toHexString(ch);
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
