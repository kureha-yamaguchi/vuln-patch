        }
        u.checkEquivalent(integralScientific, redundantFractionScientific, "redundant-decimal-before-exponent");
        u.checkEquivalent(integralScientific, integralScientificOppCase, "integral-scientific-exp-case-equivalence");

        String extra = data.consumeString(6);
        if (extra != null && extra.length() > 0) {
