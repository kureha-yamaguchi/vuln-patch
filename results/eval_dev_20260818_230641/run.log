    // Contract asserted from the shown computeGeometricalProperties implementation:
    // for getVertices().length == 0 on a leaf tree, Boolean.TRUE means whole space
    // => size is +INF and barycenter is NaN; Boolean.FALSE means empty region
    // => size is 0 and barycenter is (0,0). A "fix" that merely deletes the
    // bookkeeping or silently skips the branch breaks this observable API result.
    private static void checkLeafBooleanContract() {
        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            double wholeSize1 = whole.getSize();
            Vector2D wholeBary1 = (Vector2D) whole.getBarycenter();
            double wholeSize2 = whole.getSize();
            Vector2D wholeBary2 = (Vector2D) whole.getBarycenter();

            if (!Double.isInfinite(wholeSize1) || !Double.isInfinite(wholeSize2)
                    || !Double.isNaN(wholeBary1.getX()) || !Double.isNaN(wholeBary1.getY())
                    || !Double.isNaN(wholeBary2.getX()) || !Double.isNaN(wholeBary2.getY())) {
                throw new RuntimeException("[oracle:leaf-bool] metamorphic violation: whole-space leaf must expose infinite size and NaN barycenter lhs="
                        + wholeSize1 + "," + wholeBary1 + " rhs=" + wholeSize2 + "," + wholeBary2);
            }

            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            double emptySize1 = empty.getSize();
            Vector2D emptyBary1 = (Vector2D) empty.getBarycenter();
            double emptySize2 = empty.getSize();
            Vector2D emptyBary2 = (Vector2D) empty.getBarycenter();

            if (emptySize1 != 0.0 || emptySize2 != 0.0
                    || emptyBary1.getX() != 0.0 || emptyBary1.getY() != 0.0
                    || emptyBary2.getX() != 0.0 || emptyBary2.getY() != 0.0) {
                throw new RuntimeException("[oracle:leaf-bool] metamorphic violation: empty leaf must expose zero size and (0,0) barycenter lhs="
                        + emptySize1 + "," + emptyBary1 + " rhs=" + emptySize2 + "," + emptyBary2);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static PolygonsSet buildLeafPolygonWithNonBooleanAttribute(FuzzedDataProvider data, int salt) {
        double x1 = finiteCoordinate(data.consumeInt() ^ (salt * 0x9e3779b9));
        double y1 = finiteCoordinate(data.consumeInt() ^ (salt * 0x7f4a7c15));
        double x2 = finiteCoordinate(data.consumeInt() ^ (salt * 0x94d049bb));
        double y2 = finiteCoordinate(data.consumeInt() ^ (salt * 0x5bd1e995));

        if (x1 == x2 && y1 == y2) {
            x2 = x1 + 1.0;
        }

        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        SubHyperplane<Euclidean2D> plusOutside = data.consumeBoolean() ? line.wholeHyperplane() : null;
        SubHyperplane<Euclidean2D> plusInside = data.consumeBoolean() ? line.wholeHyperplane() : null;

        if (plusOutside == null && plusInside == null) {
            plusOutside = line.wholeHyperplane();
        }

        BoundaryAttribute<Euclidean2D> attr = new BoundaryAttribute<Euclidean2D>(plusOutside, plusInside);
        return new PolygonsSet(new BSPTree<Euclidean2D>(attr));
    }

    private static double finiteCoordinate(int v) {
        return (v % 2000001) / 1000.0;
    }

    private static void exerciseAndCheck(PolygonsSet poly) {
        poly.getTree(false);
        poly.getVertices();
        poly.getSize();
        poly.getBarycenter();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("IllegalArgument")
                || name.contains("Invalid")
                || name.contains("Malformed")
                || name.contains("Parse")
                || name.contains("MathIllegal");
    }
}
