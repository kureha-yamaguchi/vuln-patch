        exerciseSilently(observed[data.consumeInt(0, observed.length - 1)]);

        String tail = data.consumeString(6);
        if (tail != null && tail.length() > 0) {
            exerciseSilently(decimal + tail);
            exerciseSilently(scientificLower + tail);
            exerciseSilently(mant + tail);
