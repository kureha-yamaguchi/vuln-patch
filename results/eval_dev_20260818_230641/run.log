package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import java.util.Objects;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCalls();

        String token = data.consumeAsciiString(3);
        if (token.length() == 0) {
            token = "a";
        }
        String replacement = data.consumeString(4);
        String prefix = data.consumeString(8);
        String middle = data.consumeString(8);
        String suffix = data.consumeRemainingAsString();

        String text = prefix + token + middle + token + suffix;

        String[] searchList = buildSearchList(data, token);
        String[] replacementList = buildReplacementList(data, replacement, searchList.length);

        checkFilteredIgnoredPairsOracle(text, searchList, replacementList);
    }

    private static void runAnchorCalls() {
        try {
            StringUtils.replaceEach(null, new String[] {"a"}, new String[] {"b"});
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", null, null);
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", new String[0], null);
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", null, new String[0]);
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", new String[] {"a"}, null);
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", new String[] {null}, new String[] {"a"});
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", new String[] {"a"}, new String[] {null});
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }

        try {
            StringUtils.replaceEach("aba", new String[] {"a", "b"}, new String[] {"c", null});
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
        }
    }

    private static String[] buildSearchList(FuzzedDataProvider data, String token) {
        int size = data.consumeInt(2, 5);
        String[] searchList = new String[size];
        searchList[0] = token;
        for (int i = 1; i < size; i++) {
            int kind = data.consumeInt(0, 3);
            if (kind == 0) {
                searchList[i] = null;
            } else if (kind == 1) {
                searchList[i] = "";
            } else if (kind == 2) {
                searchList[i] = data.consumeAsciiString(3);
            } else {
                searchList[i] = token;
            }
        }
        return searchList;
    }

    private static String[] buildReplacementList(FuzzedDataProvider data, String replacement, int size) {
        String[] replacementList = new String[size];
        replacementList[0] = replacement;
        boolean insertedIgnored = false;
        for (int i = 1; i < size; i++) {
            int kind = data.consumeInt(0, 2);
            if (kind == 0 || !insertedIgnored) {
                replacementList[i] = null;
                insertedIgnored = true;
            } else {
                replacementList[i] = data.consumeString(4);
            }
        }
        return replacementList;
    }

    private static void checkFilteredIgnoredPairsOracle(String text, String[] searchList, String[] replacementList) {
        if (text == null || searchList == null || replacementList == null) {
            return;
        }
        if (searchList.length != replacementList.length || searchList.length < 2) {
            return;
        }

        List<String> filteredSearch = new ArrayList<String>();
        List<String> filteredReplacement = new ArrayList<String>();
        boolean hadIgnoredPair = false;
        for (int i = 0; i < searchList.length; i++) {
            String s = searchList[i];
            String r = replacementList[i];
            if (s == null || s.length() == 0 || r == null) {
                hadIgnoredPair = true;
                continue;
            }
            filteredSearch.add(s);
            filteredReplacement.add(r);
        }
        if (!hadIgnoredPair) {
            return;
        }

        String lhs;
        String rhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
            return;
        }

        try {
            rhs = StringUtils.replaceEach(
                    text,
                    filteredSearch.toArray(new String[filteredSearch.size()]),
                    filteredReplacement.toArray(new String[filteredReplacement.size()]));
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
            return;
        }

        try {
            String sanity = StringUtils.replaceEach(text, new String[] {searchList[0]}, new String[] {replacementList[0]});
            if (sanity == null && text != null) {
                return;
            }
        } catch (RuntimeException t) {
            swallowUnlessOracle(t);
            return;
        }

        /*
         * Contract asserted by tests and visible guard logic in replaceEach:
         * entries with null search strings, empty search strings, or null replacement strings
         * are skipped ("continue"), so removing those ignored pairs must not change the result.
         * A patch that merely suppresses the crash by returning a hard-coded value, or by making
         * the branch unreachable, violates this relation without throwing.
         */
        if (!Objects.equals(lhs, rhs)) {
            throw new RuntimeException(
                    "[oracle:ignored-pairs] metamorphic violation: removing ignored null/empty pairs changed result"
                            + " input=" + String.valueOf(text)
                            + " lhs=" + String.valueOf(lhs)
                            + " rhs=" + String.valueOf(rhs));
        }
    }

    private static void swallowUnlessOracle(RuntimeException t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return;
        }
        if (isOracleFailure(t)) {
            throw t;
        }
        if (isRelevantRootCause(t)) {
            return;
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t != null && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "replaceEach".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "length".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
