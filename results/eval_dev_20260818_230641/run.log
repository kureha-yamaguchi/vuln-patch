package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (Throwable t) {
            if (isOracleViolation(t)) {
                throw (RuntimeException) t;
            }
        }

        try {
            runExplore(data);
        } catch (Throwable t) {
            if (isOracleViolation(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day left = new Day(19, 8, 2005);
        Day right = new Day(31, 1, 2006);
        s.add(left, 1);
        s.add(right, 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        verifyGapCopyMustBeEmpty(s, left, right, start, end, null, "anchor");
        verifySingletonOverloadAgreement(s, 0, "anchor-left");
        verifySingletonOverloadAgreement(s, 1, "anchor-right");
    }

    private static void runExplore(FuzzedDataProvider data) throws CloneNotSupportedException {
        String name = data.consumeString(32);
        TimeSeries s = new TimeSeries(name == null ? "S" : name);

        int baseYear = 1900 + data.consumeInt(0, 199);
        int baseMonth = data.consumeInt(1, 12);
        int baseDay = data.consumeInt(1, 28);
        Day left;
        try {
            left = new Day(baseDay, baseMonth, baseYear);
        } catch (RuntimeException e) {
            return;
        }

        int gapWidth = data.consumeInt(2, 90);
        Day right = addDays(left, gapWidth);
        if (right == null) {
            return;
        }

        try {
            s.add(left, Integer.valueOf(data.consumeInt()));
            s.add(right, Integer.valueOf(data.consumeInt()));
        } catch (RuntimeException e) {
            return;
        }

        int suffixCount = data.consumeInt(0, 6);
        Day cursor = right;
        for (int i = 0; i < suffixCount; i++) {
            int step = data.consumeInt(1, 40);
            cursor = addDays(cursor, step);
            if (cursor == null) {
                return;
            }
            try {
                s.add(cursor, Integer.valueOf(data.consumeInt()));
            } catch (RuntimeException e) {
                return;
            }
