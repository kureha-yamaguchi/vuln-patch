private static void verifyGapInputAndCopy(TimeSeries series, Day left, Day right, Day start, Day end,
            FuzzedDataProvider data) throws CloneNotSupportedException {
        if (series == null || start == null || end == null || left == null || right == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        int manualCount = countItemsInInclusiveRange(series, start, end);

        if (manualCount != 0) {
            throw new RuntimeException(
                    "[oracle:gap-shape] metamorphic violation: constructed ordered range lies inside a real gap so it must contain no source items"
                            + " manualCount=" + manualCount
                            + " start=" + start
                            + " end=" + end);
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException(
                    "[oracle:gap-absent] metamorphic violation: both endpoints chosen strictly inside the gap must be absent"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:gap-accept] metamorphic violation: valid ordered non-null periods wholly inside a real gap must not be rejected"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            throw e;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by
         * ordered, non-null periods. When no source items lie in [start,end], the copied subseries
         * must be empty. A throw-deleting or bookkeeping-skipping patch can avoid the historical
         * exception yet still return the wrong non-empty series, so we assert observable emptiness
         * through the public API after the real library call.
         */
        assertEmptySeries(copy, "gap-empty", start, end);

        Day innerStart = start;
        Day innerEnd = end;
        if (data != null && start.compareTo(end) < 0) {
            int outerStartOffset = daysBetween(left, start);
            int outerEndOffset = daysBetween(left, end);
            if (outerStartOffset <= outerEndOffset) {
                int innerStartOffset = data.consumeInt(outerStartOffset, outerEndOffset);
                int innerEndOffset = data.consumeInt(innerStartOffset, outerEndOffset);
                Day s = addDays(left, innerStartOffset);
                Day e = addDays(left, innerEndOffset);
                if (s != null && e != null) {
                    innerStart = s;
                    innerEnd = e;
                }
            }
        }

        try {
            TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
            assertEmptySeries(innerCopy, "subgap-empty", innerStart, innerEnd);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:subgap-accept] metamorphic violation: any ordered non-null subrange within the same real gap must also be accepted"
                                + " outer=[" + start + "," + end + "]"
                                + " inner=[" + innerStart + "," + innerEnd + "]",
                        e);
            }
            throw e;
        }

        if (series.getItemCount() > 0) {
            int chosen = (data == null) ? 0 : data.consumeInt(0, series.getItemCount() - 1);
            RegularTimePeriod exact = series.getTimePeriod(chosen);
            try {
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree on an exact existing item",
                            e);
                }
                throw e;
            }
        }

        checkBoundaryStepRight(series, start, right);
        checkBoundaryStepLeft(series, left, end);
