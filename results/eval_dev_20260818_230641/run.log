                if (!sameDouble(size1, size2)) {
                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: getSize must be idempotent for whole-space leaf input=" + attribute + " lhs=" + size1 + " rhs=" + size2);
                }
