public class FuzzHarness {
    private static Number parseOrReject(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal left = toBigDecimal(a);
        BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static void checkEquivalentScientificNotation(String a, String b, String oracleId) {
        Number left = parseOrReject(a);
        Number right = parseOrReject(b);
        if (left == null || right == null) {
            return;
        }
        if (!sameNumericValue(left, right)) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                    + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
        }
    }

    private static String digitsFromAscii(String raw, boolean forceNonZero) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + (c & 7)));
            }
        }
        if (sb.length() == 0) {
            sb.append('0');
        }
        if (forceNonZero) {
            boolean allZero = true;
            for (int i = 0; i < sb.length(); i++) {
                if (sb.charAt(i) != '0') {
                    allZero = false;
                    break;
                }
            }
            if (allZero) {
                sb.setCharAt(sb.length() - 1, '1');
            }
        }
        return sb.toString();
    }

