package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();
        touchLength(data);
        runExploreCrash(data);
        runOracle(data);
    }

    private static void runAnchorChecks() {
        try {
            StringUtils.replaceEach(null, new String[] {"a"}, new String[] {"b"});
            StringUtils.replaceEach("aba", null, null);
            StringUtils.replaceEach("aba", new String[0], null);
            StringUtils.replaceEach("aba", null, new String[0]);
            StringUtils.replaceEach("aba", new String[] {"a"}, null);

            StringUtils.replaceEach("aba", new String[] {null}, new String[] {"a"});
            StringUtils.replaceEach("aba", new String[] {"a"}, new String[] {null});
            StringUtils.replaceEach("aba", new String[] {"a", "b"}, new String[] {"c", null});
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void touchLength(FuzzedDataProvider data) {
        String s1 = data.consumeBoolean() ? null : data.consumeString(32);
        String s2 = data.consumeBoolean() ? null : data.consumeAsciiString(32);

        int l1 = StringUtils.length(s1);
        int l2 = StringUtils.length(s2);

        if (s1 == null && l1 != 0) {
            throw new RuntimeException("[oracle:length-null] metamorphic violation: length(null) must be 0 input=null lhs=" + l1 + " rhs=0");
        }
        if (s1 != null && l1 != s1.length()) {
            throw new RuntimeException("[oracle:length-java] metamorphic violation: StringUtils.length(s) must equal s.length() input=" + s1 + " lhs=" + l1 + " rhs=" + s1.length());
        }
        if (s2 == null && l2 != 0) {
            throw new RuntimeException("[oracle:length-null2] metamorphic violation: length(null) must be 0 input=null lhs=" + l2 + " rhs=0");
        }
        if (s2 != null && l2 != s2.length()) {
            throw new RuntimeException("[oracle:length-java2] metamorphic violation: StringUtils.length(s) must equal s.length() input=" + s2 + " lhs=" + l2 + " rhs=" + s2.length());
        }
    }

    private static void runExploreCrash(FuzzedDataProvider data) {
        int n = data.consumeInt(1, 4);
        String[] search = new String[n];
        String[] repl = new String[n];

        int matchedIndex = data.consumeInt(0, n - 1);
        int nullIndex = data.consumeInt(0, n - 1);

        String token = nonEmptyAscii(data.consumeAsciiString(8), "A");
        String prefix = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);
        String text = prefix + token + suffix;

        for (int i = 0; i < n; i++) {
            if (i == matchedIndex) {
                search[i] = token;
                repl[i] = data.consumeBoolean() ? data.consumeAsciiString(8) : "";
            } else if (i == nullIndex) {
                if (data.consumeBoolean()) {
                    search[i] = nonEmptyAscii(data.consumeAsciiString(8), "B");
                    repl[i] = null;
                } else {
                    search[i] = null;
                    repl[i] = data.consumeAsciiString(8);
                }
            } else {
                search[i] = maybeNonMatchingToken(data, token);
                repl[i] = data.consumeAsciiString(8);
            }
        }

        try {
            StringUtils.replaceEach(text, search, repl);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runOracle(FuzzedDataProvider data) {
        int baseLen = data.consumeInt(1, 3);
        String[] baseSearch = new String[baseLen];
        String[] baseRepl = new String[baseLen];

        int matchedIndex = data.consumeInt(0, baseLen - 1);
        String token = nonEmptyAscii(data.consumeAsciiString(6), "X");
        String text = data.consumeAsciiString(8) + token + data.consumeAsciiString(8);

        for (int i = 0; i < baseLen; i++) {
            if (i == matchedIndex) {
                baseSearch[i] = token;
                baseRepl[i] = data.consumeAsciiString(6);
            } else {
                baseSearch[i] = maybeNonMatchingToken(data, token);
                baseRepl[i] = data.consumeAsciiString(6);
            }
        }

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, baseSearch, baseRepl);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCause(t)) {
                return;
            }
            return;
        }

        String[] augSearch = new String[baseLen + 1];
        String[] augRepl = new String[baseLen + 1];
        System.arraycopy(baseSearch, 0, augSearch, 0, baseLen);
        System.arraycopy(baseRepl, 0, augRepl, 0, baseLen);

        if (data.consumeBoolean()) {
            augSearch[baseLen] = null;
            augRepl[baseLen] = data.consumeAsciiString(6);
        } else {
            augSearch[baseLen] = nonEmptyAscii(maybeNonMatchingToken(data, token), "Y");
            augRepl[baseLen] = null;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, augSearch, augRepl);
        } catch (RuntimeException t) {
            return;
        }

        /*
         * Contract asserted from the public StringUtils tests shown in the bug report:
         * null search strings and null replacement strings are ignored
         * (e.g. replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba",
         *  replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba").
         * Therefore, adding one extra ignored null-bearing pair must not change the result.
         * A throw-deleting or branch-skipping patch could avoid the crash but silently stop
         * honoring that behavior; this relation catches such wrong outputs.
         */
        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:null-ignore] metamorphic violation: adding an ignored null-bearing rule changed replaceEach result input="
                    + text + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String nonEmptyAscii(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static String maybeNonMatchingToken(FuzzedDataProvider data, String avoid) {
        String s = nonEmptyAscii(data.consumeAsciiString(6), "Z");
        if (s.equals(avoid)) {
            s = s + "_";
        }
        return s;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
