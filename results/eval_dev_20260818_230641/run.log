    private static void anchorMetamorphicCheck() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        Day existingLeft = new Day(19, 8, 2005);
        Day existingRight = new Day(31, 1, 2006);
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

