package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        String text = data.consumeBoolean() ? null : data.consumeString(32);
        int n = data.consumeInt(1, 6);
        String[] searchList = new String[n];
        String[] replacementList = new String[n];

        boolean injectedInvalid = false;
        for (int i = 0; i < n; i++) {
            int searchKind = data.consumeInt(0, 4);
            if (searchKind == 0) {
                searchList[i] = null;
                injectedInvalid = true;
            } else if (searchKind == 1) {
                searchList[i] = "";
                injectedInvalid = true;
            } else if (searchKind == 2) {
                searchList[i] = "a";
            } else if (searchKind == 3) {
                searchList[i] = "b";
            } else {
                searchList[i] = data.consumeString(4);
                if (StringUtils.length(searchList[i]) == 0) {
                    injectedInvalid = true;
                }
            }

            int replKind = data.consumeInt(0, 3);
            if (replKind == 0) {
                replacementList[i] = null;
                injectedInvalid = true;
            } else if (replKind == 1) {
                replacementList[i] = "";
            } else if (replKind == 2) {
                replacementList[i] = data.consumeString(4);
            } else {
                replacementList[i] = data.consumeAsciiString(4);
            }
        }

        if (!injectedInvalid && n > 0) {
            replacementList[data.consumeInt(0, n - 1)] = null;
            injectedInvalid = true;
        }

        tryReplaceEach(text, searchList, replacementList);

        if (text != null) {
            String prefix = data.consumeString(8);
            String suffix = data.consumeString(8);
            String composite = prefix + text + suffix;
            String[] search2 = cloneArray(searchList);
            String[] repl2 = cloneArray(replacementList);
            tryOracleIgnoreInvalidPairs(composite, search2, repl2);
        }

        tryOracleIgnoreInvalidPairs(text, searchList, replacementList);
    }

    private static void exerciseAnchor() {
        tryReplaceEach(null, new String[] { "a" }, new String[] { "b" });
        tryReplaceEach("aba", null, null);
        tryReplaceEach("aba", new String[0], null);
        tryReplaceEach("aba", null, new String[0]);
        tryReplaceEach("aba", new String[] { "a" }, null);
        tryReplaceEach("aba", new String[] { null }, new String[] { "a" });
        tryReplaceEach("aba", new String[] { "a" }, new String[] { null });
        tryReplaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null });

        tryOracleIgnoreInvalidPairs("aba", new String[] { "a" }, new String[] { null });
        tryOracleIgnoreInvalidPairs("aba", new String[] { null }, new String[] { "a" });
        tryOracleIgnoreInvalidPairs("aba", new String[] { "a", "b" }, new String[] { "c", null });
    }

    private static void tryReplaceEach(String text, String[] searchList, String[] replacementList) {
        try {
            StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void tryOracleIgnoreInvalidPairs(String text, String[] searchList, String[] replacementList) {
        if (searchList == null || replacementList == null || searchList.length != replacementList.length) {
            return;
        }

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String[] filteredSearch = filterSearch(searchList, replacementList);
        String[] filteredReplacement = filterReplacement(searchList, replacementList);

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract used for this oracle:
         * The method's own matching logic skips any pair where searchList[i] is null,
         * searchList[i] has length 0, or replacementList[i] is null. The documented
         * tests also require these entries to be ignored:
         *   replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba"
         *   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
         *   replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc"
         * Therefore, removing all such ignored pairs before the call must not change
         * the observable result for any correct implementation.
         */
        if (!eq(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:ignore-invalid-pairs] metamorphic violation: replaceEach must ignore pairs with null/empty search or null replacement"
                    + " input=" + String.valueOf(text)
                    + " lhs=" + String.valueOf(lhs)
                    + " rhs=" + String.valueOf(rhs)
                    + " search=" + ArrayUtils.toString(searchList)
                    + " repl=" + ArrayUtils.toString(replacementList)
                    + " filteredSearch=" + ArrayUtils.toString(filteredSearch)
                    + " filteredRepl=" + ArrayUtils.toString(filteredReplacement));
        }
    }

    private static String[] filterSearch(String[] searchList, String[] replacementList) {
        int count = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (isKeptPair(searchList[i], replacementList[i])) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (isKeptPair(searchList[i], replacementList[i])) {
                out[j++] = searchList[i];
            }
        }
        return out;
    }

    private static String[] filterReplacement(String[] searchList, String[] replacementList) {
        int count = 0;
        for (int i = 0; i < replacementList.length; i++) {
            if (isKeptPair(searchList[i], replacementList[i])) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < replacementList.length; i++) {
            if (isKeptPair(searchList[i], replacementList[i])) {
                out[j++] = replacementList[i];
            }
        }
        return out;
    }

    private static boolean isKeptPair(String search, String replacement) {
        return search != null && StringUtils.length(search) != 0 && replacement != null;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())) {
                if ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName())) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean eq(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String[] cloneArray(String[] in) {
        if (in == null) {
            return null;
        }
        String[] out = new String[in.length];
        for (int i = 0; i < in.length; i++) {
            out[i] = in[i];
        }
        return out;
    }
}
