package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", true);

        String explored = buildThreeCharNonYesInput(data);
        invokeRealEntryPoint(explored, true);

        String alt = buildThreeCharNonYesInputVariant(data);
        invokeRealEntryPoint(alt, true);

        /*
         * Contract/oracle:
         * BooleanUtils.toBoolean(String) is content-based, not identity-based:
         * the implementation checks characters of the provided String, so two
         * equal-content Strings must produce the same boolean result.
         * A patch that only suppresses the crash or special-cases one object
         * instance could violate this without throwing.
         */
        checkEqualContentOracle(explored);

        /*
         * Contract/oracle:
         * For any 3-character string whose first character is neither 'y' nor 'Y',
         * the shown implementation has no accepting branch in case 3, so a correct
         * implementation must return false rather than true. Deleting the crashing
         * access and accidentally returning true would violate this observable result.
         */
        checkThreeCharNonYesReturnsFalse(explored);
        checkThreeCharNonYesReturnsFalse(alt);

        String maybeTruthy = buildTruthyTokenVariant(data);
        checkTruthyCaseOracle(maybeTruthy);
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (shouldPropagate(t, validByConstruction)) {
                throw t;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void checkThreeCharNonYesReturnsFalse(String s) {
        if (s == null || s.length() != 3) {
            return;
        }
        char ch = s.charAt(0);
        if (ch == 'y' || ch == 'Y') {
            return;
        }
        try {
            boolean result = BooleanUtils.toBoolean(s);
            if (result) {
                throw new RuntimeException("[oracle:3char-false] metamorphic violation: non-'y'/'Y' 3-char token must parse as false input=" + quote(s) + " lhs=" + result + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyCaseOracle(String s) {
        if (s == null) {
            return;
        }
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:truthy-eq] metamorphic violation: equal-content truthy candidate strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (isKnownTruthyToken(s) && !lhs) {
                throw new RuntimeException("[oracle:truthy-case] metamorphic violation: accepted truthy token must parse as true input=" + quote(s) + " lhs=" + lhs + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static String buildThreeCharNonYesInput(FuzzedDataProvider data) {
        String base = data.consumeString(3);
        char c0 = pickNonYesChar(base.length() > 0 ? base.charAt(0) : (char) ('a' + Math.floorMod(data.consumeInt(), 26)));
        char c1 = base.length() > 1 ? base.charAt(1) : (char) ('a' + Math.floorMod(data.consumeInt(), 26));
        char c2 = base.length() > 2 ? base.charAt(2) : (char) ('a' + Math.floorMod(data.consumeInt(), 26));
        return new String(new char[] { c0, c1, c2 });
    }

    private static String buildThreeCharNonYesInputVariant(FuzzedDataProvider data) {
        String base = data.consumeAsciiString(8);
        char c0 = pickNonYesChar(base.length() > 0 ? base.charAt(0) : (char) ('A' + Math.floorMod(data.consumeInt(), 26)));
        char c1 = base.length() > 1 ? base.charAt(base.length() / 2) : (char) ('0' + Math.floorMod(data.consumeInt(), 10));
        char c2 = base.length() > 2 ? base.charAt(base.length() - 1) : (char) ('!' + Math.floorMod(data.consumeInt(), 15));
        return new String(new char[] { c0, c1, c2 });
    }

    private static String buildTruthyTokenVariant(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String token = which == 0 ? "on" : (which == 1 ? "yes" : "true");
        char[] chars = token.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            boolean upper = data.consumeBoolean();
            chars[i] = upper ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static boolean isKnownTruthyToken(String s) {
        return "on".equalsIgnoreCase(s) || "yes".equalsIgnoreCase(s) || "true".equalsIgnoreCase(s);
    }

    private static char pickNonYesChar(char c) {
        if (c == 'y' || c == 'Y') {
            return 'o';
        }
        return c;
    }

    private static boolean shouldPropagate(RuntimeException t, boolean validByConstruction) {
        if (isCleanRejection(t) && !validByConstruction) {
            return false;
        }
        if (isOracleSignal(t)) {
            return true;
        }
        return isRootCause(t);
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.contains("invalid") || lower.contains("validation")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof StringIndexOutOfBoundsException && hasRelevantFrame(cur)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
