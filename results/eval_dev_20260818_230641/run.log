                    if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                        c = 'C';
                    }
                    middle.append(c);
                }
            }

            String input = prefix.toString() + middle.toString() + suffix.toString();

            String out;
            try {
                out = StringEscapeUtils.escapeCsv(input);
            } catch (RuntimeException t) {
                boolean isRootCause = t instanceof StringIndexOutOfBoundsException;
                if (isRootCause) {
                    boolean reachable = false;
