package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String s : anchors) {
            try {
                String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return the input unchanged when it contains no comma, quote, CR, or LF input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
            }
        }

        int pairs = data.consumeInt(1, 8);
