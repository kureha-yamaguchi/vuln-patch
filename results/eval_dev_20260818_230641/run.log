                                + numeric
                                + " lower=" + lower
                                + " upper=" + upper
                                + " unsuffixed=" + unsuffixed
                                + " helper=" + helperLong);
            }
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                throw new RuntimeException(
                        "[oracle:plus-signed-long-rejection] metamorphic violation: helper-valid plus-signed decimal with explicit l/L suffix must not be rejected input="
                                + numeric,
