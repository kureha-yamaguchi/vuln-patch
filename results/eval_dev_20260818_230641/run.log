package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // For a PolygonsSet backed by a leaf BSPTree (getCut() == null), computeGeometricalProperties()
        // explicitly sets:
        //   - size = +Infinity and barycenter = NaN when attribute is Boolean.TRUE
        //   - size = 0 and barycenter = (0, 0) when attribute is Boolean.FALSE
        // A "fix" that merely suppresses the crash or skips the bookkeeping would violate these
        // observable post-conditions. Repeated reads must also be idempotent.

        // ANCHOR: exercise the root-cause property with the real library classes first.
        // Leaf tree + non-Boolean attribute reaches the cast site in computeGeometricalProperties
        // through getSize()/getBarycenter().
        try {
            exerciseAndCheck(new BoundaryAttribute<Euclidean2D>(null, null));
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // VALID-BY-CONSTRUCTION checks that must hold on every correct implementation.
        try {
            exerciseAndCheck(Boolean.TRUE);
            exerciseAndCheck(Boolean.FALSE);
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                // Unexpected but outside the patch scope.
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // EXPLORE: many real leaf-tree attributes satisfying the same root-cause property
        // (null cut, attribute not guaranteed to be Boolean), plus some Boolean controls.
        int rounds = 1 + Math.max(0, Math.min(16, data.remainingBytes()));
        for (int i = 0; i < rounds; i++) {
            Object attribute = makeAttribute(data);
            try {
                exerciseAndCheck(attribute);
            } catch (RuntimeException t) {
                if (isOracleFailure(t) || isRootCause(t)) {
                    throw t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
            } catch (Error t) {
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static Object makeAttribute(FuzzedDataProvider data) {
        int choice = data.consumeInt(0, 7);
        switch (choice) {
            case 0:
                return Boolean.TRUE;
            case 1:
                return Boolean.FALSE;
            case 2:
                return new BoundaryAttribute<Euclidean2D>(null, null);
            case 3:
                return Integer.valueOf(data.consumeInt());
            case 4:
                return Byte.valueOf(data.consumeByte());
            case 5:
                return data.consumeAsciiString(32);
            case 6:
                return data.consumeString(32);
            default:
                return data.consumeBoolean() ? new BoundaryAttribute<Euclidean2D>(null, null) : Integer.valueOf(0);
        }
    }

    private static void exerciseAndCheck(Object attribute) {
        PolygonsSet poly = new PolygonsSet(new BSPTree<Euclidean2D>(attribute));

        double size1;
        Object bary1;
        double size2;
        Object bary2;

        try {
            size1 = poly.getSize();
            bary1 = poly.getBarycenter();
            size2 = poly.getSize();
            bary2 = poly.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t) || isCleanRejection(t)) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (attribute instanceof Boolean) {
            boolean inside = ((Boolean) attribute).booleanValue();

            if (inside) {
                if (!Double.isInfinite(size1) || size1 <= 0.0) {
                    throw new RuntimeException("[oracle:leaf-geom] metamorphic violation: whole-space leaf must have infinite size input=" + attribute + " lhs=" + size1 + " rhs=+Inf");
