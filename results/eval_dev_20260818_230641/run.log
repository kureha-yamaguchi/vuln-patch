    private static String makeMixedCase(String token, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer(token.length());
        boolean changed = false;
        for (int i = 0; i < token.length(); i++) {
            char ch = token.charAt(i);
            boolean upper = data.consumeBoolean();
            char out = upper ? Character.toUpperCase(ch) : Character.toLowerCase(ch);
            if (out != ch) {
                changed = true;
            }
            sb.append(out);
        }
        if (!changed && token.length() > 0) {
            char ch0 = sb.charAt(0);
            sb.setCharAt(0, Character.isUpperCase(ch0) ? Character.toLowerCase(ch0) : Character.toUpperCase(ch0));
        }
        return sb.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
