package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String generated = buildSafeCsvIdentityString(data);
        runCase(generated);

        int extraCases = data.consumeInt(0, 4);
        for (int i = 0; i < extraCases; i++) {
            runCase(buildSafeCsvIdentityString(data));
        }
    }

    private static void runAnchor() {
        runCase("\uD83D\uDE30");
        runCase("\uD800\uDC00");
        runCase("\uD834\uDD1E");
        runCase("\uDBFF\uDFFD");
    }

    private static void runCase(String input) {
        try {
            String out = StringEscapeUtils.ESCAPE_CSV.translate(input);

            /*
             * Contract used for this oracle:
             * CSV escaping only adds quotes/escapes "if required"; for inputs with no comma,
             * quote, CR, or LF, the result must remain unchanged. We construct such inputs
             * from benign ASCII plus valid supplementary code points, so a correct
             * implementation is obliged to accept them and preserve them exactly.
             * A "fix" that merely suppresses the crash by skipping bookkeeping/output would
             * violate this observable identity post-condition.
             */
            if (!input.equals(out)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: safe CSV input must be unchanged input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
