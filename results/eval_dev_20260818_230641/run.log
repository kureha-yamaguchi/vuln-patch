package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorInputs();

        int pairs = data.consumeInt(1, 6);
        String text = data.consumeString(64);

        String[] search = new String[pairs];
        String[] replacement = new String[pairs];

        boolean ensuredInteresting = false;
        for (int i = 0; i < pairs; i++) {
            boolean makeSearchNull = data.consumeBoolean();
            boolean makeReplacementNull = data.consumeBoolean();
            boolean makeSearchEmpty = data.consumeBoolean();

            if (makeSearchNull) {
                search[i] = null;
            } else if (makeSearchEmpty) {
                search[i] = "";
            } else {
                search[i] = data.consumeString(8);
            }

            if (makeReplacementNull) {
                replacement[i] = null;
            } else {
                replacement[i] = data.consumeString(8);
            }

            if (search[i] == null || replacement[i] == null || search[i].length() == 0) {
                ensuredInteresting = true;
            }
        }

        if (!ensuredInteresting) {
            int idx = data.consumeInt(0, pairs - 1);
            if (data.consumeBoolean()) {
                search[idx] = null;
            } else {
                replacement[idx] = null;
            }
        }

        int validCount = 0;
        for (int i = 0; i < pairs; i++) {
            if (search[i] != null && search[i].length() > 0 && replacement[i] != null) {
                validCount++;
            }
        }

        String[] sanitizedSearch = new String[validCount];
        String[] sanitizedReplacement = new String[validCount];
        int out = 0;
        for (int i = 0; i < pairs; i++) {
            if (search[i] != null && search[i].length() > 0 && replacement[i] != null) {
                sanitizedSearch[out] = search[i];
                sanitizedReplacement[out] = replacement[i];
                out++;
            }
        }

        tryMetamorphicIgnoreNullAndEmpty(text, search, replacement, sanitizedSearch, sanitizedReplacement);
    }

    private static void runAnchorInputs() {
        assertExpected(null, new String[] { "a" }, new String[] { "b" }, null);
        assertExpected("aba", null, null, "aba");
        assertExpected("aba", new String[0], null, "aba");
        assertExpected("aba", null, new String[0], "aba");
        assertExpected("aba", new String[] { "a" }, null, "aba");
        assertExpected("aba", new String[] { null }, new String[] { "a" }, "aba");
        assertExpected("aba", new String[] { "a" }, new String[] { null }, "aba");
        assertExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc");
    }

    private static void assertExpected(String text, String[] search, String[] replacement, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, search, replacement);
            if (expected == null ? actual != null : !expected.equals(actual)) {
                throw new RuntimeException(
                    "[oracle:anchor] metamorphic violation: documented replaceEach examples disagree input="
                        + String.valueOf(text)
                        + " search="
                        + ArrayUtils.toString(search)
                        + " replacement="
                        + ArrayUtils.toString(replacement)
                        + " lhs="
                        + String.valueOf(actual)
                        + " rhs="
                        + String.valueOf(expected));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void tryMetamorphicIgnoreNullAndEmpty(
        String text,
        String[] search,
        String[] replacement,
        String[] sanitizedSearch,
        String[] sanitizedReplacement) {

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, sanitizedSearch, sanitizedReplacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract/oracle:
         * In replaceEach's own search loops, entries with searchList[i] == null,
         * searchList[i].length() == 0, or replacementList[i] == null are skipped.
         * Therefore adding or removing only such inert entries must not change the
         * observable result. A throw-deleting or branch-skipping patch could silently
         * produce a different replacement result while no exception fires.
         */
        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "[oracle:ignore-null-empty] metamorphic violation: removing inert null/empty entries changed result input="
                    + String.valueOf(text)
                    + " search="
                    + ArrayUtils.toString(search)
                    + " replacement="
                    + ArrayUtils.toString(replacement)
                    + " lhs="
                    + String.valueOf(lhs)
                    + " rhs="
                    + String.valueOf(rhs));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
