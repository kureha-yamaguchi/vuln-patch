package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            throw e;
        } catch (CloneNotSupportedException e) {
            return;
        } catch (Throwable t) {
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            Day left = dayFromEpochDay(leftEpochDay);
            Day right = dayFromEpochDay(rightEpochDay);

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpochDay - i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(dayFromEpochDay(rightEpochDay + i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            if (start == null || end == null || start.compareTo(end) > 0) {
                return;
            }

            int manualCount = 0;
            int rawStartIndex;
            int rawEndIndex;
            try {
                for (int i = 0; i < series.getItemCount(); i++) {
                    RegularTimePeriod p = series.getTimePeriod(i);
                    if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                        manualCount++;
                    }
                    if (series.getIndex(p) != i) {
                        throw new RuntimeException(
                                "[oracle:index-roundtrip] metamorphic violation: getIndex/getTimePeriod disagree"
                                        + " index=" + i
                                        + " roundTrip=" + series.getIndex(p)
                                        + " period=" + p);
                    }
                }
                rawStartIndex = series.getIndex(start);
                rawEndIndex = series.getIndex(end);
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            if (manualCount != 0) {
                throw new RuntimeException(
                        "[oracle:constructed-gap] metamorphic violation: chosen range must lie strictly inside a real gap"
                                + " manualCount=" + manualCount
                                + " start=" + start
                                + " end=" + end);
            }
            if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
                throw new RuntimeException(
                        "[oracle:gap-absent] metamorphic violation: both gap endpoints must be absent"
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex
                                + " start=" + start
                                + " end=" + end);
            }

            int computedStartIndex = insertionPoint(rawStartIndex);
            int computedEndIndex = insertionPoint(rawEndIndex) - 1;
            if (!(computedEndIndex < computedStartIndex)) {
                return;
            }

            try {
                /*
                 * Contract asserted:
                 * createCopy(start, end) accepts ordered, non-null periods and returns the inclusive
                 * subseries between them. For a range wholly inside a real gap, the inclusive subseries
                 * contains no source items, so the returned series must be empty. A throw-deleting patch
                 * or a patch that returns the wrong slice would violate this observable API post-condition.
                 */
                TimeSeries copy = series.createCopy(start, end);
                assertEmptySeries(copy, "gap-empty", start, end, rawStartIndex, rawEndIndex);

                Day innerStart = start;
                Day innerEnd = end;
                if (startOffset < endOffset) {
                    int innerStartOffset = data.consumeInt(startOffset, endOffset);
                    int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
                    innerStart = dayFromEpochDay(leftEpochDay + innerStartOffset);
                    innerEnd = dayFromEpochDay(leftEpochDay + innerEndOffset);
                }

                /*
                 * Metamorphic relation:
                 * any ordered subrange within the same real gap is also empty, so both createCopy calls
                 * must produce equivalent empty series.
                 */
                TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
                assertEmptySeries(innerCopy, "subgap-empty", innerStart, innerEnd, rawStartIndex, rawEndIndex);
                assertEquivalentSeries(copy, innerCopy, "same-gap-subrange", start, end, innerStart, innerEnd);

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton", exact, exact, exact, exact);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
