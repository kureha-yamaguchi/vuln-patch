    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean isValidationFamily(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Validation");
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        String base;
        switch (data.consumeInt(0, 2)) {
            case 0:
                base = "on";
                break;
            case 1:
                base = "yes";
                break;
            default:
                base = "true";
                break;
        }
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String pickObservedLiteral(FuzzedDataProvider data) {
        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true",
            "truE", "trUe", "trUE", "tRue", "tRuE", "tRUe", "tRUE",
            "TRUE", "TRUe", "TRuE", "TRue", "TrUE", "TrUe", "TruE", "True",
            "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES",
            "yes?", "tru"
        };
        return literals[data.consumeInt(0, literals.length - 1)];
    }

    private static String forceLength(String s, int len, char fill) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuffer b = new StringBuffer(s);
        while (b.length() < len) {
            b.append(fill);
        }
        return b.toString();
    }

    private static char safeChar(String s, int index, char dflt) {
        if (s == null || index < 0 || index >= s.length()) {
            return dflt;
        }
        return s.charAt(index);
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
