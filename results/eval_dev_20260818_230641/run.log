        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /*
             * Contract asserted: this parser is defined by String content, not object identity.
             * The implementation only special-cases the interned literal "true" as an optimization,
             * so equal-content distinct String instances must parse identically. A patch that merely
