package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        int choice = data.consumeInt(0, 6);
        String candidate;
        switch (choice) {
            case 0:
                candidate = buildLengthThreeCandidate(data);
                break;
            case 1:
                candidate = buildTruthyVariant("yes", data);
                break;
            case 2:
                candidate = buildTruthyVariant("true", data);
                break;
            case 3:
                candidate = buildTruthyVariant("on", data);
                break;
            case 4:
                candidate = data.consumeAsciiString(3);
                if (candidate.length() < 3) {
                    candidate = padToThree(candidate);
                } else if (candidate.length() > 3) {
                    candidate = candidate.substring(0, 3);
                }
                break;
            case 5:
                candidate = pickObservedLiteral(data);
                break;
            default:
                candidate = data.consumeString(8);
                break;
        }

        invokeRealEntryPoint(candidate, false);
        checkEqualContentOracle(candidate);

        String truthy = buildTruthyVariant(data.consumeBoolean() ? "yes" : (data.consumeBoolean() ? "true" : "on"), data);
        checkTruthyOracle(truthy);
    }

