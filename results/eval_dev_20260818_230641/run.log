package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String prefix = sanitizeCsvSafe(data.consumeString(16));
        String middle = sanitizeCsvSafe(data.consumeString(16));
        String suffix = sanitizeCsvSafe(data.consumeRemainingAsString());

        String pair = makeValidSurrogatePair(
                data.consumeInt(0xD800, 0xDBFF),
                data.consumeInt(0xDC00, 0xDFFF));

        String input;
        switch (data.consumeInt(0, 5)) {
            case 0:
                input = pair;
                break;
            case 1:
                input = prefix + pair;
                break;
            case 2:
                input = pair + suffix;
                break;
            case 3:
                input = prefix + pair + suffix;
                break;
            case 4:
                input = prefix + pair + middle + pair + suffix;
                break;
            default:
                input = prefix + middle + suffix + pair;
                break;
        }

        // Contract/oracle:
        // StringEscapeUtils.escapeCsv only escapes CSV-special content (comma, quote, CR, LF).
        // For strings built to contain none of those characters, a correct implementation must
        // return the input unchanged. This catches "fixes" that merely avoid the exception by
        // skipping or mangling surrogate-pair handling in CharSequenceTranslator.translate.
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                        "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                                + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static void runAnchor(String input) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                        "[oracle:csv-anchor-identity] metamorphic violation: anchor escapeCsv must preserve CSV-safe surrogate pair input="
                                + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("validation")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                sb.append('X');
            } else if (Character.isHighSurrogate(ch) || Character.isLowSurrogate(ch)) {
                sb.append('Y');
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String makeValidSurrogatePair(int high, int low) {
        return new String(new char[] { (char) high, (char) low });
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
