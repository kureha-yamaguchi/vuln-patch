package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseAndCheck(buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, false, false), true);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        int cases = data.consumeInt(1, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());
            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            boolean plusLeaf = data.consumeBoolean();
            boolean minusLeaf = data.consumeBoolean();

            try {
                PolygonsSet poly = buildRootCausePolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
                exerciseAndCheck(poly, false);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(
                    new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            double wholeSize = whole.getSize();
            Object wholeBc = whole.getBarycenter();
            if (!Double.isInfinite(wholeSize)
                    || !(wholeBc instanceof Vector2D)
                    || !Double.isNaN(((Vector2D) wholeBc).getX())
                    || !Double.isNaN(((Vector2D) wholeBc).getY())) {
                throw new RuntimeException("[oracle:whole-space] metamorphic violation: whole-space leaf must map to infinite size and NaN barycenter input=true lhs=size="
                        + wholeSize + ",bc=" + pointToString(wholeBc) + " rhs=expected(+INF,NaN,NaN)");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(
                    new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "valid-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exerciseAndCheck(PolygonsSet poly, boolean anchor) {
        try {
            poly.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = poly.getVertices();
            if (vertices != null && vertices.length == 0) {
                Object plusAttr = poly.getTree(false).getPlus() == null ? null : poly.getTree(false).getPlus().getAttribute();
                if (Boolean.TRUE.equals(plusAttr)) {
                    assertWholeGeometry(poly, anchor ? "anchor-whole" : "fuzz-whole");
                } else {
                    assertEmptyGeometry(poly, anchor ? "anchor-empty" : "fuzz-empty");
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static PolygonsSet buildRootCausePolygon(double x1, double y1, double x2, double y2,
                                                     boolean plusLeaf, boolean minusLeaf) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> plus =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.valueOf(plusLeaf));
        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> minus =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.valueOf(minusLeaf));
        org.apache.commons.math3.geometry.partitioning.BoundaryAttribute<Euclidean2D> attribute =
                new org.apache.commons.math3.geometry.partitioning.BoundaryAttribute<Euclidean2D>(null, null, null);
        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> root =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(
                        line.wholeHyperplane(), plus, minus, attribute);
        return new PolygonsSet(root);
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String tag) {
        double size = poly.getSize();
        Object bc = poly.getBarycenter();
        if (size != 0.0
                || !(bc instanceof Vector2D)
                || ((Vector2D) bc).getX() != 0.0
                || ((Vector2D) bc).getY() != 0.0) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: empty region with getVertices().length==0 and non-whole-space leaf must map to size 0 and barycenter (0,0) lhs=size="
                    + size + ",bc=" + pointToString(bc) + " rhs=expected(0.0,0.0,0.0)");
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String tag) {
        double size = poly.getSize();
        Object bc = poly.getBarycenter();
        if (!Double.isInfinite(size)
                || !(bc instanceof Vector2D)
                || !Double.isNaN(((Vector2D) bc).getX())
                || !Double.isNaN(((Vector2D) bc).getY())) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: whole-space case with getVertices().length==0 must map to infinite size and NaN barycenter lhs=size="
                    + size + ",bc=" + pointToString(bc) + " rhs=expected(+INF,NaN,NaN)");
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || hasClassName(t, "MathIllegalArgumentException")
                || hasClassName(t, "InvalidRepresentationException")
                || hasClassName(t, "NullArgumentException");
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof ClassCastException && inReachableRegion(t)) {
            return true;
        }
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean inReachableRegion(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)) {
                if ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "followLoop".equals(method)
                        || "getTree".equals(method)
                        || "isEmpty".equals(method)
                        || "getLine".equals(method)
                        || "toSpace".equals(method)
                        || "toSubSpace".equals(method)
                        || "getStart".equals(method)
                        || "getCut".equals(method)
                        || "visit".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean hasClassName(Throwable t, String simpleName) {
        Class<?> c = t.getClass();
        while (c != null) {
            if (simpleName.equals(c.getSimpleName())) {
                return true;
            }
            c = c.getSuperclass();
        }
        return false;
    }

    private static double finiteCoord(int x) {
        return (x % 2000001) / 1024.0;
    }

    private static String pointToString(Object p) {
        if (p instanceof Vector2D) {
            Vector2D v = (Vector2D) p;
            return "(" + v.getX() + "," + v.getY() + ")";
        }
        return String.valueOf(p);
    }
}
