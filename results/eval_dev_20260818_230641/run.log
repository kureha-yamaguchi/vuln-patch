package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final CharSequenceTranslator translator = StringEscapeUtils.ESCAPE_CSV;

        class Util {
            boolean isValidation(Throwable t) {
                for (Throwable cur = t; cur != null; cur = cur.getCause()) {
                    if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                        return true;
                    }
                    String name = cur.getClass().getName().toLowerCase();
                    if (name.contains("validation") || name.contains("invalid")) {
                        return true;
                    }
                }
                return false;
            }

            boolean hasRelevantFrame(Throwable t) {
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                            && "translate".equals(ste.getMethodName())) {
                        return true;
                    }
                }
                return false;
            }

            boolean isRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantFrame(t);
            }

            String sanitizeAscii(String s) {
                StringBuilder sb = new StringBuilder(s.length());
                for (int i = 0; i < s.length(); i++) {
                    char ch = s.charAt(i);
                    if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                        sb.append('A');
                    } else {
                        sb.append(ch);
                    }
                }
                return sb.toString();
            }

            String pairFor(int idx) {
                switch (idx & 3) {
                    case 0:
                        return "\uD83D\uDE30";
                    case 1:
                        return "\uD800\uDC00";
                    case 2:
                        return "\uD834\uDD1E";
                    default:
                        return "\uDBFF\uDFFD";
                }
            }

            String repr(String s) {
                StringBuilder sb = new StringBuilder();
                sb.append('"');
                for (int i = 0; i < s.length(); i++) {
                    char ch = s.charAt(i);
                    switch (ch) {
                        case '\\':
                            sb.append("\\\\");
                            break;
                        case '"':
                            sb.append("\\\"");
                            break;
                        case '\r':
                            sb.append("\\r");
                            break;
                        case '\n':
                            sb.append("\\n");
                            break;
                        default:
                            if (ch < 0x20 || Character.isSurrogate(ch)) {
                                String hex = Integer.toHexString(ch);
                                sb.append("\\u");
                                for (int j = hex.length(); j < 4; j++) {
                                    sb.append('0');
                                }
                                sb.append(hex);
                            } else {
                                sb.append(ch);
                            }
                    }
                }
                sb.append('"');
                return sb.toString();
            }

            void exercise(String input) {
                try {
                    String out = translator.translate(input);

                    /*
                     * Contract asserted:
                     * Csv escaping leaves inputs unchanged when they contain none of the CSV
                     * trigger characters (comma, quote, CR, LF). Our generated inputs are
                     * valid-by-construction and contain only safe ASCII plus well-formed
                     * surrogate pairs, so a correct implementation must return the exact
                     * original string. A throw-deleting or bookkeeping-skipping patch could
                     * silently truncate or alter the output; this post-condition catches that.
                     */
                    if (!input.equals(out)) {
                        throw new RuntimeException(
                                "[oracle:csv-identity] metamorphic violation: no-CSV input must be unchanged input="
                                        + repr(input) + " lhs=" + repr(out) + " rhs=" + repr(input));
                    }
                } catch (Throwable t) {
                    if (isRootCause(t)) {
                        throw t instanceof RuntimeException ? (RuntimeException) t : new RuntimeException(t);
                    }
                    if (isValidation(t)) {
                        return;
                    }
                }
            }
        }

        Util util = new Util();

        String[] anchors = new String[] {
                "\uD83D\uDE30",
                "\uD800\uDC00",
                "\uD834\uDD1E",
                "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            util.exercise(anchors[i]);
        }

        String prefix = util.sanitizeAscii(data.consumeAsciiString(32));
        String middle = util.sanitizeAscii(data.consumeAsciiString(32));
        String suffix = util.sanitizeAscii(data.consumeAsciiString(32));

        String pair1 = util.pairFor(data.consumeInt(0, 3));
        String pair2 = util.pairFor(data.consumeInt(0, 3));
        String pair3 = util.pairFor(data.consumeInt(0, 3));

        String candidate;
        switch (data.consumeInt(0, 5)) {
            case 0:
                candidate = prefix + pair1 + suffix;
                break;
            case 1:
                candidate = pair1 + suffix;
                break;
            case 2:
                candidate = prefix + pair1;
                break;
            case 3:
                candidate = prefix + pair1 + middle + pair2 + suffix;
                break;
            case 4:
                candidate = pair1 + pair2 + pair3;
                break;
            default:
                candidate = prefix + pair1 + middle + pair2 + middle + pair3 + suffix;
                break;
        }

        util.exercise(candidate);
    }
}
