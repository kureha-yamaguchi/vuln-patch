package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String direct = forceLengthThree(data.consumeAsciiString(8));
        direct = forceNonYPrefix(direct, data.consumeBoolean());
        invokeRealEntryPoint(direct, false);

        String longer = data.consumeString(24);
        if (longer != null && longer.length() >= 3) {
            int start = data.consumeInt(0, longer.length() - 3);
            String window = longer.substring(start, start + 3);
            window = forceNonYPrefix(window, data.consumeBoolean());
            invokeRealEntryPoint(window, false);
        }

        String token = buildTruthyToken(data);
        checkTruthyOracle(token);

        String equalContentProbe = data.consumeBoolean() ? token : direct;
        checkEqualContentOracle(equalContentProbe);
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: BooleanUtils.toBoolean is defined by String content. The implementation only
               special-cases the interned literal "true" as an optimization, so equal-content distinct
               String instances must parse identically. A throw-deleting or representation-dependent patch
               would violate this observable API behavior without necessarily crashing. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract: this API accepts the documented truthy tokens "on", "yes", and "true"
               case-insensitively, as visible in the implementation. For a valid-by-construction mixed-case
               spelling of one of those literals, parsing must agree with the lowercase form and must be true.
               A patch that merely suppresses the crash by making a reachable branch return false would break this. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        String[] bases = new String[] { "on", "yes", "true" };
        String base = bases[data.consumeInt(0, bases.length - 1)];
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean()
                ? Character.toUpperCase(chars[i])
                : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static String forceLengthThree(String s) {
        if (s == null) {
            return "off";
        }
        if (s.length() == 3) {
            return s;
        }
        if (s.length() > 3) {
            return s.substring(0, 3);
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < 3) {
            sb.append((char) ('a' + sb.length()));
        }
        return sb.toString();
    }

    private static String forceNonYPrefix(String s, boolean useO) {
        char first = s.charAt(0);
        if (first == 'y' || first == 'Y') {
            char replacement = useO ? 'o' : 'x';
            return replacement + s.substring(1);
        }
        return s;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || hasValidationName(t);
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean hasValidationName(Throwable t) {
        Class<?> c = t.getClass();
        while (c != null) {
            String n = c.getName();
            if (n.contains("Validation")
                || n.contains("Invalid")
                || n.contains("Illegal")
                || n.contains("Malformed")
                || n.contains("Format")) {
                return true;
            }
            c = c.getSuperclass();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
