package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseAndCheck(buildRootCausePolygon(0.0, 0.0, 1.0, 0.0, true, false), true);
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());
            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            boolean plusLeaf = data.consumeBoolean();
            boolean minusLeaf = data.consumeBoolean();

            try {
                PolygonsSet poly = buildRootCausePolygon(x1, y1, x2, y2, plusLeaf, minusLeaf);
                exerciseAndCheck(poly, false);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "valid-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "valid-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static PolygonsSet buildRootCausePolygon(double x1, double y1, double x2, double y2,
                                                     boolean plusLeaf, boolean minusLeaf) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusLeaf));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusLeaf));
        BoundaryAttribute<Euclidean2D> attr = new BoundaryAttribute<Euclidean2D>(null, null);
        BSPTree<Euclidean2D> root = new BSPTree<Euclidean2D>(line.wholeHyperplane(), plus, minus, attr);
        return new PolygonsSet(root);
    }

    private static void exerciseAndCheck(PolygonsSet poly, boolean anchor) {
        try {
            poly.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = poly.getVertices();
            if (vertices == null) {
                return;
            }

            if (vertices.length == 0) {
                boolean plusInside = plusAttribute(poly);
                if (plusInside) {
                    assertWholeGeometry(poly, anchor ? "anchor-empty-whole" : "fuzz-empty-whole");
                } else {
                    assertEmptyGeometry(poly, anchor ? "anchor-empty-false" : "fuzz-empty-false");
                }
            }

            // Contract visible in computeGeometricalProperties(): for any successful call,
            // re-running it on the same region must preserve the observable geometry summary.
            // A throw-deleting or bookkeeping-skipping patch can violate this by leaving stale
            // size/barycenter state. Both sides use the real library code.
            double beforeSize = poly.getSize();
            Vector2D beforeBc = asVector(poly.getBarycenter());

            try {
                poly.computeGeometricalProperties();
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }

            double afterSize = poly.getSize();
            Vector2D afterBc = asVector(poly.getBarycenter());

            if (!sameDouble(beforeSize, afterSize) || !sameVector(beforeBc, afterBc)) {
                throw new RuntimeException("[oracle:idempotence] metamorphic violation: computeGeometricalProperties must be idempotent on the same region input="
                        + describe(poly) + " lhs=size=" + beforeSize + ",bc=" + pointToString(beforeBc)
                        + " rhs=size=" + afterSize + ",bc=" + pointToString(afterBc));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean plusAttribute(PolygonsSet poly) {
        BSPTree<Euclidean2D> tree = poly.getTree(false);
        BSPTree<Euclidean2D> plus = tree.getPlus();
        Object attr = plus == null ? null : plus.getAttribute();
        return Boolean.TRUE.equals(attr);
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String tag) {
        double size = poly.getSize();
        Vector2D bc = asVector(poly.getBarycenter());
        if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0)
                || bc == null
                || Double.doubleToLongBits(bc.getX()) != Double.doubleToLongBits(0.0)
                || Double.doubleToLongBits(bc.getY()) != Double.doubleToLongBits(0.0)) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: when getVertices().length==0 and plus leaf is false, computeGeometricalProperties must set size=0 and barycenter=(0,0) input="
                    + describe(poly) + " lhs=size=" + size + ",bc=" + pointToString(bc)
                    + " rhs=expected(0.0,(0.0,0.0))");
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String tag) {
        double size = poly.getSize();
        Vector2D bc = asVector(poly.getBarycenter());
        if (!Double.isInfinite(size)
                || bc == null
                || !Double.isNaN(bc.getX())
                || !Double.isNaN(bc.getY())) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: when getVertices().length==0 and plus leaf is true, computeGeometricalProperties must set size=+INF and barycenter=(NaN,NaN) input="
                    + describe(poly) + " lhs=size=" + size + ",bc=" + pointToString(bc)
                    + " rhs=expected(+INF,(NaN,NaN))");
        }
    }

    private static Vector2D asVector(Object p) {
        return (p instanceof Vector2D) ? (Vector2D) p : null;
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return true;
        }
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }

    private static double finiteCoord(int v) {
        return (v % 2000001) / 1000.0;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || hasNameFragment(t.getClass(), "Exception")
                   && (hasNameFragment(t.getClass(), "Invalid")
                       || hasNameFragment(t.getClass(), "NoData")
                       || hasNameFragment(t.getClass(), "Dimension")
                       || hasNameFragment(t.getClass(), "Argument")
                       || hasNameFragment(t.getClass(), "NumberIsToo")
                       || hasNameFragment(t.getClass(), "OutOfRange")
                       || hasNameFragment(t.getClass(), "NotPositive")
                       || hasNameFragment(t.getClass(), "Null"));
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(c)
                    && ("computeGeometricalProperties".equals(m)
                    || "getVertices".equals(m)
                    || "followLoop".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean hasNameFragment(Class<?> c, String fragment) {
        String n = c == null ? "" : c.getName();
        return n.contains(fragment);
    }

    private static String describe(PolygonsSet poly) {
        try {
            BSPTree<Euclidean2D> tree = poly.getTree(false);
            Object rootAttr = tree.getAttribute();
            Object plusAttr = tree.getPlus() == null ? null : tree.getPlus().getAttribute();
            Object minusAttr = tree.getMinus() == null ? null : tree.getMinus().getAttribute();
            boolean hasCut = tree.getCut() != null;
            Vector2D[][] vertices = null;
            try {
                vertices = poly.getVertices();
            } catch (RuntimeException ignored) {
            }
            return "hasCut=" + hasCut
                    + ",rootAttr=" + simple(rootAttr)
                    + ",plusAttr=" + simple(plusAttr)
                    + ",minusAttr=" + simple(minusAttr)
                    + ",vertices=" + verticesSummary(vertices);
        } catch (RuntimeException t) {
            return "describe-failed:" + t.getClass().getName();
        }
    }

    private static String verticesSummary(Vector2D[][] vertices) {
        if (vertices == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append(vertices.length).append(":[");
        for (int i = 0; i < vertices.length; i++) {
            if (i > 0) {
                sb.append(';');
            }
            Vector2D[] loop = vertices[i];
            if (loop == null) {
                sb.append("null");
                continue;
            }
            sb.append(loop.length).append('(');
            for (int j = 0; j < loop.length; j++) {
                if (j > 0) {
                    sb.append(',');
                }
                sb.append(pointToString(loop[j]));
            }
            sb.append(')');
        }
        sb.append(']');
        return sb.toString();
    }

    private static String pointToString(Object p) {
        if (!(p instanceof Vector2D)) {
            return String.valueOf(p);
        }
        Vector2D v = (Vector2D) p;
        return "(" + v.getX() + "," + v.getY() + ")";
    }

    private static String simple(Object o) {
        return o == null ? "null" : o.getClass().getSimpleName() + ":" + String.valueOf(o);
    }
}
