package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String explored = buildExplorationInput(data);
        runExploration(explored);
    }

    private static void runAnchor(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            assertIdentityForSafeCsvInput(s, out, "anchor");
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runExploration(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);

            /*
             * Contract/oracle:
             * escapeCsv only needs to quote/escape values containing CSV-special characters
             * (comma, quote, CR, LF). For inputs containing none of those characters, a correct
             * implementation must return the original input unchanged. Our explored inputs are
             * valid-by-construction: they are made only from safe ASCII plus valid UTF-16
             * surrogate pairs, so deleting/skipping the buggy bookkeeping can silently drop or
             * duplicate code units and violate this observable identity post-condition.
             */
            assertIdentityForSafeCsvInput(s, out, "safe-identity");

            /*
             * Metamorphic relation:
             * For the same class of safe inputs, escapeCsv is the identity, so applying it twice
             * must yield the same result as once. Both sides use the real public API.
             * If either call rejects, the oracle does not apply.
             */
            try {
                String twice = StringEscapeUtils.escapeCsv(out);
                if (!eq(out, twice)) {
                    throw new RuntimeException(
                        "[oracle:csv-idempotent] metamorphic violation: escapeCsv(escapeCsv(x)) == escapeCsv(x) input="
                            + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(twice));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwAsUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixLen = data.consumeInt(0, 8);
        for (int i = 0; i < prefixLen; i++) {
            sb.append(safeAscii(data));
        }

        int pairCount = data.consumeInt(1, 6);
        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                int cp = data.consumeInt(0x10000, 0x10FFFF);
                sb.append(Character.toChars(cp));
            } else {
                int[][] anchors = new int[][] {
                    {0xD83D, 0xDE30},
                    {0xD800, 0xDC00},
                    {0xD834, 0xDD1E},
                    {0xDBFF, 0xDFFD}
                };
                int idx = data.consumeInt(0, anchors.length - 1);
                sb.append((char) anchors[idx][0]).append((char) anchors[idx][1]);
            }

            int midLen = data.consumeInt(0, 4);
            for (int j = 0; j < midLen; j++) {
                sb.append(safeAscii(data));
            }
        }

        int suffixLen = data.consumeInt(0, 8);
        for (int i = 0; i < suffixLen; i++) {
            sb.append(safeAscii(data));
        }

        return sb.toString();
    }

    private static char safeAscii(FuzzedDataProvider data) {
        String chars = " abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-:/+*";
        return chars.charAt(data.consumeInt(0, chars.length() - 1));
    }

    private static void assertIdentityForSafeCsvInput(String in, String out, String oracleId) {
        if (!containsCsvSpecial(in) && !eq(in, out)) {
            throw new RuntimeException(
                "[oracle:" + oracleId + "] metamorphic violation: escapeCsv(x) must equal x for CSV-safe input input="
                    + printable(in) + " lhs=" + printable(out) + " rhs=" + printable(in));
        }
    }

    private static boolean containsCsvSpecial(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static void handleThrowable(Throwable t) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            throwAsUnchecked(t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement e : stack) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }

    private static boolean eq(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n").replace("\"", "\\\"") + "\"";
    }
}
