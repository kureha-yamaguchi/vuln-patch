    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(RuntimeException t) {
        if (isValidationFamily(t)) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Validation")
            || name.contains("Invalid")
            || name.contains("Malformed")
            || name.contains("Parse");
    }

    private static String buildLengthThreeCandidate(FuzzedDataProvider data) {
        char[] chars = new char[3];
        int mode = data.consumeInt(0, 5);
        if (mode == 0) {
            chars[0] = data.consumeBoolean() ? 't' : 'T';
            chars[1] = randomAsciiChar(data);
            chars[2] = randomAsciiChar(data);
        } else if (mode == 1) {
            chars[0] = data.consumeBoolean() ? 'y' : 'Y';
            chars[1] = randomAsciiChar(data);
            chars[2] = randomAsciiChar(data);
        } else {
            chars[0] = randomAsciiChar(data);
            chars[1] = randomAsciiChar(data);
            chars[2] = randomAsciiChar(data);
        }
        return new String(chars);
    }

    private static String buildTruthyVariant(String base, FuzzedDataProvider data) {
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static String pickObservedLiteral(FuzzedDataProvider data) {
        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        return literals[data.consumeInt(0, literals.length - 1)];
    }

    private static char randomAsciiChar(FuzzedDataProvider data) {
        return (char) data.consumeInt(32, 126);
    }

    private static String padToThree(String s) {
        StringBuilder sb = new StringBuilder(s == null ? "" : s);
        while (sb.length() < 3) {
            sb.append('x');
        }
        if (sb.length() > 3) {
            return sb.substring(0, 3);
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
