    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof NullPointerException && hasRelevantFrame(t)) {
            return true;
        }
        if (t instanceof RuntimeException && isValidationFamily(t)) {
            return false;
        }
        if (t instanceof RuntimeException) {
            return false;
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement ste : stack) {
            if (ste == null) {
                continue;
            }
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }
