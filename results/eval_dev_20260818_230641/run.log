package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryAnchor();
        tryExplore(data);
    }

    private static void tryAnchor() {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsvIdentity(s);
        }
    }

    private static void tryExplore(FuzzedDataProvider data) {
        String prefix = sanitizeCsvNeutral(data.consumeAsciiString(16));
        String suffix = sanitizeCsvNeutral(data.consumeAsciiString(16));

        int pairs = data.consumeInt(1, 4);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < pairs; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            middle.append(Character.toChars(cp));
            middle.append(sanitizeCsvNeutral(data.consumeAsciiString(4)));
        }

        String candidate = prefix + middle.toString() + suffix;
        exerciseEscapeCsvIdentity(candidate);

        String extra = sanitizeCsvNeutral(data.consumeRemainingAsString());
        if (extra.length() > 0) {
            exerciseEscapeCsvIdentity(candidate + extra);
            exerciseEscapeCsvIdentity(extra + candidate);
        }
    }

    private static void exerciseEscapeCsvIdentity(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle:
             * escapeCsv only escapes CSV-special content. For inputs with no comma, quote,
             * CR, or LF, the correct result is the original string unchanged. The failing test
             * demonstrates valid surrogate-pair inputs that must round-trip unchanged through
             * this public API. A patch that merely suppresses the exception but skips/duplicates
             * characters in CharSequenceTranslator.translate would violate this observable
             * post-condition.
             */
            if (isCsvNeutral(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-neutral input"
                        + " input=" + printable(input)
                        + " lhs=" + printable(escaped)
                        + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCsvNeutral(String s) {
        if (s == null) {
            return true;
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static String sanitizeCsvNeutral(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
