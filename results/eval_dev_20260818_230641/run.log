package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String raw = data.consumeAsciiString(16);
        invokeRealEntryPoint(raw, false);
        checkEqualContentOracle(raw);

        String len3 = buildLen3Probe(data);
        invokeRealEntryPoint(len3, false);
        checkEqualContentOracle(len3);

        String truthy = buildTruthyToken(data);
        invokeRealEntryPoint(truthy, true);
        checkTruthyOracle(truthy);

        String exactTrueDistinct = new StringBuffer("tr").append("ue").toString();
        invokeRealEntryPoint(exactTrueDistinct, true);
        checkTruthyOracle(exactTrueDistinct);

        String near = buildNearBoundaryProbe(data);
        invokeRealEntryPoint(near, false);
        checkEqualContentOracle(near);
    }

    private static String buildLen3Probe(FuzzedDataProvider data) {
        char first;
        switch (data.consumeInt(0, 5)) {
            case 0:
                first = 't';
                break;
            case 1:
                first = 'T';
                break;
            case 2:
                first = 'y';
                break;
            case 3:
                first = 'Y';
                break;
            case 4:
                first = 'o';
                break;
            default:
                first = asciiChar(data.consumeByte());
                break;
        }
        char second = asciiChar(data.consumeByte());
        char third = asciiChar(data.consumeByte());
        return new String(new char[] { first, second, third });
    }

    private static String buildNearBoundaryProbe(FuzzedDataProvider data) {
        int len = data.consumeInt(2, 5);
        char[] chars = new char[len];
        if (len > 0) {
            switch (data.consumeInt(0, 6)) {
                case 0:
                    chars[0] = 't';
                    break;
                case 1:
                    chars[0] = 'T';
                    break;
                case 2:
                    chars[0] = 'y';
                    break;
                case 3:
                    chars[0] = 'Y';
                    break;
                case 4:
                    chars[0] = 'o';
                    break;
                case 5:
                    chars[0] = 'O';
                    break;
                default:
                    chars[0] = asciiChar(data.consumeByte());
                    break;
            }
        }
        for (int i = 1; i < len; i++) {
            chars[i] = asciiChar(data.consumeByte());
        }
        return new String(chars);
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        String base;
        switch (data.consumeInt(0, 2)) {
            case 0:
                base = "on";
                break;
            case 1:
                base = "yes";
                break;
            default:
                base = "true";
                break;
        }
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static char asciiChar(byte b) {
        int v = b & 0x7F;
        if (v < 32) {
            v += 32;
        }
        return (char) v;
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: BooleanUtils.toBoolean is a parser over String content; creating a distinct
               String object with identical characters must not change the result. A patch that merely
               diverts execution or keys off representation instead of content would violate this. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract: documented truthy tokens ("on", "yes", "true") are accepted case-insensitively,
               and equal-content distinct String objects must agree. A throw-deleting patch that simply
               returns false on the formerly failing path would break one of these observations. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                    && "toBoolean".equals(st[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (isValidationFamily(t)) {
            return true;
        }
        String name = t.getClass().getName();
        String simple = t.getClass().getSimpleName();
        return name.contains("Invalid")
                || name.contains("Validation")
                || simple.contains("Invalid")
                || simple.contains("Validation");
    }

    private static String quote(String s) {
        if (s == null) {
            return "null";
        }
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
