        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "[oracle:filter-invalid] metamorphic violation: removing ignored entries (null search, empty search, or null replacement) changed replaceEach result input="
                    + safe(text)
                    + " lhs="
                    + safe(lhs)
                    + " rhs="
                    + safe(rhs)
                    + " lhsLen="
                    + StringUtils.length(lhs)
                    + " rhsLen="
                    + StringUtils.length(rhs));
        }
    }

    private static String[] filterSearch(String[] searchList, String[] replacementList) {
        ArrayList<String> out = new ArrayList<String>();
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) {
                continue;
            }
            out.add(searchList[i]);
        }
        return out.toArray(new String[out.size()]);
    }

    private static String[] filterReplacement(String[] searchList, String[] replacementList) {
        ArrayList<String> out = new ArrayList<String>();
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) {
                continue;
            }
            out.add(replacementList[i]);
        }
        return out.toArray(new String[out.size()]);
    }

    private static String fuzzElement(FuzzedDataProvider data) {
        int kind = data.consumeInt(0, 4);
        switch (kind) {
            case 0:
                return null;
            case 1:
                return "";
            case 2:
                return data.consumeAsciiString(1);
            case 3:
                return data.consumeAsciiString(3);
            default:
                return data.consumeString(6);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t.getClass().getName().endsWith("ValidationException")
                || t.getClass().getName().endsWith("InvalidFormatException")
                || t.getClass().getName().endsWith("InvalidArgumentException");
    }

    private static String safe(String s) {
        return String.valueOf(s);
    }
}
