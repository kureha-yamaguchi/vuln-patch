            helperLong = NumberUtils.createLong(numeric);
            unsuffixed = NumberUtils.createNumber(numeric);
        } catch (RuntimeException e) {
            return;
        }

        try {
            Number lower = NumberUtils.createNumber(numeric + "l");
            Number upper = NumberUtils.createNumber(numeric + "L");

            /*
             * Contract visible in NumberUtils.createNumber: for a valid integral payload with an explicit
             * l/L suffix, createNumber parses the same numeric text that createLong(numeric) would parse;
             * lower/upper case suffixes share the same logic; the unsuffixed integral parse denotes the
             * same quantity. A patch that merely suppresses the crash but makes l/L inputs unreachable or
