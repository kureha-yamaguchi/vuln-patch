package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runSeedFromTest();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (isRootCauseValidation(e)) {
                throw new RuntimeException("[oracle:anchor-valid-gap] metamorphic violation: createCopy rejected an ordered non-null range wholly inside a real gap from the regression test", e);
            }
            return;
        }

        int rounds = 1;
        if (data != null) {
            rounds = data.consumeInt(1, 8);
        }

        for (int r = 0; r < rounds; r++) {
            try {
                exerciseGapProperty(data, r);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isRootCauseValidation(e)) {
                    throw new RuntimeException("[oracle:valid-gap-accept] metamorphic violation: createCopy rejected a valid ordered non-null range wholly inside a real gap", e);
                }
                return;
            }
        }
    }

    private static void runSeedFromTest() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        requireEmptyCopyForGap(s, start, end);
        requireSingletonOverloadAgreement(s, 0);
        requireSingletonOverloadAgreement(s, 1);
    }

    private static void exerciseGapProperty(FuzzedDataProvider data, int round) throws CloneNotSupportedException {
        TimeSeries series = new TimeSeries("Fuzz-" + round + "-" + safeAscii(data, 12));

        int year = boundedInt(data, 1901, 2099, 2005);
        int month = boundedInt(data, 1, 12, 8);
        int leftDay = boundedInt(data, 1, 20, 10);
        int gapSize = boundedInt(data, 1, 40, 10);
        int beforeCount = boundedInt(data, 0, 6, 0);
        int afterCount = boundedInt(data, 0, 6, 0);

        Day left;
        Day right;
        try {
            left = new Day(leftDay, month, year);
            right = addDays(left, gapSize + 1);
        } catch (RuntimeException e) {
            return;
        }
        if (left == null || right == null) {
            return;
        }

        try {
            for (int i = beforeCount; i > 0; i--) {
                Day p = addDays(left, -i);
                if (p != null) {
                    series.add(p, Integer.valueOf(rawInt(data, i)));
                }
            }
            series.add(left, Integer.valueOf(rawInt(data, 1)));
            series.add(right, Integer.valueOf(rawInt(data, 2)));
            for (int i = 1; i <= afterCount; i++) {
                Day p = addDays(right, i);
                if (p != null) {
                    series.add(p, Integer.valueOf(rawInt(data, -i)));
                }
            }
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        int startOffset = boundedInt(data, 1, gapSize, 1);
        int endOffset = boundedInt(data, startOffset, gapSize, startOffset);

        Day start;
        Day end;
        try {
            start = addDays(left, startOffset);
            end = addDays(left, endOffset);
        } catch (RuntimeException e) {
            return;
        }
        if (start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        requireEmptyCopyForGap(series, start, end);

        if (startOffset < endOffset) {
            int innerStartOffset = boundedInt(data, startOffset, endOffset, startOffset);
            int innerEndOffset = boundedInt(data, innerStartOffset, endOffset, innerStartOffset);
            Day innerStart = addDays(left, innerStartOffset);
            Day innerEnd = addDays(left, innerEndOffset);
            if (innerStart != null && innerEnd != null && innerStart.compareTo(innerEnd) <= 0) {
                requireEmptyCopyForGap(series, innerStart, innerEnd);
            }
        }

        if (series.getItemCount() > 0) {
            int chosen = boundedInt(data, 0, series.getItemCount() - 1, 0);
            requireSingletonOverloadAgreement(series, chosen);
        }
    }

    private static void requireEmptyCopyForGap(TimeSeries series, Day start, Day end) throws CloneNotSupportedException {
        if (series == null || start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int rawStartIndex;
        int rawEndIndex;
        try {
            rawStartIndex = series.getIndex(start);
            rawEndIndex = series.getIndex(end);
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int computedStartIndex = insertionPoint(rawStartIndex);
        int computedEndIndex = insertionPoint(rawEndIndex) - 1;
        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        /*
         * Contract asserted: createCopy(start,end) returns the inclusive subseries bounded by the
         * ordered, non-null periods. If both bounds lie wholly inside a real gap, no source item is
         * in [start,end], so the result must be an empty series. A patch that merely suppresses the
         * historical exception or skips the empty-range bookkeeping would violate this observable API.
         */
        if (copy.getItemCount() != 0
                || copy.getItems().size() != 0
                || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException(
                    "[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " start=" + start
                            + " end=" + end
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " computedStartIndex=" + computedStartIndex
                            + " computedEndIndex=" + computedEndIndex
                            + " copyCount=" + copy.getItemCount()
                            + " copyItems=" + copy.getItems().size()
                            + " copyPeriods=" + copy.getTimePeriods().size());
        }
    }

    private static void requireSingletonOverloadAgreement(TimeSeries series, int index) throws CloneNotSupportedException {
        if (series == null || index < 0 || index >= series.getItemCount()) {
            return;
        }
        RegularTimePeriod exact = series.getTimePeriod(index);
        if (exact == null) {
            return;
        }

        TimeSeries byPeriod;
        TimeSeries byIndex;
        try {
            byPeriod = series.createCopy(exact, exact);
            byIndex = series.createCopy(index, index);
        } catch (RuntimeException e) {
            if (isRootCauseValidation(e)) {
                throw e;
            }
            return;
        }

        /*
         * Metamorphic relation: for any exact existing item, createCopy(period,period) and
         * createCopy(index,index) denote the same singleton subseries, so both public views must agree.
         * A patch that dodges the buggy branch by returning the wrong slice breaks this equivalence.
         */
        if (!equivalentSeries(byPeriod, byIndex)) {
            throw new RuntimeException(
                    "[oracle:singleton-overloads] metamorphic violation: createCopy(period,period) and createCopy(index,index) must agree"
                            + " index=" + index
                            + " period=" + exact
                            + " periodCount=" + byPeriod.getItemCount()
                            + " indexCount=" + byIndex.getItemCount());
        }
    }

    private static boolean equivalentSeries(TimeSeries a, TimeSeries b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a.getItemCount() != b.getItemCount()) {
            return false;
        }
        if (a.getItems().size() != b.getItems().size()) {
            return false;
        }
        if (a.getTimePeriods().size() != b.getTimePeriods().size()) {
            return false;
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null ? pb != null : pa.compareTo(pb) != 0) {
                return false;
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                return false;
            }
        }
        return true;
    }

    private static Day addDays(Day base, int delta) {
        if (base == null) {
            return null;
        }
        Day d = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                d = (Day) d.next();
                if (d == null) {
                    return null;
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                d = (Day) d.previous();
                if (d == null) {
                    return null;
                }
            }
        }
        return d;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
