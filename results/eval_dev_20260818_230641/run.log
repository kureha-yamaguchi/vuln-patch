package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            exerciseMalformed(anchors[i]);
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 11)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = (data.consumeBoolean() ? "+" : "-") + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "." + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "e" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "E" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 9:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 10:
                    probe = "0x" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeString(4);
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String digits = buildDigits(data, 1, 18);
            String numeric = data.consumeBoolean() ? digits : ("-" + digits);

            Long helper;
            Number unsuffixed;
            try {
                helper = NumberUtils.createLong(numeric);
                unsuffixed = NumberUtils.createNumber(numeric);
            } catch (RuntimeException e) {
                return;
            }

            try {
                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");

                /*
                 * Contract visible in NumberUtils.createNumber:
                 * in the explicit l/L branch, when dec == null, exp == null, and the numeric payload is
                 * a decimal integer (optional leading '-'), the method parses the same payload via
                 * createLong(numeric); lower/upper suffixes share that same branch. A patch that merely
                 * guards away the crash by making the l/L branch reject or mis-handle valid inputs would
                 * violate this observable consistency.
                 */
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || helper == null
                        || unsuffixed == null
                        || lower.longValue() != helper.longValue()
                        || upper.longValue() != helper.longValue()
                        || unsuffixed.longValue() != helper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:integral-long-suffix-consistency] metamorphic violation: explicit decimal l/L parsing must agree with createLong and unsuffixed createNumber input="
                                    + numeric
                                    + " lower=" + lower
                                    + " upper=" + upper
                                    + " unsuffixed=" + unsuffixed
                                    + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:integral-long-suffix-consistency] metamorphic violation: valid decimal with explicit l/L suffix reached root cause input="
                                    + numeric,
                            e);
                }
                return;
            }
        }

        {
            String overflowDigits = buildOverflowDigits(data);
            String overflowNumeric = data.consumeBoolean() ? overflowDigits : ("-" + overflowDigits);

            BigInteger helper;
            Number unsuffixed;
            try {
                helper = NumberUtils.createBigInteger(overflowNumeric);
                unsuffixed = NumberUtils.createNumber(overflowNumeric);
            } catch (RuntimeException e) {
                return;
            }

            try {
                Number explicit = NumberUtils.createNumber(overflowNumeric + (data.consumeBoolean() ? "L" : "l"));

                /*
                 * Contract visible in NumberUtils.createNumber:
                 * in the explicit l/L branch, if createLong(numeric) overflows, the implementation falls
                 * back to createBigInteger(numeric). Therefore explicit-suffix parsing and unsuffixed
                 * integral parsing of the same decimal text must preserve the exact BigInteger value.
                 */
                if (!(explicit instanceof BigInteger)
                        || !(unsuffixed instanceof BigInteger)
                        || helper == null
                        || !helper.equals(explicit)
                        || !helper.equals(unsuffixed)) {
                    throw new RuntimeException(
                            "[oracle:integral-long-overflow-bigint] metamorphic violation: overflow explicit l/L parsing must agree with createBigInteger and unsuffixed createNumber input="
                                    + overflowNumeric
                                    + " explicit=" + explicit
                                    + " unsuffixed=" + unsuffixed
                                    + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:integral-long-overflow-bigint] metamorphic violation: overflow decimal with explicit l/L suffix reached root cause input="
                                    + overflowNumeric,
                            e);
                }
            }
        }
    }

    private static void exerciseMalformed(String input) {
        try {
            Number parsed = NumberUtils.createNumber(input);
            throw new RuntimeException(
                    "[oracle:malformed-clean-rejection] metamorphic violation: malformed numeric text must be rejected, not parsed input="
                            + input + " parsed=" + parsed);
        } catch (RuntimeException e) {
            if (isOracle(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:malformed-clean-rejection] metamorphic violation: malformed numeric text reached root cause instead of clean validation rejection input="
                                + input,
                        e);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String buildOverflowDigits(FuzzedDataProvider data) {
        String seed = data.consumeBoolean() ? "9223372036854775808" : "18446744073709551616";
        StringBuilder sb = new StringBuilder(seed);
        int extra = data.consumeInt(0, 8);
        for (int i = 0; i < extra; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }
}
