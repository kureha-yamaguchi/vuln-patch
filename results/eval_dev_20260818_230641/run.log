                    + " lhs=plus=" + aWhole + ",size=" + as + ",bc=" + pointToString(abc)
                    + " rhs=plus=" + bWhole + ",size=" + bs + ",bc=" + pointToString(bbc));
        }
    }

    private static void assertWholeGeometry(PolygonsSet poly, String label) {
        double size = poly.getSize();
