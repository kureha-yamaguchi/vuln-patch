package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        invokeRealEntryPoint("tru", false);
        invokeRealEntryPoint(mixedCase("tru", data), false);

        String arbitrary = data.consumeString(32);
        invokeRealEntryPoint(arbitrary, false);
        checkEqualContentOracle(arbitrary);

        String propertyInput = buildThreeCharTruShape(data);
        invokeRealEntryPoint(propertyInput, false);
        checkEqualContentOracle(propertyInput);

        String truthy = buildTruthyToken(data);
        checkTruthyOracle(truthy);

        String extra = data.consumeRemainingAsString();
        if (extra.length() > 0) {
            checkEqualContentOracle(extra);
        }
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: this parser is defined by String content, not object identity.
               The implementation only special-cases the interned literal "true" as an optimization,
               so equal-content distinct String instances must parse identically. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            boolean lower = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract: BooleanUtils.toBoolean accepts the documented truthy tokens "on", "yes", and "true"
               case-insensitively; equal-content distinct String objects must also agree. A patch that merely
               avoids the crash by returning false or by making a branch unreachable would violate this. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != lower) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + lower);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildThreeCharTruShape(FuzzedDataProvider data) {
        char c0 = data.consumeBoolean() ? 't' : 'T';
        char c1 = data.consumeBoolean() ? 'r' : 'R';
        char c2 = data.consumeBoolean() ? 'u' : 'U';
        return new String(new char[] {c0, c1, c2});
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int choice = data.consumeInt(0, 2);
        String base = choice == 0 ? "on" : (choice == 1 ? "yes" : "true");
        return mixedCase(base, data);
    }

    private static String mixedCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean()
                ? Character.toUpperCase(chars[i])
                : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static boolean isRootCause(RuntimeException t) {
        return t instanceof StringIndexOutOfBoundsException && hasBooleanUtilsToBooleanFrame(t);
    }

    private static boolean hasBooleanUtilsToBooleanFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || hasValidationLikeName(t.getClass());
    }

    private static boolean hasValidationLikeName(Class<?> cls) {
        while (cls != null) {
            String name = cls.getName();
            if (name.contains("Invalid")
                    || name.contains("Validation")
                    || name.contains("Malformed")
                    || name.contains("Parse")) {
                return true;
            }
            cls = cls.getSuperclass();
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
