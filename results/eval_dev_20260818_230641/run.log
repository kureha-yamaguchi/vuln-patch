            void checkEquivalent(String a, String b, String oracleId) {
                try {
                    Number left = NumberUtils.createNumber(a);
                    Number right = NumberUtils.createNumber(b);
                    if (left == null || right == null) {
                        return;
                    }
                    if (!sameNumericValue(left, right)) {
                        throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA=" + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
                    }
                } catch (RuntimeException t) {
                    if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                        throw t;
                    }
                    if (isRootCause(t)) {
                        throw t;
                    }
                    if (isCleanReject(t)) {
                        return;
                    }
                }
            }
        }

        Util u = new Util();

        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (u.isRootCause(t)) {
                throw t;
            }
            if (!u.isCleanReject(t)) {
                return;
            }
        }

        try {
            Number a = NumberUtils.createNumber("1234.5");
            Number b = NumberUtils.createNumber("1234.5D");
            if (a != null && b != null && !u.sameNumericValue(a, b)) {
                throw new RuntimeException("[oracle:anchor-equivalence] metamorphic violation: plain decimal and explicit double suffix must denote the same numeric value inputA=1234.5 inputB=1234.5D lhs=" + a + " rhs=" + b);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (u.isRootCause(t)) {
                throw t;
            }
            if (!u.isCleanReject(t)) {
                return;
            }
        }

        String sign = data.consumeBoolean() ? "-" : "";
        int mantLen = data.consumeInt(1, 8);
        String rawMant = data.consumeAsciiString(mantLen);
        StringBuilder mantDigits = new StringBuilder();
        for (int i = 0; i < rawMant.length(); i++) {
            char c = rawMant.charAt(i);
            if (c >= '0' && c <= '9') {
                mantDigits.append(c);
            } else {
                mantDigits.append((char) ('0' + (c & 7)));
            }
        }
        if (mantDigits.length() == 0) {
            mantDigits.append('1');
        }
        boolean allZeroMant = true;
        for (int i = 0; i < mantDigits.length(); i++) {
            if (mantDigits.charAt(i) != '0') {
                allZeroMant = false;
                break;
            }
        }
        if (allZeroMant) {
            mantDigits.setCharAt(mantDigits.length() - 1, '1');
        }

        int fracLen = data.consumeInt(1, 6);
        String rawFrac = data.consumeAsciiString(fracLen);
        StringBuilder fracDigits = new StringBuilder();
        for (int i = 0; i < rawFrac.length(); i++) {
            char c = rawFrac.charAt(i);
            if (c >= '0' && c <= '9') {
                fracDigits.append(c);
            } else {
                fracDigits.append((char) ('0' + (c & 7)));
            }
        }
        if (fracDigits.length() == 0) {
            fracDigits.append('0');
        }

        boolean expNegative = data.consumeBoolean();
        int expLen = data.consumeInt(1, 3);
        String rawExp = data.consumeAsciiString(expLen);
        StringBuilder expDigits = new StringBuilder();
        for (int i = 0; i < rawExp.length(); i++) {
            char c = rawExp.charAt(i);
            if (c >= '0' && c <= '9') {
                expDigits.append(c);
            } else {
                expDigits.append((char) ('0' + (c & 7)));
            }
        }
        if (expDigits.length() == 0) {
            expDigits.append('0');
        }
        String expSign = expNegative ? "-" : "";

        char expMarker = data.consumeBoolean() ? 'e' : 'E';
        String suffix = "";
        switch (data.consumeInt(0, 4)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            default:
                break;
        }

        String decimalNoExp = sign + mantDigits + "." + fracDigits;
        String decimalWithSuffix = decimalNoExp + suffix;
        String scientific = sign + mantDigits + "." + fracDigits + expMarker + expSign + expDigits;
        String scientificOppCase = sign + mantDigits + "." + fracDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String scientificWithSuffix = scientific + suffix;
        String scientificOppCaseWithSuffix = scientificOppCase + suffix;
        String redundantFractionScientific = sign + mantDigits + ".0" + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String integralScientific = sign + mantDigits + expMarker + expSign + expDigits;
        String integralScientificOppCase = sign + mantDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;

        u.exerciseSilently(decimalNoExp);
        u.exerciseSilently(decimalWithSuffix);
        u.exerciseSilently(scientific);
        u.exerciseSilently(scientificWithSuffix);
        u.exerciseSilently(integralScientific);

        /*
         * Contract asserted below: createNumber parses numeric strings, so different
         * spellings of the same numeric value must produce numerically equal results.
         * In particular, exponent marker case must not matter, and adding a redundant
         * ".0" before an exponent must not change the value. A patch that only guards
         * the crashing branch or skips bookkeeping could avoid throwing while silently
         * changing which parser path is taken; these equivalence checks catch that.
         */
        u.checkEquivalent(scientific, scientificOppCase, "scientific-exp-case-equivalence");
        if (!suffix.isEmpty()) {
            u.checkEquivalent(scientificWithSuffix, scientificOppCaseWithSuffix, "scientific-exp-case-equivalence-suffix");
        }
        u.checkEquivalent(integralScientific, redundantFractionScientific, "redundant-decimal-before-exponent");
        u.checkEquivalent(integralScientific, integralScientificOppCase, "integral-scientific-exp-case-equivalence");

        String extra = data.consumeString(6);
        if (extra != null && extra.length() > 0) {
            String maybeBad = decimalNoExp + extra;
            u.parseOrSkip(maybeBad);
        }

        String[] observed = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2."
        };
        int idx = data.consumeInt(0, observed.length - 1);
        u.parseOrSkip(observed[idx]);
    }
