package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        try {
            TimeSeries series = buildFuzzSeries(data);
            if (series == null || series.getItemCount() < 2) {
                return;
            }

            Day left = null;
            Day right = null;
            for (int i = 0; i < series.getItemCount() - 1; i++) {
                RegularTimePeriod p1 = series.getTimePeriod(i);
                RegularTimePeriod p2 = series.getTimePeriod(i + 1);
                if (p1 instanceof Day && p2 instanceof Day) {
                    Day d1 = (Day) p1;
                    Day d2 = (Day) p2;
                    int delta = daysBetween(d1, d2);
                    if (delta >= 2) {
                        left = d1;
                        right = d2;
                        break;
                    }
                }
            }
            if (left == null || right == null) {
                return;
            }

            int interior = daysBetween(left, right) - 1;
            if (interior < 1) {
                return;
            }

            int startOffset = data.consumeInt(1, interior);
            int endOffset = data.consumeInt(startOffset, interior);
            Day start = addDays(left, startOffset);
            Day end = addDays(left, endOffset);
            if (start == null || end == null || start.compareTo(end) > 0) {
                return;
            }

            verifyGapCopy(series, start, end);

            if (series.getItemCount() > 0) {
                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                verifySingletonOverloadAgreement(series, chosen);
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            // Swallow: clone failure is outside the patched validation logic.
        } catch (Throwable t) {
            // Swallow unrelated failures to avoid false positives on correct patches.
        }
    }

    private static void runAnchor() {
        try {
            TimeSeries s = new TimeSeries("S");
            s.add(new Day(19, 8, 2005), 1);
            s.add(new Day(31, 1, 2006), 1);

            TimeSeries copy = s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));

            /*
             * Contract asserted: createCopy(start,end) returns the inclusive subseries for ordered,
             * non-null bounds. Here both bounds lie wholly inside the real gap between the only two
             * source items, so no item falls in the requested interval and the copy must be empty.
             * A throw-deleting or bookkeeping-skipping patch could avoid the historical exception yet
             * return a non-empty slice, so we check observable emptiness.
             */
            assertEmptySeries(copy, "anchor-gap-empty", new Day(1, 12, 2005), new Day(18, 1, 2006));

            verifySingletonOverloadAgreement(s, 0);
            verifySingletonOverloadAgreement(s, 1);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            // Not part of the root cause.
        }
    }

    private static TimeSeries buildFuzzSeries(FuzzedDataProvider data) {
        try {
            int year = 1900 + data.consumeInt(0, 250);
            int month = data.consumeInt(1, 12);
            int day = data.consumeInt(1, 28);

            Day current = new Day(day, month, year);
            TimeSeries series = new TimeSeries(data.consumeAsciiString(16));
            double value = data.consumeInt(-1000, 1000);
            series.add(current, value++);

            int prefixCount = data.consumeInt(0, 4);
            for (int i = 0; i < prefixCount; i++) {
                current = addDays(current, data.consumeInt(1, 3));
                if (current == null) {
                    return null;
                }
                series.add(current, value++);
            }

            Day left = current;
            int gapInterior = data.consumeInt(1, 40);
            current = addDays(current, gapInterior + 1);
            if (current == null) {
                return null;
            }
            Day right = current;
            series.add(right, value++);

            int suffixCount = data.consumeInt(0, 4);
            for (int i = 0; i < suffixCount; i++) {
                current = addDays(current, data.consumeInt(1, 3));
                if (current == null) {
                    return null;
                }
                series.add(current, value++);
            }

            if (left.compareTo(right) >= 0) {
                return null;
            }
            return series;
        } catch (RuntimeException e) {
