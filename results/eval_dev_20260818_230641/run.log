                if (isCleanValidation(e) && isReachableRootCause(e)) {
                    throw new RuntimeException(
                            "[oracle:valid-empty-gap] metamorphic violation: valid ordered non-null periods inside a real gap must not be rejected"
                                    + " start=" + start
                                    + " end=" + end
                                    + " rawStartIndex=" + rawStartIndex
                                    + " rawEndIndex=" + rawEndIndex,
                            e);
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int rawStartIndex = s.getIndex(start);
        int rawEndIndex = s.getIndex(end);

        try {
            TimeSeries copy = s.createCopy(start, end);
            assertEmptySeries(copy, "anchor-gap-empty", start, end, rawStartIndex, rawEndIndex);
        } catch (RuntimeException e) {
            if (isCleanValidation(e) && isReachableRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:anchor-valid-empty-gap] metamorphic violation: failing-test input is ordered, non-null, and wholly inside a real gap, so createCopy must return an empty series rather than reject it",
                        e);
            }
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        c.clear();
        c.set(1970, Calendar.JANUARY, 1, 0, 0, 0);
        c.add(Calendar.DATE, epochDay);
        return new Day(c.get(Calendar.DATE), c.get(Calendar.MONTH) + 1, c.get(Calendar.YEAR));
    }

    private static void assertEmptySeries(
            TimeSeries series,
            String oracleId,
            RegularTimePeriod start,
            RegularTimePeriod end,
            int rawStartIndex,
            int rawEndIndex) {
        int count = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();
        if (count != 0 || itemsSize != 0 || periodsSize != 0) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " count=" + count
                            + " items=" + itemsSize
                            + " periods=" + periodsSize
                            + " start=" + start
                            + " end=" + end
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex);
        }
    }

    private static void assertEquivalentSeries(
            TimeSeries lhs,
            TimeSeries rhs,
            String oracleId,
            RegularTimePeriod aStart,
            RegularTimePeriod aEnd,
            RegularTimePeriod bStart,
            RegularTimePeriod bEnd) {
        int lc = lhs.getItemCount();
        int rc = rhs.getItemCount();
        int li = lhs.getItems().size();
        int ri = rhs.getItems().size();
        int lp = lhs.getTimePeriods().size();
        int rp = rhs.getTimePeriods().size();

        if (lc != rc || li != ri || lp != rp) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: equivalent createCopy calls must expose equivalent sizes"
                            + " lhsCount=" + lc
                            + " rhsCount=" + rc
                            + " lhsItems=" + li
                            + " rhsItems=" + ri
                            + " lhsPeriods=" + lp
                            + " rhsPeriods=" + rp
                            + " lhsRange=[" + aStart + "," + aEnd + "]"
                            + " rhsRange=[" + bStart + "," + bEnd + "]");
        }

        for (int i = 0; i < lc; i++) {
            RegularTimePeriod ltp = lhs.getTimePeriod(i);
            RegularTimePeriod rtp = rhs.getTimePeriod(i);
            if (!ltp.equals(rtp)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: equivalent createCopy calls must expose the same periods"
                                + " index=" + i
                                + " lhsPeriod=" + ltp
                                + " rhsPeriod=" + rtp
                                + " lhsRange=[" + aStart + "," + aEnd + "]"
                                + " rhsRange=[" + bStart + "," + bEnd + "]");
            }
            Number lv = lhs.getValue(i);
            Number rv = rhs.getValue(i);
            if (lv == null ? rv != null : !lv.equals(rv)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: equivalent createCopy calls must expose the same values"
                                + " index=" + i
                                + " lhsValue=" + lv
                                + " rhsValue=" + rv
                                + " lhsRange=[" + aStart + "," + aEnd + "]"
                                + " rhsRange=[" + bStart + "," + bEnd + "]");
            }
        }
    }

    private static int insertionPoint(int rawBinarySearchResult) {
        return -(rawBinarySearchResult + 1);
    }

    private static boolean isCleanValidation(Throwable t) {
