package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact inputs from the regression test.
        checkEscapeCsv("\uD83D\uDE30", true);
        checkEscapeCsv("\uD800\uDC00", true);
        checkEscapeCsv("\uD834\uDD1E", true);
        checkEscapeCsv("\uDBFF\uDFFD", true);

        // EXPLORE: the bug is triggered when the translator reports it consumed
        // multiple UTF-16 char units while the outer loop advances by code points.
        // escapeCsv should accept arbitrary strings; for strings containing no CSV
        // special characters (comma, quote, CR, LF), its contract is to return the
        // input unchanged. We therefore build valid strings that contain one or more
        // real surrogate pairs at varied positions, but no CSV special chars.
        String prefix = sanitizeCsvSafe(data.consumeString(16));
        String middle = sanitizeCsvSafe(data.consumeString(16));
        String suffix = sanitizeCsvSafe(data.consumeRemainingAsString());

        int pairs = 1;
        if (data.remainingBytes() > 0) {
            pairs = data.consumeInt(1, 4);
        }

        StringBuilder sb = new StringBuilder(prefix.length() + middle.length() + suffix.length() + pairs * 2 + 8);
        sb.append(prefix);
        for (int i = 0; i < pairs; i++) {
            sb.append(randomSurrogatePair(data));
            if ((i & 1) == 0) {
                sb.append(middle);
            }
        }
        sb.append(suffix);

        checkEscapeCsv(sb.toString(), true);
    }

    private static void checkEscapeCsv(String input, boolean identityOracleApplies) {
        final String result;
        try {
            result = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (identityOracleApplies) {
            // Contract used for this oracle:
            // CSV escaping only quotes fields containing CSV special characters.
            // Therefore, for inputs containing none of: ',', '"', '\r', '\n',
            // escapeCsv(input) must equal input. A "fix" that merely skips the
            // crashing bookkeeping or drops output would violate this observable
            // post-condition without throwing.
            if (!input.equals(result)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe input input="
                        + repr(input) + " lhs=" + repr(result) + " rhs=" + repr(input));
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n' || Character.isSurrogate(ch)) {
                out.append('x');
            } else {
                out.append(ch);
            }
        }
        return out.toString();
    }

    private static String randomSurrogatePair(FuzzedDataProvider data) {
        char high = (char) data.consumeInt(0xD800, 0xDBFF);
        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
        return new String(new char[] { high, low });
    }

    private static String repr(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
