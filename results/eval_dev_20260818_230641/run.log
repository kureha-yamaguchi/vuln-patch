package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String base = data.consumeString(32);
        String fillerLeft = data.consumeString(8);
        String fillerRight = data.consumeString(8);
        String needle = data.consumeString(8);
        if (needle == null || needle.length() == 0) {
            needle = "a";
        }

        String text;
        if (data.consumeBoolean()) {
            text = fillerLeft + needle + fillerRight;
        } else {
            text = base;
            if (StringUtils.length(text) == 0 || text.indexOf(needle) < 0) {
                text = fillerLeft + needle + fillerRight;
            }
        }

        int pairCount = data.consumeInt(1, 6);
        String[] searchList = new String[pairCount];
        String[] replacementList = new String[pairCount];

        int guaranteedMatchIndex = data.consumeInt(0, pairCount - 1);
        int guaranteedInvalidIndex = data.consumeInt(0, pairCount - 1);

        for (int i = 0; i < pairCount; i++) {
            if (i == guaranteedMatchIndex) {
                searchList[i] = needle;
                replacementList[i] = data.consumeBoolean() ? data.consumeString(8) : "";
                continue;
            }

            int kind = data.consumeInt(0, 5);
            switch (kind) {
                case 0:
                    searchList[i] = null;
                    replacementList[i] = data.consumeString(8);
                    break;
                case 1:
                    searchList[i] = data.consumeString(8);
                    replacementList[i] = null;
                    break;
                case 2:
                    searchList[i] = "";
                    replacementList[i] = data.consumeString(8);
                    break;
                case 3:
                    searchList[i] = data.consumeString(8);
                    replacementList[i] = data.consumeString(8);
                    break;
                case 4:
                    searchList[i] = data.consumeAsciiString(8);
                    replacementList[i] = data.consumeAsciiString(8);
                    break;
                default:
                    searchList[i] = data.consumeBoolean() ? needle : data.consumeString(8);
                    replacementList[i] = data.consumeString(8);
                    break;
            }
        }

        if (guaranteedInvalidIndex == guaranteedMatchIndex) {
            guaranteedInvalidIndex = (guaranteedInvalidIndex + 1) % pairCount;
        }
        if (data.consumeBoolean()) {
            searchList[guaranteedInvalidIndex] = null;
            replacementList[guaranteedInvalidIndex] = data.consumeString(8);
        } else {
            searchList[guaranteedInvalidIndex] = data.consumeBoolean() ? data.consumeString(8) : needle;
            replacementList[guaranteedInvalidIndex] = null;
        }

        exerciseWithOracle(text, searchList, replacementList);

        if (data.consumeBoolean()) {
            String[] extraSearch = Arrays.copyOf(searchList, searchList.length + 1);
            String[] extraReplacement = Arrays.copyOf(replacementList, replacementList.length + 1);
            extraSearch[extraSearch.length - 1] = "";
            extraReplacement[extraReplacement.length - 1] = data.consumeString(8);
            exerciseWithOracle(text, extraSearch, extraReplacement);
        }

        String[] mismatchSearch = new String[] { needle };
        String[] mismatchReplacement = new String[0];
        try {
            StringUtils.replaceEach(text, mismatchSearch, mismatchReplacement);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void runAnchorCases() {
        tryReplaceAndCheck(null, new String[] { "a" }, new String[] { "b" }, null);
        tryReplaceAndCheck("aba", null, null, "aba");
        tryReplaceAndCheck("aba", new String[0], null, "aba");
        tryReplaceAndCheck("aba", null, new String[0], "aba");
        tryReplaceAndCheck("aba", new String[] { "a" }, null, "aba");
        tryReplaceAndCheck("aba", new String[] { null }, new String[] { "a" }, "aba");
        tryReplaceAndCheck("aba", new String[] { "a" }, new String[] { null }, "aba");
        tryReplaceAndCheck("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc");
    }

    private static void tryReplaceAndCheck(String text, String[] searchList, String[] replacementList, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (!equalsNullable(expected, actual)) {
                throw new RuntimeException(
                    "[oracle:anchor] metamorphic violation: documented replaceEach result mismatch input="
                        + String.valueOf(text)
                        + " search="
                        + Arrays.toString(searchList)
                        + " repl="
                        + Arrays.toString(replacementList)
                        + " lhs="
                        + String.valueOf(actual)
                        + " rhs="
                        + String.valueOf(expected));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void exerciseWithOracle(String text, String[] searchList, String[] replacementList) {
        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        ArrayList<String> filteredSearch = new ArrayList<String>();
        ArrayList<String> filteredReplacement = new ArrayList<String>();
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            String s = searchList[i];
            String r = replacementList[i];
            if (s == null || s.length() == 0 || r == null) {
                continue;
            }
            filteredSearch.add(s);
            filteredReplacement.add(r);
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(
                text,
                filteredSearch.toArray(new String[0]),
                filteredReplacement.toArray(new String[0]));
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted: replaceEach explicitly skips any pair whose search string is null/empty
         * or whose replacement is null. Therefore adding such skipped pairs must not change the result.
         * A patch that merely suppresses the crash by skipping bookkeeping or whole branches could return
         * the wrong transformed text, and this equivalence would detect that.
         */
        if (!equalsNullable(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:skip-invalid-pairs] metamorphic violation: replaceEach(text, pairs) must equal replaceEach(text, filteredValidPairs) input="
                    + String.valueOf(text)
                    + " search="
                    + Arrays.toString(searchList)
                    + " repl="
                    + Arrays.toString(replacementList)
                    + " lhs="
                    + String.valueOf(lhs)
                    + " rhs="
                    + String.valueOf(rhs));
        }

        int observedLength = StringUtils.length(lhs);
        if (observedLength < 0) {
            throw new RuntimeException("[oracle:length-nonnegative] metamorphic violation: StringUtils.length returned negative value");
        }
    }

    private static boolean equalsNullable(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Validation");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
