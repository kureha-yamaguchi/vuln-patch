        checkEquivalent(validDecimal, validDoubleSuffix, "plain-decimal-vs-double-suffix");
        checkEquivalent(sciLower, sciUpper, "scientific-exp-marker-case");
        checkEquivalent(sciUpper, sciRedundantDecimal, "scientific-redundant-decimal");

        String rawA = data.consumeString(8);
        String rawB = data.consumeString(8);
        String rawC = data.consumeRemainingAsString();
        String mix = (rawA == null ? "" : rawA) + (rawB == null ? "" : rawB) + (rawC == null ? "" : rawC);
        if (mix.length() == 0) {
            mix = "0";
        }

        int p1 = Math.abs(data.consumeInt());
        int p2 = Math.abs(data.consumeInt());
        int len = mix.length();

        int ePos = len == 0 ? 0 : (p1 % (len + 1));
        int EPos = len == 0 ? 0 : (p2 % (len + 1));

        StringBuilder invalidBothMarkers = new StringBuilder(mix);
        invalidBothMarkers.insert(Math.min(ePos, invalidBothMarkers.length()), 'e');
        invalidBothMarkers.insert(Math.min(EPos, invalidBothMarkers.length()), 'E');
        if (data.consumeBoolean()) {
            invalidBothMarkers.insert(0, data.consumeBoolean() ? "-" : "+");
        }
        if (data.consumeBoolean()) {
            invalidBothMarkers.append(data.consumeBoolean() ? 'D' : 'F');
        }
        exerciseSilently(invalidBothMarkers.toString());

        String noDecimalDualMarker = sign + intDigits + "e" + intDigits.charAt(0) + "E";
        exerciseSilently(noDecimalDualMarker);

