        String suffix = data.consumeString(8);
        String text = prefix + match + suffix;

        String absent = findAbsentToken(text, match);
        if (absent == null) {
            absent = "\u0000\u0001";
            if (text.indexOf(absent) >= 0 || match.indexOf(absent) >= 0) {
                return;
            }
        }

        String base = StringUtils.replaceEach(
            text,
            new String[]{match},
            new String[]{replacement}
        );

        String withIgnoredNullPair = StringUtils.replaceEach(
            text,
