        invokeRealEntryPoint(windowed, false);
        checkEqualContentOracle(windowed);

        String arbitraryThree = forceLength3(data.consumeAsciiString(16), data);
        invokeRealEntryPoint(arbitraryThree, false);
        checkEqualContentOracle(arbitraryThree);

        String truthy = buildMixedCaseTruthy(data);
        invokeRealEntryPoint(truthy, true);
        checkTruthyOracle(truthy);

