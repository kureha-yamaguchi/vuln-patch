import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            if (!"org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                continue;
            }
            String m = f.getMethodName();
            if ("createNumber".equals(m)
                    || "createInteger".equals(m)
                    || "isAllZeros".equals(m)
                    || "isDigits".equals(m)
                    || "createLong".equals(m)
                    || "createBigInteger".equals(m)
                    || "createFloat".equals(m)
                    || "createDouble".equals(m)
                    || "createBigDecimal".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static java.math.BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new java.math.BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        java.math.BigDecimal left = toBigDecimal(a);
        java.math.BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static Number parseOrNull(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) || isCleanReject(t)) {
                return null;
            }
            return null;
        }
    }

    private static void exerciseSilently(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                return;
            }
        }
    }

    private static String digitize(String raw, int minLen, char fallbackLast) {
        StringBuilder out = new StringBuilder();
        if (raw != null) {
            for (int i = 0; i < raw.length(); i++) {
                char c = raw.charAt(i);
                if (c >= '0' && c <= '9') {
                    out.append(c);
                } else {
                    out.append((char) ('0' + (c & 7)));
                }
            }
        }
        while (out.length() < minLen) {
            out.append('0');
        }
        boolean allZero = true;
        for (int i = 0; i < out.length(); i++) {
            if (out.charAt(i) != '0') {
                allZero = false;
                break;
            }
        }
        if (allZero && out.length() > 0) {
            out.setCharAt(out.length() - 1, fallbackLast);
        }
        return out.toString();
    }

    private static void checkEquivalent(String a, String b, String oracleId) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA=" + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted below: NumberUtils.createNumber parses valid Java-style numeric
         * strings. The project's own regression test states that "1234.5" is valid and that
         * explicit suffix variants like "1234.5D" denote the same numeric value. A patch that
         * merely suppresses the historical crash or skips the normal parser path could stop
         * throwing yet still fail to parse valid decimals consistently; these oracle checks
         * catch that wrong-output behavior.
         */
        try {
            Number anchor = NumberUtils.createNumber("1234.5");
            Number anchorD = NumberUtils.createNumber("1234.5D");
            if (anchor == null || anchorD == null || !sameNumericValue(anchor, anchorD)) {
                throw new RuntimeException("[oracle:anchor-valid-decimal] metamorphic violation: valid decimal and explicit double suffix must denote the same numeric value inputA=1234.5 inputB=1234.5D lhs=" + anchor + " rhs=" + anchorD);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isRootCause(t) || isCleanReject(t)) {
                throw new RuntimeException("[oracle:anchor-valid-decimal] metamorphic violation: valid decimal literal was not accepted input=1234.5 cause=" + t.getClass().getName(), t);
            }
            return;
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String mant = digitize(data.consumeAsciiString(data.consumeInt(1, 4)), 1, '1');
        String frac = digitize(data.consumeAsciiString(data.consumeInt(1, 3)), 1, '0');
        String exp = digitize(data.consumeAsciiString(data.consumeInt(1, 2)), 1, '0');
        String expSign = data.consumeBoolean() ? "-" : "";

        String decimal = sign + mant + "." + frac;
        String decimalD = decimal + "D";
        String decimald = decimal + "d";
        String decimalF = decimal + "F";
        String decimalf = decimal + "f";

        String scientificLower = sign + mant + "." + frac + "e" + expSign + exp;
        String scientificUpper = sign + mant + "." + frac + "E" + expSign + exp;
        String integralScientificLower = sign + mant + "e" + expSign + exp;
        String integralScientificUpper = sign + mant + "E" + expSign + exp;
        String redundantDecimalScientific = sign + mant + ".0E" + expSign + exp;

        exerciseSilently(decimal);
        exerciseSilently(decimalD);
        exerciseSilently(decimald);
        exerciseSilently(decimalF);
        exerciseSilently(decimalf);
        exerciseSilently(scientificLower);
        exerciseSilently(scientificUpper);
        exerciseSilently(integralScientificLower);
        exerciseSilently(integralScientificUpper);
        exerciseSilently(redundantDecimalScientific);

        checkEquivalent(scientificLower, scientificUpper, "scientific-exp-case-equivalence");
        checkEquivalent(integralScientificLower, integralScientificUpper, "integral-scientific-exp-case-equivalence");

        Number lhs = parseOrNull(decimal);
        Number rhs = parseOrNull(decimalD);
        if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
            throw new RuntimeException("[oracle:decimal-vs-double-suffix] metamorphic violation: plain decimal and explicit double suffix changed numeric value inputA=" + decimal + " inputB=" + decimalD + " lhs=" + lhs + " rhs=" + rhs);
        }

        Number rhs2 = parseOrNull(decimald);
        if (lhs != null && rhs2 != null && !sameNumericValue(lhs, rhs2)) {
            throw new RuntimeException("[oracle:decimal-vs-double-suffix-lower] metamorphic violation: plain decimal and explicit lower-case double suffix changed numeric value inputA=" + decimal + " inputB=" + decimald + " lhs=" + lhs + " rhs=" + rhs2);
        }

        Number iSci = parseOrNull(integralScientificLower);
        Number redundant = parseOrNull(redundantDecimalScientific);
        if (iSci != null && redundant != null && !sameNumericValue(iSci, redundant)) {
            throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: adding redundant .0 before exponent changed numeric value inputA=" + integralScientificLower + " inputB=" + redundantDecimalScientific + " lhs=" + iSci + " rhs=" + redundant);
        }

        String[] observed = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2."
