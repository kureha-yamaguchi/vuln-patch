    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String tag) {
        if (a == null || b == null) {
            throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: compared series must be non-null"
                    + " lhs=" + a + " rhs=" + b);
        }
