package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30", true);
        runCase("\uD800\uDC00", true);
        runCase("\uD834\uDD1E", true);
        runCase("\uDBFF\uDFFD", true);

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));
        int pairs = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        for (int i = 0; i < pairs; i++) {
            sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(6)));
            sb.append(Character.toChars(randomSupplementaryCodePoint(data)));
        }
        sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(6)));
        sb.append(suffix);

        runCase(sb.toString(), true);

        if (data.consumeBoolean()) {
            StringBuilder multi = new StringBuilder();
            int count = data.consumeInt(1, 8);
            for (int i = 0; i < count; i++) {
                if (data.consumeBoolean()) {
                    multi.append(sanitizeCsvSafeAscii(data.consumeAsciiString(5)));
                } else {
                    multi.append(Character.toChars(randomSupplementaryCodePoint(data)));
                }
            }
            runCase(multi.toString(), true);
        }
    }

    private static void runCase(String input, boolean validByConstruction) {
        String result;
        try {
            result = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (validByConstruction) {
            /*
             * Contract used for this post-condition:
             * StringEscapeUtils.escapeCsv returns a String enclosed in quotes only "if required".
             * For strings we construct without ',', '"', '\r', or '\n', quoting/escaping is not required,
             * so a correct implementation must return the input unchanged.
             * A patch that merely suppresses the crash or skips translation work can violate this.
             */
            if (!input.equals(result)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(result) + " rhs=" + printable(input));
            }
        }
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        return data.consumeInt(0x10000, 0x10FFFF);
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
