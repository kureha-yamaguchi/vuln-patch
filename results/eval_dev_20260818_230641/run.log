        String sign = data.consumeBoolean() ? "-" : "";
        String mant = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 6)), 1, '1');
        String exp = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 3)), 1, '0');

