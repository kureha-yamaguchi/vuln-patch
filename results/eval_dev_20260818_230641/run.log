public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorInputs();

        String prefix = data.consumeAsciiString(16);
        String suffix = data.consumeRemainingAsString();

        int n = data.consumeInt(0, 6);
        String[] searchList = new String[n];
        String[] replacementList = new String[n];

        boolean hasValidSearch = false;
        String chosenValidSearch = null;

        for (int i = 0; i < n; i++) {
            searchList[i] = fuzzElement(data);
            replacementList[i] = fuzzElement(data);

            if (searchList[i] != null && searchList[i].length() > 0) {
                hasValidSearch = true;
                if (chosenValidSearch == null && data.consumeBoolean()) {
                    chosenValidSearch = searchList[i];
                }
            }
        }

        if (chosenValidSearch == null && hasValidSearch) {
            for (int i = 0; i < n; i++) {
                if (searchList[i] != null && searchList[i].length() > 0) {
                    chosenValidSearch = searchList[i];
                    break;
                }
            }
        }

        String text = prefix;
        if (chosenValidSearch != null && data.consumeBoolean()) {
            text += chosenValidSearch;
        }
        text += suffix;
        if (text == null) {
            text = "";
        }

        tryMetamorphicFilterNullAndEmptyEntries(text, searchList, replacementList);
    }

