package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            if (!"org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                continue;
            }
            String m = f.getMethodName();
            if ("createNumber".equals(m)
                    || "createInteger".equals(m)
                    || "isAllZeros".equals(m)
                    || "charAt".equals(m)
                    || "substring".equals(m)
                    || "isDigits".equals(m)
                    || "createLong".equals(m)
                    || "createBigInteger".equals(m)
                    || "createFloat".equals(m)
                    || "createDouble".equals(m)
                    || "createBigDecimal".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && hasRelevantStack(t);
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static void parseAndMaybePropagate(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static Number parseOrNull(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return null;
            }
            return null;
        }
    }

    private static java.math.BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new java.math.BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        java.math.BigDecimal left = toBigDecimal(a);
        java.math.BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static void checkEquivalent(String a, String b, String oracleId) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            /*
             * Contract asserted: createNumber parses numeric strings, so two accepted strings
             * that denote the same numeric quantity must produce numerically equal results.
             * Here the strings differ only by exponent-marker case or by adding a redundant ".0"
             * before the exponent; a throw-deleting or branch-skipping patch could stop crashing
             * yet still split mantissa/exponent incorrectly and violate this relation.
             */
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static String digitsOnly(String s, boolean forceNonZero) {
        if (s == null) {
            s = "";
        }
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            } else {
                out.append((char) ('0' + (c & 7)));
            }
        }
        if (out.length() == 0) {
            out.append(forceNonZero ? '1' : '0');
        }
        if (forceNonZero) {
            boolean allZero = true;
            for (int i = 0; i < out.length(); i++) {
                if (out.charAt(i) != '0') {
                    allZero = false;
                    break;
                }
            }
            if (allZero) {
                out.setCharAt(out.length() - 1, '1');
            }
        }
        return out.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (!isCleanReject(t)) {
                return;
            }
        }

        String[] anchors = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "-0xFADE",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2."
        };
        for (int i = 0; i < anchors.length; i++) {
            parseAndMaybePropagate(anchors[i]);
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String intDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 8)), true);
        String fracDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 6)), false);
        String expDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 4)), false);
        String expSign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';

        String suffix = "";
        switch (data.consumeInt(0, 4)) {
            case 1:
                suffix = "d";
                break;
            case 2:
                suffix = "D";
                break;
            case 3:
                suffix = "f";
                break;
            case 4:
                suffix = "F";
                break;
            default:
                break;
        }

        String plainDecimal = sign + intDigits + "." + fracDigits;
        String plainDecimalSuffix = plainDecimal + suffix;
        String integral = sign + intDigits;
        String integralLong = integral + (data.consumeBoolean() ? "L" : "l");
        String scientific = sign + intDigits + expMarker + expSign + expDigits;
        String scientificOppCase = sign + intDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String decimalScientific = sign + intDigits + "." + fracDigits + expMarker + expSign + expDigits;
        String decimalScientificOppCase = sign + intDigits + "." + fracDigits + (expMarker == 'e' ? 'E' : 'e') + expSign + expDigits;
        String redundantPointScientific = sign + intDigits + ".0" + expMarker + expSign + expDigits;
        String decimalScientificSuffix = decimalScientific + suffix;
        String decimalScientificOppCaseSuffix = decimalScientificOppCase + suffix;

        parseAndMaybePropagate(plainDecimal);
        parseAndMaybePropagate(plainDecimalSuffix);
        parseAndMaybePropagate(integral);
        parseAndMaybePropagate(integralLong);
        parseAndMaybePropagate(scientific);
        parseAndMaybePropagate(decimalScientific);
        parseAndMaybePropagate(decimalScientificSuffix);

        checkEquivalent(scientific, scientificOppCase, "scientific-exp-case-equivalence");
        checkEquivalent(decimalScientific, decimalScientificOppCase, "decimal-scientific-exp-case-equivalence");
        checkEquivalent(scientific, redundantPointScientific, "redundant-decimal-before-exponent");
        if (suffix.length() > 0) {
            checkEquivalent(decimalScientificSuffix, decimalScientificOppCaseSuffix, "decimal-scientific-exp-case-equivalence-suffix");
        }

        Number parsedIntegral = parseOrNull(integral);
        if (parsedIntegral != null) {
            try {
                Number parsedLong = NumberUtils.createNumber(integralLong);
                if (parsedLong != null && !sameNumericValue(parsedIntegral, parsedLong)) {
                    throw new RuntimeException("[oracle:integral-vs-long-suffix] metamorphic violation: integral string and same string with long suffix must denote the same numeric value inputA="
                            + integral + " inputB=" + integralLong + " lhs=" + parsedIntegral + " rhs=" + parsedLong);
                }
            } catch (RuntimeException t) {
                if (isOracleFailure(t) || isRootCause(t)) {
                    throw t;
                }
            }
        }

        String extraPrefix = data.consumeString(3);
        String extraSuffix = data.consumeRemainingAsString();
        if (extraPrefix == null) {
            extraPrefix = "";
        }
        if (extraSuffix == null) {
            extraSuffix = "";
        }
        parseOrNull(extraPrefix + plainDecimal + extraSuffix);
    }
}
