    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if (!"org.apache.commons.lang.NumberUtils".equals(ste.getClassName())) {
                continue;
            }
            String m = ste.getMethodName();
            if ("createNumber".equals(m)
                    || "createInteger".equals(m)
                    || "isAllZeros".equals(m)
                    || "charAt".equals(m)
                    || "substring".equals(m)
                    || "isDigits".equals(m)
                    || "createLong".equals(m)
                    || "createBigInteger".equals(m)
                    || "createFloat".equals(m)
                    || "createDouble".equals(m)
                    || "createBigDecimal".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String buildDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String buildOverflowDigits(FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            return "9223372036854775808";
        }
        int extra = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder(19 + extra);
        sb.append('9');
        for (int i = 1; i < 19 + extra; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean isCreateNumberValidIntegralLongSuffixInput(String s) {
        if (s == null || s.length() < 2) {
            return false;
        }
        char last = s.charAt(s.length() - 1);
        if (last != 'l' && last != 'L') {
            return false;
        }
        String numeric = s.substring(0, s.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        int start = 0;
        char first = numeric.charAt(0);
        if (first == '+' || first == '-') {
            if (numeric.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < numeric.length(); i++) {
            if (!Character.isDigit(numeric.charAt(i))) {
                return false;
            }
        }
        return true;
    }
}
