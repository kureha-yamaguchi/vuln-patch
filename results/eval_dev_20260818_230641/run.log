package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off");

        String raw3 = fitToLength(data.consumeString(8), 3, 'x');
        invokeRealEntryPoint(raw3);
        checkEqualContentOracle(raw3);

        String ascii3 = fitToLength(data.consumeAsciiString(8), 3, 'x');
        invokeRealEntryPoint(ascii3);
        checkEqualContentOracle(ascii3);

        String t3 = "t" + fitToLength(data.consumeAsciiString(2), 2, 'x');
        invokeRealEntryPoint(t3);
        checkEqualContentOracle(t3);

        String upperT3 = "T" + fitToLength(data.consumeAsciiString(2), 2, 'x');
        invokeRealEntryPoint(upperT3);
        checkEqualContentOracle(upperT3);

        String y3 = "y" + fitToLength(data.consumeAsciiString(2), 2, 'x');
        invokeRealEntryPoint(y3);
        checkEqualContentOracle(y3);

        String yesVariant = randomizeCase("yes", data);
        checkTruthyOracle(yesVariant);

        String any = data.consumeRemainingAsString();
        invokeRealEntryPoint(any);
        checkEqualContentOracle(any);
    }

    private static void invokeRealEntryPoint(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: BooleanUtils.toBoolean is a parser over String content. The implementation's
               identity fast-path only optimizes the interned literal "true"; equal-content distinct
               String instances must still parse identically. A patch that merely suppresses a crash by
               returning a representation-dependent answer would violate this observable behavior. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract: documented truthy tokens are parsed case-insensitively by this API; "yes" is
               accepted in any mixture of case, and equal-content distinct String objects must agree.
               A throw-deleting or overfitted patch that makes the reachable 3-char branch simply return
               false would break this without throwing. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static String fitToLength(String s, int len, char pad) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuffer b = new StringBuffer(len);
        b.append(s);
        while (b.length() < len) {
            b.append(pad);
        }
        return b.toString();
    }

    private static String randomizeCase(String base, FuzzedDataProvider data) {
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
