private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException("[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input=" + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }
