package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", false);

        String raw = data.consumeString(32);
        String ascii = data.consumeAsciiString(32);

        invokeRealEntryPoint(raw, false);
        invokeRealEntryPoint(ascii, false);

        String len3 = buildLengthThreeCandidate(data, raw, ascii);
        invokeRealEntryPoint(len3, false);
        checkEqualContentOracle(len3);

        String tLike = buildTLikeLengthThree(data);
        invokeRealEntryPoint(tLike, false);
        checkEqualContentOracle(tLike);

        String yLike = buildYLikeLengthThree(data);
        invokeRealEntryPoint(yLike, false);
        checkEqualContentOracle(yLike);

        String token = buildTruthyToken(data);
        invokeRealEntryPoint(token, true);
        checkTruthyOracle(token);

        checkEqualContentOracle(raw);
        checkEqualContentOracle(ascii);
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isOracleSignal(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (validByConstruction && isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void checkEqualContentOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            /* Contract/oracle: this parser is defined by String content, not object identity.
               The implementation itself special-cases only the interned literal "true" as an optimization,
               so equal-content distinct String instances must still parse identically. A patch that merely
               suppresses the crashing path or makes one representation unreachable would violate this. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s.toLowerCase());
            /* Contract/oracle: documented/tested accepted truthy tokens ("on", "yes", "true") are parsed
               case-insensitively by this API. For a valid-by-construction mixed-case truthy token, parsing
               it and its lowercase equivalent must agree, and the result must be true. A throw-deleting or
               overfitted patch that simply returns false on the patched path breaks this observable behavior. */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:truthy-eq] metamorphic violation: case-insensitive truthy token must match lowercase input="
                        + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException(
                    "[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input="
                        + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (isOracleSignal(t) || isRootCause(t)) {
                throw t;
            }
        }
    }

    private static String buildLengthThreeCandidate(FuzzedDataProvider data, String a, String b) {
        String src = data.consumeBoolean() ? a : b;
        if (src == null) {
            src = "";
        }
        if (src.length() >= 3) {
            int start = data.consumeInt(0, src.length() - 3);
            return src.substring(start, start + 3);
        }
        String pad = src + data.consumeAsciiString(3);
        while (pad.length() < 3) {
            pad += "x";
        }
        return pad.substring(0, 3);
    }

    private static String buildTLikeLengthThree(FuzzedDataProvider data) {
        char first = data.consumeBoolean() ? 't' : 'T';
        String tail = data.consumeAsciiString(2);
        while (tail.length() < 2) {
            tail += "x";
        }
        return new String(new char[] { first, tail.charAt(0), tail.charAt(1) });
    }

    private static String buildYLikeLengthThree(FuzzedDataProvider data) {
        char first = data.consumeBoolean() ? 'y' : 'Y';
        String tail = data.consumeAsciiString(2);
        while (tail.length() < 2) {
            tail += data.consumeBoolean() ? "e" : "s";
        }
        return new String(new char[] { first, tail.charAt(0), tail.charAt(1) });
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int choice = data.consumeInt(0, 2);
        if (choice == 0) {
            return mixCase("yes", data);
        }
        if (choice == 1) {
            return mixCase("on", data);
        }
        return mixCase("true", data);
    }

    private static String mixCase(String s, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(Character.toLowerCase(ch));
            }
        }
        return sb.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isCleanRejection(Throwable t) {
        return isValidationFamily(t);
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
