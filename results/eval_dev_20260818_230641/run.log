            // comma, quote, CR, or LF. All inputs below are built to exclude those characters,
            // so a correct implementation must return the original string verbatim.
            if (!input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for CSV-safe input input="
                        + String.valueOf(input) + " lhs=" + String.valueOf(out) + " rhs=" + String.valueOf(input));
            }
