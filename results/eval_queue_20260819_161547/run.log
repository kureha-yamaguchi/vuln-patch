    private static boolean isLikelyRootCause(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "doIteration".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "doOptimize".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.AbstractLinearOptimizer".equals(cls)
                    && "incrementIterationsCounter".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getEntry".equals(method)
                            || "getNumObjectiveFunctions".equals(method)
                            || "getHeight".equals(method)
                            || "getWidth".equals(method)
                            || "getNumArtificialVariables".equals(method)
                            || "getArtificialVariableOffset".equals(method)
                            || "getBasicRow".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
            case EQ:
                if (!Precision.equals(result, c.getValue(), epsilon)) {
                    return false;
                }
                break;

            case GEQ:
                if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                    return false;
                }
                break;

            case LEQ:
                if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                    return false;
                }
                break;
            default:
                return false;
            }
        }

        return true;
    }

    private static boolean allZero(double[] v) {
        for (int i = 0; i < v.length; i++) {
            if (v[i] != 0.0d) {
                return false;
            }
        }
        return true;
    }

    private static final class SolveOutcome {
        boolean success;
        boolean rootCauseMaxCount;
        boolean cleanRejection;
        PointValuePair solution;
        double value;
    }
}
