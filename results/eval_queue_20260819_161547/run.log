            SimplexSolver solver1 = new SimplexSolver(epsilon, maxUlps);
            SimplexSolver solver2 = new SimplexSolver(epsilon, maxUlps);
            solver1.setMaxIterations(100);
            solver2.setMaxIterations(100);

            PointValuePair p1 = null;
            PointValuePair p2 = null;
            Throwable ex1 = null;
            Throwable ex2 = null;

            ArrayList<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
            if (permuted.size() > 2) {
