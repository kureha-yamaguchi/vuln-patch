package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.ParsePosition;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Object[] ANCHOR_ARGS = new Object[] {"DUMMY"};

    private static Map makeRegistry() {
        Map registry = new HashMap();
        registry.put("lower", new LowerCaseFormatFactory());
        registry.put("upper", new UpperCaseFormatFactory());
        return registry;
    }

    private static String sanitizeLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "x";
        }
        StringBuffer sb = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\'' || c == '{' || c == '}' || c < 32) {
                sb.append((char) ('a' + (i % 26)));
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('x');
        }
        return sb.toString();
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validation") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasReachableRootFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(cls)
                    && ("appendQuotedString".equals(m)
                        || "next".equals(m)
                        || "append".equals(m)
                        || "startsWith".equals(m))) {
                return true;
            }
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("append".equals(m) || "startsWith".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static void handleThrowable(Throwable t) {
        if (isOracle(t)) {
            throw (RuntimeException) t;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (t instanceof OutOfMemoryError && hasReachableRootFrame(t)) {
            throw (OutOfMemoryError) t;
        }
    }

    private static void exercise(String pattern, Object[] args, boolean checkAnchorOutput) {
        try {
            Map registry = makeRegistry();
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            String toPatternBefore = emf.toPattern();
            String formatted = emf.format(args);
            String toPatternAfter = emf.toPattern();

            // format(...) is read-only for the pattern; toPattern must not change across formatting.
            if (toPatternBefore == null ? toPatternAfter != null : !toPatternBefore.equals(toPatternAfter)) {
                throw new RuntimeException("[oracle:toPattern-stable] metamorphic violation: format mutated toPattern input="
                        + pattern + " before=" + toPatternBefore + " after=" + toPatternAfter);
            }

            // toPattern() should describe an equivalent pattern; rebuilding from it must preserve formatting.
            ExtendedMessageFormat emf2 = new ExtendedMessageFormat(toPatternBefore, registry);
            String formatted2 = emf2.format(args);
            String toPatternRoundTrip = emf2.toPattern();
            if (formatted == null ? formatted2 != null : !formatted.equals(formatted2)) {
                throw new RuntimeException("[oracle:roundtrip-format] metamorphic violation: rebuild-from-toPattern changed output input="
                        + pattern + " lhs=" + formatted + " rhs=" + formatted2);
            }
            if (toPatternBefore == null ? toPatternRoundTrip != null : !toPatternBefore.equals(toPatternRoundTrip)) {
                throw new RuntimeException("[oracle:roundtrip-pattern] metamorphic violation: toPattern not idempotent input="
                        + pattern + " lhs=" + toPatternBefore + " rhs=" + toPatternRoundTrip);
            }

            if (checkAnchorOutput) {
                String expected = "it's a dummy test!";
                if (!expected.equals(formatted)) {
                    throw new RuntimeException("[oracle:anchor-output] metamorphic violation: exact regression input="
                            + pattern + " lhs=" + formatted + " rhs=" + expected);
                }
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor = "it''s a {0,lower} 'test'!";
        exercise(anchor, ANCHOR_ARGS, true);

        String a = sanitizeLiteral(data.consumeAsciiString(16));
        String b = sanitizeLiteral(data.consumeAsciiString(16));
        String c = sanitizeLiteral(data.consumeAsciiString(16));
        String d = sanitizeLiteral(data.consumeAsciiString(16));
        String arg = sanitizeLiteral(data.consumeAsciiString(24));

        int variant = data.consumeInt(0, 5);
        String pattern;
        switch (variant) {
            case 0:
                pattern = "''" + a + " {0,lower} '" + b + "'";
                break;
            case 1:
                pattern = a + "''" + b + " {0,lower} '" + c + "'!";
                break;
            case 2:
                pattern = a + " {0,lower} ''" + b + " '" + c + "'";
                break;
            case 3:
                pattern = a + "''" + b + " {0,upper} '" + c + "''" + d + "'";
                break;
            case 4:
                pattern = a + " {0,lower} '" + b + "' ''" + c;
                break;
            default:
                pattern = a + "''" + b + " {0,lower}";
                break;
        }

        exercise(pattern, new Object[] {arg}, false);
    }

    private static final class LowerCaseFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new LowerCaseFormat();
        }
    }

    private static final class UpperCaseFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new UpperCaseFormat();
        }
    }

    private static final class LowerCaseFormat extends Format {
        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            String s = obj == null ? "null" : String.valueOf(obj);
            return toAppendTo.append(s.toLowerCase());
        }

        public Object parseObject(String source, ParsePosition pos) {
            int start = pos.getIndex();
            pos.setIndex(source.length());
            return source.substring(start).toLowerCase();
        }
    }

    private static final class UpperCaseFormat extends Format {
        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            String s = obj == null ? "null" : String.valueOf(obj);
            return toAppendTo.append(s.toUpperCase());
        }

        public Object parseObject(String source, ParsePosition pos) {
            int start = pos.getIndex();
            pos.setIndex(source.length());
            return source.substring(start).toUpperCase();
        }
    }
}
