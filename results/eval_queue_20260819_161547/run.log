    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LinearObjectiveFunction objective = buildObjective();

        ArrayList<LinearConstraint> anchor = buildAnchorLikeConstraints(
                91.0,
                54.0,
                62.0,
                -44.0,
                0,
                data);
        maybeSolveIfBugShape(objective, anchor, 1.0e-6, 10, true);

        int attempts = 8;
        for (int i = 0; i < attempts; i++) {
            double rhs1 = data.consumeInt(40, 120);
            double rhs2 = data.consumeInt(40, 120);
            double rhs3 = data.consumeInt(40, 120);
            double rhs4 = -data.consumeInt(1, 120);
            int extras = data.consumeInt(0, 3);

            ArrayList<LinearConstraint> candidate =
                    buildAnchorLikeConstraints(rhs1, rhs2, rhs3, rhs4, extras, data);
            maybeSolveIfBugShape(objective, candidate, 1.0e-6, data.consumeInt(1, 20), data.consumeBoolean());
        }

        ArrayList<LinearConstraint> fallback =
                buildAnchorLikeConstraints(91.0, 54.0, 62.0, -44.0, 3, data);
        new SimplexSolver(1.0e-6, 10).optimize(objective, fallback, GoalType.MINIMIZE, true);
    }

    private static void maybeSolveIfBugShape(LinearObjectiveFunction objective,
                                             Collection<LinearConstraint> constraints,
                                             double epsilon,
                                             int maxUlps,
                                             boolean nonNegative) {
        SimplexTableau tableau =
                new SimplexTableau(objective, constraints, GoalType.MINIMIZE, nonNegative, epsilon, maxUlps);
        int pivotCol = getPivotColumnLikeSolver(tableau);
        if (pivotCol >= 0 && hasPatchedBranchShape(tableau, pivotCol, maxUlps)) {
            new SimplexSolver(epsilon, maxUlps).optimize(objective, constraints, GoalType.MINIMIZE, nonNegative);
        }
    }

    private static int getPivotColumnLikeSolver(SimplexTableau tableau) {
        double minValue = 0.0;
        int minPos = -1;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (entry < minValue) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos;
    }

    private static boolean hasPatchedBranchShape(SimplexTableau tableau, int col, int maxUlps) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);
            if (org.apache.commons.math3.util.Precision.compareTo(entry, 0.0, maxUlps) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }

        if (minRatioPositions.size() <= 1) {
            return false;
        }

        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                double entry = tableau.getEntry(row.intValue(), column);
                Integer basicRow = tableau.getBasicRow(column);
                if (org.apache.commons.math3.util.Precision.equals(entry, 1.0, maxUlps)
                        && row.equals(basicRow)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static LinearObjectiveFunction buildObjective() {
        double[] c = new double[31];
        c[0] = 1.0;
        return new LinearObjectiveFunction(c, 0.0);
    }

