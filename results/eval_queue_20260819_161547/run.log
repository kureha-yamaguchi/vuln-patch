package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.exception.NoFeasibleSolutionException;
import org.apache.commons.math3.exception.UnboundedSolutionException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryAnchorLikeCases();
        tryFuzzedCases(data);
    }

    private static void tryAnchorLikeCases() {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] {1.0, 0.0}, 0.0);

        ArrayList<LinearConstraint> base = new ArrayList<LinearConstraint>();
        base.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.GEQ, 1.0));
        base.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.LEQ, 1.0));
        base.add(new LinearConstraint(new double[] {0.0, 1.0}, Relationship.LEQ, 2.0));

        ArrayList<LinearConstraint> dupGeq = new ArrayList<LinearConstraint>(base);
        dupGeq.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.GEQ, 1.0));

        ArrayList<LinearConstraint> dupLeq = new ArrayList<LinearConstraint>(base);
        dupLeq.add(new LinearConstraint(new double[] {1.0, 0.0}, Relationship.LEQ, 1.0));

        exerciseEquivalentProblems(f, base, dupGeq, 10);
        exerciseEquivalentProblems(f, base, dupLeq, 10);

        LinearObjectiveFunction f2 = new LinearObjectiveFunction(new double[] {1.0, 1.0, 0.0}, 0.0);
        ArrayList<LinearConstraint> base2 = new ArrayList<LinearConstraint>();
        base2.add(new LinearConstraint(new double[] {1.0, 1.0, 0.0}, Relationship.GEQ, 2.0));
        base2.add(new LinearConstraint(new double[] {1.0, 1.0, 0.0}, Relationship.LEQ, 2.0));
        base2.add(new LinearConstraint(new double[] {1.0, 0.0, 1.0}, Relationship.LEQ, 3.0));
        base2.add(new LinearConstraint(new double[] {0.0, 1.0, 1.0}, Relationship.LEQ, 3.0));

        ArrayList<LinearConstraint> dupEqPair = new ArrayList<LinearConstraint>(base2);
        dupEqPair.add(new LinearConstraint(new double[] {1.0, 1.0, 0.0}, Relationship.GEQ, 2.0));
        exerciseEquivalentProblems(f2, base2, dupEqPair, 10);
    }

    private static void tryFuzzedCases(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 6);
        int extra = data.consumeInt(0, 4);

        double[] objective = new double[vars];
        objective[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            objective[i] = data.consumeInt(-3, 3);
        }
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, data.consumeInt(-3, 3));

        double[] eq = new double[vars];
        int pivotVar = data.consumeInt(0, vars - 1);
        eq[pivotVar] = 1.0;
        for (int i = 0; i < vars; i++) {
            if (i != pivotVar) {
                eq[i] += data.consumeInt(-2, 2);
            }
        }
        double rhs = data.consumeInt(0, 5);

        ArrayList<LinearConstraint> base = new ArrayList<LinearConstraint>();
        base.add(new LinearConstraint(eq, Relationship.GEQ, rhs));
        base.add(new LinearConstraint(eq, Relationship.LEQ, rhs));

        for (int k = 0; k < extra; k++) {
            double[] c = new double[vars];
            int kind = data.consumeInt(0, 2);
            for (int i = 0; i < vars; i++) {
                c[i] = data.consumeInt(-3, 4);
            }
            if (allZero(c)) {
                c[data.consumeInt(0, vars - 1)] = 1.0;
            }
            double b = data.consumeInt(0, 8);
            Relationship r = kind == 0 ? Relationship.LEQ : (kind == 1 ? Relationship.GEQ : Relationship.EQ);
            base.add(new LinearConstraint(c, r, b));
        }

        ArrayList<LinearConstraint> dup = new ArrayList<LinearConstraint>(base);
        if (data.consumeBoolean()) {
            dup.add(new LinearConstraint(eq, Relationship.GEQ, rhs));
        } else {
            dup.add(new LinearConstraint(eq, Relationship.LEQ, rhs));
        }

        if (!looksLikePatchedConditionRegion(f, base, 10) && !looksLikePatchedConditionRegion(f, dup, 10)) {
            return;
        }

        exerciseEquivalentProblems(f, base, dup, 10);
    }

    private static void exerciseEquivalentProblems(
            LinearObjectiveFunction f,
            List<LinearConstraint> a,
            List<LinearConstraint> b,
            int maxUlps) {

        SolveOutcome oa = solve(f, a, maxUlps);
        SolveOutcome ob = solve(f, b, maxUlps);

        if (oa.cleanRejection || ob.cleanRejection) {
            return;
        }

        if (oa.rootCauseMaxCount && ob.success) {
            throw new RuntimeException("[oracle:dup-constraint] metamorphic violation: adding a duplicate constraint must not be required for convergence base=maxCount duplicate=value " + ob.value);
        }
        if (ob.rootCauseMaxCount && oa.success) {
            throw new RuntimeException("[oracle:dup-constraint] metamorphic violation: adding a duplicate constraint must not change a solvable LP into non-convergence base=value " + oa.value + " duplicate=maxCount");
        }

        if (oa.success && ob.success) {
            double delta = Math.abs(oa.value - ob.value);
            if (delta > 1.0e-6) {
                throw new RuntimeException("[oracle:dup-constraint] metamorphic violation: duplicate constraint changed optimum base=" + oa.value + " duplicate=" + ob.value);
            }
            /* Contract asserted: PointValuePair reports a point and a value for the solved objective.
               A correct implementation must have reported value == objective(point). A patch that only
               silences the looping symptom but returns stale/wrong bookkeeping will violate this. */
            assertObjectiveConsistency(f, oa.solution, "base");
            assertObjectiveConsistency(f, ob.solution, "duplicate");
        }
    }

    private static void assertObjectiveConsistency(
            LinearObjectiveFunction f, PointValuePair solution, String tag) {
        double recomputed = f.getValue(solution.getPoint());
        double reported = solution.getValue();
        if (!(Math.abs(recomputed - reported) <= 1.0e-6)) {
            throw new RuntimeException("[oracle:objective-self] metamorphic violation: reported objective disagrees with objective(point) tag=" + tag + " reported=" + reported + " recomputed=" + recomputed);
        }
    }

    private static boolean looksLikePatchedConditionRegion(
            LinearObjectiveFunction f,
            List<LinearConstraint> constraints,
            int maxUlps) {
        try {
            SimplexTableau tableau =
                    new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, EPS, maxUlps);
            if (tableau.getNumArtificialVariables() <= 0) {
                return false;
            }

            for (int col = tableau.getNumObjectiveFunctions(); col < tableau.getWidth() - 1; col++) {
                ArrayList<Integer> minRatioPositions = new ArrayList<Integer>();
                double minRatio = Double.MAX_VALUE;
                for (int row = tableau.getNumObjectiveFunctions(); row < tableau.getHeight(); row++) {
                    final double rhs = tableau.getEntry(row, tableau.getWidth() - 1);
                    final double entry = tableau.getEntry(row, col);
                    if (Precision.compareTo(entry, 0d, maxUlps) > 0) {
                        final double ratio = rhs / entry;
                        final int cmp = Double.compare(ratio, minRatio);
                        if (cmp == 0) {
                            minRatioPositions.add(row);
                        } else if (cmp < 0) {
                            minRatio = ratio;
                            minRatioPositions.clear();
                            minRatioPositions.add(row);
                        }
                    }
                }

                if (minRatioPositions.size() <= 1) {
                    continue;
                }

                boolean hasArtificialBasicTiedRow = false;
                boolean hasOtherTiedRow = false;
                for (Integer row : minRatioPositions) {
                    boolean artificialBasic = false;
                    for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                        int artificialColumn = i + tableau.getArtificialVariableOffset();
                        double artificialEntry = tableau.getEntry(row, artificialColumn);
                        Integer basicRow = tableau.getBasicRow(artificialColumn);
                        if (Precision.equals(artificialEntry, 1d, maxUlps)
                                && row.equals(basicRow)) {
                            artificialBasic = true;
                            hasArtificialBasicTiedRow = true;
                            break;
                        }
                    }
                    if (!artificialBasic) {
                        hasOtherTiedRow = true;
                    }
                }
                if (hasArtificialBasicTiedRow && hasOtherTiedRow) {
                    return true;
                }
            }
        } catch (IllegalArgumentException e) {
            return false;
        } catch (MathIllegalArgumentException e) {
            return false;
        } catch (RuntimeException e) {
            return false;
        }
        return false;
    }

    private static SolveOutcome solve(
            LinearObjectiveFunction f,
            List<LinearConstraint> constraints,
            int maxUlps) {
        SolveOutcome out = new SolveOutcome();
        try {
            SimplexSolver solver = new SimplexSolver(EPS, maxUlps);
            PointValuePair solution = solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
            out.success = true;
            out.solution = solution;
            out.value = solution.getValue();

            if (!validSolution(solution, constraints, 1.0e-6)) {
                throw new RuntimeException("[oracle:solution-satisfies] metamorphic violation: solver returned a point that violates its own constraints");
            }
            return out;
        } catch (MaxCountExceededException e) {
            if (isLikelyRootCause(e)) {
                out.rootCauseMaxCount = true;
                return out;
            }
            out.cleanRejection = true;
            return out;
        } catch (NoFeasibleSolutionException e) {
            out.cleanRejection = true;
            return out;
        } catch (UnboundedSolutionException e) {
            out.cleanRejection = true;
            return out;
        } catch (IllegalArgumentException e) {
            out.cleanRejection = true;
            return out;
        } catch (MathIllegalArgumentException e) {
            out.cleanRejection = true;
