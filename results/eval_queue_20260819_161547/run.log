    private static void runFuzzedCandidates(FuzzedDataProvider data) {
        int attempts = 32 + data.consumeInt(0, 32);
        for (int attempt = 0; attempt < attempts; attempt++) {
            int vars = data.consumeInt(3, 6);
            int[] witness = new int[vars];
            int[] upper = new int[vars];
            for (int i = 0; i < vars; i++) {
                witness[i] = data.consumeInt(0, 2);
                upper[i] = witness[i] + data.consumeInt(1, 3);
            }

            double[] objective = new double[vars];
            objective[0] = 1.0;
            for (int i = 1; i < vars; i++) {
                objective[i] = data.consumeInt(-1, 1);
            }

            ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
            addUpperBounds(constraints, upper);

            int eqCount = data.consumeInt(2, 5);
            for (int e = 0; e < eqCount; e++) {
                double[] coeffs = new double[vars];
                int nonZero = 0;
                for (int i = 0; i < vars; i++) {
                    int v = data.consumeInt(0, 3);
                    coeffs[i] = v;
                    if (v != 0) {
                        nonZero++;
                    }
                }
                if (nonZero == 0) {
                    coeffs[data.consumeInt(0, vars - 1)] = 1.0;
                }
                double rhs = dot(coeffs, witness);
                addEqualityWithDuplicateLeq(constraints, coeffs, rhs);

                if (data.consumeBoolean()) {
                    constraints.add(new LinearConstraint(coeffs, Relationship.GEQ, rhs));
                } else {
                    constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, rhs));
                }
            }

            int extras = data.consumeInt(0, 4);
            for (int k = 0; k < extras; k++) {
                double[] coeffs = new double[vars];
                int nonZero = 0;
                for (int i = 0; i < vars; i++) {
                    int v = data.consumeInt(-2, 3);
                    coeffs[i] = v;
                    if (v != 0) {
                        nonZero++;
                    }
                }
                if (nonZero == 0) {
                    coeffs[data.consumeInt(0, vars - 1)] = 1.0;
                }
                double atWitness = dot(coeffs, witness);
                if (data.consumeBoolean()) {
                    constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, atWitness + data.consumeInt(0, 2)));
                } else {
                    constraints.add(new LinearConstraint(coeffs, Relationship.GEQ, atWitness - data.consumeInt(0, 2)));
                }
            }

            maybeSolve(objective, constraints);
        }
    }

    private static void maybeSolve(double[] objective, List<LinearConstraint> constraints) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        if (oldAndNewPivotChoicesDiffer(f, constraints)) {
            new SimplexSolver(EPS, MAX_ULPS).optimize(f, constraints, GoalType.MAXIMIZE, true);
        }
    }

    private static boolean oldAndNewPivotChoicesDiffer(
            LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        SimplexTableau tableau;
        try {
            tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, EPS, MAX_ULPS);
        } catch (IllegalArgumentException e) {
            return false;
        }

        for (int col = tableau.getNumObjectiveFunctions(); col < tableau.getWidth() - 1; col++) {
            Integer oldRow = computeOldPivotRow(tableau, col);
            Integer newRow = computeNewPivotRow(tableau, col);
            if (oldRow != null && newRow != null && !oldRow.equals(newRow)) {
                return true;
            }
        }
        return false;
    }

    private static Integer computeOldPivotRow(SimplexTableau tableau, int col) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, MAX_ULPS) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }

        if (minRatioPositions.size() == 0) {
            return null;
        } else if (minRatioPositions.size() > 1) {
            for (Integer row : minRatioPositions) {
                for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                    int column = i + tableau.getArtificialVariableOffset();
                    double entry = tableau.getEntry(row.intValue(), column);
                    if (Precision.equals(entry, 1d, MAX_ULPS)
                            && row.equals(tableau.getBasicRow(column))) {
                        return row;
                    }
                }
            }

            Integer minRow = null;
            int minIndex = tableau.getWidth();
            for (Integer row : minRatioPositions) {
                int i = tableau.getNumObjectiveFunctions();
                for (; i < tableau.getWidth() - 1 && minRow != row; i++) {
                    if (row.equals(tableau.getBasicRow(i))) {
                        if (i < minIndex) {
                            minIndex = i;
                            minRow = row;
                        }
                    }
                }
            }
            return minRow;
        }
        return minRatioPositions.get(0);
    }

    private static Integer computeNewPivotRow(SimplexTableau tableau, int col) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, MAX_ULPS) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }

        if (minRatioPositions.size() == 0) {
            return null;
        } else if (minRatioPositions.size() > 1) {
            Integer minRow = null;
            int minIndex = tableau.getWidth();
            for (Integer row : minRatioPositions) {
                int i = tableau.getNumObjectiveFunctions();
                for (; i < tableau.getWidth() - 1 && minRow != row; i++) {
                    if (row.equals(tableau.getBasicRow(i))) {
                        if (i < minIndex) {
                            minIndex = i;
                            minRow = row;
                        }
                    }
                }
            }
            return minRow;
        }
        return minRatioPositions.get(0);
    }

    private static void addUpperBounds(List<LinearConstraint> constraints, int[] upper) {
        for (int i = 0; i < upper.length; i++) {
            double[] coeffs = new double[upper.length];
            coeffs[i] = 1.0;
            constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, upper[i]));
        }
    }

    private static void addEqualityWithDuplicateLeq(
            List<LinearConstraint> constraints, double[] coeffs, double rhs) {
        constraints.add(new LinearConstraint(coeffs, Relationship.GEQ, rhs));
        constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, rhs));
        constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, rhs));
    }

    private static double dot(double[] coeffs, int[] point) {
        double v = 0.0;
        for (int i = 0; i < coeffs.length; i++) {
            v += coeffs[i] * point[i];
        }
        return v;
    }
}
