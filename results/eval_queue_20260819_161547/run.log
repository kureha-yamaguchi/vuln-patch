import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final String ANCHOR_PATTERN = "it''s a {0,lower} 'test'!";
    private static final String ANCHOR_EXPECTED = "it's a dummy test!";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();
        registry.put("lower", new LowerCaseFormatFactory());
        registry.put("upper", new UpperCaseFormatFactory());

        // Exact upstream trigger first. On the buggy version this constructor call
        // reaches applyPattern -> appendQuotedString with escapingOn=true at the first
        // quote of the doubled quote sequence in "it''s...", and should let the
        // resulting OutOfMemoryError escape to Jazzer.
        ExtendedMessageFormat emf = new ExtendedMessageFormat(ANCHOR_PATTERN, registry);

        // Observable post-condition from the original regression test:
        // a correct implementation formats this pattern as "it's a dummy test!".
        String formatted = emf.format(new Object[] { "DUMMY" });
        if (!ANCHOR_EXPECTED.equals(formatted)) {
            throw new RuntimeException("[oracle:anchor-format] metamorphic violation: input="
                    + ANCHOR_PATTERN + " lhs=" + formatted + " rhs=" + ANCHOR_EXPECTED);
        }

        // Round-trip metamorphic check: reconstructing from toPattern() must preserve
        // behavior for a correct implementation.
        String canonical = emf.toPattern();
        ExtendedMessageFormat emf2 = new ExtendedMessageFormat(canonical, registry);
        String formatted2 = emf2.format(new Object[] { "DUMMY" });
        if (!canonical.equals(emf2.toPattern())) {
            throw new RuntimeException("[oracle:pattern-roundtrip] metamorphic violation: input="
                    + ANCHOR_PATTERN + " lhs=" + emf2.toPattern() + " rhs=" + canonical);
        }
        if (!formatted.equals(formatted2)) {
            throw new RuntimeException("[oracle:format-roundtrip] metamorphic violation: input="
                    + ANCHOR_PATTERN + " lhs=" + formatted + " rhs=" + formatted2);
        }

        // Explore the flipped condition with more valid doubled-quote placements.
        String a = cleanLiteral(data.consumeAsciiString(8));
        String b = cleanLiteral(data.consumeAsciiString(8));
        String c = cleanLiteral(data.consumeAsciiString(8));
        String arg = cleanArg(data.consumeRemainingAsString());
        String fmt = data.consumeBoolean() ? "lower" : "upper";

        String pattern = a + "''" + b + " {0," + fmt + "} '" + c + "'";
        ExtendedMessageFormat emf3 = new ExtendedMessageFormat(pattern, registry);
        String out1 = emf3.format(new Object[] { arg });
        String p1 = emf3.toPattern();

        ExtendedMessageFormat emf4 = new ExtendedMessageFormat(p1, registry);
        String out2 = emf4.format(new Object[] { arg });
        if (!p1.equals(emf4.toPattern())) {
            throw new RuntimeException("[oracle:explore-pattern-roundtrip] metamorphic violation: input="
                    + pattern + " lhs=" + emf4.toPattern() + " rhs=" + p1);
        }
        if (!out1.equals(out2)) {
            throw new RuntimeException("[oracle:explore-format-roundtrip] metamorphic violation: input="
                    + pattern + " lhs=" + out1 + " rhs=" + out2);
        }
    }

    private static String cleanLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "x";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if ((ch >= 'a' && ch <= 'z')
                    || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9')
                    || ch == ' ') {
                sb.append(ch);
            } else {
                sb.append('x');
            }
        }
        return sb.length() == 0 ? "x" : sb.toString();
    }

    private static String cleanArg(String s) {
        return (s == null || s.length() == 0) ? "dummy" : s;
    }

    private static final class LowerCaseFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new LowerCaseFormat(locale == null ? Locale.getDefault() : locale);
        }
    }

    private static final class UpperCaseFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new UpperCaseFormat(locale == null ? Locale.getDefault() : locale);
        }
    }

    private static final class LowerCaseFormat extends Format {
        private final Locale locale;

        LowerCaseFormat(Locale locale) {
            this.locale = locale;
        }

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            return toAppendTo.append(String.valueOf(obj).toLowerCase(locale));
        }

        public Object parseObject(String source, ParsePosition pos) {
            pos.setIndex(source.length());
            return source;
        }
    }

    private static final class UpperCaseFormat extends Format {
        private final Locale locale;

        UpperCaseFormat(Locale locale) {
            this.locale = locale;
        }

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            return toAppendTo.append(String.valueOf(obj).toUpperCase(locale));
        }

        public Object parseObject(String source, ParsePosition pos) {
            pos.setIndex(source.length());
            return source;
        }
    }
}
