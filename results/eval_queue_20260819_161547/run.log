package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.MessageFormat;
import java.util.HashMap;
import java.util.Map;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        // ANCHOR: exact trigger pattern from the failing test.
        exercisePattern("it''s a {0,lower} 'test'!", registry, "DUMMY", false);

        // Also anchor the same escaped-quote root cause with a valid-by-construction pattern
        // that uses only standard MessageFormat syntax, so post-conditions can be checked.
        exercisePattern("it''s a {0} 'test'!", registry, "DUMMY", true);

        // EXPLORE: build many valid-by-construction patterns that contain doubled quotes.
        String arg = data.consumeAsciiString(16);
        String prefix = sanitizeLiteral(data.consumeString(24));
        String suffix = sanitizeLiteral(data.consumeString(24));
        String literal = sanitizeLiteral(data.consumeString(24));

        int mode = data.consumeInt(0, 4);
        String pattern;
        switch (mode) {
            case 0:
                pattern = prefix + "''" + suffix + " {0}";
                break;
            case 1:
                pattern = "'" + literal + "'" + prefix + "''" + suffix + " {0}";
                break;
            case 2:
                pattern = prefix + " {0} " + "''" + suffix + " '" + literal + "'";
                break;
            case 3:
                pattern = prefix + "''" + suffix + " {0} '" + literal + "'!";
                break;
            default:
                pattern = prefix + " {0} '" + literal + "' " + suffix + "''";
                break;
        }

        exercisePattern(pattern, registry, arg, true);

        // More varied but still valid-by-construction patterns with multiple escaped quotes.
        int extraParts = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < extraParts; i++) {
            sb.append(sanitizeLiteral(data.consumeString(12)));
            sb.append("''");
            if (data.consumeBoolean()) {
                sb.append(' ');
            }
        }
        if (data.consumeBoolean()) {
            sb.append(" {0}");
        } else {
            sb.append(" '{").append("0").append("}' {0}");
        }
        if (data.consumeBoolean()) {
            sb.append(" '").append(sanitizeLiteral(data.consumeString(12))).append("'");
        }
        exercisePattern(sb.toString(), registry, arg, true);
    }

    private static void exercisePattern(String pattern, Map registry, Object argument, boolean checkMetamorphic) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);

            // Contract used for this oracle:
            // with an empty custom-format registry, ExtendedMessageFormat should behave like
            // MessageFormat on ordinary patterns. A throw-deleting / branch-skipping patch in
            // appendQuotedString can silently change parsing/output, so compare two real library
            // executions on the same valid-by-construction pattern.
            if (checkMetamorphic) {
                try {
                    String actual = emf.format(new Object[] { argument });
                    MessageFormat mf = new MessageFormat(pattern);
                    String expected = mf.format(new Object[] { argument });
                    if (!expected.equals(actual)) {
                        throw new RuntimeException(
                            "[oracle:msgfmt-eq] metamorphic violation: ExtendedMessageFormat != MessageFormat input="
                                + pattern + " lhs=" + actual + " rhs=" + expected);
                    }

                    String tp1 = emf.toPattern();
                    ExtendedMessageFormat emf2 = new ExtendedMessageFormat(tp1, registry);
                    String tp2 = emf2.toPattern();
                    if (!tp1.equals(tp2)) {
                        throw new RuntimeException(
                            "[oracle:topattern-idem] metamorphic violation: toPattern round-trip input="
                                + pattern + " lhs=" + tp1 + " rhs=" + tp2);
                    }
                } catch (Throwable t) {
                    if (isCleanRejection(t)) {
                        return;
                    }
                    if (t instanceof RuntimeException) {
                        throw (RuntimeException) t;
                    }
                    return;
                }
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (Error) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation") || name.contains("invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(ste.getClassName())
                    && "appendQuotedString".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(ste.getClassName())
                    && ("next".equals(ste.getMethodName())
                        || "startsWith".equals(ste.getMethodName())
                        || "append".equals(ste.getMethodName()))) {
                return true;
            }
            if ("org.apache.commons.lang.text.StrBuilder".equals(ste.getClassName())
                    && ("append".equals(ste.getMethodName())
                        || "startsWith".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "x";
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '{' || c == '}' || c == '\'') {
                out.append('x');
            } else if (Character.isISOControl(c)) {
                out.append(' ');
            } else {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            out.append('x');
        }
        return out.toString();
    }
}
