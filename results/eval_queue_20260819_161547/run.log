            addEqualityWithDuplicateLeq(constraints, new double[] {1.0, 1.0, 0.0, 0.0, 0.0}, 2.0);
            addEqualityWithDuplicateLeq(constraints, new double[] {1.0, 0.0, 1.0, 0.0, 0.0}, 2.0);
