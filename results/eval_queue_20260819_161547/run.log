    private static double[] mutatePositiveRow(double[] row, com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        double[] out = new double[row.length];
        for (int i = 0; i < row.length; i++) {
            int delta = data.consumeInt(-2, 2);
            double v = row[i] + delta;
            if (i == 0) {
                out[i] = 0.0;
            } else if (v <= 0.0) {
                out[i] = 1.0;
            } else {
                out[i] = v;
            }
        }
        return out;
    }

    private static double[] mutateNegativeRow(double[] row, com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        double[] out = new double[row.length];
        for (int i = 0; i < row.length; i++) {
            int delta = data.consumeInt(-2, 2);
            double v = row[i] + delta;
            if (i == 0) {
                out[i] = v == 0.0 ? 1.0 : v;
            } else if (v >= 0.0) {
                out[i] = -1.0;
            } else {
                out[i] = v;
            }
        }
        return out;
    }
