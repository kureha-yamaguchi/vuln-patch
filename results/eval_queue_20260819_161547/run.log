package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        try {
            exercise(buildAnchorObjective(), buildAnchorConstraints(), true, 1.0e-6, 10);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }

        int vars = 31;
        boolean nonNegative = data.consumeBoolean();
        double epsilon = 1.0e-6;
        int maxUlps = data.consumeInt(1, 20);

        LinearObjectiveFunction objective = new LinearObjectiveFunction(buildObjective(vars, data), clamp(data.consumeInt(-100, 100)), 0.0);

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(buildPositiveTieRow(vars, data), Relationship.GEQ, data.consumeInt(1, 120)));
        constraints.add(new LinearConstraint(buildPositiveTieRow(vars, data), Relationship.GEQ, data.consumeInt(1, 120)));
        constraints.add(new LinearConstraint(buildPositiveTieRow(vars, data), Relationship.GEQ, data.consumeInt(1, 120)));

        if (data.consumeBoolean()) {
            constraints.add(new LinearConstraint(buildNegativeRow(vars, data), Relationship.LEQ, data.consumeInt(-120, -1)));
        } else {
            constraints.add(new LinearConstraint(buildMixedRow(vars, data), Relationship.GEQ, data.consumeInt(1, 120)));
        }

        int extra = data.consumeInt(0, 4);
        for (int i = 0; i < extra; i++) {
            double[] row = data.consumeBoolean() ? buildMixedRow(vars, data) : buildPositiveTieRow(vars, data);
            Relationship rel = data.consumeBoolean() ? Relationship.GEQ : Relationship.LEQ;
            double rhs = rel == Relationship.GEQ ? data.consumeInt(1, 120) : data.consumeInt(-120, 120);
            constraints.add(new LinearConstraint(row, rel, rhs));
        }

        try {
            exercise(objective, constraints, nonNegative, epsilon, maxUlps);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void exercise(LinearObjectiveFunction objective,
                                 Collection<LinearConstraint> constraints,
                                 boolean nonNegative,
                                 double epsilon,
                                 int maxUlps) {
        try {
            PointValuePair first = new SimplexSolver(epsilon, maxUlps).optimize(objective, constraints, GoalType.MINIMIZE, nonNegative);
            PointValuePair second = new SimplexSolver(epsilon, maxUlps).optimize(objective, cloneConstraints(constraints), GoalType.MINIMIZE, nonNegative);

            if (first == null || second == null) {
                return;
            }

            double[] p1 = first.getPoint();
            double[] p2 = second.getPoint();
            if (p1 == null || p2 == null) {
                return;
            }

            if (p1.length != p2.length) {
                throw new RuntimeException("[oracle:repeat-solve] metamorphic violation: identical problems produced points of different dimensions lhs=" + p1.length + " rhs=" + p2.length);
            }

            double v1 = first.getValue();
            double v2 = second.getValue();
            if (Math.abs(v1 - v2) > 1.0e-7 * Math.max(1.0, Math.max(Math.abs(v1), Math.abs(v2)))) {
                throw new RuntimeException("[oracle:repeat-solve] metamorphic violation: identical problems produced different objective values lhs=" + v1 + " rhs=" + v2);
            }

            for (int i = 0; i < p1.length; i++) {
                double a = p1[i];
                double b = p2[i];
                if (Math.abs(a - b) > 1.0e-7 * Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)))) {
                    throw new RuntimeException("[oracle:repeat-solve] metamorphic violation: identical problems produced different point coordinates index=" + i + " lhs=" + a + " rhs=" + b);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("MathIllegalArgument")
                || name.contains("Invalid")
                || name.contains("NoFeasibleSolution")
                || name.contains("UnboundedSolution")
                || name.contains("DimensionMismatch")
                || name.contains("OutOfRange")
                || name.contains("NullArgument")
                || name.contains("TooMany")
                || name.contains("ZeroException");
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
            return true;
        }
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        boolean sawIncrement = false;
        boolean sawReachable = false;
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.AbstractLinearOptimizer".equals(cls)
                    && "incrementIterationsCounter".equals(method)) {
                sawIncrement = true;
            }
            if (("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls) && "getPivotRow".equals(method))
                    || ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                        && ("getNumObjectiveFunctions".equals(method)
                            || "getHeight".equals(method)
                            || "getWidth".equals(method)
                            || "getEntry".equals(method)
                            || "getNumArtificialVariables".equals(method)
                            || "getArtificialVariableOffset".equals(method)
                            || "getBasicRow".equals(method)))
                    || ("org.apache.commons.math3.util.Precision".equals(cls)
                        && ("compareTo".equals(method) || "equals".equals(method)))
                    || ("org.apache.commons.math3.linear.RealMatrix".equals(cls)
                        && ("getRowDimension".equals(method)
                            || "getColumnDimension".equals(method)
                            || "getEntry".equals(method)))) {
                sawReachable = true;
            }
        }
        return sawIncrement && sawReachable;
    }

