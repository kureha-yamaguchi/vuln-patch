    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final double epsilon = 1.0e-6;
        final int maxUlps = Math.max(1, data.consumeInt(1, 20));

        for (int attempt = 0; attempt < 2; attempt++) {
            final int vars;
            final ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
            final double[] objective;

            if (attempt == 0) {
                vars = 4;
                objective = new double[] { 1.0, 0.0, 0.0, 0.0 };

                // Anchor: a deterministic degenerate Phase 1 problem with duplicated GEQ rows,
                // which creates tied minimum-ratio candidates while artificial variables exist.
                constraints.add(new LinearConstraint(new double[] { 0.0, 16.0, 14.0, 69.0 }, Relationship.GEQ, 91.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 16.0, 14.0, 69.0 }, Relationship.GEQ, 91.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 60.0, 40.0, 81.0 }, Relationship.GEQ, 54.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 41.0, 12.0, 86.0 }, Relationship.GEQ, 62.0));
                constraints.add(new LinearConstraint(new double[] { 1.0, 0.0, 0.0, 0.0 }, Relationship.LEQ, 10.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 1.0, 0.0, 0.0 }, Relationship.LEQ, 10.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 0.0, 1.0, 0.0 }, Relationship.LEQ, 10.0));
                constraints.add(new LinearConstraint(new double[] { 0.0, 0.0, 0.0, 1.0 }, Relationship.LEQ, 10.0));
            } else {
                vars = data.consumeInt(2, 6);
                objective = new double[vars];
                objective[0] = 1.0;
                for (int i = 1; i < vars; i++) {
                    objective[i] = data.consumeInt(-3, 3);
                }

                // Explore: build valid-by-construction LPs with duplicated GEQ constraints to
                // exercise the same degeneracy/tie property through the real solver.
                double[] dup = new double[vars];
                boolean anyPositive = false;
                for (int i = 0; i < vars; i++) {
                    dup[i] = data.consumeInt(0, 20);
                    if (dup[i] > 0.0) {
                        anyPositive = true;
                    }
                }
                if (!anyPositive) {
                    dup[data.consumeInt(0, vars - 1)] = 1.0;
                }
                double rhs = data.consumeInt(1, 40);
                constraints.add(new LinearConstraint(dup.clone(), Relationship.GEQ, rhs));
                constraints.add(new LinearConstraint(dup.clone(), Relationship.GEQ, rhs));

                int extra = data.consumeInt(0, 4);
                for (int c = 0; c < extra; c++) {
                    double[] coeffs = new double[vars];
                    boolean nonZero = false;
                    for (int i = 0; i < vars; i++) {
                        coeffs[i] = data.consumeInt(-10, 20);
                        if (coeffs[i] != 0.0) {
                            nonZero = true;
                        }
                    }
                    if (!nonZero) {
                        coeffs[data.consumeInt(0, vars - 1)] = 1.0;
                    }
                    Relationship rel;
                    int relPick = data.consumeInt(0, 2);
                    if (relPick == 0) {
                        rel = Relationship.GEQ;
                    } else if (relPick == 1) {
                        rel = Relationship.LEQ;
                    } else {
                        rel = Relationship.EQ;
                    }
                    constraints.add(new LinearConstraint(coeffs, rel, data.consumeInt(-30, 60)));
                }

                for (int i = 0; i < vars; i++) {
                    double[] upper = new double[vars];
                    upper[i] = 1.0;
                    constraints.add(new LinearConstraint(upper, Relationship.LEQ, data.consumeInt(1, 25)));
                }
            }

            LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);

            // Consistency cross-check on the real tableau state:
            // for identically constructed tableaux, reported structural summaries and basic rows
            // must agree, and each reported basic row must match an independently recomputed unit column.
            try {
                SimplexTableau t1 = new SimplexTableau(
                        f,
                        constraints,
                        org.apache.commons.math3.optimization.GoalType.MAXIMIZE,
                        true,
                        epsilon);
                SimplexTableau t2 = new SimplexTableau(
                        f,
                        constraints,
                        org.apache.commons.math3.optimization.GoalType.MAXIMIZE,
                        true,
                        epsilon);

                if (t1.getNumObjectiveFunctions() != t2.getNumObjectiveFunctions()
                        || t1.getHeight() != t2.getHeight()
                        || t1.getWidth() != t2.getWidth()
                        || t1.getNumArtificialVariables() != t2.getNumArtificialVariables()
                        || t1.getArtificialVariableOffset() != t2.getArtificialVariableOffset()) {
                    throw new RuntimeException("[oracle:tableau-structure] metamorphic violation: identical tableaux disagree");
                }

                for (int col = 0; col < t1.getWidth() - 1; col++) {
                    Integer b1 = t1.getBasicRow(col);
                    Integer b2 = t2.getBasicRow(col);
                    if (b1 == null ? b2 != null : !b1.equals(b2)) {
                        throw new RuntimeException("[oracle:basic-row-repeat] metamorphic violation: identical tableaux disagree on basic row for column "
                                + col + " lhs=" + b1 + " rhs=" + b2);
                    }

                    Integer empirical = null;
                    for (int row = t1.getNumObjectiveFunctions(); row < t1.getHeight(); row++) {
                        double entry = t1.getEntry(row, col);
                        if (org.apache.commons.math3.util.Precision.equals(entry, 1.0, maxUlps)) {
                            boolean unit = true;
                            for (int other = t1.getNumObjectiveFunctions(); other < t1.getHeight(); other++) {
                                if (other == row) {
                                    continue;
                                }
                                if (!org.apache.commons.math3.util.Precision.equals(t1.getEntry(other, col), 0.0, maxUlps)) {
                                    unit = false;
                                    break;
                                }
                            }
                            if (unit) {
                                empirical = row;
                                break;
                            }
                        }
                    }
                    if (b1 == null ? empirical != null : !b1.equals(empirical)) {
