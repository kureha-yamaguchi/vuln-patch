package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testEscapeCsv("\uD83D\uDE30", true);
        testEscapeCsv("\uD800\uDC00", true);
        testEscapeCsv("\uD834\uDD1E", true);
        testEscapeCsv("\uDBFF\uDFFD", true);

        String explored = buildValidSafeCsvInput(data);
        testEscapeCsv(explored, true);
    }

    private static void testEscapeCsv(String input, boolean validByConstruction) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            if (validByConstruction) {
                /*
                 * Oracle: CSV escaping only adds quotes/doubles quotes when the input contains
                 * CSV meta characters. We construct inputs with no comma, quote, CR, or LF and
                 * with well-formed surrogate pairs only, so a correct implementation must accept
                 * them and return the original string unchanged. A throw-deleting or bookkeeping-
                 * corrupt patch can silently produce wrong output and this check catches that.
                 */
                if (!input.equals(out)) {
                    throw new RuntimeException(
                        "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve safe CSV text input="
                            + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static String buildValidSafeCsvInput(FuzzedDataProvider data) {
        int pairCount = data.consumeInt(1, 4);
        int maxAsciiChunk = 6;
        StringBuilder sb = new StringBuilder();

        int leadingLen = data.consumeInt(0, maxAsciiChunk);
        sb.append(sanitizeSafeCsvAscii(data.consumeAsciiString(leadingLen)));

        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp) || Character.isSurrogate((char) cp)) {
                cp = 0x1F630;
            }
            sb.append(Character.toChars(cp));

            int chunkLen = data.consumeInt(0, maxAsciiChunk);
            sb.append(sanitizeSafeCsvAscii(data.consumeAsciiString(chunkLen)));
        }

        if (sb.length() == 0) {
            sb.append("\uD83D\uDE30");
        }
        return sb.toString();
    }

    private static String sanitizeSafeCsvAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("translate".equals(method)
                && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
