    private static String buildMalformedPatchedBranchInput(FuzzedDataProvider data) {
        int leftZeros = data.consumeInt(1, 4);
        int rightZeros = data.consumeInt(0, 4);
        boolean upperFirst = data.consumeBoolean();
        boolean addTrailingDigit = data.consumeBoolean();
        boolean addSuffix = data.consumeBoolean();

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < leftZeros; i++) {
            sb.append('0');
        }
        sb.append(upperFirst ? 'E' : 'e');
        if (rightZeros > 0) {
            for (int i = 0; i < rightZeros; i++) {
                sb.append('0');
            }
        }
        sb.append(upperFirst ? 'e' : 'E');
        if (addTrailingDigit) {
            sb.append('0');
        }
        if (addSuffix) {
            char[] suffixes = new char[] {'f', 'F', 'd', 'D', 'l', 'L'};
            sb.append(suffixes[data.consumeInt(0, suffixes.length - 1)]);
        }
        return sb.toString();
    }

    private static String buildZeroExponentZeroInput(FuzzedDataProvider data) {
        int wholeZeros = data.consumeInt(1, 6);
        int exponentZeros = data.consumeInt(1, 6);
        boolean upperExp = data.consumeBoolean();

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < wholeZeros; i++) {
            sb.append('0');
        }
        sb.append(upperExp ? 'E' : 'e');
        for (int i = 0; i < exponentZeros; i++) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            } else if ("java.lang.String".equals(cls)) {
                if ("substring".equals(method) || "charAt".equals(method)) {
                    return true;
                }
            } else if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
