package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true);
        }

        int prefixLen = data.consumeInt(0, 16);
        int suffixLen = data.consumeInt(0, 16);
        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(prefixLen));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(suffixLen));

        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        String pair = new String(Character.toChars(codePoint));

        String fuzzed = prefix + pair + suffix;
        exerciseEscapeCsv(fuzzed, true);

        if (data.consumeBoolean()) {
            String fuzzed2 = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8)))
                    + new String(Character.toChars(data.consumeInt(0x10000, 0x10FFFF)))
                    + sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8)))
                    + new String(Character.toChars(data.consumeInt(0x10000, 0x10FFFF)))
                    + sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8)));
            exerciseEscapeCsv(fuzzed2, true);
        }
    }

    private static void exerciseEscapeCsv(String input, boolean expectUnchanged) {
        try {
            String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle: CSV escaping must leave inputs unchanged when they contain none
             * of the CSV-special characters comma, quote, CR, or LF. All constructed inputs
             * here are valid-by-construction, contain at least one well-formed surrogate pair,
             * and exclude those special characters, so a throw-deleting or branch-skipping patch
             * that silently drops/duplicates characters would violate this observable result.
             */
            if (expectUnchanged && !input.equals(out)) {
                throw new RuntimeException(
                    "[oracle:csv-unchanged] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String n = cur.getClass().getName();
            if (n.contains("Validation") || n.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
