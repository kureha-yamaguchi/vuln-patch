package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callAndMaybePropagate("off", true);

        String three = data.consumeAsciiString(3);
        three = forceLength(three, 3, data);
        callAndMaybePropagate(three, true);

        String variant1 = mutateLength3Shape(three, data);
        callAndMaybePropagate(variant1, true);

        String variant2 = mutateLength3Shape(data.consumeAsciiString(6), data);
        callAndMaybePropagate(variant2, true);

        String any = data.consumeString(8);
        callAndMaybePropagate(any, true);

        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs", "yES",
            "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        callAndMaybePropagate(literals[data.consumeInt(0, literals.length - 1)], true);

        oracleKnownTrueTokens(data);
    }

    private static void oracleKnownTrueTokens(FuzzedDataProvider data) {
        String base;
        switch (data.consumeInt(0, 2)) {
            case 0:
                base = "true";
                break;
            case 1:
                base = "yes";
                break;
            default:
                base = "on";
                break;
        }

        String cased = randomCase(base, data);

        Boolean lhs = safeToBoolean(cased, true);
        Boolean rhs = safeToBoolean(base, true);
        if (lhs == null || rhs == null) {
            return;
        }

        if (lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:case-eq] metamorphic violation: equivalent case-insensitive true token input=" +
                printable(cased) + " lhs=" + lhs + " rhs=" + rhs);
        }

        if (!lhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:recognized-true] metamorphic violation: documented true token not recognized input=" +
                printable(cased) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void callAndMaybePropagate(String s, boolean validByConstruction) {
        safeToBoolean(s, validByConstruction);
    }

    private static Boolean safeToBoolean(String s, boolean validByConstruction) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String forceLength(String s, int len, FuzzedDataProvider data) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < len) {
            int c = data.remainingBytes() > 0 ? data.consumeInt(32, 126) : 'x';
            sb.append((char) c);
        }
        return sb.toString();
    }

    private static String mutateLength3Shape(String seed, FuzzedDataProvider data) {
        String s = forceLength(seed, 3, data);
        char[] chars = s.toCharArray();
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                chars[0] = (char) data.consumeInt(32, 126);
                break;
            case 1:
                chars[1] = (char) data.consumeInt(32, 126);
                break;
            case 2:
                chars[2] = (char) data.consumeInt(32, 126);
                break;
            case 3:
                chars[0] = 'o';
                break;
            case 4:
                chars[0] = 'y';
                break;
            default:
                chars[0] = 't';
                break;
        }
        return new String(chars);
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
