                throw e;
            }
        } catch (CloneNotSupportedException e) {
        }
    }

    private static void addValue(TimeSeries s, RegularTimePeriod p, int v) {
        s.add(p, new Integer(v));
    }

    private static Day dayFromEpochDay(int epochDay) {
        GregorianCalendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(1970, Calendar.JANUARY, 1, 0, 0, 0);
        cal.add(Calendar.DATE, epochDay);
        Date date = cal.getTime();
        return new Day(date);
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        List items = series.getItems();
        for (int i = 0; i < items.size(); i++) {
            TimeSeriesDataItem item = (TimeSeriesDataItem) items.get(i);
            RegularTimePeriod p = item.getPeriod();
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
