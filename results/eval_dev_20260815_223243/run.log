package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1eE");

        String prefix = digits(data.consumeInt(1, 6), data);
        String middle = alphaNumNoDot(data.consumeInt(0, 6), data);
        String suffix = alphaNumNoDot(data.consumeInt(0, 6), data);

        String candidate;
        if (data.consumeBoolean()) {
            candidate = prefix + "e" + middle + "E" + suffix;
        } else {
            candidate = prefix + "E" + middle + "e" + suffix;
        }

        if (candidate.startsWith("--")) {
            candidate = "1" + candidate;
        }
        if (candidate.startsWith("0x") || candidate.startsWith("-0x")) {
            candidate = "1" + candidate;
        }
        if (candidate.indexOf('.') >= 0) {
            candidate = candidate.replace('.', '1');
        }
        if (candidate.trim().length() == 0) {
            candidate = "1eE";
        }

        NumberUtils.createNumber(candidate);
    }

    private static String digits(int len, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int d = data.consumeInt(0, 9);
            if (i == 0 && len > 1 && d == 0) {
                d = data.consumeInt(1, 9);
            }
            sb.append((char) ('0' + d));
        }
        return sb.toString();
    }

    private static String alphaNumNoDot(int len, FuzzedDataProvider data) {
        String alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+-_";
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append(alphabet.charAt(data.consumeInt(0, alphabet.length() - 1)));
        }
        return sb.toString();
    }
}
