package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact inputs from the failing test. These are valid UTF-16 surrogate pairs and,
        // per StringEscapeUtils.escapeCsv contract, contain no CSV special chars, so the result
        // must be the original input unchanged. A throw-deleting / branch-skipping patch that
        // avoids the crash but drops or mangles characters violates this observable post-condition.
        exerciseIdentity("\uD83D\uDE30");
        exerciseIdentity("\uD800\uDC00");
        exerciseIdentity("\uD834\uDD1E");
        exerciseIdentity("\uDBFF\uDFFD");

        // EXPLORE: build many valid-by-construction strings that contain at least one supplementary
        // code point encoded as a well-formed surrogate pair, surrounded by CSV-safe characters.
        // For such inputs, escapeCsv must accept them and return them unchanged because there are
        // no comma, quote, CR, or LF characters requiring CSV escaping.
        String fuzzed = buildValidCsvSafeStringWithSupplementary(data);
        exerciseIdentity(fuzzed);
    }

    private static void exerciseIdentity(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);
            if (!input.equals(escaped)) {
                throw new RuntimeException("[oracle:escapeCsv-identity] metamorphic violation: CSV-safe input must be unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(input)) {
                throw t;
            }
            throwIfOracleViolation(t);
        }
    }

    private static void throwIfOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        if (msg != null && msg.startsWith("[oracle:")) {
            throw t;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        boolean hasSupplementary = false;
        for (int i = 0; i < s.length();) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                hasSupplementary = true;
                i += 2;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            } else {
                i++;
            }
        }
        return hasSupplementary;
    }

    private static String buildValidCsvSafeStringWithSupplementary(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int pieces = data.consumeInt(1, 8);
        boolean insertedSupplementary = false;
        for (int i = 0; i < pieces; i++) {
            boolean useSupplementary = !insertedSupplementary || data.consumeBoolean();
            if (useSupplementary) {
                appendSupplementary(sb, data);
                insertedSupplementary = true;
            } else {
                appendSafeAscii(sb, data);
            }
        }
        if (!insertedSupplementary) {
            appendSupplementary(sb, data);
        }
        if (sb.length() == 0) {
            appendSupplementary(sb, data);
        }
        return sb.toString();
    }

    private static void appendSupplementary(StringBuilder sb, FuzzedDataProvider data) {
        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        if (!Character.isValidCodePoint(codePoint) || Character.isSurrogate((char) codePoint)) {
            codePoint = 0x10000;
        }
        sb.append(Character.toChars(codePoint));
    }

    private static void appendSafeAscii(StringBuilder sb, FuzzedDataProvider data) {
        final char[] safe = "abcXYZ019 _-./;:()[]{}".toCharArray();
        int len = data.consumeInt(1, 6);
        for (int i = 0; i < len; i++) {
            int idx = data.consumeInt(0, safe.length - 1);
            sb.append(safe[idx]);
        }
    }

    private static String printable(String s) {
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        out.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            out.append('0');
                        }
                        out.append(hex);
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }
}
