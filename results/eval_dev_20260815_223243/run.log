package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testOne("\uD83D\uDE30");
        testOne("\uD800\uDC00");
        testOne("\uD834\uDD1E");
        testOne("\uDBFF\uDFFD");

        String fuzzed = buildValidNoSpecialCsvString(data);
        testOne(fuzzed);
    }

    private static void testOne(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle:
             * The failing test shows valid surrogate pairs must be accepted by the public API.
             * For inputs with no CSV special characters (comma, quote, CR, LF), CSV escaping
             * must leave the text unchanged. A throw-deleting or branch-skipping patch could
             * avoid the crash yet silently produce the wrong output, so assert exact equality.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve valid input without CSV special characters input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isOracleFailure(t)) {
                rethrow(t);
            }
            if (isValidationLike(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrow(t);
            }
        }
    }

    private static String buildValidNoSpecialCsvString(FuzzedDataProvider data) {
        int pairCount = data.consumeInt(1, 5);
        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        StringBuilder sb = new StringBuilder();

        sb.append(safeAscii(data.consumeBytes(prefixLen)));
        for (int i = 0; i < pairCount; i++) {
            sb.appendCodePoint(validSupplementaryCodePoint(data.consumeInt()));
            sb.append(safeAscii(data.consumeBytes(data.consumeInt(0, 4))));
        }
        sb.append(safeAscii(data.consumeBytes(suffixLen)));

        if (sb.length() == 0) {
            sb.appendCodePoint(0x1F630);
        }
        return sb.toString();
    }

    private static int validSupplementaryCodePoint(int seed) {
        int range = 0x10FFFF - 0x10000 + 1;
        int cp = 0x10000 + Math.floorMod(seed, range);
        if (cp >= 0xD800 && cp <= 0xDFFF) {
            cp = 0x10000;
        }
        return cp;
    }

    private static String safeAscii(byte[] bytes) {
        final char[] alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".toCharArray();
        StringBuilder sb = new StringBuilder(bytes.length);
        for (byte b : bytes) {
            sb.append(alphabet[(b & 0xFF) % alphabet.length]);
        }
        return sb.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationLike(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static void rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7E) {
                        sb.append(String.format("\\u%04X", (int) ch));
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
