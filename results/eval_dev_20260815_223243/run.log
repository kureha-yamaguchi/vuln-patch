package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.geometry.euclidean.oned.IntervalsSet;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            triggerIssue780Anchor();
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        int trials = 1 + data.consumeInt(1, 4);
        for (int i = 0; i < trials; i++) {
            MeshSpec spec = consumeValidHexahedron(data);
            exercisePolyhedron(spec, false);
        }
    }

    private static void triggerIssue780Anchor() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };

        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        MeshSpec anchor = new MeshSpec(toVertices(coords), indices);
        exercisePolyhedron(anchor, true);
    }

    private static void exercisePolyhedron(MeshSpec spec, boolean validByConstruction) {
        PolyhedronsSet a;
        PolyhedronsSet b;

        try {
            a = buildPolyhedron(spec.vertices, spec.indices);
            List<SubHyperplane<Euclidean3D>> reordered = buildFacets(spec.vertices, spec.indices);
            Collections.rotate(reordered, 1 + (reordered.size() / 3));
            Collections.reverse(reordered);
            b = new PolyhedronsSet(reordered);
        } catch (RuntimeException t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        }

        double sizeA;
        Vector3D baryA;
        double sizeB;
        Vector3D baryB;

        try {
            sizeA = a.getSize();
            baryA = a.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        }

        try {
            sizeB = b.getSize();
            baryB = b.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        }

        /*
         * Contract used for this oracle:
         * the same closed boundary representation denotes the same region regardless
         * of the iteration order of the boundary facets. Therefore getSize() and
         * getBarycenter() must agree for two PolyhedronsSet instances built from
         * the same facets in a different order. A throw-deleting patch that merely
         * suppresses the ClassCastException but corrupts bookkeeping in the reachable
         * region can violate this observable even when no exception is thrown.
         */
        if (!sameFiniteOrInfinite(sizeA, sizeB, 1e-8)) {
            throw new RuntimeException("[oracle:facet-order] metamorphic violation: size differs under facet reordering lhs=" + sizeA + " rhs=" + sizeB);
        }
        if (!samePoint(baryA, baryB, 1e-8)) {
            throw new RuntimeException("[oracle:facet-order] metamorphic violation: barycenter differs under facet reordering lhs=" + baryA + " rhs=" + baryB);
        }
    }

    private static PolyhedronsSet buildPolyhedron(Vector3D[] vertices, int[] indices) {
        return new PolyhedronsSet(buildFacets(vertices, indices));
    }

    private static List<SubHyperplane<Euclidean3D>> buildFacets(Vector3D[] vertices, int[] indices) {
        List<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            Vector3D v1 = vertices[indices[idx]];
            Vector3D v2 = vertices[indices[idx + 1]];
            Vector3D v3 = vertices[indices[idx + 2]];

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            List<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>(3);
            edges.add(edge(p1, p2));
            edges.add(edge(p2, p3));
            edges.add(edge(p3, p1));

            PolygonsSet polygon = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, polygon));
        }
        return facets;
    }

    private static SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D> edge(Vector2D start, Vector2D end) {
        Line line = new Line(start, end);
        double a = line.toSubSpace(start).getX();
        double b = line.toSubSpace(end).getX();
        return new SubLine(line, new IntervalsSet(Math.min(a, b), Math.max(a, b)));
    }

    private static MeshSpec consumeValidHexahedron(FuzzedDataProvider data) {
        double hx = 0.5 + bounded(data.consumeInt(), 2000) / 1000.0;
        double hy = 0.5 + bounded(data.consumeInt(), 2000) / 1000.0;
        double hz = 0.5 + bounded(data.consumeInt(), 2000) / 1000.0;

        double cx = bounded(data.consumeInt(), 2000) / 100.0;
        double cy = bounded(data.consumeInt(), 2000) / 100.0;
        double cz = bounded(data.consumeInt(), 2000) / 100.0;

        double eps = bounded(data.consumeInt(), 1000) / 1000000.0;
        double skewX = data.consumeBoolean() ? eps : -eps;
        double skewY = data.consumeBoolean() ? eps : -eps;
        double skewZ = data.consumeBoolean() ? eps : -eps;

        Vector3D[] vertices = new Vector3D[] {
            new Vector3D(cx + hx, cy - hy, cz - hz),
            new Vector3D(cx + hx, cy - hy, cz + hz),
            new Vector3D(cx - hx, cy - hy, cz + hz),
            new Vector3D(cx - hx, cy - hy, cz - hz),
            new Vector3D(cx + hx, cy + hy, cz - hz),
            new Vector3D(cx + hx + skewX, cy + hy + skewY, cz + hz + skewZ),
            new Vector3D(cx - hx, cy + hy, cz + hz),
            new Vector3D(cx - hx, cy + hy, cz - hz)
        };

        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        return new MeshSpec(vertices, indices);
    }

    private static double bounded(int value, int limit) {
        int m = value % (2 * limit + 1);
        if (m < 0) {
            m += 2 * limit + 1;
        }
        return m - limit;
    }

    private static Vector3D[] toVertices(float[] coords) {
        Vector3D[] out = new Vector3D[coords.length / 3];
        for (int i = 0; i < out.length; i++) {
            int j = i * 3;
            out[i] = new Vector3D(coords[j], coords[j + 1], coords[j + 2]);
        }
        return out;
    }

    private static boolean sameFiniteOrInfinite(double a, double b, double relTol) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return Double.isNaN(a) && Double.isNaN(b);
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= relTol * scale;
    }

    private static boolean samePoint(Vector3D a, Vector3D b, double relTol) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameFiniteOrInfinite(a.getX(), b.getX(), relTol)
            && sameFiniteOrInfinite(a.getY(), b.getY(), relTol)
            && sameFiniteOrInfinite(a.getZ(), b.getZ(), relTol);
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (StackTraceElement e : st) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "getSize".equals(method)
                        || "getBarycenter".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static final class MeshSpec {
        final Vector3D[] vertices;
        final int[] indices;

        MeshSpec(Vector3D[] vertices, int[] indices) {
            this.vertices = vertices;
            this.indices = indices;
        }
    }
}
