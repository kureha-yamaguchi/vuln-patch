public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            tryAnchor();
        } catch (Throwable t) {
            if (shouldPropagate(t, true)) {
                throwUnchecked(t);
            }
        }

        try {
            exploreDirectTree(data);
        } catch (Throwable t) {
            if (shouldPropagate(t, true)) {
                throwUnchecked(t);
            }
        }
    }

    private static void tryAnchor() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };
        triggerPolyhedron(coords, indices);
    }

    private static void exploreDirectTree(FuzzedDataProvider data) {
        double ax = bounded(data.consumeInt());
        double ay = bounded(data.consumeInt());
        double bx = bounded(data.consumeInt());
        double by = bounded(data.consumeInt());

        if (ax == bx && ay == by) {
            bx = ax + 1.0;
        }

        if (data.consumeBoolean()) {
            bx = ax + (bx - ax) * 0.000001;
            by = ay + (by - ay) * 0.000001 + 1.0;
        }

        PolygonsSet a = buildProblematicPolygon(ax, ay, bx, by);
        PolygonsSet b = buildProblematicPolygon(ax, ay, bx, by);

        Vector2D[][] before;
        Vector2D[][] again;
        Vector2D[][] fromTwin;
        double size;
        Vector2D bary;
        try {
            before = a.getVertices();
            again = a.getVertices();
            fromTwin = b.getVertices();
            size = a.getSize();
            bary = (Vector2D) a.getBarycenter();
        } catch (Throwable t) {
            if (shouldPropagate(t, true)) {
                throwUnchecked(t);
            }
            return;
