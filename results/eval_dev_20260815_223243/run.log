                throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchored empty-gap copy must be empty"
                        + " itemCount=" + copy.getItemCount()
                        + " itemsSize=" + copy.getItems().size()
                        + " periodsSize=" + copy.getTimePeriods().size());
