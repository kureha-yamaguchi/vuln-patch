    private static void exerciseMalformed(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseLeak(e)) {
                return;
            }
        }
    }

    private static String padDecimalWithLeadingZeros(int value, int zeroCount) {
        String s = String.valueOf(value);
        StringBuffer sb = new StringBuffer();
        if (s.charAt(0) == '-') {
            sb.append('-');
            for (int i = 0; i < zeroCount; i++) {
                sb.append('0');
            }
            sb.append(s.substring(1));
        } else {
            for (int i = 0; i < zeroCount; i++) {
                sb.append('0');
            }
            sb.append(s);
        }
        return sb.toString();
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseLeak(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cn)
                    && ("createNumber".equals(mn)
                    || "createInteger".equals(mn)
                    || "isAllZeros".equals(mn)
                    || "isDigits".equals(mn)
                    || "createLong".equals(mn)
                    || "createBigInteger".equals(mn)
                    || "createFloat".equals(mn)
                    || "createDouble".equals(mn)
                    || "createBigDecimal".equals(mn))) {
                return true;
            }
        }
        return false;
    }
}
