    private static void exactExpect(String expected, String actual, String id) {
        if (expected == null ? actual != null : !expected.equals(actual)) {
            throw new RuntimeException(
                    "[oracle:" + id + "] metamorphic violation: expected=" + quote(expected) + " actual="
                            + quote(actual));
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static char pickLowercase(FuzzedDataProvider data, char avoid1, char avoid2) {
        for (int i = 0; i < 52; i++) {
            char c = (char) ('a' + data.consumeInt(0, 25));
            if (c != avoid1 && c != avoid2) {
                return c;
            }
        }
        for (char c = 'a'; c <= 'z'; c++) {
            if (c != avoid1 && c != avoid2) {
                return c;
            }
        }
        return 'x';
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
