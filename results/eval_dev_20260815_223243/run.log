            }
        }
    }

    private static void runAnchorChecks() {
        exactExpect("aba", StringUtils.replaceEach("aba", null, null), "anchor-null-arrays");
        exactExpect("aba", StringUtils.replaceEach("aba", new String[0], null), "anchor-empty-search");
        exactExpect("aba", StringUtils.replaceEach("aba", null, new String[0]), "anchor-empty-repl");
