package org.apache.commons.lang;

import java.math.BigInteger;
import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            probeInvalidRejectsCleanly(anchor[i]);
        }

        for (int i = 0; i < 12; i++) {
            String probe = buildExplorationInput(data);
            try {
                NumberUtils.createNumber(probe);
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    continue;
                }
                if (isRootCause(e)) {
                    throw e;
                }
            }
        }

        String singletonSuffix = data.consumeBoolean() ? "l" : "L";
        probeInvalidRejectsCleanly(singletonSuffix);

        String malformed = data.consumeAsciiString(4) + (data.consumeBoolean() ? "l" : "L");
        if (malformed.length() > 0 && !isDefinitelyValidIntegralSuffix(malformed)) {
            probeInvalidRejectsCleanly(malformed);
        }

        int small = data.consumeInt(-1000000, 1000000);
        String canonical = String.valueOf(small);
        String withLongSuffix = canonical + (data.consumeBoolean() ? "L" : "l");
        try {
            Number lhs = NumberUtils.createNumber(withLongSuffix);
            Long rhs = NumberUtils.createLong(canonical);
            if (lhs == null || lhs.longValue() != rhs.longValue()) {
                throw new RuntimeException("[oracle:long-suffix-agree] metamorphic violation: createNumber(decimal+L) must agree with createLong(decimal) for valid decimal integral input input=" + withLongSuffix + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }

        String big = buildOverflowDecimal(data);
        String bigWithSuffix = big + (data.consumeBoolean() ? "L" : "l");
        try {
            Number lhs = NumberUtils.createNumber(bigWithSuffix);
            BigInteger rhs = NumberUtils.createBigInteger(big);
            if (!(lhs instanceof BigInteger) || !rhs.equals(lhs)) {
                throw new RuntimeException("[oracle:overflow-bigint] metamorphic violation: createNumber(decimal+L) must equal createBigInteger(decimal) when the valid decimal input overflows long input=" + bigWithSuffix + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }

        int digit = data.consumeInt(0, 9);
        String oneDigit = String.valueOf((char) ('0' + digit));
        String oneDigitWithSuffix = oneDigit + (data.consumeBoolean() ? "L" : "l");
        try {
            Number lhs = NumberUtils.createNumber(oneDigitWithSuffix);
            Long rhs = NumberUtils.createLong(oneDigit);
            if (lhs == null || lhs.longValue() != rhs.longValue()) {
                throw new RuntimeException("[oracle:boundary-digit-long] metamorphic violation: one-digit decimal with long suffix must recover the same numeric value input=" + oneDigitWithSuffix + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 9)) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return data.consumeBoolean() ? "f" : "F";
            case 2:
                return String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 3:
                return "-" + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 4:
                return "." + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 5:
                return data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
            case 6:
                return data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
            case 7:
                return data.consumeAsciiString(6);
            case 8:
                return data.consumeAsciiString(2) + (data.consumeBoolean() ? "f" : "F");
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static String buildOverflowDecimal(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        int extraDigits = data.consumeInt(19, 39);
        for (int i = 0; i < extraDigits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static void probeInvalidRejectsCleanly(String val) {
        try {
            Number n = NumberUtils.createNumber(val);
            if (n != null) {
                throw new RuntimeException("[oracle:clean-reject] metamorphic violation: malformed input was accepted input=" + val + " result=" + n + " type=" + n.getClass().getName());
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:clean-reject] metamorphic violation: malformed input leaked non-validation runtime from createNumber input=" + val + " cause=" + e.getClass().getName(), e);
            }
        }
    }

    private static boolean isDefinitelyValidIntegralSuffix(String val) {
        if (val == null || val.length() < 2) {
            return false;
        }
        char last = val.charAt(val.length() - 1);
        if (last != 'l' && last != 'L') {
            return false;
        }
        String numeric = val.substring(0, val.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        if (numeric.charAt(0) == '-') {
            return numeric.length() > 1 && NumberUtils.isDigits(numeric.substring(1));
        }
        return NumberUtils.isDigits(numeric);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cn = stack[i].getClassName();
            String mn = stack[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cn)
                    && ("createNumber".equals(mn)
                    || "createLong".equals(mn)
                    || "createBigInteger".equals(mn)
                    || "createFloat".equals(mn)
                    || "createDouble".equals(mn)
                    || "createBigDecimal".equals(mn)
                    || "createInteger".equals(mn)
                    || "isAllZeros".equals(mn)
                    || "isDigits".equals(mn))) {
                return true;
            }
        }
        return false;
    }
}
