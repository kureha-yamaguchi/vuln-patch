package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Contract/oracle notes:
         * - BooleanUtils.toBoolean(String) is a parser for textual booleans. From the shown code and the
         *   failing test, canonical true tokens are case-insensitive "true", "on", and "yes"; e.g. the
         *   test explicitly expects true for many case variants of "true" and false for "off"/"oof"/"yep".
         * - Therefore:
         *   (1) a constructed case-variant of a canonical true token must parse to true;
         *   (2) a constructed 3-char token that is not any case-variant of "yes" must parse to false.
         * - These direct post-conditions catch throw-deleting / branch-skipping patches that stop crashing
         *   but silently return the wrong boolean.
         */

        // ANCHOR: exact trigger from the failing test, first.
        checkExpected("off", false, true);

        // EXPLORE 1: valid-by-construction canonical true token with randomized case.
        String[] trueBases = new String[] { "yes", "on", "true" };
        String goodBase = trueBases[Math.abs(data.consumeInt()) % trueBases.length];
        String good = randomizeCase(goodBase, data);
        checkExpected(good, true, true);

        // EXPLORE 2: many real 3-char strings derived from fuzz data; this reaches the patched len==3 logic.
        String surrounding = data.consumeAsciiString(12);
        while (surrounding.length() < 3) {
            surrounding = surrounding + "x";
        }
        int start = data.consumeInt(0, surrounding.length() - 3);
        String window = surrounding.substring(start, start + 3);

        // Force the explored window to stay in the "reject cleanly / return false" region,
        // i.e. not any case-variant of the only 3-char true token "yes".
        if (window.equalsIgnoreCase("yes")) {
            char[] chars = window.toCharArray();
            chars[0] = chars[0] == 'x' ? 'z' : 'x';
            window = new String(chars);
        }
        checkExpected(window, false, true);

        // Also probe equivalent case variants of the same rejected 3-char token.
        checkExpected(window.toLowerCase(), false, true);
        checkExpected(window.toUpperCase(), false, true);

        // Additional explored literal shaped like the real trigger space.
        String extra = buildThreeCharToken(data);
        if (extra.equalsIgnoreCase("yes")) {
            extra = "yep";
        }
        checkExpected(extra, false, true);
    }

    private static void checkExpected(String s, boolean expected, boolean validByConstruction) {
        try {
            boolean actual = BooleanUtils.toBoolean(s);
            if (actual != expected) {
                throw new RuntimeException(
                    "[oracle:boolean-parse] metamorphic violation: constructed token parsed to unexpected boolean input="
                        + String.valueOf(s) + " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            throwIfOracleViolation(t);
            // Swallow unrelated/pre-existing runtime exceptions outside this patch scope.
        }
    }

    private static void throwIfOracleViolation(RuntimeException t) {
        String msg = t.getMessage();
        if (msg != null && msg.startsWith("[oracle:")) {
            throw t;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || hasValidationLikeName(t.getClass());
    }

    private static boolean hasValidationLikeName(Class<?> c) {
        while (c != null) {
            String n = c.getName();
            if (n.contains("Invalid") || n.contains("Validation")) {
                return true;
            }
            c = c.getSuperclass();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean()
                ? Character.toUpperCase(chars[i])
                : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static String buildThreeCharToken(FuzzedDataProvider data) {
        char c1 = toAsciiLetter(data.consumeByte());
        char c2 = toAsciiLetter(data.consumeByte());
        char c3 = toAsciiLetter(data.consumeByte());
        return new String(new char[] { c1, c2, c3 });
    }

    private static char toAsciiLetter(byte b) {
        int v = b & 0xFF;
        return (char) ('a' + (v % 26));
    }
}
