package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        // Exercise the uncovered reachable helper directly.
        if (StringUtils.length(null) != 0) {
            throw new RuntimeException("[oracle:length-null] metamorphic violation: length(null) must be 0");
        }

        String prefix = data.consumeAsciiString(8);
        String middle = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);

        // Valid-by-construction:
        // - equal-length arrays
        // - non-empty text containing at least one real match for "A"
        // - null replacement entry is allowed by the documented tests and should be ignored
        String text = prefix + "A" + middle + suffix;

        String replacement = sanitizeReplacement(data.consumeAsciiString(4));
        String[] searchList = new String[] { "A", "C" };
        String[] replacementList = new String[] { replacement, null };

        String once;
        try {
            once = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // Independent helper consistency check on the different reachable function.
        if (StringUtils.length(once) != once.length()) {
            throw new RuntimeException("[oracle:length-consistency] metamorphic violation: input=" + text
                    + " result=" + once
                    + " reported=" + StringUtils.length(once)
                    + " actual=" + once.length());
        }

        String repeated;
        try {
            repeated = StringUtils.replaceEachRepeatedly(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // Contract used for this oracle:
        // replaceEachRepeatedly performs repeated application until stable.
        // Here every non-null replacement is constructed so it contains neither search token "A" nor "C",
        // and the null replacement entry is documented by tests to be inert/ignored.
        // Therefore one successful pass cannot introduce any fresh searchable token, so
        // replaceEachRepeatedly(text, searchList, replacementList) must equal
        // replaceEach(text, searchList, replacementList).
        // A throw-deleting or overfitted patch that silently skips/changes replacement behavior can violate this.
        if (!safeEquals(once, repeated)) {
            throw new RuntimeException("[oracle:repeat-agreement] metamorphic violation: input=" + text
                    + " once=" + once + " repeated=" + repeated
                    + " repl0=" + replacement);
        }

        // A second sound relation on the same valid inputs:
        // replacing "A" with a token that contains neither "A" nor "C" is idempotent.
        String twice;
        try {
            twice = StringUtils.replaceEach(once, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
        if (!safeEquals(once, twice)) {
            throw new RuntimeException("[oracle:idempotence] metamorphic violation: input=" + text
                    + " once=" + once + " twice=" + twice
                    + " repl0=" + replacement);
        }
    }

    private static void runAnchorCases() {
        runAnchorCase(null, new String[] { "a" }, new String[] { "b" }, null);
        runAnchorCase("aba", null, null, "aba");
        runAnchorCase("aba", new String[0], null, "aba");
        runAnchorCase("aba", null, new String[0], "aba");
        runAnchorCase("aba", new String[] { "a" }, null, "aba");
        runAnchorCase("aba", new String[] { null }, new String[] { "a" }, "aba");
        runAnchorCase("aba", new String[] { "a" }, new String[] { null }, "aba");
        runAnchorCase("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc");
    }

    private static void runAnchorCase(String text, String[] searchList, String[] replacementList, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (!safeEquals(expected, actual)) {
                throw new RuntimeException("[oracle:anchor-contract] metamorphic violation: expected=" + expected
                        + " actual=" + actual);
            }
            if (actual != null && StringUtils.length(actual) != actual.length()) {
                throw new RuntimeException("[oracle:anchor-length] metamorphic violation: actual=" + actual
                        + " reported=" + StringUtils.length(actual)
                        + " actualLen=" + actual.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "length".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.contains("validation") || lower.contains("invalid")) {
                    return true;
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static String sanitizeReplacement(String s) {
        if (s == null || s.length() == 0) {
            return "B";
        }
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == 'A' || c == 'C') {
                out.append('B');
            } else {
                out.append(c);
            }
        }
        String r = out.toString();
        if (r.length() == 0) {
            return "B";
        }
        return r;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
