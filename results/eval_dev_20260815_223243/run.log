package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            exerciseMalformed(anchor[i]);
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 8)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "-" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "+" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(3) + (data.consumeBoolean() ? "f" : "F");
                    break;
                case 7:
                    probe = data.consumeAsciiString(4) + (data.consumeBoolean() ? "d" : "D");
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            exerciseMalformed(probe);
        }

        /*
         * Contract used for this oracle:
         * createNumber selects a numeric type from the textual form. For the same valid numeric payload,
         * an explicit 'D' suffix and an explicit 'd' suffix denote the same number, and both must agree
         * with the helper createDouble on that payload. A throw-suppressing or branch-skipping patch in
         * the suffix-dispatch region would break this equality even if no exception is observed.
         */
        {
            String numeric = buildValidDoublePayload(data);
            String upper = numeric + "D";
            String lower = numeric + "d";
            try {
                Number upperParsed = NumberUtils.createNumber(upper);
                Number lowerParsed = NumberUtils.createNumber(lower);
                Double helper = NumberUtils.createDouble(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                if (upperParsed == null || lowerParsed == null || helper == null || unsuffixed == null) {
                    return;
                }

                long upperBits = Double.doubleToLongBits(upperParsed.doubleValue());
                long lowerBits = Double.doubleToLongBits(lowerParsed.doubleValue());
                long helperBits = Double.doubleToLongBits(helper.doubleValue());
                long unsuffixedBits = Double.doubleToLongBits(unsuffixed.doubleValue());

                if (upperBits != lowerBits) {
                    throw new RuntimeException(
                            "[oracle:double-suffix-case-consistency] metamorphic violation: createNumber(numeric+'D') must equal createNumber(numeric+'d') input="
                                    + numeric + " upper=" + upperParsed + " lower=" + lowerParsed);
                }
                if (upperBits != helperBits) {
                    throw new RuntimeException(
                            "[oracle:double-suffix-helper-consistency] metamorphic violation: createNumber(numeric+'D') must agree with createDouble(numeric) input="
                                    + upper + " lhs=" + upperParsed + " rhs=" + helper);
                }
                if (lowerBits != helperBits) {
                    throw new RuntimeException(
                            "[oracle:double-lower-suffix-helper-consistency] metamorphic violation: createNumber(numeric+'d') must agree with createDouble(numeric) input="
                                    + lower + " lhs=" + lowerParsed + " rhs=" + helper);
                }
                if (upperBits != unsuffixedBits) {
                    throw new RuntimeException(
                            "[oracle:double-suffix-unsuffixed-value] metamorphic violation: explicit double suffix and unsuffixed parse must denote the same numeric value input="
                                    + numeric + " suffixed=" + upperParsed + " unsuffixed=" + unsuffixed);
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseInRegion(e)) {
                    return;
                }
                return;
            }
        }
