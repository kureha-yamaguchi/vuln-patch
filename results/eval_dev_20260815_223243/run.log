        String bigDigits = big.toString();
        String bigWithSuffix = bigDigits + (data.consumeBoolean() ? "L" : "l");
        Number lhs = NumberUtils.createNumber(bigWithSuffix);
        BigInteger rhs = NumberUtils.createBigInteger(bigDigits);
        if (!(lhs instanceof BigInteger) || !rhs.equals(lhs)) {
            throw new RuntimeException(
