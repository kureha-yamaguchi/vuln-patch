package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            exerciseMalformed(anchor[i]);
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 9)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = "-" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "+" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String numeric = "+" + buildDigits(data, 1, 18, false);
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number parsed = NumberUtils.createNumber(suffixed);
                Long helper = NumberUtils.createLong(numeric);

                /*
                 * Contract asserted:
                 * createNumber's "requesting a specific type" long-suffix branch must agree with the
                 * dedicated helper createLong on the same valid integral payload. A leading '+' is a
                 * valid sign for Long.valueOf, so createNumber(numeric+L) must preserve the same value.
                 * A patch that merely suppresses the old crash or keeps the old over-restrictive guard
                 * would reject or misparse these helper-valid inputs.
                 */
                if (!(parsed instanceof Long) || helper == null || parsed.longValue() != helper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-long-helper-agree] metamorphic violation: createNumber(+decimal+L) must agree with createLong(+decimal) input="
                                    + suffixed + " lhs=" + parsed + " rhs=" + helper);
                }

                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || lower.longValue() != upper.longValue()
                        || upper.longValue() != helper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-long-suffix-case-consistency] metamorphic violation: lowercase/uppercase long suffixes must agree on helper-valid +decimal input="
                                    + numeric + " lower=" + lower + " upper=" + upper + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseLeak(e)) {
                    return;
                }
                return;
            }
        }

        {
            String bigNumeric = "+" + buildOverflowDigits(data);
            String suffixed = bigNumeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number parsed = NumberUtils.createNumber(suffixed);
                BigInteger helper = NumberUtils.createBigInteger(bigNumeric);

                /*
                 * Contract asserted:
                 * In the explicit long-suffix branch, if the helper parse is too large for long,
                 * createNumber must fall back to createBigInteger while preserving the value.
                 * This cross-check computes the same quantity via the dedicated helper on a
                 * plus-signed decimal that is valid by construction and guaranteed to overflow long.
                 */
                if (!(parsed instanceof BigInteger) || helper == null || !helper.equals(parsed)) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-overflow-bigint-fallback] metamorphic violation: createNumber(+overflow-decimal+L) must agree with createBigInteger(+decimal) input="
                                    + suffixed + " lhs=" + parsed + " rhs=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseLeak(e)) {
                    return;
                }
            }
        }
    }

    private static void exerciseMalformed(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseLeak(e)) {
                return;
            }
        }
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseLeak(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cn)
                    && ("createNumber".equals(mn)
                    || "createLong".equals(mn)
                    || "createBigInteger".equals(mn)
                    || "createInteger".equals(mn)
                    || "createFloat".equals(mn)
                    || "createDouble".equals(mn)
                    || "createBigDecimal".equals(mn)
                    || "isDigits".equals(mn)
                    || "isAllZeros".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static String buildDigits(FuzzedDataProvider data, int minLen, int maxLen, boolean allowAllZeros) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        boolean anyNonZero = false;
        for (int i = 0; i < len; i++) {
            int d = data.consumeInt(0, 9);
            if (d != 0) {
                anyNonZero = true;
            }
            sb.append((char) ('0' + d));
        }
        if (!allowAllZeros && !anyNonZero) {
            sb.setCharAt(len - 1, '1');
        }
        return sb.toString();
    }

    private static String buildOverflowDigits(FuzzedDataProvider data) {
        String base = "9223372036854775808";
        int extra = data.consumeInt(0, 8);
        StringBuilder sb = new StringBuilder(base.length() + extra);
        sb.append(base);
        for (int i = 0; i < extra; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }
}
