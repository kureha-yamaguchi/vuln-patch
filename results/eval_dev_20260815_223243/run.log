package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealApi("off");

        invokeRealApi(makeFixedLengthAscii(data, 3));
        invokeRealApi(makeFixedLengthAscii(data, 4));
        invokeRealApi(data.consumeAsciiString(8));
        invokeRealApi(mutateLiteral("off", data));
        invokeRealApi(mutateLiteral("yes", data));
        invokeRealApi(mutateLiteral("true", data));
        invokeRealApi(data.consumeRemainingAsString());

        /* Contract/oracle:
         * BooleanUtils.toBoolean(String) treats the accepted true tokens case-insensitively.
         * The implementation explicitly compares each character against upper/lower-case variants
         * for "on", "yes", and "true"; the tests also exercise many case variants.
         * Therefore, for any correct implementation, a randomized ASCII case-variant of one of
         * these canonical true tokens must yield the same result as the canonical token itself.
         * A patch that merely deletes the crashing branch or makes it unreachable could silently
         * change one side to false; this observable relation catches that wrong-output behavior.
         */
        String canonical = pickCanonicalTrueToken(data);
        String variant = randomAsciiCase(canonical, data);
        try {
            boolean lhs = BooleanUtils.toBoolean(canonical);
            boolean rhs = BooleanUtils.toBoolean(variant);
            if (lhs != rhs || !lhs) {
                throw new RuntimeException(
                    "[oracle:case-true] metamorphic violation: case-insensitive true-token parsing input="
                        + printable(variant) + " lhs=" + lhs + " rhs=" + rhs + " canonical=" + printable(canonical));
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:case-true]")) {
                throw t;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean invokeRealApi(String s) {
        try {
            return BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return false;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return false;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String makeFixedLengthAscii(FuzzedDataProvider data, int len) {
        String s = data.consumeAsciiString(len);
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        StringBuilder b = new StringBuilder(s);
        while (b.length() < len) {
            int v = data.consumeInt(0, 25);
            b.append((char) ('a' + v));
        }
        if (b.length() > len) {
            return b.substring(0, len);
        }
        return b.toString();
    }

    private static String mutateLiteral(String base, FuzzedDataProvider data) {
        StringBuilder b = new StringBuilder(base);
        int action = data.consumeInt(0, 3);
        if (action == 0 && b.length() > 0) {
            int pos = data.consumeInt(0, b.length() - 1);
            b.setCharAt(pos, (char) data.consumeInt(32, 126));
        } else if (action == 1) {
            int pos = data.consumeInt(0, b.length());
            b.insert(pos, (char) data.consumeInt(32, 126));
        } else if (action == 2 && b.length() > 0) {
            int pos = data.consumeInt(0, b.length() - 1);
            b.deleteCharAt(pos);
        } else {
            int pos = data.consumeInt(0, b.length());
            b.insert(pos, data.consumeAsciiString(2));
        }
        return b.toString();
    }

    private static String pickCanonicalTrueToken(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 2)) {
            case 0:
                return "on";
            case 1:
                return "yes";
            default:
                return "true";
        }
    }

    private static String randomAsciiCase(String s, FuzzedDataProvider data) {
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                b.append(Character.toUpperCase(ch));
            } else {
                b.append(Character.toLowerCase(ch));
            }
        }
        return b.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '\\' || ch == '"') {
                b.append('\\').append(ch);
            } else if (ch < 32 || ch > 126) {
                b.append("\\u");
                String hex = Integer.toHexString(ch);
                for (int j = hex.length(); j < 4; j++) {
                    b.append('0');
                }
                b.append(hex);
            } else {
                b.append(ch);
            }
        }
        b.append('"');
        return b.toString();
    }
}
