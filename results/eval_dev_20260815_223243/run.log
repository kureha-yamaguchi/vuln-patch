package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            try {
                NumberUtils.createNumber(anchor[i]);
            } catch (IllegalArgumentException e) {
                // Clean rejection is correct on fixed builds.
            } catch (RuntimeException e) {
                // Exact known buggy symptom on malformed inputs; do not report duplicate crash-only evidence.
            }
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 9)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = "-" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "-" + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(2) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            try {
                NumberUtils.createNumber(probe);
            } catch (IllegalArgumentException e) {
                // Expected for malformed probes.
            } catch (RuntimeException e) {
                // Only propagate the known root cause for valid-by-construction long-suffix inputs.
                boolean validByConstruction = false;
                if (probe != null && probe.length() >= 2) {
                    char sfx = probe.charAt(probe.length() - 1);
                    if (sfx == 'l' || sfx == 'L') {
                        String numeric = probe.substring(0, probe.length() - 1);
                        boolean digits = true;
                        int start = 0;
                        if (numeric.length() > 0 && numeric.charAt(0) == '-') {
                            start = 1;
                        }
                        if (start < numeric.length()) {
                            for (int j = start; j < numeric.length(); j++) {
                                if (!Character.isDigit(numeric.charAt(j))) {
                                    digits = false;
                                    break;
                                }
                            }
                            validByConstruction = digits;
                        }
                    }
                }

                boolean inRegion = false;
                StackTraceElement[] st = e.getStackTrace();
                for (int j = 0; j < st.length; j++) {
                    String cn = st[j].getClassName();
                    String mn = st[j].getMethodName();
                    if ("org.apache.commons.lang.NumberUtils".equals(cn)
                            && ("createNumber".equals(mn)
                            || "createLong".equals(mn)
                            || "createBigInteger".equals(mn)
                            || "isDigits".equals(mn)
                            || "createInteger".equals(mn)
                            || "isAllZeros".equals(mn)
                            || "createFloat".equals(mn)
                            || "createDouble".equals(mn)
                            || "createBigDecimal".equals(mn))) {
