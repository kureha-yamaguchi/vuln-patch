    private static void runAnchorExamples() {
        checkAnchor(null, new String[] { "a" }, new String[] { "b" }, null, "doc-null-text");
        checkAnchor("aba", null, null, "aba", "doc-null-arrays");
        checkAnchor("aba", new String[0], null, "aba", "doc-empty-search-array");
        checkAnchor("aba", null, new String[0], "aba", "doc-empty-repl-array");
        checkAnchor("aba", new String[] { "a" }, null, "aba", "doc-null-repl-array");
        checkAnchor("aba", new String[] { null }, new String[] { "a" }, "aba", "doc-null-search-elem");
        checkAnchor("aba", new String[] { "a" }, new String[] { null }, "aba", "doc-null-repl-elem");
        checkAnchor("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "doc-mixed-null-repl");
    }

    private static void checkAnchor(String text, String[] search, String[] repl, String expected, String id) {
        try {
            String actual = StringUtils.replaceEach(text, search, repl);
            if (!same(expected, actual)) {
                throw new RuntimeException("[oracle:" + id + "] metamorphic violation: expected="
                        + quote(expected) + " actual=" + quote(actual)
                        + " input=" + summarize(text, search, repl));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:" + id + "] valid documented example threw from replaceEach input="
                        + summarize(text, search, repl), e);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "length".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String[] filterSearch(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() != 0 && repl[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() != 0 && repl[i] != null) {
                out[j++] = search[i];
            }
        }
        return out;
    }

    private static String[] filterRepl(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() != 0 && repl[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() != 0 && repl[i] != null) {
                out[j++] = repl[i];
            }
        }
        return out;
    }

    private static String[] rotate(String[] in, int amount) {
        String[] out = new String[in.length];
        if (in.length == 0) {
            return out;
        }
        for (int i = 0; i < in.length; i++) {
            out[(i + amount) % in.length] = in[i];
        }
        return out;
    }

    private static boolean same(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String summarize(String text, String[] search, String[] repl) {
        return "text=" + quote(text) + " search=" + arrayToString(search) + " repl=" + arrayToString(repl);
    }

    private static String arrayToString(String[] a) {
        if (a == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i > 0) {
                sb.append(", ");
            }
            sb.append(quote(a[i]));
        }
        sb.append(']');
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
