package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        String direct3 = data.consumeAsciiString(3);
        if (direct3.length() == 3) {
            exercise(direct3, true);
        }

        String surrounding = data.consumeAsciiString(16);
        if (surrounding.length() >= 3) {
            int start = data.consumeInt(0, surrounding.length() - 3);
            exercise(surrounding.substring(start, start + 3), true);
        }

        StringBuilder built = new StringBuilder(3);
        for (int i = 0; i < 3; i++) {
            int choice = data.consumeInt(0, 5);
            switch (choice) {
                case 0:
                    built.append((char) ('a' + data.consumeInt(0, 25)));
                    break;
                case 1:
                    built.append((char) ('A' + data.consumeInt(0, 25)));
                    break;
                case 2:
                    built.append((char) ('0' + data.consumeInt(0, 9)));
                    break;
                case 3:
                    built.append('?');
                    break;
                case 4:
                    built.append('_');
                    break;
                default:
                    built.append((char) data.consumeInt(32, 126));
                    break;
            }
        }
        exercise(built.toString(), true);

        String known = pickKnownLiteral(data);
        exercise(known, true);

        String canonical = pickCanonicalTrueToken(data);
        String variedCase = randomizeAsciiCase(canonical, data);
        /* Contract/oracle: BooleanUtils.toBoolean(String) implements explicit upper/lower-case
         * character checks for accepted true tokens ("true", "on", "yes"), so any ASCII case
         * variant of the same canonical token must parse identically. A patch that merely avoids
         * the crash by making the branch unreachable or by returning false for valid "yes"/"YES"
         * inputs would violate this relation.
         */
        checkEquivalentInputsOracle(canonical, variedCase);
    }

    private static void exercise(String input, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentInputsOracle(String a, String b) {
        boolean lhs;
        boolean rhs;
        try {
            lhs = BooleanUtils.toBoolean(a);
            rhs = BooleanUtils.toBoolean(b);
        } catch (RuntimeException t) {
            return;
        }
        if (lhs != rhs) {
            throw new RuntimeException(
                "[oracle:case-variant] metamorphic violation: equivalent ASCII case variants disagreed input="
                    + quote(a) + " lhs=" + lhs + " rhsInput=" + quote(b) + " rhs=" + rhs);
        }
    }

    private static String pickCanonicalTrueToken(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 2)) {
            case 0:
                return "yes";
            case 1:
                return "true";
            default:
                return "on";
        }
    }

    private static String pickKnownLiteral(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 13)) {
            case 0:
                return "oof";
            case 1:
                return "yep";
            case 2:
                return "trux";
            case 3:
                return "false";
            case 4:
                return "a";
            case 5:
                return "true";
            case 6:
                return "truE";
            case 7:
                return "TRUE";
            case 8:
                return "on";
            case 9:
                return "ON";
            case 10:
                return "yes";
            case 11:
                return "YES";
            case 12:
                return "yes?";
            default:
                return "tru";
        }
    }

    private static String randomizeAsciiCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch >= 'a' && ch <= 'z') {
                sb.append(data.consumeBoolean() ? Character.toUpperCase(ch) : ch);
            } else if (ch >= 'A' && ch <= 'Z') {
                sb.append(data.consumeBoolean() ? Character.toLowerCase(ch) : ch);
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(f.getClassName())
                && "toBoolean".equals(f.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
