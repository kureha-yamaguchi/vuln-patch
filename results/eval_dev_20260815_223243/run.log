        // Metamorphic oracle:
        // Contract visible in BooleanUtils.toBoolean(String): it accepts case-insensitive forms
        // of "true", "yes", and "on". Therefore equivalent case variants must agree and evaluate
        // to true. A throw-deleting or overfitted patch that simply forces false on a reachable
        // branch would violate this observable result.
        String canonical;
        switch (data.consumeInt(0, 2)) {
            case 0:
                canonical = "true";
                break;
            case 1:
                canonical = "yes";
                break;
            default:
                canonical = "on";
                break;
