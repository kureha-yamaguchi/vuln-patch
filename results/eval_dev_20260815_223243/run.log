private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight) throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(absentStart, exactRight);
            byIndex = series.createCopy(rightIndex, rightIndex);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: extending an empty gap to the exact right boundary should yield the right singleton", e);
            }
            throw e;
        }

        /* Contract used here: createCopy(start,end) returns the items whose periods lie in [start,end].
           Since absentStart is inside the gap immediately before exactRight, the only included item is exactRight.
           The equivalent index-based request [rightIndex,rightIndex] must therefore produce the same singleton. */
        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight
                    + " rightIndex=" + rightIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
        if (byBoundary.getValue(0) == null || !byBoundary.getValue(0).equals(byIndex.getValue(0))) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton value mismatch"
                    + " byBoundaryValue=" + byBoundary.getValue(0)
                    + " byIndexValue=" + byIndex.getValue(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
    }
</xref>
