package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchors();
        String fuzz = buildValidByConstructionInput(data);
        if (fuzz == null || fuzz.length() == 0) {
            return;
        }
        tryEscapeAndOracle(fuzz);
    }

    private static void runAnchors() {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            tryEscapeAndOracle(anchors[i]);
        }
    }

    private static String buildValidByConstructionInput(FuzzedDataProvider data) {
        int parts = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                sb.append(safeAsciiChunk(data));
            } else {
                sb.append(validSurrogatePair(data));
            }
        }
        if (sb.length() == 0) {
            sb.append(validSurrogatePair(data));
        }
        return sb.toString();
    }

    private static String safeAsciiChunk(FuzzedDataProvider data) {
        int len = data.consumeInt(0, 8);
        String raw = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                c = 'A';
            }
            if (c < 0x20 || c > 0x7e) {
                c = 'B';
            }
            sb.append(c);
        }
        return sb.toString();
    }

    private static String validSurrogatePair(FuzzedDataProvider data) {
        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        return new String(Character.toChars(codePoint));
    }

    private static void tryEscapeAndOracle(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Oracle: escapeCsv only adds CSV escaping when the input contains CSV special
             * characters (comma, quote, CR, LF). For inputs constructed here, we exclude all
             * such characters by construction while still including valid supplementary code
             * points encoded as surrogate pairs. Therefore a correct implementation must return
             * the original input unchanged. A throw-deleting or branch-skipping patch could
             * silently drop/mis-handle surrogate pairs and violate this observable result.
             */
            if (!escaped.equals(input)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(input)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length();) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                i += 2;
                continue;
            }
            if (Character.isLowSurrogate(ch)) {
                return false;
            }
            i++;
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("malformed") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
