package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runOnKnownValid("\uD83D\uDE30", true);
        runOnKnownValid("\uD800\uDC00", true);
        runOnKnownValid("\uD834\uDD1E", true);
        runOnKnownValid("\uDBFF\uDFFD", true);

        String fuzzed = buildValidSafeCsvString(data);
        runOnKnownValid(fuzzed, true);

        String second = buildValidSafeCsvString(data);
        runOnKnownValid(second, true);
    }

    private static void runOnKnownValid(String input, boolean validByConstruction) {
        String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        /*
         * Oracle: StringEscapeUtils.escapeCsv returns the input unchanged when the input contains
         * none of the CSV characters that require quoting/escaping (comma, quote, CR, LF).
         * We build inputs from safe ASCII plus valid UTF-16 surrogate pairs only, so a correct
         * implementation must accept them and return exactly the original string. A patch that
         * merely suppresses the crash by skipping or mangling consumed characters would violate
         * this observable post-condition.
         */
        if (isCsvSafe(input) && !input.equals(escaped)) {
            throw new RuntimeException(
                "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe valid strings input="
                    + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
        }

        String escapedTwice;
        try {
            escapedTwice = StringEscapeUtils.escapeCsv(escaped);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (escapedTwice != null && !escapedTwice.equals(escaped)) {
            throw new RuntimeException(
                "[oracle:csv-idempotent] metamorphic violation: escapeCsv should be idempotent on already escaped output input="
                    + printable(input) + " lhs=" + printable(escapedTwice) + " rhs=" + printable(escaped));
        }
    }

    private static String buildValidSafeCsvString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        sb.append(toSafeAscii(data.consumeAsciiString(16)));

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            sb.append(toSafeAscii(data.consumeAsciiString(8)));
        }

        if (sb.length() == 0) {
            sb.append('A').append(Character.toChars(0x1F600)).append('B');
        }
        return sb.toString();
    }

    private static String toSafeAscii(String raw) {
        StringBuilder sb = new StringBuilder(raw.length());
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append((char) ('A' + (c & 15)));
            } else if (c < 32 || c > 126) {
                sb.append((char) ('a' + (Math.abs(c) % 26)));
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCsvSafe(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (StackTraceElement ste : trace) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 32 || c > 126) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
