package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.geometry.Point;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            tryAnchor();
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracle(t)) {
                throw t;
            }
        }

        float tweak = boundedFloat(data.consumeInt(), -0.02f, 0.02f);
        float dx = boundedFloat(data.consumeInt(), -0.02f, 0.02f);
        float dy = boundedFloat(data.consumeInt(), -0.02f, 0.02f);
        float dz = boundedFloat(data.consumeInt(), -0.02f, 0.02f);
        int rounds = data.consumeInt(1, 4);

        for (int i = 0; i < rounds; i++) {
            float localTweak = tweak + boundedFloat(data.consumeInt(), -0.005f, 0.005f);
            float localDx = dx + boundedFloat(data.consumeInt(), -0.005f, 0.005f);
            float localDy = dy + boundedFloat(data.consumeInt(), -0.005f, 0.005f);
            float localDz = dz + boundedFloat(data.consumeInt(), -0.005f, 0.005f);
            try {
                triggerPolyhedron(localTweak, localDx, localDy, localDz);
            } catch (RuntimeException t) {
                if (isRootCause(t) || isOracle(t)) {
                    throw t;
                }
            }
        }
    }

    private static void tryAnchor() {
        triggerPolyhedron(-0.000001f, 0.0f, 0.0f, 0.0f);
    }

    private static void triggerPolyhedron(float topXDelta, float vxDelta, float vyDelta, float vzDelta) {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f + vxDelta, 1.000000f + vyDelta, -1.000000f + vzDelta,
            1.000000f + topXDelta + vxDelta, 1.000000f + vyDelta, 1.000000f + vzDelta,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };

        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;

            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            Plane plane;
            try {
                plane = new Plane(v1, v2, v3);
            } catch (RuntimeException ex) {
                return;
            }

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            PolygonsSet facetRegion;
            try {
                facetRegion = triangleRegion(p1, p2, p3);
            } catch (RuntimeException ex) {
                if (isRootCause(ex)) {
                    throw ex;
                }
                return;
            }

            // Contract/oracle: for a non-collinear triangle we construct from three projected points,
            // the resulting region denotes that triangle, so its reported area and barycenter must
            // match the same quantities recovered independently from the input points.
            // A patch that merely suppresses the known throw can still leave the facet empty/wrong.
            try {
                checkTriangleConsistency(facetRegion, p1, p2, p3);
            } catch (RuntimeException ex) {
                if (isRootCause(ex) || isOracle(ex)) {
                    throw ex;
                }
                return;
            }

            facets.add(new SubPlane(plane, facetRegion));
        }

        try {
            PolyhedronsSet poly = new PolyhedronsSet(facets);
            poly.getSize();
            poly.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static PolygonsSet triangleRegion(Vector2D p1, Vector2D p2, Vector2D p3) {
        Collection<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> lines =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>(3);
        lines.add(new Line(p1, p2).wholeHyperplane());
        lines.add(new Line(p2, p3).wholeHyperplane());
        lines.add(new Line(p3, p1).wholeHyperplane());
        return new PolygonsSet(lines);
    }

    private static void checkTriangleConsistency(PolygonsSet facetRegion, Vector2D a, Vector2D b, Vector2D c) {
        double expectedArea = triangleArea(a, b, c);
        if (!(expectedArea > 1.0e-12)) {
            return;
        }

        double reportedArea;
        Point<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D> baryPoint;
        int h1;
        int h2;
        try {
            reportedArea = facetRegion.getSize();
            baryPoint = facetRegion.getBarycenter();
            h1 = facetRegion.hashCode();
            h2 = facetRegion.hashCode();
        } catch (RuntimeException ex) {
            if (isRootCause(ex)) {
                throw ex;
            }
            return;
        }

        if (h1 != h2) {
            throw new RuntimeException("[oracle:hash-stable] metamorphic violation: repeated hashCode changed lhs=" + h1 + " rhs=" + h2);
        }

        if (!(baryPoint instanceof Vector2D)) {
            return;
        }
        Vector2D reportedBary = (Vector2D) baryPoint;
        Vector2D expectedBary = new Vector2D(
                (a.getX() + b.getX() + c.getX()) / 3.0,
                (a.getY() + b.getY() + c.getY()) / 3.0);

        double areaTol = Math.max(1.0e-8, expectedArea * 1.0e-5);
        if (Double.isFinite(reportedArea) && Math.abs(reportedArea - expectedArea) > areaTol) {
            throw new RuntimeException("[oracle:facet-area] metamorphic violation: triangle area mismatch expected=" + expectedArea + " reported=" + reportedArea);
        }

