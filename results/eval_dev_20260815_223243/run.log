package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.geometry.euclidean.oned.IntervalsSet;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    private static final int[] TRIANGLE_INDICES = {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        float[] anchor = new float[] {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };

        try {
            exerciseExactAnchor(anchor);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        float[] coords = anchor.clone();
        int vertex = data.consumeInt(0, 7);
        int axis = data.consumeInt(0, 2);
        int microDelta = data.consumeInt(-8, 8);
        coords[vertex * 3 + axis] += microDelta * 1.0e-6f;

        int secondVertex = data.consumeInt(0, 7);
        if (secondVertex != vertex) {
            int secondAxis = data.consumeInt(0, 2);
            int secondMicroDelta = data.consumeInt(-4, 4);
            coords[secondVertex * 3 + secondAxis] += secondMicroDelta * 1.0e-6f;
        }

        int rotateTriangles = data.consumeInt(0, (TRIANGLE_INDICES.length / 3) - 1);
        int cycleA = data.consumeInt(0, 2);
        int cycleB = data.consumeInt(0, 2);
        boolean reverseA = data.consumeBoolean();
        boolean reverseB = data.consumeBoolean();

        try {
            PolyhedronsSet a = buildPolyhedron(coords, 0, cycleA, reverseA);
            PolyhedronsSet b = buildPolyhedron(coords, rotateTriangles, cycleB, reverseB);

            double sizeA = a.getSize();
            double sizeB = b.getSize();
            Vector3D baryA = a.getBarycenter();
            Vector3D baryB = b.getBarycenter();

            /* Same triangular facets, only reordered and cyclically re-started, describe the same boundary.
               A correct implementation must therefore report the same size and barycenter. */
            if (!close(sizeA, sizeB)) {
                throw new RuntimeException("[oracle:facet-order] metamorphic violation: equivalent facet order changed size inputRotate="
                    + rotateTriangles + " lhs=" + sizeA + " rhs=" + sizeB);
            }
            if (!close(baryA.getX(), baryB.getX()) || !close(baryA.getY(), baryB.getY()) || !close(baryA.getZ(), baryB.getZ())) {
                throw new RuntimeException("[oracle:facet-order] metamorphic violation: equivalent facet order changed barycenter "
                    + "lhs=(" + baryA.getX() + "," + baryA.getY() + "," + baryA.getZ() + ") rhs=("
                    + baryB.getX() + "," + baryB.getY() + "," + baryB.getZ() + ")");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    static void exerciseExactAnchor(float[] coords) {
        PolyhedronsSet p = buildPolyhedron(coords, 0, 0, false);
        p.getSize();
        p.getBarycenter();
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords, int triangleRotation, int cyclicShift, boolean reverseOrder) {
        ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
            new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();

        int triangleCount = TRIANGLE_INDICES.length / 3;
        for (int t = 0; t < triangleCount; t++) {
            int logical = reverseOrder ? (triangleCount - 1 - t) : t;
            int tri = (logical + triangleRotation) % triangleCount;
            int base = tri * 3;

            int ia = TRIANGLE_INDICES[base];
            int ib = TRIANGLE_INDICES[base + 1];
            int ic = TRIANGLE_INDICES[base + 2];

            if (cyclicShift == 1) {
                int tmp = ia;
                ia = ib;
                ib = ic;
                ic = tmp;
            } else if (cyclicShift == 2) {
                int tmp = ia;
                ia = ic;
                ic = ib;
                ib = tmp;
            }

            Vector3D v1 = vector(coords, ia);
            Vector3D v2 = vector(coords, ib);
            Vector3D v3 = vector(coords, ic);

            Plane plane = new Plane(v1, v2, v3);

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            ArrayList<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
            addEdge(edges, p1, p2);
            addEdge(edges, p2, p3);
            addEdge(edges, p3, p1);

            PolygonsSet polygon = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, polygon));
        }

        return new PolyhedronsSet(facets);
    }

    private static Vector3D vector(float[] coords, int i) {
        int o = i * 3;
        return new Vector3D(coords[o], coords[o + 1], coords[o + 2]);
    }

    private static void addEdge(ArrayList<SubHyperplane<Euclidean2D>> edges, Vector2D start, Vector2D end) {
        Line line = new Line(start, end);
        double a = line.toSubSpace(start).getX();
        double b = line.toSubSpace(end).getX();
        if (a <= b) {
            edges.add(new SubLine(line, new IntervalsSet(a, b)));
        } else {
            edges.add(new SubLine(line, new IntervalsSet(b, a)));
        }
    }

    private static boolean close(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-7 * scale;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("MathIllegal") || name.contains("Invalid") || name.contains("TooMany") || name.contains("NoData");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && "computeGeometricalProperties".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && "getVertices".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cls)
                    && "getSize".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
