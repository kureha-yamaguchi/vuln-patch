package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        String text = data.consumeAsciiString(32);
        String search = data.consumeAsciiString(8);
        String replacement = data.consumeAsciiString(8);

        if (search == null || search.length() == 0) {
            search = "a";
        }

        // Explore the root-cause property from the failing test:
        // a null element inside replacementList is documented-valid input for replaceEach.
        String prefix = data.consumeAsciiString(16);
        String suffix = data.consumeAsciiString(16);
        String anchorText = prefix + "a" + suffix;
        String[] searchList = new String[] { "a", "b" };
        String[] replacementList = new String[] { "c", null };
        try {
            String result = StringUtils.replaceEach(anchorText, searchList, replacementList);
            String expected = StringUtils.replace(anchorText, "a", "c");
            if (!safeEquals(result, expected)) {
                throw new RuntimeException("[oracle:null-repl-prefix-suffix] metamorphic violation: replaceEach should ignore null replacement entries and agree with singleton replacement input=" + anchorText + " lhs=" + result + " rhs=" + expected);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        // Documented contract used here:
        // replaceEach(text, new String[]{s}, new String[]{r}) should perform the same replacement
        // as the corresponding single-search public API on the same valid inputs.
        // A throw-deleting or seed-special-casing patch can still return a wrong string; this catches that.
        try {
            String lhs = StringUtils.replaceEach(text, new String[] { search }, new String[] { replacement });
            String rhs = StringUtils.replace(text, search, replacement);

            if (!safeEquals(lhs, rhs)) {
                throw new RuntimeException("[oracle:singleton-equiv] metamorphic violation: singleton replaceEach must agree with replace input=" + text + " search=" + search + " replacement=" + replacement + " lhs=" + lhs + " rhs=" + rhs);
            }

            // Independent cross-check using a different reachable function in the region set:
            // StringUtils.length(str) is specified as null ? 0 : str.length(), so it must match the JDK length.
            int reported = StringUtils.length(lhs);
            int independent = (lhs == null) ? 0 : lhs.length();
            if (reported != independent) {
                throw new RuntimeException("[oracle:length-self] metamorphic violation: StringUtils.length disagrees with String.length value=" + lhs + " reported=" + reported + " independent=" + independent);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorChecks() {
        try {
            if (StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" }) != null) {
                throw new RuntimeException("[oracle:anchor-null-text] metamorphic violation: null text must return null");
            }

            String r1 = StringUtils.replaceEach("aba", null, null);
            if (!"aba".equals(r1)) {
                throw new RuntimeException("[oracle:anchor-null-arrays] metamorphic violation: null arrays must leave text unchanged lhs=" + r1);
            }

            String r2 = StringUtils.replaceEach("aba", new String[0], null);
            if (!"aba".equals(r2)) {
                throw new RuntimeException("[oracle:anchor-empty-search] metamorphic violation: empty search array must leave text unchanged lhs=" + r2);
            }

            String r3 = StringUtils.replaceEach("aba", null, new String[0]);
            if (!"aba".equals(r3)) {
                throw new RuntimeException("[oracle:anchor-empty-repl] metamorphic violation: empty replacement array must leave text unchanged lhs=" + r3);
            }

            String r4 = StringUtils.replaceEach("aba", new String[] { "a" }, null);
            if (!"aba".equals(r4)) {
                throw new RuntimeException("[oracle:anchor-null-repl-array] metamorphic violation: null replacement array must leave text unchanged lhs=" + r4);
            }

            String r5 = StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" });
            if (!"aba".equals(r5)) {
                throw new RuntimeException("[oracle:anchor-null-search-elt] metamorphic violation: null search element must be ignored lhs=" + r5);
            }

            String r6 = StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { null });
            if (!"aba".equals(r6)) {
                throw new RuntimeException("[oracle:anchor-null-repl-elt] metamorphic violation: null replacement element must be ignored lhs=" + r6);
            }

            String r7 = StringUtils.replaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null });
            if (!"cbc".equals(r7)) {
                throw new RuntimeException("[oracle:anchor-exact] metamorphic violation: expected cbc for documented null-element case lhs=" + r7);
            }

            int reported = StringUtils.length(r7);
            int independent = r7.length();
            if (reported != independent) {
                throw new RuntimeException("[oracle:anchor-length] metamorphic violation: StringUtils.length disagrees on anchor result reported=" + reported + " independent=" + independent);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (!isCleanRejection(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
