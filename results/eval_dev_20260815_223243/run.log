package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorOracle();
        runConstructedMappingOracle(data);
    }

    private static void runAnchorOracle() {
        String text = "aba";
        String[] search = new String[] {"a", "b"};
        String[] repl = new String[] {"c", null};

        try {
            String actual = StringUtils.replaceEach(text, search, repl);
            if (!"cbc".equals(actual)) {
                throw new RuntimeException("[oracle:anchor-exact] metamorphic violation: documented test case must yield cbc input=aba lhs="
                        + actual + " rhs=cbc");
            }
            int reportedLen = StringUtils.length(actual);
            int independentLen = 3;
            if (reportedLen != independentLen) {
                throw new RuntimeException("[oracle:anchor-len] consistency violation: reportedLen="
                        + reportedLen + " independentLen=" + independentLen);
            }
        } catch (RuntimeException t) {
            if (hasReplaceEachFrame(t)) {
                throw new RuntimeException("[oracle:anchor-exact] unexpected exception on documented valid input", t);
            }
        }
    }

    private static void runConstructedMappingOracle(FuzzedDataProvider data) {
        char s0 = pickChar(data.consumeInt(), 'a');
        char s1 = pickDistinctChar(data.consumeInt(), s0, 'b');
        char sNull = pickDistinctChar(data.consumeInt(), s0, s1, 'x');
        char filler = pickDistinctChar(data.consumeInt(), s0, s1, sNull, 'z');

        char r0 = pickDistinctChar(data.consumeInt(), s0, s1, sNull, filler, Character.toUpperCase(s0));
        char r1 = pickDistinctChar(data.consumeInt(), s0, s1, sNull, filler, r0, Character.toUpperCase(s1));

        String[] search = new String[] {
                String.valueOf(s0),
                String.valueOf(s1),
                String.valueOf(sNull)
        };
        String[] repl = new String[] {
                String.valueOf(r0),
                String.valueOf(r1),
                null
        };

        int len = data.consumeInt(1, 40);
        StringBuilder text = new StringBuilder(len);
        StringBuilder expected = new StringBuilder(len);
        boolean sawActive = false;

        for (int i = 0; i < len; i++) {
            int choice = data.consumeInt(0, 3);
            char in;
            if (choice == 0) {
                in = s0;
                sawActive = true;
                expected.append(r0);
            } else if (choice == 1) {
                in = s1;
                sawActive = true;
                expected.append(r1);
            } else if (choice == 2) {
                in = sNull;
                expected.append(sNull);
            } else {
                in = filler;
                expected.append(filler);
            }
            text.append(in);
        }

        if (!sawActive) {
            text.setCharAt(0, s0);
            expected.setCharAt(0, r0);
        }

        String input = text.toString();
        String exp = expected.toString();

        try {
            String actual = StringUtils.replaceEach(input, search, repl);

            /* Contract used for this oracle:
             * The public replaceEach API skips entries whose replacement is null (as shown by the
             * library's own tests), while applying the remaining replacements. Because this input is
             * constructed from single-character, non-overlapping search tokens, the exact output is
             * known from construction: s0->r0, s1->r1, sNull stays unchanged, filler stays unchanged.
             * A throw-deleting or overfitted patch that simply suppresses the NPE but skips legitimate
             * replacements will violate this content oracle.
             */
            if (!exp.equals(actual)) {
                throw new RuntimeException("[oracle:construct-map] metamorphic violation: constructed single-char mapping input="
                        + input + " lhs=" + actual + " rhs=" + exp);
            }

            int reportedLen = StringUtils.length(actual);
            int independentLen = exp.length();
            if (reportedLen != independentLen) {
                throw new RuntimeException("[oracle:construct-len] consistency violation: input="
                        + input + " reportedLen=" + reportedLen + " independentLen=" + independentLen
                        + " actual=" + actual + " expected=" + exp);
            }
        } catch (RuntimeException t) {
            if (hasReplaceEachFrame(t)) {
                throw new RuntimeException("[oracle:construct-map] unexpected exception on valid constructed input="
                        + input, t);
            }
        }
    }

    private static boolean hasReplaceEachFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static char pickChar(int seed, char fallback) {
        int v = Math.abs(seed % 26);
        return (char) ('a' + v);
    }

    private static char pickDistinctChar(int seed, char a, char fallback) {
        char c = pickChar(seed, fallback);
        if (c != a) {
            return c;
        }
        for (char x = 'a'; x <= 'z'; x++) {
            if (x != a) {
                return x;
            }
        }
        return fallback;
    }

    private static char pickDistinctChar(int seed, char a, char b, char fallback) {
        char c = pickChar(seed, fallback);
        if (c != a && c != b) {
            return c;
        }
        for (char x = 'a'; x <= 'z'; x++) {
            if (x != a && x != b) {
                return x;
            }
        }
        return fallback;
    }

    private static char pickDistinctChar(int seed, char a, char b, char c0, char fallback) {
        char c = pickChar(seed, fallback);
        if (c != a && c != b && c != c0) {
            return c;
        }
        for (char x = 'a'; x <= 'z'; x++) {
            if (x != a && x != b && x != c0) {
                return x;
            }
        }
        return fallback;
    }

    private static char pickDistinctChar(int seed, char a, char b, char c0, char d, char fallback) {
        char c = pickChar(seed, fallback);
        if (c != a && c != b && c != c0 && c != d) {
            return c;
        }
        for (char x = 'a'; x <= 'z'; x++) {
            if (x != a && x != b && x != c0 && x != d) {
                return x;
            }
        }
        return fallback;
    }

    private static char pickDistinctChar(int seed, char a, char b, char c0, char d, char e, char fallback) {
        char c = pickChar(seed, fallback);
        if (c != a && c != b && c != c0 && c != d && c != e) {
            return c;
        }
        for (char x = 'a'; x <= 'z'; x++) {
            if (x != a && x != b && x != c0 && x != d && x != e) {
                return x;
            }
        }
        return fallback;
    }
}
