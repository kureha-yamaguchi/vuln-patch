    private static char asciiLetterish(byte b) {
        int v = b & 0xFF;
        int mode = v % 4;
        if (mode == 0) {
            return (char) ('a' + (v % 26));
        }
        if (mode == 1) {
            return (char) ('A' + (v % 26));
        }
        if (mode == 2) {
            return (char) ('0' + (v % 10));
        }
        return (char) ('?' + (v % 6));
    }

