package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1eE");

        String malformed = buildMalformedBothExponentMarkers(data);
        if (malformed != null) {
            NumberUtils.createNumber(malformed);
        }

        String valid = buildValidScientific(data);
        if (valid != null) {
            try {
                Number a = NumberUtils.createNumber(valid);
                Number b = NumberUtils.createNumber(flipExponentMarkerCase(valid));
                if (a != null && b != null && !sameNumericValue(a, b)) {
                    throw new RuntimeException("[oracle:scientific-exp-case] metamorphic violation: exponent marker case must not change numeric value input="
                            + valid + " flipped=" + flipExponentMarkerCase(valid) + " lhs=" + a + " rhs=" + b);
                }
            } catch (IllegalArgumentException ignored) {
            }
        }
    }

    private static String buildMalformedBothExponentMarkers(FuzzedDataProvider data) {
        String digits = digits(data.consumeInt(1, 6), false, data);
        String tailDigits = digits(data.consumeInt(0, 3), true, data);
        boolean lowerFirst = data.consumeBoolean();
        char first = lowerFirst ? 'e' : 'E';
        char second = lowerFirst ? 'E' : 'e';

        int shape = data.consumeInt(0, 5);
        switch (shape) {
            case 0:
                return digits + first + second;
            case 1:
                return digits + first + tailDigits + second;
            case 2:
                return "-" + digits + first + second;
            case 3:
                return digits + first + "+" + second;
            case 4:
                return digits + first + "-" + second;
            default:
                return "-" + digits + first + tailDigits + second;
        }
    }

    private static String buildValidScientific(FuzzedDataProvider data) {
        String mant = digits(data.consumeInt(1, 6), false, data);
        String frac = digits(data.consumeInt(1, 4), true, data);
        String exp = digits(data.consumeInt(1, 3), false, data);
        char marker = data.consumeBoolean() ? 'e' : 'E';
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? "-" : "";
        if (data.consumeBoolean()) {
            return sign + mant + marker + expSign + exp;
        }
        return sign + mant + "." + frac + marker + expSign + exp;
    }

    private static String flipExponentMarkerCase(String s) {
        int e = s.indexOf('e');
        if (e >= 0) {
            return s.substring(0, e) + 'E' + s.substring(e + 1);
        }
        int E = s.indexOf('E');
        if (E >= 0) {
            return s.substring(0, E) + 'e' + s.substring(E + 1);
        }
        return s;
    }

    private static String digits(int len, boolean allowZeroFirst, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(len);
        if (len <= 0) {
            return "";
        }
        int firstMin = allowZeroFirst ? 0 : 1;
        sb.append((char) ('0' + data.consumeInt(firstMin, 9)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ex) {
            return a.toString().equals(b.toString());
        }
    }
}
