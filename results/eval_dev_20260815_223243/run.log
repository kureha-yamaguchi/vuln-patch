private static void roundTripIntegralSuffixOracle(String withSuffix) {
        try {
            Number first = NumberUtils.createNumber(withSuffix);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number second = NumberUtils.createNumber(canonical);
            if (second == null) {
                return;
            }
            String canonical2 = second.toString();
            if (!canonical.equals(canonical2)) {
                throw new RuntimeException("[oracle:integral-roundtrip] metamorphic violation: createNumber(parseResult.toString()) changed canonical value input="
                        + withSuffix + " lhs=" + canonical + " rhs=" + canonical2);
            }
        } catch (RuntimeException e) {
            // If either side rejects, the relation does not apply to that input.
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:integral-roundtrip]")) {
                throw e;
            }
        }
    }
