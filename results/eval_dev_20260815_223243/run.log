                    break;
                case 2:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(1) + "e" + (data.consumeBoolean() ? "" : data.consumeAsciiString(1)) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "E" + (data.consumeBoolean() ? "" : data.consumeAsciiString(1)) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(3);
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            int base = data.consumeInt(-1_000_000, 1_000_000);
            int zeroCount = data.consumeInt(1, 6);
            boolean useUpper = data.consumeBoolean();

            String canonical = String.valueOf(base);
            String padded = padDecimalWithLeadingZeros(base, zeroCount);
            String suffix = useUpper ? "L" : "l";

            try {
                Number canonicalParsed = NumberUtils.createNumber(canonical + suffix);
                Number paddedParsed = NumberUtils.createNumber(padded + suffix);
                Long canonicalHelper = NumberUtils.createLong(canonical);
                Long paddedHelper = NumberUtils.createLong(padded);

                /*
                 * Contract asserted:
