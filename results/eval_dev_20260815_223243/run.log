            assertAbsentLookup(copy, start, "anchor-start");
            assertAbsentLookup(copy, end, "anchor-end");
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:anchor-valid-range-reject] metamorphic violation: failing-test valid range was rejected", e);
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException("[oracle:anchor-clone] metamorphic violation: unexpected clone failure", e);
        }
    }

    private static void addValue(TimeSeries series, RegularTimePeriod period, int value) {
        series.add(period, value);
    }

    private static Day dayFromEpochDay(int epochDay) {
        GregorianCalendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(1970, Calendar.JANUARY, 1);
        cal.add(Calendar.DAY_OF_MONTH, epochDay);
        return new Day(cal.getTime());
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static void assertLookupAgreement(TimeSeries series, RegularTimePeriod period, String tag) {
        int idx = series.getIndex(period);
        if (idx < 0) {
            throw new RuntimeException("[oracle:lookup-present-" + tag + "] metamorphic violation: existing period not found"
                    + " period=" + period + " idx=" + idx + " count=" + series.getItemCount());
        }

        TimeSeriesDataItem byPeriod = series.getDataItem(period);
        TimeSeriesDataItem byIndex = series.getDataItem(idx);
        if (byPeriod == null || byIndex == null) {
            throw new RuntimeException("[oracle:lookup-null-" + tag + "] metamorphic violation: existing period lookup returned null"
                    + " period=" + period + " idx=" + idx);
        }

        if (!byPeriod.getPeriod().equals(byIndex.getPeriod())) {
            throw new RuntimeException("[oracle:lookup-period-" + tag + "] metamorphic violation: period and index lookups disagree"
                    + " period=" + period
                    + " byPeriod=" + byPeriod.getPeriod()
                    + " byIndex=" + byIndex.getPeriod());
        }

        Number vp = series.getValue(period);
        Number vi = series.getValue(idx);
        if (vp == null ? vi != null : !vp.equals(vi)) {
            throw new RuntimeException("[oracle:lookup-value-" + tag + "] metamorphic violation: value and index lookups disagree"
                    + " period=" + period + " idx=" + idx
                    + " byPeriod=" + vp + " byIndex=" + vi);
        }
    }

    private static void assertAbsentLookup(TimeSeries series, RegularTimePeriod period, String tag) {
        int idx = series.getIndex(period);
        if (idx >= 0) {
            throw new RuntimeException("[oracle:absent-index-" + tag + "] metamorphic violation: empty copy unexpectedly contains period"
                    + " period=" + period + " idx=" + idx);
        }

        if (series.getDataItem(period) != null) {
            throw new RuntimeException("[oracle:absent-item-" + tag + "] metamorphic violation: absent period returned a data item"
                    + " period=" + period);
        }

        if (series.getValue(period) != null) {
            throw new RuntimeException("[oracle:absent-value-" + tag + "] metamorphic violation: absent period returned a value"
                    + " period=" + period + " value=" + series.getValue(period));
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
