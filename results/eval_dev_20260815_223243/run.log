                    }
                    return;
                } catch (CloneNotSupportedException e) {
                    return;
                } catch (RuntimeException e) {
                    throw e;
                }
            }
        } catch (RuntimeException e) {
            throw e;
        }
    }

    private static void addValue(TimeSeries series, Day day, int value, boolean useDoubleOverload) {
        if (useDoubleOverload) {
            series.add(day, (double) value);
        } else {
            series.add(day, Integer.valueOf(value));
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!isValidationFamily(t)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }
}
