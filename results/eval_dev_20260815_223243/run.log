    private static void exerciseValidEmptyGap(TimeSeries series, Day start, Day end,
                                              int rightEpochDay, int afterCount,
                                              FuzzedDataProvider data)
            throws CloneNotSupportedException {
        int startCmpEnd = start.compareTo(end);
        if (startCmpEnd > 0) {
            return;
        }

        int manualCount = countPeriodsInRange(series, start, end);
        if (manualCount != 0) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:detached-empty-copy] metamorphic violation: valid empty-gap copy rejected"
                        + " start=" + start + " end=" + end
                        + " itemCount=" + series.getItemCount(), e);
            }
            throw e;
        }

        assertEmptyCopy(copy, "[oracle:detached-empty-copy]", start, end);

        int mutations = data.consumeInt(1, 3);
        for (int i = 0; i < mutations; i++) {
            int extraOffset = afterCount + 1 + i + data.consumeInt(0, 2);
            Day extraDay = dayFromEpochDay(rightEpochDay + extraOffset);
            try {
                series.add(extraDay, Integer.valueOf(data.consumeInt(-1000, 1000)));
            } catch (RuntimeException e) {
                return;
            }

            if (!viewsAgree(series)) {
                throw new RuntimeException("[oracle:source-view-agree-after-mutation] metamorphic violation: source views disagree after mutation"
                        + " itemCount=" + series.getItemCount()
                        + " itemsSize=" + series.getItems().size()
