package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerAnchor();
        exploreEmptyBoundaryTrees(data);
        crossCheckClosedPolygonRebuild(data);
    }

    private static void triggerAnchor() {
        try {
            exerciseEmptyBoundaryTree(0.0, 0.0, 1.0, 0.0, true);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exploreEmptyBoundaryTrees(FuzzedDataProvider data) {
        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = bounded(data.consumeInt(), 1000.0);
            double y1 = bounded(data.consumeInt(), 1000.0);
            double dx = boundedNonZero(data.consumeInt(), 1000.0);
            double dy = bounded(data.consumeInt(), 1000.0);
            if (dx == 0.0 && dy == 0.0) {
                dx = 1.0;
            }
            boolean plusInside = data.consumeBoolean();
            try {
                exerciseEmptyBoundaryTree(x1, y1, x1 + dx, y1 + dy, plusInside);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static void exerciseEmptyBoundaryTree(
            double x1, double y1, double x2, double y2, boolean plusInside) {

        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D> cut =
                line.wholeHyperplane();

        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> plus =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.valueOf(plusInside));
        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> minus =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(Boolean.valueOf(!plusInside));
        org.apache.commons.math3.geometry.partitioning.BoundaryAttribute<Euclidean2D> attribute =
                new org.apache.commons.math3.geometry.partitioning.BoundaryAttribute<Euclidean2D>(null, null);
        org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D> root =
                new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(cut, plus, minus, attribute);

        PolygonsSet set = new PolygonsSet(root);

        Vector2D[][] before = set.getVertices();
        Vector2D[][] after = set.getVertices();
        if (before.length != after.length) {
            throw new RuntimeException("[oracle:vertices-idem] metamorphic violation: repeated getVertices length changed lhs="
                    + before.length + " rhs=" + after.length);
        }

        double size = set.getSize();
        Vector2D barycenter = (Vector2D) set.getBarycenter();

        if (plusInside) {
            if (!Double.isInfinite(size)) {
                throw new RuntimeException("[oracle:empty-tree-branch] metamorphic violation: expected infinite size for empty-vertex tree with plus-inside=true, got " + size);
            }
            if (!Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                throw new RuntimeException("[oracle:empty-tree-branch] metamorphic violation: expected NaN barycenter for empty-vertex tree with plus-inside=true, got ("
                        + barycenter.getX() + "," + barycenter.getY() + ")");
            }
        } else {
            if (size != 0.0) {
                throw new RuntimeException("[oracle:empty-tree-branch] metamorphic violation: expected zero size for empty-vertex tree with plus-inside=false, got " + size);
            }
            if (barycenter.getX() != 0.0 || barycenter.getY() != 0.0) {
                throw new RuntimeException("[oracle:empty-tree-branch] metamorphic violation: expected origin barycenter for empty-vertex tree with plus-inside=false, got ("
                        + barycenter.getX() + "," + barycenter.getY() + ")");
            }
        }
    }

    private static void crossCheckClosedPolygonRebuild(FuzzedDataProvider data) {
        double x = bounded(data.consumeInt(), 1000.0);
        double y = bounded(data.consumeInt(), 1000.0);
        double w = positiveSpan(data.consumeInt());
        double h = positiveSpan(data.consumeInt());

        Vector2D[] rectangle = new Vector2D[] {
                new Vector2D(x, y),
                new Vector2D(x + w, y),
                new Vector2D(x + w, y + h),
                new Vector2D(x, y + h)
        };

        try {
            PolygonsSet a = new PolygonsSet(1.0e-10, rectangle);
            Vector2D[][] loops = a.getVertices();
            if (loops.length != 1 || loops[0] == null || loops[0].length < 3 || loops[0][0] == null) {
                return;
            }

            PolygonsSet b = new PolygonsSet(1.0e-10, loops[0]);

            double sizeA = a.getSize();
            double sizeB = b.getSize();
            Vector2D ba = (Vector2D) a.getBarycenter();
            Vector2D bb = (Vector2D) b.getBarycenter();

            if (!close(sizeA, sizeB, 1.0e-8)) {
                throw new RuntimeException("[oracle:rebuild-size] metamorphic violation: rebuilding polygon from its own getVertices changed size lhs="
                        + sizeA + " rhs=" + sizeB);
            }
            if (!close(ba.getX(), bb.getX(), 1.0e-8) || !close(ba.getY(), bb.getY(), 1.0e-8)) {
                throw new RuntimeException("[oracle:rebuild-bary] metamorphic violation: rebuilding polygon from its own getVertices changed barycenter lhs=("
                        + ba.getX() + "," + ba.getY() + ") rhs=(" + bb.getX() + "," + bb.getY() + ")");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(ste.getClassName())
                    && ("computeGeometricalProperties".equals(ste.getMethodName())
                    || "getVertices".equals(ste.getMethodName())
                    || "getTree".equals(ste.getMethodName())
                    || "<init>".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof org.apache.commons.math3.exception.MathIllegalArgumentException;
    }

    private static double bounded(int value, double limit) {
        return Math.max(-limit, Math.min(limit, (double) value));
    }

    private static double boundedNonZero(int value, double limit) {
        double d = bounded(value, limit);
        if (d == 0.0) {
            return 1.0;
        }
        return d;
    }

    private static double positiveSpan(int value) {
        double d = Math.abs(bounded(value, 1000.0));
        if (d < 1.0e-3) {
            d += 1.0;
        }
        return d;
    }

    private static boolean close(double a, double b, double eps) {
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= eps * scale;
    }
}
