package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzzed = buildValidCsvSafeStringWithSupplementaryCodePoints(data);
        if (fuzzed == null || fuzzed.length() == 0) {
            return;
        }

        try {
            String escaped = StringEscapeUtils.escapeCsv(fuzzed);

            // Contract used for this oracle:
            // escapeCsv only adds CSV quoting/escaping when the input contains CSV special
            // characters (comma, quote, CR, LF). This harness constructs inputs that contain
            // none of those characters and are valid UTF-16 by construction, so every correct
            // implementation must return the input unchanged. A "fix" that merely avoids the
            // crash by skipping/altering surrogate handling would violate this observable result.
            if (!fuzzed.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: csv-safe input must be unchanged input="
                        + printable(fuzzed) + " lhs=" + printable(escaped) + " rhs=" + printable(fuzzed));
            }

            // Idempotence on csv-safe inputs follows from the same contract: once unchanged,
            // escaping again must still yield the same string.
            try {
                String escapedTwice = StringEscapeUtils.escapeCsv(escaped);
                if (!escaped.equals(escapedTwice)) {
                    throw new RuntimeException(
                        "[oracle:csv-idempotent] metamorphic violation: escapeCsv(escapeCsv(x)) == escapeCsv(x) for csv-safe x input="
                            + printable(fuzzed) + " lhs=" + printable(escapedTwice) + " rhs=" + printable(escaped));
                }
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && isValidByConstruction(fuzzed)) {
                throw e;
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:anchor-identity] metamorphic violation: known csv-safe surrogate pair must be unchanged input="
                        + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && isValidByConstruction(s)) {
                throw e;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        if (containsCsvSpecial(s)) {
            return false;
        }
        boolean sawSupplementary = false;
        for (int i = 0; i < s.length();) {
            int cp = Character.codePointAt(s, i);
            if (!Character.isValidCodePoint(cp)) {
                return false;
            }
            if (Character.isSupplementaryCodePoint(cp)) {
                sawSupplementary = true;
            }
            i += Character.charCount(cp);
        }
        return sawSupplementary;
    }

    private static boolean containsCsvSpecial(String s) {
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return true;
            }
        }
        return false;
    }

    private static String buildValidCsvSafeStringWithSupplementaryCodePoints(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int pairCount = data.consumeInt(1, 4);

        appendSafeAscii(sb, prefixLen, data);

        for (int i = 0; i < pairCount; i++) {
            int cp = chooseSupplementaryCodePoint(data);
            sb.append(Character.toChars(cp));
            if (i + 1 < pairCount) {
                appendSafeAscii(sb, data.consumeInt(0, 4), data);
            }
        }

        appendSafeAscii(sb, suffixLen, data);

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x10000));
        }
        return sb.toString();
    }

    private static int chooseSupplementaryCodePoint(FuzzedDataProvider data) {
        int selector = data.consumeInt(0, 4);
        switch (selector) {
            case 0:
                return 0x1F630; // exact failing-test emoji
            case 1:
                return 0x10000; // exact failing-test lower bound example
            case 2:
                return 0x1D11E; // exact failing-test musical symbol
            case 3:
                return 0x10FFFD; // exact failing-test upper-range example
            default:
                return data.consumeInt(0x10000, 0x10FFFD);
        }
    }

    private static void appendSafeAscii(StringBuilder sb, int len, FuzzedDataProvider data) {
        String src = data.consumeAsciiString(len);
        for (int i = 0; i < src.length(); i++) {
            char ch = src.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                sb.append('A');
            } else if (Character.isHighSurrogate(ch) || Character.isLowSurrogate(ch)) {
                sb.append('B');
            } else if (ch < 0x20) {
                sb.append('C');
            } else {
                sb.append(ch);
            }
        }
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || Character.isSurrogate(ch)) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
