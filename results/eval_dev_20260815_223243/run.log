public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            if (isOracleFailure(e) || isRootCause(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpochDay - i), data.consumeInt(-1000, 1000));
                }
                series.add(dayFromEpochDay(leftEpochDay), data.consumeInt(-1000, 1000));
                series.add(dayFromEpochDay(rightEpochDay), data.consumeInt(-1000, 1000));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(dayFromEpochDay(rightEpochDay + i), data.consumeInt(-1000, 1000));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e) || isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            try {
                checkSeriesViewConsistency(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            if (start.compareTo(end) > 0) {
                return;
            }

            int sourceManualCount = 0;
            try {
                for (int i = 0; i < series.getItemCount(); i++) {
                    RegularTimePeriod p = series.getTimePeriod(i);
                    if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                        sourceManualCount++;
                    }
                    if (series.getIndex(p) != i) {
                        throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex/getTimePeriod disagree"
                                + " index=" + i
                                + " roundTrip=" + series.getIndex(p)
                                + " period=" + p);
                    }
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            if (sourceManualCount != 0) {
                throw new RuntimeException("[oracle:gap-shape] metamorphic violation: constructed range inside gap must be empty"
                        + " manualCount=" + sourceManualCount
                        + " start=" + start
                        + " end=" + end);
            }

            int rawStartIndex;
            int rawEndIndex;
            try {
                rawStartIndex = series.getIndex(start);
                rawEndIndex = series.getIndex(end);
            } catch (RuntimeException e) {
                if (isRootCause(e) || isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            if (rawStartIndex >= 0 || rawEndIndex >= 0) {
                return;
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                /* Contract/invariant cross-check:
                   - getItemCount() reports the number of items in the series.
                   - getItems() and getTimePeriods() are views over the same backing data.
                   A throw-deleting or guard-skipping patch could return a non-empty/wrong copy while these views diverge. */
                checkSeriesViewConsistency(copy, "copy");

                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("[oracle:gap-empty] metamorphic violation: empty-gap createCopy must return empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
                }

                Day narrowedStart = start;
                Day narrowedEnd = end;
                if (startOffset < endOffset) {
                    int innerStart = data.consumeInt(startOffset, endOffset);
                    int innerEnd = data.consumeInt(innerStart, endOffset);
                    narrowedStart = dayFromEpochDay(leftEpochDay + innerStart);
                    narrowedEnd = dayFromEpochDay(leftEpochDay + innerEnd);
                }

                TimeSeries copy2 = series.createCopy(narrowedStart, narrowedEnd);
                checkSeriesViewConsistency(copy2, "copy2");

                if (copy2.getItemCount() != copy.getItemCount()
                        || copy2.getItems().size() != copy.getItems().size()
                        || copy2.getTimePeriods().size() != copy.getTimePeriods().size()) {
                    throw new RuntimeException("[oracle:subgap-agree] metamorphic violation: two empty subranges in same gap must agree"
                            + " outerCount=" + copy.getItemCount()
                            + " innerCount=" + copy2.getItemCount()
                            + " outerItems=" + copy.getItems().size()
                            + " innerItems=" + copy2.getItems().size()
                            + " outerPeriods=" + copy.getTimePeriods().size()
                            + " innerPeriods=" + copy2.getTimePeriods().size()
                            + " outer=[" + start + "," + end + "]"
                            + " inner=[" + narrowedStart + "," + narrowedEnd + "]");
                }

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);

                checkSeriesViewConsistency(byPeriod, "byPeriod");
                checkSeriesViewConsistency(byIndex, "byIndex");

                if (byPeriod.getItemCount() != byIndex.getItemCount()
                        || byPeriod.getItems().size() != byIndex.getItems().size()
                        || byPeriod.getTimePeriods().size() != byIndex.getTimePeriods().size()) {
                    throw new RuntimeException("[oracle:overload-count] metamorphic violation: createCopy overloads disagree"
                            + " chosen=" + chosen
                            + " byPeriodCount=" + byPeriod.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount());
                }

                if (byPeriod.getItemCount() == 1 && byIndex.getItemCount() == 1) {
                    if (!byPeriod.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
                        throw new RuntimeException("[oracle:overload-period] metamorphic violation: createCopy overloads copied different periods"
                                + " chosen=" + chosen
                                + " byPeriod=" + byPeriod.getTimePeriod(0)
                                + " byIndex=" + byIndex.getTimePeriod(0));
                    }
                    Number vp = byPeriod.getValue(0);
                    Number vi = byIndex.getValue(0);
                    if (vp == null ? vi != null : !vp.equals(vi)) {
                        throw new RuntimeException("[oracle:overload-value] metamorphic violation: createCopy overloads copied different values"
                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }

                if (gapSize >= 1) {
                    checkBoundaryStepRight(series, start, dayFromEpochDay(rightEpochDay));
                    checkBoundaryStepLeft(series, dayFromEpochDay(leftEpochDay), end);
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }
</xref>
<xref>
private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
        TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

        checkSeriesViewConsistency(byBoundary, "boundary-right-byBoundary");
        checkSeriesViewConsistency(byIndex, "boundary-right-byIndex");

        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight
                    + " rightIndex=" + rightIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
        Number vb = byBoundary.getValue(0);
        Number vi = byIndex.getValue(0);
        if (vb == null || !vb.equals(vi)) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton value mismatch"
                    + " byBoundaryValue=" + vb
                    + " byIndexValue=" + vi
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
