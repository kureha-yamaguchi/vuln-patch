    private static void checkEquivalentZeroScientificForms(String base) {
        String dotted = addDotBeforeExponent(base);
        if (dotted == null || dotted.length() == 0) {
            return;
        }

        /*
         * Equivalent-input guarantee:
         * inserting ".0" before the exponent in an all-zero scientific literal preserves the same
         * numeric quantity. For valid inputs, createNumber must therefore produce equivalent results
         * for base and its dotted form on both unsuffixed and explicitly-float paths.
         */
        try {
            Number lhs = NumberUtils.createNumber(base);
            Number rhs = NumberUtils.createNumber(dotted);
            if (lhs != null && rhs != null) {
                if (!(lhs instanceof Float) || !(rhs instanceof Float)
                        || Float.floatToIntBits(lhs.floatValue()) != Float.floatToIntBits(rhs.floatValue())) {
                    throw new RuntimeException("[oracle:zero-exp-dot-equivalence] metamorphic violation: equivalent unsuffixed scientific forms disagree input="
                            + base + " dotted=" + dotted + " lhs=" + describe(lhs) + " rhs=" + describe(rhs));
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        try {
            Number lhs = NumberUtils.createNumber(base + "F");
            Number rhs = NumberUtils.createNumber(dotted + "F");
            if (lhs != null && rhs != null) {
                if (!(lhs instanceof Float) || !(rhs instanceof Float)
                        || Float.floatToIntBits(lhs.floatValue()) != Float.floatToIntBits(rhs.floatValue())) {
                    throw new RuntimeException("[oracle:zero-exp-dot-f-equivalence] metamorphic violation: equivalent F-suffixed scientific forms disagree input="
                            + base + " dotted=" + dotted + " lhs=" + describe(lhs) + " rhs=" + describe(rhs));
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildZeroScientificNoDot(FuzzedDataProvider data) {
        int mantLen = data.consumeInt(1, 8);
        int expLen = data.consumeInt(1, 8);
        boolean negative = data.consumeBoolean();
        boolean upper = data.consumeBoolean();
        int expSignChoice = data.consumeInt(0, 2);

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        appendZeros(sb, mantLen);
        sb.append(upper ? 'E' : 'e');
        if (expSignChoice == 1) {
            sb.append('+');
        } else if (expSignChoice == 2) {
            sb.append('-');
        }
        appendZeros(sb, expLen);
        return sb.toString();
    }

    private static String buildNearbyBoundaryInput(FuzzedDataProvider data) {
        String base = buildZeroScientificNoDot(data);
        if (base == null) {
            return null;
        }
        switch (data.consumeInt(0, 5)) {
            case 0:
                return base + "F";
            case 1:
                return base + "D";
            case 2:
                return addDotBeforeExponent(base);
            case 3:
                return base + data.consumeAsciiString(2);
            case 4:
                return data.consumeAsciiString(2) + base;
            default:
                return base.substring(0, Math.max(1, base.length() - 1));
        }
    }

    private static String addDotBeforeExponent(String base) {
        int e = base.indexOf('e');
        if (e < 0) {
            e = base.indexOf('E');
        }
        if (e < 0) {
            return null;
        }
        return base.substring(0, e) + ".0" + base.substring(e);
    }

    private static void appendZeros(StringBuilder sb, int count) {
        for (int i = 0; i < count; i++) {
            sb.append('0');
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
