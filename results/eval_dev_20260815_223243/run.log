package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCase(null, new String[]{"a"}, new String[]{"b"}, null, "anchor-null-text");
        runAnchorCase("", new String[]{"a"}, new String[]{"b"}, "", "anchor-empty-text");
        runAnchorCase("aba", null, null, "aba", "anchor-null-arrays");
        runAnchorCase("aba", new String[0], null, "aba", "anchor-empty-search");
        runAnchorCase("aba", null, new String[0], "aba", "anchor-empty-repl");
        runAnchorCase("aba", new String[]{"a"}, null, "aba", "anchor-null-repl-array");
        runAnchorCase("aba", new String[]{"a"}, new String[]{""}, "b", "anchor-delete");
        runAnchorCase("aba", new String[]{null}, new String[]{"a"}, "aba", "anchor-null-search-elem");
        runAnchorCase("aba", new String[]{"a"}, new String[]{null}, "aba", "anchor-null-repl-elem");
        runAnchorCase("aba", new String[]{"a", "b"}, new String[]{"c", null}, "cbc", "anchor-mixed-null-repl");
        runAnchorCase("abcde", new String[]{"ab", "d"}, new String[]{"w", "t"}, "wcte", "anchor-basic");
        runAnchorCase("abcde", new String[]{"ab", "d"}, new String[]{"d", "t"}, "dcte", "anchor-basic-2");

        int pairs = data.consumeInt(1, 4);
        String[] searchList = new String[pairs];
        String[] replacementList = new String[pairs];

        char sep = '|';
        String alphabet = "abcxyz123";

        int special = data.consumeInt(0, pairs - 1);
        int specialKind = data.consumeInt(0, 2);

        for (int i = 0; i < pairs; i++) {
            if (i == special) {
                if (specialKind == 0) {
                    searchList[i] = null;
                    replacementList[i] = sanitize(data.consumeAsciiString(3), sep);
                } else if (specialKind == 1) {
                    searchList[i] = "";
                    replacementList[i] = sanitize(data.consumeAsciiString(3), sep);
                } else {
                    int idx = data.consumeInt(0, alphabet.length() - 1);
                    searchList[i] = String.valueOf(alphabet.charAt(idx));
                    replacementList[i] = null;
                }
            } else {
                int idx = data.consumeInt(0, alphabet.length() - 1);
                searchList[i] = String.valueOf(alphabet.charAt(idx));
                replacementList[i] = sanitize(data.consumeAsciiString(3), sep);
            }

            if (searchList[i] != null && StringUtils.length(searchList[i]) > 1) {
                searchList[i] = searchList[i].substring(0, 1);
            }
            if (replacementList[i] != null) {
                replacementList[i] = sanitize(replacementList[i], sep);
            }
        }

        String left = sanitize(data.consumeAsciiString(20), sep);
        String right = sanitize(data.consumeRemainingAsString(), sep);

        try {
            String joined = left + sep + right;
            String lhs = StringUtils.replaceEach(joined, searchList, replacementList);
            String leftReplaced = StringUtils.replaceEach(left, searchList, replacementList);
            String rightReplaced = StringUtils.replaceEach(right, searchList, replacementList);
            String rhs = leftReplaced + sep + rightReplaced;

            /*
             * Contract/metamorphic check:
             * replaceEach performs literal text substitutions independently at each match.
             * When every non-ignored search token is a single character and the separator is a
             * character not present in any search token, no match can cross the boundary between
             * left and right. Therefore:
             *   replaceEach(left + sep + right) == replaceEach(left) + sep + replaceEach(right)
             * A throw-deleting patch that silently skips valid replacements, or a band-aid that
             * mishandles null/empty boundary entries, can violate this equality without throwing.
             */
            if (!safeEquals(lhs, rhs)) {
                throw new RuntimeException("[oracle:split-compose] metamorphic violation: replaceEach(left+sep+right)==replaceEach(left)+sep+replaceEach(right) input="
                        + ArrayUtils.toString(new Object[]{left, right, searchList, replacementList})
                        + " lhs=" + lhs + " rhs=" + rhs);
            }

            String second = StringUtils.replaceEach(lhs, searchList, replacementList);
            if (!safeEquals(lhs, second)) {
                throw new RuntimeException("[oracle:idempotent-null-skip] metamorphic violation: repeated replaceEach should stabilize for constructed single-char mappings input="
                        + ArrayUtils.toString(new Object[]{joined, searchList, replacementList})
                        + " lhs=" + lhs + " rhs=" + second);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isReplaceEachNpe(t)) {
                throw new RuntimeException("[oracle:valid-null-entry] metamorphic violation: valid-by-construction replaceEach input threw from replaceEach with null/empty array element input="
                        + ArrayUtils.toString(new Object[]{left, right, searchList, replacementList}), t);
            }
            if (isOracle(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorCase(String text, String[] search, String[] repl, String expected, String tag) {
        try {
            String actual = StringUtils.replaceEach(text, search, repl);
            if (!safeEquals(expected, actual)) {
                throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: documented replaceEach example disagrees input="
                        + ArrayUtils.toString(new Object[]{text, search, repl}) + " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isReplaceEachNpe(t)) {
                throw new RuntimeException("[oracle:" + tag + "] metamorphic violation: documented valid replaceEach example threw NullPointerException input="
                        + ArrayUtils.toString(new Object[]{text, search, repl}), t);
            }
            if (isOracle(t)) {
                throw t;
            }
        }
    }

    private static boolean isReplaceEachNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "length".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Validation");
    }

    private static boolean isOracle(Throwable t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String sanitize(String s, char banned) {
        if (s == null || s.length() == 0) {
            return s == null ? "" : s;
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != banned) {
                out.append(c);
            }
        }
        return out.toString();
    }
}
