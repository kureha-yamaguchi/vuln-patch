public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            try {
                NumberUtils.createNumber(anchor[i]);
            } catch (IllegalArgumentException e) {
                // Clean rejection is correct for invalid inputs.
            } catch (RuntimeException e) {
                // The known buggy build crashes here; this harness's finding comes from
                // the metamorphic/post-condition checks below, so swallow duplicate crash signatures.
                if (!(e instanceof StringIndexOutOfBoundsException)) {
                    // Non-validation runtime failures on invalid inputs are outside this harness's oracle.
                }
            }
        }

        for (int i = 0; i < 8; i++) {
            String probe;
            switch (data.consumeInt(0, 7)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "-" + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "." + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(6);
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            try {
                NumberUtils.createNumber(probe);
            } catch (IllegalArgumentException e) {
                // Clean rejection is expected for many fuzzed strings.
            } catch (RuntimeException e) {
                // Do not report generic parser failures for possibly-invalid inputs.
            }
        }

        // Contract/oracle:
        // For a valid decimal integer string that is too large for long, createNumber(val + "L")
        // first tries createLong(numeric) and then must fall back to createBigInteger(numeric).
        // Both sides below use real library code; a throw-deleting or seed-only patch would not
        // satisfy this equality if suffix handling stayed wrong around the patched condition.
        StringBuilder bigDigits = new StringBuilder();
        bigDigits.append((char) ('1' + data.consumeInt(0, 8)));
        int extraDigits = data.consumeInt(19, 60);
        for (int i = 0; i < extraDigits; i++) {
            bigDigits.append((char) ('0' + data.consumeInt(0, 9)));
        }
        String big = bigDigits.toString();
        try {
            Number lhs = NumberUtils.createNumber(big + (data.consumeBoolean() ? "L" : "l"));
            BigInteger rhs = NumberUtils.createBigInteger(big);
            if (!(lhs instanceof BigInteger) || !rhs.equals(lhs)) {
                throw new RuntimeException("[oracle:overflow-bigint] metamorphic violation: createNumber(decimal+L) must equal createBigInteger(decimal) for valid decimal overflow input input=" + big + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            boolean inRegion = false;
            for (StackTraceElement ste : e.getStackTrace()) {
                String cn = ste.getClassName();
                String mn = ste.getMethodName();
                if ("org.apache.commons.lang.NumberUtils".equals(cn)
                        && ("createNumber".equals(mn)
                        || "createLong".equals(mn)
                        || "createBigInteger".equals(mn)
                        || "isAllZeros".equals(mn))) {
                    inRegion = true;
                    break;
                }
            }
            if (e instanceof StringIndexOutOfBoundsException && inRegion) {
                throw e;
            }
            return;
        }

        // Boundary flip around the patched condition: singleton suffix is invalid, but adding one
        // valid digit creates a valid long-literal string. For canonical one-digit decimal inputs,
        // createNumber(d + 'L') must recover the digit value, matching createLong(d).
        int digit = data.consumeInt(0, 9);
        String canonical = String.valueOf(digit);
        String suffixed = canonical + (data.consumeBoolean() ? "L" : "l");
        try {
            Number lhs = NumberUtils.createNumber(suffixed);
            Long rhs = NumberUtils.createLong(canonical);
            if (lhs == null || lhs.longValue() != rhs.longValue()) {
                throw new RuntimeException("[oracle:boundary-digit-long] metamorphic violation: valid one-digit long suffix parse disagrees with createLong input=" + suffixed + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            boolean inRegion = false;
            for (StackTraceElement ste : e.getStackTrace()) {
                String cn = ste.getClassName();
                String mn = ste.getMethodName();
                if ("org.apache.commons.lang.NumberUtils".equals(cn)
                        && ("createNumber".equals(mn)
                        || "createLong".equals(mn)
                        || "createBigInteger".equals(mn)
                        || "isAllZeros".equals(mn))) {
                    inRegion = true;
                    break;
                }
            }
            if (e instanceof StringIndexOutOfBoundsException && inRegion) {
                throw e;
            }
        }
