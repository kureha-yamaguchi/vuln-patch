package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        {
            TimeSeries s = new TimeSeries("S", "domain", "range", Day.class);
            try {
                s.add(new Day(19, 8, 2005), 1);
                s.add(new Day(31, 1, 2006), 1);
            } catch (RuntimeException e) {
                return;
            }

            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);
            try {
                TimeSeries copy = s.createCopy(start, end);

                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("[oracle:anchor-empty-gap-count] metamorphic violation: anchored empty-gap copy must be empty"
                            + " count=" + copy.getItemCount());
                }

                /* Contract asserted: createCopy() returns a copy of the series. The empty-range branch uses clone(),
                   so metadata carried by the source series must be preserved even when the data list is emptied.
                   A throw-deleting or special-case patch that returns an ad hoc empty series would violate this. */
                String srcDomain = s.getDomainDescription();
                String srcRange = s.getRangeDescription();
                String copyDomain = copy.getDomainDescription();
                String copyRange = copy.getRangeDescription();
                if ((srcDomain == null ? copyDomain != null : !srcDomain.equals(copyDomain))
                        || (srcRange == null ? copyRange != null : !srcRange.equals(copyRange))) {
                    throw new RuntimeException("[oracle:copy-descriptions] metamorphic violation: createCopy must preserve domain/range descriptions"
                            + " srcDomain=" + srcDomain
                            + " copyDomain=" + copyDomain
                            + " srcRange=" + srcRange
                            + " copyRange=" + copyRange);
                }

                if (copy.getTimePeriodClass() != s.getTimePeriodClass()) {
                    throw new RuntimeException("[oracle:copy-class-preserve-2] metamorphic violation: createCopy must preserve time period class"
                            + " srcClass=" + s.getTimePeriodClass()
                            + " copyClass=" + copy.getTimePeriodClass());
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                boolean root = false;
                boolean reached = false;
                if (e instanceof IllegalArgumentException) {
                    root = true;
                    StackTraceElement[] st = e.getStackTrace();
                    for (int i = 0; i < st.length; i++) {
                        String cn = st[i].getClassName();
                        String mn = st[i].getMethodName();
                        if (("org.jfree.data.time.TimeSeries".equals(cn) && "createCopy".equals(mn))
                                || ("org.jfree.data.time.TimeSeries".equals(cn) && "getIndex".equals(mn))
                                || ("java.lang.Object".equals(cn) && "clone".equals(mn))
                                || ("org.jfree.data.time.TimeSeries".equals(cn) && "clone".equals(mn))) {
                            reached = true;
                            break;
                        }
                    }
                }
                if (root && reached) {
                    throw new RuntimeException("[oracle:anchor-valid-unexpected-reject] metamorphic violation: valid anchored empty-gap range must not be rejected");
                }
                if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                    throw e;
                }
                return;
            }
        }

        int rounds = data.consumeInt(1, 8);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "D-" + data.consumeAsciiString(4),
                    "R-" + data.consumeAsciiString(4),
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 6);
            int afterCount = data.consumeInt(0, 6);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(new Day(new java.util.Date((long) (leftEpochDay - i) * 86400000L)), data.consumeInt(-1000, 1000));
                }
                series.add(new Day(new java.util.Date((long) leftEpochDay * 86400000L)), data.consumeInt(-1000, 1000));
                series.add(new Day(new java.util.Date((long) rightEpochDay * 86400000L)), data.consumeInt(-1000, 1000));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(new Day(new java.util.Date((long) (rightEpochDay + i) * 86400000L)), data.consumeInt(-1000, 1000));
                }
