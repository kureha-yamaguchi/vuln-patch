package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int leftSerial = data.consumeInt(730000, 732000);
            int gapSize = data.consumeInt(2, 40);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int rightSerial = leftSerial + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    addValue(series, dayFromSerial(leftSerial - i), data.consumeInt(-1000, 1000));
                }
                addValue(series, dayFromSerial(leftSerial), data.consumeInt(-1000, 1000));
                addValue(series, dayFromSerial(rightSerial), data.consumeInt(-1000, 1000));
                for (int i = 1; i <= afterCount; i++) {
                    addValue(series, dayFromSerial(rightSerial + i), data.consumeInt(-1000, 1000));
                }
            } catch (RuntimeException e) {
                return;
            }

            try {
                checkItemViewAgreement(series, "source");
            } catch (RuntimeException e) {
                throw e;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromSerial(leftSerial + startOffset);
            Day end = dayFromSerial(leftSerial + endOffset);

            int expectedInsertion = manualInsertionPoint(series, start);
            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            if (startIndex >= 0 || endIndex >= 0) {
                return;
            }

            if (startIndex != expectedInsertion || endIndex != expectedInsertion) {
                throw new RuntimeException("[oracle:same-gap-index] metamorphic violation: getIndex disagrees with manual insertion point"
                        + " expected=" + expectedInsertion
                        + " startIndex=" + startIndex
                        + " endIndex=" + endIndex
                        + " start=" + start
                        + " end=" + end
                        + " itemCount=" + series.getItemCount());
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                checkItemViewAgreement(copy, "copy-gap");

                for (int i = 0; i < copy.getItemCount(); i++) {
                    RegularTimePeriod p = copy.getTimePeriod(i);
                    if (p.compareTo(start) < 0 || p.compareTo(end) > 0) {
                        throw new RuntimeException("[oracle:copy-membership] metamorphic violation: copied period lies outside requested range"
                                + " period=" + p
                                + " start=" + start
                                + " end=" + end
                                + " copyCount=" + copy.getItemCount());
                    }
                    if (series.getIndex(p) < 0) {
                        throw new RuntimeException("[oracle:copy-membership] metamorphic violation: copied period not present in source"
                                + " period=" + p
                                + " start=" + start
                                + " end=" + end
                                + " sourceCount=" + series.getItemCount());
                    }
                }

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries singleton = series.createCopy(exact, exact);
                checkItemViewAgreement(singleton, "copy-singleton");
                if (singleton.getItemCount() == 1) {
                    RegularTimePeriod copied = singleton.getTimePeriod(0);
                    if (!exact.equals(copied)) {
                        throw new RuntimeException("[oracle:singleton-identity] metamorphic violation: singleton copy changed the selected period"
                                + " chosen=" + chosen
                                + " expected=" + exact
                                + " actual=" + copied);
                    }
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() {
        try {
            TimeSeries s = anchorSeries();
            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);

            int expectedInsertion = manualInsertionPoint(s, start);
            int startIndex = s.getIndex(start);
            int endIndex = s.getIndex(end);
            if (startIndex != expectedInsertion || endIndex != expectedInsertion) {
                throw new RuntimeException("[oracle:same-gap-index] metamorphic violation: anchor getIndex disagrees with manual insertion point"
                        + " expected=" + expectedInsertion
                        + " startIndex=" + startIndex
                        + " endIndex=" + endIndex
                        + " start=" + start
                        + " end=" + end);
            }

            TimeSeries copy = s.createCopy(start, end);
            checkItemViewAgreement(copy, "anchor-copy");

            for (int i = 0; i < copy.getItemCount(); i++) {
                RegularTimePeriod p = copy.getTimePeriod(i);
                if (p.compareTo(start) < 0 || p.compareTo(end) > 0) {
                    throw new RuntimeException("[oracle:copy-membership] metamorphic violation: anchor copy contains out-of-range period"
                            + " period=" + p + " start=" + start + " end=" + end);
                }
                if (s.getIndex(p) < 0) {
                    throw new RuntimeException("[oracle:copy-membership] metamorphic violation: anchor copy contains period absent from source"
                            + " period=" + p);
                }
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            // ignore
        }
    }

    private static TimeSeries anchorSeries() {
        TimeSeries s = new TimeSeries("S");
        addValue(s, new Day(19, 8, 2005), 1);
        addValue(s, new Day(31, 1, 2006), 1);
        return s;
    }

    private static void addValue(TimeSeries series, Day day, int value) {
        series.add(day, new Integer(value));
    }

    private static Day dayFromSerial(int serial) {
        return new Day(org.jfree.date.SerialDate.createInstance(serial));
    }

    private static int manualInsertionPoint(TimeSeries series, RegularTimePeriod target) {
        int less = 0;
