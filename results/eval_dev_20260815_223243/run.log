package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test / ground truth.
        Boolean anchor = invokeToBoolean("off");
        if (anchor != null && anchor.booleanValue()) {
            throw new RuntimeException("[oracle:anchor-off] metamorphic violation: toBoolean(\"off\") must be false input=off lhs=true rhs=false");
        }

        // EXPLORE: drive many real strings through BooleanUtils.toBoolean.
        // The bug is in String handling; any non-null String is valid input and should never crash.
        String[] probes = new String[8];
        probes[0] = data.consumeAsciiString(8);
        probes[1] = buildLength3Or4Probe(data);
        probes[2] = buildLength3Or4Probe(data);
        probes[3] = buildWrappedProbe(data);
        probes[4] = pickObservedLiteral(data);
        probes[5] = data.consumeString(8);
        probes[6] = data.remainingBytes() > 0 ? data.consumeRemainingAsString() : "";
        probes[7] = buildCaseMixedTrueToken(data);

        for (int i = 0; i < probes.length; i++) {
            invokeToBoolean(probes[i]);
        }

        // Post-condition / oracle 1:
        // The visible code and failing test show that recognized true literals are accepted
        // case-insensitively: "true", "on", and "yes" in mixed case must evaluate to true.
        // A patch that merely suppresses the crash by returning false would violate this.
        String trueToken = buildCaseMixedTrueToken(data);
        Boolean trueResult = invokeToBoolean(trueToken);
        if (trueResult != null && !trueResult.booleanValue()) {
            throw new RuntimeException(
                "[oracle:true-token] metamorphic violation: case-insensitive true token must parse as true input="
                    + printable(trueToken) + " lhs=false rhs=true");
        }

        // Post-condition / oracle 2:
        // The test explicitly requires interned "true" and a non-interned "true" built via
        // StringBuffer(...).toString() to have the same observable result.
        // A patch that changes the optimized fast path semantics breaks this relation.
        Boolean lhs = invokeToBoolean("true");
        Boolean rhs = invokeToBoolean(new StringBuffer("tr").append("ue").toString());
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:interned-vs-dynamic] metamorphic violation: interned and dynamically-built \"true\" must agree input=true lhs="
                    + lhs + " rhs=" + rhs);
        }
        if (lhs != null && !lhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:interned-true] metamorphic violation: canonical \"true\" must parse as true input=true lhs=false rhs=true");
        }
        if (rhs != null && !rhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:dynamic-true] metamorphic violation: dynamically-built \"true\" must parse as true input=true lhs=false rhs=true");
        }
    }

    private static Boolean invokeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildLength3Or4Probe(FuzzedDataProvider data) {
        int len = data.consumeBoolean() ? 3 : 4;
        char first;
        switch (data.consumeInt(0, 6)) {
            case 0: first = 'o'; break;
            case 1: first = 'y'; break;
            case 2: first = 'Y'; break;
            case 3: first = 't'; break;
            case 4: first = 'T'; break;
            case 5: first = 'f'; break;
            default:
                String one = data.consumeAsciiString(1);
                first = one.length() == 0 ? 'a' : one.charAt(0);
                break;
        }
        StringBuilder sb = new StringBuilder();
        sb.append(first);
        while (sb.length() < len) {
            String ch = data.consumeAsciiString(1);
            sb.append(ch.length() == 0 ? 'x' : ch.charAt(0));
        }
        return sb.toString();
    }

    private static String buildWrappedProbe(FuzzedDataProvider data) {
        String core = buildLength3Or4Probe(data);
        String prefix = data.consumeAsciiString(2);
        String suffix = data.consumeAsciiString(2);
        return prefix + core + suffix;
    }

    private static String pickObservedLiteral(FuzzedDataProvider data) {
        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        return literals[data.consumeInt(0, literals.length - 1)];
    }

    private static String buildCaseMixedTrueToken(FuzzedDataProvider data) {
        String[] tokens = new String[] { "true", "on", "yes" };
        String base = tokens[data.consumeInt(0, tokens.length - 1)];
        StringBuilder sb = new StringBuilder(base.length());
        for (int i = 0; i < base.length(); i++) {
            char c = base.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(c) : Character.toLowerCase(c));
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : s;
    }
