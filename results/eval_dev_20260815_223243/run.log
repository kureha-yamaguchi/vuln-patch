package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.Region;
import org.apache.commons.math3.geometry.partitioning.RegionFactory;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseAnchor();
        } catch (Throwable t) {
            if (isGroundTruthRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:anchor-valid] valid PolyhedronsSet construction unexpectedly reached "
                        + "PolygonsSet.computeGeometricalProperties and threw "
                        + t.getClass().getName(),
                    t);
            }
            if (!isCleanRejection(t)) {
                // Ignore unrelated failures outside the patched region.
            }
        }

        final double px = boundedDouble(data.consumeInt(), 1000.0);
        final double py = boundedDouble(data.consumeInt(), 1000.0);
        final Vector2D probe = new Vector2D(px, py);

        checkEmptyBoundaryGeometry(new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE)), probe, "leaf-false");
        checkEmptyBoundaryGeometry(new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE)), probe, "leaf-true");

        try {
            RegionFactory<Euclidean2D> factory = new RegionFactory<Euclidean2D>();
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            PolygonsSet full = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));

            PolygonsSet complementOfEmpty = (PolygonsSet) factory.getComplement(empty);
            PolygonsSet complementOfFull = (PolygonsSet) factory.getComplement(full);

            checkEmptyBoundaryGeometry(complementOfEmpty, probe, "complement-empty");
            checkEmptyBoundaryGeometry(complementOfFull, probe, "complement-full");

            // Contract/invariant used here:
            // For a polygon set with no boundary (getVertices().length == 0), membership of any probe point
            // determines whether the region is the whole space or the empty region. The shown implementation
            // of computeGeometricalProperties reflects exactly that: whole space => infinite size and NaN
            // barycenter, empty space => zero size and barycenter (0,0). This catches a patch that merely
            // deletes/suppresses the cast by routing the whole-space case into the empty-space branch.
            compareComplementPair(empty, complementOfEmpty, probe, "empty-vs-complement");
            compareComplementPair(full, complementOfFull, probe, "full-vs-complement");
        } catch (Throwable t) {
            if (isGroundTruthRootCause(t)) {
                throw new RuntimeException("[oracle:complement-valid] valid complement operation hit root cause", t);
            }
            if (!isCleanRejection(t)) {
                // Skip unrelated failures.
            }
        }
    }

    private static void exerciseAnchor() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        ArrayList<SubHyperplane<Euclidean3D>> subHyperplaneList = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;

            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            Plane polyPlane = new Plane(v1, v2, v3);

            Vector2D p1 = polyPlane.toSubSpace(v1);
            Vector2D p2 = polyPlane.toSubSpace(v2);
            Vector2D p3 = polyPlane.toSubSpace(v3);

            ArrayList<SubHyperplane<Euclidean2D>> lines = new ArrayList<SubHyperplane<Euclidean2D>>();
            lines.add(new SubLine(p1, p2));
            lines.add(new SubLine(p2, p3));
            lines.add(new SubLine(p3, p1));

            PolygonsSet facet = new PolygonsSet(lines);
            subHyperplaneList.add(new SubPlane(polyPlane, facet));
        }

        PolyhedronsSet polyhedronsSet = new PolyhedronsSet(subHyperplaneList);
        polyhedronsSet.getSize();
        polyhedronsSet.getBarycenter();
    }

    private static void checkEmptyBoundaryGeometry(PolygonsSet set, Vector2D probe, String tag) {
        try {
            Vector2D[][] verticesA = set.getVertices();
            Vector2D[][] verticesB = set.getVertices();

            if (verticesA == verticesB) {
                throw new RuntimeException("[oracle:" + tag + "-clone] metamorphic violation: getVertices returned the same top-level array instance twice");
            }
            if (verticesA.length != verticesB.length) {
                throw new RuntimeException("[oracle:" + tag + "-stable] metamorphic violation: repeated getVertices changed length "
                    + verticesA.length + " -> " + verticesB.length);
            }

            if (verticesA.length != 0) {
                return;
            }

            Region.Location location = set.checkPoint(probe);
            double size = set.getSize();
            Vector2D barycenter = (Vector2D) set.getBarycenter();

            if (location == Region.Location.INSIDE) {
                if (!Double.isInfinite(size) || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-inside-empty-boundary] metamorphic violation: "
                            + "boundary-free region containing probe must represent whole space; "
                            + "probe=" + probe + " size=" + size + " bary=("
                            + barycenter.getX() + "," + barycenter.getY() + ")");
                }
            } else if (location == Region.Location.OUTSIDE) {
                if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(barycenter.getX()) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(barycenter.getY()) != Double.doubleToLongBits(0.0)) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-outside-empty-boundary] metamorphic violation: "
                            + "boundary-free region excluding probe must represent empty space; "
                            + "probe=" + probe + " size=" + size + " bary=("
                            + barycenter.getX() + "," + barycenter.getY() + ")");
                }
            }
        } catch (Throwable t) {
            if (isGroundTruthRootCause(t)) {
                throw new RuntimeException("[oracle:" + tag + "-root] valid empty-boundary region hit root cause", t);
            }
            if (!isCleanRejection(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
        }
    }

    private static void compareComplementPair(PolygonsSet a, PolygonsSet b, Vector2D probe, String tag) {
        try {
            if (a.getVertices().length != 0 || b.getVertices().length != 0) {
                return;
            }

            Region.Location la = a.checkPoint(probe);
            Region.Location lb = b.checkPoint(probe);

            if (la == Region.Location.BOUNDARY || lb == Region.Location.BOUNDARY) {
                return;
            }

            if (la == lb) {
                throw new RuntimeException(
                    "[oracle:" + tag + "-classify] metamorphic violation: complements disagreed on complementarity at probe="
                        + probe + " lhs=" + la + " rhs=" + lb);
            }

            double sa = a.getSize();
            double sb = b.getSize();
            Vector2D ba = (Vector2D) a.getBarycenter();
            Vector2D bb = (Vector2D) b.getBarycenter();

            boolean aWhole = la == Region.Location.INSIDE;
            boolean bWhole = lb == Region.Location.INSIDE;

            if (aWhole == bWhole) {
                throw new RuntimeException(
                    "[oracle:" + tag + "-state] metamorphic violation: complements produced the same whole/empty interpretation");
            }

            if (aWhole) {
                if (!Double.isInfinite(sa) || !Double.isNaN(ba.getX()) || !Double.isNaN(ba.getY())) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-lhs] metamorphic violation: complement classified lhs as whole space "
                            + "but geometry was size=" + sa + " bary=(" + ba.getX() + "," + ba.getY() + ")");
                }
                if (Double.doubleToLongBits(sb) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(bb.getX()) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(bb.getY()) != Double.doubleToLongBits(0.0)) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-rhs] metamorphic violation: complement classified rhs as empty space "
                            + "but geometry was size=" + sb + " bary=(" + bb.getX() + "," + bb.getY() + ")");
                }
            } else {
                if (Double.doubleToLongBits(sa) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(ba.getX()) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(ba.getY()) != Double.doubleToLongBits(0.0)) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-lhs] metamorphic violation: complement classified lhs as empty space "
                            + "but geometry was size=" + sa + " bary=(" + ba.getX() + "," + ba.getY() + ")");
                }
                if (!Double.isInfinite(sb) || !Double.isNaN(bb.getX()) || !Double.isNaN(bb.getY())) {
                    throw new RuntimeException(
                        "[oracle:" + tag + "-rhs] metamorphic violation: complement classified rhs as whole space "
                            + "but geometry was size=" + sb + " bary=(" + bb.getX() + "," + bb.getY() + ")");
                }
            }
        } catch (Throwable t) {
            if (isGroundTruthRootCause(t)) {
                throw new RuntimeException("[oracle:" + tag + "-root] valid complement pair hit root cause", t);
            }
            if (!isCleanRejection(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
        }
    }

    private static boolean isGroundTruthRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.startsWith("org.apache.commons.math3.exception.")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static double boundedDouble(int raw, double maxAbs) {
        return ((double) (raw % 2000001)) * (maxAbs / 1000000.0);
    }
}
