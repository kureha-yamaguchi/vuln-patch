package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1eE");
        } catch (IllegalArgumentException ignored) {
        }

        String malformed = buildMalformedBothExponentMarkers(data);
        try {
            NumberUtils.createNumber(malformed);
        } catch (IllegalArgumentException ignored) {
        }

        String validDecimal = buildValidDecimal(data);
        checkDoubleSuffixCaseEquivalence(validDecimal);
        checkLongSuffixCaseEquivalence(buildValidLongLiteral(data));
    }

    private static String buildMalformedBothExponentMarkers(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(1, 8);
        int middleLen = data.consumeInt(0, 4);
        int suffixLen = data.consumeInt(0, prefixLen - 1);

        StringBuilder sb = new StringBuilder(prefixLen + middleLen + suffixLen + 2);
        appendDigits(sb, prefixLen, data);
        sb.append(data.consumeBoolean() ? 'e' : 'E');
        appendDigits(sb, middleLen, data);
        sb.append(sb.charAt(prefixLen) == 'e' ? 'E' : 'e');
        appendDigits(sb, suffixLen, data);
        return sb.toString();
    }

    private static void appendDigits(StringBuilder sb, int count, FuzzedDataProvider data) {
        for (int i = 0; i < count; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        int width = data.consumeInt(1, 6);
        String fracStr = Integer.toString(frac);
        while (fracStr.length() < width) {
            fracStr = "0" + fracStr;
        }
        return Integer.toString(whole) + "." + fracStr;
    }

    private static String buildValidLongLiteral(FuzzedDataProvider data) {
        long extra = ((long) data.consumeInt(0, 1_000_000)) * 1_000L + data.consumeInt(0, 999);
        long value = ((long) Integer.MAX_VALUE) + 1L + extra;
        if (data.consumeBoolean()) {
            value = -value;
        }
        return Long.toString(value);
    }

    private static void checkDoubleSuffixCaseEquivalence(String base) {
        /*
         * createNumber handles 'd' and 'D' in the same switch branch, so changing only suffix case
         * must preserve the parsed numeric value for any valid decimal literal.
         */
        Number lower;
        Number upper;
        try {
            lower = NumberUtils.createNumber(base + "d");
            upper = NumberUtils.createNumber(base + "D");
        } catch (RuntimeException ignored) {
            return;
        }
        if (lower != null && upper != null && !sameNumericValue(lower, upper)) {
            throw new RuntimeException("[oracle:d-suffix-case] metamorphic violation: d/D suffix changed numeric value input="
                    + base + "d lhs=" + lower + " rhs=" + upper);
        }
    }

    private static void checkLongSuffixCaseEquivalence(String base) {
        /*
         * createNumber handles 'l' and 'L' in the same switch branch, so both explicit long suffixes
         * must parse to the same numeric value and same concrete type for a valid long literal.
         */
        Number lower;
        Number upper;
        try {
            lower = NumberUtils.createNumber(base + "l");
            upper = NumberUtils.createNumber(base + "L");
        } catch (RuntimeException ignored) {
            return;
        }
        if (lower != null && upper != null) {
            if (!sameNumericValue(lower, upper) || !lower.getClass().equals(upper.getClass())) {
                throw new RuntimeException("[oracle:l-suffix-case] metamorphic violation: l/L suffix disagreement input="
                        + base + "l lhs=" + lower + " rhs=" + upper);
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal lhs = toBigDecimal(a);
        BigDecimal rhs = toBigDecimal(b);
        return lhs != null && rhs != null && lhs.compareTo(rhs) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Double) {
            double d = n.doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
        }
        if (n instanceof Float) {
            float f = n.floatValue();
            if (Float.isNaN(f) || Float.isInfinite(f)) {
                return null;
            }
        }
        try {
            return new BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }
}
