    private static void checkDecimalAgreesWithCreateFloat(String s) {
        Float viaFloat;
        try {
            viaFloat = NumberUtils.createFloat(s);
        } catch (RuntimeException t) {
            return;
        }

        Number viaNumber;
        try {
            viaNumber = NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        /*
         * Contract from NumberUtils.createNumber shown above: for canonical decimal literals with
         * dec != null, no exponent, no suffix, moderate magnitude, and non-zero value, createNumber
         * first calls createFloat(str) and returns that Float unless it is infinite or an imprecise zero.
         * Our generator constructs moderate non-zero decimals, so both real library calls must agree.
