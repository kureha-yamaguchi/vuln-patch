    private static void checkExponentZeroAgreement(String s) {
        if (s == null || s.length() == 0) {
            return;
        }
        if (!hasDigit(s)) {
            return;
        }

        Number plain;
        Number expZero;
        try {
            plain = NumberUtils.createNumber(s);
            expZero = NumberUtils.createNumber(s + "e0");
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }
        if (plain == null || expZero == null) {
            return;
        }

        /* Contract: appending exponent zero preserves the numeric value of a valid numeric literal.
           A patch that merely suppresses the crash or mis-handles exponent parsing can violate this
           equivalence even when no exception is thrown. */
        BigDecimal lhs;
        BigDecimal rhs;
        try {
            lhs = new BigDecimal(plain.toString());
            rhs = new BigDecimal(expZero.toString());
        } catch (RuntimeException t) {
            return;
        }
        if (lhs.compareTo(rhs) != 0) {
            throw new RuntimeException("[oracle:exp-zero-equivalence] metamorphic violation: input=" + s
                    + " plain=" + plain + " exp0=" + expZero);
        }
    }

    private static boolean isRootCause(Throwable t) {
