package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String guaranteedNeedle = data.consumeAsciiString(4);
        if (guaranteedNeedle.length() == 0) {
            guaranteedNeedle = "a";
        }

        String prefix = data.consumeString(8);
        String suffix = data.consumeString(8);
        String text = prefix + guaranteedNeedle + suffix;

        int pairCount = data.consumeInt(2, 5);
        String[] searchList = new String[pairCount];
        String[] replacementList = new String[pairCount];

        int matchingIndex = data.consumeInt(0, pairCount - 1);
        int nullReplacementIndex = data.consumeInt(0, pairCount - 1);

        for (int i = 0; i < pairCount; i++) {
            String s = data.consumeAsciiString(4);
            if (s.length() == 0) {
                s = "z";
            }
            searchList[i] = s;
            replacementList[i] = data.consumeString(6);
        }

        searchList[matchingIndex] = guaranteedNeedle;
        replacementList[matchingIndex] = data.consumeString(6);

        if (replacementList[matchingIndex] == null) {
            replacementList[matchingIndex] = "";
        }

        String nullSearch = data.consumeAsciiString(4);
        if (nullSearch.length() == 0) {
            nullSearch = "q";
        }
        searchList[nullReplacementIndex] = nullSearch;
        replacementList[nullReplacementIndex] = null;

        try {
            String result = StringUtils.replaceEach(text, searchList, replacementList);

            // Contract used for this oracle:
            // Entries with searchList[i] == null, searchList[i].length() == 0, or replacementList[i] == null
            // are skipped by the implementation's matching loop and therefore have no semantic effect.
            // So calling replaceEach with those pairs present must agree with calling it after filtering them out.
            String[] filteredSearch = filterSearch(searchList, replacementList);
            String[] filteredReplacement = filterReplacement(searchList, replacementList);
            String filteredResult;
            try {
                filteredResult = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
            } catch (RuntimeException ex) {
                if (isCleanRejection(ex)) {
                    return;
                }
                return;
            }

            if (!eq(result, filteredResult)) {
                throw new RuntimeException(
                    "[oracle:filtered-null-pairs] metamorphic violation: replaceEach should ignore null/invalid pairs" +
                    " text=" + String.valueOf(text) +
                    " lhs=" + String.valueOf(result) +
                    " rhs=" + String.valueOf(filteredResult)
                );
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorCases() {
        checkEquals(null, callReplace(null, new String[] { "a" }, new String[] { "b" }), "anchor-null-text");
        checkEquals("aba", callReplace("aba", null, null), "anchor-null-arrays");
        checkEquals("aba", callReplace("aba", new String[0], null), "anchor-empty-search");
        checkEquals("aba", callReplace("aba", null, new String[0]), "anchor-empty-repl");
        checkEquals("aba", callReplace("aba", new String[] { "a" }, null), "anchor-null-replacement-array");
        checkEquals("aba", callReplace("aba", new String[] { null }, new String[] { "a" }), "anchor-null-search-element");
        checkEquals("aba", callReplace("aba", new String[] { "a" }, new String[] { null }), "anchor-null-replacement-element");
        checkEquals("cbc", callReplace("aba", new String[] { "a", "b" }, new String[] { "c", null }), "anchor-ground-truth");
    }

    private static String callReplace(String text, String[] search, String[] replacement) {
        try {
            return StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static void checkEquals(String expected, String actual, String id) {
        if (!eq(expected, actual)) {
            throw new RuntimeException(
                "[oracle:" + id + "] metamorphic violation: expected=" +
                String.valueOf(expected) + " actual=" + String.valueOf(actual)
            );
        }
    }

    private static boolean eq(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String[] filterSearch(String[] searchList, String[] replacementList) {
        ArrayList<String> out = new ArrayList<String>();
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) {
                continue;
            }
            out.add(searchList[i]);
        }
        return out.toArray(new String[out.size()]);
    }

    private static String[] filterReplacement(String[] searchList, String[] replacementList) {
        ArrayList<String> out = new ArrayList<String>();
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) {
                continue;
            }
            out.add(replacementList[i]);
        }
        return out.toArray(new String[out.size()]);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
