package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1eE");

        checkLongSuffixAgreement(data);
        checkBigIntegerFallbackAgreement(data);
        checkBoundaryVariants(data);
    }

    private static void checkBoundaryVariants(FuzzedDataProvider data) {
        String digits = nonEmptyDigits(data.consumeInt(1, 999999));
        String infix = data.consumeAsciiString(3);

        String s1 = digits + "e" + infix + "E";
        String s2 = digits + "E" + infix + "e";
        String s3 = digits + "eE";
        String s4 = digits + "Ee";

        tryCreateNumber(s1);
        tryCreateNumber(s2);
        tryCreateNumber(s3);
        tryCreateNumber(s4);
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException ignored) {
        }
    }

    private static void checkLongSuffixAgreement(FuzzedDataProvider data) {
        String base = Integer.toString(data.consumeInt(-1_000_000, 1_000_000));
        try {
            Number plain = NumberUtils.createNumber(base);
            Number suffixed = NumberUtils.createNumber(base + "L");
            if (plain == null || suffixed == null) {
                return;
            }
            if (plain.longValue() != suffixed.longValue()) {
                throw new RuntimeException("[oracle:long-suffix] metamorphic violation: input=" + base
                        + " plain=" + plain + " suffixed=" + suffixed);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkBigIntegerFallbackAgreement(FuzzedDataProvider data) {
        String base = buildOversizedInteger(data);
        try {
            Number plain = NumberUtils.createNumber(base);
            Number suffixed = NumberUtils.createNumber(base + "L");
            BigInteger direct = NumberUtils.createBigInteger(base);
            if (plain == null || suffixed == null || direct == null) {
                return;
            }

            BigInteger plainValue = new BigInteger(plain.toString());
            BigInteger suffixedValue = new BigInteger(suffixed.toString());
            if (!direct.equals(plainValue) || !direct.equals(suffixedValue)) {
                throw new RuntimeException("[oracle:bigint-fallback] metamorphic violation: input=" + base
                        + " direct=" + direct + " plain=" + plain + " suffixed=" + suffixed);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleViolation(RuntimeException t) {
        String message = t.getMessage();
        return message != null && message.startsWith("[oracle:");
    }

    private static String buildOversizedInteger(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int len = data.consumeInt(20, 40);
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String nonEmptyDigits(int n) {
        String s = Integer.toString(Math.abs(n));
        return s.length() == 0 ? "1" : s;
    }
}
