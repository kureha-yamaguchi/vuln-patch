package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int left = data.consumeInt(-2000, 2000);
        int gapWidth = data.consumeInt(1, 60);
        int right = left + gapWidth + 1;

        TimeSeries series = new TimeSeries(nonEmptyName(data), Day.class);

        int beforeCount = data.consumeInt(0, 6);
        int afterCount = data.consumeInt(0, 6);

        try {
            for (int i = beforeCount; i >= 1; i--) {
                series.add(dayFromOffset(left - (i * 3)), Integer.valueOf(-i));
                checkSeriesConsistency(series, "src-before-" + i);
            }

            series.add(dayFromOffset(left), Integer.valueOf(1));
            checkSeriesConsistency(series, "src-left");

            series.add(dayFromOffset(right), Integer.valueOf(2));
            checkSeriesConsistency(series, "src-right");

            for (int i = 1; i <= afterCount; i++) {
                series.add(dayFromOffset(right + (i * 3)), Integer.valueOf(i + 2));
                checkSeriesConsistency(series, "src-after-" + i);
            }
        } catch (RuntimeException e) {
            return;
        }

        Day start = dayFromOffset(left + 1);
        Day end = dayFromOffset(right - 1);
        runScenario(series, start, end, "fuzz-gap");
    }

    /*
     * Contract asserted:
     * createCopy(start, end) with ordered, non-null bounds should return a series
     * containing the items in that period range. When no items fall in the range,
     * the correct result is an empty copy, not a rejection. A patch that merely
     * deletes the throw but returns the wrong object is caught by the post-call
     * consistency checks on item count, time-period count, and getIndex round-trips.
     */
    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        checkSeriesConsistency(s, "anchor-src-1");
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        checkSeriesConsistency(s, "anchor-src-2");

        runScenario(s, new Day(1, 12, 2005), new Day(18, 1, 2006), "anchor");
    }

    private static void runScenario(TimeSeries source, RegularTimePeriod start,
                                    RegularTimePeriod end, String label) {
        int sourceCountBefore = source.getItemCount();
        checkSeriesConsistency(source, label + "-src-pre");

        try {
            TimeSeries copy = source.createCopy(start, end);

            if (source.getItemCount() != sourceCountBefore) {
                throw new RuntimeException("[oracle:src-stable-after-copy] source mutated by createCopy label="
                        + label + " before=" + sourceCountBefore + " after=" + source.getItemCount());
            }
            checkSeriesConsistency(source, label + "-src-post");

            if (copy == null) {
                throw new RuntimeException("[oracle:copy-nonnull] createCopy returned null label=" + label);
            }

            checkSeriesConsistency(copy, label + "-copy");

            if (copy.getItemCount() != 0) {
                throw new RuntimeException("[oracle:empty-gap-range] expected empty copy for gap-only range label="
                        + label + " count=" + copy.getItemCount());
            }
            if (copy.getItems().size() != 0) {
                throw new RuntimeException("[oracle:empty-gap-items] expected empty items for gap-only range label="
                        + label + " size=" + copy.getItems().size());
            }
            if (copy.getTimePeriods().size() != 0) {
                throw new RuntimeException("[oracle:empty-gap-periods] expected empty time-period list for gap-only range label="
                        + label + " size=" + copy.getTimePeriods().size());
            }

            int startIndex = copy.getIndex(start);
            int endIndex = copy.getIndex(end);
            if (startIndex != -1 || endIndex != -1) {
                throw new RuntimeException("[oracle:empty-gap-index] empty copy reported present/inconsistent insertion point label="
                        + label + " startIndex=" + startIndex + " endIndex=" + endIndex);
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:valid-gap-rejected] ordered, non-null empty-range createCopy rejected label="
                        + label + " srcCount=" + sourceCountBefore
                        + " start=" + start + " end=" + end, e);
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }
    }

    /*
     * Consistency cross-check:
     * - getItemCount() must match getItems().size() and getTimePeriods().size().
     * - For every existing period p at index i, getIndex(p) must return i.
     * These are independent recomputations from the object's own exposed output.
     */
    private static void checkSeriesConsistency(TimeSeries series, String where) {
        int count = series.getItemCount();
        int itemSize = series.getItems().size();
        int periodSize = series.getTimePeriods().size();

        if (count != itemSize) {
            throw new RuntimeException("[oracle:itemcount-items] consistency violation where="
                    + where + " count=" + count + " items=" + itemSize);
        }
        if (count != periodSize) {
            throw new RuntimeException("[oracle:itemcount-periods] consistency violation where="
                    + where + " count=" + count + " periods=" + periodSize);
        }

        for (int i = 0; i < count; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            int indexed = series.getIndex(p);
            if (indexed != i) {
                throw new RuntimeException("[oracle:getindex-roundtrip] consistency violation where="
                        + where + " expectedIndex=" + i + " actualIndex=" + indexed + " period=" + p);
            }

            TimeSeriesDataItem item = series.getDataItem(i);
            if (item == null || item.getPeriod() == null) {
                throw new RuntimeException("[oracle:dataitem-period] null data item/period where="
                        + where + " index=" + i);
            }
            if (item.getPeriod().compareTo(p) != 0) {
                throw new RuntimeException("[oracle:period-agree] inconsistent period views where="
                        + where + " index=" + i + " itemPeriod=" + item.getPeriod() + " timePeriod=" + p);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
