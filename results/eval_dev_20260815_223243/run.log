private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd) throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
            throw new RuntimeException("[oracle:left-boundary-present] metamorphic violation: left boundary period must exist"
                    + " left=" + exactLeft
                    + " leftIndex=" + leftIndex);
        }

        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(exactLeft, absentEnd);
            byIndex = series.createCopy(leftIndex, leftIndex);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: extending an exact left boundary into an empty gap should preserve the left singleton", e);
            }
            throw e;
        }

        /* Contract used here: absentEnd is inside the gap immediately after exactLeft, so [exactLeft, absentEnd]
           contains exactly the left boundary item and must match the equivalent index-based singleton copy. */
        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd
                    + " leftIndex=" + leftIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd);
        }
        if (byBoundary.getValue(0) == null || !byBoundary.getValue(0).equals(byIndex.getValue(0))) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton value mismatch"
                    + " byBoundaryValue=" + byBoundary.getValue(0)
                    + " byIndexValue=" + byIndex.getValue(0)
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd);
        }
    }
