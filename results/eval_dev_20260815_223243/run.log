package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzzed = buildValidCsvSafeStringWithSupplementary(data);
        if (fuzzed == null) {
            return;
        }

        try {
            String escaped = StringEscapeUtils.escapeCsv(fuzzed);

            // Contract/oracle: escapeCsv only needs to quote/escape CSV metacharacters.
            // We construct fuzzed strings by construction to contain no comma, quote, CR, or LF,
            // so a correct implementation must return the original string unchanged.
            // A throw-deleting or branch-skipping patch could avoid the crash yet silently drop or
            // mis-handle supplementary code points; this checks the observable result.
            if (!fuzzed.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: csv-safe input must be unchanged input=" + printable(fuzzed) + " lhs=" + printable(escaped) + " rhs=" + printable(fuzzed));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isCsvSafe(fuzzed)) {
                throw t;
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(escaped)) {
                throw new RuntimeException("[oracle:anchor-identity] metamorphic violation: escapeCsv must preserve surrogate-pair-only csv-safe input input=" + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildValidCsvSafeStringWithSupplementary(FuzzedDataProvider data) {
        int pairs = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder();

        String prefix = filterCsvUnsafeAndBrokenSurrogates(data.consumeString(16));
        String suffix = filterCsvUnsafeAndBrokenSurrogates(data.consumeRemainingAsString());
        sb.append(prefix);

        for (int i = 0; i < pairs; i++) {
            if (data.consumeBoolean()) {
                String mid = filterCsvUnsafeAndBrokenSurrogates(data.consumeString(8));
                sb.append(mid);
            }
            sb.append(randomSupplementaryPair(data));
        }

        sb.append(suffix);

        String result = sb.toString();
        if (result.length() == 0 || !containsSupplementaryPair(result) || !isCsvSafe(result)) {
            return null;
        }
        return result;
    }

    private static String randomSupplementaryPair(FuzzedDataProvider data) {
        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        return new String(Character.toChars(codePoint));
    }

    private static String filterCsvUnsafeAndBrokenSurrogates(String in) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < in.length();) {
            int cp = in.codePointAt(i);
            if (cp != ',' && cp != '"' && cp != '\r' && cp != '\n' && cp < 0x10000 && !Character.isSurrogate((char) cp)) {
                out.append((char) cp);
            }
            i += Character.charCount(cp);
        }
        return out.toString();
    }

    private static boolean containsSupplementaryPair(String s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i)) && i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCsvSafe(String s) {
        return s.indexOf(',') < 0 && s.indexOf('"') < 0 && s.indexOf('\r') < 0 && s.indexOf('\n') < 0;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length();) {
            int cp = s.codePointAt(i);
            if (cp >= 32 && cp <= 126 && cp != '\\' && cp != '"') {
                sb.appendCodePoint(cp);
            } else if (cp <= 0xFFFF) {
                String hex = Integer.toHexString(cp).toUpperCase();
                while (hex.length() < 4) {
                    hex = "0" + hex;
                }
                sb.append("\\u").append(hex);
            } else {
                char[] chars = Character.toChars(cp);
                for (char c : chars) {
                    String hex = Integer.toHexString(c).toUpperCase();
                    while (hex.length() < 4) {
                        hex = "0" + hex;
                    }
                    sb.append("\\u").append(hex);
                }
            }
            i += Character.charCount(cp);
        }
        sb.append('"');
        return sb.toString();
    }
}
