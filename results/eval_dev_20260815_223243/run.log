            boolean rhs = BooleanUtils.toBoolean("on");
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:on-case] metamorphic violation: case-insensitive on parsing input=" + quote(onVariant) + " lhs=" + lhs + " rhs=" + rhs);
