        char c2 = seed.length() > 2 ? seed.charAt(2) : 'u';
        candidates[3] = new String(new char[] { c0, c1, c2 });

        int b0 = data.consumeInt(0, 127);
        int b1 = data.consumeInt(0, 127);
        int b2 = data.consumeInt(0, 127);
        char p0 = (char) b0;
        if (p0 == 'y' || p0 == 'Y') {
            p0 = 'o';
        }
        candidates[4] = new String(new char[] { p0, (char) b1, (char) b2 });

        String base3 = ascii + "xyz";
        char q0 = base3.charAt(0);
        if (q0 == 'y' || q0 == 'Y') {
