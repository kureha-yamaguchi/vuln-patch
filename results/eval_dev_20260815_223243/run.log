    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildValidUtf16WithSupplementary(FuzzedDataProvider data, boolean allowCsvSpecials) {
        StringBuilder sb = new StringBuilder();
        int segments = data.consumeInt(1, 5);
        for (int i = 0; i < segments; i++) {
            String ascii = data.consumeAsciiString(8);
            sb.append(allowCsvSpecials ? ascii : stripCsvSpecials(ascii));

            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            sb.appendCodePoint(codePoint);

            if (allowCsvSpecials && data.consumeBoolean()) {
                switch (data.consumeInt(0, 3)) {
                    case 0:
                        sb.append(',');
                        break;
                    case 1:
                        sb.append('"');
                        break;
                    case 2:
                        sb.append('\n');
                        break;
                    default:
                        sb.append('\r');
                        break;
                }
            }
        }
        String tail = data.consumeAsciiString(8);
        sb.append(allowCsvSpecials ? tail : stripCsvSpecials(tail));
        return sb.toString();
    }

    private static String stripCsvSpecials(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\n' && c != '\r') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('a');
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }
