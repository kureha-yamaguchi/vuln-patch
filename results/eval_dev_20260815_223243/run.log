                    addValue(series, dayFromEpochDay(rightEpochDay + i), data.consumeInt(-1000, 1000));
                }
            } catch (RuntimeException e) {
                return;
            }

            try {
                checkIndexRoundTrip(series, "source");
            } catch (RuntimeException e) {
                throw e;
            }

            Day exactLeft = dayFromEpochDay(leftEpochDay);
            Day exactRight = dayFromEpochDay(rightEpochDay);

            // Documented/visible invariant: getIndex(period) uses binarySearch over the same
            // ordered data that getTimePeriod(i) exposes, so for an existing period the index
            // must round-trip exactly.
            if (series.getIndex(exactLeft) < 0 || series.getIndex(exactRight) < 0) {
                throw new RuntimeException("[oracle:index-present] metamorphic violation: existing boundary period not found"
                        + " leftIndex=" + series.getIndex(exactLeft)
                        + " rightIndex=" + series.getIndex(exactRight)
                        + " itemCount=" + series.getItemCount());
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            int sourceManualCount = countItemsInRange(series, start, end);
            if (sourceManualCount != 0) {
                throw new RuntimeException("[oracle:gap-shape] metamorphic violation: constructed gap is not empty"
                        + " sourceManualCount=" + sourceManualCount
                        + " start=" + start + " end=" + end);
            }

            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            // This is the flipped boundary from the patch:
            // start lies in a gap so insertion point is j => getIndex(start) == -(j+1)
            // end lies later in the same gap so adjusted endIndex becomes j-1.
            // A correct implementation must treat this as an empty range.
            if (startIndex >= 0 || endIndex >= 0) {
                return;
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                // Post-condition: a valid empty range copy must be empty. A patch that merely
                // suppresses the throw but returns the wrong slice breaks this.
                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("[oracle:boundary-empty] metamorphic violation: gap copy should be empty"
                            + " copyCount=" + copy.getItemCount()
                            + " start=" + start + " end=" + end
                            + " rawStartIndex=" + startIndex
                            + " rawEndIndex=" + endIndex);
                }

                // Independent cross-check outside count/getItems families:
                // getTimePeriods() is another view of the same backing data and must agree.
                if (copy.getTimePeriods().size() != 0) {
                    throw new RuntimeException("[oracle:periods-view-empty] metamorphic violation: empty copy has non-empty time-period view"
                            + " periodsSize=" + copy.getTimePeriods().size()
                            + " start=" + start + " end=" + end
                            + " rawStartIndex=" + startIndex
                            + " rawEndIndex=" + endIndex);
                }

                checkIndexRoundTrip(copy, "copy-empty");

                // Metamorphic relation: deleting the interior gap from the requested range changes
                // nothing, because there are no source items in either request interval.
                Day narrowedStart = start;
                Day narrowedEnd = end;
                if (startOffset < endOffset) {
                    int innerStartOffset = data.consumeInt(startOffset, endOffset);
                    int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
                    narrowedStart = dayFromEpochDay(leftEpochDay + innerStartOffset);
                    narrowedEnd = dayFromEpochDay(leftEpochDay + innerEndOffset);
                }

                TimeSeries copy2 = series.createCopy(narrowedStart, narrowedEnd);
                if (copy2.getItemCount() != copy.getItemCount()
                        || copy2.getTimePeriods().size() != copy.getTimePeriods().size()) {
                    throw new RuntimeException("[oracle:gap-subrange-agree] metamorphic violation: two empty subranges in same gap disagree"
                            + " outerCount=" + copy.getItemCount()
                            + " innerCount=" + copy2.getItemCount()
                            + " outerPeriods=" + copy.getTimePeriods().size()
                            + " innerPeriods=" + copy2.getTimePeriods().size()
                            + " outer=[" + start + "," + end + "]"
                            + " inner=[" + narrowedStart + "," + narrowedEnd + "]");
                }

                // Sibling-overload agreement on a non-empty valid case, different observable than
                // the empty-gap trigger and it exercises getIndex/createCopy together.
                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                if (byPeriod.getItemCount() != 1 || byIndex.getItemCount() != 1) {
                    throw new RuntimeException("[oracle:singleton-copy] metamorphic violation: singleton copy must contain exactly one item"
                            + " chosen=" + chosen
                            + " byPeriodCount=" + byPeriod.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount());
                }
                if (!byPeriod.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
                    throw new RuntimeException("[oracle:singleton-period] metamorphic violation: createCopy overloads disagree on copied period"
                            + " chosen=" + chosen
                            + " byPeriod=" + byPeriod.getTimePeriod(0)
                            + " byIndex=" + byIndex.getTimePeriod(0));
                }
                checkIndexRoundTrip(byPeriod, "byPeriod");
                checkIndexRoundTrip(byIndex, "byIndex");
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                throw e;
            }
        }
    }
