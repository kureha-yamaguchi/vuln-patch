package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String match = data.consumeAsciiString(6);
        if (match == null || match.length() == 0) {
            match = "a";
        }

        String prefix = data.consumeString(12);
        String suffix = data.consumeRemainingAsString();
        if (prefix == null) {
            prefix = "";
        }
        if (suffix == null) {
            suffix = "";
        }
        String text = prefix + match + suffix;

        int len = data.consumeInt(2, 5);
        String[] searchList = new String[len];
        String[] replacementList = new String[len];

        searchList[0] = match;
        replacementList[0] = data.consumeString(8);
        if (replacementList[0] == null) {
            replacementList[0] = "";
        }

        int inertIndex = data.consumeInt(1, len - 1);
        for (int i = 1; i < len; i++) {
            if (i == inertIndex) {
                int kind = data.consumeInt(0, 2);
                if (kind == 0) {
                    searchList[i] = null;
                    replacementList[i] = data.consumeString(8);
                    if (replacementList[i] == null) {
                        replacementList[i] = "";
                    }
                } else if (kind == 1) {
                    searchList[i] = "";
                    replacementList[i] = data.consumeString(8);
                    if (replacementList[i] == null) {
                        replacementList[i] = "";
                    }
                } else {
                    searchList[i] = data.consumeAsciiString(6);
                    if (searchList[i] == null || searchList[i].length() == 0) {
                        searchList[i] = "z";
                    }
                    replacementList[i] = null;
                }
            } else {
                searchList[i] = data.consumeAsciiString(6);
                replacementList[i] = data.consumeString(8);
                if (data.consumeBoolean()) {
                    searchList[i] = null;
                } else if (data.consumeBoolean()) {
                    searchList[i] = "";
                } else if (searchList[i] == null || searchList[i].length() == 0) {
                    searchList[i] = "q";
                }
                if (data.consumeBoolean()) {
                    replacementList[i] = null;
                } else if (replacementList[i] == null) {
                    replacementList[i] = "";
                }
            }
        }

        try {
            String withInert = StringUtils.replaceEach(text, searchList, replacementList);

            String[] filteredSearch = filterSearch(searchList, replacementList);
            String[] filteredReplacement = filterReplacement(searchList, replacementList);
            String filtered = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);

            /*
             * Contract used for this oracle:
             * The public tests for StringUtils.replaceEach document that entries with
             * null search strings, empty search strings, or null replacement strings are ignored:
             *   replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba"
             *   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
             * Therefore, adding or removing such inert pairs must not change the observable result.
             * A patch that merely avoids the throw by skipping work incorrectly would violate this relation.
             */
            if (!safeEquals(withInert, filtered)) {
                throw new RuntimeException(
                    "[oracle:inert-pairs] metamorphic violation: replaceEach result changed after removing inert pairs"
                        + " input=" + text
                        + " lhs=" + withInert
                        + " rhs=" + filtered
                        + " search=" + ArrayUtils.toString(searchList)
                        + " repl=" + ArrayUtils.toString(replacementList));
            }

            String idempotentFiltered = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
            if (!safeEquals(filtered, idempotentFiltered)) {
                throw new RuntimeException(
                    "[oracle:stable-filter] metamorphic violation: filtered recomputation disagrees"
                        + " input=" + text
                        + " lhs=" + filtered
                        + " rhs=" + idempotentFiltered);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runAnchorCases() {
        checkEquals(null, StringUtils.replaceEach(null, new String[] {"a"}, new String[] {"b"}));
        checkEquals("aba", StringUtils.replaceEach("aba", null, null));
        checkEquals("aba", StringUtils.replaceEach("aba", new String[0], null));
        checkEquals("aba", StringUtils.replaceEach("aba", null, new String[0]));
        checkEquals("aba", StringUtils.replaceEach("aba", new String[] {"a"}, null));
        checkEquals("aba", StringUtils.replaceEach("aba", new String[] {null}, new String[] {"a"}));

        try {
            checkEquals("aba", StringUtils.replaceEach("aba", new String[] {"a"}, new String[] {null}));
        } catch (Throwable t) {
