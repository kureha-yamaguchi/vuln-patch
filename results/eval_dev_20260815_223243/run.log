    private static void exerciseExactAnchor() {
        PolyhedronsSet p = buildClosedMesh(1.0, 0.0, 0.0, 0.0, 0.999999, 1.0, 1.0);
        p.getSize();
        p.getBarycenter();
    }

    private static PolyhedronsSet buildClosedMesh(
            double scale, double tx, double ty, double tz,
            double v5x, double v5y, double v5z) {

        Vector3D[] vertices = new Vector3D[8];
        vertices[0] = point( 1.0, -1.0, -1.0, scale, tx, ty, tz);
        vertices[1] = point( 1.0, -1.0,  1.0, scale, tx, ty, tz);
        vertices[2] = point(-1.0, -1.0,  1.0, scale, tx, ty, tz);
        vertices[3] = point(-1.0, -1.0, -1.0, scale, tx, ty, tz);
        vertices[4] = point( 1.0,  1.0, -1.0, scale, tx, ty, tz);
        vertices[5] = point(v5x,  v5y,  v5z, scale, tx, ty, tz);
        vertices[6] = point(-1.0,  1.0,  1.0, scale, tx, ty, tz);
        vertices[7] = point(-1.0,  1.0, -1.0, scale, tx, ty, tz);

        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int i = 0; i < INDICES.length; i += 3) {
            Vector3D a = vertices[INDICES[i]];
            Vector3D b = vertices[INDICES[i + 1]];
            Vector3D c = vertices[INDICES[i + 2]];

            Plane plane = new Plane(a, b, c);

            Vector2D pa = plane.toSubSpace(a);
            Vector2D pb = plane.toSubSpace(b);
            Vector2D pc = plane.toSubSpace(c);

            Collection<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>();
            edges.add(new SubLine(pa, pb));
            edges.add(new SubLine(pb, pc));
            edges.add(new SubLine(pc, pa));

            PolygonsSet region = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, region));
        }

        return new PolyhedronsSet(facets);
    }

    private static Vector3D point(double x, double y, double z, double scale, double tx, double ty, double tz) {
        return new Vector3D(x * scale + tx, y * scale + ty, z * scale + tz);
    }

    private static boolean shouldPropagateRootCause(Throwable t, boolean validByConstruction) {
        if (!validByConstruction || !(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)) {
