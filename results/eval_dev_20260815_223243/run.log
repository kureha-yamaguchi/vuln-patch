package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.time.LocalDate;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorExactTrigger();

        int rounds = data.consumeInt(1, 4);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain-" + data.consumeAsciiString(4),
                    "range-" + data.consumeAsciiString(4),
                    Day.class);

            int maximumItemCount = data.consumeInt(2, 20);
            series.setMaximumItemCount(maximumItemCount);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int leftExtras = data.consumeInt(0, 4);
            int rightExtras = data.consumeInt(0, 4);
            int gapSize = data.consumeInt(1, 40);

            int leftEpoch = baseEpochDay + leftExtras;
            int rightEpoch = leftEpoch + gapSize + 1;

            try {
                for (int i = leftExtras; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpoch - i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(dayFromEpochDay(leftEpoch), Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(dayFromEpochDay(rightEpoch), Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= rightExtras; i++) {
                    series.add(dayFromEpochDay(rightEpoch + i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpoch + startOffset);
            Day end = dayFromEpochDay(leftEpoch + endOffset);

            checkRangeCopyAgainstManual(series, start, end, "manual-range-count-gap");

            try {
                if (series.getItemCount() > 0 && data.consumeBoolean()) {
                    int earliestEpoch = leftEpoch - leftExtras - data.consumeInt(1, 3);
                    series.add(dayFromEpochDay(earliestEpoch), Integer.valueOf(data.consumeInt(-1000, 1000)));
                    checkRangeCopyAgainstManual(series, start, end, "manual-range-count-after-add-left");
                }
                if (series.getItemCount() > 0 && data.consumeBoolean()) {
                    int latestEpoch = rightEpoch + rightExtras + data.consumeInt(1, 3);
                    series.add(dayFromEpochDay(latestEpoch), Integer.valueOf(data.consumeInt(-1000, 1000)));
                    checkRangeCopyAgainstManual(series, start, end, "manual-range-count-after-add-right");
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            Day exactLeft = dayFromEpochDay(leftEpoch);
            Day exactRight = dayFromEpochDay(rightEpoch);
            checkRangeCopyAgainstManual(series, exactLeft, exactRight, "manual-range-count-boundaries");

            int chosenIndex = data.consumeInt(0, series.getItemCount() - 1);
            RegularTimePeriod chosenPeriod = series.getTimePeriod(chosenIndex);
            checkRangeCopyAgainstManual(series, chosenPeriod, chosenPeriod, "manual-range-count-singleton");
        }
    }

    private static void anchorExactTrigger() {
        TimeSeries s = new TimeSeries("S");
        s.setMaximumItemCount(7);
        try {
            s.add(new Day(19, 8, 2005), Integer.valueOf(1));
            s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        } catch (RuntimeException e) {
            return;
        }
        checkRangeCopyAgainstManual(
                s,
                new Day(1, 12, 2005),
                new Day(18, 1, 2006),
                "anchor-manual-range-count");
    }

    private static void checkRangeCopyAgainstManual(
            TimeSeries series,
            RegularTimePeriod start,
            RegularTimePeriod end,
            String oracleId) {
        if (start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int manualCount = 0;
        int firstManualIndex = -1;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                if (firstManualIndex < 0) {
                    firstManualIndex = i;
                }
                manualCount++;
            }
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: valid inclusive range should copy exactly the manually counted subset"
                                + " manualCount=" + manualCount
                                + " start=" + start
                                + " end=" + end
                                + " sourceCount=" + series.getItemCount(),
                        e);
            }
            return;
        }

        if (copy.getItemCount() != manualCount) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: createCopy itemCount disagrees with manual count"
                            + " manualCount=" + manualCount
                            + " copyCount=" + copy.getItemCount()
                            + " start=" + start
                            + " end=" + end);
        }

        if (copy.getItems().size() != copy.getItemCount() || copy.getTimePeriods().size() != copy.getItemCount()) {
            throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: copy views disagree"
                            + " itemCount=" + copy.getItemCount()
                            + " itemsSize=" + copy.getItems().size()
                            + " periodsSize=" + copy.getTimePeriods().size()
                            + " start=" + start
                            + " end=" + end);
        }

        if (manualCount == 0) {
            if (copy.getMaximumItemCount() != series.getMaximumItemCount()) {
                throw new RuntimeException(
                        "[oracle:empty-copy-maxcount] metamorphic violation: empty-range createCopy uses cloning and must preserve maximum item count metadata"
                                + " sourceMaxCount=" + series.getMaximumItemCount()
                                + " copyMaxCount=" + copy.getMaximumItemCount()
                                + " start=" + start
                                + " end=" + end);
            }
            return;
        }

        for (int j = 0; j < manualCount; j++) {
            int sourceIndex = firstManualIndex + j;
            RegularTimePeriod sourcePeriod = series.getTimePeriod(sourceIndex);
            RegularTimePeriod copyPeriod = copy.getTimePeriod(j);
            if (!sourcePeriod.equals(copyPeriod)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: copied periods disagree with source subsequence"
                                + " sourceIndex=" + sourceIndex
                                + " copyIndex=" + j
                                + " sourcePeriod=" + sourcePeriod
                                + " copyPeriod=" + copyPeriod
                                + " start=" + start
                                + " end=" + end);
            }
            Number sourceValue = series.getValue(sourceIndex);
            Number copyValue = copy.getValue(j);
            if (sourceValue == null ? copyValue != null : !sourceValue.equals(copyValue)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: copied values disagree with source subsequence"
                                + " sourceIndex=" + sourceIndex
                                + " copyIndex=" + j
                                + " sourceValue=" + sourceValue
                                + " copyValue=" + copyValue
                                + " start=" + start
                                + " end=" + end);
            }
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        LocalDate d = LocalDate.ofEpochDay(epochDay);
        return new Day(d.getDayOfMonth(), d.getMonthValue(), d.getYear());
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
