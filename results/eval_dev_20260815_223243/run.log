                    if (!byPeriod.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
                        throw new RuntimeException("[oracle:overload-period] metamorphic violation: createCopy overloads copied different periods"
                                + " chosen=" + chosen
                                + " byPeriod=" + byPeriod.getTimePeriod(0)
                                + " byIndex=" + byIndex.getTimePeriod(0));
                    }
                    Number vp = byPeriod.getValue(0);
                    Number vi = byIndex.getValue(0);
                    if (vp == null ? vi != null : !vp.equals(vi)) {
                        throw new RuntimeException("[oracle:overload-value] metamorphic violation: createCopy overloads copied different values"
                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }

                if (gapSize >= 1) {
                    checkBoundaryStepRight(series, start, dayFromEpochDay(rightEpochDay));
                    checkBoundaryStepLeft(series, dayFromEpochDay(leftEpochDay), end);
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        checkSeriesViewConsistency(s, "anchor-source");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        if (start.compareTo(end) > 0) {
            throw new RuntimeException("[oracle:anchor-precondition] metamorphic violation: anchor input must satisfy start<=end");
        }

        int manualCount = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
        }
        if (manualCount != 0) {
            throw new RuntimeException("[oracle:anchor-gap] metamorphic violation: anchor range must be empty"
                    + " manualCount=" + manualCount);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0 || copy.getItems().size() != 0 || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchored empty-gap copy must be empty"
                    + " itemCount=" + copy.getItemCount()
                    + " itemsSize=" + copy.getItems().size()
                    + " periodsSize=" + copy.getTimePeriods().size());
        }
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
