            // has the same insertion point: it would be inserted before the same right neighbor.
            if (startInsertion != endInsertion) {
                throw new RuntimeException("[oracle:gap-insertion-constant] metamorphic violation: absent periods in one gap have different insertion points startIndex="
                        + startIndex + " endIndex=" + endIndex + " startInsertion=" + startInsertion
                        + " endInsertion=" + endInsertion + " start=" + start + " end=" + end);
            }
            if (startIndex >= 0 || endIndex >= 0) {
                throw new RuntimeException("[oracle:gap-index-absent] metamorphic violation: gap endpoints unexpectedly resolved to present items startIndex="
                        + startIndex + " endIndex=" + endIndex + " start=" + start + " end=" + end);
            }

