package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryValid("1234.5");

        String seed = data.consumeBoolean() ? buildIntegerLiteral(data) : buildDecimalLiteral(data);

        tryValid(seed);

        if (seed.indexOf('e') == -1 && seed.indexOf('E') == -1) {
            tryValid(seed + "e0");
            tryValid(seed + "E0");
        }

        if (isPlainNumeric(seed)) {
            /*
             * Contract visible in createNumber: unsuffixed numeric text and the same text with an exponent of zero
             * denote the same numeric quantity. A throw-deleting or overfit patch can stop crashing yet still
             * corrupt mantissa/exponent bookkeeping, so the two parses must agree numerically.
             */
            checkEquivalentNumeric(seed, seed + "e0", "exp-zero-equivalence");
            checkEquivalentNumeric(seed, seed + "E0", "exp-zero-case-equivalence");

            /*
             * Contract visible in the switch on the last character: suffix letters are handled case-insensitively.
             * Therefore xD == xd, xF == xf, and xL == xl whenever those forms are applicable.
             */
            if (seed.indexOf('.') >= 0) {
                checkEquivalentNumeric(seed + "D", seed + "d", "double-suffix-case");
                checkEquivalentNumeric(seed + "F", seed + "f", "float-suffix-case");
            } else {
                checkEquivalentNumeric(seed + "L", seed + "l", "long-suffix-case");
            }
        }

        String boundary = buildBoundaryExponentLiteral(data);
        tryValid(boundary);

        if (isPlainNumeric(boundary)) {
            checkEquivalentNumeric(boundary, boundary + "e0", "boundary-exp-zero-equivalence");
            checkEquivalentNumeric(boundary, boundary + "E0", "boundary-exp-zero-case-equivalence");
        }
    }

    private static String buildIntegerLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(1, 6);
        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        for (int i = 0; i < len; i++) {
            int digit;
            if (i == 0 && len > 1) {
                digit = data.consumeInt(1, 9);
            } else {
                digit = data.consumeInt(0, 9);
            }
            sb.append((char) ('0' + digit));
        }
        return sb.toString();
    }

    private static String buildDecimalLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int wholeLen = data.consumeInt(1, 6);
        int fracLen = data.consumeInt(1, 6);
        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        for (int i = 0; i < wholeLen; i++) {
            int digit = (i == 0 && wholeLen > 1) ? data.consumeInt(1, 9) : data.consumeInt(0, 9);
            sb.append((char) ('0' + digit));
        }
        sb.append('.');
        for (int i = 0; i < fracLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String buildBoundaryExponentLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        boolean useDecimal = data.consumeBoolean();
        boolean expUpper = data.consumeBoolean();

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }

        int wholeLen = data.consumeInt(1, 5);
        for (int i = 0; i < wholeLen; i++) {
            int digit = (i == 0 && wholeLen > 1) ? data.consumeInt(1, 9) : data.consumeInt(0, 9);
            sb.append((char) ('0' + digit));
        }

        if (useDecimal) {
            sb.append('.');
            int fracLen = data.consumeInt(1, 4);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }

        sb.append(expUpper ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '+' : '-');
        }
        int expLen = data.consumeInt(1, 3);
        for (int i = 0; i < expLen; i++) {
            int digit = (i == 0 && expLen > 1) ? data.consumeInt(0, 9) : data.consumeInt(0, 9);
            sb.append((char) ('0' + digit));
        }

        return sb.toString();
    }

    private static void tryValid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentNumeric(String a, String b, String oracleId) {
        Number left;
        Number right;
        try {
            left = NumberUtils.createNumber(a);
            right = NumberUtils.createNumber(b);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (left == null || right == null) {
            return;
        }

        try {
            java.math.BigDecimal lhs = new java.math.BigDecimal(left.toString());
            java.math.BigDecimal rhs = new java.math.BigDecimal(right.toString());
            if (lhs.compareTo(rhs) != 0) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: inputA=" + a
                        + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (NumberFormatException ignored) {
            return;
        }
    }

    private static boolean isPlainNumeric(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        if (s.indexOf('e') >= 0 || s.indexOf('E') >= 0) {
            return false;
        }
        char last = s.charAt(s.length() - 1);
        if (last == 'd' || last == 'D' || last == 'f' || last == 'F' || last == 'l' || last == 'L') {
            return false;
        }
        if (s.startsWith("0x") || s.startsWith("-0x")) {
            return false;
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            } else if ("java.lang.String".equals(cls)) {
                if ("substring".equals(m) || "charAt".equals(m)) {
                    return true;
                }
            } else if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(m)) {
                return true;
            }
        }
        return false;
    }
}
