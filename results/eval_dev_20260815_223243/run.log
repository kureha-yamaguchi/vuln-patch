package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true, true);
        }

        String fuzzed = buildCsvSafeStringWithSupplementary(data);
        exerciseEscapeCsv(fuzzed, true, true);

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(8));
        String combined = prefix + fuzzed + suffix;
        exerciseEscapeCsv(combined, true, true);

        String fuzzed2 = buildCsvSafeStringWithSupplementary(data);
        exerciseEscapeCsv(fuzzed2, true, true);
    }

    private static void exerciseEscapeCsv(String s, boolean validByConstruction, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);

            // Documented guarantee of escapeCsv: if the input contains no comma, double quote,
            // CR, or LF, it is returned unchanged. We build such inputs by construction, so
            // a throw-deleting or branch-skipping patch that silently changes output is caught.
            if (assertIdentity && !s.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static String buildCsvSafeStringWithSupplementary(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixParts = data.consumeInt(0, 3);
        for (int i = 0; i < prefixParts; i++) {
            appendSafeAsciiOrSupplementary(sb, data, false);
        }

        appendSafeAsciiOrSupplementary(sb, data, true);

        int suffixParts = data.consumeInt(0, 4);
        for (int i = 0; i < suffixParts; i++) {
            appendSafeAsciiOrSupplementary(sb, data, data.consumeBoolean());
        }

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x1F630));
        }
        return sb.toString();
    }

    private static void appendSafeAsciiOrSupplementary(StringBuilder sb, FuzzedDataProvider data, boolean forceSupplementary) {
        if (!forceSupplementary && data.consumeBoolean()) {
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(6)));
            return;
        }
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        if (!Character.isValidCodePoint(cp) || cp < 0x10000) {
            cp = 0x1F630;
        }
        sb.append(Character.toChars(cp));
        if (data.consumeBoolean()) {
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(4)));
        }
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 && c != '\t') {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('Z');
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }
}
