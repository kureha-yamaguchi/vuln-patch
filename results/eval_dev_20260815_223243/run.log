private static void checkExponentZeroAgreement(String s) {
        if (s == null || s.length() == 0) {
            return;
        }

        Number plain;
        Number expZero;
        try {
            plain = NumberUtils.createNumber(s);
            plain = NumberUtils.createNumber(s);
            expZero = NumberUtils.createNumber(s + "e0");
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (plain == null || expZero == null) {
            return;
        }

        try {
            BigDecimal lhs = new BigDecimal(plain.toString());
            BigDecimal rhs = new BigDecimal(expZero.toString());
            if (lhs.compareTo(rhs) != 0) {
                throw new RuntimeException("[oracle:exp-zero-equivalence] metamorphic violation: input=" + s
                        + " plain=" + plain + " exp0=" + expZero);
            }
        } catch (NumberFormatException e) {
            return;
        }
    }
