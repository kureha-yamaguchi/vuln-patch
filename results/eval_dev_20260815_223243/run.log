package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String anchor : anchors) {
            tryEscapeCsv(anchor, true);
        }

        String prefix = sanitizeSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeSafeAscii(data.consumeAsciiString(16));

        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        if (codePoint >= 0xD800 && codePoint <= 0xDFFF) {
            codePoint = 0x10000;
        }

        String pair = new String(Character.toChars(codePoint));
        String input = prefix + pair + suffix;

        if (data.consumeBoolean()) {
            String extraPrefix = sanitizeSafeAscii(data.consumeAsciiString(8));
            input = extraPrefix + input;
        }
        if (data.consumeBoolean()) {
            String extraSuffix = sanitizeSafeAscii(data.consumeAsciiString(8));
            input = input + extraSuffix;
        }
        if (data.consumeBoolean()) {
            int codePoint2 = data.consumeInt(0x10000, 0x10FFFF);
            if (codePoint2 >= 0xD800 && codePoint2 <= 0xDFFF) {
                codePoint2 = 0x10FFFF;
            }
            input = input + new String(Character.toChars(codePoint2));
        }

        tryEscapeCsv(input, true);
    }

    private static void tryEscapeCsv(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract oracle: CSV escaping only adds quoting/quote-doubling when the input contains
             * a comma, double quote, CR, or LF. We construct inputs from safe ASCII plus valid
             * supplementary Unicode code points, excluding those CSV-special characters, so a correct
             * implementation must return the input unchanged. A throw-deleting or bookkeeping-skipping
             * patch could avoid the crash but still corrupt/skip characters; this equality catches that.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve inputs without CSV-special characters input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
