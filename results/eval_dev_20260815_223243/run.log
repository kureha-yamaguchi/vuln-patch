    private static String buildValidDecimal(FuzzedDataProvider data) {
        int wholeLen = data.consumeInt(1, 6);
        int fracLen = data.consumeInt(0, 6);
        boolean negative = data.consumeBoolean();

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }

        for (int i = 0; i < wholeLen; i++) {
            int digit = data.consumeInt(0, 9);
            if (i == 0 && wholeLen > 1 && digit == 0) {
                digit = data.consumeInt(1, 9);
            }
            sb.append((char) ('0' + digit));
        }

        sb.append('.');

        for (int i = 0; i < fracLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        return sb.toString();
    }

    private static void tryCreateNumberValid(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRelevantRootCause(t) && validByConstruction) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isValidConstructedDecimal(String s) {
        if (s == null || s.length() < 2) {
            return false;
        }
        int start = 0;
        if (s.charAt(0) == '-') {
            if (s.length() < 3) {
                return false;
            }
            start = 1;
        }
        int dot = s.indexOf('.');
        if (dot < 0 || dot < start + 1) {
            return false;
        }
        for (int i = start; i < dot; i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }
        for (int i = dot + 1; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }
        return dot == s.lastIndexOf('.');
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            } else if ("java.lang.String".equals(cls) && "substring".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }
}
