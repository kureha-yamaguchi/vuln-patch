        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(exactLeft, absentEnd);
            byIndex = series.createCopy(leftIndex, leftIndex);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: extending an exact left boundary into an empty gap should preserve the left singleton", e);
            }
            throw e;
        }

        /* Contract used here: absentEnd is inside the gap immediately after exactLeft, so [exactLeft, absentEnd]
           contains exactly the left boundary item and must match the equivalent index-based singleton copy. */
        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd
                    + " leftIndex=" + leftIndex);
