    private static void checkExponentMarkerCaseEquivalence(String s) {
        int ePos = s.indexOf('e');
        int EPos = s.indexOf('E');
        int pos = ePos >= 0 ? ePos : EPos;
        if (pos <= 0 || pos >= s.length() - 1) {
            return;
        }

        String lower = s.substring(0, pos) + 'e' + s.substring(pos + 1);
        String upper = s.substring(0, pos) + 'E' + s.substring(pos + 1);

        /*
         * Contract visible in createNumber: exponent position is derived from both 'e' and 'E',
         * so valid scientific-notation strings that differ only in exponent-marker case must denote
         * the same numeric quantity. A throw-deleting or overfit patch can stop crashing yet still
         * mis-handle the mantissa/exponent bookkeeping for one marker spelling.
         */
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:exp-marker-case-equivalence] metamorphic violation: input="
                        + s + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracle(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t) && isValidScientific(lower) && isValidScientific(upper)) {
                throw t;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ex) {
            return a.toString().equals(b.toString());
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException || isOracle(t);
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(c)) {
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            } else if ("java.lang.String".equals(c) && "substring".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidScientific(String s) {
        if (s == null || s.length() < 3 || s.indexOf('.') >= 0) {
            return false;
        }
        int pos = s.indexOf('e');
        if (pos < 0) {
            pos = s.indexOf('E');
        }
        if (pos <= 0 || pos >= s.length() - 1) {
            return false;
        }
        if (s.indexOf('e', pos + 1) >= 0 || s.indexOf('E', pos + 1) >= 0) {
            return false;
        }

        int i = 0;
        if (s.charAt(0) == '-') {
            if (pos == 1) {
                return false;
            }
            i = 1;
        }
        for (; i < pos; i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }

        i = pos + 1;
        if (i < s.length() && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
            i++;
        }
        if (i >= s.length()) {
            return false;
        }
        for (; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }
        return true;
    }

    private static boolean isValidScientificWithSuffix(String base, char suffix) {
        if (!isValidScientific(base)) {
            return false;
        }
        return suffix == 'F' || suffix == 'D';
    }
