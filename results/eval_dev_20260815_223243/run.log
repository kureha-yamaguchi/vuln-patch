package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorExamples();

        String baseText = data.consumeString(24);
        if (baseText.length() == 0) {
            baseText = "aba";
        }

        String guaranteedNeedle = data.consumeString(6);
        if (guaranteedNeedle.length() == 0) {
            guaranteedNeedle = "a";
        }

        int pos = data.consumeInt(0, baseText.length());
        String text = baseText.substring(0, pos) + guaranteedNeedle + baseText.substring(pos);

        String guaranteedReplacement = data.consumeString(8);
        if (guaranteedReplacement == null) {
            guaranteedReplacement = "";
        }

        int invalidCount = data.consumeInt(1, 3);
        String[] search = new String[1 + invalidCount];
        String[] repl = new String[1 + invalidCount];

        search[0] = guaranteedNeedle;
        repl[0] = guaranteedReplacement;

        for (int i = 1; i < search.length; i++) {
            int kind = data.consumeInt(0, 3);
            if (kind == 0) {
                search[i] = null;
                repl[i] = data.consumeBoolean() ? data.consumeString(6) : "";
            } else if (kind == 1) {
                search[i] = "";
                repl[i] = data.consumeString(6);
            } else if (kind == 2) {
                String unmatched = data.consumeString(6);
                if (unmatched == null || unmatched.length() == 0 || text.indexOf(unmatched) >= 0) {
                    unmatched = guaranteedNeedle + "\u0000" + i;
                }
                search[i] = unmatched;
                repl[i] = null;
            } else {
                String unmatched = data.consumeString(6);
                if (unmatched == null || unmatched.length() == 0 || text.indexOf(unmatched) >= 0) {
                    unmatched = guaranteedNeedle + "\u0001" + i;
                }
                search[i] = unmatched;
                repl[i] = data.consumeString(6);
            }
        }

        String[] filteredSearch = filterSearch(search, repl);
        String[] filteredRepl = filterRepl(search, repl);

        int rotate = search.length == 0 ? 0 : data.consumeInt(0, search.length - 1);
        String[] rotatedSearch = rotate(search, rotate);
        String[] rotatedRepl = rotate(repl, rotate);

        // Contract exercised from StringUtils.replaceEach's documented/tested behavior:
        // entries with null search, empty search, or null replacement are ignored.
        // Therefore inserting or permuting such ignored entries must not change the result
        // compared to the filtered valid pairs. A throw-deleting or seed-special-casing patch
        // can still violate this relation.
        String expected;
        try {
            expected = StringUtils.replaceEach(text, filteredSearch, filteredRepl);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            return;
        }

        String withInvalid;
        try {
            withInvalid = StringUtils.replaceEach(text, search, repl);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:ignored-entry-invariance] valid call threw from replaceEach input="
                        + summarize(text, search, repl) + " filtered=" + summarize(text, filteredSearch, filteredRepl), e);
            }
            return;
        }

        String rotated;
        try {
            rotated = StringUtils.replaceEach(text, rotatedSearch, rotatedRepl);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:ignored-entry-permutation] valid call threw from replaceEach input="
                        + summarize(text, rotatedSearch, rotatedRepl), e);
            }
            return;
        }

        if (!same(expected, withInvalid) || !same(expected, rotated)) {
            throw new RuntimeException("[oracle:ignored-entry-invariance] metamorphic violation: filtered-vs-invalid text="
                    + quote(text)
                    + " expected=" + quote(expected)
                    + " withInvalid=" + quote(withInvalid)
                    + " rotated=" + quote(rotated)
                    + " search=" + arrayToString(search)
                    + " repl=" + arrayToString(repl));
        }

        // Independent cross-check using reachable helper StringUtils.length:
        // equal strings must report equal lengths through the library helper as well.
        int lenExpected = StringUtils.length(expected);
        int lenWithInvalid = StringUtils.length(withInvalid);
        int lenRotated = StringUtils.length(rotated);
        if (lenExpected != lenWithInvalid || lenExpected != lenRotated) {
            throw new RuntimeException("[oracle:length-agrees-after-ignored-entries] consistency violation: expectedLen="
                    + lenExpected + " withInvalidLen=" + lenWithInvalid + " rotatedLen=" + lenRotated
                    + " expected=" + quote(expected) + " withInvalid=" + quote(withInvalid)
                    + " rotated=" + quote(rotated));
