package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();
        runExplore(data);
    }

    private static void runAnchorChecks() {
        String[] search = new String[] { "a", "b" };
        String[] repl = new String[] { "c", null };

        try {
            String result = StringUtils.replaceEach("aba", search, repl);
            if (!"cbc".equals(result)) {
                throw new RuntimeException("[oracle:anchor-contract] expected cbc for valid null-elision input, got=" + result);
            }
            int reported = StringUtils.length(result);
            int independent = StringUtils.length("c") + StringUtils.length("b") + StringUtils.length("c");
            if (reported != independent) {
                throw new RuntimeException("[oracle:anchor-length] consistency violation: reported=" + reported + " independent=" + independent);
            }
        } catch (RuntimeException t) {
            if (isOracle(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-null-elision] valid input should ignore null replacement element and return cbc, but threw " + t.getClass().getName(), t);
            }
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        String prefix = onlyFrom(data.consumeAsciiString(8), "abc");
        String suffix = onlyFrom(data.consumeAsciiString(8), "abc");
        String replacement = onlyFrom(data.consumeAsciiString(8), "def");
        String fillerReplacement = onlyFrom(data.consumeAsciiString(4), "uvw");

        if (prefix.length() == 0) {
            prefix = "ab";
        }
        if (suffix.length() == 0) {
            suffix = "bc";
        }
        if (replacement.length() == 0) {
            replacement = "d";
        }
        if (fillerReplacement.length() == 0) {
            fillerReplacement = "u";
        }

        String token = "X";
        String absent = "Y";
        String nullReplSearch = "Z";
        String text = prefix + token + suffix;
        String expected = prefix + replacement + suffix;

        String[] searchA = new String[] { token, absent, nullReplSearch };
        String[] replA = new String[] { replacement, fillerReplacement, null };

        String[] searchB = new String[] { absent, token, nullReplSearch };
        String[] replB = new String[] { fillerReplacement, replacement, null };

        String resultA;
        try {
            resultA = StringUtils.replaceEach(text, searchA, replA);
        } catch (RuntimeException t) {
            if (isOracle(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:single-match] valid constructed input has exactly one real match and one ignorable null replacement element; throwing here violates the contract", t);
            }
            return;
        }

        if (!expected.equals(resultA)) {
            throw new RuntimeException("[oracle:known-single] metamorphic violation: constructed single-match input should replace only X and ignore null replacement element input=" + text + " expected=" + expected + " got=" + resultA);
        }

        int reportedLen = StringUtils.length(resultA);
        int independentLen = StringUtils.length(prefix) + StringUtils.length(replacement) + StringUtils.length(suffix);
        if (reportedLen != independentLen) {
            throw new RuntimeException("[oracle:single-length] consistency violation: reported=" + reportedLen + " independent=" + independentLen + " result=" + resultA);
        }

        try {
            String resultB = StringUtils.replaceEach(text, searchB, replB);
            if (!expected.equals(resultB)) {
                throw new RuntimeException("[oracle:perm-known] metamorphic violation: permutation with one unique live match should preserve result expected=" + expected + " got=" + resultB);
            }
            if (!resultA.equals(resultB)) {
                throw new RuntimeException("[oracle:permute-livepair] metamorphic violation: reordering unmatched and ignored pairs changed the result input=" + text + " lhs=" + resultA + " rhs=" + resultB);
            }
            int lenB = StringUtils.length(resultB);
            if (lenB != independentLen) {
                throw new RuntimeException("[oracle:perm-length] consistency violation: reported=" + lenB + " independent=" + independentLen + " result=" + resultB);
            }
        } catch (RuntimeException t) {
            if (isOracle(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:permute-livepair] valid permutation of the same unique matched pair should behave identically, but threw " + t.getClass().getName(), t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("replaceEach".equals(m) || "length".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Validation");
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static String onlyFrom(String s, String alphabet) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (alphabet.indexOf(c) >= 0) {
                out.append(c);
            }
        }
        return out.toString();
    }
}
