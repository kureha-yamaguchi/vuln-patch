            checkEquals("cbc", StringUtils.replaceEach("aba", new String[] {"a", "b"}, new String[] {"c", null}));
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static String[] filterSearch(String[] searchList, String[] replacementList) {
        int count = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                out[j++] = searchList[i];
            }
        }
        return out;
    }

    private static String[] filterReplacement(String[] searchList, String[] replacementList) {
        int count = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                out[j++] = replacementList[i];
            }
        }
        return out;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void checkEquals(String expected, String actual) {
        if (!safeEquals(expected, actual)) {
            throw new RuntimeException(
                "[oracle:anchor] metamorphic violation: expected=" + expected + " actual=" + actual);
        }
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
