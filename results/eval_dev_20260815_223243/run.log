package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.io.IOException;
import java.io.StringWriter;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCsvEscape("\uD83D\uDE30", true);
        runCsvEscape("\uD800\uDC00", true);
        runCsvEscape("\uD834\uDD1E", true);
        runCsvEscape("\uDBFF\uDFFD", true);

        String explored = buildValidCsvSafeString(data);
        runCsvEscape(explored, true);
    }

    private static void runCsvEscape(String input, boolean validByConstruction) {
        String viaPublic;
        try {
            viaPublic = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
            return;
        }

        // Contract/oracle: CSV escaping leaves values unchanged when they contain no comma,
        // quote, CR, or LF. Our constructed inputs are valid strings made only of safe ASCII
        // plus valid UTF-16 surrogate pairs, so a correct implementation must accept them and
        // return the original value unchanged. A throw-deleting or branch-skipping patch that
        // silently drops/duplicates characters would violate this observable post-condition.
        if (!input.equals(viaPublic)) {
            throw new RuntimeException(
                "[oracle:csv-identity] metamorphic violation: safe CSV input must remain unchanged input="
                    + printable(input) + " lhs=" + printable(viaPublic) + " rhs=" + printable(input));
        }

        String viaTranslateString;
        try {
            viaTranslateString = StringEscapeUtils.ESCAPE_CSV.translate(input);
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
            return;
        }

        String viaTranslateWriter;
        try {
            StringWriter writer = new StringWriter(input.length() * 2 + 4);
            StringEscapeUtils.ESCAPE_CSV.translate(input, writer);
            viaTranslateWriter = writer.toString();
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
            return;
        }

        // Documented overload agreement: CharSequenceTranslator.translate(CharSequence) delegates
        // to translate(CharSequence, Writer), so both overloads must produce the same output for
        // the same input. StringEscapeUtils.escapeCsv uses the real production entry point and must
        // agree with the underlying translator on equivalent inputs.
        if (!viaPublic.equals(viaTranslateString) || !viaPublic.equals(viaTranslateWriter)) {
            throw new RuntimeException(
                "[oracle:overload-agree] metamorphic violation: equivalent CSV escape entrypoints disagree input="
                    + printable(input) + " lhs=" + printable(viaPublic)
                    + " rhs=" + printable(viaTranslateString)
                    + " writer=" + printable(viaTranslateWriter));
        }
    }

    private static String buildValidCsvSafeString(FuzzedDataProvider data) {
        String prefix = sanitizeCsvSafe(data.consumeAsciiString(8));
        String middle = sanitizeCsvSafe(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(8));

        int pairCount = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder(prefix.length() + middle.length() + suffix.length() + pairCount * 2 + 4);
        sb.append(prefix);
        for (int i = 0; i < pairCount; i++) {
            if (i == 1) {
                sb.append(middle);
            }
            char hi = (char) data.consumeInt(0xD800, 0xDBFF);
            char lo = (char) data.consumeInt(0xDC00, 0xDFFF);
            sb.append(hi).append(lo);
            if (data.consumeBoolean()) {
                sb.append(safeAsciiChar(data.consumeInt(0, 61)));
            }
        }
        sb.append(suffix);

        if (sb.length() == 0) {
            sb.append('a').append('\uD83D').append('\uDE30');
        }
        return sb.toString();
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('a');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static char safeAsciiChar(int n) {
        final String safe = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        return safe.charAt(Math.abs(n) % safe.length());
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (isCleanRejection(t)) {
            return;
        }
        if (validByConstruction && isRootCause(t)) {
            sneakyThrow(t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("validation")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof StringIndexOutOfBoundsException || cur instanceof IndexOutOfBoundsException) {
                for (StackTraceElement ste : cur.getStackTrace()) {
                    String cls = ste.getClassName();
                    String method = ste.getMethodName();
                    if ("translate".equals(method)
                        && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                            || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                            || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                            || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '\\' && c != '"') {
                sb.append(c);
            } else {
                sb.append(String.format("\\u%04X", (int) c));
            }
        }
        sb.append('"');
        return sb.toString();
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
