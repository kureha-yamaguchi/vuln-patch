    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid") || name.contains("parse");
    }

    private static String buildCanonicalBase(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }

        int intDigits = data.consumeInt(1, 6);
        boolean nonZeroSeen = false;
        for (int i = 0; i < intDigits; i++) {
            int d = data.consumeInt(0, 9);
            if (i == 0 && intDigits > 1 && d == 0) {
                d = data.consumeInt(1, 9);
            }
            if (d != 0) {
                nonZeroSeen = true;
            }
            sb.append((char) ('0' + d));
        }

        if (data.consumeBoolean()) {
            sb.append('.');
            int fracDigits = data.consumeInt(1, 3);
            for (int i = 0; i < fracDigits; i++) {
                int d = data.consumeInt(0, 9);
                if (d != 0) {
                    nonZeroSeen = true;
                }
                sb.append((char) ('0' + d));
            }
        }

        if (!nonZeroSeen) {
            int pos = sb.charAt(0) == '-' ? 1 : 0;
            if (pos < sb.length() && Character.isDigit(sb.charAt(pos))) {
                sb.setCharAt(pos, '1');
            }
        }
        return sb.toString();
    }

    private static String stripFraction(String s) {
        int dot = s.indexOf('.');
        return dot >= 0 ? s.substring(0, dot) : s;
    }

    private static String stripToDigitsOrSign(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length() && sb.length() < 6; i++) {
            char c = s.charAt(i);
            if ((c == '-' || c == '+') && sb.length() == 0) {
                sb.append(c);
            } else if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean hasDigit(String s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isDigit(s.charAt(i))) {
                return true;
            }
        }
        return false;
    }
