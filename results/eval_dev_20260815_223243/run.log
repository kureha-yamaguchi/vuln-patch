                TimeSeries singleton = series.createCopy(period, period);
                assertLookupAgreement(singleton, period, "singleton-copy");

                if (singleton.getItemCount() != 1) {
                    throw new RuntimeException("[oracle:singleton-size] metamorphic violation: exact period copy must contain exactly one item"
