                Number unsuffixed = NumberUtils.createNumber(numeric);

                /* Sound cross-check: for exactly representable payloads, createNumber(numeric+F) and
                 * createFloat(numeric) compute the same float quantity, and the unsuffixed parse denotes
                 * the same numeric value. This uses real library siblings and catches masked wrong-branch
                 * behaviour even if no exception is thrown.
                 */
                if (!(reported instanceof Float)
                        || independent == null
                        || unsuffixed == null
                        || Float.floatToIntBits(((Float) reported).floatValue()) != Float.floatToIntBits(independent.floatValue())
                        || Float.floatToIntBits(unsuffixed.floatValue()) != Float.floatToIntBits(independent.floatValue())) {
                    throw new RuntimeException(
                            "[oracle:float-suffix-helper-agree] metamorphic violation: createNumber(numeric+F) and createFloat(numeric) must agree on exactly representable payloads input="
                                    + withSuffix + " lhs=" + reported + " unsuffixed=" + unsuffixed + " rhs=" + independent);
                }
            } catch (IllegalArgumentException e) {
                // Rejection skips the relation.
            } catch (RuntimeException e) {
                if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                    throw e;
                }
                boolean inRegion = false;
                StackTraceElement[] st = e.getStackTrace();
                for (int j = 0; j < st.length; j++) {
                    String cn = st[j].getClassName();
                    String mn = st[j].getMethodName();
                    if ("org.apache.commons.lang.NumberUtils".equals(cn)
                            && ("createNumber".equals(mn)
                            || "createFloat".equals(mn)
                            || "createDouble".equals(mn)
                            || "createBigDecimal".equals(mn)
                            || "isAllZeros".equals(mn))) {
                        inRegion = true;
                        break;
                    }
                }
                if (inRegion && e instanceof StringIndexOutOfBoundsException) {
                    throw e;
                }
            }
        }
    }
