                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void addValue(TimeSeries series, Day day, int value) {
        series.add(day, new Integer(value));
    }

    private static Day dayFromEpochDay(int epochDay) {
        long millis = ((long) epochDay) * 86400000L + 43200000L;
        return new Day(new java.util.Date(millis));
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static void checkIndexRoundTrip(TimeSeries series, String tag) {
        if (series.getTimePeriods().size() != series.getItemCount()) {
            throw new RuntimeException("[oracle:index-view-size] metamorphic violation: time-period view size disagrees with item count"
                    + " tag=" + tag
                    + " periodsSize=" + series.getTimePeriods().size()
                    + " itemCount=" + series.getItemCount());
        }
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            int idx = series.getIndex(p);
            if (idx != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: existing period does not round-trip through getIndex"
                        + " tag=" + tag
                        + " expectedIndex=" + i
                        + " actualIndex=" + idx
                        + " period=" + p);
            }
            if (!series.getDataItem(i).getPeriod().equals(p)) {
                throw new RuntimeException("[oracle:dataitem-period] metamorphic violation: getDataItem(i).getPeriod disagrees with getTimePeriod(i)"
                        + " tag=" + tag
                        + " index=" + i
                        + " dataItemPeriod=" + series.getDataItem(i).getPeriod()
                        + " timePeriod=" + p);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
