        } catch (RuntimeException t) {
            boolean root = t instanceof StringIndexOutOfBoundsException;
            if (root) {
                StackTraceElement[] st = t.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                            && "toBoolean".equals(st[i].getMethodName())) {
                        throw t;
                    }
                }
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
        }

        // Mandatory oracle:
        // The visible method body implements a case-insensitive parser where only
        // "on", "yes", and "true" map to true; other strings return false.
        // Equivalent mixed-case spellings of "yes" must therefore agree with "yes".
        // A patch that merely deletes the crashing branch or makes it unreachable
        // can silently break this observable result without throwing.
        String yesVariant = ""
                + (data.consumeBoolean() ? 'Y' : 'y')
                + (data.consumeBoolean() ? 'E' : 'e')
                + (data.consumeBoolean() ? 'S' : 's');
        try {
            boolean lhs = BooleanUtils.toBoolean(yesVariant);
            boolean rhs = BooleanUtils.toBoolean("yes");
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:yes-case] metamorphic violation: case-insensitive equivalents must agree input=" + yesVariant + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException("[oracle:yes-true] metamorphic violation: canonical true token must map to true input=" + yesVariant + " lhs=" + lhs + " rhs=true");
            }
        } catch (RuntimeException t) {
