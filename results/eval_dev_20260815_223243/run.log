package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeCreateNumberValid("1234.5");

        String candidate = buildValidNumber(data);
        invokeCreateNumberValid(candidate);

        checkDecimalAgreesWithCreateFloat(buildCanonicalDecimal(data));
        checkIntAgreesWithCreateInteger(buildCanonicalInt(data));
        checkLongSuffixAgreement(data);
        checkBigIntegerFallbackAgreement(data);
    }

    private static void invokeCreateNumberValid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildValidNumber(FuzzedDataProvider data) {
        int kind = data.consumeInt(0, 5);
        switch (kind) {
            case 0:
                return buildCanonicalDecimal(data);
            case 1:
                return buildCanonicalInt(data);
            case 2: {
                String base = buildCanonicalDecimal(data);
                return base + (data.consumeBoolean() ? "F" : "D");
            }
            case 3: {
                String base = buildCanonicalInt(data);
                return base + (data.consumeBoolean() ? "L" : "l");
            }
            case 4:
                return buildCanonicalHex(data);
            default:
                return buildCanonicalExponent(data);
        }
    }

    private static String buildCanonicalDecimal(FuzzedDataProvider data) {
        int whole = data.consumeInt(1, 1_000_000);
        int frac = data.consumeInt(1, 999_999);
        String sign = data.consumeBoolean() ? "-" : "";
        return sign + whole + "." + frac;
    }

    private static String buildCanonicalInt(FuzzedDataProvider data) {
        return Integer.toString(data.consumeInt(-1_000_000, 1_000_000));
    }

    private static String buildCanonicalHex(FuzzedDataProvider data) {
        String digits = data.consumeAsciiString(8);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('1');
        }
        return (data.consumeBoolean() ? "-0x" : "0x") + sb.toString();
    }

    private static String buildCanonicalExponent(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        int whole = data.consumeInt(1, 1_000_000);
        boolean withDecimal = data.consumeBoolean();
        String mantissa = withDecimal ? (whole + "." + data.consumeInt(1, 999_999)) : Integer.toString(whole);
        String expSign = data.consumeBoolean() ? "-" : "";
        int exp = data.consumeInt(0, 30);
        return sign + mantissa + (data.consumeBoolean() ? "E" : "e") + expSign + exp;
    }

    private static void checkLongSuffixAgreement(FuzzedDataProvider data) {
        String base = Integer.toString(data.consumeInt(-1_000_000, 1_000_000));
        Number plain;
        Number suffixed;
        try {
            plain = NumberUtils.createNumber(base);
            suffixed = NumberUtils.createNumber(base + "L");
        } catch (RuntimeException e) {
            if (isOracleViolation(e)) {
                throw e;
            }
            if (isRootCause(e) && hasRelevantStack(e)) {
                throw e;
            }
            return;
        }
        if (plain == null || suffixed == null) {
            return;
        }

        if (plain.longValue() != suffixed.longValue()) {
            throw new RuntimeException("[oracle:long-suffix] metamorphic violation: input=" + base
                    + " plain=" + plain + " suffixed=" + suffixed);
        }
    }

    private static void checkBigIntegerFallbackAgreement(FuzzedDataProvider data) {
        String base = buildOversizedInteger(data);
        Number plain;
        Number suffixed;
        BigInteger direct;
        try {
            plain = NumberUtils.createNumber(base);
            suffixed = NumberUtils.createNumber(base + "L");
            direct = NumberUtils.createBigInteger(base);
        } catch (RuntimeException e) {
            if (isOracleViolation(e)) {
                throw e;
            }
            if (isRootCause(e) && hasRelevantStack(e)) {
                throw e;
            }
            return;
        }
        if (plain == null || suffixed == null || direct == null) {
            return;
        }

        BigInteger plainValue = toBigInteger(plain);
        BigInteger suffixedValue = toBigInteger(suffixed);
        if (!direct.equals(plainValue) || !direct.equals(suffixedValue)) {
