package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below: StringEscapeUtils.escapeCsv returns the input unchanged
        // when it contains no CSV special characters (comma, quote, CR, LF). A valid UTF-16
        // surrogate pair is ordinary text for CSV escaping, so deleting/skipping the patched
        // bookkeeping would either throw or produce the wrong output on such inputs.

        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            exerciseValidCsvNoEscapeInput(anchors[i], true);
        }

        String explored = buildValidNoEscapeStringWithSurrogates(data);
        exerciseValidCsvNoEscapeInput(explored, true);

        String partA = buildValidNoEscapeStringWithSurrogates(data);
        String partB = buildValidNoEscapeStringWithSurrogates(data);
        try {
            String lhs = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(partA + partB);
            String rhs = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(partA)
                    + org.apache.commons.lang3.StringEscapeUtils.escapeCsv(partB);
            if (!lhs.equals(rhs)) {
                throw new RuntimeException("[oracle:csv-compose] metamorphic violation: escapeCsv(a+b)==escapeCsv(a)+escapeCsv(b) for inputs with no CSV specials input="
                        + printable(partA + "|" + partB) + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static void exerciseValidCsvNoEscapeInput(String input, boolean validByConstruction) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
            if (!input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv should be identity for strings without CSV special chars input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static String buildValidNoEscapeStringWithSurrogates(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int segments = data.consumeInt(1, 6);
        for (int i = 0; i < segments; i++) {
            sb.append(sanitizeNoCsvSpecials(data.consumeAsciiString(8)));

            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (cp >= 0xD800 && cp <= 0xDFFF) {
                cp = 0x10000;
            }
            sb.append(Character.toChars(cp));

            if (data.consumeBoolean()) {
                sb.append(sanitizeNoCsvSpecials(data.consumeString(6)));
            }
        }

        if (sb.length() == 0) {
            sb.append("A");
            sb.append(Character.toChars(0x10000));
        }

        return sanitizeNoCsvSpecials(sb.toString());
    }

    private static String sanitizeNoCsvSpecials(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                out.append('X');
            } else {
                out.append(ch);
            }
        }
        return out.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            String lower = name.toLowerCase(java.util.Locale.ROOT);
            if (lower.contains("invalid") || lower.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (Character.isISOControl(ch)) {
                        String hex = Integer.toHexString(ch);
                        b.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(ch);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
