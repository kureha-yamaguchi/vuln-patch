        if (malformed != null) {
            tryTarget(malformed, false);
        }

        String validSci = buildValidScientific(data);
        if (validSci != null) {
            tryTarget(validSci, true);
            checkExponentMarkerCaseEquivalence(validSci);

            try {
                Number fUpper = NumberUtils.createNumber(validSci + "F");
                Number fLower = NumberUtils.createNumber(validSci + "f");
                if (fUpper != null && fLower != null && !sameNumericValue(fUpper, fLower)) {
                    throw new RuntimeException("[oracle:suffix-f-case-equivalence] metamorphic violation: input="
                            + validSci + " lhs=" + fUpper + " rhs=" + fLower);
                }
            } catch (RuntimeException t) {
                if (isOracle(t)) {
                    throw t;
                }
                if (isRootCause(t) && hasRelevantStack(t) && isValidScientificWithSuffix(validSci, 'F')) {
                    throw t;
                }
            }

            try {
                Number dUpper = NumberUtils.createNumber(validSci + "D");
                Number dLower = NumberUtils.createNumber(validSci + "d");
                if (dUpper != null && dLower != null && !sameNumericValue(dUpper, dLower)) {
                    throw new RuntimeException("[oracle:suffix-d-case-equivalence] metamorphic violation: input="
                            + validSci + " lhs=" + dUpper + " rhs=" + dLower);
                }
            } catch (RuntimeException t) {
                if (isOracle(t)) {
                    throw t;
                }
                if (isRootCause(t) && hasRelevantStack(t) && isValidScientificWithSuffix(validSci, 'D')) {
                    throw t;
                }
            }
        }

        String intLiteral = buildValidIntegerLiteral(data);
        if (intLiteral != null) {
            try {
                Number parsed = NumberUtils.createNumber(intLiteral);
                Long helper = NumberUtils.createLong(intLiteral);
                if (parsed != null && helper != null) {
                    BigDecimal lhs = new BigDecimal(parsed.toString());
                    BigDecimal rhs = new BigDecimal(helper.toString());
                    if (lhs.compareTo(rhs) != 0) {
                        throw new RuntimeException("[oracle:long-helper-agreement] metamorphic violation: input="
                                + intLiteral + " parsed=" + parsed + " helper=" + helper);
                    }
                }
            } catch (RuntimeException t) {
                if (isOracle(t)) {
