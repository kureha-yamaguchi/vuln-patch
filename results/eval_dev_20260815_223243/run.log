package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        if (data.remainingBytes() < 8) {
            return;
        }

        try {
            int base = data.consumeInt(0, 20000);
            int leftExtras = data.consumeInt(0, 4);
            int rightExtras = data.consumeInt(0, 4);
            int gapToStart = data.consumeInt(1, 30);
            int gapWidth = data.consumeInt(0, 30);
            int gapToRight = data.consumeInt(1, 30);

            int leftDayNum = base + leftExtras;
            int startDayNum = leftDayNum + gapToStart;
            int endDayNum = startDayNum + gapWidth;
            int rightDayNum = endDayNum + gapToRight;

            Day left = dayFromEpochDay(leftDayNum);
            Day start = dayFromEpochDay(startDayNum);
            Day end = dayFromEpochDay(endDayNum);
            Day right = dayFromEpochDay(rightDayNum);

            TimeSeries s = new TimeSeries(nonEmpty(data.consumeAsciiString(12), "F"), "D", "R", Day.class);

            for (int i = leftExtras; i > 0; i--) {
                s.add(dayFromEpochDay(base + (leftExtras - i)), Integer.valueOf(i));
            }
            s.add(left, Integer.valueOf(100));
            s.add(right, Integer.valueOf(200));
            for (int i = 1; i <= rightExtras; i++) {
                s.add(dayFromEpochDay(rightDayNum + i), Integer.valueOf(200 + i));
            }

            runScenario(s, start, end);
        } catch (RuntimeException t) {
            if (isOwnOracle(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromPatchedRegion(t)) {
                return;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        try {
            runScenario(s, new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (RuntimeException t) {
            if (isOwnOracle(t)) {
                throw t;
            }
            if (isRootCauseFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:anchor-gap-empty-copy] valid empty-range createCopy threw from patched region",
                        t);
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException("[oracle:anchor-gap-empty-copy] unexpected clone failure", e);
        }
    }

    private static void runScenario(TimeSeries source, Day start, Day end) throws CloneNotSupportedException {
        if (start.compareTo(end) > 0) {
            return;
        }

        int sourceCountBefore = source.getItemCount();
        int startRaw = source.getIndex(start);
        int endRaw = source.getIndex(end);

        if (startRaw >= 0 || endRaw >= 0) {
            return;
        }

        int startIndex = -(startRaw + 1);
        int endIndex = -(endRaw + 1) - 1;

        if (!(endIndex < startIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = source.createCopy(start, end);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                throw t;
            }
            if (isRootCauseFromPatchedRegion(t)) {
                throw new RuntimeException(
                        "[oracle:gap-empty-copy] valid empty gap should return an empty copy, but createCopy rejected it; startIndex="
                                + startIndex + " endIndex=" + endIndex + " sourceCount=" + sourceCountBefore,
                        t);
            }
            return;
        }

        if (copy == null) {
            throw new RuntimeException("[oracle:gap-empty-copy] createCopy returned null");
        }

        if (copy.getItemCount() != 0) {
            throw new RuntimeException(
                    "[oracle:gap-empty-copy] metamorphic violation: copy of a gap-only range must be empty copyCount="
                            + copy.getItemCount() + " sourceCount=" + sourceCountBefore);
        }

        if (!copy.getItems().isEmpty()) {
            throw new RuntimeException(
                    "[oracle:gap-empty-copy] metamorphic violation: empty copy must expose an empty item list size="
                            + copy.getItems().size());
        }

        if (copy.getTimePeriodClass() != source.getTimePeriodClass()) {
            throw new RuntimeException(
                    "[oracle:gap-clone-meta] metamorphic violation: copy must preserve timePeriodClass src="
                            + source.getTimePeriodClass() + " copy=" + copy.getTimePeriodClass());
        }

        /* Contract asserted:
           createCopy(...) returns a copy; after taking an empty-range copy through the clone path,
           mutating the copy must not mutate the source. A throw-deleting or aliasing patch could
           return the wrong object or share the backing list silently. */
        copy.add(start, Integer.valueOf(999));

        if (copy.getItemCount() != 1 || copy.getIndex(start) < 0) {
            throw new RuntimeException(
                    "[oracle:gap-clone-independence] metamorphic violation: inserted item missing from copy copyCount="
                            + copy.getItemCount() + " copyIndex=" + copy.getIndex(start));
        }

        if (source.getItemCount() != sourceCountBefore) {
            throw new RuntimeException(
                    "[oracle:gap-clone-independence] metamorphic violation: mutating copy changed source count before="
                            + sourceCountBefore + " after=" + source.getItemCount());
        }

        if (source.getIndex(start) >= 0) {
            throw new RuntimeException(
                    "[oracle:gap-clone-independence] metamorphic violation: mutating copy inserted into source sourceIndex="
                            + source.getIndex(start));
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        long millis = ((long) epochDay) * 86400000L + 43200000L;
        return new Day(new java.util.Date(millis));
    }

    private static String nonEmpty(String s, String fallback) {
        return (s == null || s.length() == 0) ? fallback : s;
    }

    private static boolean isOwnOracle(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseFromPatchedRegion(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
