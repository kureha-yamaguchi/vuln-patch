package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probeCreateNumber("1234.5", true);
        checkPlainIntegerAgreesWithIntegerHelper("12345");

        String scientificNoDot = buildValidScientificNoDot(data);
        if (scientificNoDot != null) {
            probeCreateNumber(scientificNoDot, true);
            checkExponentMarkerCaseEquivalence(scientificNoDot);
        }

        String[] pair = buildEquivalentScientificPair(data);
        if (pair != null) {
            probeCreateNumber(pair[0], true);
            probeCreateNumber(pair[1], true);
            checkEquivalentScientificForms(pair[0], pair[1]);
            checkExponentMarkerCaseEquivalence(pair[0]);
            checkExponentMarkerCaseEquivalence(pair[1]);
        }
    }

    private static void probeCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkPlainIntegerAgreesWithIntegerHelper(String s) {
        try {
            Number parsed = NumberUtils.createNumber(s);
            Integer helper = NumberUtils.createInteger(s);
            if (parsed != null && helper != null && !sameNumericValue(parsed, helper)) {
                throw new RuntimeException("[oracle:plain-int-helper] metamorphic violation: createNumber and createInteger disagree input="
                        + s + " parsed=" + parsed + " helper=" + helper);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkExponentMarkerCaseEquivalence(String s) {
        String other;
        int lower = s.indexOf('e');
        int upper = s.indexOf('E');
        if (lower >= 0 && upper < 0) {
            other = s.substring(0, lower) + 'E' + s.substring(lower + 1);
        } else if (upper >= 0 && lower < 0) {
            other = s.substring(0, upper) + 'e' + s.substring(upper + 1);
        } else {
            return;
        }

        try {
            Number a = NumberUtils.createNumber(s);
            Number b = NumberUtils.createNumber(other);
            if (a != null && b != null && !sameNumericValue(a, b)) {
                throw new RuntimeException("[oracle:exp-marker-case] metamorphic violation: equivalent exponent marker case changed value lhs="
                        + s + " rhs=" + other + " a=" + a + " b=" + b);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificForms(String noDot, String withDot) {
        /*
         * Contract from createNumber's code path:
         * both inputs are valid numeric strings denoting the same mathematical value,
         * differing only by an inserted ".0" before the exponent. A correct parser must
         * preserve that value for both forms; a throw-deleting or overfit patch around the
         * mantissa/exponent split could silently parse one form differently.
         */
        try {
            Number a = NumberUtils.createNumber(noDot);
            Number b = NumberUtils.createNumber(withDot);
            if (a != null && b != null && !sameNumericValue(a, b)) {
                throw new RuntimeException("[oracle:scientific-dot-equivalence] metamorphic violation: equivalent scientific forms disagree lhs="
                        + noDot + " rhs=" + withDot + " a=" + a + " b=" + b);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static String buildValidScientificNoDot(FuzzedDataProvider data) {
        String digits = nonZeroLeadingDigits(data.consumeInt(1, 6), data);
        String expDigits = nonZeroLeadingDigits(data.consumeInt(1, 3), data);
        char marker = data.consumeBoolean() ? 'e' : 'E';
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? "-" : "";
        return sign + digits + marker + expSign + expDigits;
    }

    private static String[] buildEquivalentScientificPair(FuzzedDataProvider data) {
        String digits = nonZeroLeadingDigits(data.consumeInt(1, 6), data);
        String expDigits = nonZeroLeadingDigits(data.consumeInt(1, 3), data);
        char marker = data.consumeBoolean() ? 'e' : 'E';
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? "-" : "";
        String noDot = sign + digits + marker + expSign + expDigits;
        String withDot = sign + digits + ".0" + marker + expSign + expDigits;
        return new String[] { noDot, withDot };
    }

    private static String nonZeroLeadingDigits(int len, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        char first = (char) ('1' + data.consumeInt(0, 8));
        sb.append(first);
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        if ((a instanceof Double && (((Double) a).isNaN() || ((Double) a).isInfinite()))
                || (b instanceof Double && (((Double) b).isNaN() || ((Double) b).isInfinite()))
                || (a instanceof Float && (((Float) a).isNaN() || ((Float) a).isInfinite()))
                || (b instanceof Float && (((Float) b).isNaN() || ((Float) b).isInfinite()))) {
            return false;
        }
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
