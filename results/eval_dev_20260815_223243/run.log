    private static void addValue(TimeSeries series, Day day, int value) {
        series.add(day, new Integer(value));
    }

    private static Day dayFromOffset(int offset) {
        GregorianCalendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.setLenient(true);
        cal.set(2000, Calendar.JANUARY, 1, 0, 0, 0);
        cal.add(Calendar.DAY_OF_MONTH, offset);
        return new Day(cal.getTime());
    }

    private static int safeItemCount(TimeSeries s) {
        try {
            return s.getItemCount();
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return -1;
        }
    }

    private static int safeItemsSize(TimeSeries s) {
        try {
            return s.getItems().size();
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return -1;
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement f = stack[i];
            String cls = f.getClassName();
            String method = f.getMethodName();
