package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        exerciseCreateNumber("12345", true);
        exerciseCreateNumber("1234.5D", true);
        exerciseCreateNumber("1234.5d", true);
        exerciseCreateNumber("1234.5F", true);
        exerciseCreateNumber("1234.5f", true);
        exerciseCreateNumber("-1234.5", true);
        exerciseCreateNumber("-12345", true);
        exerciseCreateNumber("0xFADE", true);
        exerciseCreateNumber("-0xFADE", true);
        exerciseCreateNumber("2.", true);

        String decimal = buildValidDecimal(data);
        exerciseCreateNumber(decimal, true);

        String paddedDecimal = padWithTrailingFractionZeros(decimal, data.consumeInt(1, 4));
        exerciseCreateNumber(paddedDecimal, true);

        /*
         * Contract used for this oracle:
         * both strings denote the same decimal quantity; adding only trailing zeros to the
         * fractional part does not change the represented number. A correct createNumber
         * implementation may choose a concrete Number subtype, but the numeric value must agree.
         * This catches throw-deleting or bookkeeping-corrupting patches that stop crashing yet
         * silently parse the wrong quantity.
         */
        checkEquivalentDecimals(decimal, paddedDecimal);

        String scientificLower = buildValidScientific(data, false);
        String scientificUpper = flipExponentMarkerCase(scientificLower);
        exerciseCreateNumber(scientificLower, true);
        exerciseCreateNumber(scientificUpper, true);

        /*
         * Contract used for this oracle:
         * 'e' and 'E' are equivalent exponent markers for Java-style numeric literals, so
         * createNumber must compute the same numeric quantity for both spellings.
         */
        checkEquivalentScientificExponentCase(scientificLower, scientificUpper);

        /*
         * Consistency cross-check from the object's own output:
         * Number.toString() for the real JDK numeric objects returned by createNumber is a
         * parseable canonical representation of that same value. Re-parsing that representation
         * through the same public API must preserve the numeric quantity.
         */
        checkRoundTripConsistency(decimal);
        checkRoundTripConsistency(paddedDecimal);
        checkRoundTripConsistency(scientificLower);
        checkRoundTripConsistency(scientificUpper);
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentDecimals(String a, String b) {
        try {
            Number lhs = NumberUtils.createNumber(a);
            Number rhs = NumberUtils.createNumber(b);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:decimal-trailing-zero-equivalence] metamorphic violation: equivalent decimals disagreed inputA="
                        + a + " inputB=" + b + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRoundTripConsistency(String s) {
        try {
            Number first = NumberUtils.createNumber(s);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number reparsed = NumberUtils.createNumber(canonical);
            if (reparsed != null && !sameNumericValue(first, reparsed)) {
                throw new RuntimeException("[oracle:roundtrip-canonical-number] metamorphic violation: createNumber(x).toString() reparsed to different quantity input="
                        + s + " canonical=" + canonical + " first=" + first + " reparsed=" + reparsed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ignored) {
            return a.doubleValue() == b.doubleValue();
        }
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }

        int intLen = data.consumeInt(1, 6);
        boolean anyNonZero = false;
        for (int i = 0; i < intLen; i++) {
            int d = data.consumeInt(0, 9);
            if (i == 0 && intLen > 1 && d == 0) {
                d = data.consumeInt(1, 9);
            }
            if (d != 0) {
                anyNonZero = true;
            }
            sb.append((char) ('0' + d));
        }

        sb.append('.');

        int fracLen = data.consumeInt(1, 6);
        for (int i = 0; i < fracLen; i++) {
            int d = data.consumeInt(0, 9);
            if (d != 0) {
                anyNonZero = true;
            }
            sb.append((char) ('0' + d));
        }

        if (!anyNonZero) {
            sb.setCharAt(sb.length() - 1, '1');
        }
        return sb.toString();
    }

    private static String padWithTrailingFractionZeros(String decimal, int zeros) {
        StringBuilder sb = new StringBuilder(decimal);
        for (int i = 0; i < zeros; i++) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static String buildValidScientific(FuzzedDataProvider data, boolean upper) {
        String base = buildValidDecimal(data);
        StringBuilder sb = new StringBuilder(base);
        sb.append(upper ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        int expLen = data.consumeInt(1, 3);
        boolean nonZero = false;
        for (int i = 0; i < expLen; i++) {
            int d = data.consumeInt(0, 9);
            if (i == expLen - 1 && !nonZero && d == 0) {
                d = 1;
            }
            if (d != 0) {
                nonZero = true;
            }
            sb.append((char) ('0' + d));
        }
        return sb.toString();
    }

    private static String flipExponentMarkerCase(String s) {
        int e = s.indexOf('e');
        if (e >= 0) {
            return s.substring(0, e) + 'E' + s.substring(e + 1);
        }
        e = s.indexOf('E');
        if (e >= 0) {
            return s.substring(0, e) + 'e' + s.substring(e + 1);
        }
        return s;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
