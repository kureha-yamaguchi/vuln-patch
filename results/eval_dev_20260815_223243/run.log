package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchorChecks();

        char searchChar = pickLowercase(data, '\0', '\0');
        char replacementChar = pickLowercase(data, searchChar, '\0');
        char fillerChar = pickLowercase(data, searchChar, replacementChar);
        char ignoredChar = pickLowercase(data, searchChar, replacementChar);

        String activeSearch = String.valueOf(searchChar);
        String activeReplacement = String.valueOf(replacementChar);
        String ignoredSearch = String.valueOf(ignoredChar);

        StringBuilder textBuilder = new StringBuilder();
        int prefixBlocks = data.consumeInt(0, 8);
        int middleBlocks = data.consumeInt(0, 8);
        int suffixBlocks = data.consumeInt(0, 8);
        for (int i = 0; i < prefixBlocks; i++) {
            textBuilder.append(fillerChar);
        }
        textBuilder.append(activeSearch);
        for (int i = 0; i < middleBlocks; i++) {
            textBuilder.append(fillerChar).append(activeSearch);
        }
        for (int i = 0; i < suffixBlocks; i++) {
            textBuilder.append(fillerChar);
        }
        String extra = data.consumeAsciiString(12);
        for (int i = 0; i < extra.length(); i++) {
            char ch = extra.charAt(i);
            if (ch != searchChar && ch != replacementChar) {
                textBuilder.append(ch);
            } else {
                textBuilder.append(fillerChar);
            }
        }
        String text = textBuilder.toString();

        try {
            String baseline = StringUtils.replaceEach(
                    text,
                    new String[] { activeSearch },
                    new String[] { activeReplacement });

            String mixed = StringUtils.replaceEach(
                    text,
                    new String[] { ignoredSearch, activeSearch },
                    new String[] { null, activeReplacement });

            String repeatedBaseline = StringUtils.replaceEachRepeatedly(
                    text,
                    new String[] { activeSearch },
                    new String[] { activeReplacement });

            if (!baseline.equals(repeatedBaseline)) {
                throw new RuntimeException(
                        "[oracle:single-vs-repeated-acyclic] metamorphic violation: replaceEach != replaceEachRepeatedly for acyclic single-pair input text="
                                + quote(text) + " search=" + quote(activeSearch) + " repl="
                                + quote(activeReplacement) + " lhs=" + quote(baseline) + " rhs="
                                + quote(repeatedBaseline));
            }

            /*
             * Contract used: the regression test for StringUtils.replaceEach documents that
             * a null replacement element is ignored, e.g.
             * replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba" and
             * replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc".
             * Therefore adding an extra pair whose replacement is null must not change the
             * observable result. A throw-deleting patch that merely skips work, or returns the
             * input when any null is present, breaks this relation even if no exception fires.
             */
            if (!mixed.equals(baseline)) {
                throw new RuntimeException(
                        "[oracle:null-repl-ignored-order] metamorphic violation: ignored null-replacement pair changed result text="
