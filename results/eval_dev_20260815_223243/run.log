public class FuzzHarness {
    private static final int[] INDICES = {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseExactAnchor();
        } catch (Throwable t) {
            if (shouldPropagateRootCause(t, true)) {
                sneakyThrow(t);
            }
            return;
        }

        double scale = positiveScale(data);
        double tx = bounded(data);
        double ty = bounded(data);
        double tz = bounded(data);

        double v5x = 1.0 + boundedUnit(data) * 0.75;
        double v5y = 1.0 + boundedUnit(data) * 0.75;
        double v5z = 1.0 + boundedUnit(data) * 0.75;

        try {
            PolyhedronsSet base = buildClosedMesh(scale, 0.0, 0.0, 0.0, v5x, v5y, v5z);
            double sizeBase = base.getSize();
            Vector3D baryBase = base.getBarycenter();

            PolyhedronsSet translated = buildClosedMesh(scale, tx, ty, tz, v5x, v5y, v5z);
            double sizeTranslated = translated.getSize();
            Vector3D baryTranslated = translated.getBarycenter();

            /*
             * Metamorphic/post-condition:
             * For the same closed mesh translated by (tx,ty,tz), a correct geometry implementation
             * must preserve size and translate the barycenter by the same vector. This uses only
             * real library calls on two related inputs. A throw-deleting or wrong-bookkeeping patch
             * in the empty-vertices branch can silently corrupt setSize/setBarycenter and violate
             * this relation without throwing.
             */
            if (!close(sizeBase, sizeTranslated)) {
                throw new RuntimeException(
                    "[oracle:translate-size] metamorphic violation: translated mesh changed size"
                        + " base=" + sizeBase
                        + " translated=" + sizeTranslated
                        + " scale=" + scale
                        + " t=(" + tx + "," + ty + "," + tz + ")"
                        + " v5=(" + v5x + "," + v5y + "," + v5z + ")"
                );
            }

            if (!close(baryBase.getX() + tx, baryTranslated.getX())
                || !close(baryBase.getY() + ty, baryTranslated.getY())
                || !close(baryBase.getZ() + tz, baryTranslated.getZ())) {
                throw new RuntimeException(
                    "[oracle:translate-bary] metamorphic violation: barycenter did not translate"
                        + " base=(" + baryBase.getX() + "," + baryBase.getY() + "," + baryBase.getZ() + ")"
                        + " translated=(" + baryTranslated.getX() + "," + baryTranslated.getY() + "," + baryTranslated.getZ() + ")"
                        + " expected=(" + (baryBase.getX() + tx) + "," + (baryBase.getY() + ty) + "," + (baryBase.getZ() + tz) + ")"
                        + " scale=" + scale
                        + " t=(" + tx + "," + ty + "," + tz + ")"
                        + " v5=(" + v5x + "," + v5y + "," + v5z + ")"
                );
            }
        } catch (Throwable t) {
            if (isValidationFamily(t)) {
                return;
            }
            if (shouldPropagateRootCause(t, true)) {
                sneakyThrow(t);
            }
        }
    }

    private static void exerciseExactAnchor() {
        PolyhedronsSet p = buildClosedMesh(1.0, 0.0, 0.0, 0.0, 0.999999, 1.0, 1.0);
        p.getSize();
        p.getBarycenter();
    }

    private static PolyhedronsSet buildClosedMesh(
        double scale, double tx, double ty, double tz, double v5x, double v5y, double v5z) {

        Vector3D[] vertices = new Vector3D[8];
        vertices[0] = scaledTranslated( 1.0, -1.0, -1.0, scale, tx, ty, tz);
        vertices[1] = scaledTranslated( 1.0, -1.0,  1.0, scale, tx, ty, tz);
        vertices[2] = scaledTranslated(-1.0, -1.0,  1.0, scale, tx, ty, tz);
        vertices[3] = scaledTranslated(-1.0, -1.0, -1.0, scale, tx, ty, tz);
        vertices[4] = scaledTranslated( 1.0,  1.0, -1.0, scale, tx, ty, tz);
        vertices[5] = scaledTranslated(v5x,  v5y,  v5z, scale, tx, ty, tz);
        vertices[6] = scaledTranslated(-1.0,  1.0,  1.0, scale, tx, ty, tz);
        vertices[7] = scaledTranslated(-1.0,  1.0, -1.0, scale, tx, ty, tz);

        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int i = 0; i < INDICES.length; i += 3) {
            Vector3D a = vertices[INDICES[i]];
            Vector3D b = vertices[INDICES[i + 1]];
            Vector3D c = vertices[INDICES[i + 2]];

            Plane plane = new Plane(a, b, c);
            Vector2D pa = plane.toSubSpace(a);
            Vector2D pb = plane.toSubSpace(b);
            Vector2D pc = plane.toSubSpace(c);

            PolygonsSet region = new PolygonsSet(pa, pb, pc);
            facets.add(new SubPlane(plane, region));
        }

        return new PolyhedronsSet(facets);
    }

    private static Vector3D scaledTranslated(
        double x, double y, double z, double scale, double tx, double ty, double tz) {
        return new Vector3D(x * scale + tx, y * scale + ty, z * scale + tz);
    }

    private static boolean shouldPropagateRootCause(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("computeGeometricalProperties".equals(m)
                    || "getVertices".equals(m)
                    || "getTree".equals(m)
                    || "setSize".equals(m)
                    || "setBarycenter".equals(m)
                    || "getBarycenter".equals(m)
                    || "getSize".equals(m)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.geometry.euclidean.twod.Vector2D".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("getX".equals(m) || "getY".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("MathIllegal")
            || name.contains("Invalid")
            || name.contains("NoData")
            || name.contains("DimensionMismatch")
            || name.contains("OutOfRange")
            || name.contains("TooMany")
            || name.contains("NotPositive")
            || name.contains("NullArgument");
    }

    private static double positiveScale(FuzzedDataProvider data) {
        return 0.5 + (data.consumeInt(0, 2000) / 1000.0);
    }

    private static double bounded(FuzzedDataProvider data) {
        return data.consumeInt(-1000, 1000) / 100.0;
    }

    private static double boundedUnit(FuzzedDataProvider data) {
        return data.consumeInt(-1000, 1000) / 1000.0;
    }

    private static boolean close(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-7 * scale;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
