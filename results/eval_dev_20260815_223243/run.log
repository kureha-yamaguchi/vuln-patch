package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryEscapeCsv("\uD83D\uDE30", true, true);
        tryEscapeCsv("\uD800\uDC00", true, true);
        tryEscapeCsv("\uD834\uDD1E", true, true);
        tryEscapeCsv("\uDBFF\uDFFD", true, true);

        String explored = buildValidSafeCsvString(data);
        tryEscapeCsv(explored, true, true);

        String maybeInvalid = data.consumeRemainingAsString();
        tryEscapeCsv(maybeInvalid, false, false);
    }

    private static void tryEscapeCsv(String input, boolean validByConstruction, boolean assertUnchanged) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            if (assertUnchanged) {
                /*
                 * Contract/oracle: CSV escaping only needs to quote/escape fields containing CSV meta-characters
                 * (comma, double quote, CR, LF). For inputs we construct here, none of those characters occur.
                 * Therefore any correct implementation must return the original input unchanged. A "fix" that merely
                 * suppresses the crash by skipping/losing surrogate handling would violate this observable result.
                 */
                if (!input.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                            + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String n = cur.getClass().getName();
            if (n != null) {
                String ln = n.toLowerCase();
                if (ln.contains("invalid") || ln.contains("validation")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("translate".equals(m) && (
                    "org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidSafeCsvString(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();

        appendSafeAscii(sb, data.consumeAsciiString(prefixLen));

        for (int i = 0; i < pairCount; i++) {
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(codePoint)) {
                codePoint = 0x10000;
            }
            sb.append(Character.toChars(codePoint));
            appendSafeAscii(sb, data.consumeAsciiString(data.consumeInt(0, 4)));
        }

        appendSafeAscii(sb, data.consumeAsciiString(suffixLen));

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x10000));
        }
        return sb.toString();
    }

    private static void appendSafeAscii(StringBuilder sb, String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                if (c < 0x20 || c > 0x7e) {
                    sb.append('A');
                } else {
                    sb.append(c);
                }
            } else {
                sb.append('A');
            }
        }
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
