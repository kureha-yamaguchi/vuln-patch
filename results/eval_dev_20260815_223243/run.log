package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseTarget("off", true);

        String surrounding = data.consumeAsciiString(32);
        for (int i = 0; i + 3 <= surrounding.length(); i++) {
            String window = surrounding.substring(i, i + 3);
            boolean triggersPatchedRegion = window.charAt(0) != 'y' && window.charAt(0) != 'Y';
            exerciseTarget(window, triggersPatchedRegion);
        }

        String direct3 = buildThreeCharCandidate(data);
        exerciseTarget(direct3, direct3.charAt(0) != 'y' && direct3.charAt(0) != 'Y');

        String arbitrary = data.consumeString(32);
        exerciseTarget(arbitrary, false);

        String remaining = data.consumeRemainingAsString();
        if (remaining != null) {
            for (int i = 0; i + 3 <= remaining.length() && i < 16; i++) {
                String window = remaining.substring(i, i + 3);
                boolean triggersPatchedRegion = window.charAt(0) != 'y' && window.charAt(0) != 'Y';
                exerciseTarget(window, triggersPatchedRegion);
            }
        }

        /* Contract/oracle: BooleanUtils.toBoolean(String) is a case-insensitive parser for
         * the canonical true tokens handled in the real code ("true" and "yes" variants in
         * the shown implementation and failing test). If we construct a mixed-case spelling
         * of one of those literals from known characters, a correct implementation must
         * return true. A patch that merely makes the crashing branch unreachable or deletes
         * behavior could silently return false instead; this oracle catches that wrong output.
         */
        checkKnownTrueToken(buildMixedCaseToken(data, "true"));
        checkKnownTrueToken(buildMixedCaseToken(data, "yes"));
    }

    private static void exerciseTarget(String s, boolean validByConstructionForRootCause) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstructionForRootCause && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkKnownTrueToken(String token) {
        try {
            boolean parsed = BooleanUtils.toBoolean(token);
            if (!parsed) {
                throw new RuntimeException("[oracle:true-token] metamorphic violation: known true token parsed as false input=" + String.valueOf(token) + " lhs=" + parsed + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        Class<?> c = t.getClass();
        while (c != null) {
            String name = c.getName();
            String simple = c.getSimpleName();
            if (name.contains("Invalid") || name.contains("Validation")
                    || simple.contains("Invalid") || simple.contains("Validation")) {
                return true;
            }
            c = c.getSuperclass();
        }
        return false;
    }

    private static String buildThreeCharCandidate(FuzzedDataProvider data) {
        char c0 = visibleAscii(data.consumeByte());
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = visibleAscii(data.consumeByte());
        char c2 = visibleAscii(data.consumeByte());
        return new String(new char[] { c0, c1, c2 });
    }

    private static String buildMixedCaseToken(FuzzedDataProvider data, String base) {
        char[] out = base.toCharArray();
        for (int i = 0; i < out.length; i++) {
            if (data.consumeBoolean()) {
                out[i] = Character.toUpperCase(out[i]);
            } else {
                out[i] = Character.toLowerCase(out[i]);
            }
        }
        return new String(out);
    }

    private static char visibleAscii(byte b) {
        int v = b & 0xFF;
        return (char) (32 + (v % 95));
    }
}
