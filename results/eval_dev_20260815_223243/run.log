package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerBugOrCleanReject("1234.5", true);

        String base = buildValidDecimal(data);
        triggerBugOrCleanReject(base, true);
        checkExponentZeroAgreement(base);

        String suffixed = addOptionalFloatSuffix(base, data.consumeInt(0, 4));
        triggerBugOrCleanReject(suffixed, true);

        String plainInteger = buildValidInteger(data);
        triggerBugOrCleanReject(plainInteger, true);
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        String left = digitsOnly(data.consumeAsciiString(12));
        if (left.length() == 0) {
            left = Integer.toString(data.consumeInt(0, 1_000_000));
        }

        String right = digitsOnly(data.consumeAsciiString(12));
        if (right.length() == 0) {
            right = Integer.toString(data.consumeInt(0, 999_999));
        }

        String sign = data.consumeBoolean() ? "-" : "";
        return sign + left + "." + right;
    }

    private static String buildValidInteger(FuzzedDataProvider data) {
        String digits = digitsOnly(data.consumeAsciiString(18));
        if (digits.length() == 0) {
            digits = Integer.toString(data.consumeInt(-1_000_000, 1_000_000));
            if (digits.startsWith("-")) {
                return digits;
            }
            return digits;
        }
        return (data.consumeBoolean() ? "-" : "") + digits;
    }

    private static String addOptionalFloatSuffix(String s, int choice) {
        switch (choice) {
            case 1:
                return s + "D";
            case 2:
                return s + "d";
            case 3:
                return s + "F";
            case 4:
                return s + "f";
            default:
                return s;
        }
    }

    private static String digitsOnly(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static void triggerBugOrCleanReject(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
        }
    }

    private static void checkExponentZeroAgreement(String s) {
        if (s == null || s.length() == 0) {
            return;
        }

        Number plain;
        Number expZero;
        try {
            plain = NumberUtils.createNumber(s);
            plain = NumberUtils.createNumber(s);
            expZero = NumberUtils.createNumber(s + "e0");
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (plain == null || expZero == null) {
            return;
        }

        try {
            BigDecimal lhs = new BigDecimal(plain.toString());
            BigDecimal rhs = new BigDecimal(expZero.toString());
            if (lhs.compareTo(rhs) != 0) {
                throw new RuntimeException("[oracle:exp-zero-equivalence] metamorphic violation: input=" + s
                        + " plain=" + plain + " exp0=" + expZero);
            }
        } catch (NumberFormatException e) {
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof StringIndexOutOfBoundsException) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
