public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryCreateNumberValid("1234.5", true);

        String base = buildValidDecimal(data);
        tryCreateNumberValid(base, true);

        /*
         * Contract visible in NumberUtils.createNumber:
         * for an unsuffixed decimal literal with no exponent, createNumber(str) first tries
         * createFloat(str) and returns that Float when it is finite and not a misleading zero;
         * createNumber(str + "F") explicitly requests that same Float quantity.
         * Therefore both paths must agree with the helper for every such valid decimal.
         * A patch that merely suppresses the crash or corrupts mantissa bookkeeping can violate this.
         */
        try {
            Float helperFloat = NumberUtils.createFloat(base);
            if (helperFloat != null && !helperFloat.isInfinite()) {
                boolean allZeroDigits = true;
                for (int i = 0; i < base.length(); i++) {
                    char c = base.charAt(i);
                    if (c >= '1' && c <= '9') {
                        allZeroDigits = false;
                        break;
                    }
                }
                if (!(helperFloat.floatValue() == 0.0F && !allZeroDigits)) {
                    Number plain = NumberUtils.createNumber(base);
                    Number suffixed = NumberUtils.createNumber(base + "F");
                    if (plain != null && suffixed != null) {
                        int helperBits = Float.floatToIntBits(helperFloat.floatValue());
                        int plainBits = Float.floatToIntBits(plain.floatValue());
                        int suffixedBits = Float.floatToIntBits(suffixed.floatValue());
                        if (helperBits != plainBits || helperBits != suffixedBits) {
                            throw new RuntimeException("[oracle:float-helper-agreement] metamorphic violation: input="
                                    + base + " helper=" + helperFloat + " plain=" + plain + " suffixed=" + suffixed);
                        }
                    }
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRelevantRootCause(t) && isValidConstructedDecimal(base)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        /*
         * Second consistency check from the same public API family:
         * createNumber(str + "D") explicitly requests the same quantity parsed by createDouble(str).
         * For any correct implementation, these two real-library paths must agree.
         */
        try {
            Double helperDouble = NumberUtils.createDouble(base);
            if (helperDouble != null && !helperDouble.isInfinite() && !helperDouble.isNaN()) {
                Number dSuffixed = NumberUtils.createNumber(base + "D");
                if (dSuffixed != null) {
                    long helperBits = Double.doubleToLongBits(helperDouble.doubleValue());
                    long suffixedBits = Double.doubleToLongBits(dSuffixed.doubleValue());
                    if (helperBits != suffixedBits) {
                        throw new RuntimeException("[oracle:double-helper-agreement] metamorphic violation: input="
                                + base + " helper=" + helperDouble + " suffixed=" + dSuffixed);
                    }
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRelevantRootCause(t) && isValidConstructedDecimal(base)) {
                throw t;
            }
        }
    }
