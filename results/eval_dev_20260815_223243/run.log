package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callToBoolean("off", true);

        String base = data.consumeAsciiString(32);
        for (int i = 0; i < 4; i++) {
            String candidate = buildThreeCharNonYesToken(base, data, i);
            Boolean result = callToBoolean(candidate, true);
            if (result != null && result.booleanValue()) {
                throw new RuntimeException("[oracle:false-token] metamorphic violation: unrecognized 3-char token must parse as false input=" + printable(candidate) + " lhs=true rhs=false");
            }

            String upper = candidate.toUpperCase();
            Boolean lhs = callToBoolean(candidate, true);
            Boolean rhs = callToBoolean(upper, true);
            if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
                throw new RuntimeException("[oracle:case-agree] metamorphic violation: case variants of an unrecognized token must agree input=" + printable(candidate) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != null && rhs != null && (lhs.booleanValue() || rhs.booleanValue())) {
                throw new RuntimeException("[oracle:case-false] metamorphic violation: unrecognized 3-char token and its case variant must both be false input=" + printable(candidate) + " lhs=" + lhs + " rhs=" + rhs);
            }
        }

        String[] trueTokens = new String[] { "true", "on", "yes" };
        String token = trueTokens[Math.abs(data.consumeInt()) % trueTokens.length];
        String variant = randomCase(token, data);

        Boolean a = callToBoolean(variant, true);
        Boolean b = callToBoolean(token.toUpperCase(), true);
        if (a != null && b != null) {
            if (a.booleanValue() != b.booleanValue()) {
                throw new RuntimeException("[oracle:true-case] metamorphic violation: documented case-insensitive true tokens must agree across case variants input=" + printable(variant) + " lhs=" + a + " rhs=" + b);
            }
            if (!a.booleanValue()) {
                throw new RuntimeException("[oracle:true-value] metamorphic violation: documented true token parsed as false input=" + printable(variant) + " lhs=" + a + " rhs=true");
            }
        }
    }

    private static Boolean callToBoolean(String s, boolean validByConstruction) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] frames = t.getStackTrace();
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(f.getClassName())
                    && "toBoolean".equals(f.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildThreeCharNonYesToken(String base, FuzzedDataProvider data, int round) {
        char c0;
        char c1;
        char c2;

        if (base != null && base.length() >= 3) {
            int maxStart = base.length() - 3;
            int start = maxStart > 0 ? data.consumeInt(0, maxStart) : 0;
            c0 = base.charAt(start);
            c1 = base.charAt(start + 1);
            c2 = base.charAt(start + 2);
        } else {
            String extra = data.consumeAsciiString(3);
            c0 = extra.length() > 0 ? extra.charAt(0) : (char) ('a' + (round % 26));
            c1 = extra.length() > 1 ? extra.charAt(1) : (char) ('b' + (round % 25));
            c2 = extra.length() > 2 ? extra.charAt(2) : (char) ('c' + (round % 24));
        }

        if (c0 == 'y' || c0 == 'Y') {
            c0 = (round & 1) == 0 ? 'o' : 'a';
        }
        return new String(new char[] { c0, c1, c2 });
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        char[] out = s.toCharArray();
        for (int i = 0; i < out.length; i++) {
            out[i] = data.consumeBoolean() ? Character.toUpperCase(out[i]) : Character.toLowerCase(out[i]);
        }
        return new String(out);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
