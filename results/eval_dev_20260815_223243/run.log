package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerBugOrCleanReject("1eE");

        String candidate = buildBothExponentMarkersInput(data);
        triggerBugOrCleanReject(candidate);

        checkIntAgreesWithCreateInteger(Integer.toString(data.consumeInt(-1_000_000, 1_000_000)));
        checkDecimalAgreesWithCreateFloat(buildModerateDecimal(data));
        checkLongSuffixAgreement(data);
        checkBigIntegerFallbackAgreement(data);
    }

    private static void triggerBugOrCleanReject(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildBothExponentMarkersInput(FuzzedDataProvider data) {
        String leftDigits = nonEmptyDigits(data.consumeInt(1, 6), data);
        String middle = data.consumeBoolean() ? "e" : "E";
        String right = data.consumeBoolean() ? "E" : "e";

        int suffixMode = data.consumeInt(0, 4);
        if (suffixMode == 0) {
            return leftDigits + middle + right;
        }
        if (suffixMode == 1) {
            return leftDigits + middle + right + nonEmptyDigits(data.consumeInt(1, 3), data);
        }
        if (suffixMode == 2) {
            return "-" + leftDigits + middle + right;
        }
        if (suffixMode == 3) {
            return leftDigits + middle + nonEmptyDigits(data.consumeInt(1, 2), data) + right;
        }
        return leftDigits + right + middle;
    }

    private static String nonEmptyDigits(int len, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                return true;
            }
            if ("java.lang.String".equals(cls) && "substring".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static void checkIntAgreesWithCreateInteger(String s) {
        Integer viaInt;
        try {
            viaInt = NumberUtils.createInteger(s);
        } catch (RuntimeException t) {
            return;
        }

        Number viaNumber;
        try {
            viaNumber = NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (!(viaNumber instanceof Integer) || viaNumber.intValue() != viaInt.intValue()) {
            throw new RuntimeException(
                    "[oracle:int-helper] metamorphic violation: createNumber disagrees with createInteger input="
                            + s + " lhs=" + viaNumber + " rhs=" + viaInt);
