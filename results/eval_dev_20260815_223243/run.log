package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain-" + data.consumeAsciiString(4),
                    "range-" + data.consumeAsciiString(4),
                    Day.class);

            int baseDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int gapSize = data.consumeInt(2, 60);

            int leftEpochDay = baseDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    addValue(series, dayFromEpochDay(leftEpochDay - i), data.consumeInt(-1000, 1000));
                }
                addValue(series, dayFromEpochDay(leftEpochDay), data.consumeInt(-1000, 1000));
                addValue(series, dayFromEpochDay(rightEpochDay), data.consumeInt(-1000, 1000));
                for (int i = 1; i <= afterCount; i++) {
                    addValue(series, dayFromEpochDay(rightEpochDay + i), data.consumeInt(-1000, 1000));
                }
            } catch (RuntimeException e) {
                return;
            }

            if (series.getItemCount() != series.getItems().size()) {
                throw new RuntimeException("[oracle:src-view-count] metamorphic violation: source count disagrees with items view count="
                        + series.getItemCount() + " view=" + series.getItems().size());
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            if (start.compareTo(end) > 0) {
                throw new RuntimeException("[oracle:constructed-order-days] metamorphic violation: constructed valid range became inverted start="
                        + start + " end=" + end);
            }

            int manual = countItemsInRange(series, start, end);
            if (manual != 0) {
                throw new RuntimeException("[oracle:manual-gap-zero] metamorphic violation: constructed gap is not empty manual="
                        + manual + " start=" + start + " end=" + end);
            }

