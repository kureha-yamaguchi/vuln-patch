package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int rounds = data.consumeInt(1, 8);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpochDay - i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(dayFromEpochDay(leftEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(dayFromEpochDay(rightEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(dayFromEpochDay(rightEpochDay + i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                return;
            }

            if (series.getItemCount() != series.getItems().size()
                    || series.getItemCount() != series.getTimePeriods().size()) {
                throw new RuntimeException("[oracle:series-view-size] metamorphic violation: source views disagree"
                        + " itemCount=" + series.getItemCount()
                        + " itemsSize=" + series.getItems().size()
                        + " periodsSize=" + series.getTimePeriods().size());
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            if (start.compareTo(end) > 0) {
                return;
            }

            int manualCount = 0;
            for (int i = 0; i < series.getItemCount(); i++) {
                RegularTimePeriod p = series.getTimePeriod(i);
                if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                    manualCount++;
                }
                if (series.getIndex(p) != i) {
                    throw new RuntimeException("[oracle:series-period-index] metamorphic violation: getIndex(getTimePeriod(i)) must round-trip"
                            + " index=" + i
                            + " roundTrip=" + series.getIndex(p)
                            + " period=" + p);
                }
            }
            if (manualCount != 0) {
                throw new RuntimeException("[oracle:constructed-gap-empty] metamorphic violation: constructed interior gap range must be empty"
                        + " manualCount=" + manualCount
                        + " start=" + start
                        + " end=" + end);
            }

            int rawStart = series.getIndex(start);
            int rawEnd = series.getIndex(end);
            if (rawStart >= 0 || rawEnd >= 0) {
                return;
            }

            int insertionStart = -(rawStart + 1);
            int insertionEnd = -(rawEnd + 1);

            if (insertionStart != insertionEnd) {
                throw new RuntimeException("[oracle:gap-insertionpoint] metamorphic violation: two absent periods inside one gap must share the same insertion point"
                        + " rawStart=" + rawStart
                        + " rawEnd=" + rawEnd
                        + " insertionStart=" + insertionStart
                        + " insertionEnd=" + insertionEnd
                        + " start=" + start
                        + " end=" + end);
            }
            if (insertionStart <= 0 || insertionStart >= series.getItemCount()) {
                throw new RuntimeException("[oracle:gap-insertionpoint-bounds] metamorphic violation: chosen absent gap must be interior to the series"
                        + " insertionPoint=" + insertionStart
                        + " itemCount=" + series.getItemCount()
                        + " start=" + start
                        + " end=" + end);
            }

            try {
                /* Contract asserted here:
                   createCopy(start,end) includes all items with periods in [start,end].
                   For two absent periods chosen strictly inside one existing gap, that set is empty.
                   A throw-deleting or overfit patch could avoid the original exception but still return
                   the wrong non-empty slice, so we assert the returned copy is observably empty. */
                TimeSeries copy = series.createCopy(start, end);

                if (copy.getItemCount() != 0
                        || copy.getItems().size() != 0
                        || copy.getTimePeriods().size() != 0) {
                    throw new RuntimeException("[oracle:interior-gap-copy-empty] metamorphic violation: createCopy over an interior empty gap must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " itemsSize=" + copy.getItems().size()
                            + " periodsSize=" + copy.getTimePeriods().size()
                            + " start=" + start
                            + " end=" + end
                            + " rawStart=" + rawStart
                            + " rawEnd=" + rawEnd);
                }

                if (copy.getTimePeriodClass() != series.getTimePeriodClass()) {
                    throw new RuntimeException("[oracle:copy-timeperiodclass] metamorphic violation: createCopy must preserve the time period class"
                            + " sourceClass=" + series.getTimePeriodClass()
                            + " copyClass=" + copy.getTimePeriodClass());
                }

                int chosenIndex = data.consumeBoolean() ? insertionStart - 1 : insertionStart;
                RegularTimePeriod exact = series.getTimePeriod(chosenIndex);
                TimeSeries singleton = series.createCopy(exact, exact);

                if (singleton.getItemCount() != 1) {
                    throw new RuntimeException("[oracle:singleton-size] metamorphic violation: copying an exact existing boundary period must yield a singleton"
                            + " chosenIndex=" + chosenIndex
                            + " exact=" + exact
                            + " singletonCount=" + singleton.getItemCount());
                }

                TimeSeriesDataItem byIndex = singleton.getDataItem(0);
                TimeSeriesDataItem byPeriod = singleton.getDataItem(exact);
                if (byPeriod == null
                        || !byIndex.getPeriod().equals(byPeriod.getPeriod())
                        || (byIndex.getValue() == null ? byPeriod.getValue() != null
                                : !byIndex.getValue().equals(byPeriod.getValue()))) {
                    throw new RuntimeException("[oracle:copy-dataitem-overload] metamorphic violation: getDataItem(index) and getDataItem(period) must agree on the copied singleton"
                            + " exact=" + exact
                            + " byIndexPeriod=" + byIndex.getPeriod()
                            + " byPeriodPeriod=" + (byPeriod == null ? "null" : String.valueOf(byPeriod.getPeriod()))
                            + " byIndexValue=" + byIndex.getValue()
                            + " byPeriodValue=" + (byPeriod == null ? "null" : String.valueOf(byPeriod.getValue())));
                }

                Number valueByIndex = singleton.getValue(0);
                Number valueByPeriod = singleton.getValue(exact);
                if (valueByIndex == null ? valueByPeriod != null : !valueByIndex.equals(valueByPeriod)) {
                    throw new RuntimeException("[oracle:copy-value-overload] metamorphic violation: getValue(index) and getValue(period) must agree on the copied singleton"
                            + " exact=" + exact
                            + " byIndex=" + valueByIndex
                            + " byPeriod=" + valueByPeriod);
                }

                if (singleton.getIndex(exact) != 0) {
                    throw new RuntimeException("[oracle:copy-index-roundtrip] metamorphic violation: copied singleton must map its only period back to index 0"
                            + " exact=" + exact
                            + " index=" + singleton.getIndex(exact));
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:valid-gap-reject] metamorphic violation: valid-by-construction interior-gap createCopy must not reject"
                            + " start=" + start
                            + " end=" + end
                            + " rawStart=" + rawStart
                            + " rawEnd=" + rawEnd, e);
                }
                return;
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), Integer.valueOf(1));
            s.add(new Day(31, 1, 2006), Integer.valueOf(1));

            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);

            int rawStart = s.getIndex(start);
            int rawEnd = s.getIndex(end);
            int insertionStart = -(rawStart + 1);
            int insertionEnd = -(rawEnd + 1);

            if (rawStart >= 0 || rawEnd >= 0 || insertionStart != insertionEnd) {
                throw new RuntimeException("[oracle:anchor-gap-shape] metamorphic violation: anchor inputs must lie in the same absent interior gap"
                        + " rawStart=" + rawStart
                        + " rawEnd=" + rawEnd
                        + " insertionStart=" + insertionStart
                        + " insertionEnd=" + insertionEnd);
            }

            TimeSeries copy = s.createCopy(start, end);

            if (copy.getItemCount() != 0
                    || copy.getItems().size() != 0
                    || copy.getTimePeriods().size() != 0) {
                throw new RuntimeException("[oracle:anchor-empty-copy] metamorphic violation: anchored empty-gap copy must be empty"
                        + " itemCount=" + copy.getItemCount()
                        + " itemsSize=" + copy.getItems().size()
                        + " periodsSize=" + copy.getTimePeriods().size());
            }

            if (copy.getTimePeriodClass() != s.getTimePeriodClass()) {
                throw new RuntimeException("[oracle:anchor-copy-class] metamorphic violation: createCopy must preserve time period class on anchor input"
                        + " sourceClass=" + s.getTimePeriodClass()
                        + " copyClass=" + copy.getTimePeriodClass());
