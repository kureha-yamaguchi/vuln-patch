public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokePossiblyBuggy("1eE");

        String malformed = buildMalformedDualExponentInput(data);
        invokePossiblyBuggy(malformed);

        String valid = buildValidDecimal(data);
        checkExponentZeroAgreement(valid);
    }

    private static void invokePossiblyBuggy(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (IllegalArgumentException ignored) {
            return;
        }
    }

    private static String buildMalformedDualExponentInput(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(1, 8);
        int middleLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, prefixLen - 1);

        StringBuilder sb = new StringBuilder(prefixLen + middleLen + suffixLen + 2);
        appendDigits(sb, data, prefixLen);
        sb.append('e');
        appendDigits(sb, data, middleLen);
        sb.append('E');
        appendDigits(sb, data, suffixLen);
        return sb.toString();
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        int leftLen = data.consumeInt(1, 8);
        int rightLen = data.consumeInt(1, 8);

        StringBuilder sb = new StringBuilder(leftLen + rightLen + 2);
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        appendDigits(sb, data, leftLen);
        sb.append('.');
        appendDigits(sb, data, rightLen);
        return sb.toString();
    }

    private static void appendDigits(StringBuilder sb, FuzzedDataProvider data, int count) {
        for (int i = 0; i < count; i++) {
            int d = data.consumeInt(0, 9);
            sb.append((char) ('0' + d));
        }
    }

    private static void checkExponentZeroAgreement(String s) {
        Number plain;
        Number expZero;
        try {
            plain = NumberUtils.createNumber(s);
            expZero = NumberUtils.createNumber(s + "e0");
        } catch (RuntimeException ignored) {
            return;
        }

        if (plain == null || expZero == null) {
            return;
        }

        try {
            BigDecimal lhs = new BigDecimal(plain.toString());
            BigDecimal rhs = new BigDecimal(expZero.toString());
            if (lhs.compareTo(rhs) != 0) {
                throw new RuntimeException("[oracle:exp-zero-equivalence] metamorphic violation: input=" + s
                        + " plain=" + plain + " exp0=" + expZero);
            }
        } catch (RuntimeException ignored) {
            return;
        }
    }
}
