package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true, true);
        }

        String prefix = filterCsvSafe(data.consumeAsciiString(16));
        String suffix = filterCsvSafe(data.consumeAsciiString(16));

        int pairCount = data.consumeInt(1, 3);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp) || Character.isSurrogate((char) cp)) {
                cp = 0x10000;
            }
            middle.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                middle.append(filterCsvSafe(data.consumeAsciiString(8)));
            }
        }

        String candidate = prefix + middle.toString() + suffix;
        exerciseEscapeCsv(candidate, true, true);

        if (candidate.length() > 2) {
            int split = data.consumeInt(1, candidate.length() - 1);
            String left = candidate.substring(0, split);
            String right = candidate.substring(split);
            String whole;
            String lhs;
            String rhs;
            try {
                whole = StringEscapeUtils.escapeCsv(candidate);
                lhs = StringEscapeUtils.escapeCsv(left);
                rhs = StringEscapeUtils.escapeCsv(right);
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
            /* Contract used for this oracle: for inputs containing no CSV-special characters
             * (comma, quote, CR, LF), escapeCsv returns the input unchanged. We construct
             * left/right/candidate from CSV-safe ASCII plus valid supplementary code points,
             * so both sides must equal the original concatenation; a patch that only suppresses
             * the throw or skips processing of surrogate pairs would violate this observable.
             */
            if (!whole.equals(lhs + rhs)) {
                throw new RuntimeException("[oracle:split-safe] metamorphic violation: escapeCsv(a+b) == escapeCsv(a)+escapeCsv(b) for CSV-safe inputs input=" + printable(candidate) + " lhs=" + printable(whole) + " rhs=" + printable(lhs + rhs));
            }
        }
    }

    private static void exerciseEscapeCsv(String input, boolean validByConstruction, boolean expectIdentity) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            /* Contract used for this oracle: if the CSV input contains no comma, quote, CR, or LF,
             * escapeCsv leaves it unchanged. We build only such inputs, with well-formed surrogate
             * pairs via Character.toChars, so any correct implementation must return the same string.
             */
            if (expectIdentity && !input.equals(out)) {
                throw new RuntimeException("[oracle:identity-safe] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (IllegalArgumentException e) {
            if (!validByConstruction) {
                return;
            }
        } catch (RuntimeException e) {
            if (validByConstruction && isRootCause(e)) {
                throw e;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method) && (
                    "org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls) ||
                    "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String filterCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }
}
