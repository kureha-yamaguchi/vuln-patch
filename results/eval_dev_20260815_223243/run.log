                addValue(series, dayFromEpochDay(rightEpochDay), data.consumeInt(-1000, 1000));
                for (int i = 1; i <= afterCount; i++) {
                    addValue(series, dayFromEpochDay(rightEpochDay + i), data.consumeInt(-1000, 1000));
