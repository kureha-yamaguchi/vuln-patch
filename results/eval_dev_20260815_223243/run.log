        }
        String numeric = s.substring(0, s.length() - 1);
        if (numeric.length() == 0 || "-".equals(numeric) || ".".equals(numeric) || "-.".equals(numeric)) {
            return true;
        }
        for (int i = 0; i < numeric.length(); i++) {
            char c = numeric.charAt(i);
            if (i == 0 && c == '-') {
                continue;
            }
            if (c == '.' || c == 'e' || c == 'E') {
                return true;
            }
        }
        return !allDigitsOrLeadingMinus(numeric);
    }

    private static boolean allDigitsOrLeadingMinus(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = 0;
        if (s.charAt(0) == '-') {
            start = 1;
        }
        if (start >= s.length()) {
            return false;
        }
        for (int i = start; i < s.length(); i++) {
            if (!Character.isDigit(s.charAt(i))) {
                return false;
            }
        }
        return true;
    }

    private static boolean isValidSignedDecimalWithLongSuffix(String s) {
        if (s == null || s.length() < 2) {
            return false;
        }
        char last = s.charAt(s.length() - 1);
