public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int baseSerial = data.consumeInt(730000, 732000);
            int beforeCount = data.consumeInt(0, 4);
            int afterCount = data.consumeInt(0, 4);
            int gapSize = data.consumeInt(2, 40);

            int leftSerial = baseSerial + beforeCount;
            int rightSerial = leftSerial + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    addValue(series, dayFromSerial(leftSerial - i), data.consumeInt(-1000, 1000));
                }

                Day left = dayFromSerial(leftSerial);
                Day right = dayFromSerial(rightSerial);
                addValue(series, left, data.consumeInt(-1000, 1000));
                addValue(series, right, data.consumeInt(-1000, 1000));

                for (int i = 1; i <= afterCount; i++) {
                    addValue(series, dayFromSerial(rightSerial + i), data.consumeInt(-1000, 1000));
                }
            } catch (RuntimeException e) {
                return;
            }

            if (series.getItemCount() != series.getItems().size()) {
                throw new RuntimeException("[oracle:src-count] metamorphic violation: source count mismatch itemCount="
                        + series.getItemCount() + " itemsSize=" + series.getItems().size());
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromSerial(leftSerial + startOffset);
            Day end = dayFromSerial(leftSerial + endOffset);

            int manualCount = countItemsInRange(series, start, end);
            if (manualCount != 0) {
                throw new RuntimeException("[oracle:gap-setup] metamorphic violation: constructed gap should be empty but manualCount="
                        + manualCount + " start=" + start + " end=" + end);
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                // Contract/invariant used for this post-condition:
                // constructor and copy creation store items in the shared 'data' list,
                // so getItemCount() must agree with getItems().size() for every correct implementation.
                if (copy.getItemCount() != copy.getItems().size()) {
                    throw new RuntimeException("[oracle:copy-count] metamorphic violation: copy count mismatch itemCount="
                            + copy.getItemCount() + " itemsSize=" + copy.getItems().size()
                            + " start=" + start + " end=" + end);
                }

                // Metamorphic relation:
                // createCopy(start,end) should contain exactly the items from the source whose
                // periods lie within [start,end]. Recompute that count from the copy's own output.
                int copyManualCount = countItemsInRange(copy, start, end);
                if (copy.getItemCount() != manualCount || copyManualCount != manualCount) {
                    throw new RuntimeException("[oracle:empty-gap-copy] metamorphic violation: empty-range createCopy disagrees with source "
                            + "sourceManual=" + manualCount
                            + " copyItemCount=" + copy.getItemCount()
                            + " copyManual=" + copyManualCount
                            + " start=" + start + " end=" + end
                            + " sourceSize=" + series.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }

            try {
                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);

                if (byPeriod.getItemCount() != byIndex.getItemCount()
                        || byPeriod.getItems().size() != byIndex.getItems().size()) {
                    throw new RuntimeException("[oracle:overload-agree] metamorphic violation: createCopy overloads disagree at index="
                            + chosen + " byPeriodCount=" + byPeriod.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }
