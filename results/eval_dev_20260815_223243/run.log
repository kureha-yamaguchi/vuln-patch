package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runValidEscapeCsvCase("\uD83D\uDE30");
        runValidEscapeCsvCase("\uD800\uDC00");
        runValidEscapeCsvCase("\uD834\uDD1E");
        runValidEscapeCsvCase("\uDBFF\uDFFD");

        String s = buildValidByConstructionInput(data);
        runValidEscapeCsvCase(s);
    }

    private static String buildValidByConstructionInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixLen = data.consumeInt(0, 8);
        for (int i = 0; i < prefixLen; i++) {
            sb.append(safeAsciiChar(data));
        }

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                int supplementary = data.consumeInt(0x10000, 0x10FFFF);
                sb.append(Character.toChars(supplementary));
            } else {
                char high = (char) data.consumeInt(0xD800, 0xDBFF);
                char low = (char) data.consumeInt(0xDC00, 0xDFFF);
                sb.append(high).append(low);
            }

            int betweenLen = data.consumeInt(0, 4);
            for (int j = 0; j < betweenLen; j++) {
                sb.append(safeAsciiChar(data));
            }
        }

        int suffixLen = data.consumeInt(0, 8);
        for (int i = 0; i < suffixLen; i++) {
            sb.append(safeAsciiChar(data));
        }

        if (sb.length() == 0) {
            sb.append('a').append("\uD83D\uDE30").append('b');
        }
        return sb.toString();
    }

    private static char safeAsciiChar(FuzzedDataProvider data) {
        while (true) {
            char c = (char) data.consumeInt(0x20, 0x7E);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                return c;
            }
        }
    }

    private static void runValidEscapeCsvCase(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve strings with no CSV special chars input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }

            try {
                String escapedTwice = StringEscapeUtils.escapeCsv(escaped);
                if (!escaped.equals(escapedTwice)) {
                    throw new RuntimeException(
                        "[oracle:csv-idempotent-safe] metamorphic violation: for already-safe strings, repeated escapeCsv must be stable input="
                            + printable(input) + " lhs=" + printable(escapedTwice) + " rhs=" + printable(escaped));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw propagate(t);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation") || name.contains("invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException propagate(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
