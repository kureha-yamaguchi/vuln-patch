                Day left = dayFromEpochDay(leftEpochDay);
                Day right = dayFromEpochDay(rightEpochDay);
                addValue(series, left, data.consumeInt(-1000, 1000));
                addValue(series, right, data.consumeInt(-1000, 1000));

                for (int i = 1; i <= afterCount; i++) {
                    Day d = dayFromEpochDay(rightEpochDay + i);
                    addValue(series, d, data.consumeInt(-1000, 1000));
