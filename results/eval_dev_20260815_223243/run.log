<xref>
public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            try {
                NumberUtils.createNumber(anchor[i]);
            } catch (IllegalArgumentException e) {
                // Fixed behavior: clean rejection for malformed inputs.
                // Buggy behavior for "l"/"L" leaks StringIndexOutOfBoundsException, which is not caught.
            }
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 7)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = data.consumeBoolean() ? "f" : "F";
                    break;
                case 2:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "." + (char) ('0' + data.consumeInt(0, 9)) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = "-" + (char) ('0' + data.consumeInt(0, 9)) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            try {
                NumberUtils.createNumber(probe);
            } catch (IllegalArgumentException e) {
                // Clean rejection is acceptable. Any other RuntimeException escapes.
            }
        }

        // Metamorphic oracle:
        // For a valid decimal integer string n, createNumber(n + "L") must agree with createLong(n).
        int digit = data.consumeInt(0, 9);
        String signed = data.consumeBoolean() ? ("-" + digit) : String.valueOf(digit);
        String suffixed = signed + (data.consumeBoolean() ? "L" : "l");
        Number parsed = NumberUtils.createNumber(suffixed);
        Long expectedLong = NumberUtils.createLong(signed);
        if (parsed == null || parsed.longValue() != expectedLong.longValue()) {
            throw new RuntimeException(
                    "[oracle:signed-decimal-long-suffix] metamorphic violation: createNumber(decimal+L) must equal createLong(decimal) input="
                            + suffixed + " lhs=" + parsed + " rhs=" + expectedLong);
        }

        // Independent oracle in a different reachable helper: valid decimal overflow with L/l
        // must fall back from createLong to createBigInteger and preserve value.
        StringBuilder big = new StringBuilder();
        if (data.consumeBoolean()) {
            big.append('-');
        }
        big.append((char) ('1' + data.consumeInt(0, 8)));
        int extraDigits = data.consumeInt(19, 50);
        for (int i = 0; i < extraDigits; i++) {
            big.append((char) ('0' + data.consumeInt(0, 9)));
        }
        String bigDigits = big.toString();
        String bigWithSuffix = bigDigits + (data.consumeBoolean() ? "L" : "l");
        Number lhs = NumberUtils.createNumber(bigWithSuffix);
        BigInteger rhs = NumberUtils.createBigInteger(bigDigits);
        if (!(lhs instanceof BigInteger) || !rhs.equals(lhs)) {
            throw new RuntimeException(
                    "[oracle:negative-overflow-bigint] metamorphic violation: createNumber(overflow-decimal+L) must equal createBigInteger(decimal) input="
                            + bigWithSuffix + " lhs=" + lhs + " rhs=" + rhs);
        }
    }
