package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String explored = buildValidSafeCsvInput(data);
        if (explored != null) {
            runOracleIdentity(explored);

            String left = buildValidSafeCsvInput(data);
            String right = buildValidSafeCsvInput(data);
            if (left != null && right != null && left.length() > 0 && right.length() > 0) {
                runOracleComposition(left, right);
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:anchor-identity] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            handleThrowable(t, true);
        }
    }

    private static void runOracleIdentity(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            /*
             * Contract asserted: CSV escaping only adds quoting/escaping for CSV-special content.
             * This input is built by construction to contain no comma, quote, CR, or LF, so a
             * correct implementation must return it unchanged. A "fix" that merely avoids the crash
             * by skipping characters or otherwise corrupting traversal breaks this observable result.
             */
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:identity-safe] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            handleThrowable(t, true);
        }
    }

    private static void runOracleComposition(String a, String b) {
        String lhs;
        String ea;
        String eb;
        try {
            lhs = StringEscapeUtils.escapeCsv(a + b);
        } catch (Throwable t) {
            handleThrowable(t, true);
            return;
        }
        try {
            ea = StringEscapeUtils.escapeCsv(a);
        } catch (Throwable t) {
            handleThrowable(t, true);
            return;
        }
        try {
            eb = StringEscapeUtils.escapeCsv(b);
        } catch (Throwable t) {
            handleThrowable(t, true);
            return;
        }

        /*
         * Contract asserted: for inputs that are individually CSV-safe and contain no CSV-special
         * characters, each side must be returned unchanged; therefore escaping a concatenation of
         * two such strings must equal the concatenation of the escaped parts. This catches silent
         * truncation/skipping even if no exception is thrown.
         */
        String rhs = ea + eb;
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:concat-safe] metamorphic violation: escapeCsv(a+b) must equal escapeCsv(a)+escapeCsv(b) for CSV-safe parts input=" + printable(a + b) + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
        }
    }

    private static String buildValidSafeCsvInput(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();
        appendSafeAscii(sb, data, prefixLen);
        for (int i = 0; i < pairCount; i++) {
            sb.append(validSupplementaryChar(data));
            appendSafeAscii(sb, data, data.consumeInt(0, 4));
        }
        appendSafeAscii(sb, data, suffixLen);

        String s = sb.toString();
        return s.length() == 0 ? null : s;
    }

    private static void appendSafeAscii(StringBuilder sb, FuzzedDataProvider data, int len) {
        for (int i = 0; i < len; i++) {
            sb.append(safeAsciiChar(data));
        }
    }

    private static char safeAsciiChar(FuzzedDataProvider data) {
        while (true) {
            char c = (char) data.consumeInt(0x20, 0x7e);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                return c;
            }
        }
    }

    private static String validSupplementaryChar(FuzzedDataProvider data) {
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        return new String(Character.toChars(cp));
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (isCleanRejection(t)) {
            return;
        }
        if (validByConstruction && isRootCause(t)) {
            sneakyThrow(t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation") || name.contains("invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\r", "\\r").replace("\n", "\\n");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
