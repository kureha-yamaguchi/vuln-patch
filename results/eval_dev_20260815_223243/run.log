package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String[] baseSearch = buildActiveSearches(data);
        String[] baseReplacement = buildReplacements(data, baseSearch.length);

        String prefix = data.consumeAsciiString(8);
        String middle = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);
        String text = prefix + baseSearch[0] + middle;
        if (baseSearch.length > 1 && data.consumeBoolean()) {
            text += baseSearch[1];
        }
        text += suffix;

        checkInertPairAugmentation(text, baseSearch, baseReplacement, data);
        checkSplitComposition(baseSearch, baseReplacement, data);
    }

    private static void runAnchorCases() {
        expectReplaceEach("anchor-null-text", null, null, new String[] { "a" }, new String[] { "b" });
        expectReplaceEach("anchor-empty-string", "", "", new String[] { "a" }, new String[] { "b" });
        expectReplaceEach("anchor-null-arrays-1", "aba", "aba", null, null);
        expectReplaceEach("anchor-empty-search-array", "aba", "aba", new String[0], null);
        expectReplaceEach("anchor-empty-repl-array", "aba", "aba", null, new String[0]);
        expectReplaceEach("anchor-null-replacement-array", "aba", "aba", new String[] { "a" }, null);
        expectReplaceEach("anchor-empty-replacement", "b", "aba", new String[] { "a" }, new String[] { "" });
        expectReplaceEach("anchor-null-search-element", "aba", "aba", new String[] { null }, new String[] { "a" });
        expectReplaceEach("anchor-null-replacement-element", "aba", "aba", new String[] { "a" }, new String[] { null });
        expectReplaceEach("anchor-mixed-null-replacement", "cbc", "aba",
                new String[] { "a", "b" }, new String[] { "c", null });
    }

    private static void expectReplaceEach(String id, String expected, String text, String[] search, String[] replacement) {
        final String actual;
        try {
            actual = StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
        if (expected == null ? actual != null : !expected.equals(actual)) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: documented replaceEach example input="
                    + describe(text, search, replacement) + " expected=" + expected + " actual=" + actual);
        }
    }

    private static void checkInertPairAugmentation(String text, String[] baseSearch, String[] baseReplacement,
            FuzzedDataProvider data) {
        int baseLen = baseSearch.length;
        int insertAt = data.consumeInt(0, baseLen);
        String[] augmentedSearch = new String[baseLen + 1];
        String[] augmentedReplacement = new String[baseLen + 1];

        for (int i = 0, j = 0; i < augmentedSearch.length; i++) {
            if (i == insertAt) {
                int mode = data.consumeInt(0, 2);
                if (mode == 0) {
                    augmentedSearch[i] = null;
                    augmentedReplacement[i] = sanitizedReplacement(data.consumeAsciiString(6));
                } else if (mode == 1) {
                    augmentedSearch[i] = "";
                    augmentedReplacement[i] = sanitizedReplacement(data.consumeAsciiString(6));
                } else {
                    augmentedSearch[i] = cleanSearchToken(data.consumeAsciiString(4), "q");
                    augmentedReplacement[i] = null;
                }
            } else {
                augmentedSearch[i] = baseSearch[j];
                augmentedReplacement[i] = baseReplacement[j];
                j++;
            }
        }

        final String baseResult;
        final String augmentedResult;
        try {
            baseResult = StringUtils.replaceEach(text, baseSearch, baseReplacement);
            augmentedResult = StringUtils.replaceEach(text, augmentedSearch, augmentedReplacement);
        } catch (RuntimeException t) {
            return;
        }

        /*
         * Contract visible in replaceEach: entries with null search, empty search, or null
         * replacement are skipped by the "continue" guard, so adding one inert pair must not
         * change the observable result. A throw-deleting patch that silently drops work or a
         * wrong-output patch will violate this equality.
         */
        if (!safeEquals(baseResult, augmentedResult)) {
            throw new RuntimeException("[oracle:inert-augment] metamorphic violation: adding an inert pair changed result "
                    + "input=" + describe(text, augmentedSearch, augmentedReplacement)
                    + " base=" + baseResult + " augmented=" + augmentedResult);
        }
    }

    private static void checkSplitComposition(String[] search, String[] replacement, FuzzedDataProvider data) {
        String left = stripDelimiter(data.consumeAsciiString(8));
        String right = stripDelimiter(data.consumeAsciiString(8));
        String whole = left + "|" + right;

        final String wholeResult;
        final String leftResult;
        final String rightResult;
        try {
            wholeResult = StringUtils.replaceEach(whole, search, replacement);
            leftResult = StringUtils.replaceEach(left, search, replacement);
            rightResult = StringUtils.replaceEach(right, search, replacement);
        } catch (RuntimeException t) {
            return;
        }

        String recomposed = leftResult + "|" + rightResult;

        // Exercise the reachable helper explicitly on real outputs from the public API.
        StringUtils.length(wholeResult);
        StringUtils.length(recomposed);

        /*
         * For these constructed inputs every active search token is non-empty and does not contain
         * '|', so a match cannot cross the inserted delimiter. Therefore replacing in (left + "|"
         * + right) must equal replacing each side independently and rejoining with the same
         * delimiter. This is a sound metamorphic property for any correct implementation.
         */
        if (!safeEquals(wholeResult, recomposed)) {
            throw new RuntimeException("[oracle:split-compose] metamorphic violation: split composition failed "
                    + "input=" + describe(whole, search, replacement)
                    + " lhs=" + wholeResult + " rhs=" + recomposed);
        }
    }

    private static String[] buildActiveSearches(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 3);
        String[] out = new String[len];
        for (int i = 0; i < len; i++) {
            out[i] = cleanSearchToken(data.consumeAsciiString(4), fallbackToken(i));
        }
        return out;
    }

    private static String[] buildReplacements(FuzzedDataProvider data, int len) {
        String[] out = new String[len];
        for (int i = 0; i < len; i++) {
            out[i] = sanitizedReplacement(data.consumeAsciiString(6));
        }
        return out;
    }

    private static String cleanSearchToken(String in, String fallback) {
        String s = stripDelimiter(in);
        if (s.length() == 0) {
            s = fallback;
        }
        return s;
    }

    private static String sanitizedReplacement(String in) {
        return in == null ? "" : in;
    }

    private static String stripDelimiter(String s) {
        return s == null ? "" : s.replace("|", "");
    }

    private static String fallbackToken(int i) {
        switch (i % 3) {
            case 0:
                return "a";
            case 1:
                return "b";
            default:
                return "c";
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String describe(String text, String[] search, String[] replacement) {
        return "text=" + text + " search=" + ArrayUtils.toString(search) + " replacement=" + ArrayUtils.toString(replacement);
    }
}
