package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probeAnchor("1234.5", true);

        String decimal = buildValidDecimal(data);
        if (decimal != null) {
            probeAnchor(decimal, true);
            checkIntegerDecimalNumericEquivalence(decimal);
            checkSuffixCaseEquivalence(decimal);
        }

        String longLiteral = buildValidLongLiteral(data);
        if (longLiteral != null) {
            checkLongSuffixCaseEquivalence(longLiteral);
            checkUnsuffixedLongHelperAgreement(longLiteral);
        }

        String hexLiteral = buildValidHexLiteral(data);
        if (hexLiteral != null) {
            checkHexIntegerAgreement(hexLiteral);
        }
    }

    private static void probeAnchor(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        String fracStr = Integer.toString(frac);
        int minWidth = data.consumeInt(1, 6);
        while (fracStr.length() < minWidth) {
            fracStr = "0" + fracStr;
        }
        return Integer.toString(whole) + "." + fracStr;
    }

    private static String buildValidLongLiteral(FuzzedDataProvider data) {
        long high = (long) data.consumeInt(0, 999_999);
        long low = (long) data.consumeInt(0, 999_999);
        long value = 2147483648L + high * 1_000_000L + low;
        if (data.consumeBoolean()) {
            value = -value;
        }
        return Long.toString(value);
    }

    private static String buildValidHexLiteral(FuzzedDataProvider data) {
        String digits = data.consumeAsciiString(8);
        if (digits == null || digits.length() == 0) {
            digits = "1";
        }
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append("0x");
        boolean hasHex = false;
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            int v = c & 0x0F;
            char h = "0123456789ABCDEF".charAt(v);
            sb.append(h);
            hasHex = true;
        }
        if (!hasHex) {
            sb.append('1');
        }
        return sb.toString();
    }

    private static void checkIntegerDecimalNumericEquivalence(String decimal) {
        int dot = decimal.indexOf('.');
        if (dot <= 0) {
            return;
        }
        String whole = decimal.substring(0, dot);
        String frac = decimal.substring(dot + 1);
        boolean allZeroFraction = frac.length() > 0;
        for (int i = 0; i < frac.length(); i++) {
            if (frac.charAt(i) != '0') {
                allZeroFraction = false;
                break;
            }
        }
        if (!allZeroFraction) {
            return;
        }

        /*
         * Contract from the numeric parser itself: these two valid literals denote the same number.
         * A correct createNumber implementation may choose different concrete Number subtypes,
         * but it must not change the numeric value between "n" and "n.0...0".
         */
        try {
            Number integerParsed = NumberUtils.createNumber(whole);
            Number decimalParsed = NumberUtils.createNumber(decimal);
            if (integerParsed != null && decimalParsed != null) {
                BigDecimal lhs = toBigDecimal(integerParsed);
                BigDecimal rhs = toBigDecimal(decimalParsed);
                if (lhs != null && rhs != null && lhs.compareTo(rhs) != 0) {
                    throw new RuntimeException("[oracle:int-decimal-value] metamorphic violation: equivalent integer and decimal literals disagree input="
                            + decimal + " lhs=" + integerParsed + " rhs=" + decimalParsed);
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkSuffixCaseEquivalence(String decimal) {
        /*
         * The implementation switches on the final suffix character and treats d/D and f/F symmetrically.
         * Therefore changing only the suffix case must preserve numeric value for any valid decimal literal.
         */
        try {
            Number lowerD = NumberUtils.createNumber(decimal + "d");
            Number upperD = NumberUtils.createNumber(decimal + "D");
            if (lowerD != null && upperD != null && !sameNumericValue(lowerD, upperD)) {
                throw new RuntimeException("[oracle:decimal-d-case] metamorphic violation: d/D suffix case changed numeric value input="
                        + decimal + "d lhs=" + lowerD + " rhs=" + upperD);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }

        try {
            Number lowerF = NumberUtils.createNumber(decimal + "f");
            Number upperF = NumberUtils.createNumber(decimal + "F");
            if (lowerF != null && upperF != null && !sameNumericValue(lowerF, upperF)) {
                throw new RuntimeException("[oracle:decimal-f-case] metamorphic violation: f/F suffix case changed numeric value input="
                        + decimal + "f lhs=" + lowerF + " rhs=" + upperF);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkLongSuffixCaseEquivalence(String longLiteral) {
        /*
         * In createNumber, 'l' and 'L' share the same branch. For a valid integral literal in long range,
         * both explicit suffix forms must therefore produce the same numeric value and type family.
         */
        try {
            Number lower = NumberUtils.createNumber(longLiteral + "l");
            Number upper = NumberUtils.createNumber(longLiteral + "L");
            if (lower != null && upper != null) {
                if (!sameNumericValue(lower, upper) || !lower.getClass().equals(upper.getClass())) {
                    throw new RuntimeException("[oracle:long-suffix-case] metamorphic violation: l/L suffix disagreement input="
                            + longLiteral + "l lhs=" + lower + " rhs=" + upper);
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkUnsuffixedLongHelperAgreement(String longLiteral) {
        /*
         * For an integral literal outside int range but inside long range, createNumber first tries
         * createInteger, then createLong, and should return the same numeric quantity as createLong.
         */
        try {
            Number parsed = NumberUtils.createNumber(longLiteral);
            Long helper = NumberUtils.createLong(longLiteral);
            if (parsed != null && helper != null) {
                BigDecimal lhs = toBigDecimal(parsed);
                BigDecimal rhs = new BigDecimal(helper.toString());
                if (lhs != null && lhs.compareTo(rhs) != 0) {
                    throw new RuntimeException("[oracle:unsuffixed-long-helper] metamorphic violation: createNumber and createLong disagree input="
                            + longLiteral + " parsed=" + parsed + " helper=" + helper);
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkHexIntegerAgreement(String hexLiteral) {
        /*
         * createNumber delegates 0x / -0x inputs directly to createInteger, so both real library paths
         * must agree on the numeric value for a valid hex literal.
         */
        try {
            Number parsed = NumberUtils.createNumber(hexLiteral);
            Integer helper = NumberUtils.createInteger(hexLiteral);
            if (parsed != null && helper != null) {
                BigDecimal lhs = toBigDecimal(parsed);
                BigDecimal rhs = new BigDecimal(helper.toString());
                if (lhs != null && lhs.compareTo(rhs) != 0) {
                    throw new RuntimeException("[oracle:hex-integer-helper] metamorphic violation: createNumber and createInteger disagree input="
                            + hexLiteral + " parsed=" + parsed + " helper=" + helper);
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal lhs = toBigDecimal(a);
        BigDecimal rhs = toBigDecimal(b);
        return lhs != null && rhs != null && lhs.compareTo(rhs) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof Float) {
            Float f = (Float) n;
            if (f.isNaN() || f.isInfinite()) {
                return null;
            }
        }
        if (n instanceof Double) {
            Double d = (Double) n;
            if (d.isNaN() || d.isInfinite()) {
                return null;
            }
        }
        try {
            return new BigDecimal(n.toString());
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof NumberFormatException || c instanceof IllegalArgumentException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        boolean classMatch = false;
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof StringIndexOutOfBoundsException || c instanceof IndexOutOfBoundsException) {
                classMatch = true;
                break;
            }
        }
        if (!classMatch) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
