    private static boolean isAcceptedStringInput(String s) {
        return true;
    }

    private static String buildTriggerLikeInput(FuzzedDataProvider data) {
        int strategy = data.consumeInt(0, 5);
        switch (strategy) {
            case 0:
                return "oof";
            case 1:
                return "yep";
            case 2:
                return mutateAwayFromYes(varyCase("yes", data), data);
            case 3:
                return forceLength3(data.consumeAsciiString(3));
            case 4:
                return mutateAwayFromYes("off", data);
            default:
                return mutateAwayFromYes(data.consumeString(8), data);
        }
    }

    private static String forceLength3(String s) {
        if (s == null) {
            s = "";
        }
        if (s.length() >= 3) {
            return s.substring(0, 3);
        }
        StringBuilder b = new StringBuilder(s);
        while (b.length() < 3) {
            b.append('x');
        }
        return b.toString();
    }

    private static String mutateAwayFromYes(String s, FuzzedDataProvider data) {
        s = forceLength3(s);
        char[] chars = s.toCharArray();
        int pos = data.consumeInt(0, 2);
        char replacement = (char) ('a' + data.consumeInt(0, 25));
        chars[pos] = replacement;
        String out = new String(chars);
        if (!isNonYesThreeChar(out)) {
            chars[(pos + 1) % 3] = chars[(pos + 1) % 3] == 'z' ? 'q' : 'z';
            out = new String(chars);
        }
        return out;
    }

    private static boolean isNonYesThreeChar(String s) {
        return s != null && s.length() == 3 && !equalsIgnoreCaseAscii(s, "yes");
    }

    private static String varyCase(String base, FuzzedDataProvider data) {
        char[] chars = base.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static boolean equalsIgnoreCaseAscii(String a, String b) {
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char x = a.charAt(i);
            char y = b.charAt(i);
            if (x == y) {
                continue;
            }
            if (toLowerAscii(x) != toLowerAscii(y)) {
                return false;
            }
        }
        return true;
    }

    private static char toLowerAscii(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
