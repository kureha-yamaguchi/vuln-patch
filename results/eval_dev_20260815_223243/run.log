package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        String three = padOrTrimToLength(data.consumeAsciiString(3), 3);
        exercise(three, true);

        String base = data.consumeAsciiString(12);
        if (base.length() >= 3) {
            int start = data.consumeInt(0, base.length() - 3);
            exercise(base.substring(start, start + 3), true);
        } else {
            exercise(padOrTrimToLength(base, 3), true);
        }

        String any = data.consumeString(8);
        exercise(any, true);

        String canonicalTrue = pickCanonicalTrueToken(data.consumeInt(0, 2));
        String mixedTrue = randomizeCase(canonicalTrue, data);
        boolean parsedTrue = safeToBoolean(mixedTrue, true);
        if (!parsedTrue) {
            throw new RuntimeException("[oracle:true-token] metamorphic violation: case-insensitive true token parsed as false input="
                    + quote(mixedTrue) + " canonical=" + quote(canonicalTrue) + " result=" + parsedTrue);
        }

        String mixedUpper = mixedTrue.toUpperCase();
        boolean parsedUpper = safeToBoolean(mixedUpper, true);
        if (parsedTrue != parsedUpper) {
            throw new RuntimeException("[oracle:case-agree] metamorphic violation: equivalent case variants disagree input="
                    + quote(mixedTrue) + " lhs=" + parsedTrue + " rhs=" + parsedUpper);
        }

        String invalid3 = buildInvalidLengthThree(data);
        boolean invalidResult = safeToBoolean(invalid3, true);
        if (invalidResult) {
            throw new RuntimeException("[oracle:invalid-false] metamorphic violation: constructed invalid length-3 token should parse as false input="
                    + quote(invalid3) + " result=" + invalidResult);
        }
    }

    private static void exercise(String s, boolean validByConstruction) {
        safeToBoolean(s, validByConstruction);
    }

    private static boolean safeToBoolean(String s, boolean validByConstruction) {
        try {
            return BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return false;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return false;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String pickCanonicalTrueToken(int which) {
        switch (which) {
            case 0:
                return "on";
            case 1:
                return "yes";
            default:
                return "true";
        }
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String buildInvalidLengthThree(FuzzedDataProvider data) {
        char[] chars = new char[3];
        chars[0] = chooseNonTrueLeadingChar(data);
        chars[1] = chooseAsciiLetterOrDigit(data);
        chars[2] = chooseAsciiLetterOrDigit(data);
        String s = new String(chars);
        if (equalsIgnoreCaseAscii(s, "yes")) {
            chars[2] = chars[2] == 'x' ? 'z' : 'x';
            s = new String(chars);
        }
        return s;
    }

    private static char chooseNonTrueLeadingChar(FuzzedDataProvider data) {
        char c = chooseAsciiLetterOrDigit(data);
        if (c == 'y' || c == 'Y' || c == 't' || c == 'T') {
            return 'o';
        }
        return c;
    }

    private static char chooseAsciiLetterOrDigit(FuzzedDataProvider data) {
        int v = data.consumeInt(0, 61);
        if (v < 26) {
            return (char) ('a' + v);
        }
        if (v < 52) {
            return (char) ('A' + (v - 26));
        }
        return (char) ('0' + (v - 52));
    }

    private static boolean equalsIgnoreCaseAscii(String a, String b) {
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (ca == cb) {
                continue;
            }
            if (Character.toLowerCase(ca) != Character.toLowerCase(cb)) {
                return false;
            }
        }
        return true;
    }

    private static String padOrTrimToLength(String s, int len) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuilder sb = new StringBuilder(len);
        sb.append(s);
        while (sb.length() < len) {
            sb.append('x');
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
