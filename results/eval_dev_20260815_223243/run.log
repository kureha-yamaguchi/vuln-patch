            boolean rhs = BooleanUtils.toBoolean("true");
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:true-case] metamorphic violation: case-insensitive true parsing input=" + quote(trueVariant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isAcceptedStringInput(trueVariant)) {
                throw t;
            }
            return;
        }

        String yesVariant = varyCase("yes", data);
        try {
            boolean lhs = BooleanUtils.toBoolean(yesVariant);
            boolean rhs = BooleanUtils.toBoolean("yes");
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:yes-case] metamorphic violation: case-insensitive yes parsing input=" + quote(yesVariant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
