    private static void assertEmptyCopyEquivalentToClonedEmpty(TimeSeries source,
                                                               Day start,
                                                               Day end,
                                                               String label) throws CloneNotSupportedException {
        TimeSeries expected = (TimeSeries) source.clone();
        if (expected.getItemCount() > 0) {
            expected.delete(0, expected.getItemCount() - 1);
        }

        TimeSeries actual;
        try {
            actual = source.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:" + label + "-empty-copy-equivalent] metamorphic violation: valid empty-gap createCopy rejected while cloned-empty reference succeeded start="
                        + start + " end=" + end + " sourceCount=" + source.getItemCount(), e);
            }
            if (isValidationLike(e)) {
                return;
            }
            throw e;
        }

        if (actual == null) {
            throw new RuntimeException("[oracle:" + label + "-nonnull-copy] metamorphic violation: createCopy returned null");
        }

        // Contract exercised by the patched branch: for an empty selected range, createCopy()
        // returns a clone of the source with its data list replaced by an empty list.
        // A throw-deleting or branch-skipping patch can violate this while avoiding the original exception.
        if (actual.getItemCount() != expected.getItemCount()
                || actual.getItems().size() != expected.getItems().size()
                || actual.getItemCount() != 0
                || expected.getItemCount() != 0) {
            throw new RuntimeException("[oracle:" + label + "-empty-copy-shape] metamorphic violation: empty-gap copy disagrees with cloned-empty reference actualCount="
                    + actual.getItemCount() + " actualView=" + actual.getItems().size()
                    + " expectedCount=" + expected.getItemCount() + " expectedView=" + expected.getItems().size()
                    + " start=" + start + " end=" + end);
        }

        if (actual.getTimePeriodClass() != expected.getTimePeriodClass()) {
            throw new RuntimeException("[oracle:" + label + "-metadata-class] metamorphic violation: timePeriodClass changed across empty-gap copy actual="
                    + actual.getTimePeriodClass() + " expected=" + expected.getTimePeriodClass());
        }
        if (actual.getMaximumItemCount() != expected.getMaximumItemCount()) {
            throw new RuntimeException("[oracle:" + label + "-metadata-maxcount] metamorphic violation: maximum item count changed actual="
                    + actual.getMaximumItemCount() + " expected=" + expected.getMaximumItemCount());
        }
        if (actual.getMaximumItemAge() != expected.getMaximumItemAge()) {
            throw new RuntimeException("[oracle:" + label + "-metadata-maxage] metamorphic violation: maximum item age changed actual="
                    + actual.getMaximumItemAge() + " expected=" + expected.getMaximumItemAge());
        }

        try {
            if (actual.getItems().size() != actual.getTimePeriods().size()) {
                throw new RuntimeException("[oracle:" + label + "-period-view-size] metamorphic violation: empty copy items/timePeriods views disagree items="
                        + actual.getItems().size() + " periods=" + actual.getTimePeriods().size());
            }
        } catch (RuntimeException e) {
            if (!isValidationLike(e)) {
                throw e;
            }
        }
