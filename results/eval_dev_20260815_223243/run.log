    private static void addValue(TimeSeries series, Day d, int value) {
        series.add(d, new Integer(value));
    }

    private static Day dayFromEpochDay(int epochDay) {
        java.time.LocalDate ld = java.time.LocalDate.ofEpochDay(epochDay);
        return new Day(ld.getDayOfMonth(), ld.getMonthValue(), ld.getYear());
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int insertionPoint(int searchResult) {
        return searchResult >= 0 ? searchResult : -(searchResult + 1);
    }

    private static boolean isValidationLike(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
