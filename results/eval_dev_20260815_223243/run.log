                        || Double.doubleToLongBits(unsuffixed.doubleValue()) != Double.doubleToLongBits(independent.doubleValue())) {
                    throw new RuntimeException("[oracle:double-suffix-unsuffixed-consistency] metamorphic violation: suffixed and unsuffixed parses must denote the same numeric value input="
                            + withSuffix + " unsuffixed=" + unsuffixed + " rhs=" + independent);
                }
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException e) {
                if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                    throw e;
                }
                boolean inRegion = false;
                StackTraceElement[] st = e.getStackTrace();
                for (int j = 0; j < st.length; j++) {
                    String cn = st[j].getClassName();
                    String mn = st[j].getMethodName();
                    if ("org.apache.commons.lang.NumberUtils".equals(cn)
                            && ("createNumber".equals(mn)
                            || "createFloat".equals(mn)
                            || "createDouble".equals(mn)
                            || "createBigDecimal".equals(mn)
                            || "isAllZeros".equals(mn))) {
                        inRegion = true;
                        break;
                    }
                }
                if (e instanceof StringIndexOutOfBoundsException && inRegion) {
                    throw e;
                }
            }
        }
