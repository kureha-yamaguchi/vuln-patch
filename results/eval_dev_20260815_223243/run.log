    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight) throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(absentStart, exactRight);
            byIndex = series.createCopy(rightIndex, rightIndex);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: extending an empty gap to the exact right boundary should yield the right singleton", e);
            }
            throw e;
        }

        /* Contract used here: createCopy(start,end) returns the items whose periods lie in [start,end].
           Since absentStart is inside the gap immediately before exactRight, the only included item is exactRight.
           The equivalent index-based request [rightIndex,rightIndex] must therefore produce the same singleton. */
        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight
                    + " rightIndex=" + rightIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
        if (byBoundary.getValue(0) == null || !byBoundary.getValue(0).equals(byIndex.getValue(0))) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: right-boundary singleton value mismatch"
                    + " byBoundaryValue=" + byBoundary.getValue(0)
                    + " byIndexValue=" + byIndex.getValue(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd) throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
            throw new RuntimeException("[oracle:left-boundary-present] metamorphic violation: left boundary period must exist"
                    + " left=" + exactLeft
                    + " leftIndex=" + leftIndex);
        }

        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(exactLeft, absentEnd);
            byIndex = series.createCopy(leftIndex, leftIndex);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: extending an exact left boundary into an empty gap should preserve the left singleton", e);
            }
            throw e;
        }

        /* Contract used here: absentEnd is inside the gap immediately after exactLeft, so [exactLeft, absentEnd]
           contains exactly the left boundary item and must match the equivalent index-based singleton copy. */
        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton size mismatch"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd
                    + " leftIndex=" + leftIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd);
        }
        if (byBoundary.getValue(0) == null || !byBoundary.getValue(0).equals(byIndex.getValue(0))) {
            throw new RuntimeException("[oracle:boundary-step-left] metamorphic violation: left-boundary singleton value mismatch"
                    + " byBoundaryValue=" + byBoundary.getValue(0)
                    + " byIndexValue=" + byIndex.getValue(0)
                    + " exactLeft=" + exactLeft
                    + " absentEnd=" + absentEnd);
        }
    }

    private static void addValue(TimeSeries series, Day day, int value) {
        series.add(day, new Integer(value));
    }

    private static Day shift(Day base, int delta) {
        Day result = base;
        if (delta > 0) {
            for (int i = 0; i < delta; i++) {
                result = (Day) result.next();
                if (result == null) {
                    throw new IllegalArgumentException("day overflow");
                }
            }
        } else if (delta < 0) {
            for (int i = 0; i < -delta; i++) {
                result = (Day) result.previous();
                if (result == null) {
                    throw new IllegalArgumentException("day underflow");
                }
            }
        }
        return result;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof ClassCastException
                || t instanceof NullPointerException
                || t instanceof IndexOutOfBoundsException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException || t instanceof RuntimeException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
