            baryA = (Vector3D) a.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        }

        try {
            sizeB = b.getSize();
            baryB = (Vector3D) b.getBarycenter();
        } catch (RuntimeException t) {
            if (isRootCause(t) && validByConstruction) {
                throw t;
            }
            return;
        } catch (Error t) {
