package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
        }

        try {
            runScenario(data);
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));
        } catch (Throwable t) {
            return;
        }
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        analyzeWindow(s, start, end, true, "anchor");
    }

    private static void runScenario(FuzzedDataProvider data) {
        int n = data.consumeInt(2, 8);
        long current = data.consumeInt(-100000, 100000);
        TimeSeries s = new TimeSeries(
                nonEmpty(data.consumeAsciiString(12)),
                nonEmpty(data.consumeAsciiString(12)),
                nonEmpty(data.consumeAsciiString(12)),
                FixedMillisecond.class);

        try {
            for (int i = 0; i < n; i++) {
                long gap = data.consumeInt(2, 50);
                current += gap;
                s.add(new FixedMillisecond(current), new Integer(data.consumeInt(-1000, 1000)));
            }
        } catch (Throwable t) {
            return;
        }

        if (s.getItemCount() < 2) {
            return;
        }

        int left = data.consumeInt(0, s.getItemCount() - 2);
        FixedMillisecond p0 = (FixedMillisecond) s.getTimePeriod(left);
        FixedMillisecond p1 = (FixedMillisecond) s.getTimePeriod(left + 1);
        long t0 = p0.getFirstMillisecond();
        long t1 = p1.getFirstMillisecond();
        long gap = t1 - t0;
        if (gap < 2) {
            return;
        }

        long startMillis = t0 + data.consumeInt(1, (int) Math.min(gap - 1, 25));
        long endMillis = startMillis + data.consumeInt(0, (int) Math.min(t1 - startMillis - 1, 25));
        if (endMillis >= t1) {
            endMillis = t1 - 1;
        }
        if (startMillis > endMillis) {
            return;
        }

        FixedMillisecond start = new FixedMillisecond(startMillis);
        FixedMillisecond end = new FixedMillisecond(endMillis);
        analyzeWindow(s, start, end, true, "fuzz-gap");
    }

    private static void analyzeWindow(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end,
                                      boolean validByConstruction, String tag) {
        if (start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int manualCount = 0;
        RegularTimePeriod firstExpected = null;
        RegularTimePeriod lastExpected = null;
        List items = s.getItems();
        for (int i = 0; i < items.size(); i++) {
            TimeSeriesDataItem item = (TimeSeriesDataItem) items.get(i);
            RegularTimePeriod p = item.getPeriod();
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                if (firstExpected == null) {
                    firstExpected = p;
                }
                lastExpected = p;
                manualCount++;
            }
        }

        int rawStart = s.getIndex(start);
        int computedStart = rawStart < 0 ? -(rawStart + 1) : rawStart;
        int rawEnd = s.getIndex(end);
        int computedEnd = rawEnd < 0 ? -(rawEnd + 1) - 1 : rawEnd;
        boolean derivedEmpty = (computedStart >= s.getItemCount()) || (computedEnd < 0) || (computedEnd < computedStart);

        if (derivedEmpty != (manualCount == 0)) {
            throw new RuntimeException(
                    "[oracle:index-window-empty] getIndex-derived emptiness disagrees with iteration tag="
                            + tag + " rawStart=" + rawStart + " rawEnd=" + rawEnd
                            + " computedStart=" + computedStart + " computedEnd=" + computedEnd
                            + " manualCount=" + manualCount + " itemCount=" + s.getItemCount());
        }

        int beforeCount = s.getItemCount();
        List beforeItems = s.getItems();
        try {
            TimeSeries copy = s.createCopy(start, end);

            if (s.getItemCount() != beforeCount || beforeItems.size() != s.getItems().size()) {
                throw new RuntimeException(
                        "[oracle:source-stable-metadata] source changed after createCopy tag="
                                + tag + " beforeCount=" + beforeCount + " afterCount=" + s.getItemCount());
            }

            if (copy == null) {
                throw new RuntimeException("[oracle:copy-nonnull-boundary] null copy tag=" + tag);
            }

            if (copy.getItemCount() != manualCount) {
                throw new RuntimeException(
                        "[oracle:window-count-manual] copy count disagrees with iteration tag="
                                + tag + " expected=" + manualCount + " actual=" + copy.getItemCount());
            }

            if (copy.getTimePeriodClass() != s.getTimePeriodClass()) {
                throw new RuntimeException(
                        "[oracle:copy-period-class] copy changed timePeriodClass tag="
                                + tag + " expected=" + s.getTimePeriodClass()
                                + " actual=" + copy.getTimePeriodClass());
            }

            if (!safeEquals(copy.getDomainDescription(), s.getDomainDescription())
                    || !safeEquals(copy.getRangeDescription(), s.getRangeDescription())) {
                throw new RuntimeException(
                        "[oracle:copy-metadata] copy changed domain/range tag="
                                + tag + " domain=" + s.getDomainDescription() + "/" + copy.getDomainDescription()
                                + " range=" + s.getRangeDescription() + "/" + copy.getRangeDescription());
            }

            /* Contract asserted:
             * createCopy(start, end) returns a copy of the subset of data items in the range.
             * Therefore, when the independently recomputed subset is non-empty, the first and last
             * periods in the copy must match the first and last periods selected from the source.
             * A throw-deleting or wrong-empty-copy patch would violate this even if no exception fires.
             */
            if (manualCount > 0) {
                RegularTimePeriod firstActual = copy.getTimePeriod(0);
                RegularTimePeriod lastActual = copy.getTimePeriod(copy.getItemCount() - 1);
                if (firstActual.compareTo(firstExpected) != 0 || lastActual.compareTo(lastExpected) != 0) {
                    throw new RuntimeException(
                            "[oracle:window-boundaries] copy boundaries disagree with iteration tag="
                                    + tag + " expectedFirst=" + firstExpected + " actualFirst=" + firstActual
                                    + " expectedLast=" + lastExpected + " actualLast=" + lastActual);
                }
            } else {
                if (copy.getItemCount() != 0) {
                    throw new RuntimeException(
                            "[oracle:empty-gap-copy] expected empty copy for empty interval tag="
                                    + tag + " actual=" + copy.getItemCount());
                }
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException t) {
            if (validByConstruction && isRootCauseFromCreateCopy(t)) {
                throw new RuntimeException(
                        "[oracle:boundary-flip-createCopy] valid empty interval rejected tag="
                                + tag + " manualCount=" + manualCount
                                + " rawStart=" + rawStart + " rawEnd=" + rawEnd
                                + " computedStart=" + computedStart + " computedEnd=" + computedEnd, t);
            }
            throw t;
        } catch (Throwable t) {
            if (validByConstruction && isRootCauseFromCreateCopy(t)) {
                throw new RuntimeException(
                        "[oracle:boundary-flip-createCopy] valid empty interval rejected tag="
                                + tag + " manualCount=" + manualCount
                                + " rawStart=" + rawStart + " rawEnd=" + rawEnd
                                + " computedStart=" + computedStart + " computedEnd=" + computedEnd, t);
            }
        }
    }

    private static boolean isRootCauseFromCreateCopy(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.jfree.data.time.TimeSeries".equals(e.getClassName())
                    && "createCopy".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean safeEquals(Object a, Object b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String nonEmpty(String s) {
        return (s == null || s.length() == 0) ? "X" : s;
    }
}
