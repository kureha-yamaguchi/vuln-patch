package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            tryEscapeCsvAndAssertIdentity(s, true);
        }

        int iterations = 1 + data.consumeInt(1, 4);
        for (int i = 0; i < iterations; i++) {
            String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
            String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));

            int codePoint = chooseSupplementaryCodePoint(data.consumeInt());
            String pair = new String(Character.toChars(codePoint));

            String middle = data.consumeBoolean() ? sanitizeCsvSafeAscii(data.consumeAsciiString(4)) : "";
            String input;
            switch (data.consumeInt(0, 3)) {
                case 0:
                    input = prefix + pair + suffix;
                    break;
                case 1:
                    input = pair + prefix + middle + suffix;
                    break;
                case 2:
                    input = prefix + middle + pair;
                    break;
                default:
                    input = prefix + pair + middle + pair + suffix;
                    break;
            }

            if (input.length() == 0) {
                input = "A" + pair;
            }

            tryEscapeCsvAndAssertIdentity(input, true);
        }
    }

    private static void tryEscapeCsvAndAssertIdentity(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: CSV escaping returns the input unchanged when the input
             * contains none of ',', '"', '\r', or '\n'. All explored inputs are built
             * from safe ASCII plus well-formed supplementary code points, so a correct
             * implementation must preserve them exactly. A patch that merely suppresses
             * the crash by skipping bookkeeping or dropping characters would violate this.
             */
            if (isCsvSafe(input) && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isOracleFailure(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCsvSafe(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static int chooseSupplementaryCodePoint(int raw) {
        int[] ranges = new int[] {
            0x10000, 0x10FFF,
            0x1F300, 0x1FAFF,
            0x2A700, 0x2B73F,
            0xE0000, 0xE007F
        };
        int idx = Math.abs(raw == Integer.MIN_VALUE ? 0 : raw) % (ranges.length / 2);
        int start = ranges[idx * 2];
        int end = ranges[idx * 2 + 1];
        int span = end - start + 1;
        int off = Math.abs((raw * 1103515245) ^ 0x5bd1e995);
        return start + (off % span);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (StackTraceElement e : st) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
