package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathRuntimeException;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        tryAnchor();

        try {
            exploreLeafPolygons(data);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }

        try {
            checkGetVerticesCloneIsolation(data);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static void tryAnchor() {
        try {
            float[] coords = {
                1.000000f, -1.000000f, -1.000000f,
                1.000000f, -1.000000f,  1.000000f,
               -1.000000f, -1.000000f,  1.000000f,
               -1.000000f, -1.000000f, -1.000000f,
                1.000000f,  1.000000f, -1.000000f,
                0.999999f,  1.000000f,  1.000000f,
               -1.000000f,  1.000000f,  1.000000f,
               -1.000000f,  1.000000f, -1.000000f
            };
            int[] indices = {
                0, 1, 2, 0, 2, 3,
                4, 7, 6, 4, 6, 5,
                0, 4, 5, 0, 5, 1,
                1, 5, 6, 1, 6, 2,
                2, 6, 7, 2, 7, 3,
                4, 0, 3, 4, 3, 7
            };

            Collection<SubHyperplane<Euclidean3D>> boundary = new ArrayList<SubHyperplane<Euclidean3D>>();
            for (int i = 0; i < indices.length; i += 3) {
                Vector3D a = vec(coords, indices[i]);
                Vector3D b = vec(coords, indices[i + 1]);
                Vector3D c = vec(coords, indices[i + 2]);

                Plane plane = new Plane(a, b, c);
                Vector2D pA = plane.toSubSpace(a);
                Vector2D pB = plane.toSubSpace(b);
                Vector2D pC = plane.toSubSpace(c);

                PolygonsSet facetRegion = new PolygonsSet(1.0e-10, pA, pB, pC);
                boundary.add(new SubPlane(plane, facetRegion));
            }

            PolyhedronsSet poly = new PolyhedronsSet(boundary);

            poly.getSize();
            poly.getBarycenter();
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static void exploreLeafPolygons(FuzzedDataProvider data) {
        boolean inside = data.consumeBoolean();
        BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D> tree =
                new BSPTree<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>(Boolean.valueOf(inside));
        PolygonsSet p = new PolygonsSet(tree);

        Vector2D[][] v1 = p.getVertices();
        if (v1.length != 0) {
            throw new RuntimeException("[oracle:leaf-verts] metamorphic violation: null-cut leaf must expose zero loops length=" + v1.length);
        }

        double size = p.getSize();
        Vector2D bary = p.getBarycenter();

        if (inside) {
            if (!Double.isInfinite(size) || size < 0.0) {
                throw new RuntimeException("[oracle:whole-space] metamorphic violation: whole-space leaf must report infinite size size=" + size);
            }
            if (!Double.isNaN(bary.getX()) || !Double.isNaN(bary.getY())) {
                throw new RuntimeException("[oracle:whole-space] metamorphic violation: whole-space leaf must report NaN barycenter x=" + bary.getX() + " y=" + bary.getY());
            }
        } else {
            if (size != 0.0) {
                throw new RuntimeException("[oracle:empty-space] metamorphic violation: empty leaf must report zero size size=" + size);
            }
            if (bary.getX() != 0.0 || bary.getY() != 0.0) {
                throw new RuntimeException("[oracle:empty-space] metamorphic violation: empty leaf must report origin barycenter x=" + bary.getX() + " y=" + bary.getY());
            }
        }

        Vector2D[][] v2 = p.getVertices();
        if (v2.length != 0) {
            throw new RuntimeException("[oracle:leaf-verts-post] metamorphic violation: computeGeometricalProperties must not change zero-loop vertex view length=" + v2.length);
        }
    }

    private static void checkGetVerticesCloneIsolation(FuzzedDataProvider data) {
        double x1 = bounded(data.consumeInt());
        double y1 = bounded(data.consumeInt());
        double dx1 = 1.0 + Math.abs(bounded(data.consumeInt()));
        double dy2 = 1.0 + Math.abs(bounded(data.consumeInt()));

        Vector2D a = new Vector2D(x1, y1);
        Vector2D b = new Vector2D(x1 + dx1, y1);
        Vector2D c = new Vector2D(x1, y1 + dy2);

        PolygonsSet triangle = new PolygonsSet(1.0e-10, a, b, c);

        Vector2D[][] first = triangle.getVertices();
        Vector2D[][] second = triangle.getVertices();
        if (first.length == 0 || second.length == 0 || first[0] == null || second[0] == null) {
            return;
        }

        int before = second[0].length;
        first[0] = null;

        Vector2D[][] third = triangle.getVertices();
        if (third.length == 0 || third[0] == null) {
            throw new RuntimeException("[oracle:clone-isolation] metamorphic violation: modifying returned outer array changed later getVertices result");
        }
        if (third[0].length != before) {
            throw new RuntimeException("[oracle:clone-isolation] metamorphic violation: later getVertices length changed after caller mutated prior return before=" + before + " after=" + third[0].length);
        }
    }

    private static Vector3D vec(float[] coords, int vertexIndex) {
        int i = vertexIndex * 3;
        return new Vector3D(coords[i], coords[i + 1], coords[i + 2]);
    }

    private static double bounded(int v) {
        return (v % 10000) / 10.0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof MathIllegalArgumentException
                || t instanceof MathRuntimeException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
