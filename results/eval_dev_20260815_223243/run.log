package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callTarget("off");

        int observedCount = 1 + data.consumeInt(0, 7);
        for (int i = 0; i < observedCount; i++) {
            String candidate;
            switch (data.consumeInt(0, 5)) {
                case 0:
                    candidate = data.consumeAsciiString(3);
                    break;
                case 1:
                    candidate = buildLengthThreeCandidate(data);
                    break;
                case 2:
                    candidate = pickObservedLiteral(data);
                    break;
                case 3:
                    candidate = data.consumeAsciiString(4);
                    break;
                case 4:
                    candidate = data.consumeString(8);
                    break;
                default:
                    candidate = data.consumeRemainingAsString();
                    break;
            }
            callTarget(candidate);
        }

        /* Contract/oracle:
         * BooleanUtils.toBoolean(String) recognizes "true", "on", and "yes" case-insensitively.
         * Therefore any mixed-case variant of one of those canonical true tokens must produce the
         * same result as the canonical spelling, namely true. A patch that merely suppresses the
         * crash by skipping the len-3 branch, or by making the branch unreachable, would wrongly
         * turn some "yes"/"YES" inputs into false and violate this relation without throwing.
         */
        String canonical;
        switch (data.consumeInt(0, 2)) {
            case 0:
                canonical = "true";
                break;
            case 1:
                canonical = "yes";
                break;
            default:
                canonical = "on";
                break;
        }
        String mixed = randomizeCase(canonical, data);
        try {
            boolean lhs = BooleanUtils.toBoolean(mixed);
            boolean rhs = BooleanUtils.toBoolean(canonical);
            if (lhs != rhs || !rhs) {
                throw new RuntimeException(
                    "[oracle:case-true-token] metamorphic violation: equivalent mixed-case true token input="
                        + printable(mixed) + " lhs=" + lhs + " rhs=" + rhs + " canonical=" + printable(canonical));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static void callTarget(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildLengthThreeCandidate(FuzzedDataProvider data) {
        char c0 = asciiFromByte(data.consumeByte());
        char c1 = asciiFromByte(data.consumeByte());
        char c2 = asciiFromByte(data.consumeByte());
        if (equalsIgnoreAscii(c0, 'y') && equalsIgnoreAscii(c1, 'e') && equalsIgnoreAscii(c2, 's')) {
            c2 = 'p';
        }
        return new String(new char[] { c0, c1, c2 });
    }

    private static String pickObservedLiteral(FuzzedDataProvider data) {
        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        return literals[data.consumeInt(0, literals.length - 1)];
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            char ch = chars[i];
            if (ch >= 'a' && ch <= 'z') {
                chars[i] = data.consumeBoolean() ? (char) (ch - ('a' - 'A')) : ch;
            } else if (ch >= 'A' && ch <= 'Z') {
                chars[i] = data.consumeBoolean() ? (char) (ch + ('a' - 'A')) : ch;
            }
        }
        return new String(chars);
    }

    private static boolean equalsIgnoreAscii(char a, char b) {
        return a == b || toLowerAscii(a) == toLowerAscii(b);
    }

    private static char toLowerAscii(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static char asciiFromByte(byte b) {
        int v = b & 0x7F;
        if (v < 32 || v > 126) {
            v = 'a' + (v % 26);
        }
        return (char) v;
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
