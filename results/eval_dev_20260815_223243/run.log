import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            exercise(anchor[i]);
        }

        for (int i = 0; i < 10; i++) {
            String probe;
            switch (data.consumeInt(0, 9)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = String.valueOf((char) ('1' + data.consumeInt(0, 8)))
                            + String.valueOf((char) ('0' + data.consumeInt(0, 9)))
                            + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "-" + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "." + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeBoolean() ? "f" : "F";
                    break;
                case 8:
                    probe = data.consumeAsciiString(3);
                    break;
                default:
                    probe = data.consumeRemainingAsString();
                    break;
            }
            exercise(probe);
        }

        /*
         * Contract used for this oracle:
         * - In createNumber, for integral strings without a suffix and within int range,
         *   the implementation "starts small" and returns createInteger(val).
         * - When the input ends in 'l' or 'L', the code explicitly treats that as
         *   "Requesting a specific type.." and must use the long-literal branch,
         *   returning createLong(numeric) for in-range decimal inputs.
         *
         * Therefore, for a small positive decimal n, createNumber(n) and createNumber(n+"L")
         * must denote the same numeric value, but the suffixed form must select Long rather
         * than the unsuffixed Integer. A patch that merely suppresses the singleton crash by
         * skipping or bypassing the long-suffix branch can silently return the wrong type here,
         * so this post-condition catches throw-deleting / branch-skipping fixes.
         */
        String canonical = buildSmallPositiveDecimal(data);
        String suffixed = canonical + (data.consumeBoolean() ? "L" : "l");
        try {
            Number plain = NumberUtils.createNumber(canonical);
            Number forcedLong = NumberUtils.createNumber(suffixed);
            Long helper = NumberUtils.createLong(canonical);
            if (plain == null || forcedLong == null || helper == null) {
                return;
            }
            if (!(plain instanceof Integer)
                    || !(forcedLong instanceof Long)
                    || plain.longValue() != helper.longValue()
                    || forcedLong.longValue() != helper.longValue()
                    || !helper.toString().equals(forcedLong.toString())) {
                throw new RuntimeException(
                        "[oracle:suffix-forces-long-type] metamorphic violation: decimal+L must preserve the value of createLong(decimal) while selecting Long instead of unsuffixed Integer input="
                                + canonical
                                + " suffixed=" + suffixed
                                + " plain=" + describe(plain)
                                + " forcedLong=" + describe(forcedLong)
                                + " helper=" + describe(helper));
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (isRootCauseLeak(e)) {
                return;
            }
            return;
        }
    }

    private static void exercise(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCauseLeak(e)) {
                return;
            }
            return;
        }
    }

    private static boolean isRootCauseLeak(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (int i = 0; i < t.getStackTrace().length; i++) {
            StackTraceElement ste = t.getStackTrace()[i];
            if ("org.apache.commons.lang.NumberUtils".equals(ste.getClassName())) {
                String mn = ste.getMethodName();
                if ("createNumber".equals(mn)
                        || "createInteger".equals(mn)
                        || "isAllZeros".equals(mn)
                        || "createLong".equals(mn)
                        || "createBigInteger".equals(mn)
                        || "createFloat".equals(mn)
                        || "createDouble".equals(mn)
                        || "createBigDecimal".equals(mn)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleFailure(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static String buildSmallPositiveDecimal(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 6);
        StringBuilder sb = new StringBuilder();
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + n.toString();
    }
}
