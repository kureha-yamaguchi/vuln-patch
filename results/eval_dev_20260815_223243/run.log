            if (copy.getItemCount() != 0 || copy.getItems().size() != 0) {
                throw new RuntimeException(
                        "[oracle:anchor-empty-post] metamorphic violation: anchor empty gap must yield empty copy"
                                + " copyCount=" + copy.getItemCount()
                                + " copyItemsSize=" + copy.getItems().size()
                                + " rawStart=" + rawStart
                                + " rawEnd=" + rawEnd);
            }

