            try {
                String viaTranslator = CharSequenceTranslatorFactory.ESCAPE_CSV.translate(input);
                if (!escaped.equals(viaTranslator)) {
                    throw new RuntimeException(
                        "[oracle:overload-agree] metamorphic violation: StringEscapeUtils.escapeCsv and ESCAPE_CSV.translate disagree input="
                            + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(viaTranslator));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwRoot(t);
