package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsvOnValidSafeInput(s);
        }

        String fuzzed = buildValidSafeStringWithSupplementary(data);
        exerciseEscapeCsvOnValidSafeInput(fuzzed);
    }

    private static void exerciseEscapeCsvOnValidSafeInput(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle: CSV escaping only adds quoting/escaping when the input contains
            // comma, double quote, CR, or LF. We construct inputs from safe ASCII plus valid
            // supplementary code points only, so a correct implementation must return the input
            // unchanged. A patch that merely suppresses the crash but skips/corrupts translation
            // will violate this observable post-condition.
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(input)) {
                throw t;
            }
            throwIfOracle(t);
        }
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        boolean sawSupplementary = false;
        for (int i = 0; i < s.length();) {
            int cp = Character.codePointAt(s, i);
            if (Character.isSupplementaryCodePoint(cp)) {
                sawSupplementary = true;
            }
            if (cp == ',' || cp == '"' || cp == '\r' || cp == '\n') {
                return false;
            }
            if (!Character.isValidCodePoint(cp)) {
                return false;
            }
            i += Character.charCount(cp);
        }
        return sawSupplementary;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validation") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwIfOracle(RuntimeException t) {
        if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
            throw t;
        }
    }

    private static String buildValidSafeStringWithSupplementary(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        sb.append(toCsvSafeAscii(data.consumeAsciiString(12)));

        int supplementaryCount = data.consumeInt(1, 4);
        for (int i = 0; i < supplementaryCount; i++) {
            int cp = randomSupplementaryCodePoint(data);
            sb.append(Character.toChars(cp));
            sb.append(toCsvSafeAscii(data.consumeAsciiString(8)));
        }

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x10000));
        }

        return sb.toString();
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp) && Character.isSupplementaryCodePoint(cp)) {
                return cp;
            }
        }
    }

    private static String toCsvSafeAscii(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                out.append('a');
            } else if (c < 0x20 || c > 0x7e) {
                out.append('b');
            } else {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            out.append('x');
        }
        return out.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c).toUpperCase();
                        out.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            out.append('0');
                        }
                        out.append(hex);
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }
}
