    private static String buildMalformedBothExponentMarkers(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        if (data.consumeBoolean()) {
            sb.append('-');
        }

        int prefixDigits = data.consumeInt(1, 6);
        for (int i = 0; i < prefixDigits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        if (data.consumeBoolean()) {
            sb.append('e');
            int middleDigits = data.consumeInt(0, 4);
            for (int i = 0; i < middleDigits; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
            sb.append('E');
        } else {
            sb.append('E');
            int middleDigits = data.consumeInt(0, 4);
            for (int i = 0; i < middleDigits; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
            sb.append('e');
        }

        int suffixDigits = data.consumeInt(0, 4);
        for (int i = 0; i < suffixDigits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        return sb.toString();
