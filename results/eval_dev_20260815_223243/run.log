                        + " bary2=(" + bary2.getX() + "," + bary2.getY() + "," + bary2.getZ() + ")"
                        + " expected=(" + expectedBx + "," + expectedBy + "," + expectedBz + ")");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagateRootCause(t) || isOracleFailure(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void exerciseAnchor() {
        try {
            PolyhedronsSet anchor = buildPolyhedronsSet(ANCHOR_COORDS);
            anchor.getSize();
            anchor.getBarycenter();
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagateRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static float[] makeVariantCoords(float epsilon, float tx, float ty, float tz, float scale) {
        float[] coords = new float[ANCHOR_COORDS.length];
        for (int i = 0; i < ANCHOR_COORDS.length; i += 3) {
            float x = ANCHOR_COORDS[i];
            float y = ANCHOR_COORDS[i + 1];
            float z = ANCHOR_COORDS[i + 2];
            if (i == 15) {
                x = 1.0f - epsilon;
            }
            coords[i] = (x + tx) * scale;
            coords[i + 1] = (y + ty) * scale;
            coords[i + 2] = (z + tz) * scale;
        }
        return coords;
    }

    private static PolyhedronsSet buildPolyhedronsSet(float[] coords) {
        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < INDICES.length; idx += 3) {
            Vector3D v1 = vertex(coords, INDICES[idx]);
            Vector3D v2 = vertex(coords, INDICES[idx + 1]);
            Vector3D v3 = vertex(coords, INDICES[idx + 2]);

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>();
            addEdge(edges, p1, p2);
            addEdge(edges, p2, p3);
            addEdge(edges, p3, p1);

            PolygonsSet polygon = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, polygon));
        }
        return new PolyhedronsSet(facets);
    }

    private static Vector3D vertex(float[] coords, int vertexIndex) {
        int base = vertexIndex * 3;
        return new Vector3D(coords[base], coords[base + 1], coords[base + 2]);
    }

    private static void addEdge(
            Collection<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges,
            Vector2D start,
            Vector2D end) {
        Line line = new Line(start, end);
        double a = line.toSubSpace(start).getX();
        double b = line.toSubSpace(end).getX();
        double min = Math.min(a, b);
        double max = Math.max(a, b);
        edges.add(new SubLine(line, new IntervalsSet(min, max)));
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException || t instanceof MathIllegalArgumentException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("Invalid") || n.contains("Illegal") || n.contains("Malformed");
    }

    private static boolean shouldPropagateRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "getTree".equals(method)
                        || "setSize".equals(method)
                        || "setBarycenter".equals(method)
                        || "getBarycenter".equals(method)
                        || "getSize".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean approximatelyEqual(double actual, double expected, double absTol, double relTol) {
        if (Double.isNaN(actual) || Double.isNaN(expected)) {
            return false;
        }
        if (Double.isInfinite(actual) || Double.isInfinite(expected)) {
            return actual == expected;
        }
        double diff = Math.abs(actual - expected);
        return diff <= absTol || diff <= relTol;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
