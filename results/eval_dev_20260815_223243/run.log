package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerBugOrCleanReject("1234.5", true);

        triggerBugOrCleanReject(buildDualExponentMarkerInput(data), false);

        checkDoubleSuffixAgreement(buildCanonicalDecimal(data));
        checkHexHelperAgreement(buildCanonicalHex(data));
    }

    private static void triggerBugOrCleanReject(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (t instanceof RuntimeException && isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
        }
    }

    private static void checkDoubleSuffixAgreement(String numeric) {
        Double viaDoubleUpper;
        Double viaDoubleLower;
        try {
            viaDoubleUpper = NumberUtils.createDouble(numeric);
            viaDoubleLower = NumberUtils.createDouble(numeric);
        } catch (RuntimeException t) {
            return;
        }

        Number viaNumberUpper;
        Number viaNumberLower;
        try {
            viaNumberUpper = NumberUtils.createNumber(numeric + "D");
            viaNumberLower = NumberUtils.createNumber(numeric + "d");
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (viaNumberUpper == null || viaNumberLower == null) {
            return;
        }

        /* Contract visible in createNumber: for a non-infinite, moderate decimal with a 'D'/'d' suffix,
           createNumber strips the suffix, calls createDouble(numeric), and returns that Double. */
        if (!(viaNumberUpper instanceof Double)
                || Double.doubleToLongBits(((Double) viaNumberUpper).doubleValue())
                        != Double.doubleToLongBits(viaDoubleUpper.doubleValue())) {
            throw new RuntimeException(
                    "[oracle:double-suffix] metamorphic violation: createNumber disagrees with createDouble input="
                            + numeric + " lhs=" + viaNumberUpper + " rhs=" + viaDoubleUpper);
        }
        if (!(viaNumberLower instanceof Double)
                || Double.doubleToLongBits(((Double) viaNumberLower).doubleValue())
                        != Double.doubleToLongBits(viaDoubleLower.doubleValue())) {
            throw new RuntimeException(
                    "[oracle:double-suffix] metamorphic violation: createNumber disagrees with createDouble input="
                            + numeric + " lhs=" + viaNumberLower + " rhs=" + viaDoubleLower);
        }
    }

    private static void checkHexHelperAgreement(String hex) {
        Integer viaInteger;
        Number viaNumber;
        try {
            viaInteger = NumberUtils.createInteger(hex);
            viaNumber = NumberUtils.createNumber(hex);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }

        if (viaInteger == null || viaNumber == null) {
            return;
        }

        /* Contract visible in createNumber: when the string starts with "0x" or "-0x",
           createNumber returns createInteger(str) directly, so both real library calls must agree exactly. */
        if (!(viaNumber instanceof Integer) || viaNumber.intValue() != viaInteger.intValue()) {
            throw new RuntimeException(
                    "[oracle:hex-helper] metamorphic violation: createNumber disagrees with createInteger input="
                            + hex + " lhs=" + viaNumber + " rhs=" + viaInteger);
        }
    }

    private static String buildCanonicalDecimal(FuzzedDataProvider data) {
        String intPart = digitsOrDefault(data.consumeAsciiString(6), "1");
        String fracPart = digitsOrDefault(data.consumeAsciiString(6), "1");
        boolean negative = data.consumeBoolean();
        return (negative ? "-" : "") + intPart + "." + fracPart;
    }

    private static String buildCanonicalHex(FuzzedDataProvider data) {
        int value = data.consumeInt(0, Integer.MAX_VALUE);
        String digits = Integer.toHexString(value);
        return data.consumeBoolean() ? "-0x" + digits : "0x" + digits;
    }

    private static String buildDualExponentMarkerInput(FuzzedDataProvider data) {
        String a = digitsOrDefault(data.consumeAsciiString(5), "1");
        String b = digitsOrDefault(data.consumeAsciiString(5), "2");
        String c = digitsOrDefault(data.consumeAsciiString(5), "3");
        boolean negative = data.consumeBoolean();
        boolean upperFirst = data.consumeBoolean();
        boolean endWithSecondMarker = data.consumeBoolean();
        char first = upperFirst ? 'E' : 'e';
        char second = upperFirst ? 'e' : 'E';

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        sb.append(a).append(first).append(b);
        if (endWithSecondMarker) {
            sb.append(second);
        } else {
            sb.append(second).append(c);
        }

        if (!endWithSecondMarker && data.remainingBytes() > 0) {
            int choice = data.consumeInt(0, 4);
            switch (choice) {
                case 0:
                    sb.append('D');
                    break;
                case 1:
                    sb.append('F');
                    break;
                case 2:
                    sb.append('L');
                    break;
                default:
                    break;
            }
        }
        return sb.toString();
    }

    private static String digitsOrDefault(String s, String dflt) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch >= '0' && ch <= '9') {
                out.append(ch);
            }
        }
        if (out.length() == 0) {
            return dflt;
        }
        return out.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }
}
