package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract/oracle used below:
        // From the shown BooleanUtils.toBoolean(String) code, the parser recognizes
        // "on" (len 2), "yes" (len 3), and "true" (len 4) case-insensitively.
        // Therefore any length-3 string whose first character is NOT 'y'/'Y' cannot be
        // a recognized true token and must return false; a throw-deleting or wrong-value
        // patch that changes this observable result is a bug.

        callExpectFalse("off", "anchor-off");

        int trials = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < trials; i++) {
            String candidate = buildThreeCharCandidate(data);
            callExpectFalse(candidate, "len3-false");
        }

        String trueToken = buildTrueTokenVariant(data);
        checkRecognizedTrueToken(trueToken);

        String yesToken = buildYesTokenVariant(data);
        checkRecognizedTrueToken(yesToken);

        String onToken = buildOnTokenVariant(data);
        checkRecognizedTrueToken(onToken);
    }

    private static void callExpectFalse(String s, String oracleId) {
        try {
            boolean result = BooleanUtils.toBoolean(s);
            if (result) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: non-recognized length-3 string must parse false input=" + quote(s) + " lhs=" + result + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkRecognizedTrueToken(String token) {
        try {
