    private static String buildValidDecimal(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        if (data.consumeBoolean()) {
            sb.append('-');
        }

        int intLen = data.consumeInt(1, 6);
        for (int i = 0; i < intLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        sb.append('.');

        int fracLen = data.consumeInt(1, 6);
        for (int i = 0; i < fracLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        String s = sb.toString();
        if (allDigitsAreZero(s)) {
            int idx = s.charAt(0) == '-' ? 1 : 0;
            StringBuilder fix = new StringBuilder(s);
            fix.setCharAt(idx, '1');
            s = fix.toString();
        }
        return s;
    }

    private static boolean allDigitsAreZero(String s) {
        boolean sawDigit = false;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sawDigit = true;
                if (c != '0') {
                    return false;
                }
            }
        }
        return sawDigit;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(stack[i].getClassName())
                    && "createNumber".equals(stack[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }
