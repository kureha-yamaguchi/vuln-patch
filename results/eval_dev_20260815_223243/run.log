    private static void invokePossiblyBuggy(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (validByConstruction && isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkSuffixCaseAgreement(String base, char leftSuffix, char rightSuffix) {
        Number left;
        Number right;
        try {
            left = NumberUtils.createNumber(base + leftSuffix);
            right = NumberUtils.createNumber(base + rightSuffix);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }
        if (left == null || right == null) {
            return;
        }

        /* Contract used for this oracle: createNumber dispatches on the final type suffix and
           treats upper/lower case variants identically in the same switch arm ('D'/'d', 'F'/'f').
           Therefore equivalent literals differing only by suffix case must yield the same numeric
           value and same selected wrapper type. A patch that only suppresses an exception or skips
           part of exponent parsing can violate this without throwing. */
        if (!left.getClass().equals(right.getClass()) || compareAsDecimal(left, right) != 0) {
            throw new RuntimeException("[oracle:suffix-case] metamorphic violation: input=" + base
                    + " lhs=" + left + " (" + left.getClass().getName() + ")"
                    + " rhs=" + right + " (" + right.getClass().getName() + ")");
        }
    }

    private static void checkEquivalentInputsAgreement(String leftInput, String rightInput, String oracleId) {
        Number left;
        Number right;
        try {
            left = NumberUtils.createNumber(leftInput);
            right = NumberUtils.createNumber(rightInput);
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            return;
        }
        if (left == null || right == null) {
            return;
        }

        /* Contract used for this oracle: Java numeric literals and the parser logic in createNumber
           accept both 'e' and 'E' as exponent markers. Replacing one with the other does not change
           the represented number, so both calls must agree numerically for any valid-by-construction
           scientific-notation input. */
        if (compareAsDecimal(left, right) != 0) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: lhsInput="
                    + leftInput + " rhsInput=" + rightInput + " lhs=" + left + " rhs=" + right);
        }
    }

    private static int compareAsDecimal(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs);
        } catch (RuntimeException e) {
            return 1;
        }
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String digits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            char c = (char) ('0' + data.consumeInt(0, 9));
            if (i == 0 && len > 1 && c == '0') {
                c = (char) ('1' + data.consumeInt(0, 8));
            }
            sb.append(c);
        }
        return sb.toString();
    }
}
