package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.GregorianCalendar;
import java.util.List;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain-" + data.consumeAsciiString(6),
                    "range-" + data.consumeAsciiString(6),
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 4);
            int afterCount = data.consumeInt(0, 4);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpochDay - i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(dayFromEpochDay(leftEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(dayFromEpochDay(rightEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(dayFromEpochDay(rightEpochDay + i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                return;
            }

            if (!viewsAgree(series)) {
                throw new RuntimeException("[oracle:source-view-agree-after-build] metamorphic violation: source views disagree"
                        + " itemCount=" + series.getItemCount()
                        + " itemsSize=" + series.getItems().size()
                        + " periodsSize=" + series.getTimePeriods().size());
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);

            try {
                exerciseValidEmptyGap(series, start, end, rightEpochDay, afterCount, data);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), Integer.valueOf(1));
            s.add(new Day(31, 1, 2006), Integer.valueOf(1));
            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);

            /* Contract asserted:
               createCopy(start,end) returns a copy of the items whose periods lie in [start,end].
               Here [start,end] is a valid interval fully inside the gap between two existing items,
               so the result must be an empty, detached series. A patch that merely suppresses the
               throw or returns the wrong object breaks the emptiness or later-detachment checks. */
            TimeSeries copy;
            try {
                copy = s.createCopy(start, end);
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:detached-empty-copy] metamorphic violation: valid empty-gap copy rejected", e);
                }
                return;
            }

            assertEmptyCopy(copy, "[oracle:detached-empty-copy]", start, end);

            s.add(new Day(1, 2, 2006), Integer.valueOf(7));
            assertEmptyCopy(copy, "[oracle:detached-empty-copy]", start, end);

            TimeSeries probe;
            try {
                probe = s.createCopy(start, end);
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:detached-empty-copy] metamorphic violation: valid empty-gap copy rejected after source mutation", e);
                }
                return;
            }
