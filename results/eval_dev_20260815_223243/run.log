import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probeBug("1234.5", true);

        probeBug("1eE", false);

        String malformed = buildMalformedPatchedBranchInput(data);
        probeBug(malformed, false);

        String zeroExp = buildZeroExponentZeroInput(data);

        /*
         * Contract visible in NumberUtils.createNumber:
         * for an unsuffixed number with an exponent, createNumber first tries createFloat(str)
         * and returns that Float when it is finite and not a misleading zero; "0...e0..." is all zeros,
         * so zero is not misleading and the returned type must be Float.
         *
         * Likewise, explicit 'F'/'f' requests Float and explicit 'D'/'d' requests Double.
         *
         * This specifically exercises the patched branch (no decimal point, exponent present) at the
         * boundary where the changed mantissa computation affects isAllZeros(mant). A patch that merely
         * prevents the old substring crash by changing mant bookkeeping can still silently choose the
         * wrong numeric type here.
