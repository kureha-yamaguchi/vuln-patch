            if (manualCount != 0) {
                throw new RuntimeException("[oracle:gap-setup] metamorphic violation: constructed gap should be empty but manualCount="
                        + manualCount + " start=" + start + " end=" + end);
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                if (copy.getItemCount() != copy.getItems().size()) {
                    throw new RuntimeException("[oracle:copy-count] metamorphic violation: copy count mismatch itemCount="
                            + copy.getItemCount() + " itemsSize=" + copy.getItems().size()
                            + " start=" + start + " end=" + end);
                }

                int copyManualCount = countItemsInRange(copy, start, end);
                if (copy.getItemCount() != manualCount || copyManualCount != manualCount) {
                    throw new RuntimeException("[oracle:empty-gap-copy] metamorphic violation: empty-range createCopy disagrees with source "
