package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkCreateNumberOnValidInput("1234.5");

        exerciseLiteral("12345");
        exerciseLiteral("1234.5D");
        exerciseLiteral("1234.5d");
        exerciseLiteral("1234.5F");
        exerciseLiteral("1234.5f");
        exerciseLiteral("12345L");
        exerciseLiteral("12345l");
        exerciseLiteral("-1234.5");
        exerciseLiteral("-12345");
        exerciseLiteral("0xFADE");
        exerciseLiteral("-0xFADE");
        exerciseLiteral("1.1E200");
        exerciseLiteral("1.1E20");
        exerciseLiteral("-1.1E200");
        exerciseLiteral("1.1E-200");
        exerciseLiteral("12345678901234567890L");
        exerciseLiteral("1.1E-700F");
        exerciseLiteral("2.");

        String exponentBoundary = buildExponentBoundaryInput(data);
        exerciseBoundaryCandidate(exponentBoundary);

        String baseInt = buildCanonicalInt(data);
        exerciseBoundaryCandidate(baseInt + "E");
        exerciseBoundaryCandidate(baseInt + "e");
        exerciseBoundaryCandidate(baseInt + "E0");
        exerciseBoundaryCandidate(baseInt + "e0");
        exerciseBoundaryCandidate(baseInt + "E+0");
        exerciseBoundaryCandidate(baseInt + "e-0");

        checkIntAgreesWithCreateInteger(buildCanonicalInt(data));
        checkLongSuffixAgreement(data);
        checkBigIntegerFallbackAgreement(data);
        checkDecimalAgreesWithCreateFloat(buildModerateDecimal(data));
    }

    private static void checkCreateNumberOnValidInput(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
        }
    }

    private static void exerciseLiteral(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t) && isKnownValidLiteral(s)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void exerciseBoundaryCandidate(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t) && isValidByConstruction(s)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isKnownValidLiteral(String s) {
        return "1234.5".equals(s)
                || "12345".equals(s)
                || "1234.5D".equals(s)
                || "1234.5d".equals(s)
                || "1234.5F".equals(s)
                || "1234.5f".equals(s)
                || "12345L".equals(s)
                || "12345l".equals(s)
                || "-1234.5".equals(s)
                || "-12345".equals(s)
                || "0xFADE".equals(s)
                || "-0xFADE".equals(s)
                || "1.1E200".equals(s)
                || "1.1E20".equals(s)
                || "-1.1E200".equals(s)
                || "1.1E-200".equals(s)
                || "12345678901234567890L".equals(s)
                || "1.1E-700F".equals(s)
                || "2.".equals(s);
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = s.charAt(0) == '-' ? 1 : 0;
        if (start >= s.length()) {
            return false;
        }
        int ePos = Math.max(s.indexOf('e'), s.indexOf('E'));
        if (ePos >= 0) {
            if (ePos == start || ePos >= s.length() - 1) {
                return false;
            }
            for (int i = start; i < ePos; i++) {
                char c = s.charAt(i);
                if (!Character.isDigit(c) && c != '.') {
                    return false;
                }
            }
            int expStart = ePos + 1;
            if (s.charAt(expStart) == '+' || s.charAt(expStart) == '-') {
                expStart++;
            }
            if (expStart >= s.length()) {
                return false;
            }
            for (int i = expStart; i < s.length(); i++) {
                if (!Character.isDigit(s.charAt(i))) {
                    return false;
                }
            }
            return true;
        }

        int dotCount = 0;
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '.') {
                dotCount++;
                if (dotCount > 1) {
                    return false;
                }
            } else if (!Character.isDigit(c)) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String buildCanonicalInt(FuzzedDataProvider data) {
        int value = data.consumeInt(-1_000_000, 1_000_000);
        return Integer.toString(value);
    }

    private static String buildModerateDecimal(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int whole = data.consumeInt(1, 1_000_000);
        int frac = data.consumeInt(1, 999_999);
        String s = whole + "." + frac;
        return negative ? "-" + s : s;
    }

    private static String buildOversizedInteger(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(19, 40);
        StringBuilder sb = new StringBuilder(len + 1);
        if (negative) {
            sb.append('-');
        }
        sb.append(data.consumeInt(1, 9));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String buildExponentBoundaryInput(FuzzedDataProvider data) {
        String base = buildCanonicalInt(data);
        boolean upper = data.consumeBoolean();
        char e = upper ? 'E' : 'e';
        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            return base + e;
        }
        if (mode == 1) {
            return base + e + "0";
        }
        if (mode == 2) {
            return base + e + "+0";
        }
        if (mode == 3) {
            return base + e + "-0";
        }
        return base + e + Integer.toString(data.consumeInt(-9, 9));
    }

    private static void checkLongSuffixAgreement(FuzzedDataProvider data) {
        String base = Integer.toString(data.consumeInt(-1_000_000, 1_000_000));
        Number plain;
        Number suffixed;
        try {
            plain = NumberUtils.createNumber(base);
            suffixed = NumberUtils.createNumber(base + "L");
        } catch (RuntimeException e) {
            return;
        }
        if (plain == null || suffixed == null) {
            return;
        }

        /* Contract visible in createNumber: adding 'L' requests long/integral parsing of the same
           valid decimal integer literal, so both real library calls must denote the same value. */
        if (plain.longValue() != suffixed.longValue()) {
            throw new RuntimeException("[oracle:long-suffix] metamorphic violation: input=" + base
                    + " plain=" + plain + " suffixed=" + suffixed);
        }
    }

    private static void checkBigIntegerFallbackAgreement(FuzzedDataProvider data) {
        String base = buildOversizedInteger(data);
        Number plain;
        Number suffixed;
        BigInteger direct;
        try {
            plain = NumberUtils.createNumber(base);
            suffixed = NumberUtils.createNumber(base + "L");
            direct = NumberUtils.createBigInteger(base);
        } catch (RuntimeException e) {
            return;
        }
        if (plain == null || suffixed == null || direct == null) {
            return;
        }

        /* Contract visible in createNumber: an oversized decimal integer is parsed as BigInteger,
           and the 'L' branch falls back to createBigInteger when createLong overflows. */
        BigInteger plainValue = toBigInteger(plain);
        BigInteger suffixedValue = toBigInteger(suffixed);
        if (!direct.equals(plainValue) || !direct.equals(suffixedValue)) {
            throw new RuntimeException("[oracle:bigint-fallback] metamorphic violation: input=" + base
                    + " direct=" + direct + " plain=" + plain + " suffixed=" + suffixed);
        }
    }

    private static void checkDecimalAgreesWithCreateFloat(String s) {
        Float viaFloat;
        try {
            viaFloat = NumberUtils.createFloat(s);
        } catch (RuntimeException t) {
            return;
        }

        Number viaNumber;
        try {
            viaNumber = NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        /* Contract visible in createNumber: with dec != null and our generator producing moderate,
           non-zero decimals without suffixes or exponents, createNumber tries createFloat(str)
           first and returns that Float unless it is infinite or an imprecise zero. */
        if (!(viaNumber instanceof Float) || ((Float) viaNumber).floatValue() != viaFloat.floatValue()) {
            throw new RuntimeException(
                    "[oracle:decimal-float] metamorphic violation: createNumber disagrees with createFloat input="
                            + s + " lhs=" + viaNumber + " rhs=" + viaFloat);
        }
    }

    private static void checkIntAgreesWithCreateInteger(String s) {
        Integer viaInt;
        try {
            viaInt = NumberUtils.createInteger(s);
        } catch (RuntimeException t) {
            return;
        }

        Number viaNumber;
        try {
            viaNumber = NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && hasRelevantStack(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        /* Contract visible in createNumber: when dec == null and exp == null, it tries
           createInteger(str) before wider integer types. For canonical in-range decimal integers,
           both real library calls must therefore agree exactly. */
        if (!(viaNumber instanceof Integer) || viaNumber.intValue() != viaInt.intValue()) {
            throw new RuntimeException(
                    "[oracle:int-helper] metamorphic violation: createNumber disagrees with createInteger input="
                            + s + " lhs=" + viaNumber + " rhs=" + viaInt);
        }
    }

