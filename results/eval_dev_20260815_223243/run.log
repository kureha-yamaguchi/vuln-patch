    private static void addValue(TimeSeries series, Day day, int value) {
        series.add(day, new Integer(value));
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        int n = series.getItemCount();
        for (int i = 0; i < n; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int safeGetIndex(TimeSeries series, RegularTimePeriod period) {
        try {
            return series.getIndex(period);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return Integer.MIN_VALUE;
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(1970, java.util.Calendar.JANUARY, 1, 0, 0, 0);
        cal.add(java.util.Calendar.DATE, epochDay);
        return new Day(cal.getTime(), java.util.TimeZone.getTimeZone("UTC"));
    }

    private static boolean isValidationFamily(Throwable t) {
        Throwable x = t;
        while (x != null) {
            if (x instanceof IllegalArgumentException || x instanceof NumberFormatException) {
                return true;
            }
            String name = x.getClass().getName();
            if (name != null && (name.indexOf("SeriesException") >= 0 || name.indexOf("Invalid") >= 0)) {
                return true;
            }
            x = x.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable x = t;
        while (x != null) {
            if (x instanceof IllegalArgumentException) {
                StackTraceElement[] st = x.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    String cls = st[i].getClassName();
                    String method = st[i].getMethodName();
                    if ("org.jfree.data.time.TimeSeries".equals(cls)
                            && ("createCopy".equals(method) || "getIndex".equals(method))) {
                        return true;
                    }
                }
            }
            x = x.getCause();
        }
        return false;
    }
