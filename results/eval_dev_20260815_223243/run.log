    private static void exerciseValidCsvIdentityInput(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /* Contract/oracle:
             * CSV escaping only adds quoting/escaping when the input contains CSV special
             * characters. We build inputs by construction from safe BMP chars plus well-formed
             * surrogate pairs, excluding ',', '"', '\r', and '\n'. Therefore every correct
             * implementation must return the original string unchanged. A throw-deleting or
             * bookkeeping-breaking patch that silently skips/misprocesses code points would
             * violate this observable result.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: safe CSV input must remain unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }

