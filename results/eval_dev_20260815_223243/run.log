    private static boolean isRootCauseFromToBoolean(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
