package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30", true, true);
        runCase("\uD800\uDC00", true, true);
        runCase("\uD834\uDD1E", true, true);
        runCase("\uDBFF\uDFFD", true, true);

        String prefix = sanitizeSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeSafeAscii(data.consumeAsciiString(16));
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder(prefix);
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                sb.append(sanitizeSafeAscii(data.consumeAsciiString(8)));
            }
        }
        sb.append(suffix);

        String validSafeInput = sb.toString();
        if (validSafeInput.length() > 0) {
            runCase(validSafeInput, true, true);
        }

        String maybeUnsafe = data.consumeRemainingAsString();
        if (maybeUnsafe != null && maybeUnsafe.length() > 0 && !containsCsvMeta(maybeUnsafe) && containsWellFormedSurrogatePair(maybeUnsafe)) {
            runCase(maybeUnsafe, true, true);
        }
    }

    private static void runCase(String input, boolean validByConstruction, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: CSV escaping only encloses/escapes when required by CSV syntax.
             * For inputs we build to contain no comma, quote, CR, or LF, the result must be
             * exactly the original input. A patch that merely avoids the exception by skipping
             * or mis-advancing through surrogate pairs would violate this observable post-condition.
             */
            if (assertIdentity && !containsCsvMeta(input) && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV input must remain unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("translate".equals(m)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static boolean containsCsvMeta(String s) {
        return s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\r') >= 0 || s.indexOf('\n') >= 0;
    }

    private static boolean containsWellFormedSurrogatePair(String s) {
        for (int i = 0; i + 1 < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i)) && Character.isLowSurrogate(s.charAt(i + 1))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return Arrays.toString(s.toCharArray());
    }
}
