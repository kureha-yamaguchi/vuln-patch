    private static Day dayFromOffset(int offsetDays) {
        java.util.GregorianCalendar cal =
                new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(2000, java.util.Calendar.JANUARY, 1, 12, 0, 0);
        cal.add(java.util.Calendar.DAY_OF_MONTH, offsetDays);
        return new Day(cal.getTime());
    }
