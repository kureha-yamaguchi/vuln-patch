package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static final String[] ANCHORS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (String anchor : ANCHORS) {
            exerciseEscapeCsv(anchor);
        }

        String explored = buildSafeCsvInputWithSupplementary(data);
        exerciseEscapeCsv(explored);

        String explored2 = buildSafeCsvInputWithSupplementary(data) + buildSafeCsvInputWithSupplementary(data);
        exerciseEscapeCsv(explored2);
    }

    private static void exerciseEscapeCsv(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle: CSV escaping leaves strings that contain none of the CSV
             * metacharacters (comma, quote, CR, LF) unchanged. The failing test itself
             * asserts this for surrogate-pair-only inputs. Our generated inputs are valid
             * Java strings and are built to avoid those metacharacters by construction, so
             * a correct implementation is obliged to return the original input verbatim.
             * A patch that merely suppresses the crash but skips or corrupts translation
             * would violate this observable post-condition.
             */
            if (!input.equals(out)) {
                throw new RuntimeException(
                    "[oracle:escapeCsv-identity] metamorphic violation: safe CSV input must remain unchanged"
                        + " input=" + printable(input)
                        + " lhs=" + printable(out)
                        + " rhs=" + printable(input));
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (NumberFormatException e) {
            return;
        } catch (RuntimeException e) {
            if (e instanceof RuntimeException && e.getMessage() != null
                    && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("translate".equals(method)
