    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probeValid("1234.5");

        checkZeroScientificTypeSelection("0E0");
        checkZeroScientificTypeSelection("0e0");
        checkEquivalentZeroScientificForms("0E0");

        String base = buildZeroScientificNoDot(data);
        if (base != null) {
            probeValid(base);
            checkZeroScientificTypeSelection(base);
            checkEquivalentZeroScientificForms(base);
        }

        String nearby = buildNearbyBoundaryInput(data);
        if (nearby != null) {
            probePossiblyInvalid(nearby);
        }
    }

