        if (!sameVertices(before, again) || !sameVertices(before, fromTwin)) {
            throw new RuntimeException("[oracle:vertices-stable] metamorphic violation: repeated/fresh getVertices disagreement");
        }
        if (before.length != 0) {
            return;
        }
        if (!(approx(size, 0.0) && bary != null && approx(bary.getX(), 0.0) && approx(bary.getY(), 0.0))) {
            throw new RuntimeException("[oracle:empty-region-summary] metamorphic violation: vertices=0 size=" + size
                    + " bary=" + String.valueOf(bary));
        }
    }

