package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runEscapeCsvIdentity("\uD83D\uDE30");
        runEscapeCsvIdentity("\uD800\uDC00");
        runEscapeCsvIdentity("\uD834\uDD1E");
        runEscapeCsvIdentity("\uDBFF\uDFFD");

        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        String pair = new String(Character.toChars(codePoint));

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(8));

        String s1 = prefix + pair + suffix;
        runEscapeCsvIdentity(s1);

        String mid1 = sanitizeCsvSafe(data.consumeAsciiString(6));
        String mid2 = sanitizeCsvSafe(data.consumeAsciiString(6));
        String s2 = prefix + pair + mid1 + pair + mid2 + suffix;
        runEscapeCsvIdentity(s2);

        if (data.consumeBoolean()) {
            String extra = sanitizeCsvSafe(data.consumeAsciiString(12));
            runEscapeCsvIdentity(extra + pair);
            runEscapeCsvIdentity(pair + extra);
        }
    }

    private static void runEscapeCsvIdentity(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);
            /*
             * Contract/oracle: CSV escaping leaves strings unchanged when they contain
             * no comma, quote, CR, or LF. The anchor seeds are exactly the upstream
             * regression test and the explored inputs are built by construction from
             * CSV-safe ASCII plus valid supplementary code points, so a correct
             * implementation must return the original input verbatim.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
