package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzz = buildValidUtf16WithSurrogatePairsAndNoCsvMeta(data);
        if (fuzz == null) {
            return;
        }

        try {
            String escaped = StringEscapeUtils.escapeCsv(fuzz);

            /* Contract/oracle:
             * StringEscapeUtils.escapeCsv only quotes/escapes CSV-special content. For an input
             * constructed to contain no comma, quote, CR, or LF, a correct implementation must
             * return the original string unchanged. This detects "fixes" that merely avoid the
             * crash by skipping/wrongly advancing through surrogate pairs and thus corrupt output.
             */
            if (!fuzz.equals(escaped)) {
                throw new RuntimeException("[oracle:unchanged-no-csv-meta] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input="
                        + printable(fuzz) + " lhs=" + printable(escaped) + " rhs=" + printable(fuzz));
            }

            // Same contract as above, exercised on concatenation to vary positions/lengths.
            String suffix = safeAscii(data.consumeAsciiString(16));
            if (suffix.length() > 0) {
                String combined = fuzz + suffix;
                try {
                    String combinedEscaped = StringEscapeUtils.escapeCsv(combined);
                    if (!combined.equals(combinedEscaped)) {
                        throw new RuntimeException("[oracle:concat-unchanged-no-csv-meta] metamorphic violation: escapeCsv must leave CSV-safe concatenation unchanged input="
                                + printable(combined) + " lhs=" + printable(combinedEscaped) + " rhs=" + printable(combined));
                    }
                } catch (RuntimeException t) {
                    if (isCleanRejection(t)) {
                        return;
                    }
                    if (isRootCause(t, true)) {
                        throw t;
                    }
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t, true)) {
                throw t;
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(escaped)) {
                throw new RuntimeException("[oracle:anchor-unchanged] metamorphic violation: escapeCsv must leave surrogate-pair CSV-safe input unchanged input="
                        + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t, true)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidUtf16WithSurrogatePairsAndNoCsvMeta(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(0, 16);
        int pairCount = data.consumeInt(1, 6);
        int suffixLen = data.consumeInt(0, 16);

        StringBuilder sb = new StringBuilder(prefixLen + pairCount * 2 + suffixLen);
        appendSafeAscii(sb, safeAscii(data.consumeAsciiString(prefixLen)));
        for (int i = 0; i < pairCount; i++) {
            int high = data.consumeInt(0xD800, 0xDBFF);
            int low = data.consumeInt(0xDC00, 0xDFFF);
            sb.append((char) high).append((char) low);

            if (data.consumeBoolean()) {
                appendSafeAscii(sb, safeAscii(data.consumeAsciiString(data.consumeInt(0, 4))));
            }
        }
        appendSafeAscii(sb, safeAscii(data.consumeAsciiString(suffixLen)));

        String s = sb.toString();
        if (s.length() == 0) {
            return null;
        }
        return s;
    }

    private static void appendSafeAscii(StringBuilder sb, String s) {
        sb.append(s);
    }

    private static String safeAscii(String in) {
        if (in == null || in.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(in.length());
        for (int i = 0; i < in.length(); i++) {
            char c = in.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('a');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('b');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
