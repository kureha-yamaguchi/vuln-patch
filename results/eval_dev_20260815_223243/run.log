    private static void checkWholeOrEmptyFromChildLeaf(boolean inside) {
        Line line = new Line(new Vector2D(0.0, 0.0), new Vector2D(1.0, 0.0));
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(null, null);
        BSPTree<Euclidean2D> tree =
            new BSPTree<Euclidean2D>(line.wholeHyperplane(), plus, minus, attribute);
        PolygonsSet region = new PolygonsSet(tree);

        double size;
        Vector2D barycenter;
        try {
            size = region.getSize();
            barycenter = (Vector2D) region.getBarycenter();
        } catch (ClassCastException cce) {
            if (isRootCause(cce)) {
                throw new RuntimeException(
                    "[oracle:flip-cond] metamorphic violation: child-leaf classification crashed for inside=" + inside,
                    cce);
            }
            throw cce;
        }

        if (inside) {
            if (!Double.isInfinite(size) || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                throw new RuntimeException(
                    "[oracle:flip-cond] metamorphic violation: expected whole space from child leaf true"
                        + " size=" + size + " barycenter=(" + barycenter.getX() + "," + barycenter.getY() + ")");
            }
        } else {
            if (size != 0.0 || barycenter.getX() != 0.0 || barycenter.getY() != 0.0) {
                throw new RuntimeException(
                    "[oracle:flip-cond] metamorphic violation: expected empty space from child leaf false"
                        + " size=" + size + " barycenter=(" + barycenter.getX() + "," + barycenter.getY() + ")");
            }
        }
    }

    private static void checkTranslationMetamorphic(float[] coords, float tx, float ty, float tz) {
        PolyhedronsSet a;
        PolyhedronsSet b;
        try {
            a = buildPolyhedron(coords);
            b = buildPolyhedron(translate(coords, tx, ty, tz));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        double sizeA;
        double sizeB;
        Vector3D baryA;
        Vector3D baryB;
        try {
            sizeA = a.getSize();
            baryA = (Vector3D) a.getBarycenter();
            sizeB = b.getSize();
            baryB = (Vector3D) b.getBarycenter();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        double sizeTol = Math.max(1.0e-9, Math.abs(sizeA) * 1.0e-6);
        if (Math.abs(sizeA - sizeB) > sizeTol) {
            throw new RuntimeException(
                "[oracle:xlate] metamorphic violation: translation changed size"
                    + " sizeA=" + sizeA + " sizeB=" + sizeB
                    + " delta=(" + tx + "," + ty + "," + tz + ")");
        }

        if (!close(baryA.getX() + tx, baryB.getX())
            || !close(baryA.getY() + ty, baryB.getY())
            || !close(baryA.getZ() + tz, baryB.getZ())) {
            throw new RuntimeException(
                "[oracle:xlate] metamorphic violation: translation did not translate barycenter"
                    + " baryA=(" + baryA.getX() + "," + baryA.getY() + "," + baryA.getZ() + ")"
                    + " baryB=(" + baryB.getX() + "," + baryB.getY() + "," + baryB.getZ() + ")"
                    + " delta=(" + tx + "," + ty + "," + tz + ")");
        }

        checkBarycenterWithinInputBounds(coords, baryA, "orig");
        checkBarycenterWithinInputBounds(translate(coords, tx, ty, tz), baryB, "translated");
    }

    private static void checkBarycenterWithinInputBounds(float[] coords, Vector3D bary, String label) {
        float minX = coords[0], maxX = coords[0];
        float minY = coords[1], maxY = coords[1];
        float minZ = coords[2], maxZ = coords[2];
        for (int i = 3; i < coords.length; i += 3) {
            if (coords[i] < minX) minX = coords[i];
            if (coords[i] > maxX) maxX = coords[i];
            if (coords[i + 1] < minY) minY = coords[i + 1];
            if (coords[i + 1] > maxY) maxY = coords[i + 1];
            if (coords[i + 2] < minZ) minZ = coords[i + 2];
            if (coords[i + 2] > maxZ) maxZ = coords[i + 2];
        }
        double eps = 1.0e-6;
        if (bary.getX() < minX - eps || bary.getX() > maxX + eps
            || bary.getY() < minY - eps || bary.getY() > maxY + eps
            || bary.getZ() < minZ - eps || bary.getZ() > maxZ + eps) {
            throw new RuntimeException(
                "[oracle:bbox] metamorphic violation: barycenter escaped input bounds"
                    + " label=" + label
                    + " bary=(" + bary.getX() + "," + bary.getY() + "," + bary.getZ() + ")"
                    + " bounds=[(" + minX + "," + minY + "," + minZ + "),("
                    + maxX + "," + maxY + "," + maxZ + ")]");
        }
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords) {
        ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
            new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();
        for (int i = 0; i < ISSUE780_INDICES.length; i += 3) {
            Vector3D v1 = vertex(coords, ISSUE780_INDICES[i]);
            Vector3D v2 = vertex(coords, ISSUE780_INDICES[i + 1]);
            Vector3D v3 = vertex(coords, ISSUE780_INDICES[i + 2]);

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            PolygonsSet facetRegion = buildTriangleRegion(p1, p2, p3);
            facets.add(new SubPlane(plane, facetRegion));
        }
        return new PolyhedronsSet(facets);
    }

    private static PolygonsSet buildTriangleRegion(Vector2D p1, Vector2D p2, Vector2D p3) {
        Collection<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
        edges.add(edge(p1, p2));
        edges.add(edge(p2, p3));
        edges.add(edge(p3, p1));
        return new PolygonsSet(edges);
    }

    private static SubHyperplane<Euclidean2D> edge(Vector2D a, Vector2D b) {
        Line line = new Line(a, b);
        double start = line.toSubSpace(a).getX();
        double end = line.toSubSpace(b).getX();
        return new SubLine(line, new IntervalsSet(start, end));
    }

    private static void triggerIssue780(float[] coords) {
        PolyhedronsSet poly = buildPolyhedron(coords);
        poly.getSize();
        poly.getBarycenter();
    }

    private static Vector3D vertex(float[] coords, int index) {
        int i = index * 3;
        return new Vector3D(coords[i], coords[i + 1], coords[i + 2]);
    }

    private static float[] translate(float[] coords, float tx, float ty, float tz) {
        float[] out = coords.clone();
        for (int i = 0; i < out.length; i += 3) {
            out[i] += tx;
            out[i + 1] += ty;
            out[i + 2] += tz;
        }
        return out;
    }

    private static boolean close(double a, double b) {
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-6 * scale;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(ste.getClassName())
                && ("computeGeometricalProperties".equals(ste.getMethodName())
                    || "getVertices".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.startsWith("org.apache.commons.math3.exception.");
    }
}
