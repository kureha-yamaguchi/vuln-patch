package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static final String[] ANCHOR_INPUTS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (int i = 0; i < ANCHOR_INPUTS.length; i++) {
            exerciseValidCsvSafeInput(ANCHOR_INPUTS[i]);
        }

        String explored = buildValidCsvSafeStringWithSupplementaryCodePoints(data);
        exerciseValidCsvSafeInput(explored);
    }

    private static void exerciseValidCsvSafeInput(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract used for this oracle:
             * StringEscapeUtils.escapeCsv only quotes/escapes CSV-special inputs.
             * For inputs containing none of ',', '"', '\r', '\n', the result must be unchanged.
             * We build such inputs by construction, while also ensuring they contain real supplementary
             * characters (UTF-16 surrogate pairs), so a throw-deleting or branch-skipping patch that
             * silently drops/mangles surrogate handling will violate this observable result.
             */
            if (!containsCsvSpecial(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static String buildValidCsvSafeStringWithSupplementaryCodePoints(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixChunks = data.consumeInt(0, 3);
        for (int i = 0; i < prefixChunks; i++) {
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
        }

        int supplementaryCount = data.consumeInt(1, 4);
        for (int i = 0; i < supplementaryCount; i++) {
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
            }
            int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
            sb.appendCodePoint(cp);
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
            }
        }

        int suffixChunks = data.consumeInt(0, 3);
        for (int i = 0; i < suffixChunks; i++) {
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
        }

        if (sb.length() == 0) {
            sb.appendCodePoint(0x10000);
        }
        return sb.toString();
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                out.append('A');
            } else {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static boolean containsCsvSpecial(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && hasRelevantTranslateFrame(t);
    }

    private static boolean hasRelevantTranslateFrame(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            String cls = f.getClassName();
            String method = f.getMethodName();
            if ("translate".equals(method)
                && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
