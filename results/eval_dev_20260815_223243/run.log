package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off", true);

        String direct = data.consumeAsciiString(32);
        if (direct != null && direct.length() == 3 && !startsWithYOrY(direct)) {
            exercise(direct, true);
        }

        String surrounding = data.consumeAsciiString(64);
        if (surrounding != null && surrounding.length() >= 3) {
            int start = data.consumeInt(0, surrounding.length() - 3);
            String sub = surrounding.substring(start, start + 3);
            if (!startsWithYOrY(sub)) {
                exercise(sub, true);
            } else {
                exercise(sub, false);
            }
        }

        int count = data.consumeInt(1, 6);
        for (int i = 0; i < count; i++) {
            String candidate = buildThreeCharCandidate(data);
            exercise(candidate, true);
        }

        String maybeOther = data.consumeRemainingAsString();
        if (maybeOther != null) {
            if (maybeOther.length() == 3 && !startsWithYOrY(maybeOther)) {
                exercise(maybeOther, true);
            } else {
                exercise(maybeOther, false);
            }
        }

        String trueToken = buildCaseVariant(data, "true");
        checkCaseInsensitiveTrue(trueToken);

        String onToken = buildCaseVariant(data, "on");
        checkCaseInsensitiveTrue(onToken);

        String yesToken = buildCaseVariant(data, "yes");
        checkCaseInsensitiveTrue(yesToken);
    }

    private static void exercise(String s, boolean shouldPropagateRootCause) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (shouldPropagateRootCause && isRootCauseFromToBoolean(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCauseFromToBoolean(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean startsWithYOrY(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        char c = s.charAt(0);
        return c == 'y' || c == 'Y';
    }

    private static String buildThreeCharCandidate(FuzzedDataProvider data) {
        char c0 = nextAsciiNonY(data);
        char c1 = nextAscii(data);
        char c2 = nextAscii(data);
        return new String(new char[] { c0, c1, c2 });
    }

    private static char nextAscii(FuzzedDataProvider data) {
        return (char) data.consumeInt(32, 126);
    }

    private static char nextAsciiNonY(FuzzedDataProvider data) {
        char c = nextAscii(data);
        if (c == 'y' || c == 'Y') {
            return 'x';
        }
        return c;
    }

    private static String buildCaseVariant(FuzzedDataProvider data, String canonical) {
        char[] chars = canonical.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static void checkCaseInsensitiveTrue(String token) {
        try {
            boolean lhs = BooleanUtils.toBoolean(token);
            boolean rhs = BooleanUtils.toBoolean(token.toUpperCase());
            boolean canonical = BooleanUtils.toBoolean(token.toLowerCase());
            /* Contract/oracle: BooleanUtils.toBoolean(String) recognizes the true tokens
             * "true", "on", and "yes" case-insensitively (as shown by the implementation and
             * the test cases). For any case-variant constructed from one of those canonical
             * tokens, all equivalent case variants must parse to the same boolean value. A
             * throw-deleting or branch-skipping patch that avoids the buggy path but returns a
             * wrong value for some case pattern would violate this sibling/equivalent-input
             * relation. */
            if (!(lhs == rhs && rhs == canonical && canonical)) {
                throw new RuntimeException("[oracle:case-true] metamorphic violation: equivalent case variants must agree and be true input="
                        + token + " lhs=" + lhs + " rhs=" + rhs + " canonical=" + canonical);
            }
        } catch (Throwable ignored) {
            return;
        }
    }
}
