package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorFromRegressionTest();
        exploreNullReplacementProperty(data);
        crossCheckSinglePairAgreement(data);
    }

    private static void anchorFromRegressionTest() {
        checkNullResult(null, new String[] { "a" }, new String[] { "b" }, "anchor-null-text");
        checkEquals("aba", null, null, "aba", "anchor-null-arrays");
        checkEquals("aba", new String[0], null, "aba", "anchor-empty-search");
        checkEquals("aba", null, new String[0], "aba", "anchor-empty-replacement");
        checkEquals("aba", new String[] { "a" }, null, "aba", "anchor-null-replacement-array");
        checkEquals("aba", new String[] { null }, new String[] { "a" }, "aba", "anchor-null-search-element");
        checkEquals("aba", new String[] { "a" }, new String[] { null }, "aba", "anchor-null-replacement-element");
        checkEquals("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "anchor-mixed-null-replacement");
    }

    private static void exploreNullReplacementProperty(FuzzedDataProvider data) {
        String search = data.consumeAsciiString(8);
        if (search.length() == 0) {
            search = "a";
        }

        String prefix = data.consumeString(16);
        String middle = data.consumeString(16);
        String suffix = data.consumeRemainingAsString();
        String text = prefix + search + middle + search + suffix;

        try {
            String result = StringUtils.replaceEach(text, new String[] { search }, new String[] { null });
            /*
             * Contract asserted from the regression test:
             * replaceEach(text, new String[]{"a"}, new String[]{null}) returns the original text.
             * A correct implementation ignores null replacement elements rather than crashing or
             * silently changing the output.
             */
            if (!text.equals(result)) {
                throw new RuntimeException(
                    "[oracle:null-repl] metamorphic violation: null replacement element must leave text unchanged input="
                        + safe(text) + " search=" + safe(search) + " result=" + safe(result));
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
        }
    }

    private static void crossCheckSinglePairAgreement(FuzzedDataProvider data) {
        String search = data.consumeAsciiString(6);
        if (search.length() == 0) {
            search = "x";
        }

        String replacement = data.consumeString(8);
        if (replacement == null) {
            replacement = "";
        }

        String left = data.consumeString(12);
        String right = data.consumeRemainingAsString();
        String text = left + search + right;

        try {
            String viaEach = StringUtils.replaceEach(text, new String[] { search }, new String[] { replacement });
            String viaSingle = StringUtils.replace(text, search, replacement);
            /*
             * Sound sibling-agreement check:
             * replaceEach is the array-valued generalization of replacement; with exactly one
             * search/replacement pair, it must agree with StringUtils.replace on the same inputs.
             * A patch that merely suppresses the crash but skips or mangles the replacement will
             * violate this observable post-condition.
             */
            if (!ObjectUtils.equals(viaEach, viaSingle)) {
                throw new RuntimeException(
                    "[oracle:single-pair-agree] consistency violation: replaceEach(single pair) must match replace input="
                        + safe(text) + " search=" + safe(search) + " replacement=" + safe(replacement)
                        + " lhs=" + safe(viaEach) + " rhs=" + safe(viaSingle));
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
        }
    }

    private static void checkNullResult(String text, String[] searchList, String[] replacementList, String label) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (actual != null) {
                throw new RuntimeException("[oracle:" + label + "] expected null but got " + safe(actual));
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
        }
    }

    private static void checkEquals(String text, String[] searchList, String[] replacementList, String expected, String label) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (!ObjectUtils.equals(actual, expected)) {
                throw new RuntimeException(
                    "[oracle:" + label + "] expected=" + safe(expected) + " actual=" + safe(actual));
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
        }
    }

    private static boolean shouldPropagate(RuntimeException t, boolean validByConstruction) {
        if (isOracleFailure(t)) {
            return true;
        }
        if (isCleanRejection(t)) {
            return false;
        }
        return validByConstruction && isRootCause(t);
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())) {
                if ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName())) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String safe(String s) {
        return s == null ? "null" : s;
    }
}
