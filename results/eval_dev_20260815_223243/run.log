    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int itemCount = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();
        if (itemCount != itemsSize || itemCount != periodsSize) {
            throw new RuntimeException("[oracle:" + label + "-consistency] metamorphic violation: series views disagree"
                    + " itemCount=" + itemCount
                    + " itemsSize=" + itemsSize
                    + " periodsSize=" + periodsSize);
        }

        int manual = 0;
        for (int i = 0; i < itemCount; i++) {
            if (series.getDataItem(i) == null || series.getTimePeriod(i) == null) {
                throw new RuntimeException("[oracle:" + label + "-nonnull] metamorphic violation: indexed item/period unexpectedly null"
                        + " index=" + i);
            }
            manual++;
        }
        if (manual != itemCount) {
            throw new RuntimeException("[oracle:" + label + "-manual-count] metamorphic violation: manual iteration count disagrees"
                    + " manual=" + manual
                    + " itemCount=" + itemCount);
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement frame = trace[i];
            if ("org.jfree.data.time.TimeSeries".equals(frame.getClassName())
                    && ("createCopy".equals(frame.getMethodName())
                    || "getIndex".equals(frame.getMethodName())
                    || "clone".equals(frame.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static Day dayFromEpochDay(int epochDay) {
        long millis = ((long) epochDay) * 86400000L;
        return new Day(new java.util.Date(millis));
    }
