package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probe("off", true);

        String raw3 = data.consumeAsciiString(3);
        String candidate1 = forceLengthThree(raw3);
        candidate1 = forceFirstCharNotY(candidate1, data.consumeByte());
        probe(candidate1, true);
        assertInvalidLen3ReturnsFalse(candidate1);

        String surrounded = data.consumeAsciiString(12);
        String candidate2;
        if (surrounded.length() >= 3) {
            int start = data.consumeInt(0, surrounded.length() - 3);
            candidate2 = surrounded.substring(start, start + 3);
        } else {
            candidate2 = forceLengthThree(surrounded);
        }
        candidate2 = new StringBuffer().append(candidate2).toString();
        candidate2 = forceFirstCharNotY(candidate2, data.consumeByte());
        probe(candidate2, true);
        assertInvalidLen3ReturnsFalse(candidate2);

        String candidate3 = new StringBuffer()
                .append((char) chooseNonYAscii(data.consumeByte()))
                .append((char) printableAscii(data.consumeByte()))
                .append((char) printableAscii(data.consumeByte()))
                .toString();
        probe(candidate3, true);
        assertInvalidLen3ReturnsFalse(candidate3);

        String candidate4 = forceLengthThree(data.consumeRemainingAsString());
        candidate4 = forceFirstCharNotY(candidate4, data.consumeByte());
        probe(candidate4, true);
        assertInvalidLen3ReturnsFalse(candidate4);

        String yesVariant = randomCase("yes", data);
        assertKnownTrueToken(yesVariant);
        String onVariant = randomCase("on", data);
        assertKnownTrueToken(onVariant);
        String trueVariant = randomCase("true", data);
        assertKnownTrueToken(trueVariant);
    }

    private static void probe(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void assertInvalidLen3ReturnsFalse(String s) {
        if (s == null || s.length() != 3) {
            return;
        }
        char ch = s.charAt(0);
        if (ch == 'y' || ch == 'Y') {
            return;
        }

        try {
            boolean result = BooleanUtils.toBoolean(s);
            /* Contract/oracle:
             * BooleanUtils.toBoolean(String) recognizes only case-insensitive "true",
             * "on", and "yes" as true; otherwise it returns false.
             * For any non-null 3-char string whose first char is neither 'y' nor 'Y',
             * the 3-char "yes" branch cannot match, so a correct implementation must
             * return false. A patch that merely suppresses the crash but returns the
             * wrong value is caught here.
             */
            if (result) {
                throw new RuntimeException("[oracle:len3-false] metamorphic violation: invalid 3-char non-yes input must return false input=" + quote(s) + " lhs=" + result + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void assertKnownTrueToken(String s) {
        try {
            boolean result = BooleanUtils.toBoolean(s);
            /* Contract/oracle:
             * The parser explicitly accepts upper/lower-case variants of "yes", "on",
             * and "true" as true. For a string constructed solely by randomizing the
             * case of one of those canonical tokens, a correct implementation must
             * still return true.
             */
            if (!result) {
                throw new RuntimeException("[oracle:true-token] metamorphic violation: case variant of accepted token must return true input=" + quote(s) + " lhs=" + result + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String forceLengthThree(String s) {
        if (s == null) {
            s = "";
        }
        if (s.length() == 3) {
            return s;
        }
        if (s.length() > 3) {
            return s.substring(0, 3);
        }
        StringBuffer sb = new StringBuffer(s);
        while (sb.length() < 3) {
            sb.append('a');
        }
        return sb.toString();
    }

    private static String forceFirstCharNotY(String s, byte b) {
        if (s == null || s.length() != 3) {
            s = forceLengthThree(s);
        }
        char first = chooseNonYAscii(b);
        return new StringBuffer()
                .append(first)
                .append(s.charAt(1))
                .append(s.charAt(2))
                .toString();
    }

    private static char chooseNonYAscii(byte b) {
        char c = printableAscii(b);
        if (c == 'y' || c == 'Y') {
            return 'o';
        }
        return c;
    }

    private static char printableAscii(byte b) {
        int v = b & 0xFF;
        return (char) (32 + (v % 95));
    }

    private static String randomCase(String token, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < token.length(); i++) {
            char c = token.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(c) : Character.toLowerCase(c));
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
