import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing test input first.
        try {
            boolean off = BooleanUtils.toBoolean("off");
            // Contract visible in the original failing test: "off" must be handled and return false.
            if (off) {
                throw new RuntimeException("[oracle:off-false] metamorphic violation: BooleanUtils.toBoolean(\"off\") must be false input=off lhs=" + off + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromToBoolean(t)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
            return;
        }

        // EXPLORE 1: fuzz many valid-by-construction 3-char strings that are not "yes" in any case.
        // A correct implementation is obliged to accept arbitrary strings and return false for unknown tokens;
        // the failing test demonstrates this for several non-canonical inputs including "off", "oof", and "yep".
        String invalid3 = forceLength(data.consumeAsciiString(3), 3, 'x');
        if (equalsIgnoreCaseAscii(invalid3, "yes")) {
            invalid3 = invalid3.substring(0, 2) + "x";
        }
        try {
            boolean parsed = BooleanUtils.toBoolean(invalid3);
            if (parsed) {
                throw new RuntimeException("[oracle:invalid3-false] metamorphic violation: unknown 3-char token must map to false input=" + invalid3 + " lhs=" + parsed + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromToBoolean(t)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
            return;
        }

        // EXPLORE 2: case-insensitive accepted token "yes" must parse to true for any casing.
        String yesVariant = randomCase("yes", data);
        try {
            boolean parsed = BooleanUtils.toBoolean(yesVariant);
            if (!parsed) {
                throw new RuntimeException("[oracle:yes-true] metamorphic violation: case-insensitive \"yes\" must map to true input=" + yesVariant + " lhs=" + parsed + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromToBoolean(t)) {
