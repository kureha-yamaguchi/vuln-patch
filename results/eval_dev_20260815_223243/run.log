package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        String effectiveSearch = normalizeToken(data.consumeAsciiString(3), "a");
        String ignoredSearch = normalizeDifferentToken(data.consumeAsciiString(3), effectiveSearch, "b");
        String replacement = normalizeToken(data.consumeAsciiString(4), "c");
        String middle = sanitizeBody(data.consumeAsciiString(12));

        String text = effectiveSearch + middle + ignoredSearch + effectiveSearch;
        String prefix = makeSentinelPrefix(data.consumeInt(1, 6));

        String[] searchList = new String[] { effectiveSearch, ignoredSearch };
        String[] replacementList = new String[] { replacement, null };

        String base;
        String withPrefix;
        try {
            base = StringUtils.replaceEach(text, searchList, replacementList);
            withPrefix = StringUtils.replaceEach(prefix + text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isRootCauseFromPatchedRegion(t)) {
                throw t;
            }
            return;
        }

        if (base == null || withPrefix == null) {
            return;
        }

        /*
         * Contract used for this oracle:
         * replaceEach only replaces occurrences of the given search strings.
         * We construct prefix from '~', a character excluded from every search token,
         * so no match can occur inside the prefix or across the prefix/text boundary.
         * Therefore a correct implementation must satisfy:
         * replaceEach(prefix + text, search, repl) == prefix + replaceEach(text, search, repl)
         * even when another pair in replacementList is null and must be ignored.
         * A throw-deleting patch that silently skips work or corrupts replacement bookkeeping
         * breaks this relation without needing the original NPE.
         */
        String expected = prefix + base;
        if (!expected.equals(withPrefix)) {
            throw new RuntimeException(
                "[oracle:untouched-prefix] metamorphic violation: prefix unaffected by replaceEach input="
                    + text + " prefix=" + prefix + " lhs=" + withPrefix + " rhs=" + expected);
        }

        int expectedLen = StringUtils.length(prefix) + StringUtils.length(base);
        int actualLen = StringUtils.length(withPrefix);
        if (actualLen != expectedLen) {
            throw new RuntimeException(
                "[oracle:prefix-length] metamorphic violation: composed length mismatch input="
                    + text + " prefix=" + prefix + " lhsLen=" + actualLen + " rhsLen=" + expectedLen);
        }
    }

    private static void runAnchorChecks() {
        exactExpect(null, new String[] { "a" }, new String[] { "b" }, null, "anchor-null-text");
        exactExpect("aba", null, null, "aba", "anchor-null-arrays");
        exactExpect("aba", new String[0], null, "aba", "anchor-empty-search-null-repl");
        exactExpect("aba", null, new String[0], "aba", "anchor-null-search-empty-repl");
        exactExpect("aba", new String[] { "a" }, null, "aba", "anchor-null-replacement-array");
        exactExpect("aba", new String[] { null }, new String[] { "a" }, "aba", "anchor-null-search-element");
        exactExpect("aba", new String[] { "a" }, new String[] { null }, "aba", "anchor-single-null-replacement");
        exactExpect("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "anchor-mixed-null-replacement");
    }

    private static void exactExpect(String text, String[] searchList, String[] replacementList, String expected, String oracleId) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (expected == null) {
                if (actual != null) {
                    throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: expected null actual=" + actual);
                }
            } else if (!expected.equals(actual)) {
                throw new RuntimeException(
                    "[oracle:" + oracleId + "] metamorphic violation: expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isRootCauseFromPatchedRegion(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCauseFromPatchedRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())) {
                String method = ste.getMethodName();
                if ("replaceEach".equals(method) || "length".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String normalizeToken(String s, String fallback) {
        if (s == null || s.length() == 0) {
            s = fallback;
        }
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.length() && b.length() < 3; i++) {
            char c = s.charAt(i);
            if (c == '~') {
                c = 'x';
            }
            if (c < 'a' || c > 'z') {
                c = (char) ('a' + (c & 15));
            }
            b.append(c);
        }
        if (b.length() == 0) {
            b.append(fallback);
        }
        return b.toString();
    }

    private static String normalizeDifferentToken(String s, String other, String fallback) {
        String token = normalizeToken(s, fallback);
        if (token.equals(other)) {
            token = other + "z";
        }
        return token;
    }

    private static String sanitizeBody(String s) {
        if (s == null) {
            return "m";
        }
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.length() && b.length() < 12; i++) {
            char c = s.charAt(i);
            if (c == '~') {
                c = 'y';
            }
            b.append(c);
        }
        if (b.length() == 0) {
            b.append('m');
        }
        return b.toString();
    }

    private static String makeSentinelPrefix(int len) {
        StringBuilder b = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            b.append('~');
        }
        return b.toString();
    }
}
