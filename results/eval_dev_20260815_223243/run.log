package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchor = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchor.length; i++) {
            exerciseAnchor(anchor[i]);
        }

        for (int i = 0; i < 12; i++) {
            exerciseExploration(buildProbe(data));
        }

        // Contract used for this oracle:
        // For a valid signed decimal integer string n, createNumber(n + 'L'/'l') takes the integral-suffix
        // path and must produce the same numeric value as the dedicated integral factories on n.
        // This is observable through real library calls only. A patch that merely suppresses the
        // known singleton crash, but leaves suffix handling inconsistent, will violate this agreement.
        signedLongSuffixAgreementOracle(data);

        // Additional reachable-function coverage in the same public entry point:
        // createNumber(decimal + 'F'/'f') should agree with createFloat(decimal) when the float result
        // is finite and representable without the fallback conditions in createNumber.
        floatSuffixAgreementOracle(data);
    }

    private static void exerciseAnchor(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseLeak(e) && isDefinitelyValid(input)) {
                throw e;
            }
        }
    }

    private static void exerciseExploration(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseLeak(e) && isDefinitelyValid(input)) {
                throw e;
            }
        }
    }

    private static String buildProbe(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 8)) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return String.valueOf((char) ('a' + data.consumeInt(0, 25))) + (data.consumeBoolean() ? "l" : "L");
            case 2:
                return data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
            case 3:
                return data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
            case 4:
                return "." + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 5:
                return "-" + String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 6:
                return String.valueOf((char) ('0' + data.consumeInt(0, 9))) + (data.consumeBoolean() ? "l" : "L");
            case 7:
                return data.consumeBoolean() ? "f" : "F";
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static void signedLongSuffixAgreementOracle(FuzzedDataProvider data) {
        int magnitude = data.consumeInt(0, 9);
        String numeric = (data.consumeBoolean() ? "-" : "") + magnitude;
        String withSuffix = numeric + (data.consumeBoolean() ? "L" : "l");
        try {
            Number parsed = NumberUtils.createNumber(withSuffix);
            Long asLong = NumberUtils.createLong(numeric);
            Integer asInt = NumberUtils.createInteger(numeric);
            if (parsed == null
                    || parsed.longValue() != asLong.longValue()
                    || parsed.intValue() != asInt.intValue()) {
                throw new RuntimeException(
                        "[oracle:signed-long-suffix-agree] metamorphic violation: createNumber(signed-decimal+L) must agree with createLong/createInteger input="
                                + withSuffix + " lhs=" + parsed + " rhsLong=" + asLong + " rhsInt=" + asInt);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:signed-long-suffix-agree]")) {
                throw e;
            }
            if (isRootCauseLeak(e) && isDefinitelyValid(withSuffix)) {
                throw e;
            }
        }

        StringBuilder negBig = new StringBuilder();
        negBig.append('-');
        negBig.append((char) ('1' + data.consumeInt(0, 8)));
        int extraDigits = data.consumeInt(19, 40);
        for (int i = 0; i < extraDigits; i++) {
            negBig.append((char) ('0' + data.consumeInt(0, 9)));
        }
        String big = negBig.toString();
        String bigWithSuffix = big + (data.consumeBoolean() ? "L" : "l");
        try {
            Number parsed = NumberUtils.createNumber(bigWithSuffix);
            BigInteger expected = NumberUtils.createBigInteger(big);
            if (!(parsed instanceof BigInteger) || !expected.equals(parsed)) {
                throw new RuntimeException(
                        "[oracle:negative-bigint-suffix] metamorphic violation: createNumber(negative-overflow-decimal+L) must equal createBigInteger input="
                                + bigWithSuffix + " lhs=" + parsed + " rhs=" + expected);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:negative-bigint-suffix]")) {
                throw e;
            }
            if (isRootCauseLeak(e) && isDefinitelyValid(bigWithSuffix)) {
                throw e;
            }
        }
    }

    private static void floatSuffixAgreementOracle(FuzzedDataProvider data) {
        String whole = String.valueOf(data.consumeInt(0, 999999));
        String frac = String.valueOf(data.consumeInt(0, 999999));
        String numeric = whole + "." + frac;
        String withSuffix = numeric + (data.consumeBoolean() ? "F" : "f");
        try {
            Number viaCreateNumber = NumberUtils.createNumber(withSuffix);
            Float viaCreateFloat = NumberUtils.createFloat(numeric);
            if (viaCreateNumber instanceof Float) {
                if (Float.floatToIntBits(((Float) viaCreateNumber).floatValue()) != Float.floatToIntBits(viaCreateFloat.floatValue())) {
                    throw new RuntimeException(
                            "[oracle:float-suffix-agree] metamorphic violation: createNumber(decimal+F) must agree with createFloat when both choose float input="
                                    + withSuffix + " lhs=" + viaCreateNumber + " rhs=" + viaCreateFloat);
                }
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:float-suffix-agree]")) {
                throw e;
            }
            if (isRootCauseLeak(e) && isDefinitelyValid(withSuffix)) {
                throw e;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseLeak(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cn)
                    && ("createNumber".equals(mn)
                    || "createInteger".equals(mn)
                    || "isAllZeros".equals(mn)
                    || "createLong".equals(mn)
                    || "createBigInteger".equals(mn)
                    || "createFloat".equals(mn)
                    || "createDouble".equals(mn)
                    || "createBigDecimal".equals(mn))) {
                return true;
            }
            if ("java.lang.String".equals(cn) && ("charAt".equals(mn) || "substring".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isDefinitelyValid(String input) {
        if (input == null || input.length() < 2) {
            return false;
        }
        char suffix = input.charAt(input.length() - 1);
        if (suffix != 'l' && suffix != 'L' && suffix != 'f' && suffix != 'F' && suffix != 'd' && suffix != 'D') {
            return false;
        }
        String numeric = input.substring(0, input.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        if (suffix == 'l' || suffix == 'L') {
            int start = 0;
            if (numeric.charAt(0) == '-') {
                if (numeric.length() == 1) {
                    return false;
                }
                start = 1;
            }
            for (int i = start; i < numeric.length(); i++) {
                char c = numeric.charAt(i);
                if (c < '0' || c > '9') {
                    return false;
                }
            }
            return true;
        }
        int digits = 0;
        int dots = 0;
        int start = 0;
        if (numeric.charAt(0) == '-') {
            if (numeric.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < numeric.length(); i++) {
            char c = numeric.charAt(i);
            if (c >= '0' && c <= '9') {
                digits++;
            } else if (c == '.') {
                dots++;
                if (dots > 1) {
                    return false;
                }
            } else {
                return false;
            }
        }
        return digits > 0;
    }
}
