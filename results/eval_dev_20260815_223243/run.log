package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        int pairs = data.consumeInt(1, 8);
        int safePrefixLen = data.consumeInt(0, 16);
        int safeSuffixLen = data.consumeInt(0, 16);

        StringBuilder sb = new StringBuilder();
        appendSafeCsvText(sb, data, safePrefixLen);
        for (int i = 0; i < pairs; i++) {
            appendValidSurrogatePair(sb, data);
            appendSafeCsvText(sb, data, data.consumeInt(0, 4));
        }
        appendSafeCsvText(sb, data, safeSuffixLen);

        String validSafe = sb.toString();
        runValidIdentityOracle(validSafe);

        String left = buildValidSafeString(data, data.consumeInt(1, 8), data.consumeInt(0, 8));
        String right = buildValidSafeString(data, data.consumeInt(1, 8), data.consumeInt(0, 8));
        runConcatenationOracle(left, right);

        String maybeInvalid = data.consumeString(32);
        runBestEffort(maybeInvalid);
    }

    private static void runAnchor(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:anchor-identity] metamorphic violation: escapeCsv must return unchanged text when input contains no CSV special characters input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runValidIdentityOracle(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            /*
             * Documented guarantee used for this oracle:
             * escapeCsv returns the input unchanged when the input contains no comma,
             * double quote, CR, or LF. We construct s using only safe ASCII plus valid
             * surrogate pairs, so it is valid by construction and contains none of the
             * CSV characters that trigger quoting/escaping.
             */
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:identity-safe] metamorphic violation: escapeCsv(s) must equal s for CSV-safe valid text input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runConcatenationOracle(String left, String right) {
        try {
            /*
             * Documented guarantee used for this oracle:
             * when a string contains no CSV special characters, escapeCsv returns it unchanged.
             * Since both left and right are constructed to be CSV-safe, left + right is also
             * CSV-safe; therefore escapeCsv(left + right) == (left + right) and also equals
             * escapeCsv(left) + escapeCsv(right). A patch that merely skips bookkeeping or
             * silently drops part of a surrogate pair breaks this observable relation.
             */
            String whole = StringEscapeUtils.escapeCsv(left + right);
            String parts = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);
            if (!whole.equals(parts)) {
                throw new RuntimeException("[oracle:concat-safe] metamorphic violation: escapeCsv(left+right) must equal escapeCsv(left)+escapeCsv(right) for CSV-safe valid text input=" + printable(left + right) + " lhs=" + printable(whole) + " rhs=" + printable(parts));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runBestEffort(String s) {
        try {
            StringEscapeUtils.escapeCsv(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstructionForRootCause(s)) {
                throw t;
            }
        }
    }

    private static boolean isValidByConstructionForRootCause(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                i++;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidSafeString(FuzzedDataProvider data, int pairCount, int extraSafeChars) {
        StringBuilder sb = new StringBuilder();
        appendSafeCsvText(sb, data, extraSafeChars);
        for (int i = 0; i < pairCount; i++) {
            appendSafeCsvText(sb, data, data.consumeInt(0, 3));
            appendValidSurrogatePair(sb, data);
        }
        appendSafeCsvText(sb, data, data.consumeInt(0, 3));
        return sb.toString();
    }

    private static void appendValidSurrogatePair(StringBuilder sb, FuzzedDataProvider data) {
        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        sb.append(Character.toChars(codePoint));
    }

    private static void appendSafeCsvText(StringBuilder sb, FuzzedDataProvider data, int len) {
        String ascii = data.consumeAsciiString(len);
        for (int i = 0; i < ascii.length(); i++) {
            char c = ascii.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (Character.isHighSurrogate(c) || Character.isLowSurrogate(c)) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
