                                    + " helperAlt="
                                    + helperAlt
                                    + " parsedCanonical="
                                    + parsedCanonical
                                    + " parsedAlt="
                                    + parsedAltLower);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseLeak(e)) {
                    return;
                }
            }
        }
