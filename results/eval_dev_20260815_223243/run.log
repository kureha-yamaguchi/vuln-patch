package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String anchor : anchors) {
            try {
                String out = StringEscapeUtils.escapeCsv(anchor);
                if (!anchor.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity-anchor] metamorphic violation: escapeCsv must preserve CSV-safe input containing valid surrogate pairs input=" + printable(anchor) + " lhs=" + printable(out) + " rhs=" + printable(anchor));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                if (isOracleFailure(t)) {
                    throw t;
                }
                return;
            }
        }

        String explored = buildValidCsvSafeStringWithAtLeastOneSurrogatePair(data);
        if (explored == null || explored.length() == 0) {
            return;
        }

        try {
            String out = StringEscapeUtils.escapeCsv(explored);

            // Contract/oracle: CSV escaping only adds quotes/escapes when the input contains CSV special
            // characters (comma, quote, CR, LF). We construct the input to exclude those characters and to
            // contain only valid UTF-16, so every correct implementation must return the original input.
            if (!explored.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe valid input input=" + printable(explored) + " lhs=" + printable(out) + " rhs=" + printable(explored));
            }

            String left = explored.substring(0, splitAtCodePointBoundary(explored, data.consumeInt(0, countCodePoints(explored))));
            String right = explored.substring(left.length());

            try {
                String whole = StringEscapeUtils.escapeCsv(explored);
                String parts = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);
                // Metamorphic relation on our constructed domain: both halves and the whole are CSV-safe,
                // so escaping is identity on each; therefore escaping the concatenation equals concatenating
                // the escaped halves for every correct implementation.
                if (!whole.equals(parts)) {
                    throw new RuntimeException("[oracle:csv-compose] metamorphic violation: escapeCsv(x+y) must equal escapeCsv(x)+escapeCsv(y) for CSV-safe valid inputs input=" + printable(explored) + " lhs=" + printable(whole) + " rhs=" + printable(parts));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
                return;
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)) {
                if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildValidCsvSafeStringWithAtLeastOneSurrogatePair(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int prefixUnits = data.consumeInt(0, 8);
        for (int i = 0; i < prefixUnits; i++) {
            sb.append(safeBmpChar(data));
        }

        int pairs = data.consumeInt(1, 6);
        for (int i = 0; i < pairs; i++) {
            int codePoint = randomSupplementaryCodePoint(data);
            sb.append(Character.toChars(codePoint));

            int betweenUnits = data.consumeInt(0, 4);
            for (int j = 0; j < betweenUnits; j++) {
                sb.append(safeBmpChar(data));
            }
        }

        int suffixUnits = data.consumeInt(0, 8);
        for (int i = 0; i < suffixUnits; i++) {
            sb.append(safeBmpChar(data));
        }

        if (sb.length() == 0) {
            sb.append("\uD83D\uDE30");
        }
        return sb.toString();
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp)) {
                return cp;
            }
        }
    }

    private static char safeBmpChar(FuzzedDataProvider data) {
        while (true) {
            int c = data.consumeInt(0x20, 0x7E);
            char ch = (char) c;
            if (ch != ',' && ch != '"' && ch != '\r' && ch != '\n') {
                return ch;
            }
        }
    }

    private static int countCodePoints(String s) {
        return s.codePointCount(0, s.length());
    }

    private static int splitAtCodePointBoundary(String s, int cpIndex) {
        return s.offsetByCodePoints(0, cpIndex);
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7E) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
