package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryCreateNumberValid("1234.5", true);

        String base = buildValidDecimal(data);
        tryCreateNumberValid(base, true);

        /*
         * Contract visible in NumberUtils.createNumber:
         * for an unsuffixed decimal literal with no exponent, createNumber(str) first tries
         * createFloat(str) and returns that Float when it is finite and not a misleading zero;
         * createNumber(str + "F") explicitly requests that same Float quantity.
         * Therefore these real-library paths must agree on the same quantity.
         */
        checkFloatHelperAgreement(base);

        /*
         * Same public-family consistency check:
         * createNumber(str + "D") explicitly requests the same quantity parsed by createDouble(str).
         * These real-library paths must agree for a valid decimal literal.
         */
        checkDoubleHelperAgreement(base);

        String variant = mutateValidDecimal(data, base);
        tryCreateNumberValid(variant, true);
        checkFloatHelperAgreement(variant);
        checkDoubleHelperAgreement(variant);
    }

    private static void tryCreateNumberValid(String s, boolean validByConstruction) {
        try {
