package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchorCases();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            exploreBoundary(data);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isRootCause(t)) {
                return;
            }
        }
    }

    private static void runAnchorCases() {
        assertNull(StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" }), "anchor-null-text");
        assertEquals("", StringUtils.replaceEach("", new String[] { "a" }, new String[] { "b" }), "anchor-empty-text");
        assertEquals("aba", StringUtils.replaceEach("aba", null, null), "anchor-null-arrays-1");
        assertEquals("aba", StringUtils.replaceEach("aba", new String[0], null), "anchor-null-arrays-2");
        assertEquals("aba", StringUtils.replaceEach("aba", null, new String[0]), "anchor-null-arrays-3");
        assertEquals("aba", StringUtils.replaceEach("aba", new String[] { "a" }, null), "anchor-null-replacement-array");
        assertEquals("b", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { "" }), "anchor-empty-repl");
        assertEquals("aba", StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" }), "anchor-null-search-element");

        // Exact trigger from the failing test: a null replacement element must be ignored, not crash.
        assertEquals("aba", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { null }),
                "anchor-ground-truth");
        assertEquals("cbc", StringUtils.replaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null }),
                "anchor-mixed-null-replacement");
    }

    private static void exploreBoundary(FuzzedDataProvider data) {
        String needle = data.consumeAsciiString(4);
        if (needle.length() == 0) {
            needle = "a";
        }

        String replacement = data.consumeAsciiString(4);
        String prefix = data.consumeAsciiString(8);
        String middle = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);

        String text = prefix + needle + middle + needle + suffix;

        String ghost = data.consumeAsciiString(4);
        if (ghost.length() == 0 || ghost.equals(needle)) {
            ghost = needle + "Z";
        }

        if (data.consumeBoolean()) {
            int insertAt = data.consumeInt(0, text.length());
            text = text.substring(0, insertAt) + ghost + text.substring(insertAt);
        }

        String extraSearch = data.consumeAsciiString(3);
        String extraReplacement = data.consumeAsciiString(3);
        if (extraSearch.length() == 0 || extraSearch.equals(needle) || extraSearch.equals(ghost)) {
            extraSearch = "Q";
        }

        String[] baseSearch = new String[] { needle, extraSearch };
        String[] baseReplacement = new String[] { replacement, extraReplacement };

        String[] extendedSearch;
        String[] extendedReplacement;
        if (data.consumeBoolean()) {
            extendedSearch = new String[] { ghost, needle, extraSearch };
            extendedReplacement = new String[] { null, replacement, extraReplacement };
        } else {
            extendedSearch = new String[] { needle, extraSearch, ghost };
            extendedReplacement = new String[] { replacement, extraReplacement, null };
        }

        String base;
        try {
            base = StringUtils.replaceEach(text, baseSearch, baseReplacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        String extended;
        try {
            extended = StringUtils.replaceEach(text, extendedSearch, extendedReplacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        // Contract used for this oracle:
        // In StringUtils.replaceEach, entries with null replacementList[i] are skipped by the search loops.
        // Therefore adding an extra (search -> null) pair must be observationally inert.
        // A throw-deleting or seed-only patch could avoid the NPE yet still mishandle this extra pair.
        if (!eq(base, extended)) {
            throw new RuntimeException(
                    "[oracle:null-replacement-inert] metamorphic violation: adding a null-replacement pair changed result"
                            + " input=" + text
                            + " lhs=" + base
                            + " rhs=" + extended);
        }

        // Independent agreement check for the reachable helper: StringUtils.length(str) is specified as
        // null ? 0 : str.length(), so for non-null outputs it must equal the JDK String length.
        int reportedBaseLen = StringUtils.length(base);
        int actualBaseLen = base.length();
        if (reportedBaseLen != actualBaseLen) {
            throw new RuntimeException(
                    "[oracle:length-agreement] consistency violation: reported=" + reportedBaseLen
                            + " actual=" + actualBaseLen
                            + " value=" + base);
        }

        int reportedExtendedLen = StringUtils.length(extended);
        int actualExtendedLen = extended.length();
        if (reportedExtendedLen != actualExtendedLen) {
            throw new RuntimeException(
                    "[oracle:length-agreement-2] consistency violation: reported=" + reportedExtendedLen
                            + " actual=" + actualExtendedLen
                            + " value=" + extended);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String n = cur.getClass().getName();
            if (n != null) {
                String lower = n.toLowerCase();
                if (lower.contains("invalid") || lower.contains("validation")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("replaceEach".equals(method) || "length".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void assertEquals(String expected, String actual, String id) {
        if (!eq(expected, actual)) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: expected=" + expected + " actual=" + actual);
        }
    }

    private static void assertNull(String actual, String id) {
        if (actual != null) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: expected=null actual=" + actual);
        }
    }

    private static boolean eq(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
