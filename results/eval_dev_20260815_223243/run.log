package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            anchor();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < cases; i++) {
            double x1 = bounded(data.consumeInt());
            double y1 = bounded(data.consumeInt());
            double x2 = bounded(data.consumeInt());
            double y2 = bounded(data.consumeInt());

            if (x1 == x2 && y1 == y2) {
                x2 = x1 + 1.0;
            }

            try {
                exerciseFlippedCondition(x1, y1, x2, y2, true);
                exerciseFlippedCondition(x1, y1, x2, y2, false);
            } catch (IllegalArgumentException e) {
                return;
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static void anchor() {
        exerciseFlippedCondition(0.0, 0.0, 1.0, 0.0, true);
        exerciseFlippedCondition(0.0, 0.0, 1.0, 0.0, false);
    }

    private static void exerciseFlippedCondition(double x1, double y1, double x2, double y2, boolean inside) {
        PolygonsSet polygon = new PolygonsSet(makeRedundantTree(x1, y1, x2, y2, inside));

        Vector2D[][] vertices = polygon.getVertices();
        if (vertices == null || vertices.length != 0) {
            return;
        }

        double size = polygon.getSize();
        Vector2D barycenter = (Vector2D) polygon.getBarycenter();
        double bx = barycenter.getX();
        double by = barycenter.getY();

        PolygonsSet twin = new PolygonsSet(makeRedundantTree(x1, y1, x2, y2, inside));
        Vector2D[][] twinVertices = twin.getVertices();
        if (twinVertices == null || twinVertices.length != 0) {
            return;
        }
        double twinSize = twin.getSize();
        Vector2D twinBarycenter = (Vector2D) twin.getBarycenter();
        double tbx = twinBarycenter.getX();
        double tby = twinBarycenter.getY();

        if (inside) {
            if (!(Double.isInfinite(size) && size > 0.0 && Double.isNaN(bx) && Double.isNaN(by))) {
                throw new RuntimeException("[oracle:flip-empty] metamorphic violation: redundant whole-space tree with empty vertices must report infinite size and NaN barycenter"
                        + " input=(" + x1 + "," + y1 + ")->(" + x2 + "," + y2 + ")"
                        + " size=" + size + " bary=(" + bx + "," + by + ")");
            }
            if (!(Double.isInfinite(twinSize) && twinSize > 0.0 && Double.isNaN(tbx) && Double.isNaN(tby))) {
                throw new RuntimeException("[oracle:flip-empty] metamorphic violation: identically-constructed twin disagrees for whole-space case"
                        + " input=(" + x1 + "," + y1 + ")->(" + x2 + "," + y2 + ")"
                        + " twinSize=" + twinSize + " twinBary=(" + tbx + "," + tby + ")");
            }
        } else {
            if (!(size == 0.0 && bx == 0.0 && by == 0.0)) {
                throw new RuntimeException("[oracle:flip-empty] metamorphic violation: redundant empty-space tree with empty vertices must report zero size and origin barycenter"
                        + " input=(" + x1 + "," + y1 + ")->(" + x2 + "," + y2 + ")"
                        + " size=" + size + " bary=(" + bx + "," + by + ")");
            }
            if (!(twinSize == 0.0 && tbx == 0.0 && tby == 0.0)) {
                throw new RuntimeException("[oracle:flip-empty] metamorphic violation: identically-constructed twin disagrees for empty-space case"
                        + " input=(" + x1 + "," + y1 + ")->(" + x2 + "," + y2 + ")"
                        + " twinSize=" + twinSize + " twinBary=(" + tbx + "," + tby + ")");
            }
        }
    }

    private static BSPTree<Euclidean2D> makeRedundantTree(double x1, double y1, double x2, double y2, boolean inside) {
        Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
        SubHyperplane<Euclidean2D> cut = line.wholeHyperplane();
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(null, null);
        return new BSPTree<Euclidean2D>(cut, plus, minus, attribute);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement ste : stack) {
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(ste.getClassName())
                    && "computeGeometricalProperties".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static double bounded(int v) {
        return (double) (v % 10000);
    }
}
