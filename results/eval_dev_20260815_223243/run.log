        // contract is that all of these inputs are accepted by toBoolean(String) and return
        // false except recognized true tokens. A StringIndexOutOfBoundsException here is a bug.
        invokeAndMaybePropagate(null);
        invokeAndMaybePropagate("");
        invokeAndMaybePropagate("off");

        // Additional literals from the failing test / observed corpus keep the harness anchored
        // to the real usage that exercised this method.
        String[] literals = new String[] {
            "oof", "yep", "trux", "false", "a",
            "true", "truE", "trUe", "trUE", "tRue", "tRuE", "tRUe", "tRUE",
            "TRUE", "TRUe", "TRuE", "TRue", "TrUE", "TrUe", "TruE", "True",
            "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES",
            "yes?", "tru"
        };
        for (int i = 0; i < literals.length; i++) {
            invokeAndMaybePropagate(literals[i]);
        }

        // EXPLORE: The touched code is in the length-3 handling of toBoolean(String).
        // Drive many real inputs through the public API, especially non-null 3-char strings,
        // plus neighboring lengths used by adjacent switch arms.
        int rounds = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < rounds; i++) {
            int mode = data.consumeInt(0, 5);
            String s;
            switch (mode) {
                case 0:
                    s = buildExactLengthAscii(data, 3);
                    break;
                case 1:
                    s = buildExactLengthAscii(data, 2);
                    break;
                case 2:
                    s = buildExactLengthAscii(data, 4);
                    break;
                case 3:
                    s = mutateKnownShape(data);
                    break;
                case 4:
                    s = data.consumeAsciiString(8);
                    break;
                default:
                    s = data.consumeString(8);
                    break;
            }
            invokeAndMaybePropagate(s);
        }

        // Mandatory post-condition / metamorphic oracle:
        // The implementation and its own tests establish that the recognized true literals
        // "true", "yes", and "on" are parsed case-insensitively. Therefore any case-variant
        // of one canonical token must produce the same result as the canonical token itself.
        // A "fix" that merely avoids the crash by skipping/altering the branch logic could
        // silently break this equivalence without throwing.
        String canonical = pickCanonicalTrueToken(data);
        String variant = varyCase(canonical, data);
        boolean lhs;
        boolean rhs;
        try {
            lhs = BooleanUtils.toBoolean(canonical);
            rhs = BooleanUtils.toBoolean(variant);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromToBoolean(t)) {
                throw t;
            }
            return;
        }
        if (lhs != rhs || !lhs) {
            throw new RuntimeException(
                "[oracle:case-insensitive-true] metamorphic violation: equivalent case variants of a recognized true token must agree input="
                    + printable(variant) + " lhs=" + lhs + " rhs=" + rhs + " canonical=" + printable(canonical));
        }
    }

    private static void invokeAndMaybePropagate(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromToBoolean(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseFromToBoolean(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildExactLengthAscii(FuzzedDataProvider data, int len) {
        String seed = data.consumeAsciiString(len);
        if (seed.length() == len) {
            return seed;
        }
        StringBuilder sb = new StringBuilder(seed);
        while (sb.length() < len) {
            char c = (char) ('a' + data.consumeInt(0, 25));
            sb.append(c);
        }
        if (sb.length() > len) {
            sb.setLength(len);
        }
        return sb.toString();
    }

    private static String mutateKnownShape(FuzzedDataProvider data) {
        String[] bases = new String[] { "off", "oof", "yep", "yes", "tru", "true", "on", "false" };
        String base = bases[data.consumeInt(0, bases.length - 1)];
        StringBuilder sb = new StringBuilder(base);

        int ops = data.consumeInt(1, 3);
        for (int i = 0; i < ops; i++) {
            int action = data.consumeInt(0, 2);
            char c;
            if (data.consumeBoolean()) {
                c = (char) ('a' + data.consumeInt(0, 25));
            } else {
                c = (char) ('A' + data.consumeInt(0, 25));
            }

            if (action == 0 && sb.length() > 0) {
                int idx = data.consumeInt(0, sb.length() - 1);
                sb.setCharAt(idx, c);
            } else if (action == 1 && sb.length() < 8) {
                int idx = data.consumeInt(0, sb.length());
                sb.insert(idx, c);
            } else if (action == 2 && sb.length() > 0) {
                int idx = data.consumeInt(0, sb.length() - 1);
                sb.deleteCharAt(idx);
            }
        }

        if (sb.length() == 0) {
            sb.append('x');
        }
        if (sb.length() > 8) {
            sb.setLength(8);
        }
        return sb.toString();
    }

    private static String pickCanonicalTrueToken(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 2)) {
            case 0:
                return "true";
            case 1:
                return "yes";
            default:
                return "on";
        }
    }

    private static String varyCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(ch) : Character.toLowerCase(ch));
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
