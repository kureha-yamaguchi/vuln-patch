package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        String prefix = sanitize(data.consumeString(24));
        String suffix = sanitize(data.consumeString(24));
        String replacement = sanitize(data.consumeString(24));

        final String present = "\u0001P\u0002";
        final String absent = "\u0003A\u0004";

        int layout = data.consumeInt(0, 2);
        String text;
        String expected;
        if (layout == 0) {
            text = prefix + present + suffix;
            expected = prefix + replacement + suffix;
        } else if (layout == 1) {
            text = present + prefix + suffix;
            expected = replacement + prefix + suffix;
        } else {
            text = prefix + suffix + present;
            expected = prefix + suffix + replacement;
        }

        boolean reverseOrder = data.consumeBoolean();
        String[] searchList;
        String[] replacementList;
        if (reverseOrder) {
            searchList = new String[] { absent, present };
            replacementList = new String[] { null, replacement };
        } else {
            searchList = new String[] { present, absent };
            replacementList = new String[] { replacement, null };
        }

        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);

            /* Contract exercised by the regression test examples:
             * null search/replacement elements are ignored by replaceEach.
             * Here the null-replacement pair's search token is guaranteed absent by construction,
             * while the non-null pair's search token occurs exactly once.
             * Therefore a correct implementation must replace exactly that one occurrence.
             * A throw-deleting patch that silently skips bookkeeping or mishandles the branch
             * would violate this observable result even if it no longer crashes.
             */
            if (!expected.equals(actual)) {
                throw new RuntimeException(
                    "[oracle:single-known-hit] metamorphic violation: exactly one known replacement with one absent null pair"
                        + " text=" + debug(text)
                        + " expected=" + debug(expected)
                        + " actual=" + debug(actual));
            }

            int expectedLength =
                StringUtils.length(prefix) + StringUtils.length(replacement) + StringUtils.length(suffix);
            int actualLength = StringUtils.length(actual);
            if (actualLength != expectedLength) {
                throw new RuntimeException(
                    "[oracle:length-of-single-hit] metamorphic violation: constructed output length mismatch"
                        + " text=" + debug(text)
                        + " expectedLength=" + expectedLength
                        + " actualLength=" + actualLength
                        + " actual=" + debug(actual));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runAnchorChecks() {
        exactExpect(null, StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" }));
        exactExpect("", StringUtils.replaceEach("", new String[] { "a" }, new String[] { "b" }));
        exactExpect("aba", StringUtils.replaceEach("aba", null, null));
        exactExpect("aba", StringUtils.replaceEach("aba", new String[0], null));
        exactExpect("aba", StringUtils.replaceEach("aba", null, new String[0]));
        exactExpect("aba", StringUtils.replaceEach("aba", new String[] { "a" }, null));
        exactExpect("b", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { "" }));
        exactExpect("aba", StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" }));
        exactExpect("aba", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { null }));
        exactExpect("cbc", StringUtils.replaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null }));
    }

    private static void exactExpect(String expected, String actual) {
        if (expected == null ? actual != null : !expected.equals(actual)) {
            throw new RuntimeException(
                "[oracle:anchor-regression] metamorphic violation: expected=" + debug(expected) + " actual=" + debug(actual));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitize(String s) {
        if (s == null) {
            return "";
        }
        return s.replace("\u0001", "")
                .replace("\u0002", "")
                .replace("\u0003", "")
                .replace("\u0004", "");
    }

    private static String debug(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
