package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            try {
                String out = StringEscapeUtils.escapeCsv(anchors[i]);
                if (!anchors[i].equals(out)) {
                    throw new RuntimeException("[oracle:anchor-identity] metamorphic violation: escapeCsv must return the same string for input without CSV special characters input=" + quote(anchors[i]) + " lhs=" + quote(out) + " rhs=" + quote(anchors[i]));
                }
            } catch (Throwable t) {
                handleThrowable(t);
            }
        }

        int cases = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < cases; i++) {
            String s = buildValidSupplementarySafeString(data);
            try {
                String out = StringEscapeUtils.escapeCsv(s);

                /* Contract asserted: CSV escaping only adds quoting/escaping for CSV-special chars.
                   For strings we construct from safe ASCII plus valid surrogate pairs, with no comma,
                   quote, CR, or LF, the public API is obligated to return the input unchanged.
                   A patch that merely suppresses the crash but skips/garbles code-point handling
                   would violate this observable post-condition. */
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:safe-identity] metamorphic violation: escapeCsv must preserve CSV-safe valid text input=" + quote(s) + " lhs=" + quote(out) + " rhs=" + quote(s));
                }

                String out2 = StringEscapeUtils.escapeCsv(out);
                if (!out.equals(out2)) {
                    throw new RuntimeException("[oracle:safe-idempotence] metamorphic violation: escapeCsv on already CSV-safe output must be idempotent input=" + quote(s) + " lhs=" + quote(out2) + " rhs=" + quote(out));
                }
            } catch (Throwable t) {
                handleThrowable(t);
            }
        }
    }

    private static String buildValidSupplementarySafeString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        sb.append(prefix);

        int pairCount = 1 + data.consumeInt(0, 3);
        for (int i = 0; i < pairCount; i++) {
            String mid = sanitizeCsvSafeAscii(data.consumeAsciiString(6));
            sb.append(mid);

            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp)) {
                cp = 0x10000;
            }
            sb.append(Character.toChars(cp));
        }

        sb.append(suffix);

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x10000));
        }
        return sb.toString();
    }

    private static String sanitizeCsvSafeAscii(String s) {
        if (s == null || s.length() == 0) {
            return "A";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n' || c < 0x20 || c > 0x7e) {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('A');
        }
        return sb.toString();
    }

    private static void handleThrowable(Throwable t) {
        if (t == null) {
            return;
        }

        if (isCleanRejection(t)) {
            return;
        }

        if (t instanceof RuntimeException && isRootCause(t)) {
            throw (RuntimeException) t;
        }

        if (t instanceof Error && isRootCause(t)) {
            throw (Error) t;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation") || name.contains("invalid") || name.contains("malformed")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }
}
