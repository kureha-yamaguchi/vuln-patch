package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            TimeSeries anchor = new TimeSeries("S");
            anchor.add(new Day(19, 8, 2005), Integer.valueOf(1));
            anchor.add(new Day(31, 1, 2006), Integer.valueOf(1));

            try {
                TimeSeries copy = anchor.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
                if (copy.getItemCount() != 0 || copy.getItems().size() != 0) {
                    throw new RuntimeException("[oracle:anchor-empty-count] metamorphic violation: exact regression input should copy an empty valid range but got itemCount="
                            + copy.getItemCount() + " itemsSize=" + copy.getItems().size());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:anchor-valid-empty] metamorphic violation: exact regression input is valid-by-construction yet createCopy rejected it", e);
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }

            // Contract used below: createCopy(start, end) returns a copy of the subset
            // in the inclusive [start, end] range. For a correct implementation, moving
            // only the END boundary from the last absent period in a gap to the first
            // present period after that gap flips the result from empty to a singleton
            // containing exactly that boundary item.
            int rounds = data.consumeInt(1, 4);
            for (int r = 0; r < rounds; r++) {
                TimeSeries series = new TimeSeries(
                        "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                        "domain",
                        "range",
                        Day.class);

                int year = data.consumeInt(1990, 2025);
                int month = data.consumeInt(1, 12);
                int beforeCount = data.consumeInt(0, 3);
                int leftDay = data.consumeInt(5, 20);
                int maxGap = 27 - leftDay;
                if (maxGap < 1) {
                    continue;
                }
                int gap = data.consumeInt(1, Math.min(7, maxGap));
                int rightDay = leftDay + gap + 1;
                int afterCount = data.consumeInt(0, 28 - rightDay);

                try {
                    for (int i = beforeCount; i > 0; i--) {
                        addValue(series, new Day(leftDay - i, month, year), data.consumeInt(-1000, 1000), data.consumeBoolean());
                    }
                    Day left = new Day(leftDay, month, year);
                    Day right = new Day(rightDay, month, year);
                    addValue(series, left, data.consumeInt(-1000, 1000), data.consumeBoolean());
                    addValue(series, right, data.consumeInt(-1000, 1000), data.consumeBoolean());
                    for (int i = 1; i <= afterCount; i++) {
                        addValue(series, new Day(rightDay + i, month, year), data.consumeInt(-1000, 1000), data.consumeBoolean());
                    }
                } catch (RuntimeException e) {
                    return;
                }

                if (series.getItemCount() != series.getItems().size()) {
                    throw new RuntimeException("[oracle:source-view-consistency] metamorphic violation: source count disagrees with items view itemCount="
                            + series.getItemCount() + " itemsSize=" + series.getItems().size());
                }

                int startOffset = data.consumeInt(1, gap);
                int endOffset = data.consumeInt(startOffset, gap);
                Day startAbsent = new Day(leftDay + startOffset, month, year);
                Day endAbsent = new Day(leftDay + endOffset, month, year);
                Day rightExact = new Day(rightDay, month, year);

                int startIndex = series.getIndex(startAbsent);
                int endIndexAbsent = series.getIndex(endAbsent);
                int rightIndex = series.getIndex(rightExact);

                if (startIndex >= 0 || endIndexAbsent >= 0 || rightIndex < 0) {
                    throw new RuntimeException("[oracle:constructed-gap-boundary] metamorphic violation: constructed source does not have the intended absent/present boundary startIndex="
                            + startIndex + " endIndexAbsent=" + endIndexAbsent + " rightIndex=" + rightIndex);
                }

                try {
                    TimeSeries emptyCopy = series.createCopy(startAbsent, endAbsent);
                    if (emptyCopy.getItemCount() != 0 || emptyCopy.getItems().size() != 0) {
                        throw new RuntimeException("[oracle:boundary-gap-empty] metamorphic violation: copying a fully absent subrange inside a gap should be empty but got itemCount="
                                + emptyCopy.getItemCount() + " itemsSize=" + emptyCopy.getItems().size()
                                + " start=" + startAbsent + " end=" + endAbsent);
                    }

                    TimeSeries inclusiveCopy = series.createCopy(startAbsent, rightExact);
                    if (inclusiveCopy.getItemCount() != 1 || inclusiveCopy.getItems().size() != 1) {
                        throw new RuntimeException("[oracle:boundary-flip-singleton] metamorphic violation: extending end to the first present boundary item should yield a singleton but got itemCount="
                                + inclusiveCopy.getItemCount() + " itemsSize=" + inclusiveCopy.getItems().size()
                                + " start=" + startAbsent + " end=" + rightExact);
                    }

                    RegularTimePeriod copiedPeriod = inclusiveCopy.getTimePeriod(0);
                    if (!rightExact.equals(copiedPeriod)) {
                        throw new RuntimeException("[oracle:boundary-right-period] metamorphic violation: singleton boundary copy should contain the right boundary item expected="
                                + rightExact + " actual=" + copiedPeriod);
                    }

                    if (inclusiveCopy.getIndex(rightExact) != 0) {
