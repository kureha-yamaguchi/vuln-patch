                "semantic mismatch: base.plusHours(1).toString()=" + plusOneHourString);
        }

        int minute = data.consumeInt(0, 59);
        int second = data.consumeInt(0, 59);
        int millis = data.consumeInt(0, 999);

        long expectedUtcMillis =
            new DateTime(2011, 10, 30, 0, minute, second, millis, DateTimeZone.UTC).getMillis();
        long localMillis =
            new DateTime(2011, 10, 30, 1, minute, second, millis, DateTimeZone.UTC).getMillis();

        int actualOffsetFromLocal = zone.getOffsetFromLocal(localMillis);
        int expectedOffsetFromLocal = (int) (localMillis - expectedUtcMillis);
        if (actualOffsetFromLocal != expectedOffsetFromLocal) {
