        }

        int equivalentMinute = data.consumeInt(0, 59);
        org.joda.time.Partial equivalent = new org.joda.time.Partial(hourMinuteTypes, new int[] {10, equivalentMinute});
        try {
            equivalent.with(org.joda.time.DateTimeFieldType.clockhourOfDay(), 6);
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected IllegalArgumentException from Partial(hourOfDay=10, minuteOfHour="
