package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        java.util.Set anchorSet = LocaleUtils.availableLocaleSet();
        Locale[] anchorLocales = new Locale[] {
            new Locale("en"),
            new Locale("en", "US"),
            new Locale("en", "US", "ZZZZ"),
            new Locale("fr"),
            new Locale("fr", "CA"),
            new Locale("qq"),
            new Locale("qq", "ZZ")
        };

        for (int i = 0; i < anchorLocales.length; i++) {
            anchorSet.contains(anchorLocales[i]);
            LocaleUtils.isAvailableLocale(anchorLocales[i]);
        }

        int iterations = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < iterations; i++) {
            Locale locale;
            int mode = data.consumeInt(0, 5);

            switch (mode) {
                case 0:
                    locale = null;
                    break;
                case 1: {
                    java.util.List locales = LocaleUtils.availableLocaleList();
                    if (locales.isEmpty()) {
                        return;
                    }
                    locale = (Locale) locales.get(data.consumeInt(0, locales.size() - 1));
                    break;
                }
                case 2: {
                    String language =
                        "" + (char) ('a' + data.consumeInt(0, 25))
                           + (char) ('a' + data.consumeInt(0, 25));
                    locale = new Locale(language);
                    break;
                }
                case 3: {
                    String language =
                        "" + (char) ('a' + data.consumeInt(0, 25))
                           + (char) ('a' + data.consumeInt(0, 25));
                    String country =
                        "" + (char) ('A' + data.consumeInt(0, 25))
                           + (char) ('A' + data.consumeInt(0, 25));
                    locale = new Locale(language, country);
                    break;
                }
                case 4: {
                    String language =
                        "" + (char) ('a' + data.consumeInt(0, 25))
                           + (char) ('a' + data.consumeInt(0, 25));
                    String country =
                        "" + (char) ('A' + data.consumeInt(0, 25))
                           + (char) ('A' + data.consumeInt(0, 25));
                    String variant = data.consumeAsciiString(8);
                    if (variant.length() == 0) {
                        variant = "V";
                    }
                    locale = new Locale(language, country, variant);
                    break;
                }
                default:
                    locale = new Locale(
                        data.consumeAsciiString(8),
                        data.consumeAsciiString(8),
                        data.consumeAsciiString(12));
                    break;
            }

            boolean actual = LocaleUtils.isAvailableLocale(locale);
            boolean expected = LocaleUtils.availableLocaleList().contains(locale);
            if (actual != expected) {
                throw new RuntimeException("metamorphic violation: isAvailableLocale == availableLocaleList.contains");
            }
        }
    }
}
