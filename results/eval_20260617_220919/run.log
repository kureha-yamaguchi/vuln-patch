    private static String toWhitespace(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            switch (s.charAt(i) & 3) {
                case 0:
                    sb.append(' ');
                    break;
                case 1:
                    sb.append('\n');
                    break;
                case 2:
                    sb.append('\t');
                    break;
                default:
                    sb.append('\r');
                    break;
            }
        }
        return sb.toString();
