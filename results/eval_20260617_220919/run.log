import java.io.PrintStream;
import java.io.Writer;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] seedInputs = new String[] {
            "goog.require('beer');",
            "goog.provide('beer');\ngoog.require('hops');",
            "goog.provide('hops');",
        };
        String[] seedExpected = new String[] {
            "goog.provide('hops');",
            "goog.provide('beer');\ngoog.require('hops');",
            "goog.require('beer');"
        };

        String seedActual = compileWithCommandLineRunner(seedInputs);
        if (seedActual != null &&
            !normalize(seedActual).equals(normalize(joinWithNewlines(seedExpected)))) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: dependency sorting for whitespace mode seed");
        }

        String provideName = sanitizeNamespace(data.consumeAsciiString(24), "beer");
        String depName = sanitizeNamespace(data.consumeAsciiString(24), "hops");
        if (provideName.equals(depName)) {
            depName = depName + "Dep";
        }

        String[] generatedInputs = new String[] {
            "goog.require('" + provideName + "');",
            "goog.provide('" + provideName + "');\ngoog.require('" + depName + "');",
            "goog.provide('" + depName + "');",
        };
        String[] generatedExpected = new String[] {
            "goog.provide('" + depName + "');",
            "goog.provide('" + provideName + "');\ngoog.require('" + depName + "');",
            "goog.require('" + provideName + "');"
        };

        String generatedActual = compileWithCommandLineRunner(generatedInputs);
        if (generatedActual != null &&
            !normalize(generatedActual).equals(normalize(joinWithNewlines(generatedExpected)))) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: generalized dependency sorting output");
        }

        String sortedActual = compileWithCommandLineRunner(generatedExpected);
        if (generatedActual != null && sortedActual != null &&
            !normalize(generatedActual).equals(normalize(sortedActual))) {
            throw new RuntimeException(
                "metamorphic violation: dependency-managed output should be invariant under input order");
        }
    }

    private static String compileWithCommandLineRunner(String[] sources) {
        File dir = null;
        PrintStream out = null;
        PrintStream err = null;
        try {
            dir = createTempDir();
            String[] args = new String[2 + sources.length];
            args[0] = "--manage_closure_dependencies";
            args[1] = "--compilation_level=WHITESPACE_ONLY";

            for (int i = 0; i < sources.length; i++) {
                File jsFile = new File(dir, "input" + i + ".js");
                writeUtf8(jsFile, sources[i]);
                args[i + 2] = "--js=" + jsFile.getAbsolutePath();
            }

            ByteArrayOutputStream stdoutBytes = new ByteArrayOutputStream();
            ByteArrayOutputStream stderrBytes = new ByteArrayOutputStream();
            out = new PrintStream(stdoutBytes, true, "UTF-8");
            err = new PrintStream(stderrBytes, true, "UTF-8");

            CommandLineRunner runner = new CommandLineRunner(args, out, err);
            runner.run();
            out.flush();
            return stdoutBytes.toString("UTF-8");
        } catch (IOException e) {
            return null;
        } finally {
            if (out != null) {
                out.close();
            }
            if (err != null) {
                err.close();
            }
            deleteRecursively(dir);
        }
    }

    private static File createTempDir() throws IOException {
        File dir = File.createTempFile("jazzer-closure-", "");
        if (!dir.delete() || !dir.mkdir()) {
            throw new IOException("Failed to create temp directory");
        }
        return dir;
    }

    private static void writeUtf8(File file, String content) throws IOException {
        Writer writer = null;
        try {
            writer = new OutputStreamWriter(new FileOutputStream(file), "UTF-8");
            writer.write(content);
        } finally {
            if (writer != null) {
                writer.close();
            }
        }
    }

    private static String joinWithNewlines(String[] parts) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < parts.length; i++) {
            if (i != 0) {
                sb.append('\n');
            }
            sb.append(parts[i]);
        }
        return sb.toString();
    }

    private static String normalize(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (!Character.isWhitespace(c)) {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String sanitizeNamespace(String raw, String fallback) {
        StringBuilder cleaned = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z') ||
                (c >= 'A' && c <= 'Z') ||
                (c >= '0' && c <= '9') ||
                c == '_' || c == '$') {
                cleaned.append(c);
            }
        }
        if (cleaned.length() == 0) {
            cleaned.append(fallback);
        }
        return "ns" + cleaned.toString();
    }

    private static void deleteRecursively(File file) {
        if (file == null || !file.exists()) {
            return;
        }
        if (file.isDirectory()) {
            File[] children = file.listFiles();
            if (children != null) {
                for (int i = 0; i < children.length; i++) {
                    deleteRecursively(children[i]);
                }
            }
        }
        file.delete();
    }
}
