package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String SOURCE_NAME = "javascript/complex.js";
    private static final DiagnosticType FOO_TYPE =
            DiagnosticType.error("JAZZER_FOO_TYPE", "error description here");

    private static LightweightMessageFormatter formatterForSource(String sourceLine) {
        Compiler compiler = new Compiler();
        compiler.init(
                java.util.Collections.<JSSourceFile>emptyList(),
                java.util.Collections.singletonList(JSSourceFile.fromCode(SOURCE_NAME, sourceLine)),
                new CompilerOptions());
        return new LightweightMessageFormatter(compiler);
    }

    private static String sanitizeSingleLine(String s) {
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\n' || c == '\r') {
                b.append(' ');
            } else {
                b.append(c);
            }
        }
        if (b.length() == 0) {
            b.append('x');
        }
        return b.toString();
    }

    private static String expectedFormatted(String sourceLine, int charno) {
        StringBuilder b = new StringBuilder();
        b.append(SOURCE_NAME);
        b.append(":1: ERROR - error description here\n");
        b.append(sourceLine);
        b.append('\n');
        if (0 <= charno && charno <= sourceLine.length()) {
            for (int i = 0; i < charno; i++) {
                char c = sourceLine.charAt(i);
                if (Character.isWhitespace(c)) {
                    b.append(c);
                } else {
                    b.append(' ');
                }
            }
            b.append("^\n");
        }
        return b.toString();
    }

    private static String indicatorLine(String formatted) {
        int nl1 = formatted.indexOf('\n');
        if (nl1 < 0) {
            return null;
        }
        int nl2 = formatted.indexOf('\n', nl1 + 1);
        if (nl2 < 0) {
            return null;
        }
        int nl3 = formatted.indexOf('\n', nl2 + 1);
        if (nl3 < 0) {
            return null;
        }
        return formatted.substring(nl2 + 1, nl3 + 1);
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        JSError seedError = JSError.make(SOURCE_NAME, 1, 10, FOO_TYPE);
        LightweightMessageFormatter seedFormatter = formatterForSource("assert (1;");
        String seedActual = seedFormatter.formatError(seedError);
        String seedExpected = "javascript/complex.js:1: ERROR - error description here\n" +
                "assert (1;\n" +
                "          ^\n";
