package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String SEED_INPUT =
            "var foo = function(a) { return getWindow(a); };"
                    + "var bar = function(b) { return b; };"
                    + "foo(bar(x));";
    private static final String SEED_EXPECTED = "getWindow(x)";

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        assertCompilesLike(
                SEED_INPUT,
                SEED_EXPECTED,
                "testDoubleInlining1");

        String id = makeIdentifier("x", data.consumeAsciiString(16));
        String fooName = makeIdentifier("f", data.consumeAsciiString(16));
        String barName = makeIdentifier("g", data.consumeAsciiString(16));

        if (fooName.equals(barName)) {
            barName = barName + "_b";
        }
        if (fooName.equals(id)) {
            fooName = fooName + "_f";
        }
        if (barName.equals(id)) {
            barName = barName + "_b";
        }
        if ("getWindow".equals(fooName)) {
            fooName = fooName + "_f";
        }
        if ("getWindow".equals(barName)) {
            barName = barName + "_b";
        }

        String generalizedInput =
                "var " + fooName + " = function(a) { return getWindow(a); };"
                        + "var " + barName + " = function(b) { return b; };"
                        + fooName + "(" + barName + "(" + id + "));";
        String generalizedExpected = "getWindow(" + id + ")";

        assertCompilesLike(
                generalizedInput,
                generalizedExpected,
                "double inlining output differed for constructed identifier family");

        String withIdentity = generalizedInput;
        String withoutIdentity =
                "var " + fooName + " = function(a) { return getWindow(a); };"
                        + fooName + "(" + id + ");";

        String left = compileAndNormalize(withIdentity);
        String right = compileAndNormalize(withoutIdentity);
        if (left != null && right != null && !left.equals(right)) {
            throw new RuntimeException(
                    "metamorphic violation: identity wrapper changed optimized result");
        }
    }

    private static void assertCompilesLike(String inputProgram, String expectedProgram, String label) {
        String actual = compileAndNormalize(inputProgram);
        String expected = compileAndNormalize(expectedProgram);
        if (actual == null || expected == null) {
            return;
        }
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: " + label + " expected [" + expected + "] but got [" + actual + "]");
        }
    }

    private static String compileAndNormalize(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);

        JSSourceFile[] externs = new JSSourceFile[] {
                JSSourceFile.fromCode("externs.js", "")
        };
        JSSourceFile[] inputs = new JSSourceFile[] {
                JSSourceFile.fromCode("input.js", js)
        };

        Result result = compiler.compile(externs, inputs, options);
        if (result == null || !result.success) {
            return null;
        }

        String out = compiler.toSource();
        return out == null ? "" : out.trim();
    }

    private static String makeIdentifier(String prefix, String raw) {
        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == '_'
                    || c == '$') {
                sb.append(c);
            } else {
                sb.append('_');
            }
        }
        return sb.toString();
    }
}
