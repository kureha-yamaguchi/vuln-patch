package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    private static String letters(String s, int maxLen, boolean upper) {
        int len = s.length();
        if (len > maxLen) {
            len = maxLen;
        }
        StringBuilder out = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            char c = s.charAt(i);
            if (upper) {
                if (c >= 'a' && c <= 'z') {
                    c = (char) (c - 'a' + 'A');
                }
                if (c < 'A' || c > 'Z') {
                    c = (char) ('A' + (i % 26));
                }
            } else {
                if (c >= 'A' && c <= 'Z') {
                    c = (char) (c - 'A' + 'a');
                }
                if (c < 'a' || c > 'z') {
                    c = (char) ('a' + (i % 26));
                }
            }
            out.append(c);
        }
        return out.toString();
    }

    private static Locale makeLocale(FuzzedDataProvider data) {
        int kind = data.consumeInt(0, 4);
        if (kind == 0) {
            return null;
        }
        if (kind == 1) {
            return new Locale(letters(data.consumeAsciiString(8), 8, false));
        }
        if (kind == 2) {
            return new Locale(
                    letters(data.consumeAsciiString(8), 8, false),
                    letters(data.consumeAsciiString(8), 8, true));
        }
        if (kind == 3) {
            return new Locale(
                    letters(data.consumeAsciiString(8), 8, false),
                    letters(data.consumeAsciiString(8), 8, true),
                    data.consumeAsciiString(8));
        }
        String lang = letters(data.consumeAsciiString(2), 2, false);
        String country = letters(data.consumeAsciiString(2), 2, true);
        String variant = data.consumeAsciiString(8);
        return new Locale(lang, country, variant);
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LocaleUtils.isAvailableLocale(new Locale("en"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US", "ZZZZ"));
        LocaleUtils.isAvailableLocale(new Locale("fr"));
        LocaleUtils.isAvailableLocale(new Locale("fr", "CA"));
        LocaleUtils.isAvailableLocale(new Locale("qq"));
        LocaleUtils.isAvailableLocale(new Locale("qq", "ZZ"));

        int count = data.consumeInt(1, 8);
        for (int i = 0; i < count; i++) {
            Locale locale = makeLocale(data);
            boolean a = LocaleUtils.isAvailableLocale(locale);
            boolean b = LocaleUtils.availableLocaleList().contains(locale);
            if (a != b) {
                throw new RuntimeException("metamorphic violation: isAvailableLocale(locale) != availableLocaleList().contains(locale)");
            }
        }
    }
}
