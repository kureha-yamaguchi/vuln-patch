        Complex finite = new Complex(real, imaginary);

        finite.equals(Complex.INF);
        Complex.INF.equals(finite);
        finite.equals(Complex.ZERO);
        Complex.ZERO.equals(finite);

        boolean lhs = Complex.NaN.equals(finite);
        boolean rhs = finite.equals(Complex.NaN);
        if (lhs != rhs) {
            throw new RuntimeException("metamorphic violation: equals symmetry");
        }
    }
}
