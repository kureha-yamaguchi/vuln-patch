package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    private static String letters(FuzzedDataProvider data, int len, boolean upper) {
        StringBuilder sb = new StringBuilder(len);
        char base = upper ? 'A' : 'a';
        for (int i = 0; i < len; i++) {
            sb.append((char) (base + ((data.consumeByte() & 0xff) % 26)));
        }
        return sb.toString();
    }

    private static String upperAlnum(FuzzedDataProvider data, int len) {
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int v = (data.consumeByte() & 0xff) % 36;
            sb.append(v < 26 ? (char) ('A' + v) : (char) ('0' + (v - 26)));
        }
        return sb.toString();
    }

    private static Locale makeFuzzLocale(FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            String language = letters(data, 2, false);
            int form = data.consumeInt(0, 2);
            String spec;
            if (form == 0) {
                spec = language;
            } else if (form == 1) {
                spec = language + "_" + letters(data, 2, true);
            } else {
                spec = language + "_" + letters(data, 2, true) + "_" + upperAlnum(data, data.consumeInt(1, 12));
            }
            return LocaleUtils.toLocale(spec);
        }

        return new Locale(
                letters(data, data.consumeInt(0, 3), false),
                letters(data, data.consumeInt(0, 3), true),
                upperAlnum(data, data.consumeInt(0, 12)));
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Locale[] anchors = new Locale[] {
                new Locale("en"),
                new Locale("en", "US"),
                new Locale("en", "US", "ZZZZ"),
                new Locale("fr"),
                new Locale("fr", "CA"),
                new Locale("qq"),
                new Locale("qq", "ZZ")
        };

        for (int i = 0; i < anchors.length; i++) {
            Locale locale = anchors[i];
            boolean actual = LocaleUtils.isAvailableLocale(locale);
            boolean expected = LocaleUtils.availableLocaleList().contains(locale);
            if (actual != expected) {
                throw new RuntimeException("metamorphic violation: isAvailableLocale != availableLocaleList().contains");
            }
        }

        int count = 1 + data.consumeInt(0, 7);
        for (int i = 0; i < count; i++) {
            Locale locale;
            try {
                locale = makeFuzzLocale(data);
            } catch (IllegalArgumentException expected) {
                continue;
            }

            boolean actual = LocaleUtils.isAvailableLocale(locale);
            boolean expected = LocaleUtils.availableLocaleList().contains(locale);
            if (actual != expected) {
                throw new RuntimeException("metamorphic violation: isAvailableLocale != availableLocaleList().contains");
            }
        }
    }
}
