package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone zone = DateTimeZone.forID("Europe/London");

        DateTime base = new DateTime(2011, 10, 30, 1, 15, zone);
        String baseString = base.toString();
        if (!"2011-10-30T01:15:00.000+01:00".equals(baseString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.toString() expected 2011-10-30T01:15:00.000+01:00 but got " + baseString);
        }

        String plusOneString = base.plusHours(1).toString();
        if (!"2011-10-30T01:15:00.000Z".equals(plusOneString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.plusHours(1).toString() expected 2011-10-30T01:15:00.000Z but got " + plusOneString);
        }

        int minute = data.consumeInt(0, 59);
        int second = data.consumeInt(0, 59);
        int millisOfSecond = data.consumeInt(0, 999);

        DateTime chosenUtc = new DateTime(2011, 10, 30, 0, minute, second, millisOfSecond, DateTimeZone.UTC);
        LocalDateTime chosenLondonLocal = chosenUtc.withZone(zone).toLocalDateTime();

        long localMillis = chosenLondonLocal.toDateTime(DateTimeZone.UTC).getMillis();
        int actualOffset = zone.getOffsetFromLocal(localMillis);
        int expectedOffset = (int) (localMillis - chosenUtc.getMillis());
        if (actualOffset != expectedOffset) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: getOffsetFromLocal expected " + expectedOffset + " but got " + actualOffset);
        }

        DateTime reconstructed = chosenLondonLocal.toDateTime(zone);
        if (reconstructed.getMillis() != chosenUtc.getMillis()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: LocalDateTime.toDateTime(Europe/London) expected millis "
                    + chosenUtc.getMillis() + " but got " + reconstructed.getMillis());
        }

        String reconstructedText = reconstructed.toString();
        DateTime reparsed = DateTime.parse(reconstructedText);
        if (reparsed.getMillis() != reconstructed.getMillis()) {
            throw new RuntimeException(
                "metamorphic violation: DateTime.parse(dt.toString()).getMillis() != dt.getMillis()");
        }
    }
}
