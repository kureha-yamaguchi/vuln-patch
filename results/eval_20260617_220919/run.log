package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            TimeSeries s1 = new TimeSeries("S1");
            s1.add(new Year(2009), 100.0);
            s1.add(new Year(2010), 101.0);
            s1.add(new Year(2011), 102.0);
            if (Double.compare(s1.getMinY(), 100.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.getMinY() != 100.0");
            }
            if (Double.compare(s1.getMaxY(), 102.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.getMaxY() != 102.0");
            }

            TimeSeries s2 = s1.createCopy(0, 1);
            if (Double.compare(s2.getMinY(), 100.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.createCopy(0, 1).getMinY() != 100.0");
            }
            if (Double.compare(s2.getMaxY(), 101.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.createCopy(0, 1).getMaxY() != 101.0");
            }

            TimeSeries s3 = s1.createCopy(1, 2);
            if (Double.compare(s3.getMinY(), 101.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.createCopy(1, 2).getMinY() != 101.0");
            }
            if (Double.compare(s3.getMaxY(), 102.0) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: s1.createCopy(1, 2).getMaxY() != 102.0");
            }

            String key = data.consumeString(20);
            int v0 = data.consumeInt();
            int v1 = data.consumeInt();
            int v2 = data.consumeInt();
            int start = data.consumeInt(0, 2);
            int end = data.consumeInt(0, 2);
            if (start > end) {
                int tmp = start;
                start = end;
                end = tmp;
            }

            TimeSeries fuzzSeries = new TimeSeries(key);
            fuzzSeries.add(new Year(2000), (double) v0);
            fuzzSeries.add(new Year(2001), (double) v1);
            fuzzSeries.add(new Year(2002), (double) v2);

            double[] values = new double[] {(double) v0, (double) v1, (double) v2};

            double expectedMinAll = values[0];
            double expectedMaxAll = values[0];
            for (int i = 1; i < values.length; i++) {
                if (values[i] < expectedMinAll) {
                    expectedMinAll = values[i];
                }
                if (values[i] > expectedMaxAll) {
                    expectedMaxAll = values[i];
                }
            }

            if (Double.compare(fuzzSeries.getMinY(), expectedMinAll) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: fuzzSeries.getMinY()");
            }
            if (Double.compare(fuzzSeries.getMaxY(), expectedMaxAll) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: fuzzSeries.getMaxY()");
            }

            TimeSeries sub = fuzzSeries.createCopy(start, end);

            double expectedMin = values[start];
            double expectedMax = values[start];
            for (int i = start + 1; i <= end; i++) {
                if (values[i] < expectedMin) {
                    expectedMin = values[i];
                }
                if (values[i] > expectedMax) {
                    expectedMax = values[i];
                }
            }

            if (!fuzzSeries.getKey().equals(sub.getKey())) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: createCopy changed series key");
            }
            if (sub.getItemCount() != end - start + 1) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: createCopy item count");
            }
            if (Double.compare(sub.getMinY(), expectedMin) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: createCopy minY");
            }
            if (Double.compare(sub.getMaxY(), expectedMax) != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: createCopy maxY");
            }
            for (int i = 0; i < sub.getItemCount(); i++) {
                TimeSeriesDataItem item = sub.getDataItem(i);
                Year expectedPeriod = new Year(2000 + start + i);
                double expectedValue = values[start + i];
                if (!expectedPeriod.equals(item.getPeriod())) {
