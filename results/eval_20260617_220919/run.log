package org.jfree.chart.renderer.category;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
import org.jfree.chart.LegendItemCollection;
import org.jfree.chart.plot.CategoryPlot;
import org.jfree.data.category.DefaultCategoryDataset;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        AbstractCategoryItemRenderer r = new LineAndShapeRenderer();
        LegendItemCollection initial = r.getLegendItems();
        if (initial == null) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected non-null legend items");
        }
        if (initial.getItemCount() != 0) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected 0 legend items before plot assignment");
        }

        DefaultCategoryDataset dataset = new DefaultCategoryDataset();
        CategoryPlot plot = new CategoryPlot();
        plot.setDataset(dataset);
        plot.setRenderer(r);

        LegendItemCollection empty = r.getLegendItems();
        if (empty == null) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected non-null legend items after empty dataset assignment");
        }
        if (empty.getItemCount() != 0) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected 0 legend items for empty dataset");
        }

        dataset.addValue(1.0, "S1", "C1");
        LegendItemCollection lic = r.getLegendItems();
        if (lic == null) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected non-null legend items after adding S1/C1");
        }
        if (lic.getItemCount() != 1) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected 1 legend item after adding single series");
        }
        if (!"S1".equals(lic.get(0).getLabel())) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected legend label S1");
        }

        int seriesCount = data.consumeInt(1, 4);
        String baseCategory = data.consumeString(16);
        if (baseCategory.length() == 0) {
            baseCategory = "C";
        }

        AbstractCategoryItemRenderer fuzzRenderer = new LineAndShapeRenderer();
        DefaultCategoryDataset fuzzDataset = new DefaultCategoryDataset();
        CategoryPlot fuzzPlot = new CategoryPlot();
        fuzzPlot.setDataset(fuzzDataset);
        fuzzPlot.setRenderer(fuzzRenderer);

        for (int i = 0; i < seriesCount; i++) {
            String seriesKey = "S" + i + "_" + data.consumeString(8);
            fuzzDataset.addValue(Integer.valueOf(data.consumeInt()), seriesKey, baseCategory);
        }

        LegendItemCollection fuzzLegendItems = fuzzRenderer.getLegendItems();
        if (fuzzLegendItems == null) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: expected non-null legend items for constructed dataset");
        }
        if (fuzzLegendItems.getItemCount() != seriesCount) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: legend item count differs from constructed series count");
