            if (result == null || !result.success) {
                return;
            }

            String actual = compiler.toSource();
            if (actual == null) {
                actual = "";
            }
            normalizedGeneralizedActual = actual.replaceAll("\\s+", "");
            while (normalizedGeneralizedActual.endsWith(";")) {
                normalizedGeneralizedActual =
                        normalizedGeneralizedActual.substring(0, normalizedGeneralizedActual.length() - 1);
            }

            String normalizedExpected = generalizedExpected.replaceAll("\\s+", "");
            if (!normalizedExpected.equals(normalizedGeneralizedActual)) {
                throw new FuzzerSecurityIssueLow(
                        "semantic mismatch: expected " + generalizedExpected + " but got " + actual);
            }
        }

        {
