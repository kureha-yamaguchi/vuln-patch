package org.joda.time.field;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.DateTimeFieldType;
import org.joda.time.Partial;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Partial test = new Partial()
                .with(DateTimeFieldType.hourOfDay(), 10)
                .with(DateTimeFieldType.minuteOfHour(), 20);

        boolean sawExpectedIllegalArgumentException = false;
        try {
            test.with(DateTimeFieldType.clockhourOfDay(), 6);
        } catch (IllegalArgumentException ex) {
            sawExpectedIllegalArgumentException = true;
        }

        if (!sawExpectedIllegalArgumentException) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected IllegalArgumentException from test.with(DateTimeFieldType.clockhourOfDay(), 6)");
        }

        if (test.get(DateTimeFieldType.hourOfDay()) != 10 || test.get(DateTimeFieldType.minuteOfHour()) != 20) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: check(test, 10, 20)");
        }

        int hour = data.consumeInt(0, 23);
        int minute = data.consumeInt(0, 59);
        int arbitraryClockHour = data.consumeInt(1, 24);

        Partial fuzzBase = new Partial()
                .with(DateTimeFieldType.hourOfDay(), hour)
                .with(DateTimeFieldType.minuteOfHour(), minute);

        boolean fuzzSawExpectedIllegalArgumentException = false;
        try {
            fuzzBase.with(DateTimeFieldType.clockhourOfDay(), 6);
        } catch (IllegalArgumentException ex) {
            fuzzSawExpectedIllegalArgumentException = true;
        }

        if (!fuzzSawExpectedIllegalArgumentException) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: expected IllegalArgumentException from hour/minute partial with(DateTimeFieldType.clockhourOfDay(), 6)");
        }

        try {
            fuzzBase.with(DateTimeFieldType.clockhourOfDay(), arbitraryClockHour);
        } catch (IllegalArgumentException ignored) {
        }

        Partial equivalent = new Partial(
                new DateTimeFieldType[] {
                        DateTimeFieldType.hourOfDay(),
                        DateTimeFieldType.minuteOfHour()
                },
                new int[] { hour, minute }
        );

        Partial resultA = null;
        Partial resultB = null;
        boolean threwA = false;
        boolean threwB = false;

        try {
            resultA = fuzzBase.with(DateTimeFieldType.clockhourOfDay(), arbitraryClockHour);
        } catch (IllegalArgumentException ex) {
            threwA = true;
        }

        try {
            resultB = equivalent.with(DateTimeFieldType.clockhourOfDay(), arbitraryClockHour);
        } catch (IllegalArgumentException ex) {
            threwB = true;
        }

        if (threwA != threwB) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent Partial constructions must agree on whether with(clockhourOfDay, v) throws");
        }
        if (!threwA && !resultA.equals(resultB)) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent Partial constructions must yield equal results for with(clockhourOfDay, v)");
        }
    }
}
