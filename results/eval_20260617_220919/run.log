package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone zone = DateTimeZone.forID("Europe/London");

        DateTime base = new DateTime(2011, 10, 30, 1, 15, zone);
        String baseString = base.toString();
        if (!"2011-10-30T01:15:00.000+01:00".equals(baseString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.toString() was " + baseString);
        }

        String plusOneString = base.plusHours(1).toString();
        if (!"2011-10-30T01:15:00.000Z".equals(plusOneString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.plusHours(1).toString() was " + plusOneString);
        }

        int minute = data.consumeInt(0, 59);

        DateTime expectedLocal = new DateTime(
            new DateTime(2011, 10, 30, 0, minute, DateTimeZone.UTC).getMillis(),
            zone);
        DateTime actualLocal = new DateTime(2011, 10, 30, 1, minute, zone);
        if (actualLocal.getMillis() != expectedLocal.getMillis()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: overlap constructor chose " + actualLocal.toString()
                    + " instead of " + expectedLocal.toString());
        }

        DateTime expectedPlus = new DateTime(
            new DateTime(2011, 10, 30, 1, minute, DateTimeZone.UTC).getMillis(),
            zone);
        DateTime actualPlus = actualLocal.plusHours(1);
        if (actualPlus.getMillis() != expectedPlus.getMillis()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: overlap plusHours(1) produced " + actualPlus.toString()
                    + " instead of " + expectedPlus.toString());
        }

        if (data.remainingBytes() > 0) {
            int year = data.consumeInt(1900, 2100);
            int month = data.consumeInt(1, 12);
            int day = data.consumeInt(1, 28);
            int hour = data.consumeInt(0, 23);
            int randomMinute = data.consumeInt(0, 59);
            int deltaHours = data.consumeInt(-48, 48);
            new DateTime(year, month, day, hour, randomMinute, zone).plusHours(deltaHours).toString();
        }

        DateTime reconstructed = new DateTime(
            expectedLocal.getYear(),
            expectedLocal.getMonthOfYear(),
            expectedLocal.getDayOfMonth(),
            expectedLocal.getHourOfDay(),
            expectedLocal.getMinuteOfHour(),
            zone);
        if (reconstructed.getMillis() != expectedLocal.getMillis()) {
            throw new RuntimeException(
                "metamorphic violation: reconstructing Europe/London overlap local fields from a known UTC instant changed the instant");
        }
    }
}
