package org.apache.commons.math.complex;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static double consumeDouble(FuzzedDataProvider data) {
        long high = ((long) data.consumeInt()) << 32;
        long low = ((long) data.consumeInt()) & 0xffffffffL;
        return Double.longBitsToDouble(high | low);
    }

    private static boolean sameComplex(Complex a, Complex b) {
        return Double.doubleToLongBits(a.getReal()) == Double.doubleToLongBits(b.getReal())
                && Double.doubleToLongBits(a.getImaginary()) == Double.doubleToLongBits(b.getImaginary());
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Complex x = new Complex(3.0, 4.0);
        Complex z = x.add(Complex.NaN);
        if (!z.isNaN()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: x.add(Complex.NaN).isNaN() was false");
        }

        z = new Complex(1, Double.NaN);
        Complex w = x.add(z);
        if (!Double.isNaN(w.getReal())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: Double.isNaN(w.getReal()) was false");
        }
        if (!Double.isNaN(w.getImaginary())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: Double.isNaN(w.getImaginary()) was false");
        }

        double lhsReal = consumeDouble(data);
        double lhsImag = consumeDouble(data);
        double rhsReal = consumeDouble(data);
        double rhsImag = consumeDouble(data);
        double carrier = consumeDouble(data);

        Complex lhs = new Complex(lhsReal, lhsImag);
        Complex rhs = new Complex(rhsReal, rhsImag);

        lhs.add(rhs);

        Complex partialNaN = data.consumeBoolean()
                ? new Complex(carrier, Double.NaN)
                : new Complex(Double.NaN, carrier);

        partialNaN.add(rhs);
        Complex.NaN.add(rhs);

        Complex left = lhs.add(partialNaN);
        Complex right = lhs.add(Complex.NaN);
        if (!sameComplex(left, right)) {
            throw new RuntimeException(
                    "metamorphic violation: add(any NaN complex) must agree with add(Complex.NaN)");
        }
    }
}
