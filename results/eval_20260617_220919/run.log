public class FuzzHarness {
    private static String normalizeLowerAlpha(String s, int len, char fallback) {
        StringBuilder out = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            char c = i < s.length() ? s.charAt(i) : fallback;
            if (c >= 'A' && c <= 'Z') {
                c = (char) (c - 'A' + 'a');
            }
            if (c < 'a' || c > 'z') {
                c = fallback;
            }
            out.append(c);
        }
        return out.toString();
    }

    private static String normalizeUpperAlpha(String s, int len, char fallback) {
        StringBuilder out = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            char c = i < s.length() ? s.charAt(i) : fallback;
            if (c >= 'a' && c <= 'z') {
                c = (char) (c - 'a' + 'A');
            }
            if (c < 'A' || c > 'Z') {
                c = fallback;
            }
            out.append(c);
        }
        return out.toString();
    }

    private static String normalizeVariant(String s) {
        if (s == null || s.length() == 0) {
            return "ZZZZ";
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '_') {
                c = 'V';
            }
            out.append(c);
        }
        return out.toString();
    }

    private static Locale buildLocale(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            return null;
        }
        if (mode == 1) {
            return new Locale(
                    normalizeLowerAlpha(data.consumeAsciiString(8), 2, 'q'));
        }
        if (mode == 2) {
            return new Locale(
                    normalizeLowerAlpha(data.consumeAsciiString(8), 2, 'q'),
                    normalizeUpperAlpha(data.consumeAsciiString(8), 2, 'Z'));
        }
        if (mode == 3) {
            return new Locale(
                    normalizeLowerAlpha(data.consumeAsciiString(8), 2, 'q'),
                    normalizeUpperAlpha(data.consumeAsciiString(8), 2, 'Z'),
                    normalizeVariant(data.consumeAsciiString(8)));
        }

        String language = normalizeLowerAlpha(data.consumeAsciiString(8), 2, 'q');
        String country = normalizeUpperAlpha(data.consumeAsciiString(8), 2, 'Z');
        String variant = normalizeVariant(data.consumeAsciiString(8));
        int shape = data.consumeInt(0, 2);
        String localeString;
        if (shape == 0) {
            localeString = language;
        } else if (shape == 1) {
            localeString = language + "_" + country;
        } else {
            localeString = language + "_" + country + "_" + variant;
        }
        try {
            return LocaleUtils.toLocale(localeString);
        } catch (IllegalArgumentException expectedValidation) {
            return null;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LocaleUtils.availableLocaleSet();

        Locale[] anchorLocales = new Locale[] {
            new Locale("en"),
            new Locale("en", "US"),
            new Locale("en", "US", "ZZZZ"),
            new Locale("fr"),
            new Locale("fr", "CA"),
            new Locale("qq"),
