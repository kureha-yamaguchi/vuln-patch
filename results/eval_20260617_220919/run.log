                "alert(baz(foo(" + Integer.toString(a) + "+" + Integer.toString(b) + ")))";

        String actualGenerated = runInlineFunctions(generatedSource);
        if (!normalizeJs(actualGenerated).equals(normalizeJs(generatedExpected))) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: generated output differed, expected "
                            + generatedExpected
                            + " but got "
                            + actualGenerated);
        }

        String whitespaceVariant =
                "function  BAR_FN ( x , y , z ) {\n"
                        + "  return  z ( foo ( x + y ) )\n"
                        + "}\n"
                        + "alert ( BAR_FN ( "
                        + a
                        + " , "
                        + b
                        + " , baz ) )";

        String variantOutput = runInlineFunctions(whitespaceVariant);
        if (!normalizeJs(actualGenerated).equals(normalizeJs(variantOutput))) {
            throw new RuntimeException(
                    "metamorphic violation: whitespace-equivalent inputs compiled differently");
        }
    }

    private static String runInlineFunctions(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        options.inlineFunctions = true;
        options.inlineLocalFunctions = true;

        SourceFile externs =
                SourceFile.fromCode(
                        "externs.js",
                        "function alert(x){}\nfunction foo(x){}\nfunction baz(x){}\n");
        SourceFile input = SourceFile.fromCode("input.js", js);

        compiler.compile(
                Collections.singletonList(externs),
                Collections.singletonList(input),
                options);
        String out = compiler.toSource();
        return out == null ? "" : out;
    }

    private static String normalizeJs(String js) {
        if (js == null) {
            return "";
        }
        StringBuilder sb = new StringBuilder(js.length());
        for (int i = 0; i < js.length(); i++) {
            char c = js.charAt(i);
            if (!Character.isWhitespace(c) && c != ';') {
                sb.append(c);
            }
        }
        return sb.toString();
    }
}
