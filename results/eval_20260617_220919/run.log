package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LocaleUtils.isAvailableLocale(new Locale("en"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US", "ZZZZ"));
        LocaleUtils.isAvailableLocale(new Locale("fr"));
        LocaleUtils.isAvailableLocale(new Locale("fr", "CA"));
        LocaleUtils.isAvailableLocale(new Locale("qq"));
        LocaleUtils.isAvailableLocale(new Locale("qq", "ZZ"));

        char lang1 = (char) ('a' + data.consumeInt(0, 25));
        char lang2 = (char) ('a' + data.consumeInt(0, 25));
        char country1 = (char) ('A' + data.consumeInt(0, 25));
        char country2 = (char) ('A' + data.consumeInt(0, 25));

        int variantLen = data.consumeInt(0, 8);
        StringBuffer variant = new StringBuffer();
        for (int i = 0; i < variantLen; i++) {
            variant.append((char) ('A' + data.consumeInt(0, 25)));
        }

        String baseLang = new String(new char[] { lang1, lang2 });
        String baseCountry = new String(new char[] { country1, country2 });

        String localeSpec;
        int specKind = data.consumeInt(0, 2);
        if (specKind == 0) {
            localeSpec = baseLang;
        } else if (specKind == 1) {
            localeSpec = baseLang + "_" + baseCountry;
        } else {
            localeSpec = baseLang + "_" + baseCountry + "_" + variant.toString();
        }

        Locale parsedLocale = null;
        try {
            parsedLocale = LocaleUtils.toLocale(data.consumeBoolean() ? null : localeSpec);
        } catch (IllegalArgumentException expected) {
            parsedLocale = null;
        }

        Locale arbitraryLocale = new Locale(
                data.consumeAsciiString(8),
                data.consumeAsciiString(8),
                data.consumeAsciiString(16));

        Locale[] jdkLocales = Locale.getAvailableLocales();
        Locale jdkLocale = null;
        if (jdkLocales.length > 0) {
            jdkLocale = jdkLocales[data.consumeInt(0, jdkLocales.length - 1)];
        }

        Locale nullableLocale = data.consumeBoolean() ? null : arbitraryLocale;

        LocaleUtils.isAvailableLocale(parsedLocale);
        LocaleUtils.isAvailableLocale(arbitraryLocale);
        LocaleUtils.isAvailableLocale(jdkLocale);
        LocaleUtils.isAvailableLocale(nullableLocale);

        Locale checkLocale = parsedLocale;
        if (checkLocale == null) {
            checkLocale = arbitraryLocale;
        }
        if (data.consumeBoolean()) {
            checkLocale = jdkLocale;
        }
        if (data.consumeBoolean()) {
            checkLocale = null;
        }

        boolean expected = LocaleUtils.availableLocaleSet().contains(checkLocale);
        boolean actual = LocaleUtils.isAvailableLocale(checkLocale);
        if (expected != actual) {
            throw new RuntimeException(
                    "metamorphic violation: availableLocaleSet().contains(locale) == isAvailableLocale(locale)");
