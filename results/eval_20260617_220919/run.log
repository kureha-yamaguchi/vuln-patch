package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = printWithCodePrinter("x- -0");
        if (!"x- -0.0".equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: CodePrinter(\"x- -0\") returned "
                    + String.valueOf(seedActual)
                    + ", expected x- -0.0");
        }

        String id = makeIdentifier(data.consumeAsciiString(16));
        String generalizedSource = id + "- -0";
        String generalizedExpected = id + "- -0.0";
        String generalizedActual = printWithCodePrinter(generalizedSource);
        if (!generalizedExpected.equals(generalizedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: CodePrinter(\""
                    + generalizedSource
                    + "\") returned "
                    + String.valueOf(generalizedActual)
                    + ", expected "
                    + generalizedExpected);
        }

        String canonicalFromNegZero = generalizedActual;
        String canonicalFromNegZeroPointZero = printWithCodePrinter(id + "- -0.0");
        if (canonicalFromNegZero != null
            && canonicalFromNegZeroPointZero != null
            && !canonicalFromNegZero.equals(canonicalFromNegZeroPointZero)) {
            throw new RuntimeException(
                "metamorphic violation: CodePrinter should canonicalize -0 and -0.0 identically after binary minus");
        }

        if (data.remainingBytes() > 0) {
            String extraId = makeIdentifier(data.consumeRemainingAsString());
            printWithCodePrinter(extraId + "- -0");
        }
    }

    private static String printWithCodePrinter(String js) {
        Compiler compiler = new Compiler();
        Node root = compiler.parseTestCode(js);
        if (root == null) {
            return null;
        }
        return new CodePrinter.Builder(root).build();
    }

    private static String makeIdentifier(String raw) {
        StringBuilder sb = new StringBuilder();
        sb.append('x');
        for (int i = 0; i < raw.length() && sb.length() < 17; i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '_'
                || c == '$') {
                sb.append(c);
            } else {
                sb.append((char) ('a' + ((c & 0x0f) % 26)));
            }
        }
        return sb.toString();
    }
}
