public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        AbstractCategoryItemRenderer r = new LineAndShapeRenderer();

        LegendItemCollection initial = r.getLegendItems();
        if (initial == null) {
            semantic("getLegendItems() returned null");
        }
        if (initial.getItemCount() != 0) {
            semantic("expected 0 legend items before attaching to a plot");
        }

        DefaultCategoryDataset dataset = new DefaultCategoryDataset();
        CategoryPlot plot = new CategoryPlot();
        plot.setDataset(dataset);
        plot.setRenderer(r);

        LegendItemCollection empty = r.getLegendItems();
        if (empty == null) {
            semantic("getLegendItems() returned null for empty dataset");
        }
        if (empty.getItemCount() != 0) {
            semantic("expected 0 legend items for empty dataset");
        }

        dataset.addValue(1.0, "S1", "C1");
        LegendItemCollection lic = r.getLegendItems();
        if (lic == null) {
            semantic("getLegendItems() returned null after adding a series");
        }
        if (lic.getItemCount() != 1) {
            semantic("expected 1 legend item after adding dataset series");
        }
        if (lic.get(0) == null || !"S1".equals(lic.get(0).getLabel())) {
            semantic("expected first legend label S1");
        }

        int extraColumns = data.consumeInt(0, 8);
        DefaultCategoryDataset equivalentDataset = new DefaultCategoryDataset();
        equivalentDataset.addValue(1.0, "S1", "C1");
        for (int i = 0; i < extraColumns; i++) {
            equivalentDataset.addValue(
                    (double) data.consumeInt(),
                    "S1",
                    "C" + (i + 2) + data.consumeAsciiString(8));
        }

        LineAndShapeRenderer equivalentRenderer = new LineAndShapeRenderer();
        CategoryPlot equivalentPlot = new CategoryPlot();
        equivalentPlot.setDataset(equivalentDataset);
        equivalentPlot.setRenderer(equivalentRenderer);

        LegendItemCollection equivalent = equivalentRenderer.getLegendItems();
        if (equivalent == null) {
            semantic("getLegendItems() returned null for equivalent single-series dataset");
        }
        if (equivalent.getItemCount() != 1) {
            semantic("expected 1 legend item for equivalent single-series dataset");
        }
        if (equivalent.get(0) == null || !"S1".equals(equivalent.get(0).getLabel())) {
            semantic("expected first legend label S1 for equivalent single-series dataset");
        }

        equivalentPlot.setRowRenderingOrder(SortOrder.ASCENDING);
        LegendItemCollection ascending = equivalentRenderer.getLegendItems();
        equivalentPlot.setRowRenderingOrder(SortOrder.DESCENDING);
        LegendItemCollection descending = equivalentRenderer.getLegendItems();

        if (ascending == null || descending == null) {
            throw new RuntimeException("metamorphic violation: changing row rendering order produced null legend items");
        }
        if (ascending.getItemCount() != descending.getItemCount()) {
            throw new RuntimeException("metamorphic violation: single-series legend item count changed with row rendering order");
        }
        if (ascending.getItemCount() > 0) {
            String a = ascending.get(0) == null ? null : ascending.get(0).getLabel();
            String d = descending.get(0) == null ? null : descending.get(0).getLabel();
            if (a == null ? d != null : !a.equals(d)) {
                throw new RuntimeException("metamorphic violation: single-series legend label changed with row rendering order");
            }
        }
    }

    private static void semantic(String whatDiffered) {
        throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
