package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone zone = DateTimeZone.forID("Europe/London");

        DateTime base = new DateTime(2011, 10, 30, 1, 15, zone);
        String baseString = base.toString();
        if (!"2011-10-30T01:15:00.000+01:00".equals(baseString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.toString() expected 2011-10-30T01:15:00.000+01:00 but got " + baseString);
        }

        String plusOneString = base.plusHours(1).toString();
        if (!"2011-10-30T01:15:00.000Z".equals(plusOneString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.plusHours(1).toString() expected 2011-10-30T01:15:00.000Z but got " + plusOneString);
        }

        int overlapMinute = data.consumeInt(0, 59);
        DateTime chosenEarlierInstant = new DateTime(2011, 10, 30, 0, overlapMinute, DateTimeZone.UTC).withZone(zone);
        if (chosenEarlierInstant.getYear() == 2011
                && chosenEarlierInstant.getMonthOfYear() == 10
                && chosenEarlierInstant.getDayOfMonth() == 30
                && chosenEarlierInstant.getHourOfDay() == 1
                && chosenEarlierInstant.getMinuteOfHour() == overlapMinute) {
            DateTime reconstructed = new DateTime(
                chosenEarlierInstant.getYear(),
                chosenEarlierInstant.getMonthOfYear(),
                chosenEarlierInstant.getDayOfMonth(),
                chosenEarlierInstant.getHourOfDay(),
                chosenEarlierInstant.getMinuteOfHour(),
                zone);
            if (!chosenEarlierInstant.toString().equals(reconstructed.toString())) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: reconstructing Europe/London overlap local time changed "
                        + chosenEarlierInstant.toString() + " to " + reconstructed.toString());
            }
        }

        int year = data.consumeInt(2000, 2022);
        int month = data.consumeInt(1, 12);
        int day = data.consumeInt(1, 28);
        int hour = data.consumeInt(0, 23);
        int minute = data.consumeInt(0, 59);
        DateTime fuzzed = new DateTime(year, month, day, hour, minute, zone);
        fuzzed.toString();
        fuzzed.plusHours(data.consumeInt(-2, 2)).toString();

        DateTime roundTripBase = new DateTime(2011, 10, 30, 1, overlapMinute, zone);
        DateTime roundTrip = roundTripBase.plusHours(1).minusHours(1);
        if (roundTrip.getMillis() != roundTripBase.getMillis()) {
            throw new RuntimeException("metamorphic violation: plusHours(1).minusHours(1) should preserve the instant");
        }
    }
}
