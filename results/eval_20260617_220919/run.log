package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.IR;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedActual = new CodePrinter.Builder(
                IR.sub(IR.name("x"), IR.number(-0.0d))
        ).build();
        if (!"x- -0.0".equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: CodePrinter printed '" + seedActual + "' instead of 'x- -0.0'"
            );
        }

        int len = data.consumeInt(1, 16);
        StringBuilder id = new StringBuilder(len);
        id.append((char) ('a' + Math.floorMod(data.consumeInt(), 26)));
        for (int i = 1; i < len; i++) {
            int selector = Math.floorMod(data.consumeInt(), 38);
            if (selector < 26) {
                id.append((char) ('a' + selector));
            } else if (selector < 36) {
                id.append((char) ('0' + (selector - 26)));
            } else if (selector == 36) {
                id.append('_');
            } else {
                id.append('$');
            }
        }
        String identifier = id.toString();

        String actual = new CodePrinter.Builder(
                IR.sub(IR.name(identifier), IR.number(-0.0d))
        ).build();
        String expected = identifier + "- -0.0";
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: CodePrinter printed '" + actual + "' instead of '" + expected + "'"
            );
        }

        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        double arbitrary = Double.longBitsToDouble(hi | lo);
        new CodePrinter.Builder(
                IR.sub(IR.name(identifier), IR.number(arbitrary))
        ).build();

        String m1 = new CodePrinter.Builder(
                IR.sub(IR.name(identifier), IR.number(-0.0d))
        ).build();
        String m2 = new CodePrinter.Builder(
                IR.sub(IR.name(identifier), IR.number(Double.longBitsToDouble(0x8000000000000000L)))
        ).build();
        if (!m1.equals(m2)) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent negative-zero values must print identically"
            );
        }
    }
}
