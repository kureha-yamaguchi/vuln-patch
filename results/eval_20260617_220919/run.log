package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;
import com.google.javascript.rhino.Token;

public class FuzzHarness {
    private static final ClosureCodingConvention CONVENTION = new ClosureCodingConvention();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        assertSemanticEquals("goog.require('foo')", "foo",
                extractRequire(makeGoogCall("require", stringNode("foo"))));
        assertSemanticEquals("goog.require(foo)", null,
                extractRequire(makeGoogCall("require", nameNode("foo"))));
        assertSemanticEquals("goog.require()", null,
                extractRequire(makeGoogCall("require", null)));
        assertSemanticEquals("foo()", null,
                extractRequire(makeSimpleCall("foo", null)));

        String chosenClassName = data.consumeString(64);
        assertSemanticEquals("goog.require('<fuzzed-string>')", chosenClassName,
                extractRequire(makeGoogCall("require", stringNode(chosenClassName))));

        String fuzzedIdentifier = sanitizeIdentifier(data.consumeAsciiString(32), "seed");
        assertSemanticEquals("goog.require(<fuzzed-identifier>)", null,
                extractRequire(makeGoogCall("require", nameNode(fuzzedIdentifier))));

        String id1 = sanitizeIdentifier(data.consumeAsciiString(32), "left");
        String id2 = sanitizeIdentifier(data.consumeAsciiString(32), "right");
        if (id1.equals(id2)) {
            id2 = id2 + "_x";
        }

        String result1 = extractRequire(makeGoogCall("require", nameNode(id1)));
        String result2 = extractRequire(makeGoogCall("require", nameNode(id2)));
        if (result1 == null ? result2 != null : !result1.equals(result2)) {
            throw new RuntimeException(
                    "metamorphic violation: goog.require(NAME) should not depend on which NAME is used");
        }
    }

    private static String extractRequire(Node exprResult) {
        Node call = exprResult.getFirstChild();
        return CONVENTION.extractClassNameIfRequire(call, exprResult);
    }

    private static Node makeGoogCall(String functionName, Node arg) {
