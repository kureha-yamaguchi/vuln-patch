    private static String sanitizeIdentifier(String s, String fallback) {
        String base = (s == null || s.length() == 0) ? fallback : s;
        StringBuilder out = new StringBuilder("v");
        for (int i = 0; i < base.length(); i++) {
            char c = base.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == '_'
                    || c == '$') {
                out.append(c);
            } else {
                out.append('_');
            }
        }
