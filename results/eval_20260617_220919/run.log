    private static void checkLegendItems(AbstractCategoryItemRenderer r, int expectedCount,
                                         String expectedFirstLabel, String where) {
        LegendItemCollection lic = r.getLegendItems();
        if (lic == null) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: getLegendItems() returned null at " + where);
        }
        if (lic.getItemCount() != expectedCount) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: item count at " + where + " expected " + expectedCount + " but got "
                            + lic.getItemCount());
        }
        if (expectedFirstLabel != null) {
            if (lic.getItemCount() == 0) {
                throw new FuzzerSecurityIssueLow(
                        "semantic mismatch: missing first legend item at " + where);
            }
            String actual = lic.get(0).getLabel();
            if (!expectedFirstLabel.equals(actual)) {
                throw new FuzzerSecurityIssueLow(
                        "semantic mismatch: first label at " + where + " expected " + expectedFirstLabel
                                + " but got " + actual);
            }
        }
    }
