package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            TimeSeries s1 = new TimeSeries("S1");
            s1.add(new Year(2009), 100.0);
            s1.add(new Year(2010), 101.0);
            s1.add(new Year(2011), 102.0);
            requireEquals(s1.getMinY(), 100.0, "s1.getMinY()");
            requireEquals(s1.getMaxY(), 102.0, "s1.getMaxY()");

            TimeSeries s2 = s1.createCopy(0, 1);
            requireEquals(s2.getMinY(), 100.0, "s2.getMinY()");
            requireEquals(s2.getMaxY(), 101.0, "s2.getMaxY()");

            TimeSeries s3 = s1.createCopy(1, 2);
            requireEquals(s3.getMinY(), 101.0, "s3.getMinY()");
            requireEquals(s3.getMaxY(), 102.0, "s3.getMaxY()");

            int startYear = data.consumeInt(1900, 9997);
            int base = data.consumeInt(-1000000, 1000000);
            int inc1 = data.consumeInt(1, 1000);
            int inc2 = data.consumeInt(1, 1000);
            String key = data.consumeAsciiString(16);
            if (key.length() == 0) {
                key = "S";
            }

            double v0 = base;
            double v1 = base + inc1;
            double v2 = base + inc1 + inc2;

            TimeSeries fuzzSeries = new TimeSeries(key);
            fuzzSeries.add(new Year(startYear), v0);
            fuzzSeries.add(new Year(startYear + 1), v1);
            fuzzSeries.add(new Year(startYear + 2), v2);

            TimeSeries copy01 = fuzzSeries.createCopy(0, 1);
            requireEquals(copy01.getMinY(), v0, "copy01.getMinY()");
            requireEquals(copy01.getMaxY(), v1, "copy01.getMaxY()");

            TimeSeries copy12 = fuzzSeries.createCopy(1, 2);
            requireEquals(copy12.getMinY(), v1, "copy12.getMinY()");
            requireEquals(copy12.getMaxY(), v2, "copy12.getMaxY()");

            TimeSeries copyAll = fuzzSeries.createCopy(0, fuzzSeries.getItemCount() - 1);
            requireEquals(copyAll.getMinY(), fuzzSeries.getMinY(), "copyAll.getMinY()");
            requireEquals(copyAll.getMaxY(), fuzzSeries.getMaxY(), "copyAll.getMaxY()");

            if (!fuzzSeries.equals(copyAll) || !copyAll.equals(fuzzSeries)) {
                throw new RuntimeException(
                    "metamorphic violation: createCopy(0, itemCount-1) must equal the original series");
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException(e);
        }
    }

    private static void requireEquals(double actual, double expected, String what) {
        if (Double.compare(actual, expected) != 0) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: " + what + " expected " + expected + " but got " + actual);
        }
    }
}
