import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            String[] seedOriginal = new String[] {
                "goog.require('beer');",
                "goog.provide('beer');\ngoog.require('hops');",
                "goog.provide('hops');",
            };
            String[] seedExpected = new String[] {
                "goog.provide('hops');",
                "goog.provide('beer');\ngoog.require('hops');",
                "goog.require('beer');"
            };

            int id1 = data.consumeInt();
            int id2 = data.consumeInt();
            if (id1 == id2) {
                id2 = id1 + 1;
            }
            String beer = "ns" + Integer.toHexString(id1);
            String hops = "ns" + Integer.toHexString(id2);
            if (beer.equals(hops)) {
                hops = hops + "x";
            }

            String[] fuzzOriginal = new String[] {
                "goog.require('" + beer + "');",
                "goog.provide('" + beer + "');\ngoog.require('" + hops + "');",
                "goog.provide('" + hops + "');",
            };
            String[] fuzzExpected = new String[] {
                "goog.provide('" + hops + "');",
                "goog.provide('" + beer + "');\ngoog.require('" + hops + "');",
                "goog.require('" + beer + "');"
            };

            java.util.ArrayList<String[]> sourceSets = new java.util.ArrayList<String[]>();
            sourceSets.add(seedOriginal);
            sourceSets.add(fuzzOriginal);
            sourceSets.add(fuzzExpected);

            java.util.ArrayList<String> normalizedOutputs = new java.util.ArrayList<String>();

            for (int setIndex = 0; setIndex < sourceSets.size(); setIndex++) {
                java.io.File dir = java.nio.file.Files.createTempDirectory("jazzer-closure-").toFile();
                try {
                    java.io.File outFile = new java.io.File(dir, "out.js");
                    java.util.ArrayList<String> cliArgs = new java.util.ArrayList<String>();
                    cliArgs.add("--manage_closure_dependencies");
                    cliArgs.add("--compilation_level=WHITESPACE_ONLY");
                    cliArgs.add("--js_output_file=" + outFile.getAbsolutePath());

                    String[] sources = sourceSets.get(setIndex);
                    for (int i = 0; i < sources.length; i++) {
                        java.io.File inFile = new java.io.File(dir, "input" + i + ".js");
                        java.nio.file.Files.write(
                            inFile.toPath(),
                            sources[i].getBytes(java.nio.charset.Charset.forName("UTF-8")));
                        cliArgs.add("--js=" + inFile.getAbsolutePath());
                    }

                    new CommandLineRunner(cliArgs.toArray(new String[cliArgs.size()])).run();

                    String actual = "";
                    if (outFile.exists()) {
                        actual = new String(
                            java.nio.file.Files.readAllBytes(outFile.toPath()),
                            java.nio.charset.Charset.forName("UTF-8"));
                    }

                    normalizedOutputs.add(
                        actual.replace("\r\n", "\n")
                              .replace('\r', '\n')
                              .replaceAll("\\s+", ""));
                } finally {
                    java.io.File[] children = dir.listFiles();
                    if (children != null) {
                        for (int i = 0; i < children.length; i++) {
                            children[i].delete();
                        }
                    }
                    dir.delete();
                }
