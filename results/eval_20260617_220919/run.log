        return new Partial(
                new DateTimeFieldType[] {
                        DateTimeFieldType.hourOfDay(),
                        DateTimeFieldType.minuteOfHour()
                },
                new int[] { hourOfDay, minuteOfHour });
    }

    private static int toClockhourOfDay(int hourOfDay) {
        return hourOfDay == 0 ? 24 : hourOfDay;
    }

    private static int pickDifferentClockhour(int candidate, int forbiddenA, int forbiddenB) {
        int start = candidate;
        if (start < 1 || start > 24) {
            start = 1;
        }
        for (int i = 0; i < 24; i++) {
            int v = 1 + ((start - 1 + i) % 24);
            if (v != forbiddenA && v != forbiddenB) {
                return v;
            }
        }
        return forbiddenA == 1 ? 2 : 1;
    }

    private static boolean throwsIllegalArgumentException(Partial partial, int clockhourOfDay) {
        try {
            partial.with(DateTimeFieldType.clockhourOfDay(), clockhourOfDay);
            return false;
        } catch (IllegalArgumentException ex) {
            return true;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Partial test = createHourMinPartial(10, 20);
        boolean threw = false;
        try {
            test.with(DateTimeFieldType.clockhourOfDay(), 6);
        } catch (IllegalArgumentException ex) {
            threw = true;
        }
        if (!threw) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: expected IllegalArgumentException from test.with(DateTimeFieldType.clockhourOfDay(), 6)");
        }
        if (test.getValue(0) != 10 || test.getValue(1) != 20) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: check(test, 10, 20) failed");
        }

        int hourOfDay = data.consumeInt(0, 23);
        int minuteOfHour = data.consumeInt(0, 59);
        Partial fuzzPartial = createHourMinPartial(hourOfDay, minuteOfHour);

        int canonicalClockhour = toClockhourOfDay(hourOfDay);
        int conflictingClockhour1 =
                pickDifferentClockhour(data.consumeInt(1, 24), canonicalClockhour, -1);

        if (!throwsIllegalArgumentException(fuzzPartial, conflictingClockhour1)) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: inconsistent hourOfDay/clockhourOfDay was accepted");
        }

        try {
            fuzzPartial.with(DateTimeFieldType.clockhourOfDay(), canonicalClockhour);
        } catch (IllegalArgumentException ignored) {
        }

        try {
            fuzzPartial.with(DateTimeFieldType.clockhourOfDay(), data.consumeInt(1, 24));
        } catch (IllegalArgumentException ignored) {
        }

        int conflictingClockhour2 =
                pickDifferentClockhour(data.consumeInt(1, 24), canonicalClockhour, conflictingClockhour1);

        boolean leftRejected = throwsIllegalArgumentException(fuzzPartial, conflictingClockhour1);
        boolean rightRejected = throwsIllegalArgumentException(fuzzPartial, conflictingClockhour2);
        if (leftRejected != rightRejected) {
            throw new RuntimeException(
                    "metamorphic violation: conflicting clockhourOfDay values must be rejected consistently");
        }
    }
}
