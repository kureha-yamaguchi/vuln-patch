                    options);

            if (result != null && result.success) {
                String actual = compiler.toSource();
                if (actual == null) {
                    actual = "";
                }
                String normalizedActual = actual.replaceAll("\\s+", "");
                while (normalizedActual.endsWith(";")) {
                    normalizedActual = normalizedActual.substring(0, normalizedActual.length() - 1);
                }

