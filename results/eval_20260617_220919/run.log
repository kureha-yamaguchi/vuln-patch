                (seedExpected[0] + "\n" + seedExpected[1] + "\n" + seedExpected[2])
                    .replaceAll("\\s+", "");
            if (!seedExpectedNormalized.equals(normalizedOutputs.get(0))) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: seed dependency sorting in whitespace mode differed");
            }

            String fuzzExpectedNormalized =
                (fuzzExpected[0] + "\n" + fuzzExpected[1] + "\n" + fuzzExpected[2])
                    .replaceAll("\\s+", "");
            if (!fuzzExpectedNormalized.equals(normalizedOutputs.get(1))) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: dependency sorting in whitespace mode differed");
            }

            if (!normalizedOutputs.get(1).equals(normalizedOutputs.get(2))) {
                throw new RuntimeException(
                    "metamorphic violation: dependency-managed output changed with input permutation");
            }
        } catch (java.io.IOException e) {
            throw new RuntimeException(e);
        }
    }
