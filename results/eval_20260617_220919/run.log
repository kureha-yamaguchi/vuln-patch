package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final String fileName = "javascript/complex.js";
        final DiagnosticType fooType =
                DiagnosticType.error("TEST_FOO", "error description here");

        String seedCode = "\n\n\n\n\nif (foo";
        Compiler seedCompiler = new Compiler();
        java.util.List seedExterns =
                java.util.Collections.singletonList(SourceFile.fromCode("externs.js", ""));
        java.util.List seedInputs =
                java.util.Collections.singletonList(SourceFile.fromCode(fileName, seedCode));
        seedCompiler.init(seedExterns, seedInputs, new CompilerOptions());
        LightweightMessageFormatter seedFormatter = new LightweightMessageFormatter(seedCompiler);
        JSError seedError = JSError.make("javascript/complex.js", 6, 7, fooType);
        String seedActual = seedFormatter.formatError(seedError);
        String seedExpected = "javascript/complex.js:6: ERROR - error description here\n" +
                "if (foo\n" +
                "       ^\n";
        if (!seedExpected.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: lifted seed output");
        }

        String raw = data.consumeAsciiString(64);
        StringBuilder sanitized = new StringBuilder(raw.length());
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c == '\n' || c == '\r') {
                continue;
            }
            if ((c < 0x20 && c != '\t' && c != ' ') || c == 0x7f) {
                sanitized.append('a');
            } else {
                sanitized.append(c);
            }
        }
        if (sanitized.length() == 0) {
            sanitized.append('a');
        }
        String fuzzLine = sanitized.toString();

        String fuzzCode = "\n\n\n\n\n" + fuzzLine;
        Compiler compiler = new Compiler();
        java.util.List externs =
                java.util.Collections.singletonList(SourceFile.fromCode("externs.js", ""));
        java.util.List inputs =
                java.util.Collections.singletonList(SourceFile.fromCode(fileName, fuzzCode));
        compiler.init(externs, inputs, new CompilerOptions());
        LightweightMessageFormatter formatter = new LightweightMessageFormatter(compiler);

        JSError error = JSError.make(fileName, 6, fuzzLine.length(), fooType);
        String actual = formatter.formatError(error);

        StringBuilder caretLine = new StringBuilder(fuzzLine.length() + 2);
        for (int i = 0; i < fuzzLine.length(); i++) {
            char c = fuzzLine.charAt(i);
            if (Character.isWhitespace(c)) {
                caretLine.append(c);
            } else {
                caretLine.append(' ');
            }
        }
        caretLine.append("^\n");

        String expected = fileName + ":6: ERROR - error description here\n"
                + fuzzLine + "\n"
                + caretLine.toString();
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: end-of-line caret formatting differed");
        }

        JSError keyAError = JSError.make(
                fileName, 6, fuzzLine.length(),
                DiagnosticType.error("FUZZ_KEY_A", "error description here"));
        JSError keyBError = JSError.make(
                fileName, 6, fuzzLine.length(),
                DiagnosticType.error("FUZZ_KEY_B", "error description here"));
        String keyAOutput = formatter.formatError(keyAError);
        String keyBOutput = formatter.formatError(keyBError);
        if (!keyAOutput.equals(keyBOutput)) {
            throw new RuntimeException(
                    "metamorphic violation: diagnostic key should not affect formatted error text");
        }
    }
}
