package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static String twoDigits(int value) {
        return value < 10 ? "0" + value : Integer.toString(value);
    }

    private static void assertSemanticEquals(String actual, String expected, String what) {
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: " + what + " expected=" + expected + " actual=" + actual
            );
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone zone = DateTimeZone.forID("Europe/London");

        DateTime base = new DateTime(2011, 10, 30, 1, 15, zone);
        assertSemanticEquals(
            base.toString(),
            "2011-10-30T01:15:00.000+01:00",
            "new DateTime(2011, 10, 30, 1, 15, zone).toString()"
        );
        assertSemanticEquals(
            base.plusHours(1).toString(),
            "2011-10-30T01:15:00.000Z",
            "new DateTime(2011, 10, 30, 1, 15, zone).plusHours(1).toString()"
        );

        int minute = data.consumeInt(0, 59);
        DateTime fuzzBase = new DateTime(2011, 10, 30, 1, minute, zone);
        DateTime fuzzPlusOne = fuzzBase.plusHours(1);

        if (minute >= 1) {
            String mm = twoDigits(minute);
            assertSemanticEquals(
                fuzzBase.toString(),
                "2011-10-30T01:" + mm + ":00.000+01:00",
                "overlap construction toString() for minute=" + minute
            );
            assertSemanticEquals(
                fuzzPlusOne.toString(),
                "2011-10-30T01:" + mm + ":00.000Z",
                "overlap construction plusHours(1).toString() for minute=" + minute
            );
        }

        DateTime roundTrip = fuzzPlusOne.minusHours(1);
        if (!roundTrip.equals(fuzzBase)) {
            throw new RuntimeException(
                "metamorphic violation: base.plusHours(1).minusHours(1) must equal base"
            );
        }
    }
}
