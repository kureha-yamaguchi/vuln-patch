                }
                Number actualValue = item.getValue();
                if (actualValue == null || Double.compare(actualValue.doubleValue(), expectedValue) != 0) {
                    throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                            "semantic mismatch: createCopy value at index " + i);
                }
            }

            TimeSeries viaCopy = fuzzSeries.createCopy(0, fuzzSeries.getItemCount() - 1);
            TimeSeries viaClone = (TimeSeries) fuzzSeries.clone();
            if (!viaCopy.getKey().equals(viaClone.getKey())
                    || viaCopy.getItemCount() != viaClone.getItemCount()
                    || Double.compare(viaCopy.getMinY(), viaClone.getMinY()) != 0
                    || Double.compare(viaCopy.getMaxY(), viaClone.getMaxY()) != 0) {
                throw new RuntimeException(
                        "metamorphic violation: full-range createCopy and clone disagree");
            }
            for (int i = 0; i < viaCopy.getItemCount(); i++) {
                TimeSeriesDataItem copyItem = viaCopy.getDataItem(i);
                TimeSeriesDataItem cloneItem = viaClone.getDataItem(i);
                Number copyValue = copyItem.getValue();
                Number cloneValue = cloneItem.getValue();
                boolean valuesEqual = copyValue != null
                        && cloneValue != null
                        && Double.compare(copyValue.doubleValue(), cloneValue.doubleValue()) == 0;
                if (!copyItem.getPeriod().equals(cloneItem.getPeriod()) || !valuesEqual) {
                    throw new RuntimeException(
                            "metamorphic violation: full-range createCopy and clone disagree");
                }
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException(e);
        }
