                        DateTimeFieldType.minuteOfHour()
                },
                new int[] {10, 20});

        boolean threwIllegalArgumentException = false;
        try {
            test.with(DateTimeFieldType.clockhourOfDay(), 6);
        } catch (IllegalArgumentException expected) {
            threwIllegalArgumentException = true;
        }

        if (!threwIllegalArgumentException) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: Partial.with(DateTimeFieldType.clockhourOfDay(), 6) did not throw IllegalArgumentException");
        }

        if (test.get(DateTimeFieldType.hourOfDay()) != 10 || test.get(DateTimeFieldType.minuteOfHour()) != 20) {
            throw new FuzzerSecurityIssueLow("semantic mismatch: check(test, 10, 20) failed");
        }

        int fuzzHour = data.consumeInt(0, 23);
        int fuzzMinute = data.consumeInt(0, 59);
        int fuzzClockHour = data.consumeInt();

        Partial fuzzPartial = new Partial(
                new DateTimeFieldType[] {
                        DateTimeFieldType.hourOfDay(),
                        DateTimeFieldType.minuteOfHour()
                },
                new int[] {fuzzHour, fuzzMinute});

        try {
            fuzzPartial.with(DateTimeFieldType.clockhourOfDay(), fuzzClockHour);
        } catch (IllegalArgumentException ignored) {
        }

        int trustedMinute = data.consumeInt(0, 59);
        Partial clockMin = new Partial(
                new DateTimeFieldType[] {
                        DateTimeFieldType.clockhourOfDay(),
                        DateTimeFieldType.minuteOfHour()
                },
                new int[] {24, trustedMinute});

        if (clockMin.get(DateTimeFieldType.clockhourOfDay()) != 24) {
            throw new FuzzerSecurityIssueLow(
                    "semantic mismatch: constructed Partial did not round-trip clockhourOfDay value 24");
        }

        Partial once = clockMin.with(DateTimeFieldType.clockhourOfDay(), 24);
        Partial twice = once.with(DateTimeFieldType.clockhourOfDay(), 24);
        if (!once.equals(twice)) {
            throw new RuntimeException("metamorphic violation: with(clockhourOfDay, 24) is not idempotent");
        }
    }
}
