package org.apache.commons.math.complex;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Complex x = new Complex(3.0, 4.0);
        Complex z = x.add(Complex.NaN);
        if (!z.isNaN()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: x.add(Complex.NaN).isNaN() was false");
        }

        z = new Complex(1, Double.NaN);
        Complex w = x.add(z);
        if (!Double.isNaN(w.getReal())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: Double.isNaN(w.getReal()) was false");
        }
        if (!Double.isNaN(w.getImaginary())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: Double.isNaN(w.getImaginary()) was false");
        }

        double lhsReal = (double) data.consumeInt();
        double lhsImag = (double) data.consumeInt();
        Complex lhs = new Complex(lhsReal, lhsImag);

        double finitePart = (double) data.consumeInt();
        Complex rhsWithNaN;
        if (data.consumeBoolean()) {
            rhsWithNaN = new Complex(finitePart, Double.NaN);
        } else {
            rhsWithNaN = new Complex(Double.NaN, finitePart);
        }

        Complex nanFamilyResult = lhs.add(rhsWithNaN);
        if (!Double.isNaN(nanFamilyResult.getReal())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: add(Complex-with-NaN).getReal() was not NaN");
        }
        if (!Double.isNaN(nanFamilyResult.getImaginary())) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: add(Complex-with-NaN).getImaginary() was not NaN");
        }

        Complex arbitraryA = new Complex((double) data.consumeInt(), (double) data.consumeInt());
        Complex arbitraryB = new Complex((double) data.consumeInt(), (double) data.consumeInt());
        arbitraryA.add(arbitraryB);

        Complex metaLhs = new Complex((double) data.consumeInt(), (double) data.consumeInt());
        double metaFinite = (double) data.consumeInt();
        Complex meta1 = metaLhs.add(new Complex(metaFinite, Double.NaN));
        Complex meta2 = metaLhs.add(Complex.NaN);
        if (Double.doubleToLongBits(meta1.getReal()) != Double.doubleToLongBits(meta2.getReal())
                || Double.doubleToLongBits(meta1.getImaginary()) != Double.doubleToLongBits(meta2.getImaginary())) {
            throw new RuntimeException(
                "metamorphic violation: equivalent NaN operands to Complex.add disagree");
        }
    }
}
