package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;

public class FuzzHarness {
    private static Node parse(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        compiler.initOptions(options);
        Node root = compiler.parseTestCode(js);
        if (root == null || compiler.getErrorCount() > 0) {
            return null;
        }
        return root;
    }

    private static String print(Node root) {
        return new CodePrinter.Builder(root).build();
    }

    private static String parseAndPrint(String js) {
        Node root = parse(js);
        if (root == null) {
            return null;
        }
        return print(root);
    }

    private static String makeIdentifier(String raw) {
        StringBuilder sb = new StringBuilder();
        sb.append('a');
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z')
                    || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9')
                    || c == '_'
                    || c == '$') {
                sb.append(c);
            } else {
                sb.append('a');
            }
        }
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedInput = "x- -0";
        String seedExpected = "x- -0.0";
        String seedActual = parseAndPrint(seedInput);
        if (!seedExpected.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: CodePrinter(\"x- -0\") expected \"" + seedExpected
                            + "\" but got \"" + String.valueOf(seedActual) + "\"");
        }

        String id = makeIdentifier(data.consumeAsciiString(16));
        String zeroLiteral = data.consumeBoolean() ? "0" : "0.0";
        int variant = data.consumeInt(0, 3);
        String source;
        switch (variant) {
            case 0:
                source = id + "- -" + zeroLiteral;
                break;
            case 1:
                source = id + " - -" + zeroLiteral;
                break;
            case 2:
                source = id + "-  -" + zeroLiteral;
                break;
            default:
                source = id + " -  -" + zeroLiteral;
                break;
        }

        String expected = id + "- -0.0";
        String actual = parseAndPrint(source);
        if (!expected.equals(actual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: CodePrinter(\"" + source + "\") expected \"" + expected
                            + "\" but got \"" + String.valueOf(actual) + "\"");
        }

        Node reparsed = parse(actual);
        if (reparsed == null) {
            throw new RuntimeException("metamorphic violation: parse(print(x)) failed");
        }
        String roundTrip = print(reparsed);
        if (!actual.equals(roundTrip)) {
            throw new RuntimeException("metamorphic violation: print(parse(print(x))) != print(x)");
        }
    }
}
