package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.rhino.Node;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String seedInput = "x- -0";
        String seedExpected = "x- -0.0";

        Compiler seedCompiler = new Compiler();
        CompilerOptions seedOptions = new CompilerOptions();
        seedCompiler.initOptions(seedOptions);
        Node seedRoot = seedCompiler.parseTestCode(seedInput);
        String seedActual = seedRoot == null ? null : new CodePrinter.Builder(seedRoot).build();
        if (!seedExpected.equals(seedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: CodePrinter on " + seedInput + " produced " + String.valueOf(seedActual)
                    + " instead of " + seedExpected);
        }

        int left = data.consumeInt(0, 99);
        boolean spaceBeforeBinaryMinus = data.consumeBoolean();
        boolean useExplicitDecimalNegativeZero = data.consumeBoolean();

        String generalizedInput =
            Integer.toString(left)
                + (spaceBeforeBinaryMinus ? " " : "")
                + "- "
                + (useExplicitDecimalNegativeZero ? "-0.0" : "-0");
        String generalizedExpected = Integer.toString(left) + "- -0.0";

        Compiler generalizedCompiler = new Compiler();
        CompilerOptions generalizedOptions = new CompilerOptions();
        generalizedCompiler.initOptions(generalizedOptions);
        Node generalizedRoot = generalizedCompiler.parseTestCode(generalizedInput);
        String generalizedActual =
            generalizedRoot == null ? null : new CodePrinter.Builder(generalizedRoot).build();
        if (!generalizedExpected.equals(generalizedActual)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: CodePrinter on " + generalizedInput + " produced "
                    + String.valueOf(generalizedActual) + " instead of " + generalizedExpected);
        }

        String metamorphicInput = Integer.toString(left) + "- -0";
        Compiler firstCompiler = new Compiler();
        CompilerOptions firstOptions = new CompilerOptions();
        firstCompiler.initOptions(firstOptions);
        Node firstRoot = firstCompiler.parseTestCode(metamorphicInput);
        String firstPrinted = firstRoot == null ? null : new CodePrinter.Builder(firstRoot).build();

        if (firstPrinted != null) {
            Compiler secondCompiler = new Compiler();
            CompilerOptions secondOptions = new CompilerOptions();
            secondCompiler.initOptions(secondOptions);
            Node secondRoot = secondCompiler.parseTestCode(firstPrinted);
            String secondPrinted =
                secondRoot == null ? null : new CodePrinter.Builder(secondRoot).build();

            if (secondPrinted == null || !firstPrinted.equals(secondPrinted)) {
                throw new RuntimeException(
                    "metamorphic violation: print(parse(print(src))) == print(src)");
            }
        }

        int extraLeft = data.consumeInt();
        boolean extraSpaceBeforeBinaryMinus = data.consumeBoolean();
        boolean extraUseExplicitDecimalNegativeZero = data.consumeBoolean();
        String extraInput =
            Integer.toString(extraLeft)
                + (extraSpaceBeforeBinaryMinus ? " " : "")
                + "- "
                + (extraUseExplicitDecimalNegativeZero ? "-0.0" : "-0");
        Compiler extraCompiler = new Compiler();
        CompilerOptions extraOptions = new CompilerOptions();
        extraCompiler.initOptions(extraOptions);
        Node extraRoot = extraCompiler.parseTestCode(extraInput);
        if (extraRoot != null) {
            new CodePrinter.Builder(extraRoot).build();
        }
    }
}
