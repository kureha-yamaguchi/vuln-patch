package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeZone zone = DateTimeZone.forID("Europe/London");

        DateTime base = new DateTime(2011, 10, 30, 1, 15, zone);
        String baseString = base.toString();
        if (!"2011-10-30T01:15:00.000+01:00".equals(baseString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.toString() expected 2011-10-30T01:15:00.000+01:00 but got " + baseString);
        }

        String plusOneString = base.plusHours(1).toString();
        if (!"2011-10-30T01:15:00.000Z".equals(plusOneString)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: base.plusHours(1).toString() expected 2011-10-30T01:15:00.000Z but got " + plusOneString);
        }

        int minute = data.consumeInt(0, 59);
        LocalDateTime local = new LocalDateTime(2011, 10, 30, 1, minute);
        DateTime overlap = new DateTime(2011, 10, 30, 1, minute, zone);

        String mm = minute < 10 ? "0" + minute : Integer.toString(minute);

        String expectedOverlap = "2011-10-30T01:" + mm + ":00.000+01:00";
        String actualOverlap = overlap.toString();
        if (!expectedOverlap.equals(actualOverlap)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: overlap.toString() expected " + expectedOverlap + " but got " + actualOverlap);
        }

        String expectedOverlapPlus = "2011-10-30T01:" + mm + ":00.000Z";
        String actualOverlapPlus = overlap.plusHours(1).toString();
        if (!expectedOverlapPlus.equals(actualOverlapPlus)) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: overlap.plusHours(1).toString() expected " + expectedOverlapPlus + " but got " + actualOverlapPlus);
        }

        long localMillis = local.toDateTime(DateTimeZone.UTC).getMillis();
        int offsetFromLocal = zone.getOffsetFromLocal(localMillis);
        if (offsetFromLocal != DateTimeConstants.MILLIS_PER_HOUR) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                "semantic mismatch: getOffsetFromLocal expected 3600000 but got " + offsetFromLocal);
        }

        int arbitraryLocal = data.consumeInt();
        zone.getOffsetFromLocal((long) arbitraryLocal);

        DateTime reparsed = DateTime.parse(overlap.toString());
        if (reparsed.getMillis() != overlap.getMillis()) {
            throw new RuntimeException("metamorphic violation: parse(toString(dt)) changed instant");
        }
    }
}
