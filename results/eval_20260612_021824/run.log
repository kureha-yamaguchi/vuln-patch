package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.lang.reflect.Field;
import java.util.Locale;

public class FuzzHarness {
    private static void resetLocaleUtilsCaches() {
        try {
            Class<?> cls = LocaleUtils.class;
            Field listField = cls.getDeclaredField("cAvailableLocaleList");
            Field setField = cls.getDeclaredField("cAvailableLocaleSet");
            listField.setAccessible(true);
            setField.setAccessible(true);
            listField.set(null, null);
            setField.set(null, null);
        } catch (Throwable ignored) {
            // Best-effort reset; if this fails, we still proceed.
        }
    }

    private static Locale buildRandomLocale(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 3);
        switch (mode) {
            case 0:
                return null; // Exercise null input
            case 1: {
                String lang = data.consumeAsciiString(8);
                return new Locale(lang);
            }
            case 2: {
                String lang = data.consumeAsciiString(8);
                String country = data.consumeAsciiString(8);
                return new Locale(lang, country);
            }
            default: {
                String lang = data.consumeAsciiString(8);
                String country = data.consumeAsciiString(8);
                String variant = data.consumeAsciiString(16);
                return new Locale(lang, country, variant);
            }
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Ensure a cold start so the buggy version reproduces the NPE reliably.
        resetLocaleUtilsCaches();

