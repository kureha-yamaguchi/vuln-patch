import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor inputs from the failing test to trigger the original bug
        StringEscapeUtils.escapeCsv("\uD83D\uDE30");
        StringEscapeUtils.escapeCsv("\uD800\uDC00");
        StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        // Explore: single supplementary character
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        String singleSupplementary = new String(Character.toChars(cp));
        StringEscapeUtils.escapeCsv(singleSupplementary);

        // Explore: supplementary character within ASCII context
        String pre = data.consumeAsciiString(32);
        String post = data.consumeAsciiString(32);
        String mixed = pre + singleSupplementary + post;
        StringEscapeUtils.escapeCsv(mixed);

        // Force CSV quoting in some cases
        if (data.consumeBoolean()) {
            String withComma = mixed + ",";
            StringEscapeUtils.escapeCsv(withComma);
        }
        if (data.consumeBoolean()) {
            String withQuote = mixed + "\"";
            StringEscapeUtils.escapeCsv(withQuote);
        }
        if (data.consumeBoolean()) {
            String withNewline = mixed + "\n";
            StringEscapeUtils.escapeCsv(withNewline);
        }

        // Additional fuzzed cases with varied structure
        int loops = data.consumeInt(0, 5);
        for (int i = 0; i < loops; i++) {
            int segments = data.consumeInt(1, 8);
            StringBuilder sb = new StringBuilder();
            for (int j = 0; j < segments; j++) {
                int choice = data.consumeInt(0, 5);
                switch (choice) {
                    case 0:
                        sb.append(data.consumeAsciiString(32));
                        break;
                    case 1:
                        // Random supplementary code point (valid surrogate pair)
                        int cp2 = data.consumeInt(0x10000, 0x10FFFF);
                        sb.append(Character.toChars(cp2));
                        break;
                    case 2:
                        // Explicit surrogate pair
                        char high = (char) data.consumeInt(0xD800, 0xDBFF);
                        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
                        sb.append(high).append(low);
                        break;
                    case 3:
                        // Lone surrogate (invalid UTF-16 sequence)
                        if (data.consumeBoolean()) {
                            sb.append((char) data.consumeInt(0xD800, 0xDBFF));
                        } else {
                            sb.append((char) data.consumeInt(0xDC00, 0xDFFF));
                        }
                        break;
                    case 4:
                        // CSV special characters to trigger quoting
                        char[] specials = new char[] {',', '"', '\n', '\r'};
                        sb.append(specials[data.consumeInt(0, specials.length - 1)]);
                        break;
                    default:
                        // General mixed string
                        sb.append(data.consumeString(16));
                        break;
                }
                if (sb.length() > 1024) {
                    break;
                }
            }
            String s = sb.toString();
            StringEscapeUtils.escapeCsv(s);
        }

