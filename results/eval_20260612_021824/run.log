        }
        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            out.append(isIdentPart(c) ? c : '_');
        }
        return out.toString();
    }

    private static boolean isIdentStart(char c) {
        return (c == '_' || c == '$' || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'));
    }

    private static boolean isIdentPart(char c) {
        return isIdentStart(c) || (c >= '0' && c <= '9');
    }

