    private static String makeDigits(FuzzedDataProvider data, int min, int max) {
        int lenMax = Math.max(min, max);
        int len = min + data.consumeInt(0, lenMax - min);
        if (len <= 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder(len);
        // Ensure first digit is not leading '+' or '-'.
        for (int i = 0; i < len; i++) {
            int d = data.consumeInt(0, 9);
            char c = (char) ('0' + d);
            sb.append(c);
        }
        return sb.toString();
    }

    private static String makeHexDigits(FuzzedDataProvider data, int min, int max) {
        int lenMax = Math.max(min, max);
        int len = min + data.consumeInt(0, lenMax - min);
        if (len <= 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int v = data.consumeInt(0, 15);
            if (v < 10) {
                sb.append((char) ('0' + v));
            } else {
                boolean upper = data.consumeBoolean();
                char base = upper ? 'A' : 'a';
                sb.append((char) (base + (v - 10)));
            }
        }
        return sb.toString();
    }

