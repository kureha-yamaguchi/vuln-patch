            if (makeBracket) {
                // Create an interval around k * PI to bracket a root of sin(x).
                int k = data.remainingBytes() > 0 ? data.consumeInt(-1000, 1000) : 0;
                double center = k * Math.PI;

                // Small offsets on either side of the root to ensure opposite signs.
                double lBase = data.remainingBytes() > 0 ? (double) data.consumeInt(1, 1_000_000) : 12345.0;
                double rBase = data.remainingBytes() > 0 ? (double) data.consumeInt(1, 1_000_000) : 67890.0;
                double lScale = data.remainingBytes() > 0 ? (double) data.consumeInt(1, 1_000_000) : 777.0;
                double rScale = data.remainingBytes() > 0 ? (double) data.consumeInt(1, 1_000_000) : 555.0;

                double leftOffset = -lBase / (lScale * 100.0 + 1.0);
                double rightOffset = rBase / (rScale * 100.0 + 1.0);

                min = center + leftOffset;
                max = center + rightOffset;

                if (min >= max) {
                    double a = center - Math.abs(leftOffset);
                    double b = center + Math.abs(rightOffset);
                    min = Math.min(a, b);
                    max = Math.max(a, b);
                    if (min == max) {
