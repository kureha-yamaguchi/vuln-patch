package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.image.BufferedImage;
import java.awt.Graphics2D;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        int imgW = data.consumeInt(1, 1024);
        int imgH = data.consumeInt(1, 768);
        BufferedImage image = new BufferedImage(imgW, imgH, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2 = image.createGraphics();

        // ANCHOR: replicate key steps from BorderArrangementTests
        RectangleConstraint constraint = new RectangleConstraint(
            10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
            0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());

        // center only
        container.add(new EmptyBlock(5.0, 6.0));
        container.arrange(g2, constraint);

        container.clear();
        // center only, larger
        container.add(new EmptyBlock(15.0, 16.0));
        container.arrange(g2, constraint);

        container.clear();
        // right only (12.3 wide)
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
        container.arrange(g2, constraint);

        container.clear();
        // Trigger the original root cause: left wider than available width with a right block present
        container.add(new EmptyBlock(12.3, 10.0), RectangleEdge.LEFT);
        container.add(new EmptyBlock(1.0, 10.0), RectangleEdge.RIGHT);
        container.arrange(g2, constraint);

        // EXPLORE: fuzz a variety of valid constraints and block configurations
        int iterations = 1 + (data.remainingBytes() % 5);
        for (int i = 0; i < iterations; i++) {
            double W = data.consumeInt(0, 5000) / 10.0; // 0..500.0
            double H = data.consumeInt(0, 5000) / 10.0; // 0..500.0
            boolean heightFixed = data.consumeBoolean();

            RectangleConstraint rc = new RectangleConstraint(
                W, new Range(W, W), LengthConstraintType.FIXED,
                H, heightFixed ? new Range(H, H) : new Range(0.0, 0.0),
                heightFixed ? LengthConstraintType.FIXED : LengthConstraintType.NONE
            );

            BlockContainer c = new BlockContainer(new BorderArrangement());

            boolean addTop = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();
            boolean addLeft = data.consumeBoolean();
            boolean addRight = data.consumeBoolean();
            boolean addCenter = data.consumeBoolean();

            // Occasionally force both left and right to hit the patched region and original fault condition.
            if (data.consumeBoolean()) {
                addLeft = true;
                addRight = true;
            }

            double tW = data.consumeInt(0, 4000) / 10.0;
            double bW = data.consumeInt(0, 4000) / 10.0;
            double lW = data.consumeInt(0, 8000) / 10.0;
            double rW = data.consumeInt(0, 8000) / 10.0;
            double cW = data.consumeInt(0, 8000) / 10.0;

            // Occasionally ensure left width exceeds the fixed container width when right is present.
            if (data.consumeBoolean() && addRight) {
                lW = W + (data.consumeInt(1, 3000) / 10.0);
                addLeft = true;
            }

            double tH = data.consumeInt(0, 4000) / 10.0;
            double bH = data.consumeInt(0, 4000) / 10.0;
            double lH = data.consumeInt(0, 4000) / 10.0;
            double rH = data.consumeInt(0, 4000) / 10.0;
            double cH = data.consumeInt(0, 4000) / 10.0;

            if (addTop) {
                c.add(new EmptyBlock(tW, tH), RectangleEdge.TOP);
            }
            if (addBottom) {
                c.add(new EmptyBlock(bW, bH), RectangleEdge.BOTTOM);
            }
            if (addLeft) {
                c.add(new EmptyBlock(lW, lH), RectangleEdge.LEFT);
            }
            if (addRight) {
                c.add(new EmptyBlock(rW, rH), RectangleEdge.RIGHT);
            }
            if (addCenter) {
                c.add(new EmptyBlock(cW, cH));
            }

            // Try both FF and FN styles to exercise different paths
            if (!heightFixed && data.consumeBoolean()) {
                RectangleConstraint rcFF = new RectangleConstraint(
                    W, new Range(W, W), LengthConstraintType.FIXED,
                    H, new Range(H, H), LengthConstraintType.FIXED
                );
                c.arrange(g2, rcFF);
            } else {
                c.arrange(g2, rc);
            }
        }

        g2.dispose();
    }
}
