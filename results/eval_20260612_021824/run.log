            String country = data.consumeAsciiString(16);
            String variant = data.consumeAsciiString(32);

            // Randomly normalize cases to exercise different variants and code paths.
            if (data.consumeBoolean()) {
                lang = lang == null ? "" : lang.toLowerCase(java.util.Locale.ENGLISH);
            }
            if (data.consumeBoolean()) {
                country = country == null ? "" : country.toUpperCase(java.util.Locale.ENGLISH);
            }

            // Randomly choose constructor arity.
            int mode = data.consumeInt(0, 2);
            java.util.Locale fuzzLocale;
            if (mode == 0) {
                fuzzLocale = new java.util.Locale(lang == null ? "" : lang);
            } else if (mode == 1) {
                fuzzLocale = new java.util.Locale(lang == null ? "" : lang, country == null ? "" : country);
            } else {
                fuzzLocale = new java.util.Locale(lang == null ? "" : lang, country == null ? "" : country, variant == null ? "" : variant);
            }

            // Call the real API under test.
            LocaleUtils.isAvailableLocale(fuzzLocale);

            // Occasionally also test null explicitly.
            if (data.consumeBoolean()) {
                LocaleUtils.isAvailableLocale(null);
            }
        }
    }
