        java.util.Locale LOCALE_EN_US_ZZZZ = new java.util.Locale("en", "US", "ZZZZ");
        java.util.Locale LOCALE_FR = new java.util.Locale("fr", "");
        java.util.Locale LOCALE_FR_CA = new java.util.Locale("fr", "CA");
        java.util.Locale LOCALE_QQ = new java.util.Locale("qq", "");
        java.util.Locale LOCALE_QQ_ZZ = new java.util.Locale("qq", "ZZ");

        // This first call triggers the NPE on the buggy version (before any cache init).
        // On the fixed version, it should return a boolean cleanly.
        if (LocaleUtils.isAvailableLocale(LOCALE_EN)) {
            // no-op
        }
        // More exact test inputs
        LocaleUtils.isAvailableLocale(LOCALE_EN_US);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US_ZZZZ);
        LocaleUtils.isAvailableLocale(LOCALE_FR);
        LocaleUtils.isAvailableLocale(LOCALE_FR_CA);
        LocaleUtils.isAvailableLocale(LOCALE_QQ);
        LocaleUtils.isAvailableLocale(LOCALE_QQ_ZZ);

        // EXPLORE: Generate varied Locales and query isAvailableLocale.
        // Property: calling isAvailableLocale should never rely on prior initialization
        // and must not throw; it should handle arbitrary Locale values (including null).
        int count = 1;
        try {
            count = Math.max(1, data.consumeInt(0, 64));
        } catch (Throwable t) {
            // If FuzzedDataProvider misbehaves, default to a small count.
            count = 8;
