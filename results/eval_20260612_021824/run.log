    // Compile JS code through the real Compiler API so passes (including NameAnalyzer) run.
    private static void compileString(String code) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        options.smartNameRemoval = true;
        // Default coding convention recognizes goog.inherits in most Closure versions.
        // Using an empty externs file is sufficient for this scenario.
        JSSourceFile externs = JSSourceFile.fromCode("externs.js", "");
        JSSourceFile input = JSSourceFile.fromCode("input.js", code);
        compiler.compile(externs, input, options);
    }

    private static String sanitizeIdent(String raw, String fallback) {
        if (raw == null) {
            return fallback;
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '_' || c == '$') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append(fallback);
        }
        char first = sb.charAt(0);
        if ((first >= '0' && first <= '9')) {
            sb.insert(0, 'A');
        }
        return sb.toString();
    }
