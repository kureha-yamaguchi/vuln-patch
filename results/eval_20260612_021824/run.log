import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing-test inputs
        NumberUtils.createNumber("-1l");
        NumberUtils.createNumber("01l");
        NumberUtils.createNumber("1l");

        // Targeted shape: single digit + 'l'/'L' (no sign, no exponent, no dot)
        char singleDigit = (char) ('0' + data.consumeInt(0, 9));
        char suffix = data.consumeBoolean() ? 'l' : 'L';
        String singleLiteral = new String(new char[] { singleDigit, suffix });
        NumberUtils.createNumber(singleLiteral);

        // EXPLORE: generate various 'l'/'L'-suffixed numbers with and without exponent
        int iterations = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < iterations && data.remainingBytes() > 0; i++) {
            boolean withExp = data.consumeBoolean();
            boolean upperSuffix = data.consumeBoolean();
            boolean negative = data.consumeBoolean();
            int len = data.consumeInt(1, 64);

            StringBuilder sb = new StringBuilder();
            if (negative) {
                sb.append('-');
            }
            for (int j = 0; j < len; j++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
            if (withExp) {
                sb.append(data.consumeBoolean() ? 'e' : 'E');
                if (data.consumeBoolean()) {
                    sb.append('-');
                }
                int elen = data.consumeInt(1, 10);
                for (int j = 0; j < elen; j++) {
                    sb.append((char) ('0' + data.consumeInt(0, 9)));
                }
            }
            sb.append(upperSuffix ? 'L' : 'l');

            String candidate = sb.toString();
            boolean hasExp = withExp;
            boolean hasDot = candidate.indexOf('.') >= 0;

            try {
                NumberUtils.createNumber(candidate);
            } catch (NumberFormatException nfe) {
                // Inputs with exponent or decimal are invalid for 'l'/'L' suffix: swallow as expected rejections.
                if (hasExp || hasDot) {
                    // expected post-fix behavior: invalid long literal rejected
                } else {
                    // Valid long-like literal without exponent/decimal should not be rejected: surface the bug.
                    throw nfe;
                }
            }
        }
    }
}
