            // Otherwise, treat as correct rejection and return.
        } catch (RuntimeException re) {
            // Swallow the known "Not implemented." branches in BorderArrangement.
            String msg = re.getMessage();
            if (msg != null && msg.contains("Not implemented")) {
                return;
            }
            throw re;
        }
    }
