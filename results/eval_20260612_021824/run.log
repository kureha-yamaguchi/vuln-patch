        switch (p) {
            case -6: return 1e-6;
            case -5: return 1e-5;
            case -4: return 1e-4;
            case -3: return 1e-3;
            case -2: return 1e-2;
            case -1: return 1e-1;
            case 0: return 1.0;
            case 1: return 1e1;
            case 2: return 1e2;
            case 3: return 1e3;
            case 4: return 1e4;
            case 5: return 1e5;
            case 6: return 1e6;
            default: return Math.pow(10.0, p);
        }
    }

