    private static String sanitizeIdent(String s, String fallback) {
        if (s == null) return fallback;
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'A' && c <= 'Z') ||
                (c >= 'a' && c <= 'z') ||
                (c >= '0' && c <= '9') ||
                c == '_' || c == '$') {
                out.append(c);
            } else {
                out.append('_');
            }
        }
        if (out.length() == 0) {
            out.append(fallback);
        }
        char first = out.charAt(0);
        if ((first >= '0' && first <= '9')) {
            out.insert(0, '_');
        }
        return out.toString();
    }
