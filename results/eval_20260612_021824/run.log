        int reps = data.consumeInt(0, 4);
        if (reps > 0) {
            char[] pair = Character.toChars(data.consumeInt(0x10000, 0x10FFFF));
            StringBuilder repeated = new StringBuilder(reps * 2);
            for (int r = 0; r < reps; r++) {
                repeated.append(pair);
            }
            StringEscapeUtils.escapeCsv(repeated.toString());
        }
    }
}
