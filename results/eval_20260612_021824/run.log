        MutableDateTime nyStart = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York"));
        anchorFormatter.parseInto(nyStart, "2 29", 0);
        MutableDateTime tokyoEnd = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo"));
        anchorFormatter.parseInto(tokyoEnd, "2 29", 0);

        // EXPLORE: fuzz around the root cause (month-day without explicit year; Feb 29; zones and instants near year boundaries)
        String[] zoneIds = new String[] {
            "UTC",
            "Europe/London",
            "America/New_York",
            "Asia/Tokyo",
            "Australia/Sydney",
            "Europe/Moscow",
            "Asia/Kathmandu",
            "America/St_Johns",
            "Pacific/Apia",
            "Pacific/Kiritimati"
        };
        String[] patterns = new String[] {
            "M d",
            "MM dd",
            "M/d",
            "M-d",
            "MMM d",
            "MMMM d"
        };

        int iterations = data.consumeInt(1, 12);
        for (int i = 0; i < iterations; i++) {
            String pattern = patterns[data.consumeInt(0, patterns.length - 1)];
            DateTimeFormatter fmt = DateTimeFormat.forPattern(pattern).withLocale(Locale.UK);
            // Optionally force a different zone on the formatter to exercise selectChronology/offset interactions.
            if (data.consumeBoolean()) {
                DateTimeZone forcedFmtZone = DateTimeZone.forID(zoneIds[data.consumeInt(0, zoneIds.length - 1)]);
                fmt = fmt.withZone(forcedFmtZone);
            }

            // Choose a leap year to make "Feb 29" valid when the default year is computed correctly.
            int year = data.consumeInt(1900, 2200);
            int guard = 0;
            while (!(((year % 4) == 0 && (year % 100) != 0) || (year % 400) == 0)) {
                year++;
                guard++;
                if (guard > 10) break; // avoid runaway; accept non-leap if too many steps
            }

            // Pick a base zone and an instant near year boundaries.
            DateTimeZone baseZone = DateTimeZone.forID(zoneIds[data.consumeInt(0, zoneIds.length - 1)]);
            boolean startOfYear = data.consumeBoolean();
            MutableDateTime baseInstant;
            if (startOfYear) {
                baseInstant = new MutableDateTime(year, 1, 1, 0, 0, 0, 0, baseZone);
            } else {
                baseInstant = new MutableDateTime(year, 12, 31, 23, 59, 59, 999, baseZone);
            }

            // Build an input matching the pattern that represents February 29 in Locale.UK.
            String inputCore;
            switch (pattern) {
                case "MM dd":
                    inputCore = "02 29";
                    break;
                case "M/d":
                    inputCore = (data.consumeBoolean() ? "02" : "2") + "/29";
                    break;
                case "M-d":
                    inputCore = (data.consumeBoolean() ? "02" : "2") + "-29";
                    break;
                case "MMM d":
                    inputCore = "Feb 29";
                    break;
                case "MMMM d":
                    inputCore = "February 29";
                    break;
                case "M d":
                default:
                    inputCore = (data.consumeBoolean() ? "02" : "2") + " 29";
                    break;
            }

            // Optionally add a prefix/suffix and start parsing at the correct position.
            String prefix = data.consumeBoolean() ? data.consumeAsciiString(5) : "";
            String suffix = data.consumeBoolean() ? data.consumeAsciiString(5) : "";
            String fullInput = prefix + inputCore + suffix;
            int position = prefix.length();

            try {
                int newPos = fmt.parseInto(baseInstant, fullInput, position);
                // Touch result to keep JIT/optimizer from eliding everything.
                if (newPos >= position) {
                    long millis = baseInstant.getMillis();
                    if (millis == 0 && data.consumeBoolean()) {
                        // no-op branch to consume a bit more input/state
                        baseInstant.setMillis(1L);
                        baseInstant.setMillis(0L);
