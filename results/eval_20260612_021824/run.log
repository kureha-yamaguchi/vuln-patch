    private static String ensureLengthExact(String s, int len, char pad) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuilder sb = new StringBuilder(len);
        sb.append(s);
        while (sb.length() < len) {
            sb.append(pad);
        }
        return sb.toString();
    }
