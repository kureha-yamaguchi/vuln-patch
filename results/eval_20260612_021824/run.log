        MutableDateTime nyStart = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York"));
        fAnchor.parseInto(nyStart, "2 29", 0);
        MutableDateTime tokyoEnd = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo"));
        fAnchor.parseInto(tokyoEnd, "2 29", 0);

        // EXPLORE: vary time zones, base instants near year boundaries, and parse positions around the "2 29" token
        try {
            int loops = 1 + Math.abs(data.consumeInt()) % 5;
            for (int i = 0; i < loops; i++) {
                // Always use the same pattern to drive the real entry point the same way as the tests.
                DateTimeFormatter fmt = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

                // Randomly set a zone directly on the formatter (sometimes null to use chronology's zone).
                if (data.consumeBoolean()) {
                    String zIdFmt = ZONES[data.consumeInt(0, ZONES.length - 1)];
                    try {
                        fmt = fmt.withZone(DateTimeZone.forID(zIdFmt));
                    } catch (IllegalArgumentException ignore) {
                        // If zone is invalid, skip setting it.
                    }
                }

                // Choose a leap year to keep "2 29" valid when defaults are correct.
                int[] leapYears = new int[] { 1996, 2000, 2004, 2008, 2012, 2016, 2020, 2024, 2028 };
                int year = leapYears[data.consumeInt(0, leapYears.length - 1)];

                // Pick a chronology zone for the base instant.
                String zIdBase = ZONES[data.consumeInt(0, ZONES.length - 1)];
                DateTimeZone baseZone;
                try {
                    baseZone = DateTimeZone.forID(zIdBase);
                } catch (IllegalArgumentException ex) {
                    baseZone = DateTimeZone.UTC;
                }

                // Place the base instant right at the start or end of year to maximize chance of offset-induced year shift.
                MutableDateTime base;
                if (data.consumeBoolean()) {
                    base = new MutableDateTime(year, 1, 1, 0, 0, 0, 0, baseZone);
                } else {
                    base = new MutableDateTime(year, 12, 31, 23, 59, 59, 999, baseZone);
                }

                // Build a string with a random prefix/suffix; ensure "2 29" is at 'position'.
                String prefix = data.consumeAsciiString(20);
                String suffix = data.consumeAsciiString(20);
                String text = prefix + "2 29" + suffix;
                int position = prefix.length();

                try {
                    fmt.parseInto(base, text, position);
                } catch (org.joda.time.IllegalFieldValueException e) {
