        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || (c >= '0' && c <= '9')
                || c == '_') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append(fallback);
        }
        // First char must be non-digit
        char first = sb.charAt(0);
        if (!(first == '_' || (first >= 'A' && first <= 'Z') || (first >= 'a' && first <= 'z'))) {
            sb.insert(0, '_');
        }
        return sb.toString();
    }

    private static void runCompilation(String code) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        options.setCodingConvention(new ClosureCodingConvention());
        options.smartNameRemoval = true;

        List<SourceFile> externs = new ArrayList<SourceFile>();
        externs.add(SourceFile.fromCode("externs.js",
            "/** @const */ var goog = {};\n" +
            "goog.inherits = function(x, y) {};\n" +
            "var window; var arguments;"));

        List<SourceFile> inputs = new ArrayList<SourceFile>();
        inputs.add(SourceFile.fromCode("input.js", code));

