import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing input from the test
        try {
            org.apache.commons.math.distribution.NormalDistribution std = new org.apache.commons.math.distribution.NormalDistributionImpl(0.0, 1.0);
            std.inverseCumulativeProbability(0.9772498680518209);
        } catch (org.apache.commons.math.MathException e) {
            // Propagate as RuntimeException to signal the root-cause bug on buggy versions.
            throw new RuntimeException(e);
        } catch (IllegalArgumentException iae) {
            // Parameter validation (shouldn't happen here).
            return;
        }

        // EXPLORE: generate many inputs with the property that the bracket hits a root at an endpoint.
        // For Normal(mean, sd), AbstractContinuousDistribution picks initial = mean +/- sd depending on p.
        // We set p = CDF(initial +/- 1), so the first expansion in bracket evaluates exactly at the root on an endpoint.
        int iterations = 1 + (data.remainingBytes() & 3);
        for (int i = 0; i < iterations; i++) {
            // Generate mean in [-20.0, 20.0] and sd in (0.01, 20.0]
            double mean;
            double sd;
            try {
                mean = data.consumeInt(-200, 200) / 10.0;
                int sdScaled = data.consumeInt(1, 2000);
                sd = Math.max(0.01, sdScaled / 100.0);
            } catch (Exception e) {
                break; // Not enough data
            }

            boolean highSide = data.consumeBoolean();
            org.apache.commons.math.distribution.NormalDistribution dist;
            try {
                dist = new org.apache.commons.math.distribution.NormalDistributionImpl(mean, sd);
            } catch (IllegalArgumentException iae) {
                continue; // Invalid parameters => skip
            }

            double x = highSide ? (mean + sd + 1.0) : (mean - sd - 1.0);
            double p;
            try {
                p = dist.cumulativeProbability(x);
            } catch (org.apache.commons.math.MathException e) {
                continue; // Numerical issue computing CDF => skip
            }

            // Ensure valid probability
            if (!(p > 0.0 && p < 1.0)) {
                continue;
            }

            try {
                dist.inverseCumulativeProbability(p);
            } catch (org.apache.commons.math.MathException e) {
                // This is the buggy behavior (rejecting an endpoint root); let it crash.
                throw new RuntimeException(e);
            } catch (IllegalArgumentException iae) {
                // Clean rejection of invalid input (shouldn't happen here since p came from CDF).
            }
        }
    }
}
