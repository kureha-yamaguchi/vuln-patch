        java.util.Locale LOCALE_EN_US_ZZZZ = new java.util.Locale("en", "US", "ZZZZ");
        java.util.Locale LOCALE_FR = new java.util.Locale("fr", "");
        java.util.Locale LOCALE_FR_CA = new java.util.Locale("fr", "CA");
        java.util.Locale LOCALE_QQ = new java.util.Locale("qq", "");
        java.util.Locale LOCALE_QQ_ZZ = new java.util.Locale("qq", "ZZ");

        // This first call reproduces the buggy behavior on Lang_57_buggy (NPE due to uninitialized cache).
        // Do not catch here: let genuine internal failures propagate.
        LocaleUtils.isAvailableLocale(LOCALE_EN);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US_ZZZZ);
        LocaleUtils.isAvailableLocale(LOCALE_FR);
        LocaleUtils.isAvailableLocale(LOCALE_FR_CA);
        LocaleUtils.isAvailableLocale(LOCALE_QQ);
        LocaleUtils.isAvailableLocale(LOCALE_QQ_ZZ);

        // EXPLORE: Generate many varied Locale inputs and drive them through the same public API.
        int iterations = 1;
        try {
            iterations = data.consumeInt(1, 32);
        } catch (Throwable t) {
            // Fallback to a sane default if FuzzedDataProvider misbehaves
            iterations = 8;
        }

        for (int i = 0; i < iterations; i++) {
            // Occasionally test null directly.
            if (data.consumeBoolean()) {
                // This should be handled cleanly post-fix.
                LocaleUtils.isAvailableLocale(null);
            }

            String lang = data.consumeAsciiString(8);
            String country = data.consumeAsciiString(8);
            String variant = data.consumeAsciiString(8);

            // Construct different forms of Locale to vary inputs.
            java.util.Locale loc;
            switch (data.consumeInt(0, 2)) {
                case 0:
                    loc = new java.util.Locale(lang == null ? "" : lang);
                    break;
                case 1:
                    loc = new java.util.Locale(lang == null ? "" : lang, country == null ? "" : country);
                    break;
                default:
                    loc = new java.util.Locale(lang == null ? "" : lang, country == null ? "" : country, variant == null ? "" : variant);
                    break;
            }

            // Drive through the patched code path.
            LocaleUtils.isAvailableLocale(loc);

            // Also try to create a Locale via LocaleUtils.toLocale using fuzzed strings.
            // Invalid formats are expected to throw IllegalArgumentException: swallow them as valid rejections.
            String maybeLocaleStr;
            if (data.consumeBoolean()) {
                // Attempt to form a valid "ll" or "ll_CC" or "ll_CC_variant" string
                char a = (char) ('a' + (Math.abs(data.consumeByte()) % 26));
                char b = (char) ('a' + (Math.abs(data.consumeByte()) % 26));
                String ll = new String(new char[]{a, b});
                if (data.consumeBoolean()) {
                    char c1 = (char) ('A' + (Math.abs(data.consumeByte()) % 26));
                    char c2 = (char) ('A' + (Math.abs(data.consumeByte()) % 26));
                    String cc = new String(new char[]{c1, c2});
                    if (data.consumeBoolean()) {
                        String var = data.consumeAsciiString(6);
                        maybeLocaleStr = ll + "_" + cc + "_" + var;
                    } else {
                        maybeLocaleStr = ll + "_" + cc;
                    }
                } else {
                    maybeLocaleStr = ll;
                }
            } else {
                // Random ASCII, often invalid -> expect IAE.
                maybeLocaleStr = data.consumeAsciiString(16);
            }
            try {
                java.util.Locale fromStr = LocaleUtils.toLocale(maybeLocaleStr);
                if (fromStr != null) {
                    LocaleUtils.isAvailableLocale(fromStr);
                }
            } catch (IllegalArgumentException expected) {
                // Documented, deliberate rejection for invalid locale strings.
            }
        }

        // Exercise related public APIs that coexist with the caches used by isAvailableLocale.
        // These should not throw for arbitrary inputs; if they do, let it surface.
        if (data.consumeBoolean()) {
            String cc = data.consumeAsciiString(3);
            LocaleUtils.languagesByCountry(cc);
        }
        if (data.consumeBoolean()) {
            String lc = data.consumeAsciiString(3);
            LocaleUtils.countriesByLanguage(lc);
        }

        // Interact with the available locales collections and sample an element back through isAvailableLocale.
        java.util.List all = LocaleUtils.availableLocaleList();
        if (all != null && !all.isEmpty()) {
            Object o = all.get(data.consumeInt(0, all.size() - 1));
            if (o instanceof java.util.Locale) {
                LocaleUtils.isAvailableLocale((java.util.Locale) o);
