package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.image.BufferedImage;
import java.awt.Graphics2D;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: replicate the failing test's scenario to hit the original crash.
        BufferedImage image = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = image.createGraphics();

        BorderArrangement arrangement = new BorderArrangement();
        BlockContainer container = new BlockContainer(arrangement);

        RectangleConstraint constraint = new RectangleConstraint(
            10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
            0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        // As in the test: center-only scenarios first
        container.add(new EmptyBlock(5.0, 6.0));
        container.arrange(g2, constraint);

        container.clear();
        container.add(new EmptyBlock(15.0, 16.0));
        container.arrange(g2, constraint);

        // Right-only block with width > fixed container width (10.0) to force negative leftover (-2.3)
        container.clear();
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
        container.arrange(g2, constraint);

        // Explore: generate varied real inputs that preserve the triggering property:
        // - width constraint is FIXED
        // - left and/or right blocks may exceed the fixed width (causing negative leftover width internally)
        int iterations = data.consumeInt(1, 8);
        for (int i = 0; i < iterations; i++) {
            container.clear();

            boolean addLeft = data.consumeBoolean();
            boolean addRight = data.consumeBoolean();
            boolean addTop = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();
            boolean addCenter = data.consumeBoolean();

            // Ensure at least one side block exists to exercise width logic
            if (!addLeft && !addRight) {
                if (data.consumeBoolean()) {
                    addLeft = true;
                } else {
                    addRight = true;
                }
            }

            // Dimensions from fuzzed data (non-negative)
            double leftW = data.consumeInt(0, 500) / 10.0;
            double leftH = data.consumeInt(0, 500) / 10.0 + 0.01;
            double rightW = data.consumeInt(0, 500) / 10.0;
            double rightH = data.consumeInt(0, 500) / 10.0 + 0.01;

            double topW = data.consumeInt(0, 500) / 10.0;
            double topH = data.consumeInt(0, 500) / 10.0;

            double bottomW = data.consumeInt(0, 500) / 10.0;
            double bottomH = data.consumeInt(0, 500) / 10.0;

            double centerW = data.consumeInt(0, 500) / 10.0;
            double centerH = data.consumeInt(0, 500) / 10.0;

            // Choose a fixed width that sometimes forces overflow on the left/right placement
            boolean forceOverflow = data.consumeBoolean();
            double fixedW;
            if (forceOverflow) {
                double over = data.consumeInt(0, 90) / 10.0 + 0.1; // ensure strictly positive overflow
                if (addLeft && addRight) {
                    fixedW = Math.max(0.0, (leftW + rightW) - over);
                } else if (addRight) {
                    fixedW = Math.max(0.0, rightW - over);
                } else {
                    fixedW = Math.max(0.0, leftW - over);
                }
            } else {
                fixedW = leftW + rightW + data.consumeInt(0, 100) / 10.0;
            }

            boolean fixedHeight = data.consumeBoolean();
            double fixedH = data.consumeInt(0, 500) / 10.0;

            RectangleConstraint rc;
            if (fixedHeight) {
                rc = new RectangleConstraint(
                    fixedW, new Range(fixedW, fixedW), LengthConstraintType.FIXED,
                    fixedH, new Range(fixedH, fixedH), LengthConstraintType.FIXED
                );
            } else {
                rc = new RectangleConstraint(
                    fixedW, new Range(fixedW, fixedW), LengthConstraintType.FIXED,
                    0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
                );
            }

            if (addLeft) {
                container.add(new EmptyBlock(leftW, leftH), RectangleEdge.LEFT);
            }
            if (addRight) {
                container.add(new EmptyBlock(rightW, rightH), RectangleEdge.RIGHT);
            }
            if (addTop) {
                container.add(new EmptyBlock(topW, topH), RectangleEdge.TOP);
            }
            if (addBottom) {
                container.add(new EmptyBlock(bottomW, bottomH), RectangleEdge.BOTTOM);
            }
            if (addCenter) {
                container.add(new EmptyBlock(centerW, centerH));
            }

            // Arrange to drive through BorderArrangement.arrange*(...) including arrangeFF
            container.arrange(g2, rc);

            // Optionally arrange again to exercise state reset and reuse scenarios
            if (data.consumeBoolean()) {
                container.arrange(g2, rc);
            }
        }

        g2.dispose();
    }
}
