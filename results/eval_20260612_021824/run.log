package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR inputs from the failing test
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD83D\uDE30");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD800\uDC00");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        // EXPLORE: Generate varied inputs that start with one or more surrogate pairs and
        // optionally include CSV trigger characters to force the translator to consume > 0.
        int iterations = 1 + data.consumeInt(0, 30);
        for (int i = 0; i < iterations; i++) {
            // Generate a supplementary code point (always forms a surrogate pair)
            int cpRange = 0x10FFFF - 0x10000 + 1;
            int r = data.consumeInt();
            int cp = 0x10000 + Math.abs(r % cpRange);
            String sp = new String(Character.toChars(cp));

            // Repeat the surrogate pair a few times to vary initial length
            int pairCount = data.consumeInt(1, 4);
            StringBuilder spSeq = new StringBuilder();
            for (int j = 0; j < pairCount; j++) {
                spSeq.append(sp);
            }

            String ascii1 = data.consumeAsciiString(64);
            String ascii2 = data.consumeAsciiString(64);

            // Build the input starting with surrogate pairs to exercise the code point loop
            StringBuilder sb = new StringBuilder();
            sb.append(spSeq);

            // Optionally ensure presence of CSV special characters to trigger translation consumption
            String base = ascii1;
            if (i % 2 == 0) {
                if (base.indexOf(',') < 0 && base.indexOf('"') < 0 && base.indexOf('\n') < 0 && base.indexOf('\r') < 0) {
                    char[] tr = new char[] {',', '"', '\n', '\r'};
                    char t = tr[Math.abs(data.consumeInt()) % tr.length];
                    int insertPos = base.length() == 0 ? 0 : Math.abs(data.consumeInt()) % (base.length() + 1);
                    StringBuilder tmp = new StringBuilder(base);
                    tmp.insert(insertPos, t);
                    base = tmp.toString();
                }
            }
            sb.append(base);

            // Optionally insert another surrogate pair somewhere in the middle
            if (data.consumeBoolean()) {
                int where = sb.length() == 0 ? 0 : Math.abs(data.consumeInt()) % (sb.length() + 1);
                sb.insert(where, sp);
            }

            // Append trailing ascii
            sb.append(ascii2);

            // With some probability, force a CSV trigger if none present
            if (i % 3 == 0) {
                if (sb.indexOf(",") < 0 && sb.indexOf("\"") < 0 && sb.indexOf("\n") < 0 && sb.indexOf("\r") < 0) {
                    sb.append(',');
                }
            }

            String input = sb.toString();
            org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
        }

        // Additional small crafted cases combining surrogate pairs with CSV triggers
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD83D\uDE30,");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD83D\uDE30\"");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD83D\uDE30\n");
    }
}
