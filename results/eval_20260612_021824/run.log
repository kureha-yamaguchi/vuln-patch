package org.apache.commons.lang.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing-test inputs in order
        // These must not be caught: on the buggy version "1l" will throw, on the fixed version all should pass.
        NumberUtils.createNumber("-1l");
        NumberUtils.createNumber("01l");
        NumberUtils.createNumber("1l");

        // EXPLORE: Generate varied inputs that exercise the patched logic.
        // Property under test:
        // - Strings ending with 'l' or 'L'
        // - If they contain an exponent (e/E), a clean NumberFormatException is expected (swallow).
        // - Otherwise, a valid numeric part before the suffix should be accepted (do not swallow).
        int iterations = (data.remainingBytes() > 0 ? ((data.consumeInt() & 7) + 3) : 5);
        for (int i = 0; i < iterations; i++) {
            boolean includeExponent = data.consumeBoolean();
            boolean useUpperSuffix = data.consumeBoolean();
            boolean includeSign = data.consumeBoolean();
            boolean decimal = data.consumeBoolean();

            StringBuilder sb = new StringBuilder();

            // Optional sign
            if (includeSign) {
                sb.append(data.consumeBoolean() ? '-' : '+');
            }

            // Mantissa: ensure at least one digit
            int leftLen = data.consumeInt(1, 20);
            for (int j = 0; j < leftLen; j++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }

            // Optional decimal part: ensure at least one digit on the right when present
            if (decimal) {
                sb.append('.');
                int rightLen = data.consumeInt(1, 20);
                for (int j = 0; j < rightLen; j++) {
                    sb.append((char) ('0' + data.consumeInt(0, 9)));
                }
            }

            // Optional exponent part
            if (includeExponent) {
                sb.append(data.consumeBoolean() ? 'e' : 'E');
                if (data.consumeBoolean()) {
                    sb.append(data.consumeBoolean() ? '-' : '+');
                }
                int expLen = data.consumeInt(1, 6);
                for (int j = 0; j < expLen; j++) {
                    sb.append((char) ('0' + data.consumeInt(0, 9)));
                }
            }

            // Suffix 'l' or 'L'
            sb.append(useUpperSuffix ? 'L' : 'l');

            String candidate = sb.toString();

            // Distinguish expected behavior:
            // - With exponent: clean rejection (NumberFormatException) is expected -> swallow.
            // - Without exponent: should be accepted -> let any unexpected exception propagate.
            if (includeExponent) {
                try {
                    NumberUtils.createNumber(candidate);
                } catch (NumberFormatException expected) {
                    // expected clean rejection when exponent is present with 'l' suffix
                }
            } else {
                // Should be accepted across int/long/float/double/BigDecimal paths
                NumberUtils.createNumber(candidate);
            }
        }

        // Extra targeted cases:
        // 1-digit positive integers with 'l'/'L' (buggy version throws, fixed accepts)
        {
            char d = (char) ('0' + data.consumeInt(0, 9));
            String s1 = (new StringBuilder()).append(d).append('l').toString();
            String s2 = (new StringBuilder()).append(d).append('L').toString();
            NumberUtils.createNumber(s1);
            NumberUtils.createNumber(s2);
        }

        // Decimal numbers with 'l'/'L' and no exponent (buggy version throws, fixed accepts)
        {
            int aLen = data.consumeInt(1, 10);
            int bLen = data.consumeInt(1, 10);
            StringBuilder mantA = new StringBuilder();
            for (int j = 0; j < aLen; j++) mantA.append((char) ('0' + data.consumeInt(0, 9)));
            StringBuilder mantB = new StringBuilder();
            for (int j = 0; j < bLen; j++) mantB.append((char) ('0' + data.consumeInt(0, 9)));
            String base = mantA.toString() + "." + mantB.toString();
            NumberUtils.createNumber(base + "l");
            NumberUtils.createNumber(base + "L");
        }
    }
