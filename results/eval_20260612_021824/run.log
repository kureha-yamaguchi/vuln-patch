package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: Reproduce the failing test input to reach the buggy code path.
        UnivariateRealFunction f = new SinFunction();
        BisectionSolver anchorSolver = new BisectionSolver();
        try {
            // This triggers the buggy call chain on the unfixed version:
            // BisectionSolver.solve(f, min, max, initial) -> solve(min, max) (without f) => NPE.
            anchorSolver.solve(f, 3.0, 3.2, 3.1);
        } catch (MaxIterationsExceededException e) {
            // Acceptable post-fix behavior for difficult inputs; ignore.
        } catch (FunctionEvaluationException e) {
            // Acceptable post-fix behavior for bad functions/inputs; ignore.
        } catch (IllegalArgumentException e) {
            // Acceptable validation failure; ignore.
        }
        // EXPLORE: Generate varied inputs that exercise the same root cause:
        // calling solve(f, min, max, initial) on a fresh solver instance.
        int iterations = 1;
        if (data.remainingBytes() > 0) {
            iterations = data.consumeInt(1, 20);
        }
        for (int i = 0; i < iterations; i++) {
            // Generate min and max in a wide but reasonable range.
            double min = data.consumeInt(-1_000_000, 1_000_000) / 1000.0;
            double max = data.consumeInt(-1_000_000, 1_000_000) / 1000.0;

            // Optionally sort to ensure min <= max sometimes.
            if (data.consumeBoolean() && min > max) {
                double t = min;
                min = max;
                max = t;
            }

            // Choose an initial value; sometimes inside [min, max], sometimes outside.
            double initial;
            if (data.consumeBoolean()) {
                // Inside the interval (or equal if max==min).
                int r = data.consumeInt(0, 1000);
                initial = min + (max - min) * (r / 1000.0);
            } else {
                // Outside the interval.
                int offset = data.consumeInt(1, 1000);
                if (data.consumeBoolean()) {
                    initial = max + offset;
                } else {
                    initial = min - offset;
                }
            }

            // Always use a fresh solver to keep 'function' unset unless passed correctly.
            BisectionSolver solver = new BisectionSolver();
            try {
                solver.solve(f, min, max, initial);
            } catch (MaxIterationsExceededException e) {
                // Normal rejection for hard cases; swallow.
            } catch (FunctionEvaluationException e) {
                // Normal function evaluation failure; swallow.
            } catch (IllegalArgumentException e) {
                // Normal validation failure (e.g., no bracketing); swallow.
            }
        }
    }
}
