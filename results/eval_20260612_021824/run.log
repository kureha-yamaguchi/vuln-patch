public class FuzzHarness {
    private static final String[] ZONES = new String[] {
        "UTC",
        "Europe/London",
        "America/New_York",
        "Asia/Tokyo",
        "Pacific/Kiritimati",
        "Pacific/Pago_Pago",
        "Europe/Paris",
        "Asia/Kolkata",
        "Australia/Lord_Howe",
        "America/Phoenix"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing inputs first
