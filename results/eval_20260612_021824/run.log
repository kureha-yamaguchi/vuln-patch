            char suf = suffixes[safeAbs(data.consumeByte()) % suffixes.length];
            sb.append(suf);
        }
        return sb.toString();
    }

    private static String buildHexOrAscii(FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
