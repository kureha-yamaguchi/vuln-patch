        LocaleUtils.isAvailableLocale(new Locale("en"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US"));
        LocaleUtils.isAvailableLocale(new Locale("en", "US", "ZZZZ"));

        // EXPLORE: Vary inputs but always call with a cold cache first to stress the root cause.
        int iters = data.consumeInt(0, 20);
        for (int i = 0; i < iters; i++) {
            resetLocaleUtilsCaches();
            Locale loc = buildRandomLocale(data);
            // If fixed, this should never throw; if buggy, calling before cache init may NPE.
            LocaleUtils.isAvailableLocale(loc);
        }
    }
}
