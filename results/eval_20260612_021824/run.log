            s.add(new Day(19, 8, 2005), 1);
            s.add(new Day(31, 1, 2006), 1);
            // On the buggy version this throws IllegalArgumentException ("Requires start <= end.")
            // We intentionally do not catch IllegalArgumentException here to surface the bug.
            s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException e) {
            // ignore
        }

        // Explore: generate varied inputs that satisfy the root property:
        // - start and end are in the same gap between two consecutive data items,
        // - start <= end in chronological order,
        // - endIndex < startIndex in the original buggy logic, causing an IAE.
        int iterations = 1;
        try {
            iterations = 1 + data.consumeInt(0, 3);
        } catch (IllegalArgumentException e) {
            // If consumeInt throws due to bounds, default to 1 iteration.
            iterations = 1;
        }
        for (int it = 0; it < iterations; it++) {
            String name = data.consumeAsciiString(24);
            if (name == null) {
                name = "T";
            }
            TimeSeries ts = new TimeSeries(name);

            int year;
            int month;
            try {
                year = data.consumeInt(1900, 2099);
                month = data.consumeInt(1, 12);
            } catch (IllegalArgumentException e) {
                year = 2000;
                month = 6;
            }

            // Build an increasing sequence of distinct day-of-month values within [1, 28]
            // to avoid invalid dates across months.
            int targetCount;
            try {
                targetCount = data.consumeInt(2, 8);
            } catch (IllegalArgumentException e) {
                targetCount = 2;
            }
            int[] daysTmp = new int[Math.max(2, targetCount)];
            int actual = 0;
            int current;
            try {
                current = data.consumeInt(1, 20);
            } catch (IllegalArgumentException e) {
                current = 5;
            }
            daysTmp[actual++] = current;
            while (actual < targetCount) {
                int step;
                try {
                    step = data.consumeInt(1, 4);
                } catch (IllegalArgumentException e) {
                    step = 2;
                }
                current += step;
                if (current > 28) {
                    break;
                }
                daysTmp[actual++] = current;
            }
            if (actual < 2) {
                // Fallback to ensure at least two points with a gap
                daysTmp = new int[] {5, 28};
                actual = 2;
            }
            int[] days = new int[actual];
            for (int i = 0; i < actual; i++) {
                days[i] = daysTmp[i];
            }

            // Populate the series (values arbitrary)
            for (int i = 0; i < actual; i++) {
                try {
                    ts.add(new Day(days[i], month, year), i + 1);
                } catch (RuntimeException ex) {
                    // If there's any unexpected runtime issue while adding (e.g., duplicates),
                    // skip this iteration.
                    ts = null;
                    break;
                }
            }
            if (ts == null) {
                continue;
            }

            // Identify gaps with at least one integer day strictly between the two items (diff >= 2)
            int[] gapIdx = new int[Math.max(0, actual - 1)];
            int gapCount = 0;
            for (int i = 0; i < actual - 1; i++) {
                if (days[i + 1] - days[i] >= 2) {
                    gapIdx[gapCount++] = i;
                }
            }

            if (gapCount == 0) {
                // Force a simple series with a wide gap
                ts = new TimeSeries(name + "_fallback");
                try {
                    ts.add(new Day(1, month, year), 1);
                    ts.add(new Day(28, month, year), 2);
                } catch (RuntimeException ex) {
                    continue;
                }
                days = new int[] {1, 28};
                gapIdx = new int[] {0};
                gapCount = 1;
            }

            // Choose a gap and pick start/end within that same gap while ensuring start <= end
            int j;
            try {
                j = data.consumeInt(0, gapCount - 1);
            } catch (IllegalArgumentException e) {
                j = 0;
            }
            int left = days[gapIdx[j]];
            int right = days[gapIdx[j] + 1];
            int diff = right - left; // >= 2

            // start day = left + sDelta with 1 <= sDelta <= diff-1
            int sDelta;
            try {
                sDelta = data.consumeInt(1, diff - 1);
            } catch (IllegalArgumentException e) {
                sDelta = 1;
            }
            int startDay = left + sDelta;

            // end day = startDay + inc, 0 <= inc <= (right - startDay - 1)
            int incUpper = right - startDay - 1;
            int inc = 0;
            if (incUpper > 0) {
                try {
                    inc = data.consumeInt(0, incUpper);
                } catch (IllegalArgumentException e) {
                    inc = 0;
                }
            }
            int endDay = startDay + inc;

            Day start = new Day(startDay, month, year);
            Day end = new Day(endDay, month, year);

            try {
                ts.createCopy(start, end);
            } catch (CloneNotSupportedException e) {
                // ignore and continue
            } catch (IllegalArgumentException e) {
                // Swallow only if this is a legitimate rejection of invalid input, i.e., start > end.
                // Otherwise, rethrow to signal a bug (as in the original issue).
                try {
                    if (start.compareTo(end) > 0) {
                        // Valid input rejection; ignore and continue fuzzing.
                    } else {
                        throw e;
                    }
                } catch (RuntimeException cmpEx) {
                    // If comparison fails unexpectedly, let the original exception propagate.
                    throw e;
                }
            }
        }
    }
}
