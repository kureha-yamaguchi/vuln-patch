        DateTimeFormatter f = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

        // New York at start of year
        DateTimeZone newYork = DateTimeZone.forID("America/New_York");
        MutableDateTime nyStart = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, newYork);
        // On buggy version this throws IllegalFieldValueException - let it propagate.
        f.parseInto(nyStart, "2 29", 0);

        // Tokyo at end of year
        DateTimeZone tokyo = DateTimeZone.forID("Asia/Tokyo");
        MutableDateTime tokyoEnd = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, tokyo);
        // On buggy version this can also throw - let it propagate.
        f.parseInto(tokyoEnd, "2 29", 0);

        // Explore: Generate inputs that exercise the same root cause (defaultYear derived incorrectly from local millis).
        // Focus on leap years and times close to year boundaries across various time zones.
        String[] zoneIds = new String[] {
            "UTC",
            "America/New_York",
            "America/Los_Angeles",
            "America/Chicago",
            "America/Denver",
            "America/Phoenix",
            "America/Sao_Paulo",
            "Europe/London",
            "Europe/Paris",
            "Europe/Berlin",
            "Europe/Moscow",
            "Asia/Tokyo",
            "Asia/Shanghai",
