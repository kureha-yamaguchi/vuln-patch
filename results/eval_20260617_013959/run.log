            }
        }
    }

    private static final int[] DAYS_IN_MONTH = {
        31, 29, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    private static int daysInMonth(int month) {
        return DAYS_IN_MONTH[month - 1];
    }
