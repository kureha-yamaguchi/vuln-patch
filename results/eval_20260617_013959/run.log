        if (data.consumeBoolean()) {
            int size = Math.max(0, data.consumeInt(0, 100));
            arr = new String[size];
            for (int i = 0; i < size; i++) {
                arr[i] = data.consumeString(20);
            }
        }

        // Random element (possibly null)
