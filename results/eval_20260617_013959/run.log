package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Objects;

/* Fuzz harness for StringUtils.join that triggers the known NPE on the buggy
   version (StringUtils.join(Object[], char, int, int) when the first element
   of the array is null) and then explores additional inputs to ensure the
   patch handles all such cases. */
public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor call that crashes the buggy version
        Object[] anchorArray = new Object[]{null, "null"};
        StringUtils.join(anchorArray, '/', 0, 1);

        // Random exploration: generate an array that may contain nulls
        int len = data.consumeInt(1, 20);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                array[i] = null;
            } else {
                if (data.consumeBoolean()) {
                    array[i] = data.consumeString(10);
                } else {
                    array[i] = Integer.valueOf(data.consumeInt());
                }
            }
        }

        int startIdx = data.consumeInt(0, len - 1);
        int endIdx = data.consumeInt(startIdx + 1, len);
        char separator = (char) data.consumeInt(0, 127);

        // This call should crash on the buggy version when array[startIdx] is null
        StringUtils.join(array, separator, startIdx, endIdx);

        // Metamorphic check: for arrays that start with a non‑null value,
        // the full‑array join should equal the indexed join.
        if (array[0] != null) {
            String full = StringUtils.join(array, separator);
            String indexed = StringUtils.join(array, separator, 0, array.length);
            if (!Objects.equals(full, indexed)) {
                throw new RuntimeException(
                    "metamorphic violation: join(array, separator) != join(array, separator, 0, array.length)");
            }
        }
    }
}

