package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.jfree.data.time.TimeSeries;
import org.jfree.data.time.Day;
import java.time.LocalDate;
import java.time.YearMonth;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: reproduce known crash on buggy version
        try {
            TimeSeries sAnchor = new TimeSeries("S");
            sAnchor.add(new Day(19, 8, 2005), 1.0);
            sAnchor.add(new Day(31, 1, 2006), 1.0);
            sAnchor.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException e) {
            // Expected only in exceptional cloning environments; ignore.
        }

        // Exploration: random series and start/end dates that both fall between two consecutive data points
        try {
            // Generate first data point
            int year1 = data.consumeInt(1900, 2100);
            int month1 = data.consumeInt(1, 12);
            YearMonth ym1 = YearMonth.of(year1, month1);
            int day1 = data.consumeInt(1, ym1.lengthOfMonth());
            LocalDate ld1 = LocalDate.of(year1, month1, day1);
            Day d1 = new Day(day1, month1, year1);

            // Generate second data point at least two days after the first
            int minGap = 2;
            int maxGap = 365 * 5; // up to about five years
            int gap = data.consumeInt(minGap, maxGap);
            LocalDate ld2 = ld1.plusDays(gap);
            Day d2 = new Day(ld2.getDayOfMonth(), ld2.getMonthValue(), ld2.getYear());

            TimeSeries sExplore = new TimeSeries("S");
            sExplore.add(d1, 1.0);
            sExplore.add(d2, 1.0);

            // Pick start and end dates strictly between d1 and d2
            int daysBetween = gap; // at least 2
            int startOffset = data.consumeInt(1, daysBetween - 1);
            LocalDate startLocal = ld1.plusDays(startOffset);
            int endOffset = data.consumeInt(startOffset, daysBetween - 1);
            LocalDate endLocal = ld1.plusDays(endOffset);
            Day startDay = new Day(startLocal.getDayOfMonth(), startLocal.getMonthValue(), startLocal.getYear());
            Day endDay = new Day(endLocal.getDayOfMonth(), endLocal.getMonthValue(), endLocal.getYear());

            TimeSeries copy = null;
            try {
                copy = sExplore.createCopy(startDay, endDay);
            } catch (CloneNotSupportedException ignored) { }

            if (copy != null) {
                int originalCount = sExplore.getItemCount();
                int copyCount = copy.getItemCount();
                if (copyCount > originalCount) {
                    throw new RuntimeException(
                            "metamorphic violation: copy contains more items than original");
                }
            }
        } catch (CloneNotSupportedException ignored) {
            // Ignore cloning exceptions during exploration
        }
    }
}
