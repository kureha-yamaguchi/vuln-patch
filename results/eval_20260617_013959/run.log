package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: reproduce known buggy scenario
        StrBuilder anchor = new StrBuilder(1);
        anchor.appendFixedWidthPadRight("foo", 1, '-');

        // Generate random inputs for exploration
        int capacity = (data.consumeInt() & Integer.MAX_VALUE) % 30 + 1; // 1..30
        int width = (data.consumeInt() & Integer.MAX_VALUE) % 30 + 1;   // 1..30
        String s = data.consumeString(50); // up to 50 characters

        StrBuilder sb = new StrBuilder(capacity);
        sb.appendFixedWidthPadRight(s, width, '-');

        // Metamorphic relation: if width <= s.length(), result equals substring
        if (width > 0 && width <= s.length()) {
            StrBuilder result1 = new StrBuilder();
            result1.appendFixedWidthPadRight(s, width, '-');

            StrBuilder result2 = new StrBuilder();
            result2.append(s, 0, width);

            if (!result1.toString().equals(result2.toString())) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight output differs from simple substring append");
            }
        }
    }
}
