            String nilStr1 = StringUtils.join((Object[]) null, separatorStr, 0, 0);
            String nilStr2 = StringUtils.join((Object[]) null, separatorStr);
            if (!Objects.equals(nilStr1, nilStr2)) {
                throw new RuntimeException("metamorphic violation on null array");
            }
        }
    }
}

