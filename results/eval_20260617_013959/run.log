public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor crash: array with first element null, startIndex 0, endIndex 1
        Object[] anchor = new Object[] { null };
        StringUtils.join(anchor, ',', 0, 1); // expected to throw NPE on buggy version

        // Build a random array of up to 50 elements containing strings or nulls
        int len = data.consumeInt(0, 50);
        Object[] arr = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                arr[i] = null;
            } else {
                arr[i] = data.consumeString(20);
            }
        }

        int start = 0;
        int end = arr.length;

        // Call join with different separators
        StringUtils.join(arr, ',', start, end);
        String sepString = data.consumeString(5);
        StringUtils.join(arr, sepString, start, end);
        char sepChar = data.consumeAsciiString(1).charAt(0);
        StringUtils.join(arr, sepChar, start, end);

        // Metamorphic check: full-range join should equal join with start/end
        String full = StringUtils.join(arr, ',');
        String range = StringUtils.join(arr, ',', start, end);
        if (!full.equals(range)) {
            throw new RuntimeException("metamorphic violation: join(array, separator) != join(array, separator, 0, array.length)");
        }
    }
