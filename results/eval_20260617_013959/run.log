/* Jazzer harness for MonthDay addWrapPartial patch */
package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.chrono.ISOChronology;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: trigger known crash scenario
        MonthDay anchor = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
        anchor.plusMonths(-1);

        // Generate random month and day
        int month = data.consumeInt(1, 12);
        int day   = data.consumeInt(1, 31);

        MonthDay md;
        try {
            md = new MonthDay(month, day, ISOChronology.getInstance());
        } catch (IllegalFieldValueException e) {
            // Skip invalid dates
            return;
        }

        int op     = data.consumeInt(0, 3);
        int amount = data.consumeInt(-10, 10);
        MonthDay result;

        switch (op) {
            case 0:
                result = md.plusMonths(amount);
                break;
            case 1:
                result = md.minusMonths(amount);
                break;
            case 2:
                result = md.plusDays(amount);
                break;
            default:
                result = md.minusDays(amount);
                break;
        }

        // Metamorphic relation: operation followed by its inverse should yield the original
        MonthDay back;
        if (op == 0) {               // plusMonths
            back = result.minusMonths(amount);
        } else if (op == 1) {          // minusMonths
            back = result.plusMonths(amount);
        } else if (op == 2) {          // plusDays
            back = result.minusDays(amount);
        } else {                       // minusDays
            back = result.plusDays(amount);
        }

        if (!back.equals(md)) {
            throw new RuntimeException("metamorphic violation: inverse operation mismatch");
        }
    }
}
