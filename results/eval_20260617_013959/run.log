package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.*;
import java.lang.reflect.*;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            // Anchor input from the failing test
            String anchor =
                "var goog = {};\n" +
                "goog.inherits = function(x, y) {};\n" +
                "var ns = {};\n" +
                "/** @constructor */\n" +
                "ns.PageSelectionModel = function() {};\n" +
                "/** @constructor */\n" +
                "ns.PageSelectionModel.FooEvent = function() {};\n" +
                "/** @constructor */\n" +
                "ns.PageSelectionModel.SelectEvent = function() {};\n" +
                "goog.inherits(ns.PageSelectionModel.ChangeEvent, ns.PageSelectionModel.FooEvent);\n";

            // Compile the anchor twice to check reproducibility
            String out1 = compileCode(anchor);
            String out2 = compileCode(anchor);
            if (!out1.equals(out2)) {
                throw new RuntimeException("metamorphic violation: anchor outputs differ");
            }

            // Generate a fuzzed code containing the same pattern
            int seed = data.consumeInt(1, 9);
            String prefix = "var rand" + seed + " = " + seed + ";\n";
            String fuzzPart = data.consumeAsciiString(200).replace("*/", "*_/");
            String fuzzed = prefix + anchor + "\n/*" + fuzzPart + "*/";

            // Compile fuzzed code twice for metamorphic check
            String fOut1 = compileCode(fuzzed);
            String fOut2 = compileCode(fuzzed);
            if (!fOut1.equals(fOut2)) {
                throw new RuntimeException("metamorphic violation: fuzzed outputs differ");
            }

        } catch (Throwable t) {
            // Let an unexpected crash propagate
            throw new RuntimeException(t);
        }
    }

    private static String compileCode(String code) throws Exception {
        // Load classes via reflection
        Class<?> compilerClass = Class.forName("com.google.javascript.jscomp.Compiler");
        Object compiler = compilerClass.getDeclaredConstructor().newInstance();

        Class<?> optionsClass = Class.forName("com.google.javascript.jscomp.CompilerOptions");
        Object options = optionsClass.getDeclaredConstructor().newInstance();
        java.lang.reflect.Field smartField = optionsClass.getDeclaredField("smartNameRemoval");
        smartField.setAccessible(true);
        smartField.setBoolean(options, true);

        // Build SourceFile objects
        Class<?> sourceFileClass = Class.forName("com.google.javascript.jscomp.SourceFile");
        java.lang.reflect.Method fromCode = sourceFileClass.getMethod("fromCode", String.class, String.class);
        Object srcFile = fromCode.invoke(null, "input.js", code);
        Object externFile = fromCode.invoke(null, "extern.js", "");

        // Build CompilerInput objects
        Class<?> compilerInputClass = Class.forName("com.google.javascript.jscomp.CompilerInput");
        Constructor<?> ciCtor = compilerInputClass.getDeclaredConstructor(sourceFileClass);
        ciCtor.setAccessible(true);
        Object srcInput = ciCtor.newInstance(srcFile);
        Object externInput = ciCtor.newInstance(externFile);

        // Find an appropriate compile method
        Method compileMethod = null;
        for (Method m : compilerClass.getMethods()) {
            if (!m.getName().equals("compile")) continue;
            Class<?>[] pTypes = m.getParameterTypes();
            // 3-parameter form: List/Array, List/Array, CompilerOptions
            if (pTypes.length == 3 && optionsClass.isAssignableFrom(pTypes[2])) {
                compileMethod = m;
                break;
            }
            // 2-parameter form: List/Array, List/Array
            if (pTypes.length == 2) {
                if ((java.util.List.class.isAssignableFrom(pTypes[0]) &&
                     java.util.List.class.isAssignableFrom(pTypes[1])) ||
                    (pTypes[0].isArray() && pTypes[1].isArray() &&
                     pTypes[0].getComponentType().equals(compilerInputClass) &&
                     pTypes[1].getComponentType().equals(compilerInputClass))) {
                    compileMethod = m;
