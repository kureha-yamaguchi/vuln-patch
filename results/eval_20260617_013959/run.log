package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Objects;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        /* Anchor crash: buggy version throws ClassCastException for null array & null element */
        try {
            ArrayUtils.add((String[]) null, (String) null);
        } catch (IllegalArgumentException e) {
            /* expected after patch */
        }

        try {
            ArrayUtils.add((String[]) null, 0, (String) null);
        } catch (IllegalArgumentException e) {
            /* expected after patch */
        }

        /* Exploration phase */
        boolean arrayNullFlag = data.consumeBoolean();
        String[] array = null;
        if (!arrayNullFlag) {
            int size = data.consumeInt(0, 10);
            array = new String[size];
            for (int i = 0; i < size; i++) {
                array[i] = data.consumeString(10);
            }
        }

        boolean elementNullFlag = data.consumeBoolean();
        String element = null;
        if (!elementNullFlag) {
            element = data.consumeString(10);
        }

        // Call simple add
        try {
            String[] result = ArrayUtils.add(array, element);
            if (!(array == null && element == null)) {
                checkAddResult(array, element, result);
            }
        } catch (IllegalArgumentException e) {
            if (!(array == null && element == null)) {
                throw e;
            }
        }

        // Choose an index for indexed add
        int index;
        if (array != null) {
            index = data.consumeInt(0, array.length);
        } else {
            index = 0; // safe for null array
        }

        try {
            String[] resultIndex = ArrayUtils.add(array, index, element);
            if (!(array == null && element == null)) {
                checkAddIndexResult(array, index, element, resultIndex);
            }
        } catch (IllegalArgumentException e) {
            if (!(array == null && element == null)) {
                throw e;
            }
        }
    }

    private static void checkAddResult(String[] original, String element, String[] result) {
        if (original == null && element == null) {
            throw new RuntimeException("Metamorphic violation: expected exception on null array & null element");
        }
        if (original == null) {
            if (result.length != 1) {
                throw new RuntimeException("Metamorphic violation: result array length should be 1 for null original");
            }
            if (!Objects.equals(element, result[0])) {
                throw new RuntimeException("Metamorphic violation: result[0] mismatch");
            }
            return;
        }

        if (result.length != original.length + 1) {
            throw new RuntimeException("Metamorphic violation: result length mismatch");
        }
        for (int i = 0; i < original.length; i++) {
            if (!Objects.equals(original[i], result[i])) {
                throw new RuntimeException("Metamorphic violation: element mismatch at index " + i);
            }
        }
        if (!Objects.equals(element, result[original.length])) {
            throw new RuntimeException("Metamorphic violation: appended element mismatch");
        }
    }

    private static void checkAddIndexResult(String[] original, int index, String element, String[] result) {
        if (original == null && element == null) {
            return;
        }

        int expectedLen = (original == null ? 1 : original.length + 1);
        if (result.length != expectedLen) {
            throw new RuntimeException("Metamorphic violation: result length mismatch");
        }

        if (original == null) {
            if (!Objects.equals(element, result[0])) {
                throw new RuntimeException("Metamorphic violation: result[0] mismatch");
            }
            return;
        }

        if (index < 0 || index > original.length) {
            throw new RuntimeException("Metamorphic violation: index out of bounds");
        }

        if (!Objects.equals(element, result[index])) {
            throw new RuntimeException("Metamorphic violation: inserted element mismatch at index " + index);
        }

        for (int i = 0; i < index; i++) {
            if (!Objects.equals(original[i], result[i])) {
                throw new RuntimeException("Metamorphic violation: element before index mismatch at " + i);
            }
        }
        for (int i = index + 1; i < result.length; i++) {
            if (!Objects.equals(original[i - 1], result[i])) {
                throw new RuntimeException("Metamorphic violation: element after index mismatch at " + i);
            }
        }
    }
}

