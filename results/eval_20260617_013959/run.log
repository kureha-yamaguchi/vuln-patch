    private static void anchorTest() {
        DateTimeFormatter f = DateTimeFormat.forPattern("M d")
                                            .withLocale(Locale.UK);
        MutableDateTime result = new MutableDateTime(2004, 1, 1,
                                                     0, 0, 0, 0,
                                                     NEWYORK);
        try {
            int pos = f.parseInto(result, "2 29", 0);
            // Verify expected outcome
            if (pos != 4 ||
