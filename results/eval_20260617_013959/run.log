        for (int i = 0; i < iterations; i++) {
            int capacity = data.consumeInt(1, 50); // ensure non‑negative capacity
            StrBuilder sb = new StrBuilder(capacity);

            // Random object: either null or a random string
            String obj = null;
            if (data.consumeBoolean()) {
                obj = data.consumeString(100);
            }

            int width = data.consumeInt(1, 200);
            String ascii = data.consumeAsciiString(1);
            char padChar = ascii.isEmpty() ? ' ' : ascii.charAt(0);

            int oldSize = sb.length();
            try {
                sb.appendFixedWidthPadRight(obj, width, padChar);
                int newSize = sb.length();
                // Metamorphic check: appending must increase size by width
                if (newSize - oldSize != width) {
                    throw new RuntimeException(
                        "metamorphic violation: size diff mismatch oldSize=" + oldSize
                        + " newSize=" + newSize + " width=" + width);
                }
            } catch (IllegalArgumentException e) {
                // Accepted rejection
            }
        }
    }
}
