package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Objects;

/* Jazzer fuzz harness for StringUtils.replaceEach */

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: input known to crash on buggy version
        StringUtils.replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null});

        // Generate a random text string
        int maxLen = data.consumeInt(0, 100);
        String text = data.consumeString(maxLen);

        // Randomly build the search and replacement arrays
        int arraySize = data.consumeInt(0, 10);
        String[] searchList = new String[arraySize];
        String[] replaceList = new String[arraySize];

        for (int i = 0; i < arraySize; i++) {
            searchList[i] = data.consumeBoolean() ? data.consumeString(20) : null;
            replaceList[i] = data.consumeBoolean() ? data.consumeString(20) : null;
        }

        // Call the function under test
        String resultWithNulls = StringUtils.replaceEach(text, searchList, replaceList);

        // Metamorphic consistency check: removing entries with null replacement should not change result
        int cleanSize = 0;
        for (int i = 0; i < arraySize; i++) {
            if (searchList[i] != null && replaceList[i] != null) {
                cleanSize++;
            }
        }

        String[] cleanSearch = new String[cleanSize];
        String[] cleanReplace = new String[cleanSize];
        int idx = 0;
        for (int i = 0; i < arraySize; i++) {
            if (searchList[i] != null && replaceList[i] != null) {
                cleanSearch[idx] = searchList[i];
                cleanReplace[idx] = replaceList[i];
                idx++;
            }
        }

        String cleanResult = StringUtils.replaceEach(text, cleanSearch, cleanReplace);

        if (!Objects.equals(resultWithNulls, cleanResult)) {
            throw new RuntimeException("metamorphic violation: replaceEach with null replacements differs after cleaning");
        }
    }
}
