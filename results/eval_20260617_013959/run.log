        series.add(new Day(19, 8, 2005), 1);
        series.add(new Day(31, 1, 2006), 1);
        try {
            series.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException ignored) {
        }

        // Exploration – create random series and trigger the patched path.
        int itemCount = data.consumeInt(3, 10);
        TimeSeries s = new TimeSeries("Series-" + data.consumeString(5));
        List<Day> days = new ArrayList<>(itemCount);
        for (int i = 0; i < itemCount; i++) {
            int day = data.consumeInt(1, 28);      // avoid invalid days
            int month = data.consumeInt(1, 12);
            int year = data.consumeInt(1900, 2100);
            days.add(new Day(day, month, year));
        }

        days.sort(Comparator.comparingLong(d -> d.getFirstMillisecond()));
        for (Day d : days) {
            s.add(d, data.consumeInt());
        }

        if (days.size() >= 2) {
            Day start = days.get(1);
            Day end = days.get(days.size() - 1);

            try {
                TimeSeries copy = s.createCopy(start, end);
                // Metamorphic check: the copy must be a new instance.
                if (copy == s) {
                    throw new RuntimeException("Exploration: createCopy returned the original series for startIndex == 1");
                }
                // Optional sanity check on size.
                int expectedSize = s.getItemCount() - 1;
                if (copy.getItemCount() != expectedSize) {
                    if (expectedSize > 0) {
                        throw new RuntimeException("Exploration: createCopy produced unexpected item count");
                    }
                }
            } catch (CloneNotSupportedException ignored) {
            }
            // If an IllegalArgumentException is thrown here, it indicates a bug.
        }
    }
}

