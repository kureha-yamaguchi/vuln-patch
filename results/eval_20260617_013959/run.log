package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor tests with known problematic surrogate pair strings
        String[] anchors = {"\uD83D\uDE30", "\uD800\uDC00", "\uD834\uDD1E", "\uDBFF\uDFFD"};
        for (String s : anchors) {
            // This call is expected to trigger the bug on buggy version
            StringEscapeUtils.escapeCsv(s);
        }

        // Generate fuzzed input
        int maxLen = Math.min(2000, data.remainingBytes());
        String base = data.consumeString(maxLen);

        // Optionally insert a surrogate pair into the fuzzed input
        if (data.consumeBoolean()) {
            int pos = data.consumeInt(0, base.length());
            int choice = data.consumeInt(0, 3);
            String surrogate;
            switch (choice) {
                case 0: surrogate = "\uD83D\uDE30"; break;
                case 1: surrogate = "\uD800\uDC00"; break;
                case 2: surrogate = "\uD834\uDD1E"; break;
                default: surrogate = "\uDBFF\uDFFD"; break;
            }
            StringBuilder sb = new StringBuilder(base);
            sb.insert(pos, surrogate);
            base = sb.toString();
        }

        // Translate the input
        String escaped = StringEscapeUtils.escapeCsv(base);
        if (escaped == null) {
            return; // nothing to check
        }

        // Metamorphic check: if the input has no CSV special characters, escaping should be a no‑op
        if (!escaped.equals(base) &&
                base.indexOf(',') < 0 &&
                base.indexOf('"') < 0 &&
                base.indexOf('\r') < 0 &&
                base.indexOf('\n') < 0) {
            throw new RuntimeException("metamorphic violation: escapeCsv should return same string when no special characters");
        }
    }
}
