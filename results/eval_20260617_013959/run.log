        }
        invokeArrange(container, g2, constraint);

        // Right + center blocks
        container.clear();
        org.jfree.chart.block.EmptyBlock centerBlock = new org.jfree.chart.block.EmptyBlock(7.0, 20.0);
        org.jfree.chart.block.EmptyBlock rightBlock2 = new org.jfree.chart.block.EmptyBlock(8.0, 30.0);
        container.add(centerBlock);
        try {
            Class<?> edgeClass = Class.forName("org.jfree.chart.util.RectangleEdge");
            Object rightEdgeEnum = Enum.valueOf((Class<? extends Enum>) edgeClass, "RIGHT");
            addBlockWithEdge(container, rightBlock2, rightEdgeEnum);
        } catch (Exception e) {
            // Edge class not available; skip side placement
        }
        invokeArrange(container, g2, constraint);
    }

    private static void runExploration(FuzzedDataProvider data) throws Exception {
        int seed = data.consumeInt();
        Random rnd = new Random(seed);

        Class<?> ltClass = loadLengthConstraintType();
        Object fixedEnum = Enum.valueOf((Class<? extends Enum>) ltClass, "FIXED");
        Object noneEnum = Enum.valueOf((Class<? extends Enum>) ltClass, "NONE");

        boolean edgeClassAvailable = true;
        Class<?> edgeClass = null;
        Object leftEdge = null;
        Object rightEdge = null;
        try {
            edgeClass = Class.forName("org.jfree.chart.util.RectangleEdge");
            leftEdge = Enum.valueOf((Class<? extends Enum>) edgeClass, "LEFT");
            rightEdge = Enum.valueOf((Class<? extends Enum>) edgeClass, "RIGHT");
        } catch (ClassNotFoundException e) {
            edgeClassAvailable = false;
        }

        for (int i = 0; i < 5; i++) {
            double width = rnd.nextDouble() * 2000 - 1000;
            double height = rnd.nextDouble() * 2000 - 1000;
            double wLow = rnd.nextDouble() * 200 - 100;
            double wHigh = wLow + rnd.nextDouble() * 200;
            double hLow = rnd.nextDouble() * 200 - 100;
            double hHigh = hLow + rnd.nextDouble() * 200;
            if (wHigh < wLow || hHigh < hLow) continue;
            org.jfree.data.Range wRange = new org.jfree.data.Range(wLow, wHigh);
            org.jfree.data.Range hRange = new org.jfree.data.Range(hLow, hHigh);
            Object constraint = createConstraint(width, wRange, fixedEnum,
                    height, hRange, noneEnum, ltClass);

            java.awt.image.BufferedImage image = new java.awt.image.BufferedImage(200, 100,
                    java.awt.image.BufferedImage.TYPE_INT_RGB);
            java.awt.Graphics2D g2 = image.createGraphics();

