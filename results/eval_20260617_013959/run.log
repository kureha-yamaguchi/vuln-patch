package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import com.google.javascript.jscomp.Compiler;
import com.google.javascript.jscomp.CompilerOptions;
import com.google.javascript.jscomp.SourceFile;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        try {
            String js = buildCode(data);
            Compiler compiler = new Compiler();
            CompilerOptions options = new CompilerOptions();
            options.smartNameRemoval = true;
            List<SourceFile> externs = Collections.emptyList();
            List<SourceFile> inputs = Collections.singletonList(SourceFile.fromCode("input.js", js));
            compiler.compile(externs, inputs, options);
            compiler.toSource();
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
            throw new RuntimeException(t);
        }
    }

    private static String buildCode(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        // Random leading whitespace
        int leadingSpaces = data.consumeInt(0, 20);
        for (int i = 0; i < leadingSpaces; i++) sb.append(' ');

        // Random identifiers for the namespace and class elements
        String modelName = randomId(data, 6);
        String fooEventName = randomId(data, 6);
        String selectEventName = randomId(data, 6);
        String changeEventName = randomId(data, 6);

        sb.append("var goog = {};\n");
        sb.append("goog.inherits = function(x, y) {};\n");
        sb.append("var ns = {};\n");
        sb.append("/** @constructor */\n");
        sb.append("ns.").append(modelName).append(" = function() {};\n");
        sb.append("/** @constructor */\n");
        sb.append("ns.").append(modelName).append(".").append(fooEventName).append(" = function() {};\n");
        sb.append("/** @constructor */\n");
        sb.append("ns.").append(modelName).append(".").append(selectEventName).append(" = function() {};\n");
        sb.append("goog.inherits(ns.").append(modelName).append(".").append(changeEventName).append(", ");
        sb.append("ns.").append(modelName).append(".").append(fooEventName).append(");\n");

        // Random semicolons and newlines after the core code
        int semicolons = data.consumeInt(0, 50);
        for (int i = 0; i < semicolons; i++) sb.append(';');
        int newLines = data.consumeInt(0, 20);
        for (int i = 0; i < newLines; i++) sb.append('\n');

        return sb.toString();
    }

    private static String randomId(FuzzedDataProvider data, int maxLen) {
        int len = Math.max(1, data.consumeInt(1, maxLen));
        StringBuilder id = new StringBuilder(len);
        // First character must be a letter
        char first = (char) ('a' + data.consumeInt(0, 25));
        id.append(first);
        for (int i = 1; i < len; i++) {
            int r = data.consumeInt(0, 61); // 0..61 inclusive
            char c;
            if (r < 26) {
                c = (char) ('a' + r);
            } else if (r < 52) {
                c = (char) ('A' + (r - 26));
            } else {
                c = (char) ('0' + (r - 52));
            }
            id.append(c);
        }
        return id.toString();
    }
}

