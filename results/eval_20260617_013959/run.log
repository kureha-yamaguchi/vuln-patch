            throw new RuntimeException("Bug detected: IllegalFieldValueException on valid input", e);
        } catch (Exception e) {
            throw new RuntimeException("Unexpected exception in anchor test", e);
        }
    }

    private static void fuzzTest(FuzzedDataProvider data) {
        DateTimeFormatter f = DateTimeFormat.forPattern("M d")
                                            .withLocale(Locale.UK);
        int month = data.consumeInt(1, 12);
        int day   = data.consumeInt(1, 31);
        String text = month + " " + day;

        MutableDateTime instant = new MutableDateTime(2004, 1, 1,
                                                      0, 0, 0, 0,
                                                      NEWYORK);
        try {
            f.parseInto(instant, text, 0);
        } catch (IllegalFieldValueException ignored) {
            // Normal rejection for invalid month/day values
        } catch (Exception e) {
            // Any other exception indicates a fault
            throw new RuntimeException("Unexpected exception in fuzz test", e);
        }
    }

    private static void metamorphicCheck() {
        MutableDateTime original = new MutableDateTime(2022, 7, 14,
                                                       12, 0, 0, 0,
                                                       DateTimeZone.UTC);
        DateTimeFormatter fullFormat = DateTimeFormat.forPattern("yyyy-M-d");
        String formatted = fullFormat.print(original);

        MutableDateTime parsed = new MutableDateTime(2000, 1, 1,
                                                     0, 0, 0, 0,
                                                     DateTimeZone.UTC);
        int pos = fullFormat.parseInto(parsed, formatted, 0);
        if (pos < 0) {
            throw new RuntimeException("Metamorphic check failed: negative parse position");
        }
        if (original.getYear() != parsed.getYear() ||
            original.getMonthOfYear() != parsed.getMonthOfYear() ||
            original.getDayOfMonth() != parsed.getDayOfMonth()) {
            throw new RuntimeException("Metamorphic check failed: parsed date differs from original");
        }
    }
}

