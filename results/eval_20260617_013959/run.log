    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Build a time series with at least two data points
        TimeSeries series = new TimeSeries("S");

        int yr1 = data.consumeInt(1900, 2199);
        int mn1 = data.consumeInt(1, 12);
        int dy1 = data.consumeInt(1, 28);
        Day d1 = new Day(dy1, mn1, yr1);

        int yr2 = data.consumeInt(1900, 2199);
        int mn2 = data.consumeInt(1, 12);
        int dy2 = data.consumeInt(1, 28);
        Day d2 = new Day(dy2, mn2, yr2);

        if (d1.compareTo(d2) > 0) {
            Day tmp = d1; d1 = d2; d2 = tmp;
        }

        series.add(d1, 1);
        series.add(d2, 1);

        // Attempt to find start and end periods that will cause reversed indices
        Day start = null;
        Day end = null;
        for (int attempt = 0; attempt < 10; attempt++) {
            int cy = data.consumeInt(1900, 2199);
            int cm = data.consumeInt(1, 12);
            int cd = data.consumeInt(1, 28);
            Day s = new Day(cd, cm, cy);

            int ey = data.consumeInt(1900, 2199);
            int em = data.consumeInt(1, 12);
            int ed = data.consumeInt(1, 28);
            Day e = new Day(ed, em, ey);

            if (s.compareTo(e) > 0) {
                Day tmp = s; s = e; e = tmp;
            }

            int sIdx = series.getIndex(s);
            int eIdx = series.getIndex(e);
            if (sIdx >= 0 && eIdx >= 0 && sIdx > eIdx) {
                start = s;
                end = e;
                break;
            }
        }

        if (start == null || end == null) {
            return;
        }

        try {
            TimeSeries copy = series.createCopy(start, end);

            // Metamorphic check: number of items in the copy must equal the number of items
            // in the original series that lie between start and end inclusive.
            int expected = 0;
            for (int i = 0; i < series.getItemCount(); i++) {
                RegularTimePeriod period = series.getTimePeriod(i);
                if (start.compareTo(period) <= 0 && period.compareTo(end) <= 0) {
                    expected++;
                }
            }
            if (expected != copy.getItemCount()) {
                throw new RuntimeException("metamorphic violation: expected=" + expected
                        + ", got=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException ignored) {
            // ignore
        } catch (IllegalArgumentException ex) {
            int sIdx = series.getIndex(start);
            int eIdx = series.getIndex(end);
            if (start.compareTo(end) <= 0 && sIdx >= 0 && eIdx >= 0 && sIdx > eIdx) {
                // The bug causes an exception in this scenario; rethrow to report it
                throw ex;
            }
            // Otherwise, the exception is a normal validation failure; swallow
        }
    }
}

