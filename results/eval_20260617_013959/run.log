package org.joda.time.format;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.format.DateTimeFormat;
import org.joda.time.format.DateTimeFormatter;
import org.joda.time.MutableDateTime;
import org.joda.time.DateTimeZone;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: reproduces the known crash on the buggy build.
        DateTimeFormatter formatter = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

        MutableDateTime startNY = new MutableDateTime(
                2004, 1, 1, 0, 0, 0, 0,
                DateTimeZone.forID("America/New_York"));
        formatter.parseInto(startNY, "2 29", 0);
        String formattedStart = formatter.print(startNY);
        if (!formattedStart.equals("2 29")) {
            throw new RuntimeException(
                    "metamorphic violation: parsed result does not match input (startNY)");
        }

        MutableDateTime endTok = new MutableDateTime(
                2004, 12, 31, 23, 59, 59, 999,
                DateTimeZone.forID("Asia/Tokyo"));
        formatter.parseInto(endTok, "2 29", 0);
        String formattedEnd = formatter.print(endTok);
        if (!formattedEnd.equals("2 29")) {
            throw new RuntimeException(
                    "metamorphic violation: parsed result does not match input (endTok)");
        }

        // Fuzzing exploration: generate many different years and negative‑offset zones.
        String[] negativeZones = {
                "America/New_York",
                "America/Chicago",
                "America/Los_Angeles",
                "America/Denver",
                "America/Anchorage",
                "America/Sao_Paulo",
                "America/Argentina/Buenos_Aires"
        };
        int zoneIndex = data.consumeInt(0, negativeZones.length - 1);
        DateTimeZone zone = DateTimeZone.forID(negativeZones[zoneIndex]);

        int candidateYear = data.consumeInt(1990, 2100);
        int year = candidateYear;
        while (!isLeapYear(year)) {
            year++;
            if (year > 2100) {
                year = 2004;
                break;
            }
        }

        // The same problematic input that triggered the original bug.
        String input = "2 29";
        MutableDateTime fuzzedInstant = new MutableDateTime(
                year, 1, 1, 0, 0, 0, 0, zone);
        formatter.parseInto(fuzzedInstant, input, 0);
        String fuzzedFormatted = formatter.print(fuzzedInstant);
        if (!fuzzedFormatted.equals("2 29")) {
            throw new RuntimeException(
                    "metamorphic violation: fuzzed parse->format mismatch");
        }
    }

    private static boolean isLeapYear(int year) {
        return ((year % 4 == 0) && (year % 100 != 0)) || (year % 400 == 0);
    }
}

