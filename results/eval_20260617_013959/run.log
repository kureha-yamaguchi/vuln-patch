            "var goog = {};\n" +
            "goog.inherits = function(x, y) {};\n" +
            "var ns = {};\n" +
            "/** @constructor */\n" +
            "ns.PageSelectionModel = function() {};\n" +
            "/** @constructor */\n" +
            "ns.PageSelectionModel.FooEvent = function() {};\n" +
            "/** @constructor */\n" +
            "ns.PageSelectionModel.SelectEvent = function() {};\n" +
            "goog.inherits(ns.PageSelectionModel.ChangeEvent, ns.PageSelectionModel.FooEvent);";
        List<JSSourceFile> externs = Collections.emptyList();
        List<JSSourceFile> src = Collections.singletonList(JSSourceFile.fromCode("anchor.js", seedSource));
        anchorCompiler.compile(externs, src, baseOptions);

        // Explore: generate fuzzed source containing a goog.inherits call with valid identifiers
        String raw1 = data.consumeAsciiString(10);
        String raw2 = data.consumeAsciiString(10);
        String name1 = sanitizeIdent(raw1);
        String name2 = sanitizeIdent(raw2);
        String fuzzSource =
            "var goog={};goog.inherits=function(x,y){};" +
            "var ns={};" +
            "goog.inherits(ns." + name1 + ", ns." + name2 + ");";
        Compiler fuzzCompiler = new Compiler();
        List<JSSourceFile> fuzzSrc = Collections.singletonList(JSSourceFile.fromCode("fuzz.js", fuzzSource));
        fuzzCompiler.compile(externs, fuzzSrc, baseOptions);
    }

    private static String sanitizeIdent(String raw) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                (c >= '0' && c <= '9') || c == '_' || c == '$') {
                sb.append(c);
            }
        }
        String s = sb.toString();
        if (s.isEmpty()) {
            s = "x";
        } else if (Character.isDigit(s.charAt(0))) {
            s = "_" + s;
        }
        return s;
    }
}

