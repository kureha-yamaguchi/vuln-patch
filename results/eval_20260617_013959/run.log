import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Method;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // ANCHOR: use a proxy that throws NPE when toString() is called
        InvocationHandler handler = new InvocationHandler() {
            @Override
            public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
                if ("toString".equals(method.getName()) && method.getParameterCount() == 0) {
                    throw new NullPointerException("proxy toString exception");
                }
                return null;
            }
        };
        Object proxy = Proxy.newProxyInstance(
                FuzzHarness.class.getClassLoader(),
                new Class<?>[] { java.util.Comparator.class },
                handler);

        Object[] arrayWithProxy = new Object[] { proxy };
        // This call will trigger the bug in the buggy version
        StringUtils.join(arrayWithProxy, ',');

        // EXPLORE: generate random arrays and apply a metamorphic check
