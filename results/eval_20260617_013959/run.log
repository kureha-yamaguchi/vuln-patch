        calEnd.add(Calendar.DAY_OF_MONTH, endOffset);

        Day startDay = new Day(calStart.get(Calendar.DAY_OF_MONTH), calStart.get(Calendar.MONTH) + 1, calStart.get(Calendar.YEAR));
