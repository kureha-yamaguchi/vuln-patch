package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;
import java.util.Set;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: call with a specific locale that triggers the bug
        try {
            Locale anchorLocale = new Locale("en", "US", "ZZZZ");
            LocaleUtils.isAvailableLocale(anchorLocale);
        } catch (IllegalArgumentException e) {
            // Should not happen for the hardcoded locale
        }

        // Explore: generate random locales and test
        int localeCnt = data.consumeInt(1, 10); // number of locales to generate
        for (int i = 0; i < localeCnt; i++) {
            try {
                // Generate language part: 2-3 lowercase letters
                String lang = data.consumeAsciiString(3);
                if (lang.length() < 2 || lang.length() > 3) continue;

                boolean hasCountry = data.consumeBoolean();
                String country = null;
                if (hasCountry) {
                    country = data.consumeAsciiString(2);
                    if (country.length() != 2) continue;
                }

                boolean hasVariant = data.consumeBoolean();
                String variant = null;
                if (hasVariant) {
                    variant = data.consumeAsciiString(8);
                    if (variant.length() == 0) continue;
                }

                Locale locale;
                if (!hasCountry && !hasVariant) {
                    locale = new Locale(lang);
                } else if (hasCountry && !hasVariant) {
                    locale = new Locale(lang, country);
                } else if (hasCountry && hasVariant) {
                    locale = new Locale(lang, country, variant);
                } else {
                    continue; // skip invalid case
                }

                boolean available = LocaleUtils.isAvailableLocale(locale);

                // Metamorphic check: set.contains(locale) == isAvailableLocale(locale)
                Set<Locale> localeSet = LocaleUtils.availableLocaleSet();
                boolean contains = localeSet.contains(locale);
                if (available != contains) {
                    throw new RuntimeException("metamorphic violation: set.contains != isAvailableLocale");
                }
            } catch (IllegalArgumentException e) {
                // Skip invalid locales constructed from bad strings
            }
        }
    }
}
