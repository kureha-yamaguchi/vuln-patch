        Object[] randomArray = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                randomArray[i] = data.consumeString(10);
            } else {
                randomArray[i] = null;
            }
        }
        char separator = (char) data.consumeInt(32, 126);

        String joined = StringUtils.join(randomArray, separator);
        int expectedLen = 0;
        for (Object o : randomArray) {
