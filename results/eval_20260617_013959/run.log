    private static int[] extractNumbers(String s) {
        int[] res = new int[2];
        int i = 0;
        int len = s.length();

        // first number
        while (i < len && !Character.isDigit(s.charAt(i))) i++;
        int start = i;
        while (i < len && Character.isDigit(s.charAt(i))) i++;
        if (start == i) {
            res[0] = -1;
        } else {
            try {
                res[0] = Integer.parseInt(s.substring(start, i));
            } catch (NumberFormatException e) {
                res[0] = -1;
            }
        }

        // second number
        while (i < len && !Character.isDigit(s.charAt(i))) i++;
        start = i;
        while (i < len && Character.isDigit(s.charAt(i))) i++;
        if (start == i) {
            res[1] = -1;
        } else {
            try {
                res[1] = Integer.parseInt(s.substring(start, i));
            } catch (NumberFormatException e) {
                res[1] = -1;
            }
        }

        return res;
    }
}
