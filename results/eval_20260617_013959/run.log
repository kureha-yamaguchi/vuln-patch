    private static void invokeArrange(org.jfree.chart.block.BlockContainer container,
                                      java.awt.Graphics2D g2,
                                      Object constraint) throws Exception {
        Class<?> rectCls = Class.forName("org.jfree.chart.util.RectangleConstraint");
        java.lang.reflect.Method arrangeMethod = container.getClass().getMethod(
                "arrange", java.awt.Graphics2D.class, rectCls);
        arrangeMethod.invoke(container, g2, constraint);
    }

    private static Class<?> loadLengthConstraintType() throws ClassNotFoundException {
        try {
            return Class.forName("org.jfree.chart.util.RectangleConstraint$LengthConstraintType");
        } catch (ClassNotFoundException e) {
            return Class.forName("org.jfree.chart.util.LengthConstraintType");
        }
    }

    private static Object createConstraint(double w, org.jfree.data.Range wR, Object wT,
