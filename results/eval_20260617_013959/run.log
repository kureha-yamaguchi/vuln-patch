        } catch (Throwable t) {
            throw new RuntimeException(t);
        }
    }

    private static void runAnchorTest() throws Exception {
        Class<?> ltClass = loadLengthConstraintType();
        Object fixedEnum = Enum.valueOf((Class<? extends Enum>) ltClass, "FIXED");
        Object noneEnum = Enum.valueOf((Class<? extends Enum>) ltClass, "NONE");

        Object constraint = createConstraint(10.0,
                new org.jfree.data.Range(10.0, 10.0), fixedEnum,
                0.0, new org.jfree.data.Range(0.0, 0.0), noneEnum,
                ltClass);

        java.awt.image.BufferedImage img = new java.awt.image.BufferedImage(200, 100,
                java.awt.image.BufferedImage.TYPE_INT_RGB);
        java.awt.Graphics2D g2 = img.createGraphics();

        org.jfree.chart.block.BlockContainer container = new org.jfree.chart.block.BlockContainer(
                new org.jfree.chart.block.BorderArrangement());

        // Center block only
        container.add(new org.jfree.chart.block.EmptyBlock(5.0, 6.0));
        invokeArrange(container, g2, constraint);

        // Right block only
        container.clear();
        org.jfree.chart.block.EmptyBlock rightBlock = new org.jfree.chart.block.EmptyBlock(12.3, 45.6);
        try {
            Class<?> edgeClass = Class.forName("org.jfree.chart.util.RectangleEdge");
            Object rightEdgeEnum = Enum.valueOf((Class<? extends Enum>) edgeClass, "RIGHT");
