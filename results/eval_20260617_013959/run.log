package org.jfree.data.xy;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: deterministic crash path on buggy version
        XYSeries series = new XYSeries("Series", true, true);
        series.addOrUpdate(1.0, 1.0);
        series.addOrUpdate(1.0, 2.0);

        // Exploration: feed random inputs that may trigger the buggy path
        int count = data.consumeInt(1, 200);
        Double lastX = null;
        for (int i = 0; i < count; i++) {
            double x;
            if (data.consumeBoolean() && lastX != null) {
                x = lastX.doubleValue();
            } else {
                x = data.consumeInt();
                lastX = Double.valueOf(x);
            }
            double y = data.consumeInt();
            series.addOrUpdate(x, y);
        }

        // Metamorphic check: series should remain sorted when autoSort is true
        int itemCount = series.getItemCount();
        for (int i = 0; i < itemCount - 1; i++) {
            Number x1 = series.getX(i);
            Number x2 = series.getX(i + 1);
            if (x1.doubleValue() > x2.doubleValue()) {
                throw new RuntimeException("metamorphic violation: unsorted order");
            }
        }
    }
}
