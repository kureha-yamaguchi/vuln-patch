        Locale locale = Locale.forLanguageTag(tag);

        // Call the target method, allowing any root‑cause NPE to propagate
        boolean result = LocaleUtils.isAvailableLocale(locale);

        // Metamorphic check: result should agree with membership in availableLocaleList()
        List<Locale> list = LocaleUtils.availableLocaleList();
        if (list.contains(locale) != result) {
            throw new RuntimeException("metamorphic violation: isAvailableLocale inconsistent with availableLocaleList for locale " + locale);
        }
    }
}
