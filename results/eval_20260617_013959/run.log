package org.joda.time.format;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;
import org.joda.time.DateTimeZone;
import org.joda.time.MutableDateTime;
import org.joda.time.format.DateTimeFormat;
import org.joda.time.IllegalFieldValueException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: should trigger bug on buggy build
        DateTimeFormatter formatter = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);
        MutableDateTime anchorResult = new MutableDateTime(
                2004, 1, 1, 0, 0, 0, 0,
                DateTimeZone.forID("America/New_York"));
        formatter.parseInto(anchorResult, "2 29", 0); // crashes on buggy version

        // Randomized fuzzing of month/day inputs
        int month = data.consumeInt(1, 12);
        int day = data.consumeInt(1, 31);
        String text = month + " " + day;

        MutableDateTime randomResult = new MutableDateTime(
                2004, 1, 1, 0, 0, 0, 0,
                DateTimeZone.forID("America/New_York"));
        try {
            int newPos = formatter.parseInto(randomResult, text, 0);
            String parsedPart = text.substring(0, newPos);
