import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    // A special object whose toString throws NPE, used to trigger the buggy behavior.
    private static final Object BAD_OBJECT = new Object() {
        @Override
        public String toString() {
            throw new NullPointerException("toString NPE");
        }
    };

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: this call will trigger NPE in the buggy version due to the capacity calculation
        Object[] anchorArray = new Object[]{ BAD_OBJECT, "foo" };
        StringUtils.join(anchorArray, ','); // char separator, no bounds
        StringUtils.join(anchorArray, ',', 0, anchorArray.length); // bounds variant
        StringUtils.join(anchorArray, '/', 0, anchorArray.length); // char separator variant

        // Explore: generate varied inputs while keeping the first element problematic.
        int len = data.consumeInt(0, 20);
        Object[] arr = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                // With 50% probability set the first element to BAD_OBJECT to hit the bug.
                if (i == 0 && data.consumeBoolean()) {
                    arr[i] = BAD_OBJECT;
                } else {
                    arr[i] = data.consumeAsciiString(10);
                }
            } else {
                arr[i] = data.consumeInt();
            }
        }

        if (arr.length == 0) {
            // Still invoke joins to ensure no other errors occur on empty arrays.
            StringUtils.join(arr, ',');
            StringUtils.join(arr, ',', 0, arr.length);
        } else {
            // These calls may crash if BAD_OBJECT is in the array.
            StringUtils.join(arr, ','); // char separator, no bounds
            StringUtils.join(arr, ',', 0, arr.length); // bounds variant

            // Metamorphic validation: both overloads should produce identical results.
            String simple = StringUtils.join(arr, ',');
            String withBounds = StringUtils.join(arr, ',', 0, arr.length);
            if (simple == null ? withBounds != null : !simple.equals(withBounds)) {
                throw new RuntimeException("metamorphic violation: join overload mismatch");
            }
        }

        // Additional checks on the String separator overload for thoroughness.
        StringUtils.join(arr, "/"); // string separator, no bounds
        StringUtils.join(arr, "/", 0, arr.length); // bounds variant
    }
}

