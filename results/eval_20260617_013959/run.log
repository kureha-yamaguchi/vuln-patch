package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // generate a String array: either null or an array of random length up to 20
        String[] array;
        if (data.consumeBoolean()) {
            // null array typed as String[]
            array = null;
        } else {
            int len = Math.max(0, data.consumeInt(0, 20));
            array = new String[len];
            for (int i = 0; i < len; i++) {
                array[i] = data.consumeString(10);
            }
        }

        // element may be null or a random string
        String element = data.consumeBoolean() ? null : data.consumeString(10);

        // First, test add(array, element)
        try {
            String[] result = ArrayUtils.add(array, element);
            // metamorphic check: length is oldLen+1
            int oldLen = ArrayUtils.getLength(array);
            int newLen = ArrayUtils.getLength(result);
            if (newLen != oldLen + 1) {
                throw new RuntimeException("metamorphic violation: add length mismatch");
            }
        } catch (IllegalArgumentException | IndexOutOfBoundsException e) {
            // accepted rejection of bad input; ignore
        }

        // Second, test add(array, index, element)
