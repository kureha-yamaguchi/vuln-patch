                }
                if (data.consumeBoolean() && edgeClassAvailable && edgeClass != null) {
                    boolean left = data.consumeBoolean();
                    Object edge = left ? leftEdge : rightEdge;
                    addBlockWithEdge(container, block, edge);
                } else {
