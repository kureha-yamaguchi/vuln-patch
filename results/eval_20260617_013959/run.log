public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: trigger the bug on the buggy version
        DateTimeZone newYork = DateTimeZone.forID("America/New_York");
        DateTimeFormatter fAnchor = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);
        MutableDateTime resultAnchor = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, newYork);
        fAnchor.parseInto(resultAnchor, "2 29", 0);

        // Fuzzing section
        DateTimeFormatter f = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);
        int year = 2004;  // use a leap year to exercise the bug
        int month = data.consumeInt(1, 12);
        LocalDate temp = new LocalDate(year, month, 1);
        int maxDay = temp.dayOfMonth().getMaximumValue();
        int day = data.consumeInt(1, maxDay);
        int hour = data.consumeInt(0, 23);
        int minute = data.consumeInt(0, 59);
        int second = data.consumeInt(0, 59);
        int millis = data.consumeInt(0, 999);
        MutableDateTime result = new MutableDateTime(year, month, day, hour, minute, second, millis, newYork);

        String text = data.consumeAsciiString(20);
        int pos = data.consumeInt(0, Math.max(0, text.length() - 1));
        int[] expectedNums = extractFirstTwoNumbers(text);

        boolean parseSucceeded = true;
        try {
            f.parseInto(result, text, pos);
        } catch (IllegalFieldValueException e) {
            if (expectedNums[0] == 2 && expectedNums[1] == 29) {
                throw e; // bug case: valid input but exception thrown
            }
            parseSucceeded = false; // legitimate rejection
        } catch (IllegalArgumentException e) {
            parseSucceeded = false; // legitimate rejection
        }

        if (parseSucceeded && expectedNums[0] != -1) {
            if (result.getYear() != year ||
                result.getMonthOfYear() != expectedNums[0] ||
                result.getDayOfMonth() != expectedNums[1]) {
                throw new RuntimeException(
                    "metamorphic violation: parsed date differs from input");
            }
        }
    }

    private static int[] extractFirstTwoNumbers(String s) {
        int[] nums = new int[2];
        int i = 0;
        int len = s.length();

        // first number
        while (i < len && !Character.isDigit(s.charAt(i))) i++;
        int start = i;
        while (i < len && Character.isDigit(s.charAt(i))) i++;
        if (start == i) {
            nums[0] = -1;
        } else {
            nums[0] = Integer.parseInt(s.substring(start, i));
        }

        // second number
        while (i < len && !Character.isDigit(s.charAt(i))) i++;
        start = i;
        while (i < len && Character.isDigit(s.charAt(i))) i++;
        if (start == i) {
            nums[1] = -1;
        } else {
            nums[1] = Integer.parseInt(s.substring(start, i));
        }

        return nums;
    }
}

