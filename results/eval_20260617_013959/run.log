        boolean useNullArray = data.consumeBoolean();
        Object[] array = null;
        if (!useNullArray) {
            int len = data.consumeInt(0, 50);
            array = new Object[len];
            for (int i = 0; i < len; i++) {
                if (data.consumeBoolean()) {
                    array[i] = null;
                } else {
                    int choice = data.consumeInt(0, 2);
                    switch (choice) {
                        case 0:
                            array[i] = data.consumeString(10);
                            break;
                        case 1:
                            array[i] = Integer.valueOf(data.consumeInt());
                            break;
                        case 2:
                            array[i] = Long.valueOf(data.consumeInt());
                            break;
                        default:
                            array[i] = null;
                    }
                }
            }
        }

        char separatorChar = (char) data.consumeInt(0, 127);
        String separatorStr = data.consumeString(10);

        // Trigger the bug path with a null array and the subarray join method
        StringUtils.join((Object[]) null, separatorChar, 0, 1);

        // Normal operations with a generated array (if any)
        if (array != null) {
            int len = array.length;
            int startIdx = 0;
            int endIdx = 0;
            if (len > 0) {
                startIdx = data.consumeInt(0, len - 1);
                endIdx = data.consumeInt(startIdx, len);
            }

            // Call the subarray join method
            StringUtils.join(array, separatorChar, startIdx, endIdx);

            // Metamorphic consistency check for the char separator
            String fullChar = StringUtils.join(array, separatorChar, 0, len);
            String fullVar = StringUtils.join(array, separatorChar);
            if (!Objects.equals(fullChar, fullVar)) {
                throw new RuntimeException(
                    "metamorphic violation: join(array, separator) != join(array, separator, 0, array.length)");
            }

            // Metamorphic consistency check for the String separator
            String fullStr = StringUtils.join(array, separatorStr, 0, len);
            String fullVarStr = StringUtils.join(array, separatorStr);
            if (!Objects.equals(fullStr, fullVarStr)) {
                throw new RuntimeException(
                    "metamorphic violation: join(array, separator) != join(array, separator, 0, array.length)");
            }
        } else {
            // When array is null, both forms should yield null
            String nilChar1 = StringUtils.join((Object[]) null, separatorChar, 0, 0);
            String nilChar2 = StringUtils.join((Object[]) null, separatorChar);
            if (!Objects.equals(nilChar1, nilChar2)) {
                throw new RuntimeException("metamorphic violation on null array");
