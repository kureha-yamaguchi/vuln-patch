package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.regex.Pattern;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor: input that triggers the bug on the buggy version
        String[] specialArray = new String[]{"null"};
        StringUtils.join(specialArray, '/', 0, 1);

        // Explore: generate varied inputs that still exercise the patched code
        int arrLen = data.consumeInt(1, 20);
        Object[] arr = new Object[arrLen];
        for (int i = 0; i < arrLen; i++) {
            if (data.consumeBoolean()) {
                arr[i] = data.consumeAsciiString(10);
            } else {
                if (data.consumeBoolean()) {
                    arr[i] = null;
                } else {
                    arr[i] = data.consumeInt();
                }
            }
        }

        char separator = (char) data.consumeByte();
        int startIndex = data.consumeInt(0, arrLen - 1);
        int endIndex = data.consumeInt(startIndex + 1, arrLen);

        // Call the target method
        StringUtils.join(arr, separator, startIndex, endIndex);

        // Metamorphic check: join with default indices vs split by separator
        if (arrLen > 0) {
            boolean skipMeta = false;
            for (Object obj : arr) {
                if (obj != null && String.valueOf(obj).indexOf(separator) >= 0) {
                    skipMeta = true;
                    break;
                }
            }
            if (!skipMeta) {
                String joined = StringUtils.join(arr, separator);
                String[] parts = joined.split(Pattern.quote(String.valueOf(separator)), -1);
                if (parts.length != arrLen) {
                    throw new RuntimeException("metamorphic violation: parts length differs");
                }
                for (int i = 0; i < arrLen; i++) {
                    Object obj = arr[i];
                    String part = parts[i];
                    if (obj == null) {
                        if (!part.equals("")) {
                            throw new RuntimeException("metamorphic violation: unexpected part for null at index " + i);
                        }
                    } else {
                        String expected = String.valueOf(obj);
                        if (!expected.equals(part)) {
                            throw new RuntimeException("metamorphic violation: mismatch at index " + i);
                        }
                    }
                }
            }
        }
    }
}

