/* Fuzz harness for JFreeChart TimeSeries createCopy bug test */
package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.jfree.data.time.Day;
import org.jfree.data.time.RegularTimePeriod;
import org.jfree.data.time.TimeSeries;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Build a small random time series
        TimeSeries series = new TimeSeries("S");
        int itemCount = data.consumeInt(1, 5); // at least one data point
        for (int i = 0; i < itemCount; i++) {
            int year = data.consumeInt(1900, 2199);
            int month = data.consumeInt(1, 12);
            int day = data.consumeInt(1, 28); // safe range
            Day period = new Day(day, month, year);
            series.add(period, 1.0);
        }

        // Random start and end periods for createCopy
        int yearStart = data.consumeInt(1900, 2199);
        int monthStart = data.consumeInt(1, 12);
        int dayStart = data.consumeInt(1, 28);
        Day start = new Day(dayStart, monthStart, yearStart);

        int yearEnd = data.consumeInt(1900, 2199);
        int monthEnd = data.consumeInt(1, 12);
        int dayEnd = data.consumeInt(1, 28);
        Day end = new Day(dayEnd, monthEnd, yearEnd);

        // If start is after end, an IllegalArgumentException is expected and should be ignored
        if (isAfter(start, end)) {
            try {
                series.createCopy(start, end);
            } catch (CloneNotSupportedException ignored) {
            }
            return; // normal termination for invalid range
        }

        try {
            TimeSeries copy = series.createCopy(start, end);

            // Metamorphic check: number of items in the copy must equal the number of items
            // in the original series that lie between start and end inclusive.
            int expected = 0;
            for (int i = 0; i < series.getItemCount(); i++) {
                RegularTimePeriod p = series.getTimePeriod(i);
                if (p.getFirstMillisecond() >= start.getFirstMillisecond()
                        && p.getFirstMillisecond() <= end.getLastMillisecond()) {
                    expected++;
                }
            }
            if (expected != copy.getItemCount()) {
                throw new RuntimeException(
                        "metamorphic violation: expected count=" + expected
                        + ", got=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException ignored) {
            // Unlikely but ignore
        } catch (IllegalArgumentException e) {
            // Unexpected IllegalArgumentException for a valid range indicates a bug
            throw e;
        }
    }

    /** Returns true if {@code a} occurs after {@code b} chronologically. */
    private static boolean isAfter(Day a, Day b) {
        if (a.getYear() != b.getYear()) {
            return a.getYear() > b.getYear();
        }
        if (a.getMonth() != b.getMonth()) {
            return a.getMonth() > b.getMonth();
        }
        return a.getDay() > b.getDay();
    }
}

