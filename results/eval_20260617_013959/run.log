package org.apache.commons.lang3.text.translate;

import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: test known surrogate pair inputs that previously caused a crash
        StringEscapeUtils.escapeCsv("\uD83D\uDE30");
        StringEscapeUtils.escapeCsv("\uD800\uDC00");
        StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        // Explore: use fuzzed input that contains at least one surrogate pair
        int maxLen = Math.min(1000, data.remainingBytes());
        String input = data.consumeString(maxLen);
        if (!hasSurrogatePair(input)) {
            return; // no surrogate pair, skip further checks
        }

        // Run escape and unescape and check metamorphic relation
        String escaped = StringEscapeUtils.escapeCsv(input);
        String unescaped = StringEscapeUtils.unescapeCsv(escaped);
        if (!input.equals(unescaped)) {
            throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x for input: " + input);
        }
    }

    private static boolean hasSurrogatePair(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length() - 1; i++) {
            char ch = s.charAt(i);
            if (Character.isHighSurrogate(ch)) {
                char next = s.charAt(i + 1);
                if (Character.isLowSurrogate(next)) {
                    return true;
                }
            }
        }
        return false;
    }
}

