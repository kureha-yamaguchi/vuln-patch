package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.exception.DimensionMismatchException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        // Anchor call to trigger the bug on the buggy version
        double[] aAnchor = {1.23456789};
        double[] bAnchor = {98765432.1};
        MathArrays.linearCombination(aAnchor, bAnchor);

        // Generate arrays from fuzzed input
        int remaining = data.remainingBytes();
        if (remaining < 8) {
            return;
        }
        int maxLen = Math.max(1, remaining / 8);
        int len = data.consumeInt(1, maxLen);

        double[] a = new double[len];
        double[] b = new double[len];
        for (int i = 0; i < len; i++) {
            a[i] = (double) data.consumeInt();
            b[i] = (double) data.consumeInt();
        }

        double result;
        try {
            result = MathArrays.linearCombination(a, b);
        } catch (DimensionMismatchException e) {
            return;
        }

        double swappedResult;
        try {
            swappedResult = MathArrays.linearCombination(b, a);
        } catch (DimensionMismatchException e) {
            return;
        }

        if (Double.isNaN(result) && Double.isNaN(swappedResult)) {
            // ok, both NaN
        } else if (Double.isNaN(result) || Double.isNaN(swappedResult)) {
            throw new RuntimeException("metamorphic violation: dot product symmetry (NaN mismatch)");
        } else if (result != swappedResult) {
            throw new RuntimeException("metamorphic violation: dot product symmetry");
        }
    }
}

