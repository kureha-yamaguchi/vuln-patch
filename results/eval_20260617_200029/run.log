            int hour = data.consumeInt(0, 23); // Valid hours range from 0 to 23.
            int minute = data.consumeInt(0, 59); // Valid minutes range from 0 to 59.

            Partial partial = new Partial()
                    .with(DateTimeFieldType.hourOfDay(), hour)
                    .with(DateTimeFieldType.minuteOfHour(), minute);

            // Fuzz a new value for the clockhourOfDay field.
            int clockHourOfDay = data.consumeInt(1, 24); // Valid clock hour range is 1 to 24.

            try {
                // Attempt to add a clockhourOfDay field with the fuzzed value.
                partial.with(DateTimeFieldType.clockhourOfDay(), clockHourOfDay);
            } catch (IllegalArgumentException ex) {
                // Expected behavior: IllegalArgumentException should be thrown.
            }

            // Check that the original hour and minute values remain unchanged.
            if (partial.get(DateTimeFieldType.hourOfDay()) != hour || partial.get(DateTimeFieldType.minuteOfHour()) != minute) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: hour or minute values were altered unexpectedly");
            }

            // Metamorphic check: ensure the Partial object remains idempotent after repeated construction.
            Partial reconstructedPartial = new Partial()
                    .with(DateTimeFieldType.hourOfDay(), partial.get(DateTimeFieldType.hourOfDay()))
                    .with(DateTimeFieldType.minuteOfHour(), partial.get(DateTimeFieldType.minuteOfHour()));

            if (!partial.equals(reconstructedPartial)) {
                throw new RuntimeException("metamorphic violation: reconstructed Partial does not match the original");
            }

        } catch (Exception e) {
            // Catch any unexpected exceptions and let Jazzer report them.
            throw new RuntimeException("Unexpected exception: " + e.getMessage(), e);
        }
    }
}
