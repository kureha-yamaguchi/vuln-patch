            if (actualValue != expectedValue) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: expected " + expectedValue + " but got " + actualValue);
            }
        } catch (IllegalArgumentException e) {
            // Expected behavior for invalid values, do nothing
        }

        // Metamorphic relation check: idempotence of partial.with()
        try {
            Partial onceModified = partial.with(fieldType, newValue);
            Partial twiceModified = onceModified.with(fieldType, newValue);
            if (!onceModified.equals(twiceModified)) {
                throw new RuntimeException("metamorphic violation: idempotence of Partial.with()");
