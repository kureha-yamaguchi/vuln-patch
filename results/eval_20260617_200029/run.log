package org.joda.time.field;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.Partial;
import org.joda.time.DateTimeFieldType;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Create a Partial object with predefined fields and values
        Partial test = new Partial()
                .with(DateTimeFieldType.hourOfDay(), 10)
                .with(DateTimeFieldType.minuteOfHour(), 20);

        // Fuzz a value for clockhourOfDay to test with
        int fuzzedValue = data.consumeInt(1, 24); // Valid range for clockhourOfDay

        try {
            // Attempt to modify the Partial object with the fuzzed value
            test.with(DateTimeFieldType.clockhourOfDay(), fuzzedValue);
        } catch (IllegalArgumentException ex) {
            // Expected behavior: do nothing, as this is the correct handling
        }

        // Check that the Partial object remains unchanged
        if (test.get(DateTimeFieldType.hourOfDay()) != 10 || test.get(DateTimeFieldType.minuteOfHour()) != 20) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow("semantic mismatch: Partial state was altered unexpectedly");
        }

        // Metamorphic check: Ensure the Partial object is immutable
        Partial modified = test.without(DateTimeFieldType.hourOfDay());
        if (modified.getFieldTypes().length != test.getFieldTypes().length - 1) {
            throw new RuntimeException("metamorphic violation: Partial object immutability failed");
        }
    }
}
