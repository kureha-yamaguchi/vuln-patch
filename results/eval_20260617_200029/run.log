        // Construct a Partial instance using known values
        Partial partial = new Partial()
                .with(DateTimeFieldType.hourOfDay(), 10)
                .with(DateTimeFieldType.minuteOfHour(), 20);

        int fieldTypeIndex = data.consumeInt(0, 1); // Select between hourOfDay (0) and minuteOfHour (1)
