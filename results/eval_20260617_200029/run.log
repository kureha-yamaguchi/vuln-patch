        }
    }

    private static Partial createHourMinPartial(int hour, int minute) {
        Partial partial = new Partial();
        partial = partial.with(DateTimeFieldType.hourOfDay(), hour);
        partial = partial.with(DateTimeFieldType.minuteOfHour(), minute);
        return partial;
    }
}
