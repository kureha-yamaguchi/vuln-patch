package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double anchorP = 0.9772498680518209;
            double anchorResult = anchor.inverseCumulativeProbability(anchorP);
            if (Math.abs(anchorResult - 2.0) > 1.0e-12) {
                throw new RuntimeException("anchor mismatch");
            }
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        double ctorMean = finiteDouble(data.consumeInt(), data.consumeBoolean());
        double ctorSd = signedMagnitude(data.consumeInt(), data.consumeBoolean());
        try {
            new NormalDistributionImpl(ctorMean, ctorSd);
        } catch (IllegalArgumentException expected) {
            return;
        }

        double mean = finiteDouble(data.consumeInt(), data.consumeBoolean());
        double sd = positiveScale(data.consumeInt());
        NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sd);
        } catch (IllegalArgumentException expected) {
            return;
        }

        int cases = 1 + data.consumeInt(1, 4);
        for (int i = 0; i < cases; i++) {
            int z = data.consumeInt(-8, 8);
            boolean forceAnchorLike = data.consumeBoolean();
            if (forceAnchorLike) {
                z = data.consumeBoolean() ? 2 : -2;
            }

            double x = mean + (sd * z);
            if (Double.isNaN(x) || Double.isInfinite(x)) {
                continue;
            }

            try {
                double p = normal.cumulativeProbability(x);
                if (Double.isNaN(p) || p < 0.0 || p > 1.0) {
                    continue;
                }

                double inv = normal.inverseCumulativeProbability(p);

                double tol = Math.max(1.0e-12, Math.abs(x) * 1.0e-9);
                if (Math.abs(inv - x) > tol) {
                    throw new RuntimeException("metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x)) != x");
                }

                double p2 = normal.cumulativeProbability(inv);
                if (Math.abs(p2 - p) > 1.0e-10) {
                    throw new RuntimeException("metamorphic violation: cumulativeProbability(inverseCumulativeProbability(p)) != p");
                }
            } catch (MathException e) {
                throw new RuntimeException(e);
            } catch (IllegalArgumentException expected) {
                return;
            }
        }
    }

    private static double finiteDouble(int raw, boolean negate) {
        double v = (raw & 0x7fffffff) / 1048576.0;
        return negate ? -v : v;
    }

    private static double signedMagnitude(int raw, boolean negate) {
        double v = (raw & 0x7fffffff) / 65536.0;
        return negate ? -v : v;
    }

    private static double positiveScale(int raw) {
        return ((raw & 0x7fffffff) % 1000000) / 100000.0 + 1.0e-6;
    }
}
