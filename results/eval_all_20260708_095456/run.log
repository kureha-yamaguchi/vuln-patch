        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n        ords[0] = data.consumeInt(0, 20000);\n        ords[1] = ords[0] + data.consumeInt(2, 40);\n        for (int i = 2; i < count; i++) {\n            ords[i] = ords[i - 1] + data.consumeInt(1, 40);\n        }\n        Arrays.sort(ords);\n\n        TimeSeries series = new TimeSeries(data.consumeString(20));\n        for (int i = 0; i < ords.length; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        Day gapStart = dayFromOrdinal(data.consumeInt(ords[0] + 1, ords[1] - 1));\n        Day gapEnd = dayFromOrdinal(data.consumeInt(\n                Math.max(ords[0] + 1, daysSince2000(gapStart)),\n                ords[1] - 1));\n\n        try {\n            series.getIndex(gapStart);\n            series.getIndex(gapEnd);\n\n            TimeSeries gapCopy = series.createCopy(gapStart, gapEnd);\n            assertEmptyCopy(series, gapCopy, \"gap createCopy(start,end)\");\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n            RegularTimePeriod startExisting = series.getTimePeriod(i);\n            RegularTimePeriod endExisting = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            if (byPeriod.getItemCount() != byIndex.getItemCount()) {\n                throw new RuntimeException(\"metamorphic violation: existing-period copy != index copy itemCount\");\n            }\n            for (int k = 0; k < byPeriod.getItemCount(); k++) {\n                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {\n                    throw new RuntimeException(\"metamorphic violation: existing-period copy != index copy timePeriod\");\n                }\n            }\n        } catch (IllegalArgumentException e) {\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        runAnchor();\n\n        int count = data.consumeInt(2, 10);\n        int[] ordinals = new int[count];\n        int filled = 0;\n        while (filled < count) {\n            int candidate = data.consumeInt(0, 365 * 40);\n            boolean seen = false;\n            for (int i = 0; i < filled; i++) {\n                if (ordinals[i] == candidate) {\n                    seen = true;\n                    break;\n                }\n            }\n            if (!seen) {\n                ordinals[filled++] = candidate;\n            }\n        }\n        sort(ordinals);\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < ordinals.length; i++) {\n            try {\n                series.add(dayFromOrdinal(ordinals[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        try {\n            series.getIndex(series.getTimePeriod(0));\n            series.getIndex(series.getTimePeriod(series.getItemCount() - 1));\n        } catch (IllegalArgumentException e) {\n            return;\n        }\n\n        int beforeFirst = ordinals[0] - 1;\n        if (beforeFirst >= 0) {\n            try {\n                TimeSeries emptyClone = series.createCopy(dayFromOrdinal(beforeFirst), dayFromOrdinal(beforeFirst));\n                if (emptyClone == null) {\n                    throw new RuntimeException(\"null empty-range copy\");\n                }\n            } catch (CloneNotSupportedException e) {\n                return;\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            }\n        }\n\n        int gapIndex = findGap(ordinals);\n        if (gapIndex != -1) {\n            int left = ordinals[gapIndex];\n            int right = ordinals[gapIndex + 1];\n\n            int startOrd1 = data.consumeInt(left + 1, right - 1);\n            int endOrd1 = data.consumeInt(startOrd1, right - 1);\n\n            Day start1 = dayFromOrdinal(startOrd1);\n            Day end1 = dayFromOrdinal(endOrd1);\n\n            try {\n                series.getIndex(start1);\n                series.getIndex(end1);\n                TimeSeries copy1 = series.createCopy(start1, end1);\n                if (copy1 == null) {\n                    throw new RuntimeException(\"null gap copy\");\n                }\n            } catch (CloneNotSupportedException e) {\n                return;\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            }\n\n            if (right - left >= 3) {\n                int startOrd2 = data.consumeInt(left + 1, right - 1);\n                int endOrd2 = data.consumeInt(startOrd2, right - 1);\n\n                Day start2 = dayFromOrdinal(startOrd2);\n                Day end2 = dayFromOrdinal(endOrd2);\n\n                try {\n                    TimeSeries copyA = series.createCopy(start1, end1);\n                    TimeSeries copyB = series.createCopy(start2, end2);\n                    if (copyA.getItemCount() != copyB.getItemCount()) {\n                        throw new RuntimeException(\"metamorphic violation: same-gap ranges produced different item counts\");\n                    }\n                    for (int i = 0; i < copyA.getItemCount(); i++) {\n                        if (!copyA.getTimePeriod(i).equals(copyB.getTimePeriod(i))) {\n                            throw new RuntimeException(\"metamorphic violation: same-gap ranges produced different periods\");\n                        }\n                    }\n                } catch (CloneNotSupportedException e) {\n                  