package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    private static final double ANCHOR_P = 0.9772498680518209d;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double anchorResult = anchor.inverseCumulativeProbability(ANCHOR_P);
            if (Math.abs(anchorResult - 2.0d) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(2)) != 2 for anchor");
            }
        } catch (MathException e) {
            throw new RuntimeException(e);
        } catch (IllegalArgumentException e) {
            return;
        }

        double mean = data.consumeInt(-1000000, 1000000);
        int scale = data.consumeInt(1, 1000000);
        double sd = scale;
        int direction = data.consumeBoolean() ? 1 : -1;
        int step = data.consumeInt(2, 32);

        try {
            NormalDistribution dist = new NormalDistributionImpl(mean, sd);
            double target = mean + (direction * step * sd);
            double p = dist.cumulativeProbability(target);

            if (Double.isNaN(p) || p <= 0.0d || p >= 1.0d) {
                return;
            }

            double inverse = dist.inverseCumulativeProbability(p);

            if (Double.isNaN(inverse) || Double.isInfinite(inverse)) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(x)) produced non-finite result");
            }

            double tolerance = Math.max(1.0e-12d, Math.abs(target) * 1.0e-9d);
            if (Math.abs(inverse - target) > tolerance) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(x)) != x");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }
    }
}
