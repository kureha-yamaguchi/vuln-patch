package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.distribution.BinomialDistribution;
import org.apache.commons.math3.distribution.FDistribution;
import org.apache.commons.math3.exception.MathIllegalArgumentException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorBinomial();
        runAnchorF();

        int selector = data.consumeInt(0, 2);
        if (selector == 0) {
            exploreBinomialSymmetric(data);
        } else if (selector == 1) {
            exploreFLargeEqualDof(data);
        } else {
            exploreBoth(data);
        }
    }

    private static void runAnchorBinomial() {
        BinomialDistribution dist = new BinomialDistribution(500000, 0.5);
        int p = dist.inverseCumulativeProbability(0.5);
        if (p != 250000) {
            throw new RuntimeException("metamorphic violation: symmetric binomial median at p=0.5");
        }
    }

    private static void runAnchorF() {
        FDistribution f = new FDistribution(200000, 200000);
        double result = f.inverseCumulativeProbability(0.01);
        if (!(result < 1.0) || Double.isNaN(result)) {
            throw new RuntimeException("metamorphic violation: equal-dof F inverse at prob<0.5 should be < 1");
        }
    }

    private static void exploreBoth(FuzzedDataProvider data) {
        exploreBinomialSymmetric(data);
        exploreFLargeEqualDof(data);
    }

    private static void exploreBinomialSymmetric(FuzzedDataProvider data) {
        int trials = data.consumeInt(1, 20000000);
        if (data.consumeBoolean()) {
            trials &= ~1;
            if (trials == 0) {
                trials = 2;
            }
        }

        double q;
        if (data.consumeBoolean()) {
            q = 0.5;
        } else {
            int tweak = data.consumeInt(-8, 8);
            q = 0.5 + tweak * Math.ulp(0.5);
            if (q <= 0.0) {
                q = Double.MIN_VALUE;
            } else if (q >= 1.0) {
                q = 1.0 - Math.ulp(1.0);
            }
        }

        try {
            BinomialDistribution dist = new BinomialDistribution(trials, 0.5);
            int icp = dist.inverseCumulativeProbability(q);

            if (q == 0.5 && (trials & 1) == 0) {
                int expected = trials / 2;
                if (icp != expected) {
                    throw new RuntimeException("metamorphic violation: symmetric binomial median at p=0.5");
                }
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }

    private static void exploreFLargeEqualDof(FuzzedDataProvider data) {
        int dof = data.consumeInt(1, 1000000);
        double prob;
        if (data.consumeBoolean()) {
            prob = 0.01;
        } else {
            int bucket = data.consumeInt(1, 999999);
            prob = bucket / 1000000.0;
        }

        try {
            FDistribution f1 = new FDistribution(dof, dof);
            double x = f1.inverseCumulativeProbability(prob);

            if (dof > 0 && prob > 0.0 && prob < 1.0 && !Double.isNaN(x) && x > 0.0 && Double.isFinite(x)) {
                FDistribution f2 = new FDistribution(dof, dof);
                double y = f2.inverseCumulativeProbability(1.0 - prob);
                if (!Double.isNaN(y) && y > 0.0 && Double.isFinite(y)) {
                    double lhs = x;
                    double rhs = 1.0 / y;
                    double scale = Math.max(1.0, Math.max(Math.abs(lhs), Math.abs(rhs)));
                    if (Math.abs(lhs - rhs) > 1e-8 * scale) {
                        throw new RuntimeException("metamorphic violation: F inverse reciprocal symmetry for equal degrees of freedom");
                    }
                }
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }
