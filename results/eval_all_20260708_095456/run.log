package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new AssertionError("anchor parse failed");
        }

        exerciseRegressionSuite();

        requireUppercaseHexConsistency("0Xfade");
        requireUppercaseHexConsistency("-0Xfade");

        tryCreateNumber(data.consumeString(64));

        String uppercaseHex = buildUppercaseHexLiteral(data);
        requireUppercaseHexConsistency(uppercaseHex);

        String lowercaseHex = uppercaseHex.startsWith("-0X")
                ? "-0x" + uppercaseHex.substring(3)
                : "0x" + uppercaseHex.substring(2);

        metamorphicEquivalentHexPrefixes(uppercaseHex, lowercaseHex);

        tryCreateNumber(buildLongLiteral(data));
        tryCreateNumber(buildScientificLiteral(data));
        tryCreateNumber(buildFixedPointLiteral(data));
        tryCreateNumber(buildBigIntegerLiteral(data));
        tryCreateNumber(data.consumeRemainingAsString());
    }

    private static void exerciseRegressionSuite() {
        String[] literals = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "0Xfade",
                "-0xFADE",
                "-0Xfade",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                "-1l",
                "01l",
                "1l",
                "1eE"
        };
        for (int i = 0; i < literals.length; i++) {
            tryCreateNumber(literals[i]);
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException ignored) {
        }
    }

    private static void requireUppercaseHexConsistency(String s) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(s);
        } catch (NumberFormatException ignored) {
            tryCreateNumber(s);
            return;
        }

        Number actual;
        try {
            actual = NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
            throw new AssertionError("createNumber rejected valid uppercase hex accepted by createInteger: " + s, e);
        }

        if (actual == null) {
            throw new AssertionError("createNumber returned null for valid uppercase hex: " + s);
        }
        if (actual.intValue() != expected.intValue()) {
            throw new AssertionError("createNumber disagrees with createInteger for uppercase hex: " + s);
        }
    }

    private static void metamorphicEquivalentHexPrefixes(String upper, String lower) {
        Integer upperOracle;
        Integer lowerOracle;
        try {
            upperOracle = NumberUtils.createInteger(upper);
            lowerOracle = NumberUtils.createInteger(lower);
        } catch (NumberFormatException ignored) {
            tryCreateNumber(upper);
            tryCreateNumber(lower);
            return;
        }

        if (!upperOracle.equals(lowerOracle)) {
            throw new AssertionError("createInteger oracle mismatch for equivalent hex prefixes");
        }

        Number upperNumber;
        Number lowerNumber;
        try {
            upperNumber = NumberUtils.createNumber(upper);
            lowerNumber = NumberUtils.createNumber(lower);
        } catch (NumberFormatException e) {
            throw new AssertionError("metamorphic violation: equivalent 0X/0x hex inputs must both parse", e);
        }

        if (upperNumber == null || lowerNumber == null) {
            throw new AssertionError("metamorphic violation: equivalent 0X/0x hex inputs returned null");
        }
        if (!upperNumber.equals(lowerNumber)) {
            throw new AssertionError("metamorphic violation: 0X and 0x forms must be equivalent");
        }
    }

    private static String buildUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int bodyLen = data.consumeInt(1, 24);
        String seed = data.consumeAsciiString(bodyLen);
        String mixedHex = "0123456789abcdefABCDEF";
        String lastAlphabet = "abcdefABCDEF";
        StringBuilder body = new StringBuilder();

        for (int i = 0; i < bodyLen - 1; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('A' + (i % 6));
            int idx = (c & 0x7fffffff) % mixedHex.length();
            body.append(mixedHex.charAt(idx));
        }
        body.append(lastAlphabet.charAt(data.consumeInt(0, lastAlphabet.length() - 1)));

        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            digits.append('0');
        }
        digits.append(body);

        return (negative ? "-0X" : "0X") + digits.toString();
    }

    private static String buildLongLiteral(FuzzedDataProvider data) {
        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        long value = hi ^ lo;
        return Long.toString(value) + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        String mantissa = Integer.toString(data.consumeInt());
        String fraction = Integer.toString(Math.abs(data.consumeInt()));
        int exp = data.consumeInt(-400, 400);
        char e = data.consumeBoolean() ? 'E' : 'e';
        String suffix = "";
        int pick = data.consumeInt(0, 4);
        if (pick == 1) {
            suffix = "F";
        } else if (pick == 2) {
            suffix = "f";
        } else if (pick == 3) {
            suffix = "D";
        } else if (pick == 4) {
            suffix = "d";
        }
        return mantissa + "." + fraction + e + exp + suffix;
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        String left = Integer.toString(data.consumeInt());
        String right = Integer.toString(Math.abs(data.consumeInt()));
        if (right.length() == 0) {
            right = "0";
        }
        String base = data.consumeBoolean() ? (left + ".") : (left + "." + right);
        int suffixSelector = data.consumeInt(0, 4);
        switch (suffixSelector) {
            case 1:
                return base + "F";
            case 2:
                return base + "f";
            case 3:
                return base + "D";
            case 4:
                return base + "d";
            default:
                return base;
        }
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 40);
        String seed = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        for (int i = 0; i < len; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + (i % 10));
            sb.append((char) ('0' + ((c & 0x7fffffff) % 10)));
        }
        if (sb.length() == 1 && sb.charAt(0) == '-') {
            sb.append('0');
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }
}
