    private static double[] makeRealVector(FuzzedDataProvider data, int len) {
        double[] out = new double[len];
        for (int i = 0; i < len; i++) {
            out[i] = data.consumeInt(-10, 10);
        }
        return out;
    }

    private static BigMatrixImpl identityBig(int n) {
        BigDecimal[][] id = new BigDecimal[n][n];
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {
                id[r][c] = (r == c) ? BigDecimal.ONE : BigDecimal.ZERO;
            }
        }
        return new BigMatrixImpl(id, false);
    }

    private static RealMatrixImpl identityReal(int n) {
        double[][] id = new double[n][n];
        for (int r = 0; r < n; r++) {
            id[r][r] = 1.0d;
        }
        return new RealMatrixImpl(id, false);
    }
