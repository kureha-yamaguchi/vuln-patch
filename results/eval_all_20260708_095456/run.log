package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        try {
            Integer expected = NumberUtils.createInteger("0Xfade");
            Number actual = NumberUtils.createNumber("0Xfade");
            if (actual == null || actual.intValue() != expected.intValue()) {
                throw new RuntimeException("uppercase hex anchor mismatch");
            }
        } catch (NumberFormatException e) {
            throw new RuntimeException("createNumber rejected valid uppercase hex anchor", e);
        }

        String[] regressionLiterals = new String[] {
            "12345",
            "1234.5D",
            "1234.5d",
            "1234.5F",
            "1234.5f",
            "12345L",
            "12345l",
            "-1234.5",
            "-12345",
            "0xFADE",
            "-0xFADE",
            "-0Xfade",
            "1.1E200",
            "1.1E20",
            "-1.1E200",
            "1.1E-200",
            "12345678901234567890L",
            "1.1E-700F",
            "2.",
            "-1l",
            "01l",
            "1l",
            "1eE"
        };
        for (int i = 0; i < regressionLiterals.length; i++) {
            try {
                NumberUtils.createNumber(regressionLiterals[i]);
            } catch (NumberFormatException ignored) {
            }
        }

        try {
            NumberUtils.createNumber(data.consumeString(64));
        } catch (NumberFormatException ignored) {
        }

        boolean negative = data.consumeBoolean();
        int digitsLen = data.consumeInt(1, 24);
        String seed = data.consumeAsciiString(digitsLen);
        String hexAlphabet = "0123456789abcdefABCDEF";
        String lastAlphabet = "abcdefABCDEF";
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < digitsLen - 1; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + (i % 10));
            digits.append(hexAlphabet.charAt((c & 0x7fffffff) % hexAlphabet.length()));
        }
        digits.append(lastAlphabet.charAt(data.consumeInt(0, lastAlphabet.length() - 1)));

        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder fullDigits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            fullDigits.append('0');
        }
        fullDigits.append(digits);

        String upperHex = (negative ? "-0X" : "0X") + fullDigits.toString();
        String lowerHex = (negative ? "-0x" : "0x") + fullDigits.toString();

        Integer expectedUpper;
        Integer expectedLower;
        try {
            expectedUpper = NumberUtils.createInteger(upperHex);
            expectedLower = NumberUtils.createInteger(lowerHex);
        } catch (NumberFormatException ignored) {
            expectedUpper = null;
            expectedLower = null;
        }

        if (expectedUpper != null && expectedLower != null) {
            if (!expectedUpper.equals(expectedLower)) {
                throw new RuntimeException("metamorphic violation: createInteger x/X equivalence");
            }

            Number actualUpper;
            try {
                actualUpper = NumberUtils.createNumber(upperHex);
            } catch (NumberFormatException e) {
                throw new RuntimeException("createNumber rejected valid uppercase hex input: " + upperHex, e);
            }

            if (actualUpper == null || actualUpper.intValue() != expectedUpper.intValue()) {
                throw new RuntimeException("createNumber disagrees with createInteger for uppercase hex");
            }

            try {
                Number actualLower = NumberUtils.createNumber(lowerHex);
                if (actualLower == null || actualUpper.intValue() != actualLower.intValue()) {
                    throw new RuntimeException("metamorphic violation: 0x and 0X forms must be equivalent");
                }
            } catch (NumberFormatException ignored) {
            }
