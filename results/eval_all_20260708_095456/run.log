    private static void runAnchor() {
        LinearObjectiveFunction f = new LinearObjectiveFunction(
                new double[] { 10.0, -57.0, -9.0, -24.0 }, 0.0);

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(
                new double[] { 0.5, -5.5, -2.5, 9.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(
                new double[] { 0.5, -1.5, -0.5, 1.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(
                new double[] { 1.0, 0.0, 0.0, 0.0 }, Relationship.LEQ, 1.0));

        solve(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static LinearObjectiveFunction buildBealeObjective(int scale, double j0, double j1, double j2, double j3) {
        return new LinearObjectiveFunction(
                new double[] {
                        scale * (10.0 + j0),
                        scale * (-57.0 + j1),
                        scale * (-9.0 + j2),
                        scale * (-24.0 + j3)
                },
                0.0);
    }

    private static List<LinearConstraint> buildBealeConstraints(int s1, int s2, int s3, boolean dup1, boolean dup2) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        LinearConstraint c1 = new LinearConstraint(
                new double[] { 0.5 * s1, -5.5 * s1, -2.5 * s1, 9.0 * s1 }, Relationship.LEQ, 0.0);
        LinearConstraint c2 = new LinearConstraint(
                new double[] { 0.5 * s2, -1.5 * s2, -0.5 * s2, 1.0 * s2 }, Relationship.LEQ, 0.0);
        LinearConstraint c3 = new LinearConstraint(
                new double[] { 1.0 * s3, 0.0, 0.0, 0.0 }, Relationship.LEQ, 1.0 * s3);
        constraints.add(c1);
        constraints.add(c2);
        constraints.add(c3);
        if (dup1) {
            constraints.add(c1);
        }
        if (dup2) {
            constraints.add(c2);
        }
        return constraints;
    }

    private static double jitter(FuzzedDataProvider data) {
        return ((double) data.consumeInt(-2, 2)) / 10.0;
    }

    private static PointValuePair solve(LinearObjectiveFunction f,
                                        Collection<LinearConstraint> constraints,
                                        GoalType goal,
                                        boolean nonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver();
            return solver.optimize(f, constraints, goal, nonNegative);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        }
    }
}
