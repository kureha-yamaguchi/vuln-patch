    private static LinearObjectiveFunction buildObjective(FuzzedDataProvider data, int vars) {
        double[] coeff = new double[vars];
        coeff[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            coeff[i] = data.consumeInt(-3, 3);
        }
        return new LinearObjectiveFunction(coeff, data.consumeInt(-2, 2));
    }

    private static ArrayList<LinearConstraint> buildCycleLikeConstraints(FuzzedDataProvider data, int vars, int rows) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] a = new double[vars];
        a[0] = 1.0;
        if (vars > 1) {
            a[1] = Math.max(0, data.consumeInt(0, 5));
        }
        constraints.add(new LinearConstraint(a, data.consumeBoolean() ? Relationship.EQ : Relationship.GEQ, 0.0));

        double[] b = new double[vars];
        b[0] = 1.0;
        if (vars > 1) {
            b[1] = 1.0 + data.consumeInt(0, 5);
        }
        if (vars > 2) {
            b[2] = Math.max(0, data.consumeInt(0, 5));
        }
        constraints.add(new LinearConstraint(b, Relationship.GEQ, 0.0));

        for (int r = 2; r < rows; r++) {
            double[] c = new double[vars];
            c[0] = 1.0 + data.consumeInt(0, 3);
            for (int i = 1; i < vars; i++) {
                c[i] = data.consumeInt(-5, 5);
            }

            Relationship rel;
            int pick = data.consumeInt(0, 2);
            if (pick == 0) {
                rel = Relationship.GEQ;
            } else if (pick == 1) {
                rel = Relationship.EQ;
            } else {
                rel = Relationship.LEQ;
            }

            double rhs;
            if (r % 3 == 0) {
                rhs = 0.0;
            } else {
                rhs = data.consumeInt(-4, 6);
            }
            constraints.add(new LinearConstraint(c, rel, rhs));
        }

        return constraints;
    }

    private static void exerciseRealPaths(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver();

        try {
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, nonNegative, 1.0e-6, 10);

            int h = tableau.getHeight();
            int w = tableau.getWidth();
            int nObj = tableau.getNumObjectiveFunctions();
            int nArt = tableau.getNumArtificialVariables();
            int artOffset = tableau.getArtificialVariableOffset();

            if (h > 0 && w > 0) {
                tableau.getEntry(0, 0);
                tableau.getEntry(h - 1, w - 1);
            }
            if (nArt > 0) {
                int col = artOffset;
                if (col >= 0 && col < w) {
                    tableau.getBasicRow(col);
                }
            }
            if (nObj < h && w > 1) {
                try {
                    solver.doIteration(tableau);
                } catch (UnboundedSolutionException e) {
                    return;
                }
            }
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return;
        } catch (UnboundedSolutionException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathIllegalStateException e) {
            if (e instanceof MaxCountExceededException) {
                throw (MaxCountExceededException) e;
            }
            return;
        }

        solveExpectedly(f, constraints, nonNegative);
    }

    private static PointValuePair solveExpectedly(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean nonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver();
            return solver.optimize(f, constraints, GoalType.MAXIMIZE, nonNegative);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        } catch (MathIllegalStateException e) {
            if (e instanceof MaxCountExceededException) {
                throw (MaxCountExceededException) e;
            }
            return null;
        }
    }

    private static LinearObjectiveFunction augmentObjectiveWithZero(LinearObjectiveFunction f) {
        double[] src = f.getCoefficients().toArray();
        double[] dst = new double[src.length + 1];
        System.arraycopy(src, 0, dst, 0, src.length);
        dst[src.length] = 0.0;
        return new LinearObjectiveFunction(dst, f.getConstantTerm());
    }

    private static ArrayList<LinearConstraint> augmentConstraintsWithZero(List<LinearConstraint> constraints) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(constraints.size());
        for (LinearConstraint c : constraints) {
            double[] src = c.getCoefficients().toArray();
            double[] dst = new double[src.length + 1];
            System.arraycopy(src, 0, dst, 0, src.length);
            dst[src.length] = 0.0;
            out.add(new LinearConstraint(dst, c.getRelationship(), c.getValue()));
        }
        return out;
    }
}
