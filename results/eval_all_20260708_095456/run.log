        String prefix = data.consumeString(32);
        int width = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xff);
        boolean useNullObject = data.consumeBoolean();

        Object obj;
        String nullText = null;

        if (useNullObject) {
            String baseNullText = data.consumeString(64);
            nullText = ensureLongerThanWidth(baseNullText, width, padChar == 0 ? 'N' : padChar);
            obj = null;
        } else {
            String baseObj = data.consumeString(64);
            obj = ensureLongerThanWidth(baseObj, width, padChar == 0 ? 'O' : padChar);
            if (data.consumeBoolean()) {
                nullText = data.consumeString(16);
            }
        }

        runCase(initialCapacity, prefix, obj, nullText, width, padChar);

        int alternateCapacity = data.consumeInt(0, 32);
        String left = runCase(initialCapacity, prefix, obj, nullText, width, padChar);
        String right = runCase(alternateCapacity, prefix, obj, nullText, width, padChar);
        if (!left.equals(right)) {
            throw new RuntimeException("metamorphic violation: result depends on initial capacity");
        }
    }

    private static String runCase(int initialCapacity, String prefix, Object obj, String nullText, int width, char padChar) {
        StrBuilder sb = new StrBuilder(initialCapacity);
        if (nullText != null) {
            sb.setNullText(nullText);
        }
        sb.append(prefix);
        sb.appendFixedWidthPadRight(obj, width, padChar);
        return sb.toString();
    }

    private static String ensureLongerThanWidth(String s, int width, char fill) {
        if (s == null) {
            s = "";
        }
        if (s.length() > width) {
            return s;
        }
        StringBuilder builder = new StringBuilder(s);
        char c = fill == 0 ? 'X' : fill;
        while (builder.length() <= width) {
            builder.append(c);
        }
        return builder.toString();
    }
