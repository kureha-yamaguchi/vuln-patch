package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.lang.annotation.Annotation;

public class FuzzHarness {
    @Retention(RetentionPolicy.RUNTIME)
    private @interface HarnessAnno {
        String value();
    }

    @HarnessAnno("seed")
    private static class AnnotatedSeed {
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor1 = StringUtils.join((Object[]) null, '/');

        Object[] anchorArray = new Object[] { null };
        String anchor2 = StringUtils.join(anchorArray, '/', 0, 1);
        StringUtils.length(anchor1);
        StringUtils.length(anchor2);

        Annotation anno = AnnotatedSeed.class.getAnnotation(HarnessAnno.class);
        if (anno != null) {
            String annoString = AnnotationUtils.toString(anno);
            StringUtils.length(annoString);
            StringUtils.join(new Object[] { annoString, null, "x" }, '/', 0, 3);
            StringUtils.join(new Object[] { annoString, null, "x" }, "::", 0, 3);
        }

        int len = data.consumeInt(0, 16);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            int choice = data.consumeInt(0, 5);
            switch (choice) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(32);
                    break;
                case 2:
                    array[i] = data.consumeAsciiString(32);
                    break;
                case 3:
                    array[i] = ArrayUtils.toString(data.consumeBytes(8), null);
                    break;
                case 4:
                    array[i] = BooleanUtils.toString(
                            data.consumeBoolean() ? Boolean.TRUE : null,
                            data.consumeAsciiString(8),
                            data.consumeAsciiString(8),
                            null);
                    break;
                default:
                    if (anno != null) {
                        array[i] = AnnotationUtils.toString(anno);
                    } else {
                        array[i] = data.consumeString(16);
                    }
                    break;
            }
        }

        if (len > 0 && data.consumeBoolean()) {
            array[data.consumeInt(0, len - 1)] = null;
        }

        int start = data.consumeInt(0, len);
        int end = data.consumeInt(start, len);
        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString = data.consumeBoolean() ? null : String.valueOf(sepChar);

        try {
            String joinedChar = StringUtils.join(array, sepChar, start, end);
            String joinedString = StringUtils.join(array, sepString, start, end);

            StringUtils.length(joinedChar);
            StringUtils.length(joinedString);

            if (sepString != null && joinedChar != null && joinedString != null && !joinedChar.equals(joinedString)) {
                throw new RuntimeException("metamorphic violation: char separator vs one-char String separator");
            }
        } catch (NullPointerException | ArrayIndexOutOfBoundsException | NegativeArraySizeException | ArithmeticException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }
    }
}
