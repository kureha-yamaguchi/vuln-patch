public class FuzzHarness {
    private static final Map REGISTRY = new HashMap();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryPattern("it''s a {0,lower} 'test'!");

        String pre = clean(data.consumeAsciiString(24));
        String a = clean(data.consumeAsciiString(24));
        String b = clean(data.consumeAsciiString(24));
        String post = clean(data.consumeAsciiString(24));
        String tail = clean(data.consumeRemainingAsString());

        String formatPart;
        switch (data.consumeInt(0, 2)) {
            case 0:
                formatPart = "{0}";
                break;
            case 1:
                formatPart = "{0,number}";
                break;
            default:
                formatPart = "";
                break;
        }

        String pattern;
        switch (data.consumeInt(0, 5)) {
            case 0:
                pattern = pre + "''" + post + formatPart;
                break;
            case 1:
                pattern = pre + "'" + a + "'" + post + formatPart;
                break;
            case 2:
                pattern = pre + "'" + a + "''" + b + "'" + post + formatPart;
                break;
            case 3:
                pattern = "'" + pre + "''" + a + "'" + post + formatPart;
                break;
            case 4:
                pattern = pre + formatPart + " '" + a + "''" + b + "'";
                break;
            default:
                pattern = pre + "'" + post + tail;
                break;
        }

        ExtendedMessageFormat emf = tryPattern(pattern);
        if (emf != null) {
            String canonical = emf.toPattern();
            ExtendedMessageFormat reparsed = tryPattern(canonical);
            if (reparsed != null && !canonical.equals(reparsed.toPattern())) {
                throw new RuntimeException("metamorphic violation: toPattern reparsing is not idempotent");
            }
        }
    }

    private static ExtendedMessageFormat tryPattern(String pattern) {
        try {
            return new ExtendedMessageFormat(pattern, REGISTRY);
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    private static String clean(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer sb = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\'' || c == '{' || c == '}' || c == ',') {
                sb.append('a');
            } else if (c < 32 || c > 126) {
                sb.append('b');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }
}
