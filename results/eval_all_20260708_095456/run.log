        try {
            NumberUtils.createNumber(longLiteral);
        } catch (NumberFormatException ignored) {
        }

        String scientific = buildScientificLiteral(data);
        try {
            NumberUtils.createNumber(scientific);
        } catch (NumberFormatException ignored) {
        }

        String bigInt = buildBigIntegerLiteral(data);
        try {
            NumberUtils.createNumber(bigInt);
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(data.consumeRemainingAsString());
        } catch (NumberFormatException ignored) {
        }
    }

    private static void requireValidUppercaseHex(String s) {
        Number expected = NumberUtils.createInteger(s);
        Number actual = NumberUtils.createNumber(s);
        if (actual == null || !actual.equals(expected)) {
            throw new RuntimeException("createNumber disagrees with createInteger for valid uppercase hex: " + s);
        }
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int intDigits = data.consumeInt(1, 6);
        for (int i = 0; i < intDigits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracDigits = data.consumeInt(0, 6);
            for (int i = 0; i < fracDigits; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        sb.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        int expDigits = data.consumeInt(1, 4);
        for (int i = 0; i < expDigits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (data.consumeBoolean()) {
            sb.append("fFdD".charAt(data.consumeInt(0, 3)));
        }
        return sb.toString();
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int digits = data.consumeInt(1, 40);
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < digits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
