                return data.consumeAsciiString(8);
            case 1:
                return Integer.valueOf(data.consumeInt());
            case 2:
                return Double.valueOf((double) data.consumeInt());
            case 3:
                return Long.valueOf((long) data.consumeInt());
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            case 5:
                return data.consumeBytes(8);
            default:
                return new Object();
        }
    }
