package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.util.List;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.chart.util.Size2D;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            runAnchor(g2);
            runExplore(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchor(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);

        touchContainerState(container);
        safeArrange(container, g2, constraint);
    }

    private static void runExplore(FuzzedDataProvider data, Graphics2D g2) {
        double fixedWidth = positive(data.consumeInt(1, 500), 10.0);
        double excess = positive(data.consumeInt(1, 500), 10.0);
        double sideWidth = fixedWidth + excess;
        double sideHeight = positive(data.consumeInt(1, 1000), 10.0);

        double centerWidth = positive(data.consumeInt(0, 1000), 10.0);
        double centerHeight = positive(data.consumeInt(0, 1000), 10.0);
        double topWidth = positive(data.consumeInt(0, 1000), 10.0);
        double topHeight = positive(data.consumeInt(0, 1000), 10.0);
        double bottomWidth = positive(data.consumeInt(0, 1000), 10.0);
        double bottomHeight = positive(data.consumeInt(0, 1000), 10.0);

        boolean useRight = data.consumeBoolean();
        boolean useLeft = data.consumeBoolean();
        boolean useCenter = data.consumeBoolean();
        boolean useTop = data.consumeBoolean();
        boolean useBottom = data.consumeBoolean();

        if (!useRight && !useLeft) {
            useRight = true;
        }

        RectangleConstraint constraint = new RectangleConstraint(
                fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());
        if (useCenter) {
            container.add(new EmptyBlock(centerWidth, centerHeight));
        }
        if (useTop) {
            container.add(new EmptyBlock(topWidth, topHeight), RectangleEdge.TOP);
        }
        if (useBottom) {
            container.add(new EmptyBlock(bottomWidth, bottomHeight), RectangleEdge.BOTTOM);
        }
        if (useLeft) {
            container.add(new EmptyBlock(sideWidth, sideHeight), RectangleEdge.LEFT);
        }
        if (useRight) {
            container.add(new EmptyBlock(sideWidth, sideHeight), RectangleEdge.RIGHT);
        }

        touchContainerState(container);

        Size2D first = safeArrange(container, g2, constraint);
        if (first == null) {
            return;
        }

        Size2D second = safeArrange(container, g2, constraint);
        if (second == null) {
            return;
        }

        if (Double.doubleToLongBits(first.getWidth()) != Double.doubleToLongBits(second.getWidth())
                || Double.doubleToLongBits(first.getHeight()) != Double.doubleToLongBits(second.getHeight())) {
            throw new RuntimeException("metamorphic violation: repeated arrange should be idempotent");
        }
    }

    private static void touchContainerState(BlockContainer container) {
        List blocks = container.getBlocks();
        for (int i = 0; i < blocks.size(); i++) {
            Object o = blocks.get(i);
            if (o instanceof Block) {
                Block b = (Block) o;
                double w = b.getBounds().getWidth();
                if (w == 123456789.0) {
                    throw new RuntimeException("unreachable");
                }
                if (b instanceof AbstractBlock) {
                    double declaredWidth = ((AbstractBlock) b).getWidth();
                    if (declaredWidth == 987654321.0) {
                        throw new RuntimeException("unreachable");
                    }
                }
            }
        }
    }

    private static Size2D safeArrange(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
            return null;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof IllegalArgumentException) {
            String msg = t.getMessage();
            if (msg != null && msg.contains("require lower (0.0) <= upper")) {
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.jfree.chart.block.BorderArrangement".equals(ste.getClassName())
                            && ("arrangeFF".equals(ste.getMethodName()) || "arrangeFN".equals(ste.getMethodName()))) {
                        return true;
                    }
                }
            }
            return false;
        }

        if (t instanceof NullPointerException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof ArithmeticException) {
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.jfree.chart.block.BorderArrangement".equals(ste.getClassName())) {
                    return true;
                }
            }
        }

        return false;
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static double positive(int value, double scale) {
        return ((double) value) / scale;
    }
}
