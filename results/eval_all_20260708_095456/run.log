package org.apache.commons.math.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ConcurrentModificationException;
import org.apache.commons.math.linear.OpenMapRealVector;
import org.apache.commons.math.linear.RealVector;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int dimension = data.consumeInt(1, 32);
        double epsilon = 1e-6;

        OpenMapRealVector u = new OpenMapRealVector(dimension, epsilon);
        OpenMapRealVector v1 = new OpenMapRealVector(dimension, epsilon);
        double[] v2 = new double[dimension];

        boolean forcedZeroInU = false;
        boolean forcedZeroInV = false;
        boolean forcedNonZeroInU = false;
        boolean forcedNonZeroInV = false;

        for (int i = 0; i < dimension; i++) {
            boolean uZero = data.consumeBoolean();
            boolean vZero = data.consumeBoolean();

            double uVal = uZero ? 0.0 : smallFiniteValue(data.consumeInt());
            double vVal = vZero ? 0.0 : smallFiniteValue(data.consumeInt());

            u.setEntry(i, uVal);
            v1.setEntry(i, vVal);
            v2[i] = vVal;

            if (uVal == 0.0) {
                forcedZeroInU = true;
            } else {
                forcedNonZeroInU = true;
            }
            if (vVal == 0.0) {
                forcedZeroInV = true;
            } else {
                forcedNonZeroInV = true;
            }
        }

        if (!forcedZeroInU) {
            u.setEntry(0, 0.0);
        }
        if (!forcedZeroInV) {
            v1.setEntry(dimension - 1, 0.0);
            v2[dimension - 1] = 0.0;
        }
        if (!forcedNonZeroInU) {
            u.setEntry(0, 1.0);
            if (dimension > 1) {
                u.setEntry(1, 0.0);
            }
        }
        if (!forcedNonZeroInV) {
            v1.setEntry(0, 2.0);
            v2[0] = 2.0;
            if (dimension > 1) {
                v1.setEntry(1, 0.0);
                v2[1] = 0.0;
            }
        }

        try {
            RealVector w1 = u.ebeMultiply(v1);
            RealVector w2 = u.ebeMultiply(v2);
            compareVectors(w1, w2, "multiply vector-vs-array");

            RealVector d1 = u.ebeDivide(v1);
            RealVector d2 = u.ebeDivide(v2);
            compareVectors(d1, d2, "divide vector-vs-array");

            OpenMapRealVector ones = new OpenMapRealVector(dimension, epsilon);
            double[] onesArray = new double[dimension];
            for (int i = 0; i < dimension; i++) {
                ones.setEntry(i, 1.0);
                onesArray[i] = 1.0;
            }

            RealVector m1 = u.ebeMultiply(ones);
            RealVector m2 = u.ebeMultiply(onesArray);
            compareVectors(m1, m2, "metamorphic equivalent inputs");
        } catch (ConcurrentModificationException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        } catch (ArrayIndexOutOfBoundsException e) {
            throw e;
        } catch (NullPointerException e) {
            throw e;
        } catch (ArithmeticException e) {
            throw e;
        }
    }

    private static void anchor() {
        final RealVector u = new OpenMapRealVector(3, 1e-6);
        u.setEntry(0, 1);
        u.setEntry(1, 0);
        u.setEntry(2, 2);

        final RealVector v1 = new OpenMapRealVector(3, 1e-6);
        final double[] v2 = new double[3];
        v1.setEntry(0, 0);
        v2[0] = 0;
        v1.setEntry(1, 3);
        v2[1] = 3;
        v1.setEntry(2, 0);
        v2[2] = 0;

        u.ebeMultiply(v1);
        u.ebeMultiply(v2);
        u.ebeDivide(v1);
        u.ebeDivide(v2);
    }

    private static double smallFiniteValue(int x) {
        int v = x % 11;
        if (v == 0) {
            return 1.0;
        }
        return (double) v;
    }

    private static void compareVectors(RealVector a, RealVector b, String relation) {
        int dim = a.getDimension();
        if (dim != b.getDimension()) {
            throw new RuntimeException("metamorphic violation: " + relation);
        }
        for (int i = 0; i < dim; i++) {
            double x = a.getEntry(i);
            double y = b.getEntry(i);
            if (Double.doubleToLongBits(x) != Double.doubleToLongBits(y)) {
                throw new RuntimeException("metamorphic violation: " + relation);
            }
        }
    }
}
