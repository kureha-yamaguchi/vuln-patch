package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        ClassUtils.toClass(null);
        ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });

        int length = data.consumeInt(0, 32);
        Object[] array = new Object[length];
        for (int i = 0; i < length; i++) {
            switch (data.consumeInt(0, 7)) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(64);
                    break;
                case 2:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    array[i] = Double.valueOf(data.consumeInt());
                    break;
                case 4:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 5:
                    array[i] = data.consumeBytes(data.consumeInt(0, 16));
                    break;
                case 6:
                    array[i] = new Object[] { data.consumeString(16), data.consumeBoolean() ? null : Integer.valueOf(data.consumeInt()) };
                    break;
                default:
                    array[i] = data.consumeAsciiString(32);
                    break;
            }
        }

        ClassUtils.toClass(array);

        int split = data.consumeInt(0, array.length);
        Object[] left = ArrayUtils.subarray(array, 0, split);
        Object[] right = ArrayUtils.subarray(array, split, array.length);

        Class<?>[] whole = ClassUtils.toClass(ArrayUtils.addAll(left, right));
        Class<?>[] parts = ArrayUtils.addAll(ClassUtils.toClass(left), ClassUtils.toClass(right));
        if (!Arrays.equals(whole, parts)) {
            throw new RuntimeException("metamorphic violation: composition");
        }
    }
}
