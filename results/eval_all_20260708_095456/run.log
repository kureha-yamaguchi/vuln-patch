    private static GeneratedProblem generateProblem(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 10);
        int constraintsCount = data.consumeInt(2, 12);
        int pivotCol = data.consumeInt(0, vars - 1);

        double[] objective = new double[vars];
        objective[pivotCol] = data.consumeBoolean() ? 1.0 : -1.0;
        for (int i = 0; i < vars; i++) {
            if (i == pivotCol) {
                continue;
            }
            objective[i] = smallNumber(data.consumeInt(-3, 3));
        }

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] tieA = new double[vars];
        double[] tieB = new double[vars];
        tieA[pivotCol] = 1.0;
        tieB[pivotCol] = 1.0;
        for (int i = 0; i < vars; i++) {
            if (i == pivotCol) {
                continue;
            }
            tieA[i] = smallNumber(data.consumeInt(-4, 4));
            tieB[i] = smallNumber(data.consumeInt(-4, 4));
        }

        Relationship tieRel = data.consumeBoolean() ? Relationship.GEQ : Relationship.EQ;
        constraints.add(new LinearConstraint(tieA, tieRel, 0.0));
        constraints.add(new LinearConstraint(tieB, tieRel, 0.0));

        for (int c = 2; c < constraintsCount; c++) {
            double[] coeffs = new double[vars];
            for (int i = 0; i < vars; i++) {
                coeffs[i] = smallNumber(data.consumeInt(-8, 8));
            }

            if (data.consumeBoolean()) {
                coeffs[pivotCol] = Math.abs(coeffs[pivotCol]) + 1.0;
            }

            Relationship rel;
            int relPick = data.consumeInt(0, 2);
            if (relPick == 0) {
                rel = Relationship.GEQ;
            } else if (relPick == 1) {
                rel = Relationship.EQ;
            } else {
                rel = Relationship.LEQ;
            }

            double rhs;
            if (data.consumeBoolean()) {
                rhs = 0.0;
            } else {
