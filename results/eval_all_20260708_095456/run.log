        } catch (NotStrictlyPositiveException e) {
            return;
        }

        // EXPLORE: many valid distributions with the same incompatible-runtime-type property.
        int exploreIters = 1 + data.consumeInt(0, 8);
        for (int iter = 0; iter < exploreIters; iter++) {
