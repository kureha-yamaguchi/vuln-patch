        double sharedEntry = positiveSmallInt(data);
        double sharedRhs = positiveSmallInt(data);

        for (int r = 0; r < constraintsCount; r++) {
            double[] coeff = new double[vars];
            for (int c = 0; c < vars; c++) {
                coeff[c] = smallInt(data);
            }

            if (r < 2) {
                coeff[0] = sharedEntry;
            } else if (data.consumeBoolean()) {
                coeff[0] = sharedEntry;
            }

            Relationship rel;
            int pick = data.consumeInt(0, 2);
            if (pick == 0) {
                rel = Relationship.GEQ;
            } else if (pick == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }

            double rhs = (r < 2 || data.consumeBoolean()) ? sharedRhs : smallInt(data);
            constraints.add(new LinearConstraint(coeff, rel, rhs));
        }

        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, constant);

        try {
            SimplexTableau tableau = new SimplexTableau(f, constraints, goal, restrictToNonNegative, 1.0e-6, 10);
            int h = tableau.getHeight();
            int w = tableau.getWidth();
            int nObj = tableau.getNumObjectiveFunctions();
            int nArt = tableau.getNumArtificialVariables();
            int artOff = tableau.getArtificialVariableOffset();

            if (h > 0 && w > 0) {
                double acc = 0.0;
                for (int r = 0; r < h; r++) {
