            double totalWidth = totalWidthTenth / 10.0;

            int leftWidthTenth = data.consumeInt(totalWidthTenth + 1, totalWidthTenth + 300);
            double leftWidth = leftWidthTenth / 10.0;
            double leftHeight = positive(data.consumeInt(-500, 1000) / 10.0);

            double rightWidth = positive(data.consumeInt(-500, 1000) / 10.0);
            double rightHeight = positive(data.consumeInt(-500, 1000) / 10.0);

            boolean addCenter = data.consumeBoolean();
            boolean addTop = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();

            double centerWidth = positive(data.consumeInt(-500, 1000) / 10.0);
            double centerHeight = positive(data.consumeInt(-500, 1000) / 10.0);
            double topWidth = positive(data.consumeInt(-500, 1000) / 10.0);
            double topHeight = positive(data.consumeInt(-500, 1000) / 10.0);
            double bottomWidth = positive(data.consumeInt(-500, 1000) / 10.0);
            double bottomHeight = positive(data.consumeInt(-500, 1000) / 10.0);

            BlockContainer container = new BlockContainer(new BorderArrangement());
            EmptyBlock left = new EmptyBlock(leftWidth, leftHeight);
            EmptyBlock right = new EmptyBlock(rightWidth, rightHeight);
            container.add(left, RectangleEdge.LEFT);
            container.add(right, RectangleEdge.RIGHT);
            if (addCenter) {
                container.add(new EmptyBlock(centerWidth, centerHeight));
            }
            if (addTop) {
                container.add(new EmptyBlock(topWidth, topHeight), RectangleEdge.TOP);
            }
            if (addBottom) {
                container.add(new EmptyBlock(bottomWidth, bottomHeight), RectangleEdge.BOTTOM);
            }

            if (container.getBlocks().isEmpty()) {
                return;
            }
            if (left.getWidth() <= totalWidth) {
                return;
            }

            RectangleConstraint constraint = new RectangleConstraint(
                    totalWidth, new Range(totalWidth, totalWidth), LengthConstraintType.FIXED,
                    0.0, new Range(0.0, 0.0), LengthConstraintType.NONE);

            Size2D s1 = arrangeOrSwallow(container, g2, constraint);
            if (s1 != null) {
                Size2D s2 = arrangeOrSwallow(container, g2, constraint);
                if (s2 != null) {
                    if (Double.compare(s1.getWidth(), s2.getWidth()) != 0
                            || Double.compare(s1.getHeight(), s2.getHeight()) != 0) {
                        throw new RuntimeException("metamorphic violation: repeated arrange changed size");
                    }
                }
            }
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchorInputs(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE);

        BlockContainer container = new BlockContainer(new BorderArrangement());

        container.add(new EmptyBlock(5.0, 6.0));
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(15.0, 16.0));
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.LEFT);
        container.add(new EmptyBlock(1.0, 1.0), RectangleEdge.RIGHT);
        arrangeOrSwallow(container, g2, constraint);
    }

    private static Size2D arrangeOrSwallow(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return null;
        } catch (RuntimeException e) {
            if (isBenign(e)) {
                return null;
            }
            throw e;
        }
    }

    private static boolean isRootCause(IllegalArgumentException e) {
        String msg = e.getMessage();
        return msg != null && msg.indexOf("Range(double, double): require lower") >= 0;
    }

    private static boolean isBenign(RuntimeException e) {
        String msg = e.getMessage();
        if (msg == null) {
            return false;
        }
        return msg.indexOf("Null") >= 0 && msg.indexOf("argument") >= 0;
    }

    private static double positive(double v) {
        if (Double.isNaN(v) || Double.isInfinite(v)) {
            return 0.0;
        }
        return v < 0.0 ? -v : v;
    }
}
