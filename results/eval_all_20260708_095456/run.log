    private static PointValuePair solve(LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        try {
            SimplexSolver solver = new SimplexSolver();
            return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        } catch (MathIllegalStateException e) {
            return null;
        }
    }

    private static boolean sameSolution(PointValuePair a, PointValuePair b) {
        if (Math.abs(a.getValue() - b.getValue()) > 1.0e-8) {
            return false;
        }
        double[] pa = a.getPoint();
        double[] pb = b.getPoint();
        if (pa == null || pb == null || pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (Math.abs(pa[i] - pb[i]) > 1.0e-8) {
                return false;
            }
        }
        return true;
    }
