package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact verified trigger from the failing test.
        StrBuilder anchor = new StrBuilder(1);
        anchor.appendFixedWidthPadRight("foo", 1, '-');
        if (!"f".equals(anchor.toString())) {
            throw new RuntimeException("metamorphic violation: anchor output mismatch");
        }

        String prefix = data.consumeString(32);
        int width = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xff);

        String base = data.consumeString(64);
        int extra = data.consumeInt(1, 16);
        StringBuilder sb = new StringBuilder(base == null ? "" : base);
        while (sb.length() <= width) {
            sb.append('X');
        }
        for (int i = 0; i < extra; i++) {
            sb.append((char) ('a' + (i % 26)));
        }
        String longValue = sb.toString();

        try {
            runObjectCase(prefix, longValue, width, padChar);
            runNullTextCase(prefix, longValue, width, padChar);
            runMetamorphic(prefix, longValue, width, padChar);
        } catch (StringIndexOutOfBoundsException e) {
            throw e;
        } catch (ArrayIndexOutOfBoundsException e) {
            throw e;
        } catch (NegativeArraySizeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }
    }

    private static void runObjectCase(String prefix, String value, int width, char padChar) {
        int capacity = prefix.length() + width;
        StrBuilder out = new StrBuilder(capacity);
        out.append(prefix);
        out.appendFixedWidthPadRight(value, width, padChar);
    }

    private static void runNullTextCase(String prefix, String nullText, int width, char padChar) {
        int capacity = prefix.length() + width;
        StrBuilder out = new StrBuilder(capacity);
        out.setNullText(nullText);
        out.append(prefix);
        out.appendFixedWidthPadRight(null, width, padChar);
    }

    private static void runMetamorphic(String prefix, String value, int width, char padChar) {
        if (width <= 0 || value == null || value.length() < width) {
            return;
        }

        int capacity = prefix.length() + width;

        StrBuilder a = new StrBuilder(capacity);
        a.append(prefix);
        a.appendFixedWidthPadRight(value, width, padChar);

        StrBuilder b = new StrBuilder(capacity);
        b.append(prefix);
        b.appendFixedWidthPadRight(value.substring(0, width), width, padChar);

        String sa = a.toString();
        String sb = b.toString();
        if (!sa.equals(sb)) {
            throw new RuntimeException("metamorphic violation: truncating input to width changed appendFixedWidthPadRight result");
        }
    }
}
