package org.apache.commons.math3.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathArithmeticException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.NotStrictlyPositiveException;
import org.apache.commons.math3.util.Pair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            List<Pair<Object, Double>> anchor = new ArrayList<Pair<Object, Double>>();
            anchor.add(new Pair<Object, Double>("seed", Double.valueOf(0.0)));
            anchor.add(new Pair<Object, Double>(Integer.valueOf(1), Double.valueOf(1.0)));
            new DiscreteDistribution<Object>(anchor).sample(1);
        } catch (MathArithmeticException | MathIllegalArgumentException | NotStrictlyPositiveException expected) {
            return;
        }

        try {
            int variantA = data.consumeInt(0, 5);
            int variantB = data.consumeInt(0, 5);
            if (variantB == variantA) {
                variantB = (variantB + 1) % 6;
            }

            Object first;
            switch (variantA) {
                case 0:
                    first = data.consumeAsciiString(16);
                    break;
                case 1:
                    first = Integer.valueOf(data.consumeInt());
                    break;
                case 2:
                    first = Double.valueOf((double) data.consumeInt());
                    break;
                case 3:
                    first = Long.valueOf((long) data.consumeInt());
                    break;
                case 4:
                    first = data.consumeBytes(8);
                    break;
                default:
                    first = Boolean.valueOf(data.consumeBoolean());
                    break;
            }

            Object chosen;
            switch (variantB) {
                case 0:
                    chosen = data.consumeString(16);
                    break;
                case 1:
                    chosen = Integer.valueOf(data.consumeInt());
                    break;
                case 2:
                    chosen = Double.valueOf((double) data.consumeInt());
                    break;
                case 3:
                    chosen = Long.valueOf((long) data.consumeInt());
                    break;
                case 4:
                    chosen = data.consumeBytes(8);
                    break;
                default:
                    chosen = Boolean.valueOf(data.consumeBoolean());
                    break;
            }

            List<Pair<Object, Double>> fuzzed = new ArrayList<Pair<Object, Double>>();
            int before = data.consumeInt(0, 3);
            int after = data.consumeInt(0, 3);

            fuzzed.add(new Pair<Object, Double>(first, Double.valueOf(0.0)));
            for (int i = 0; i < before; i++) {
                fuzzed.add(new Pair<Object, Double>(Integer.valueOf(data.consumeInt()), Double.valueOf(0.0)));
            }
            fuzzed.add(new Pair<Object, Double>(chosen, Double.valueOf(1.0)));
            for (int i = 0; i < after; i++) {
                fuzzed.add(new Pair<Object, Double>(data.consumeAsciiString(8), Double.valueOf(0.0)));
            }

            int sampleSize = data.consumeInt(1, 8);
            new DiscreteDistribution<Object>(fuzzed).sample(sampleSize);

            List<Pair<Object, Double>> deterministic = new ArrayList<Pair<Object, Double>>();
            String token = data.consumeAsciiString(16);
            deterministic.add(new Pair<Object, Double>(token, Double.valueOf(1.0)));
            DiscreteDistribution<Object> det = new DiscreteDistribution<Object>(deterministic);
            Object lhs = det.sample(1)[0];
            Object rhs = det.sample();
            if ((lhs == null && rhs != null) || (lhs != null && !lhs.equals(rhs))) {
                throw new RuntimeException("metamorphic violation: deterministic sample(1)[0] != sample()");
            }
        } catch (MathArithmeticException | MathIllegalArgumentException | NotStrictlyPositiveException expected) {
            return;
        }
    }
}
