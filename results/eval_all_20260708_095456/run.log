package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        solveCyclingExample(1.0, 1.0, 1.0, 1.0);
    }

    private static void runExplore(FuzzedDataProvider data) {
        double objectiveScale = positiveScale(data.consumeInt(1, 9));
        double row1Scale = positiveScale(data.consumeInt(1, 9));
        double row2Scale = positiveScale(data.consumeInt(1, 9));
        double row3Scale = positiveScale(data.consumeInt(1, 9));

        PointValuePair a = solveCyclingExample(objectiveScale, row1Scale, row2Scale, row3Scale);

        double secondObjectiveScale = objectiveScale * positiveScale(data.consumeInt(1, 5));
        PointValuePair b = solveCyclingExample(secondObjectiveScale, row1Scale, row2Scale, row3Scale);

        if (a != null && b != null) {
            double va = a.getValue();
            double vb = b.getValue();
            double factor = secondObjectiveScale / objectiveScale;
            if (Double.isFinite(va) && Double.isFinite(vb)) {
                double expected = va * factor;
                double tolerance = 1e-8 * Math.max(1.0, Math.max(Math.abs(expected), Math.abs(vb)));
                if (Math.abs(expected - vb) > tolerance) {
                    throw new RuntimeException("metamorphic violation: objective scaling");
                }
            }
        }
    }

    private static double positiveScale(int n) {
        return (double) n;
    }

    private static PointValuePair solveCyclingExample(double objectiveScale,
                                                      double row1Scale,
                                                      double row2Scale,
                                                      double row3Scale) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(
                new double[] {
                        10.0 * objectiveScale,
                        -57.0 * objectiveScale,
                        -9.0 * objectiveScale,
                        -24.0 * objectiveScale
                },
                0.0);

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(
                new double[] {
                        0.5 * row1Scale,
                        -5.5 * row1Scale,
                        -2.5 * row1Scale,
                        9.0 * row1Scale
                },
                Relationship.LEQ,
                0.0 * row1Scale));
        constraints.add(new LinearConstraint(
                new double[] {
                        0.5 * row2Scale,
                        -1.5 * row2Scale,
                        -0.5 * row2Scale,
                        1.0 * row2Scale
                },
                Relationship.LEQ,
                0.0 * row2Scale));
        constraints.add(new LinearConstraint(
                new double[] {
                        1.0 * row3Scale,
                        0.0,
                        0.0,
                        0.0
                },
                Relationship.LEQ,
                1.0 * row3Scale));

        return new SimplexSolver().optimize(f, constraints, GoalType.MAXIMIZE, true);
    }
}
