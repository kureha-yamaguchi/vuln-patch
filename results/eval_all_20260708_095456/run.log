package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            new PoissonDistributionImpl(-1);
        } catch (org.apache.commons.math.exception.NotStrictlyPositiveException expected) {
            // Expected on the fixed version.
        }

        double invalidMean;
        switch (data.consumeInt(0, 5)) {
            case 0:
                invalidMean = 0.0;
                break;
            case 1:
                invalidMean = -0.0;
                break;
            case 2:
                invalidMean = -Math.abs((double) data.consumeInt());
                break;
            case 3:
                invalidMean = -Math.abs((double) data.consumeByte());
                break;
            case 4:
                int denom = data.consumeInt(1, Integer.MAX_VALUE);
                invalidMean = -Math.abs(((double) data.consumeInt()) / denom);
                break;
            default:
                invalidMean = -Math.abs((double) data.consumeInt()) - 1.0;
                break;
        }

        try {
            new PoissonDistributionImpl(invalidMean);
        } catch (org.apache.commons.math.exception.NotStrictlyPositiveException expected) {
            // Expected on the fixed version for p <= 0.
        }

        int base = data.consumeInt();
        int fracDen = data.consumeInt(1, Integer.MAX_VALUE);
        double validMean = 1.0 + Math.abs((double) base) + (((double) Math.abs(data.consumeInt())) / fracDen);

        try {
            PoissonDistribution d1 = new PoissonDistributionImpl(validMean);
            double observed = d1.getMean();
            PoissonDistribution d2 = new PoissonDistributionImpl(observed);
            double observedTwice = d2.getMean();
            if (Double.compare(observed, observedTwice) != 0) {
                throw new RuntimeException("metamorphic violation: getMean-constructor round-trip");
            }
        } catch (org.apache.commons.math.exception.NotStrictlyPositiveException expected) {
            // Should not happen for validMean, but treat as rejected input rather than a fuzz finding.
        }
    }
}
