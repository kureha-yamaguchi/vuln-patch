public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        requireValidUppercaseHex("0Xfade");
        requireValidUppercaseHex("-0Xfade");

        String[] regressionLiterals = new String[] {
            "12345",
            "1234.5D",
            "1234.5d",
            "1234.5F",
            "1234.5f",
            "12345L",
            "12345l",
            "-1234.5",
            "-12345",
            "0xFADE",
            "-0xFADE",
            "1.1E200",
            "1.1E20",
            "-1.1E200",
            "1.1E-200",
            "12345678901234567890L",
            "1.1E-700F",
            "2.",
            "1eE"
        };
        for (int i = 0; i < regressionLiterals.length; i++) {
            try {
                NumberUtils.createNumber(regressionLiterals[i]);
            } catch (NumberFormatException ignored) {
            }
        }

        try {
            NumberUtils.createNumber(data.consumeString(64));
        } catch (NumberFormatException ignored) {
        }

        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(1, 32);
        String seed = data.consumeAsciiString(len);
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < len; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('a' + (i % 6));
            int selector = c & 0x0F;
            if (selector < 10) {
                digits.append((char) ('0' + selector));
            } else {
                digits.append("abcdef".charAt(selector - 10));
            }
        }
        digits.setCharAt(digits.length() - 1, "abcdefABCDEF".charAt(data.consumeInt(0, 11)));

        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder prefixDigits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            prefixDigits.append('0');
        }
        prefixDigits.append(digits);

        String upper = (negative ? "-0X" : "0X") + prefixDigits.toString();
        String lower = (negative ? "-0x" : "0x") + prefixDigits.toString();

        requireValidUppercaseHex(upper);

        try {
            NumberUtils.createNumber(lower);
        } catch (NumberFormatException ignored) {
        }

        try {
            Number upperParsed = NumberUtils.createNumber(upper);
            Number lowerParsed = NumberUtils.createNumber(lower);
            if (upperParsed == null || lowerParsed == null || !upperParsed.equals(lowerParsed)) {
                throw new RuntimeException("metamorphic violation: 0X and 0x hex forms must be equivalent");
            }
        } catch (NumberFormatException e) {
            try {
                NumberUtils.createInteger(upper);
                throw e;
            } catch (NumberFormatException ignored) {
            }
        }

        String longLiteral = Long.toString((((long) data.consumeInt()) << 32) ^ (data.consumeInt() & 0xffffffffL))
                + (data.consumeBoolean() ? "L" : "l");
        try {
            NumberUtils.createNumber(longLiteral);
        } catch (NumberFormatException ignored) {
        }

        String scientific = buildScientificLiteral(data);
        try {
            NumberUtils.createNumber(scientific);
        } catch (NumberFormatException ignored) {
        }

        String bigInt = buildBigIntegerLiteral(data);
        try {
            NumberUtils.createNumber(bigInt);
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(data.consumeRemainingAsString());
        } catch (NumberFormatException ignored) {
        }
    }
