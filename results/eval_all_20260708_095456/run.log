    private static void runAnchor() {
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(null, null);
        PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(attribute));
        set.getSize();
    }

    private static void runBoundaryLeaf(FuzzedDataProvider data, boolean plusOutside, boolean plusInside) {
        SubHyperplane<Euclidean2D> outside = plusOutside ? makeWholeLine(data) : null;
        SubHyperplane<Euclidean2D> inside = plusInside ? makeWholeLine(data) : null;
        BoundaryAttribute<Euclidean2D> attribute = new BoundaryAttribute<Euclidean2D>(outside, inside);
        PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(attribute));

        exercise(set);
    }

    private static void runBooleanLeaf(boolean inside) {
        PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(inside)));
        exercise(set);
    }

    private static SubHyperplane<Euclidean2D> makeWholeLine(FuzzedDataProvider data) {
        Vector2D a = new Vector2D(consumeFiniteDouble(data), consumeFiniteDouble(data));
        Vector2D b = new Vector2D(consumeFiniteDouble(data), consumeFiniteDouble(data));
        if (samePoint(a, b)) {
