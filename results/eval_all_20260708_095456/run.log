    private static String buildUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(1, 32);
        String source = data.consumeAsciiString(len);
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < source.length() && digits.length() < len; i++) {
            char c = source.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                digits.append(c);
            }
        }
        while (digits.length() < len) {
            int v = data.consumeInt(0, 15);
            digits.append("0123456789ABCDEF".charAt(v));
        }
        if (digits.length() == 0) {
            digits.append('0');
        }
        if (containsNoLetter(digits)) {
            digits.setCharAt(digits.length() - 1, "ABCDEF".charAt(data.consumeInt(0, 5)));
        }
        return (negative ? "-0X" : "0X") + digits.toString();
    }

    private static boolean containsNoLetter(CharSequence s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) {
                return false;
            }
        }
        return true;
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        int len = data.consumeInt(19, 64);
        String digits = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + ((c & 0x7f) % 10)));
            }
        }
        while (sb.length() <= len) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (sb.charAt(sb.length() - 1) == '-') {
            sb.append('0');
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 999999));
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracLen = data.consumeInt(0, 12);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        sb.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        sb.append(data.consumeInt(0, 800));
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'D');
        }
        return sb.toString();
    }

    private static String buildSuffixLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int whole = data.consumeInt(0, 1000000);
        sb.append(whole);
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracLen = data.consumeInt(0, 10);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        char suffix;
        switch (data.consumeInt(0, 5)) {
            case 0:
                suffix = 'f';
                break;
            case 1:
                suffix = 'F';
                break;
            case 2:
                suffix = 'd';
                break;
            case 3:
                suffix = 'D';
                break;
            case 4:
                suffix = 'l';
                break;
            default:
                suffix = 'L';
                break;
        }
        sb.append(suffix);
        return sb.toString();
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 1000000));
        sb.append('.');
        int fracLen = data.consumeInt(0, 16);
        for (int i = 0; i < fracLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }
