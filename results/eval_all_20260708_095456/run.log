            metamorphicSingletonSampleCheck(data);
        } catch (ArrayStoreException e) {
            throw e;
        } catch (NotStrictlyPositiveException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static void anchorExactTrigger() {
        List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
        list.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(0.0)));
        list.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(1.0)));
        new DiscreteDistribution<Object>(list).sample(1);
    }

    private static void exploreHeterogeneousDiscreteDistribution(FuzzedDataProvider data) {
        int count = data.consumeInt(2, 6);
        int forcedIndex = data.consumeInt(1, count - 1);
        Object first = makeValue(data, 0);
        Object forced = makeValue(data, 1);
        if (forced.getClass().equals(first.getClass())) {
            forced = alternateValue(first);
        }

        List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
        list.add(new Pair<Object, Double>(first, Double.valueOf(0.0)));
        for (int i = 1; i < count; i++) {
            Object value = (i == forcedIndex) ? forced : makeValue(data, i + 2);
            if (i != forcedIndex && value.getClass().equals(first.getClass()) && data.consumeBoolean()) {
                value = alternateValue(value);
            }
            double p = (i == forcedIndex) ? 1.0 : 0.0;
            list.add(new Pair<Object, Double>(value, Double.valueOf(p)));
        }

        DiscreteDistribution<Object> distribution = new DiscreteDistribution<Object>(list);
        int sampleSize = data.consumeInt(1, 8);
        Object[] samples = distribution.sample(sampleSize);
        if (samples.length != sampleSize) {
            throw new RuntimeException("metamorphic violation: sample length");
        }
    }

    private static void metamorphicSingletonSampleCheck(FuzzedDataProvider data) {
        Object singleton = makeValue(data, 100);
        List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
        list.add(new Pair<Object, Double>(singleton, Double.valueOf(1.0)));
        DiscreteDistribution<Object> distribution = new DiscreteDistribution<Object>(list);

        int sampleSize = data.consumeInt(1, 8);
        Object[] many = distribution.sample(sampleSize);
        Object one = distribution.sample();

        if (many.length != sampleSize) {
            throw new RuntimeException("metamorphic violation: singleton sample length");
        }
        for (int i = 0; i < many.length; i++) {
            if (many[i] != one) {
                throw new RuntimeException("metamorphic violation: singleton distribution sample(int) must match repeated sample()");
            }
        }
    }

    private static void exerciseDiscreteRealDistribution(FuzzedDataProvider data) {
        int n = data.consumeInt(1, 6);
        double[] values = new double[n];
        double[] probs = new double[n];
        int forced = data.consumeInt(0, n - 1);

        for (int i = 0; i < n; i++) {
            if (data.consumeBoolean()) {
                values[i] = data.consumeInt(-1000, 1000);
            } else {
                values[i] = (double) data.consumeInt(-1000, 1000) / (double) (data.consumeInt(1, 32));
            }
            probs[i] = (i == forced) ? 1.0 : 0.0;
        }

        DiscreteRealDistribution d = new DiscreteRealDistribution(values, probs);
        double lower = d.getSupportLowerBound();
        double upper = d.getSupportUpperBound();
        d.getNumericalMean();
        d.getNumericalVariance();
        d.isSupportConnected();
        d.getSolverAbsoluteAccuracy();
        d.cumulativeProbability(values[forced]);
        d.inverseCumulativeProbability(0.0);
        d.inverseCumulativeProbability(0.5);
        d.inverseCumulativeProbability(1.0);
        double s = d.sample();

        if (s < lower || s > upper) {
            throw new RuntimeException("metamorphic violation: sample outside support bounds");
        }
    }

    private static Object makeValue(FuzzedDataProvider data, int salt) {
        switch ((data.consumeInt() ^ salt) & 7) {
            case 0:
                return data.consumeAsciiString(16);
            case 1:
                return Integer.valueOf(data.consumeInt());
            case 2:
                return Long.valueOf((long) data.consumeInt());
            case 3:
                return Double.valueOf((double) data.consumeInt());
            case 4:
                return Float.valueOf((float) data.consumeInt());
            case 5:
                return Short.valueOf((short) data.consumeInt());
            case 6:
                return Character.valueOf((char) data.consumeInt(0, 65535));
            default:
                return data.consumeBytes(8);
        }
    }

    private static Object alternateValue(Object value) {
        if (!(value instanceof String)) {
            return "";
        }
        return Integer.valueOf(1);
    }
}
