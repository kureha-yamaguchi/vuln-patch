public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        requireValidHexEquivalence("0xfade", "0Xfade");

        int base = data.consumeInt(0, Integer.MAX_VALUE);
        base = (base & ~0xF) | data.consumeInt(10, 15);
        boolean negative = data.consumeBoolean() && base != 0;
        String hexDigits = Integer.toHexString(base);
        if (data.consumeBoolean()) {
            hexDigits = hexDigits.toUpperCase();
        }
        String lowerHex = (negative ? "-" : "") + "0x" + hexDigits;
        String upperHex = (negative ? "-" : "") + "0X" + hexDigits;
        requireValidHexEquivalence(lowerHex, upperHex);

        String decimal = Integer.toString(data.consumeInt());
        try {
            NumberUtils.createNumber(decimal);
        } catch (NumberFormatException ignored) {
        }

        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        long longValue = hi ^ lo;
        String longLiteral = Long.toString(longValue) + (data.consumeBoolean() ? "L" : "l");
        try {
            NumberUtils.createNumber(longLiteral);
        } catch (NumberFormatException ignored) {
        }

        String bigLiteral = buildBigIntegerLiteral(data);
        try {
            NumberUtils.createNumber(bigLiteral);
        } catch (NumberFormatException ignored) {
        }

        String scientific = buildScientificLiteral(data);
        try {
            NumberUtils.createNumber(scientific);
        } catch (NumberFormatException ignored) {
        }

        String maybeInvalid = data.consumeRemainingAsString();
        try {
            NumberUtils.createNumber(maybeInvalid);
        } catch (NumberFormatException ignored) {
        }
    }
