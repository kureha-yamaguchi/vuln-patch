    private static boolean samePointOrNull(Vector2D a, Vector2D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return samePointOrNaN(a, b);
    }

    private static boolean samePointOrNaN(Vector2D a, Vector2D b) {
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean samePoint(Vector2D a, Vector2D b) {
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }
