            Object chosen = makeDifferentClassObject(data, first);

            int sampleSize = 1 + data.consumeInt(0, 16);
            int extra = data.consumeInt(0, 3);

            List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
            list.add(new Pair<Object, Double>(first, Double.valueOf(0.0)));
            list.add(new Pair<Object, Double>(chosen, Double.valueOf(1.0)));

            for (int i = 0; i < extra; i++) {
                Object filler = data.consumeBoolean() ? makeObject(data) : chosen;
                list.add(new Pair<Object, Double>(filler, Double.valueOf(0.0)));
            }

            try {
                new DiscreteDistribution<Object>(list).sample(sampleSize);
            } catch (MathIllegalArgumentException e) {
                return;
            } catch (NotStrictlyPositiveException e) {
                return;
            }
        }

        // METAMORPHIC CHECK: for a deterministic one-point distribution, sample(1)[0]
        // must equal sample(). This holds for any correct implementation.
        Object deterministic = makeObject(data);
        List<Pair<Object, Double>> det = new ArrayList<Pair<Object, Double>>();
        det.add(new Pair<Object, Double>(deterministic, Double.valueOf(1.0)));
        try {
            DiscreteDistribution<Object> d = new DiscreteDistribution<Object>(det);
            Object direct = d.sample();
            Object[] arr = d.sample(1);
            if (arr == null || arr.length != 1 || arr[0] != direct) {
