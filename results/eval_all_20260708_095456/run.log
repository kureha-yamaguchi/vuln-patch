package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("😰");
        exercise("\uD800\uDC00");
        exercise("\uD834\uDD1E");
        exercise("\uDBFF\uDFFD");

        String prefix = data.consumeAsciiString(16);
        String suffix = data.consumeAsciiString(16);
        String infix = data.consumeAsciiString(16);

        StringBuilder sb = new StringBuilder();
        sb.append(prefix);

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp)) {
                cp = 0x10000;
            }
            sb.appendCodePoint(cp);

            if (data.consumeBoolean()) {
                switch (data.consumeInt(0, 4)) {
                    case 0:
                        sb.append(',');
                        break;
                    case 1:
                        sb.append('"');
                        break;
                    case 2:
                        sb.append('\n');
                        break;
                    case 3:
                        sb.append('\r');
                        break;
                    default:
                        sb.append(infix);
                        break;
                }
            } else {
                sb.append(infix);
            }
        }
        sb.append(suffix);

        exercise(sb.toString());

        if (data.consumeBoolean()) {
            exercise(prefix + sb.toString());
        }
        if (data.consumeBoolean()) {
            exercise(sb.toString() + suffix);
        }
    }

    private static void exercise(String input) {
        String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        try {
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException;
    }
}
