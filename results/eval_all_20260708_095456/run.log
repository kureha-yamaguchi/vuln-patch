        double root = k * Math.PI;

        double leftDelta = 0.01 + (data.consumeInt(0, 1500) / 1000.0);
        double rightDelta = 0.01 + (data.consumeInt(0, 1500) / 1000.0);

        if (leftDelta >= (Math.PI / 2.0)) {
            leftDelta = (Math.PI / 2.0) - 1e-6;
        }
        if (rightDelta >= (Math.PI / 2.0)) {
            rightDelta = (Math.PI / 2.0) - 1e-6;
        }

