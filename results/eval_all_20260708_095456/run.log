            int xi = data.consumeInt(-32, 32);
            if (xi >= -1 && xi <= 1) {
                xi = data.consumeBoolean() ? 2 : -2;
            }

            double x = (double) xi;
            try {
                double p = normal.cumulativeProbability(x);
