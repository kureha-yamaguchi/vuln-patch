public class FuzzHarness {
    private static final int VARS = 31;

    private static double[] c(double[] in) {
        double[] out = new double[in.length];
        System.arraycopy(in, 0, out, 0, in.length);
        return out;
    }

    private static LinearConstraint lc(double[] coeffs, Relationship rel, double rhs) {
        return new LinearConstraint(c(coeffs), rel, rhs);
    }

    private static PointValuePair solve(ArrayList<LinearConstraint> constraints) {
        double[] objective = new double[VARS];
        objective[0] = 1.0;
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        return solver.optimize(new LinearObjectiveFunction(objective, 0.0), constraints, GoalType.MINIMIZE, true);
    }

    private static ArrayList<LinearConstraint> cloneConstraints(ArrayList<LinearConstraint> in) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(in.size());
        for (int i = 0; i < in.size(); i++) {
            LinearConstraint x = in.get(i);
            out.add(new LinearConstraint(x.getCoefficients(), x.getRelationship(), x.getValue()));
        }
        return out;
    }

    private static double leading(LinearConstraint x) {
        return x.getCoefficients().getEntry(0);
