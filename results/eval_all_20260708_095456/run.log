package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        Problem p = buildProblem(data);

        try {
            solve(p.objective, p.constraints, p.goalType, p.nonNegative);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        PointValuePair lhs;
        try {
            lhs = solveMaybe(p.objective, p.constraints, p.goalType, p.nonNegative);
        } catch (MaxCountExceededException e) {
            throw e;
        }

        if (lhs == null || p.constraints.isEmpty()) {
            return;
        }

        int scale = Math.abs(data.consumeInt()) % 7 + 1;
        ArrayList<LinearConstraint> scaled = new ArrayList<LinearConstraint>(p.constraints.size());
        boolean first = true;
        for (LinearConstraint c : p.constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double rhs = c.getValue();
            if (first) {
                for (int i = 0; i < coeffs.length; i++) {
                    coeffs[i] *= scale;
                }
                rhs *= scale;
                first = false;
            }
            scaled.add(new LinearConstraint(coeffs, c.getRelationship(), rhs));
        }

        PointValuePair rhs = solveMaybe(p.objective, scaled, p.goalType, p.nonNegative);
        if (rhs == null) {
            return;
        }

        double v1 = lhs.getValue();
        double v2 = rhs.getValue();
        if (Double.isNaN(v1) != Double.isNaN(v2) || Math.abs(v1 - v2) > 1.0e-6) {
            throw new RuntimeException("metamorphic violation: positive scaling of a constraint changed optimum");
        }
    }

    private static void runAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 0.5, -5.5, -2.5, 9.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { 0.5, -1.5, -0.5, 1.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { 1.0, 0.0, 0.0, 0.0 }, Relationship.LEQ, 1.0));
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 10.0, -57.0, -9.0, -24.0 }, 0.0);
        solve(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static Problem buildProblem(FuzzedDataProvider data) {
        int extra = data.consumeInt(0, 4);
        int n = 4 + extra;

        double objectiveScale = data.consumeInt(1, 6);
        double[] obj = new double[n];
        obj[0] = 10.0 * objectiveScale;
        obj[1] = -57.0 * objectiveScale;
        obj[2] = -9.0 * objectiveScale;
        obj[3] = -24.0 * objectiveScale;
        for (int i = 4; i < n; i++) {
            obj[i] = data.consumeInt(-3, 3);
        }
        LinearObjectiveFunction f = new LinearObjectiveFunction(obj, data.consumeInt(-3, 3));

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double s1 = data.consumeInt(1, 8);
        double[] c1 = new double[n];
        c1[0] = 0.5 * s1;
        c1[1] = -5.5 * s1;
        c1[2] = -2.5 * s1;
        c1[3] = 9.0 * s1;
        for (int i = 4; i < n; i++) {
            c1[i] = data.consumeBoolean() ? 0.0 : data.consumeInt(-2, 2);
        }
        constraints.add(new LinearConstraint(c1, Relationship.LEQ, 0.0));

        double s2 = data.consumeInt(1, 8);
        double[] c2 = new double[n];
        c2[0] = 0.5 * s2;
        c2[1] = -1.5 * s2;
        c2[2] = -0.5 * s2;
        c2[3] = 1.0 * s2;
        for (int i = 4; i < n; i++) {
            c2[i] = data.consumeBoolean() ? 0.0 : data.consumeInt(-2, 2);
        }
        constraints.add(new LinearConstraint(c2, Relationship.LEQ, 0.0));

        double s3 = data.consumeInt(1, 8);
        double[] c3 = new double[n];
        c3[0] = 1.0 * s3;
        for (int i = 1; i < n; i++) {
            c3[i] = 0.0;
        }
        constraints.add(new LinearConstraint(c3, Relationship.LEQ, 1.0 * s3));

        int redundant = data.consumeInt(0, 3);
        for (int r = 0; r < redundant; r++) {
            int which = data.consumeInt(0, 2);
            int mul = data.consumeInt(1, 5);
            double[] base;
            double rhs;
            if (which == 0) {
                base = c1;
                rhs = 0.0;
            } else if (which == 1) {
                base = c2;
                rhs = 0.0;
            } else {
                base = c3;
                rhs = 1.0 * s3;
            }
            double[] coeffs = new double[n];
            for (int i = 0; i < n; i++) {
                coeffs[i] = base[i] * mul;
            }
            constraints.add(new LinearConstraint(coeffs, Relationship.LEQ, rhs * mul));
        }

        if (data.consumeBoolean()) {
            double[] eq = new double[n];
            eq[0] = data.consumeBoolean() ? 0.0 : data.consumeInt(-1, 1);
            eq[1] = data.consumeBoolean() ? 0.0 : data.consumeInt(-1, 1);
            eq[2] = data.consumeBoolean() ? 0.0 : data.consumeInt(-1, 1);
            eq[3] = data.consumeBoolean() ? 0.0 : data.consumeInt(-1, 1);
            for (int i = 4; i < n; i++) {
                eq[i] = data.consumeBoolean() ? 0.0 : data.consumeInt(-1, 1);
            }
            constraints.add(new LinearConstraint(eq, Relationship.EQ, 0.0));
        }

        return new Problem(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static PointValuePair solve(LinearObjectiveFunction f, List<LinearConstraint> constraints,
                                        GoalType goalType, boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, goalType, nonNegative);
    }

    private static PointValuePair solveMaybe(LinearObjectiveFunction f, List<LinearConstraint> constraints,
                                             GoalType goalType, boolean nonNegative) {
        try {
            return solve(f, constraints, goalType, nonNegative);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    private static final class Problem {
        final LinearObjectiveFunction objective;
        final ArrayList<LinearConstraint> constraints;
        final GoalType goalType;
        final boolean nonNegative;

        Problem(LinearObjectiveFunction objective, ArrayList<LinearConstraint> constraints,
                GoalType goalType, boolean nonNegative) {
            this.objective = objective;
            this.constraints = constraints;
            this.goalType = goalType;
            this.nonNegative = nonNegative;
        }
    }
}
