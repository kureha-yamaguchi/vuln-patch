package org.jfree.data.xy;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int preCount = data.consumeInt(0, 16);
        boolean useFinite = data.consumeBoolean();
        double duplicateX = chooseDouble(data, useFinite);
        double firstY = chooseDouble(data, data.consumeBoolean());
        double secondY = chooseDouble(data, data.consumeBoolean());

        try {
            XYSeries series = new XYSeries(data.consumeString(16), true, true);

            for (int i = 0; i < preCount; i++) {
                double x = chooseDouble(data, data.consumeBoolean());
                double y = chooseDouble(data, data.consumeBoolean());
                safeAddOrUpdate(series, new Double(x), new Double(y));
            }

            safeAddOrUpdate(series, new Double(duplicateX), new Double(firstY));
            safeAddOrUpdate(series, new Double(duplicateX), new Double(secondY));

            metamorphicCheck(duplicateX, firstY, secondY);
        } catch (IllegalArgumentException e) {
            return;
        } catch (ClassCastException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (Error e) {
            throw e;
        }
    }

    private static void anchor() {
        XYSeries series = new XYSeries("Series", true, true);
        series.addOrUpdate(new Double(1.0), new Double(1.0));
        series.addOrUpdate(new Double(1.0), new Double(2.0));
        if (!new Double(1.0).equals(series.getY(0))) {
            throw new RuntimeException("metamorphic violation: anchor first y");
        }
        if (!new Double(2.0).equals(series.getY(1))) {
            throw new RuntimeException("metamorphic violation: anchor second y");
        }
        if (series.getItemCount() != 2) {
            throw new RuntimeException("metamorphic violation: anchor item count");
        }
    }

    private static void metamorphicCheck(double x, double y1, double y2) {
        XYSeries viaAddOrUpdate = new XYSeries("m1", true, true);
        XYSeries viaAdd = new XYSeries("m2", true, true);

        safeAddOrUpdate(viaAddOrUpdate, new Double(x), new Double(y1));
        safeAddOrUpdate(viaAddOrUpdate, new Double(x), new Double(y2));

        viaAdd.add(new Double(x), new Double(y1));
        viaAdd.add(new Double(x), new Double(y2));

        if (viaAddOrUpdate.getItemCount() != viaAdd.getItemCount()) {
            throw new RuntimeException("metamorphic violation: addOrUpdate vs add item count");
        }
        for (int i = 0; i < viaAdd.getItemCount(); i++) {
            Number x1 = viaAddOrUpdate.getX(i);
            Number x2 = viaAdd.getX(i);
            Number yy1 = viaAddOrUpdate.getY(i);
            Number yy2 = viaAdd.getY(i);
            if (!numbersEqual(x1, x2) || !numbersEqual(yy1, yy2)) {
                throw new RuntimeException("metamorphic violation: addOrUpdate vs add contents");
            }
        }
    }

    private static void safeAddOrUpdate(XYSeries series, Number x, Number y) {
        try {
            series.addOrUpdate(x, y);
        } catch (IllegalArgumentException e) {
        } catch (ClassCastException e) {
        }
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException
                || t instanceof ArrayIndexOutOfBoundsException
                || t instanceof NegativeArraySizeException;
    }

    private static boolean numbersEqual(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return a == b;
        }
        double da = a.doubleValue();
        double db = b.doubleValue();
        return Double.doubleToLongBits(da) == Double.doubleToLongBits(db);
    }

    private static double chooseDouble(FuzzedDataProvider data, boolean finiteOnly) {
        if (finiteOnly) {
            int selector = data.consumeInt(0, 4);
            switch (selector) {
                case 0:
                    return data.consumeInt(-1000, 1000);
                case 1:
                    return data.consumeInt() / 10.0;
                case 2:
                    return data.consumeByte();
                case 3:
                    return data.consumeInt(-100000, 100000) / 100.0;
                default:
                    return 0.0;
            }
        }
        int selector = data.consumeInt(0, 7);
        switch (selector) {
            case 0:
                return Double.NaN;
            case 1:
                return Double.POSITIVE_INFINITY;
            case 2:
                return Double.NEGATIVE_INFINITY;
            case 3:
                return 0.0;
            case 4:
                return -0.0;
            case 5:
                return data.consumeInt();
            case 6:
                return data.consumeInt() / 10.0;
            default:
                return data.consumeByte();
        }
    }
}
