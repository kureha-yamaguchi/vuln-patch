package org.apache.commons.math.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ConcurrentModificationException;
import org.apache.commons.math.linear.OpenMapRealVector;
import org.apache.commons.math.linear.RealVector;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int dim = data.consumeInt(1, 32);
        double epsilon = epsilonFromInt(data.consumeInt());

        OpenMapRealVector u = new OpenMapRealVector(dim, epsilon);
        OpenMapRealVector vSparse = new OpenMapRealVector(dim, epsilon);
        double[] vDense = new double[dim];

        boolean hasZeroInV = false;
        boolean hasNonZeroInU = false;

        for (int i = 0; i < dim; i++) {
            double uVal = boundedDouble(data.consumeInt());
            if (data.consumeBoolean()) {
                uVal = 0.0;
            }
            u.setEntry(i, uVal);
            if (uVal != 0.0) {
                hasNonZeroInU = true;
            }

            double vVal;
            if (data.consumeBoolean()) {
                vVal = 0.0;
                hasZeroInV = true;
            } else {
                vVal = boundedDouble(data.consumeInt());
                if (vVal == 0.0) {
                    vVal = 1.0;
                }
            }
            vSparse.setEntry(i, vVal);
            vDense[i] = vVal;
        }

        if (!hasZeroInV && dim > 0) {
            int idx = data.consumeInt(0, dim - 1);
            vSparse.setEntry(idx, 0.0);
            vDense[idx] = 0.0;
            hasZeroInV = true;
        }
        if (!hasNonZeroInU && dim > 0) {
            int idx = data.consumeInt(0, dim - 1);
            u.setEntry(idx, 1.0);
            hasNonZeroInU = true;
        }

        if (!hasZeroInV || !hasNonZeroInU) {
            return;
        }

        try {
            RealVector mulSparse = u.ebeMultiply(vSparse);
            RealVector mulDense = u.ebeMultiply(vDense);
            RealVector divSparse = u.ebeDivide(vSparse);
            RealVector divDense = u.ebeDivide(vDense);

            if (!sameVector(mulSparse, mulDense)) {
                throw new RuntimeException("metamorphic violation: ebeMultiply(RealVector) != ebeMultiply(double[])");
            }
            if (!sameVector(divSparse, divDense)) {
                throw new RuntimeException("metamorphic violation: ebeDivide(RealVector) != ebeDivide(double[])");
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static void runAnchor() {
        RealVector u = new OpenMapRealVector(3, 1e-6);
        u.setEntry(0, 1);
        u.setEntry(1, 0);
        u.setEntry(2, 2);

        RealVector v1 = new OpenMapRealVector(3, 1e-6);
        double[] v2 = new double[3];
        v1.setEntry(0, 0);
        v2[0] = 0;
        v1.setEntry(1, 3);
        v2[1] = 3;
        v1.setEntry(2, 0);
        v2[2] = 0;

        u.ebeMultiply(v1);
        u.ebeMultiply(v2);
        u.ebeDivide(v1);
        u.ebeDivide(v2);
    }

    private static boolean sameVector(RealVector a, RealVector b) {
        if (a == null || b == null) {
            return a == b;
        }
        int dim = a.getDimension();
        if (dim != b.getDimension()) {
            return false;
        }
        for (int i = 0; i < dim; i++) {
            if (Double.doubleToLongBits(a.getEntry(i)) != Double.doubleToLongBits(b.getEntry(i))) {
                return false;
            }
        }
        return true;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof ConcurrentModificationException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null && name.contains("ConcurrentModification")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static double boundedDouble(int x) {
        return (x % 1000) - 500;
    }

    private static double epsilonFromInt(int x) {
        int v = Math.abs(x % 9);
        double e = 1.0;
        for (int i = 0; i < v; i++) {
            e *= 0.1;
        }
        return e;
    }
}
