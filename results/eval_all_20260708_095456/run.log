public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorCategoryPlotRemoveDomainMarker();
        anchorXYPlotRemoveDomainMarker();
        anchorXYPlotRemoveRangeMarker();

        int index = data.consumeInt();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean notify = data.consumeBoolean();

        String categoryKey = data.consumeString(64);
        if (categoryKey == null) {
            categoryKey = "";
        }
        CategoryMarker categoryMarker = new CategoryMarker(categoryKey);

        double v1 = Double.longBitsToDouble(((long) data.consumeInt() << 32) ^ (data.consumeInt() & 0xffffffffL));
        double v2 = Double.longBitsToDouble(((long) data.consumeInt() << 32) ^ (data.consumeInt() & 0xffffffffL));
        ValueMarker valueMarker1 = new ValueMarker(v1);
        ValueMarker valueMarker2 = new ValueMarker(v2);

        try {
            CategoryPlot cp = new CategoryPlot();
            cp.removeDomainMarker(index, categoryMarker, layer, notify);
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            XYPlot xp = new XYPlot();
            xp.removeDomainMarker(index, valueMarker1, layer, notify);
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            XYPlot xp = new XYPlot();
            xp.removeRangeMarker(index, valueMarker2, layer, notify);
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            CategoryPlot cp = new CategoryPlot();
            boolean first = cp.removeDomainMarker(index, categoryMarker, layer, notify);
            boolean second = cp.removeDomainMarker(index, categoryMarker, layer, notify);
            if (first != second) {
                throw new RuntimeException("metamorphic violation: repeated removal from unchanged empty CategoryPlot should be idempotent");
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

