import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int ULPS = 10;

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchorCycleFamily();

        int vars = data.consumeInt(2, 8);
        int geqRows = data.consumeInt(2, 8);
        boolean restrictToNonNegative = data.consumeBoolean();
        GoalType goal = data.consumeBoolean() ? GoalType.MINIMIZE : GoalType.MAXIMIZE;

        LinearObjectiveFunction f = new LinearObjectiveFunction(buildObjective(data, vars), 0.0);
        ArrayList<LinearConstraint> constraints = buildDegenerateConstraintFamily(data, vars, geqRows);

        exerciseTableauGetters(f, constraints, goal, restrictToNonNegative);

        PointValuePair base = runRealSolver(f, constraints, goal, restrictToNonNegative);

        if (!constraints.isEmpty()) {
            ArrayList<LinearConstraint> dup = new ArrayList<LinearConstraint>(constraints);
            dup.add(constraints.get(0));
            exerciseTableauGetters(f, dup, goal, restrictToNonNegative);
            PointValuePair withDuplicate = runRealSolver(f, dup, goal, restrictToNonNegative);
            if (base != null && withDuplicate != null && samePointLength(base, withDuplicate)) {
                if (!sameSolution(base, withDuplicate)) {
                    throw new RuntimeException("metamorphic violation: duplicating an existing constraint changed the optimum");
                }
            }
        }
    }

    private static void runAnchorCycleFamily() {
        int vars = 31;
