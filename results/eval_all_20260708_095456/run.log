    private static Day dayFromOrdinal(int ord) {
        int year = 2000 + (ord / (12 * 28));
        int rem = ord % (12 * 28);
        int month = 1 + (rem / 28);
        int day = 1 + (rem % 28);
        return new Day(day, month, year);
    }
