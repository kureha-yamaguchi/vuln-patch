package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        TimeSeries series = buildSeriesWithGapAfterFirst(data);
        if (series == null || series.getItemCount() < 2) {
            return;
        }

        Day first = (Day) series.getTimePeriod(0);
        Day second = (Day) series.getTimePeriod(1);

        int firstOrd = ordinalFromDay(first);
        int secondOrd = ordinalFromDay(second);
        if (secondOrd - firstOrd < 2) {
            return;
        }

        int startOrd = data.consumeInt(firstOrd + 1, secondOrd - 1);
        int endOrd = data.consumeInt(startOrd, secondOrd - 1);

        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        int startIndex;
        int endIndexRaw;
        try {
            startIndex = series.getIndex(start);
            endIndexRaw = series.getIndex(end);
        } catch (IllegalArgumentException e) {
            return;
        }

        if (startIndex >= 0 || endIndexRaw >= 0) {
            return;
        }

        TimeSeries gapCopy;
        try {
            gapCopy = series.createCopy(start, end);
        } catch (CloneNotSupportedException e) {
            return;
        }

        if (gapCopy == series) {
            throw new RuntimeException("createCopy returned original series");
        }

        int beforeOrd = firstOrd - 1;
        if (beforeOrd < 0) {
            return;
        }

        TimeSeries emptyCopy;
        try {
            Day before = dayFromOrdinal(beforeOrd);
            emptyCopy = series.createCopy(before, before);
        } catch (IllegalArgumentException e) {
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        if (gapCopy.getItemCount() != emptyCopy.getItemCount()) {
            throw new RuntimeException("metamorphic violation: two empty-range copies differ in itemCount");
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);
        try {
            TimeSeries copy = s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
            if (copy == s) {
                throw new RuntimeException("anchor returned original series");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException("anchor expected empty copy");
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static TimeSeries buildSeriesWithGapAfterFirst(FuzzedDataProvider data) {
        int count = data.consumeInt(2, 8);
        int maxOrd = 365 * 40;

        int firstOrd = data.consumeInt(1, maxOrd - (count + 3));
