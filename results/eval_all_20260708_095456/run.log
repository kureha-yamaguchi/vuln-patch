package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        requireValidHexEquivalence("0xfade", "0Xfade");

        int base = data.consumeInt(0, Integer.MAX_VALUE);
        base = (base & ~0xF) | data.consumeInt(10, 15);
        boolean negative = data.consumeBoolean() && base != 0;
        String hexDigits = Integer.toHexString(base);
        if (data.consumeBoolean()) {
            hexDigits = hexDigits.toUpperCase();
        }
        String lowerHex = (negative ? "-" : "") + "0x" + hexDigits;
        String upperHex = (negative ? "-" : "") + "0X" + hexDigits;
        requireValidHexEquivalence(lowerHex, upperHex);

        String decimal = Integer.toString(data.consumeInt());
        try {
            NumberUtils.createNumber(decimal);
        } catch (NumberFormatException ignored) {
        }

        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        long longValue = hi ^ lo;
        String longLiteral = Long.toString(longValue) + (data.consumeBoolean() ? "L" : "l");
        try {
            NumberUtils.createNumber(longLiteral);
        } catch (NumberFormatException ignored) {
        }

        String bigLiteral = buildBigIntegerLiteral(data);
        try {
            NumberUtils.createNumber(bigLiteral);
        } catch (NumberFormatException ignored) {
        }

        String scientific = buildScientificLiteral(data);
        try {
            NumberUtils.createNumber(scientific);
        } catch (NumberFormatException ignored) {
        }

        String maybeInvalid = data.consumeRemainingAsString();
        try {
            NumberUtils.createNumber(maybeInvalid);
        } catch (NumberFormatException ignored) {
        }
    }

    private static void requireValidHexEquivalence(String lowerHex, String upperHex) {
        Integer expectedLower = NumberUtils.createInteger(lowerHex);
        Integer expectedUpper = NumberUtils.createInteger(upperHex);
        if (!expectedLower.equals(expectedUpper)) {
            throw new RuntimeException("metamorphic violation: createInteger x/X equivalence");
        }

        Number lower;
        Number upper;
        try {
            lower = NumberUtils.createNumber(lowerHex);
            upper = NumberUtils.createNumber(upperHex);
        } catch (NumberFormatException e) {
            throw new RuntimeException("unexpected rejection of valid hex literal", e);
        }

        if (lower == null || upper == null) {
            throw new RuntimeException("unexpected null for valid hex literal");
        }
        if (lower.intValue() != expectedLower.intValue() || upper.intValue() != expectedUpper.intValue()) {
            throw new RuntimeException("metamorphic violation: createNumber disagrees with createInteger");
        }
        if (lower.intValue() != upper.intValue()) {
            throw new RuntimeException("metamorphic violation: createNumber x/X equivalence");
        }
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        String a = digitsOnly(data.consumeAsciiString(12));
        String b = digitsOnly(data.consumeAsciiString(12));
        if (a.length() == 0) {
            a = "9";
        }
        if (b.length() == 0) {
            b = "876543210";
        }
        String digits = stripLeadingZeros(a + b + "12345678901234567890");
        if (digits.length() == 0) {
            digits = "12345678901234567890";
        }
        return (data.consumeBoolean() ? "-" : "") + digits + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        String whole = digitsOnly(data.consumeAsciiString(6));
        String frac = digitsOnly(data.consumeAsciiString(6));
        if (whole.length() == 0) {
            whole = "1";
        }
        if (frac.length() == 0) {
            frac = data.consumeBoolean() ? "0" : "1";
        }
        int exp = data.consumeInt(-1000, 1000);
        char suffix;
        int choice = data.consumeInt(0, 2);
        if (choice == 0) {
            suffix = 'F';
        } else if (choice == 1) {
            suffix = 'D';
        } else {
            suffix = 'f';
        }
        return (data.consumeBoolean() ? "-" : "") + whole + "." + frac + "E" + exp + suffix;
    }

    private static String digitsOnly(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String stripLeadingZeros(String s) {
        int i = 0;
        while (i < s.length() && s.charAt(i) == '0') {
            i++;
        }
        return s.substring(i);
    }
}
