public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int count = data.consumeInt(2, 8);
        int[] values = new int[count];
        int filled = 0;
        while (filled < count) {
            int v = data.consumeInt(0, 31 * 12 * 20 - 1);
            boolean dup = false;
            for (int i = 0; i < filled; i++) {
                if (values[i] == v) {
                    dup = true;
                    break;
                }
            }
            if (!dup) {
                values[filled++] = v;
            }
        }
        Arrays.sort(values);

        TimeSeries series = new TimeSeries(data.consumeString(20));
        for (int i = 0; i < values.length; i++) {
            Day day = dayFromOrdinal(values[i]);
            try {
                series.add(day, data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() == 0) {
            return;
        }

        Day first = (Day) series.getTimePeriod(0);
        Day last = (Day) series.getTimePeriod(series.getItemCount() - 1);

        try {
            series.getIndex(first);
            series.getIndex(last);
        } catch (IllegalArgumentException e) {
            return;
        }

        int gapIndex = -1;
        for (int i = 0; i < values.length - 1; i++) {
            if (values[i + 1] - values[i] >= 2) {
                gapIndex = i;
                break;
            }
        }

        if (gapIndex != -1) {
            int left = values[gapIndex];
            int right = values[gapIndex + 1];
            int startOrd = data.consumeInt(left + 1, right - 1);
            int endOrd = data.consumeInt(startOrd, right - 1);
            Day start = dayFromOrdinal(startOrd);
            Day end = dayFromOrdinal(endOrd);

            try {
                series.getIndex(start);
                series.getIndex(end);
                TimeSeries copy = series.createCopy(start, end);
                if (copy == null) {
                    throw new RuntimeException("null copy");
                }
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        if (data.consumeBoolean()) {
            int before = values[0] - 1;
            if (before >= 0) {
                try {
                    TimeSeries copy = series.createCopy(dayFromOrdinal(before), dayFromOrdinal(before));
                    if (copy == null) {
                        throw new RuntimeException("null clone-path copy");
                    }
                } catch (IllegalArgumentException e) {
                    return;
                } catch (CloneNotSupportedException e) {
                    return;
                }
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod startExisting = series.getTimePeriod(i);
            RegularTimePeriod endExisting = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);
            TimeSeries byIndex = series.createCopy(i, j);

            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                throw new RuntimeException("metamorphic violation: existing-period copy != index copy itemCount");
            }
            for (int k = 0; k < byPeriod.getItemCount(); k++) {
                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {
                    throw new RuntimeException("metamorphic violation: existing-period copy != index copy timePeriod");
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }
    }
