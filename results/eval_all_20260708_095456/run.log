package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.chart.util.Size2D;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            runAnchorInputs(g2);
            exploreInputs(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchorInputs(Graphics2D g2) {
        RectangleConstraint constraint = fixedWidthNoneHeight(10.0);

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
        container.getBlocks().size();
        Size2D s = container.arrange(g2, constraint);
        if (s == null) {
            throw new RuntimeException("unexpected null size");
        }

        BlockContainer trigger = new BlockContainer(new BorderArrangement());
        EmptyBlock left = new EmptyBlock(12.3, 45.6);
        EmptyBlock right = new EmptyBlock(1.0, 2.0);
        left.getWidth();
        right.getWidth();
        trigger.add(left, RectangleEdge.LEFT);
        trigger.add(right, RectangleEdge.RIGHT);
        trigger.getBlocks().size();
        trigger.arrange(g2, constraint);
    }

    private static void exploreInputs(FuzzedDataProvider data, Graphics2D g2) {
        double constraintWidth = tenth(data.consumeInt(0, 300));
        if (constraintWidth < 0.0) {
            return;
        }
        RectangleConstraint constraint = fixedWidthNoneHeight(constraintWidth);

        BlockContainer container = new BlockContainer(new BorderArrangement());

        boolean addTop = data.consumeBoolean();
        boolean addBottom = data.consumeBoolean();
        boolean addCenter = data.consumeBoolean();
        boolean addRight = data.consumeBoolean();

        double overshoot = tenth(data.consumeInt(0, 300));
        double leftWidth = constraintWidth + overshoot;
        double leftHeight = tenth(data.consumeInt(0, 500));
        EmptyBlock left = new EmptyBlock(leftWidth, leftHeight);
        left.getWidth();
        container.add(left, RectangleEdge.LEFT);

        if (addTop) {
            container.add(new EmptyBlock(tenth(data.consumeInt(0, 500)), tenth(data.consumeInt(0, 500))), RectangleEdge.TOP);
        }
        if (addBottom) {
            container.add(new EmptyBlock(tenth(data.consumeInt(0, 500)), tenth(data.consumeInt(0, 500))), RectangleEdge.BOTTOM);
        }
        if (addCenter) {
            container.add(new EmptyBlock(tenth(data.consumeInt(0, 500)), tenth(data.consumeInt(0, 500))));
        }
        if (addRight || !addCenter) {
            container.add(new EmptyBlock(tenth(data.consumeInt(0, 500)), tenth(data.consumeInt(0, 500))), RectangleEdge.RIGHT);
        }

        container.getBlocks().size();

        Size2D first = container.arrange(g2, constraint);
        if (first == null) {
            return;
        }

        Size2D second = container.arrange(g2, constraint);
        if (second != null
                && (Double.compare(first.getWidth(), second.getWidth()) != 0
                || Double.compare(first.getHeight(), second.getHeight()) != 0)) {
            throw new RuntimeException("metamorphic violation: arrange idempotence");
        }
    }

    private static RectangleConstraint fixedWidthNoneHeight(double width) {
        return new RectangleConstraint(
                width, new Range(width, width), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );
    }

    private static double tenth(int v) {
        return ((double) v) / 10.0;
    }
}
