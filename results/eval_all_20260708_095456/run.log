            }
            if (scenario == 1 || scenario == 3) {
                addLeft = true;
            }

            BlockContainer c1 = new BlockContainer(new BorderArrangement());
            BlockContainer c2 = new BlockContainer(new BorderArrangement());

            if (addCenter) {
                addEquivalent(c1, c2, centerW, centerH, null);
            }
            if (addLeft) {
                addEquivalent(c1, c2, leftW, leftH, RectangleEdge.LEFT);
            }
            if (addRight) {
                addEquivalent(c1, c2, rightW, rightH, RectangleEdge.RIGHT);
            }
            if (addTop) {
                addEquivalent(c1, c2, topW, topH, RectangleEdge.TOP);
            }
