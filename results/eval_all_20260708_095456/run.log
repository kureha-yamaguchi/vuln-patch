                }
                if (Double.doubleToLongBits(va.getY()) != Double.doubleToLongBits(vb.getY())) {
                    return false;
                }
            }
        }
        return true;
    }

    private static double consumeFiniteDouble(FuzzedDataProvider data) {
        int selector = data.consumeInt(0, 4);
        switch (selector) {
            case 0:
