package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number first = NumberUtils.createNumber("1234.5");
        if (first == null || first.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        exerciseAnchorSuite();

        try {
            NumberUtils.createNumber(data.consumeString(64));
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(data.consumeRemainingAsString());
        } catch (NumberFormatException ignored) {
        }

        String candidate = buildUppercaseHexCandidate(data);
        requireCreateIntegerConsistent(candidate);

        String lowerEquivalent = candidate.replace("0X", "0x");
        if (candidate.startsWith("-0X")) {
            lowerEquivalent = candidate.replace("-0X", "-0x");
        }
        metamorphicEquivalentPrefix(candidate, lowerEquivalent);
    }

    private static void exerciseAnchorSuite() {
        String[] anchors = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                String.valueOf(((long) Integer.MAX_VALUE) + 1L),
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "0Xfade",
                "-0xFADE",
                "-0Xfade",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                "-1l",
                "01l",
                "1l",
                "1eE"
        };

        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException ignored) {
            }
        }
    }

    private static String buildUppercaseHexCandidate(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int digitsLen = data.consumeInt(1, 32);
        String seed = data.consumeAsciiString(digitsLen);

        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < digitsLen; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('A' + (i % 6));
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                digits.append(c);
            } else {
                digits.append("0123456789ABCDEF".charAt(c & 0x0F));
            }
        }

        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder normalized = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            normalized.append('0');
        }
        if (digits.length() == 0) {
            normalized.append('F');
        } else {
            normalized.append(digits);
        }

        char last = normalized.charAt(normalized.length() - 1);
        if (!isHexLetter(last)) {
            normalized.setCharAt(normalized.length() - 1, "ABCDEFabcdef".charAt(data.consumeInt(0, 11)));
        }

        return (negative ? "-0X" : "0X") + normalized.toString();
    }

    private static void requireCreateIntegerConsistent(String s) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(s);
        } catch (NumberFormatException ignored) {
            try {
                NumberUtils.createNumber(s);
            } catch (NumberFormatException ignoredToo) {
            }
            return;
        }

        Number actual;
        try {
            actual = NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
            throw new RuntimeException("createNumber rejected valid uppercase hex accepted by createInteger: " + s, e);
        }

        if (actual == null) {
            throw new RuntimeException("createNumber returned null for valid uppercase hex: " + s);
        }
        if (actual.intValue() != expected.intValue()) {
            throw new RuntimeException("createNumber disagrees with createInteger for: " + s);
        }
    }

    private static void metamorphicEquivalentPrefix(String upper, String lower) {
        Number upperNumber;
        Number lowerNumber;
        try {
            upperNumber = NumberUtils.createNumber(upper);
            lowerNumber = NumberUtils.createNumber(lower);
        } catch (NumberFormatException ignored) {
            return;
        }

        if (upperNumber != null && lowerNumber != null && !upperNumber.equals(lowerNumber)) {
            throw new RuntimeException("metamorphic violation: 0X and 0x forms must be equivalent");
        }
    }

    private static boolean isHexLetter(char c) {
        return (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }
}
