package org.apache.commons.math.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ConcurrentModificationException;
import org.apache.commons.math.linear.OpenMapRealVector;
import org.apache.commons.math.linear.RealVector;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            RealVector u = new OpenMapRealVector(3, 1e-6);
            u.setEntry(0, 1);
            u.setEntry(1, 0);
            u.setEntry(2, 2);

            RealVector v1 = new OpenMapRealVector(3, 1e-6);
            double[] v2 = new double[3];
            v1.setEntry(0, 0);
            v2[0] = 0;
            v1.setEntry(1, 3);
            v2[1] = 3;
            v1.setEntry(2, 0);
            v2[2] = 0;

            u.ebeMultiply(v1);
            u.ebeMultiply(v2);
            u.ebeDivide(v1);
            u.ebeDivide(v2);
        } catch (ConcurrentModificationException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        }

        int dimension = data.consumeInt(1, 16);
        double epsilon = 1e-6;

        OpenMapRealVector fu = new OpenMapRealVector(dimension, epsilon);
        OpenMapRealVector fv = new OpenMapRealVector(dimension, epsilon);
        double[] fa = new double[dimension];

        int triggerMul = data.consumeInt(0, dimension - 1);
        int triggerDiv = data.consumeInt(0, dimension - 1);

        for (int i = 0; i < dimension; i++) {
            int rawU = data.consumeInt(-3, 3);
            int rawV = data.consumeInt(-3, 3);

            double uVal = rawU;
            double vVal = rawV;

            if (i == triggerMul) {
                if (uVal == 0.0) {
                    uVal = 1.0;
                }
                vVal = 0.0;
            }

            if (i == triggerDiv) {
                uVal = 0.0;
                if (vVal == 0.0) {
                    vVal = 1.0;
                }
            }

            fu.setEntry(i, uVal);
            fv.setEntry(i, vVal);
            fa[i] = vVal;
        }

        try {
            fu.ebeMultiply(fv);
            fu.ebeMultiply(fa);
            fu.ebeDivide(fv);
            fu.ebeDivide(fa);
        } catch (ConcurrentModificationException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            RealVector left = fu.ebeMultiply(fv);
            RealVector right = fu.ebeMultiply(fa);
            if (left.getDimension() != right.getDimension()) {
                throw new RuntimeException("metamorphic violation: ebeMultiply(vector) dimension != ebeMultiply(array) dimension");
            }
            for (int i = 0; i < left.getDimension(); i++) {
                double a = left.getEntry(i);
                double b = right.getEntry(i);
                if (Double.doubleToLongBits(a) != Double.doubleToLongBits(b)) {
                    throw new RuntimeException("metamorphic violation: ebeMultiply(vector) != ebeMultiply(array)");
                }
            }
        } catch (ConcurrentModificationException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
