public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber("0Xfade");
        } catch (NumberFormatException e) {
            try {
                Number expected = NumberUtils.createInteger("0Xfade");
                if (expected != null) {
                    throw new RuntimeException("createNumber rejected valid uppercase-hex anchor", e);
                }
            } catch (NumberFormatException ignored) {
            }
        }

        String arbitrary = data.consumeString(64);
        try {
            NumberUtils.createNumber(arbitrary);
        } catch (NumberFormatException ignored) {
        }

        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(1, 16);
        String hexDigits = "0123456789abcdefABCDEF";
        String hexLetters = "abcdefABCDEF";
        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append("-0X");
        } else {
            sb.append("0X");
        }
        for (int i = 0; i < len - 1; i++) {
            int idx = data.consumeInt(0, hexDigits.length() - 1);
            sb.append(hexDigits.charAt(idx));
        }
        sb.append(hexLetters.charAt(data.consumeInt(0, hexLetters.length() - 1)));
        String candidate = sb.toString();

        Number expected;
        try {
            expected = NumberUtils.createInteger(candidate);
        } catch (NumberFormatException ignored) {
            return;
        }

        Number actual;
        try {
            actual = NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            throw new RuntimeException("createNumber rejected valid uppercase-hex input: " + candidate, e);
        }

        if (!expected.equals(actual)) {
            throw new RuntimeException("metamorphic violation: createNumber(s) != createInteger(s) for " + candidate);
        }

        String equivalent = negative ? candidate.replaceFirst("-0X", "-0x") : candidate.replaceFirst("0X", "0x");
        try {
            Number lhs = NumberUtils.createNumber(candidate);
            Number rhs = NumberUtils.createNumber(equivalent);
            if (!lhs.equals(rhs)) {
                throw new RuntimeException("metamorphic violation: uppercase and lowercase hex prefixes differ");
            }
        } catch (NumberFormatException ignored) {
        }
    }
