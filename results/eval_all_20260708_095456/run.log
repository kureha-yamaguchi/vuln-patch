private static void requireValidHexEquivalence(String lowerHex, String upperHex) {
        Integer expectedLower = NumberUtils.createInteger(lowerHex);
        Integer expectedUpper = NumberUtils.createInteger(upperHex);
        if (!expectedLower.equals(expectedUpper)) {
            throw new RuntimeException("metamorphic violation: createInteger x/X equivalence");
        }

        Number lower;
        Number upper;
        try {
            lower = NumberUtils.createNumber(lowerHex);
            upper = NumberUtils.createNumber(upperHex);
        } catch (NumberFormatException e) {
            throw new RuntimeException("unexpected rejection of valid hex literal", e);
        }

        if (lower == null || upper == null) {
            throw new RuntimeException("unexpected null for valid hex literal");
        }
        if (lower.intValue() != expectedLower.intValue() || upper.intValue() != expectedUpper.intValue()) {
            throw new RuntimeException("metamorphic violation: createNumber disagrees with createInteger");
        }
        if (lower.intValue() != upper.intValue()) {
            throw new RuntimeException("metamorphic violation: createNumber x/X equivalence");
        }
    }
