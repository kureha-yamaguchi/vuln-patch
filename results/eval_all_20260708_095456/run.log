package org.apache.commons.math3.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathArithmeticException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.NotStrictlyPositiveException;
import org.apache.commons.math3.util.Pair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            List<Pair<Object, Double>> anchor = new ArrayList<Pair<Object, Double>>();
            anchor.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(0)));
            anchor.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(1)));
            new DiscreteDistribution<Object>(anchor).sample(1);
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        } catch (NotStrictlyPositiveException e) {
            return;
        }

        try {
            int size = data.consumeInt(2, 6);
            int sampledIndex = data.consumeInt(1, size - 1);

            Object first = makeObject(data, data.consumeInt(0, 5));
            Object target = makeObject(data, data.consumeInt(0, 5));
            if (first == null || target == null) {
                return;
            }
            if (first.getClass().equals(target.getClass())) {
                target = forceDifferentClass(first, data);
            }

            List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
            list.add(new Pair<Object, Double>(first, Double.valueOf(sampledIndex == 0 ? 1.0 : 0.0)));

            for (int i = 1; i < size; i++) {
                Object value;
                if (i == sampledIndex) {
                    value = target;
                } else {
                    value = makeObject(data, data.consumeInt(0, 5));
                    if (value == null) {
                        value = Integer.valueOf(i);
                    }
                }
                list.add(new Pair<Object, Double>(value, Double.valueOf(i == sampledIndex ? 1.0 : 0.0)));
            }

            int sampleSize = data.consumeInt(1, 8);
            new DiscreteDistribution<Object>(list).sample(sampleSize);
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        } catch (NotStrictlyPositiveException e) {
            return;
        }

        try {
            List<Pair<Object, Double>> det = new ArrayList<Pair<Object, Double>>();
            det.add(new Pair<Object, Double>("fixed", Double.valueOf(1.0)));
            DiscreteDistribution<Object> d = new DiscreteDistribution<Object>(det);
            Object one = d.sample();
            Object[] many = d.sample(1);
            if (many == null || many.length != 1 || many[0] == null || !one.equals(many[0])) {
                throw new RuntimeException("metamorphic violation: deterministic distribution sample() must match sample(1)[0]");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        } catch (NotStrictlyPositiveException e) {
            return;
        }
    }

    private static Object makeObject(FuzzedDataProvider data, int kind) {
        switch (kind) {
            case 0:
                return Integer.valueOf(data.consumeInt());
            case 1:
                return Long.valueOf((long) data.consumeInt());
            case 2:
                return Double.valueOf((double) data.consumeInt());
            case 3:
                return data.consumeString(16);
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            default:
                return data.consumeBytes(8);
        }
    }

    private static Object forceDifferentClass(Object first, FuzzedDataProvider data) {
        if (first instanceof Integer) {
            return data.consumeString(16);
        }
        if (first instanceof String) {
            return Integer.valueOf(data.consumeInt());
        }
        if (first instanceof Long) {
            return Boolean.valueOf(data.consumeBoolean());
        }
        if (first instanceof Double) {
            return data.consumeBytes(8);
        }
        if (first instanceof Boolean) {
            return Long.valueOf((long) data.consumeInt());
        }
        return Double.valueOf((double) data.consumeInt());
    }
}
