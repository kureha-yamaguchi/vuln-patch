    }

    private static void exploreCategoryPlot(FuzzedDataProvider data) {
        CategoryPlot plot = new CategoryPlot();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean useRange = data.consumeBoolean();
        boolean preAdd = data.consumeBoolean();
        boolean useIndexOverload = data.consumeBoolean();
        int index = data.consumeInt(-3, 3);
        boolean notify = data.consumeBoolean();

        if (useRange) {
            ValueMarker marker = new ValueMarker(data.consumeInt());
            if (preAdd) {
                plot.addRangeMarker(marker, layer);
            }
            if (useIndexOverload) {
                plot.removeRangeMarker(index, marker, layer, notify);
            } else {
                plot.removeRangeMarker(marker, layer);
            }
        } else {
            CategoryMarker marker = new CategoryMarker(data.consumeString(32));
            if (preAdd) {
                plot.addDomainMarker(marker, layer);
            }
            if (useIndexOverload) {
                plot.removeDomainMarker(index, marker, layer, notify);
            } else {
                plot.removeDomainMarker(marker, layer);
            }
        }
    }

    private static void exploreXYPlot(FuzzedDataProvider data) {
        XYPlot plot = new XYPlot();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean useRange = data.consumeBoolean();
        boolean preAdd = data.consumeBoolean();
        boolean useIndexOverload = data.consumeBoolean();
        int index = data.consumeInt(-3, 3);
        boolean notify = data.consumeBoolean();
        ValueMarker marker = new ValueMarker(data.consumeInt());

        if (useRange) {
            if (preAdd) {
                plot.addRangeMarker(marker, layer);
            }
            if (useIndexOverload) {
                plot.removeRangeMarker(index, marker, layer, notify);
            } else {
                plot.removeRangeMarker(marker, layer);
            }
