package org.apache.commons.math3.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import org.apache.commons.math3.exception.MathArithmeticException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.NotStrictlyPositiveException;
import org.apache.commons.math3.util.Pair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        List<Pair<Object, Double>> anchor = new ArrayList<Pair<Object, Double>>();
        anchor.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(0.0)));
        anchor.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(1.0)));
        new DiscreteDistribution<Object>(anchor).sample(1);

        try {
            int total = data.consumeInt(2, 8);
            int winner = data.consumeInt(1, total - 1);
            int sampleSize = data.consumeInt(1, 32);

            List<Pair<Object, Double>> fuzzList = new ArrayList<Pair<Object, Double>>(total);
            for (int i = 0; i < total; i++) {
                Object singleton = makeObject(data, i == 0 ? 0 : data.consumeInt(0, 7));
                double p = (i == winner) ? 1.0 : 0.0;
                fuzzList.add(new Pair<Object, Double>(singleton, Double.valueOf(p)));
            }

            new DiscreteDistribution<Object>(fuzzList).sample(sampleSize);
        } catch (NotStrictlyPositiveException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        }

        double mean = data.consumeInt(-1000000, 1000000) / 1000.0;
        double sd = (data.consumeInt(1, 1000000)) / 1000.0;
        double p = data.consumeInt(1, 999999) / 1000000.0;

        try {
            NormalDistribution nd = new NormalDistribution(mean, sd);
            nd.getSupportLowerBound();
            nd.getSupportUpperBound();
            nd.getNumericalMean();
            nd.getNumericalVariance();
            nd.isSupportConnected();
            double x = nd.inverseCumulativeProbability(p);
            double roundTrip = nd.cumulativeProbability(x);
            if (Math.abs(roundTrip - p) > 1e-9) {
                throw new RuntimeException("metamorphic violation: cumulativeProbability(inverseCumulativeProbability(p)) != p");
            }
        } catch (NotStrictlyPositiveException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        }
    }

    private static Object makeObject(FuzzedDataProvider data, int selector) {
        switch (selector & 7) {
            case 0:
                return Integer.valueOf(data.consumeInt());
            case 1:
                return Long.valueOf(data.consumeInt());
            case 2:
                return data.consumeString(32);
            case 3:
                return new BigInteger(1, atLeastOneByte(data.consumeBytes(8)));
            case 4:
                return new Date((long) data.consumeInt());
            case 5:
                return Boolean.valueOf(data.consumeBoolean());
            case 6:
                return Byte.valueOf(data.consumeByte());
            default:
                return new StringBuilder(data.consumeAsciiString(16)).toString();
        }
    }

    private static byte[] atLeastOneByte(byte[] in) {
        if (in != null && in.length > 0) {
            return in;
        }
        return new byte[] { 1 };
    }
}
