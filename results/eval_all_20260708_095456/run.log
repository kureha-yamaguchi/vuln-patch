package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        StringEscapeUtils.escapeCsv("\uD83D\uDE30");
        StringEscapeUtils.escapeCsv("\uD800\uDC00");
        StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        String explore = buildExplorationInput(data);
        try {
            StringEscapeUtils.escapeCsv(explore);
        } catch (IllegalArgumentException e) {
            return;
        }

        String a = buildCsvSafeSupplementaryString(data, 16);
        String b = buildCsvSafeSupplementaryString(data, 16);
        try {
            String left = StringEscapeUtils.escapeCsv(a + b);
            String right = StringEscapeUtils.escapeCsv(a) + StringEscapeUtils.escapeCsv(b);
            if (!left.equals(right)) {
                throw new RuntimeException("metamorphic violation: composition");
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        String base = data.consumeString(32);
        if (base == null) {
            base = "";
        }
        StringBuilder sb = new StringBuilder(base);
        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            String pair = new String(Character.toChars(randomSupplementaryCodePoint(data)));
            int pos = data.consumeInt(0, sb.length());
            sb.insert(pos, pair);
        }
        return sb.toString();
    }

    private static String buildCsvSafeSupplementaryString(FuzzedDataProvider data, int maxAsciiLen) {
        String left = sanitizeCsvSpecials(data.consumeAsciiString(maxAsciiLen));
        String right = sanitizeCsvSpecials(data.consumeAsciiString(maxAsciiLen));
        StringBuilder sb = new StringBuilder(left);
        int pairCount = data.consumeInt(1, 3);
        for (int i = 0; i < pairCount; i++) {
            sb.append(Character.toChars(randomSupplementaryCodePoint(data)));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSpecials(data.consumeAsciiString(4)));
            }
        }
        sb.append(right);
        return sb.toString();
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        int cp;
        do {
            cp = data.consumeInt(0x10000, 0x10FFFF);
        } while (!Character.isValidCodePoint(cp));
        return cp;
    }

    private static String sanitizeCsvSpecials(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
