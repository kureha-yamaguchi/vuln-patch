import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double anchorResult = anchor.inverseCumulativeProbability(0.9772498680518209);
            if (Math.abs(anchorResult - 2.0) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: inverse(CDF(2)) != 2 for anchor");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        int meanNum = data.consumeInt(-1000000, 1000000);
        int meanDen = data.consumeInt(1, 1000000);
        double mean = meanNum / (double) meanDen;

        int sdNum = data.consumeInt(1, 1000000);
        int sdDen = data.consumeInt(1, 1000000);
        double sd = sdNum / (double) sdDen;

        if (!Double.isFinite(mean) || !Double.isFinite(sd) || sd <= 0.0) {
            return;
        }

        try {
            NormalDistribution dist = new NormalDistributionImpl(mean, sd);

            double x = mean + (2.0 * sd);
            double p = dist.cumulativeProbability(x);
            if (!Double.isFinite(x) || !Double.isFinite(p) || p <= 0.0 || p >= 1.0) {
                return;
            }

            double inv = dist.inverseCumulativeProbability(p);

            double tolX = Math.max(1.0e-12 * (1.0 + Math.abs(x)), 64.0 * Math.ulp(x));
            if (!(Math.abs(inv - x) <= tolX)) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(x)) != x");
            }

            double roundTripP = dist.cumulativeProbability(inv);
            double tolP = Math.max(1.0e-12, 64.0 * Math.ulp(p));
            if (!(Math.abs(roundTripP - p) <= tolP)) {
                throw new RuntimeException("metamorphic violation: cdf(inverse(p)) != p");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }
    }
}
