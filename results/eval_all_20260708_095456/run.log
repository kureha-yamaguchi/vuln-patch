public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (NumberFormatException ignored) {
            return;
        }

        String knownBug = "0Xfade";
        try {
            Number expected = Integer.decode(knownBug);
            Number actual = NumberUtils.createNumber(knownBug);
            if (actual == null || actual.intValue() != expected.intValue()) {
                throw new RuntimeException("metamorphic violation: createNumber(0X...) must match Integer.decode");
            }
        } catch (NumberFormatException e) {
            throw e;
        }

        String prefix = data.consumeBoolean() ? "-" : "";
        String hexDigits = data.consumeAsciiString(32);
        if (hexDigits.length() == 0) {
            hexDigits = "0";
        }

        StringBuilder filtered = new StringBuilder();
        for (int i = 0; i < hexDigits.length(); i++) {
            char c = hexDigits.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                filtered.append(c);
            }
        }
        if (filtered.length() == 0) {
            filtered.append('0');
        }

        int extraZeros = data.consumeInt(0, 8);
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < extraZeros; i++) {
            digits.append('0');
        }
        digits.append(filtered);

        String candidate = prefix + "0X" + digits.toString();

        try {
            Integer decoded = Integer.decode(candidate);
            Number parsed = NumberUtils.createNumber(candidate);
            if (parsed == null || parsed.intValue() != decoded.intValue()) {
                throw new RuntimeException("metamorphic violation: createNumber(0X...) must match Integer.decode");
            }
        } catch (NumberFormatException e) {
            try {
                Integer.decode(candidate);
                throw e;
            } catch (NumberFormatException ignored) {
            }
        }

        String lowerEquivalent = candidate.replace("0X", "0x");
        try {
            Number upper = NumberUtils.createNumber(candidate);
            Number lower = NumberUtils.createNumber(lowerEquivalent);
            if (upper != null && lower != null && upper.intValue() != lower.intValue()) {
                throw new RuntimeException("metamorphic violation: 0X and 0x forms must be equivalent");
            }
        } catch (NumberFormatException ignored) {
        }

        String decimalish = data.consumeString(32);
        try {
            NumberUtils.createNumber(decimalish);
        } catch (NumberFormatException ignored) {
        }
    }
