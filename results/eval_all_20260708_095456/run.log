package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.chart.util.Size2D;
import org.jfree.data.Range;

public class FuzzHarness {
    private static final class Spec {
        final boolean top;
        final boolean bottom;
        final boolean left;
        final boolean right;
        final boolean center;
        final double topW;
        final double topH;
        final double bottomW;
        final double bottomH;
        final double leftW;
        final double leftH;
        final double rightW;
        final double rightH;
        final double centerW;
        final double centerH;

        Spec(
                boolean top, boolean bottom, boolean left, boolean right, boolean center,
                double topW, double topH,
                double bottomW, double bottomH,
                double leftW, double leftH,
                double rightW, double rightH,
                double centerW, double centerH) {
            this.top = top;
            this.bottom = bottom;
            this.left = left;
            this.right = right;
            this.center = center;
            this.topW = topW;
            this.topH = topH;
            this.bottomW = bottomW;
            this.bottomH = bottomH;
            this.leftW = leftW;
            this.leftH = leftH;
            this.rightW = rightW;
            this.rightH = rightH;
            this.centerW = centerW;
            this.centerH = centerH;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            runAnchorFromTest(g2);
            runGuaranteedCrashAnchor(g2);
            runExplore(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchorFromTest(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());

        EmptyBlock center1 = new EmptyBlock(5.0, 6.0);
        center1.getWidth();
        container.add(center1);
        container.getBlocks();
        container.arrange(g2, constraint);

        container.clear();
        EmptyBlock center2 = new EmptyBlock(15.0, 16.0);
        center2.getWidth();
        container.add(center2);
        container.getBlocks();
        container.arrange(g2, constraint);

        container.clear();
        EmptyBlock rightOnly = new EmptyBlock(12.3, 45.6);
        rightOnly.getWidth();
        container.add(rightOnly, RectangleEdge.RIGHT);
        container.getBlocks();
        container.arrange(g2, constraint);
    }

    private static void runGuaranteedCrashAnchor(Graphics2D g2) {
        BlockContainer container = new BlockContainer(new BorderArrangement());
        EmptyBlock top = new EmptyBlock(1.0, 2.3);
        EmptyBlock bottom = new EmptyBlock(1.0, 1.0);
        top.getWidth();
        bottom.getWidth();
        container.add(top, RectangleEdge.TOP);
        container.add(bottom, RectangleEdge.BOTTOM);
        container.getBlocks();

        RectangleConstraint ff = new RectangleConstraint(10.0, 0.0);
        container.arrange(g2, ff);
    }

    private static void runExplore(FuzzedDataProvider data, Graphics2D g2) {
        double fixedWidth = scaled(data.consumeInt(0, 300));
        double fixedHeight = scaled(data.consumeInt(0, 200));

        double topHeight = fixedHeight + scaled(data.consumeInt(1, 300));
        double topWidth = scaled(data.consumeInt(0, 300));
        double bottomWidth = scaled(data.consumeInt(0, 300));
        double bottomHeight = scaled(data.consumeInt(0, 300));

        Spec spec = new Spec(
                true,
                true,
                data.consumeBoolean(),
                data.consumeBoolean(),
                data.consumeBoolean(),
                topWidth, topHeight,
                bottomWidth, bottomHeight,
                scaled(data.consumeInt(0, 300)), scaled(data.consumeInt(0, 300)),
                scaled(data.consumeInt(0, 300)), scaled(data.consumeInt(0, 300)),
                scaled(data.consumeInt(0, 300)), scaled(data.consumeInt(0, 300))
        );

        BlockContainer explored = build(spec);
        RectangleConstraint ff = new RectangleConstraint(fixedWidth, fixedHeight);
        explored.getBlocks();
        explored.arrange(g2, ff);

        runMetamorphic(spec, fixedWidth, g2);
    }

    private static void runMetamorphic(Spec spec, double fixedWidth, Graphics2D g2) {
        RectangleConstraint fn = new RectangleConstraint(
                fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer c1 = build(spec);
        Size2D naturalAtWidth;
        try {
            naturalAtWidth = c1.arrange(g2, fn);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        RectangleConstraint ff = new RectangleConstraint(fixedWidth, naturalAtWidth.getHeight());
        BlockContainer c2 = build(spec);
        Size2D fixedAtNaturalHeight;
        try {
            fixedAtNaturalHeight = c2.arrange(g2, ff);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        if (Double.compare(naturalAtWidth.getWidth(), fixedAtNaturalHeight.getWidth()) != 0
                || Double.compare(naturalAtWidth.getHeight(), fixedAtNaturalHeight.getHeight()) != 0) {
            throw new RuntimeException("metamorphic violation: width-fixed/none must equal width-fixed/fixed-at-natural-height");
        }
    }

    private static BlockContainer build(Spec s) {
        BlockContainer container = new BlockContainer(new BorderArrangement());
        if (s.top) {
            EmptyBlock b = new EmptyBlock(s.topW, s.topH);
            b.getWidth();
            container.add(b, RectangleEdge.TOP);
        }
        if (s.bottom) {
            EmptyBlock b = new EmptyBlock(s.bottomW, s.bottomH);
            b.getWidth();
            container.add(b, RectangleEdge.BOTTOM);
        }
        if (s.left) {
            EmptyBlock b = new EmptyBlock(s.leftW, s.leftH);
            b.getWidth();
            container.add(b, RectangleEdge.LEFT);
        }
        if (s.right) {
            EmptyBlock b = new EmptyBlock(s.rightW, s.rightH);
            b.getWidth();
            container.add(b, RectangleEdge.RIGHT);
        }
        if (s.center) {
            EmptyBlock b = new EmptyBlock(s.centerW, s.centerH);
            b.getWidth();
            container.add(b);
        }
        container.getBlocks();
        return container;
    }

    private static double scaled(int v) {
        return v / 10.0;
    }
}
