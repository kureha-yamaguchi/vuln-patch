package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.HashMap;
import java.util.Map;

public class FuzzHarness {
    private static final Map EMPTY_REGISTRY = new HashMap();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runPattern("it''s a {0,lower} 'test'!", false);

        String prefix = escapeQuotes(data.consumeAsciiString(32));
        String suffix = escapeQuotes(data.consumeAsciiString(32));
        String middle = escapeQuotes(data.consumeAsciiString(32));
        int style = data.consumeInt(0, 5);

        String pattern;
        switch (style) {
            case 0:
                pattern = prefix + "''" + suffix;
                break;
            case 1:
                pattern = prefix + "''" + suffix + " {0}";
                break;
            case 2:
                pattern = prefix + "''" + " {" + Math.abs(data.consumeInt() % 3) + "}";
                break;
            case 3:
                pattern = prefix + " '" + middle + "' " + "''" + suffix;
                break;
            case 4:
                pattern = "{" + Math.abs(data.consumeInt() % 3) + "}" + prefix + "''" + suffix;
                break;
            default:
                pattern = prefix + "''" + " a {" + Math.abs(data.consumeInt() % 3) + ",lower} '" + middle + "'!" + suffix;
                break;
        }

        runPattern(pattern, true);

        String metaPattern = prefix + "''" + suffix + " {0}";
        try {
            ExtendedMessageFormat emf1 = new ExtendedMessageFormat(metaPattern, EMPTY_REGISTRY);
            String canonical1 = emf1.toPattern();
            String formatted1 = emf1.format(new Object[] { middle });

            ExtendedMessageFormat emf2 = new ExtendedMessageFormat(canonical1, EMPTY_REGISTRY);
            String canonical2 = emf2.toPattern();
            String formatted2 = emf2.format(new Object[] { middle });

            if (!canonical1.equals(canonical2) || !formatted1.equals(formatted2)) {
                throw new RuntimeException("metamorphic violation: applyPattern/toPattern idempotence");
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static void runPattern(String pattern, boolean formatIfAccepted) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, EMPTY_REGISTRY);
            if (formatIfAccepted) {
                emf.format(new Object[] { "x", "y", "z" });
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static String escapeQuotes(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        return s.replace("'", "''");
    }
}
