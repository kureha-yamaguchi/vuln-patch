    private static void anchor() {
        List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>();
        list.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(0)));
        list.add(new Pair<Object, Double>(new Object() {}, Double.valueOf(1)));
        new DiscreteDistribution<Object>(list).sample(1);
    }

    private static void explore(FuzzedDataProvider data) {
        int size = data.consumeInt(2, 8);
        int targetIndex = data.consumeInt(1, size - 1);
        int sampleSize = data.consumeInt(1, 8);
        String s1 = data.consumeString(24);
        String s2 = data.consumeAsciiString(24);

        Object first = variedObject(data.consumeInt(), s1, 1);
        Object target = variedObject(data.consumeInt(), s2, 2);
        if (first.getClass().equals(target.getClass())) {
            target = forceDifferentClass(first, s2);
        }

        List<Pair<Object, Double>> list = new ArrayList<Pair<Object, Double>>(size);
        for (int i = 0; i < size; i++) {
            Object value;
            double probability;
            if (i == 0) {
                value = first;
                probability = 0.0d;
            } else if (i == targetIndex) {
                value = target;
                probability = 1.0d;
            } else {
                value = variedObject(data.consumeInt(), data.consumeString(12), i + 3);
                probability = 0.0d;
            }
            list.add(new Pair<Object, Double>(value, Double.valueOf(probability)));
        }

        new DiscreteDistribution<Object>(list).sample(sampleSize);
    }

    private static void metamorphicCheck() {
        Object singleton = new StringBuilder("singleton");
        List<Pair<Object, Double>> one = new ArrayList<Pair<Object, Double>>();
        one.add(new Pair<Object, Double>(singleton, Double.valueOf(1.0d)));
        DiscreteDistribution<Object> dist = new DiscreteDistribution<Object>(one);

        Object direct = dist.sample();
        Object[] many = dist.sample(3);

        if (many.length != 3 || many[0] != direct || many[1] != direct || many[2] != direct) {
            throw new RuntimeException("metamorphic violation: degenerate distribution sample(int) must match repeated sample()");
        }
    }

    private static Object variedObject(int selector, String s, int salt) {
        switch (Math.abs(selector % 8)) {
            case 0:
                return s;
            case 1:
                return Integer.valueOf(salt);
            case 2:
                return Double.valueOf(salt + 0.5d);
            case 3:
                return Long.valueOf(1000L + salt);
            case 4:
                return new StringBuilder(s);
            case 5:
                return new ArrayList<Object>();
            case 6:
                return new byte[] { (byte) salt };
            default:
                return Boolean.valueOf((salt & 1) == 0);
        }
    }

    private static Object forceDifferentClass(Object first, String s) {
        if (!(first instanceof String)) {
            return s + "x";
        }
        return Integer.valueOf(42);
    }
