package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map NON_NULL_REGISTRY = new HashMap();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        new ExtendedMessageFormat("it''s a {0,lower} 'test'!", Locale.getDefault(), NON_NULL_REGISTRY);

        String left = data.consumeAsciiString(32);
        String right = data.consumeAsciiString(32);
        String tail = data.consumeRemainingAsString();

        String pattern = buildPattern(left, right, tail, data.consumeBoolean(), data.consumeBoolean());
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.getDefault(), NON_NULL_REGISTRY);
            String p1 = emf.toPattern();
            ExtendedMessageFormat emf2 = new ExtendedMessageFormat(p1, Locale.getDefault(), NON_NULL_REGISTRY);
            String p2 = emf2.toPattern();
            if (!p1.equals(p2)) {
                throw new RuntimeException("metamorphic violation: toPattern idempotence");
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static String buildPattern(String left, String right, String tail, boolean withArg, boolean wrapTrailingQuote) {
        StringBuilder sb = new StringBuilder(left.length() + right.length() + tail.length() + 16);
        sb.append(left);
        sb.append("''");
        sb.append(right);
        if (withArg) {
            sb.append(" {0}");
        }
        if (wrapTrailingQuote) {
            sb.append(" '");
            sb.append(tail);
            sb.append('\'');
        } else {
            sb.append(tail);
        }
        return sb.toString();
    }
}
