package org.apache.commons.math.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorBig();
        anchorReal();

        int cols = data.consumeInt(1, 6);
        int rows;
        if (data.consumeBoolean()) {
            rows = data.consumeInt(cols + 1, cols + 6);
        } else {
            rows = data.consumeInt(1, 6);
        }

        BigMatrixImpl bigA;
        RealMatrixImpl realA;
        try {
            bigA = new BigMatrixImpl(makeBigData(data, rows, cols), false);
            realA = new RealMatrixImpl(makeRealData(data, rows, cols), false);
        } catch (IllegalArgumentException e) {
            return;
        }

        int bigRows = bigA.getRowDimension();
        int bigCols = bigA.getColumnDimension();
        int realRows = realA.getRowDimension();
        int realCols = realA.getColumnDimension();

        try {
            BigDecimal[] bigVec = makeBigVector(data, bigCols);
            double[] realVec = makeRealVector(data, realCols);

            BigDecimal[] bigOut = bigA.operate(bigVec);
            double[] realOut = realA.operate(realVec);

            if (bigOut.length != bigRows) {
                throw new RuntimeException("metamorphic violation: BigMatrixImpl operate result length");
            }
            if (realOut.length != realRows) {
                throw new RuntimeException("metamorphic violation: RealMatrixImpl operate result length");
            }
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            BigMatrixImpl bigI = identityBig(bigCols);
            RealMatrixImpl realI = identityReal(realCols);

            BigMatrixImpl bigProd = bigA.multiply(bigI);
            RealMatrixImpl realProd = realA.multiply(realI);

            if (bigProd.getRowDimension() != bigA.getRowDimension()
                    || bigProd.getColumnDimension() != bigA.getColumnDimension()) {
                throw new RuntimeException("metamorphic violation: BigMatrixImpl A*I dimensions");
            }
            if (realProd.getRowDimension() != realA.getRowDimension()
                    || realProd.getColumnDimension() != realA.getColumnDimension()) {
                throw new RuntimeException("metamorphic violation: RealMatrixImpl A*I dimensions");
            }

            for (int r = 0; r < bigRows; r++) {
                for (int c = 0; c < bigCols; c++) {
                    if (bigProd.getEntry(r, c).compareTo(bigA.getEntry(r, c)) != 0) {
                        throw new RuntimeException("metamorphic violation: BigMatrixImpl A*I == A");
                    }
                }
            }
            for (int r = 0; r < realRows; r++) {
                for (int c = 0; c < realCols; c++) {
                    if (realProd.getEntry(r, c) != realA.getEntry(r, c)) {
                        throw new RuntimeException("metamorphic violation: RealMatrixImpl A*I == A");
                    }
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static void anchorBig() {
        BigMatrixImpl a = new BigMatrixImpl(new BigDecimal[][] {
                { new BigDecimal(1), new BigDecimal(2) },
                { new BigDecimal(3), new BigDecimal(4) },
                { new BigDecimal(5), new BigDecimal(6) }
        }, false);
        BigDecimal[] b = a.operate(new BigDecimal[] { BigDecimal.ONE, BigDecimal.ONE });
        if (b.length != a.getRowDimension()) {
            throw new RuntimeException("metamorphic violation: anchor BigMatrixImpl operate length");
        }
        BigMatrixImpl prod = a.multiply(identityBig(a.getColumnDimension()));
        if (prod.getRowDimension() != a.getRowDimension() || prod.getColumnDimension() != a.getColumnDimension()) {
            throw new RuntimeException("metamorphic violation: anchor BigMatrixImpl A*I dimensions");
        }
    }

    private static void anchorReal() {
        RealMatrixImpl a = new RealMatrixImpl(new double[][] {
                { 1, 2 },
                { 3, 4 },
                { 5, 6 }
        }, false);
        double[] b = a.operate(new double[] { 1, 1 });
        if (b.length != a.getRowDimension()) {
            throw new RuntimeException("metamorphic violation: anchor RealMatrixImpl operate length");
        }
        RealMatrixImpl prod = a.multiply(identityReal(a.getColumnDimension()));
        if (prod.getRowDimension() != a.getRowDimension() || prod.getColumnDimension() != a.getColumnDimension()) {
            throw new RuntimeException("metamorphic violation: anchor RealMatrixImpl A*I dimensions");
        }
    }

    private static BigDecimal[][] makeBigData(FuzzedDataProvider data, int rows, int cols) {
        BigDecimal[][] out = new BigDecimal[rows][cols];
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                out[r][c] = new BigDecimal(data.consumeInt(-10, 10));
            }
        }
        return out;
    }

    private static double[][] makeRealData(FuzzedDataProvider data, int rows, int cols) {
        double[][] out = new double[rows][cols];
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                out[r][c] = data.consumeInt(-10, 10);
            }
