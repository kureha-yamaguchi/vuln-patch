            } catch (MathException e) {
                sneakyThrow(e);
            }
        }

        double mean = data.consumeInt(-1000, 1000) + (data.consumeInt(-1024, 1024) / 1024.0);

        int sdBase = data.consumeInt(-32, 32);
        int sdDiv = data.consumeInt(1, 32);
        double sd = sdBase / (double) sdDiv;
        if (data.consumeBoolean()) {
            sd = Math.abs(sd) + 1.0 / sdDiv;
        }

        final NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, sd);
        } catch (IllegalArgumentException e) {
            return;
        }

        double rawP = data.consumeInt(-1000, 2000) / 1000.0;
        try {
            dist.inverseCumulativeProbability(rawP);
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            if (rawP < 0.0 || rawP > 1.0) {
                return;
            }
            sneakyThrow(e);
            return;
        }

        int xInt = data.consumeInt(-8, 8);
        int xFrac = data.consumeInt(-1024, 1024);
        double x = xInt + (xFrac / 1024.0);

        final double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (MathException e) {
            sneakyThrow(e);
            return;
        }

        if (p <= 0.0 || p >= 1.0 || Double.isNaN(p)) {
            return;
        }

        final double inv;
        try {
            inv = dist.inverseCumulativeProbability(p);
        } catch (MathException e) {
            sneakyThrow(e);
            return;
        }

        try {
            double roundTripP = dist.cumulativeProbability(inv);
            if (Math.abs(roundTripP - p) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: cumulativeProbability(inverseCumulativeProbability(p)) != p");
            }
        } catch (MathException e) {
            sneakyThrow(e);
        }
    }

