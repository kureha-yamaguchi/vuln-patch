package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.distribution.BinomialDistribution;
import org.apache.commons.math3.distribution.FDistribution;
import org.apache.commons.math3.exception.MathIllegalArgumentException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorFDistribution();
        runAnchorBinomial();

        int mode = data.consumeInt(0, 2);
        if (mode == 0) {
            exploreFDistributionEqualLarge(data);
        } else if (mode == 1) {
            exploreBinomialLargeHalf(data);
        } else {
            exploreBoth(data);
        }

        metamorphicReciprocalF(data);
    }

    private static void runAnchorFDistribution() {
        FDistribution f = new FDistribution(200000.0, 200000.0);
        double result = f.inverseCumulativeProbability(0.01);
        if (Double.isNaN(result) || Double.isInfinite(result)) {
            throw new RuntimeException("invalid F inverse result for anchor");
        }
    }

    private static void runAnchorBinomial() {
        BinomialDistribution dist = new BinomialDistribution(500000, 0.5);
        int p = dist.inverseCumulativeProbability(0.5);
        if (p != 250000) {
            throw new RuntimeException("anchor binomial median mismatch");
        }
    }

    private static void exploreFDistributionEqualLarge(FuzzedDataProvider data) {
        int base = 150000 + data.consumeInt(0, 900000);
        int delta = data.consumeInt(0, 128);
        double numeratorDf = base;
        double denominatorDf = data.consumeBoolean() ? base : (base + delta);

        int probSelector = data.consumeInt(0, 5);
        double prob;
        switch (probSelector) {
            case 0:
                prob = 0.01;
                break;
            case 1:
                prob = 0.5;
                break;
            case 2:
                prob = 0.99;
                break;
            case 3:
                prob = 1e-6;
                break;
            case 4:
                prob = 1.0 - 1e-6;
                break;
            default:
                prob = (data.consumeInt(1, 999999)) / 1000000.0;
                break;
        }

        try {
            FDistribution f = new FDistribution(numeratorDf, denominatorDf);
            double x = f.inverseCumulativeProbability(prob);
            if (Double.isNaN(x) || x < 0.0) {
                throw new RuntimeException("invalid F inverse result");
            }
            double cdf = f.cumulativeProbability(x);
            if (Double.isNaN(cdf) || cdf < 0.0 || cdf > 1.0) {
                throw new RuntimeException("invalid F cdf result");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }

    private static void exploreBinomialLargeHalf(FuzzedDataProvider data) {
        int trials = 500000 + data.consumeInt(0, 4000000);
        double q = 0.5;
        double prob = data.consumeBoolean() ? 0.5 : (data.consumeInt(1, 999999) / 1000000.0);

        try {
            BinomialDistribution dist = new BinomialDistribution(trials, q);
            int x = dist.inverseCumulativeProbability(prob);
            if (x < -1 || x > trials) {
                throw new RuntimeException("invalid binomial inverse result");
            }
            double cdf = dist.cumulativeProbability(Math.max(0, Math.min(trials, x)));
            if (Double.isNaN(cdf) || cdf < 0.0 || cdf > 1.0) {
                throw new RuntimeException("invalid binomial cdf result");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }

    private static void exploreBoth(FuzzedDataProvider data) {
        exploreFDistributionEqualLarge(data);
        exploreBinomialLargeHalf(data);
    }

    private static void metamorphicReciprocalF(FuzzedDataProvider data) {
        double d1 = 1.0 + data.consumeInt(1, 500000);
        double d2 = 1.0 + data.consumeInt(1, 500000);
        double p = data.consumeInt(1, 999999) / 1000000.0;

        try {
            FDistribution f12 = new FDistribution(d1, d2);
            FDistribution f21 = new FDistribution(d2, d1);

            double x = f12.inverseCumulativeProbability(p);
            double y = f21.inverseCumulativeProbability(1.0 - p);

            if (Double.isNaN(x) || Double.isNaN(y) ||
                Double.isInfinite(x) || Double.isInfinite(y) ||
                x <= 0.0 || y <= 0.0) {
                throw new RuntimeException("metamorphic violation: reciprocal quantiles not finite positive");
            }

            double product = x * y;
            double relErr = Math.abs(product - 1.0);
            if (relErr > 1e-8 && relErr / Math.max(1.0, Math.abs(product)) > 1e-8) {
                throw new RuntimeException("metamorphic violation: F(d1,d2)^-1(p) * F(d2,d1)^-1(1-p) != 1");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }
}
