        anchorDomainPlot.removeDomainMarker(new ValueMarker(0.5));

        int targetIndex = data.consumeInt(-3, 3);
        Layer targetLayer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean notify = data.consumeBoolean();

        ValueMarker domainMarker = new ValueMarker(data.consumeInt());
        ValueMarker rangeMarker = new ValueMarker(data.consumeInt());

        XYPlot exploredPlot = new XYPlot();

        int decorations = data.consumeInt(0, 4);
        for (int i = 0; i < decorations; i++) {
            int otherIndex = data.consumeInt(-3, 3);
            Layer otherLayer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
            ValueMarker extra = new ValueMarker(data.consumeInt());

            if (otherIndex == targetIndex && otherLayer == targetLayer) {
                if (otherLayer == Layer.FOREGROUND) {
                    otherLayer = Layer.BACKGROUND;
                } else {
                    otherLayer = Layer.FOREGROUND;
                }
