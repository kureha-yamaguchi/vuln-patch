            }
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (NotStrictlyPositiveException e) {
            return;
        }
    }

    private static Object makeDifferentClassObject(FuzzedDataProvider data, Object first) {
        for (int i = 0; i < 8; i++) {
            Object candidate = makeObject(data);
            if (!first.getClass().equals(candidate.getClass())) {
                return candidate;
            }
        }
        if (!(first instanceof String)) {
            return "fallback";
        }
        return Integer.valueOf(1);
    }

    private static Object makeObject(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 6)) {
