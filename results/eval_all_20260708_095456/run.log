package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.GregorianCalendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int count = data.consumeInt(2, 8);
        int[] epochDays = new int[count];
        int base = data.consumeInt(-20000, 20000);
        int gapIndex = data.consumeInt(0, count - 2);
        epochDays[0] = base;
        for (int i = 1; i < count; i++) {
            int step = (i - 1 == gapIndex) ? data.consumeInt(2, 50) : data.consumeInt(1, 10);
            epochDays[i] = epochDays[i - 1] + step;
        }

        TimeSeries series = new TimeSeries(data.consumeString(20));
        for (int i = 0; i < count; i++) {
            try {
                series.add(dayFromEpochDay(epochDays[i]), data.consumeInt());
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }

        int left = epochDays[gapIndex];
        int right = epochDays[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startDay = left + data.consumeInt(1, right - left - 1);
        int endDay = left + data.consumeInt(startDay - left, right - left - 1);

        Day start = dayFromEpochDay(startDay);
        Day end = dayFromEpochDay(endDay);

        series.getIndex(start);
        series.getIndex(end);

        try {
            TimeSeries copy = series.createCopy(start, end);

            TimeSeries copyAgain = copy.createCopy(start, end);
            if (copy.getItemCount() != copyAgain.getItemCount()) {
                throw new RuntimeException("metamorphic violation: repeated createCopy changed itemCount");
            }
            for (int i = 0; i < copy.getItemCount(); i++) {
                if (!copy.getTimePeriod(i).equals(copyAgain.getTimePeriod(i))) {
                    throw new RuntimeException("metamorphic violation: repeated createCopy changed periods");
                }
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void anchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);
        try {
            s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException e) {
        }
    }

    private static boolean isRootCause(IllegalArgumentException e) {
        return "Requires start <= end.".equals(e.getMessage());
    }

    private static Day dayFromEpochDay(int epochDay) {
        Calendar c = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        c.clear();
        c.set(1970, Calendar.JANUARY, 1, 0, 0, 0);
        c.add(Calendar.DAY_OF_MONTH, epochDay);
        return new Day(c.getTime());
    }
}
