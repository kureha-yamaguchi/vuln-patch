package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryCreateNumber(anchors[i]);
        }

        String singleCharProbe = data.consumeBoolean() ? "l" : "L";
        tryCreateNumber(singleCharProbe);

        String fuzzAscii = data.consumeAsciiString(32);
        if (data.consumeBoolean()) {
            fuzzAscii = "";
        }
        String explored = buildExplorationInput(data, fuzzAscii);
        tryCreateNumber(explored);

        String integral = buildIntegralLikeInput(data);
        tryCreateNumber(integral);

        String floating = buildFloatingLikeInput(data);
        tryCreateNumber(floating);

        String hex = buildHexLikeInput(data);
        tryCreateNumber(hex);

        metamorphicLongSuffixCase(data);
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }
    }

    private static String buildExplorationInput(FuzzedDataProvider data, String fuzzAscii) {
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return fuzzAscii + (data.consumeBoolean() ? "l" : "L");
            case 2:
                return "-" + digitsFromInt(data.consumeInt()) + (data.consumeBoolean() ? "l" : "L");
            case 3:
                return digitsFromInt(data.consumeInt()) + "." + digitsFromInt(Math.abs(data.consumeInt())) + (data.consumeBoolean() ? "f" : "F");
            case 4:
                return digitsFromInt(data.consumeInt()) + "E" + data.consumeInt(-50, 50) + (data.consumeBoolean() ? "d" : "D");
            default:
                return fuzzAscii;
        }
    }

    private static String buildIntegralLikeInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 3);
        String digits = digitsFromInt(data.consumeInt());
        switch (mode) {
            case 0:
                return digits;
            case 1:
                return "-" + digits;
            case 2:
                return digits + (data.consumeBoolean() ? "l" : "L");
            default:
                return "12345678901234567890L";
        }
    }

    private static String buildFloatingLikeInput(FuzzedDataProvider data) {
        String left = digitsFromInt(Math.abs(data.consumeInt()));
        String right = digitsFromInt(Math.abs(data.consumeInt()));
        int exp = data.consumeInt(-400, 400);
        int mode = data.consumeInt(0, 4);
        switch (mode) {
            case 0:
                return left + "." + right;
            case 1:
                return "-" + left + "." + right;
            case 2:
                return left + "." + right + (data.consumeBoolean() ? "f" : "F");
            case 3:
                return left + "." + right + "E" + exp;
            default:
                return left + "." + right + "E" + exp + (data.consumeBoolean() ? "d" : "D");
        }
    }

    private static String buildHexLikeInput(FuzzedDataProvider data) {
        String hexDigits = Integer.toHexString(data.consumeInt());
        if (hexDigits.startsWith("-")) {
            hexDigits = hexDigits.substring(1);
        }
        if (hexDigits.length() == 0) {
            hexDigits = "0";
        }
        return data.consumeBoolean() ? "0x" + hexDigits : "-0x" + hexDigits;
    }

    private static String digitsFromInt(int value) {
        String s = Integer.toString(value);
        return s.startsWith("-") ? s.substring(1) : s;
    }

    private static void metamorphicLongSuffixCase(FuzzedDataProvider data) {
        int n = data.consumeInt();
        String base = Integer.toString(n);
        try {
            Number lower = NumberUtils.createNumber(base + "l");
            Number upper = NumberUtils.createNumber(base + "L");
            if (lower == null || upper == null) {
                return;
            }
            if (!lower.getClass().equals(upper.getClass()) || lower.longValue() != upper.longValue()) {
                throw new RuntimeException("metamorphic violation: createNumber(n + \"l\") != createNumber(n + \"L\")");
            }
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }
    }
