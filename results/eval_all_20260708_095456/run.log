package org.apache.commons.lang.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseExpectedValid("-1l");
        exerciseExpectedValid("01l");
        exerciseExpectedValid("1l");

        int mode = data.consumeInt(0, 7);
        String candidate;
        switch (mode) {
            case 0:
                candidate = buildValidLongSuffixCandidate(data, true, false);
                break;
            case 1:
                candidate = buildValidLongSuffixCandidate(data, false, false);
                break;
            case 2:
                candidate = buildValidLongSuffixCandidate(data, data.consumeBoolean(), true);
                break;
            case 3:
                candidate = data.consumeAsciiString(32);
                break;
            case 4:
                candidate = data.consumeString(32);
                break;
            case 5:
                candidate = buildFloatLikeCandidate(data);
                break;
            case 6:
                candidate = buildHexLikeCandidate(data);
                break;
            default:
                candidate = data.consumeRemainingAsString();
                break;
        }

        boolean looksLikePatchedProperty = isValidLongSuffixShape(candidate);

        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            if (looksLikePatchedProperty) {
                throw e;
            }
        } catch (NullPointerException e) {
            if (looksLikePatchedProperty) {
                throw e;
            }
        }

        if (looksLikePatchedProperty) {
            String upper = candidate.substring(0, candidate.length() - 1) + "L";
            Number lowerResult;
            Number upperResult;
            try {
                lowerResult = NumberUtils.createNumber(candidate);
                upperResult = NumberUtils.createNumber(upper);
            } catch (NumberFormatException e) {
                throw new RuntimeException("metamorphic violation: valid l/L forms must both parse", e);
            } catch (NullPointerException e) {
                throw new RuntimeException("metamorphic violation: valid l/L forms must both parse", e);
            }
            if (lowerResult == null || upperResult == null || !lowerResult.toString().equals(upperResult.toString())) {
                throw new RuntimeException("metamorphic violation: lowercase/uppercase long suffix equivalence");
            }
        }
    }

    private static void exerciseExpectedValid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
            throw e;
        } catch (NullPointerException e) {
            throw e;
        }
    }

    private static boolean isValidLongSuffixShape(String s) {
        if (s == null || s.length() < 2) {
            return false;
        }
        char last = s.charAt(s.length() - 1);
        if (last != 'l' && last != 'L') {
            return false;
        }
        String numeric = s.substring(0, s.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        if (numeric.indexOf('.') >= 0 || numeric.indexOf('e') >= 0 || numeric.indexOf('E') >= 0) {
            return false;
        }
        if (numeric.charAt(0) == '-') {
            return numeric.length() > 1 && NumberUtils.isDigits(numeric.substring(1));
        }
        return Character.isDigit(numeric.charAt(0)) && NumberUtils.isDigits(numeric);
    }

    private static String buildValidLongSuffixCandidate(FuzzedDataProvider data, boolean negative, boolean noisyLeadingZeros) {
        int digitsLen = data.consumeInt(1, 24);
        String digits = data.consumeAsciiString(digitsLen);
        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        boolean anyDigit = false;
        if (noisyLeadingZeros) {
            int zeros = data.consumeInt(0, 6);
            for (int i = 0; i < zeros; i++) {
                sb.append('0');
                anyDigit = true;
            }
        }
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
                anyDigit = true;
            } else {
                sb.append((char) ('0' + (c & 7)));
                anyDigit = true;
            }
        }
        if (!anyDigit || (negative && sb.length() == 1)) {
            sb.append('0');
        }
        sb.append(data.consumeBoolean() ? 'l' : 'L');
        return sb.toString();
    }

    private static String buildFloatLikeCandidate(FuzzedDataProvider data) {
        String left = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 12)));
        String right = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 12)));
        if (left.length() == 0) {
            left = "0";
        }
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(left);
        if (data.consumeBoolean()) {
            sb.append('.');
            sb.append(right);
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
            if (data.consumeBoolean()) {
                sb.append('-');
            }
            String exp = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 6)));
            sb.append(exp.length() == 0 ? "0" : exp);
        }
        if (data.consumeBoolean()) {
            char[] suffixes = new char[] {'f', 'F', 'd', 'D', 'l', 'L'};
            sb.append(suffixes[data.consumeInt(0, suffixes.length - 1)]);
        }
        return sb.toString();
    }

    private static String buildHexLikeCandidate(FuzzedDataProvider data) {
        String raw = data.consumeAsciiString(data.consumeInt(0, 16));
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append("0x");
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            int v = c & 15;
            if (v < 10) {
                sb.append((char) ('0' + v));
            } else {
                sb.append((char) ((data.consumeBoolean() ? 'A' : 'a') + (v - 10)));
            }
        }
        if (raw.length() == 0) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static String digitsOnly(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            sb.append((char) ('0' + (s.charAt(i) & 7)));
        }
        return sb.toString();
    }
}
