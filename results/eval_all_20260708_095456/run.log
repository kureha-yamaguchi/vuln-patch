    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseExactAnchor();

        double[] ys = buildExplorationInput(data);
        int xOffset = data.consumeInt(-50, 50);

        try {
            fitDataset(ys, xOffset, false);
        } catch (RuntimeException e) {
            if (isExpectedBoundaryRejection(e)) {
                return;
            }
            throw e;
        }

        try {
            double[] p1 = fitDataset(ys, xOffset, false);
            double[] p2 = fitDataset(ys, xOffset, true);
            if (p1 != null && p2 != null && !paramsClose(p1, p2)) {
                throw new RuntimeException("metamorphic violation: zero-weight observations changed fit");
            }
        } catch (RuntimeException e) {
            if (isExpectedBoundaryRejection(e)) {
                return;
            }
            throw e;
        }
    }

    private static void exerciseExactAnchor() {
        fitDataset(ANCHOR, 0, false);
    }

    private static double[] fitDataset(double[] ys, int xOffset, boolean addZeroWeightPoints) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ys.length; i++) {
            fitter.addObservedPoint(xOffset + i, ys[i]);
        }
        if (addZeroWeightPoints) {
            double leftX = xOffset - 10.0;
            double rightX = xOffset + ys.length + 10.0;
            double leftY = ys.length == 0 ? 0.0 : ys[0];
            double rightY = ys.length == 0 ? 0.0 : ys[ys.length - 1];
            fitter.addObservedPoint(0.0, leftX, leftY);
            fitter.addObservedPoint(0.0, rightX, rightY);
        }
        return fitter.fit();
    }

    private static double[] buildExplorationInput(FuzzedDataProvider data) {
        int start = data.consumeInt(0, ANCHOR.length - 3);
        int end = data.consumeInt(start + 3, ANCHOR.length);
        int prefix = data.consumeInt(0, 6);
        int suffix = data.consumeInt(0, 6);

        double[] ys = new double[prefix + (end - start) + suffix];

        double first = ANCHOR[start];
        for (int i = 0; i < prefix; i++) {
            int shift = data.consumeInt(0, 20);
            ys[i] = Math.scalb(first, -shift);
            if (!(ys[i] > 0.0) || Double.isNaN(ys[i]) || Double.isInfinite(ys[i])) {
                ys[i] = first;
            }
        }

        for (int i = start; i < end; i++) {
            double v = ANCHOR[i];
            int shift = data.consumeInt(-4, 4);
            double mutated = Math.scalb(v, shift);
            if (data.consumeBoolean()) {
                mutated += Math.scalb(v, -20);
            }
            if (!(mutated > 0.0) || Double.isNaN(mutated) || Double.isInfinite(mutated)) {
                mutated = v;
            }
            ys[prefix + (i - start)] = mutated;
        }

        double last = ANCHOR[end - 1];
        for (int i = 0; i < suffix; i++) {
            int shift = data.consumeInt(0, 20);
            ys[prefix + (end - start) + i] = Math.scalb(last, -shift);
            if (!(ys[prefix + (end - start) + i] > 0.0)
                    || Double.isNaN(ys[prefix + (end - start) + i])
                    || Double.isInfinite(ys[prefix + (end - start) + i])) {
                ys[prefix + (end - start) + i] = last;
            }
        }

        return ys;
    }

    private static boolean isExpectedBoundaryRejection(RuntimeException e) {
        return !(e instanceof NotStrictlyPositiveException)
            && (e instanceof NumberIsTooSmallException
                || e instanceof ZeroException
                || e instanceof OutOfRangeException
                || e instanceof NullArgumentException
                || e instanceof IllegalArgumentException);
    }

    private static boolean paramsClose(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            double x = a[i];
            double y = b[i];
            if (Double.isNaN(x) && Double.isNaN(y)) {
                continue;
            }
            if (x == y) {
                continue;
            }
            if (Double.isInfinite(x) || Double.isInfinite(y)) {
                return false;
            }
            double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
            if (Math.abs(x - y) > 1.0e-8 * scale) {
                return false;
            }
        }
        return true;
    }
}
