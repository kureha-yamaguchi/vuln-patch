public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            new PoissonDistributionImpl(-1);
            throw new RuntimeException("accepted negative mean from anchor input");
        } catch (org.apache.commons.math.exception.NotStrictlyPositiveException expected) {
        }

        int trials = 1 + data.consumeInt(0, 7);
        for (int i = 0; i < trials; i++) {
            double mean;
            switch (data.consumeInt(0, 5)) {
                case 0:
                    mean = 0.0d;
                    break;
                case 1:
                    mean = -0.0d;
                    break;
                case 2:
                    mean = -1.0d;
                    break;
                case 3:
                    mean = -((double) data.consumeInt(1, Integer.MAX_VALUE));
                    break;
