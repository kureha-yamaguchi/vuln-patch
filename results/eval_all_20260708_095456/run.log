            for (int c = 1; c < n; c++) {
                coeff[c] = data.consumeInt(1, 99);
            }
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, data.consumeInt(1, 99)));
        }

        for (int r = 0; r < leqCount; r++) {
            double[] coeff = new double[n];
            int pos = data.consumeInt(0, n - 1);
            for (int c = 0; c < n; c++) {
                coeff[c] = -data.consumeInt(1, 99);
            }
            coeff[pos] = data.consumeInt(1, 99);
            if (data.consumeBoolean()) {
                coeff[0] += data.consumeInt(0, 20);
            }
            constraints.add(new LinearConstraint(coeff, Relationship.LEQ, 0.0));
        }

        PointValuePair p1 = optimize(objective, constraints);

        ArrayList<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(constraints);
        if (!constraints.isEmpty()) {
            duplicated.add(constraints.get(data.consumeInt(0, constraints.size() - 1)));
        }
        PointValuePair p2 = optimize(objective, duplicated);

        if (p1 != null && p2 != null && !same(p1, p2)) {
            throw new RuntimeException("metamorphic violation: duplicating a constraint changed the optimum");
        }
    }

    private static PointValuePair optimize(double[] objective, Collection<LinearConstraint> constraints) {
        SimplexSolver solver = new SimplexSolver();
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        return solver.optimize(f, constraints, GoalType.MINIMIZE, true);
    }

    private static double[] row(int n, int[] idx, double[] vals) {
        double[] out = new double[n];
        for (int i = 0; i < idx.length && i < vals.length; i++) {
            out[idx[i]] = vals[i];
        }
        return out;
    }

    private static boolean same(PointValuePair a, PointValuePair b) {
        if (Double.doubleToLongBits(a.getValue()) != Double.doubleToLongBits(b.getValue())) {
            return false;
        }
        double[] ap = a.getPointRef();
        double[] bp = b.getPointRef();
        if (ap == null || bp == null) {
            return ap == bp;
        }
        if (ap.length != bp.length) {
            return false;
        }
        for (int i = 0; i < ap.length; i++) {
            if (Double.doubleToLongBits(ap[i]) != Double.doubleToLongBits(bp[i])) {
                return false;
            }
        }
        return true;
    }
