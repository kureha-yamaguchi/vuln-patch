package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        StrBuilder anchor = new StrBuilder(1);
        anchor.appendFixedWidthPadRight("foo", 1, '-');
        if (!"f".equals(anchor.toString())) {
            throw new RuntimeException("metamorphic violation: anchor result");
        }

        int width = data.consumeInt(1, 8);
        char padChar = (char) (data.consumeByte() & 0xff);
        String prefix = data.consumeString(8);

        boolean useNullObject = data.consumeBoolean();
        String effectiveText;
        Object obj;
        String nullText = null;

        if (useNullObject) {
            effectiveText = makeLongText(data, width);
            nullText = effectiveText;
            obj = null;
        } else {
            effectiveText = makeLongText(data, width);
            int kind = data.consumeInt(0, 2);
            if (kind == 0) {
                obj = effectiveText;
            } else if (kind == 1) {
                obj = new StrBuilder(effectiveText);
            } else {
                obj = new StrTokenizer(effectiveText);
                effectiveText = obj.toString();
                if (effectiveText.length() <= width) {
                    effectiveText = makeFallbackLongText(width);
                    obj = effectiveText;
                }
            }
        }

        int prefixLen = prefix.length();
        int smallCapacityMax = Math.max(0, prefixLen + width - 1);
        int smallCapacity = data.consumeInt(0, smallCapacityMax);
        int largeCapacity = Math.max(prefixLen + effectiveText.length() + 8, smallCapacity + 1);

        String result1 = runCase(smallCapacity, prefix, obj, nullText, width, padChar);
        String result2 = runCase(largeCapacity, prefix, obj, nullText, width, padChar);

        if (!result1.equals(result2)) {
            throw new RuntimeException("metamorphic violation: appendFixedWidthPadRight must be independent of initial capacity");
        }
    }

    private static String runCase(int initialCapacity, String prefix, Object obj, String nullText, int width, char padChar) {
        StrBuilder sb = new StrBuilder(initialCapacity);
        if (nullText != null) {
            sb.setNullText(nullText);
        }
        sb.append(prefix);
        sb.appendFixedWidthPadRight(obj, width, padChar);
        return sb.toString();
    }

    private static String makeLongText(FuzzedDataProvider data, int width) {
        int extra = data.consumeInt(1, 16);
