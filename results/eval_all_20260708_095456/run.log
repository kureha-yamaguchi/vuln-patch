package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.distribution.BinomialDistribution;
import org.apache.commons.math3.distribution.FDistribution;
import org.apache.commons.math3.exception.MathIllegalArgumentException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        BinomialDistribution anchorBinomial = new BinomialDistribution(500000, 0.5);
        int anchorMedian = anchorBinomial.inverseCumulativeProbability(0.5);
        if (anchorMedian != 250000) {
            throw new RuntimeException("anchor violation: binomial median");
        }

        FDistribution anchorF = new FDistribution(200000, 200000);
        double anchorFQuantile = anchorF.inverseCumulativeProbability(0.01);
        if (!(anchorFQuantile < 1.0) || Double.isNaN(anchorFQuantile) || Double.isInfinite(anchorFQuantile)) {
            throw new RuntimeException("anchor violation: F inverse quantile");
        }

        int rawTrials = data.consumeInt(500000, 20000000);
        int trials = (rawTrials & 1) == 0 ? rawTrials : rawTrials - 1;
        if (trials < 2) {
            trials = 2;
        }

        try {
            BinomialDistribution dist = new BinomialDistribution(trials, 0.5);
            int median = dist.inverseCumulativeProbability(0.5);
            if (median != trials / 2) {
                throw new RuntimeException("metamorphic violation: symmetric binomial median");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }

        double df = (double) data.consumeInt(50000, 1000000);
        int probInt = data.consumeInt(1, 999999);
        double prob = probInt / 1000000.0;

        try {
            FDistribution f = new FDistribution(df, df);
            double q1 = f.inverseCumulativeProbability(prob);
            if (Double.isNaN(q1) || Double.isInfinite(q1) || q1 <= 0.0) {
                throw new RuntimeException("unexpected F quantile");
            }

            double q2 = f.inverseCumulativeProbability(1.0 - prob);
            if (!Double.isNaN(q2) && !Double.isInfinite(q2) && q2 > 0.0) {
                double product = q1 * q2;
                double error = Math.abs(product - 1.0);
                double tolerance = 1.0e-4 * Math.max(1.0, Math.abs(product));
                if (error > tolerance) {
                    throw new RuntimeException("metamorphic violation: reciprocal F quantiles");
                }
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }
    }
}
