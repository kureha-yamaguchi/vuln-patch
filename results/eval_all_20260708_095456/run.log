    private static double[] buildObjective(FuzzedDataProvider data, int vars) {
        double[] c = new double[vars];
        c[0] = data.consumeBoolean() ? 1.0 : -1.0;
        for (int i = 1; i < vars; i++) {
            int v = data.consumeInt(-3, 3);
            c[i] = v;
        }
        return c;
    }

    private static ArrayList<LinearConstraint> buildDegenerateConstraintFamily(FuzzedDataProvider data, int vars, int geqRows) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        int pivotCol = data.consumeInt(0, vars - 1);
        for (int i = 0; i < geqRows; i++) {
            double[] coeff = new double[vars];
            coeff[pivotCol] = 1.0;
            int extras = data.consumeInt(0, Math.min(3, vars - 1));
            for (int j = 0; j < extras; j++) {
                int idx = data.consumeInt(0, vars - 1);
                if (idx != pivotCol) {
                    coeff[idx] = data.consumeInt(-2, 2);
                }
            }
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, 0.0));
        }

        constraints.add(new LinearConstraint(unitVector(vars, pivotCol), Relationship.LEQ, 1.0));

        int additional = data.consumeInt(0, 5);
        for (int i = 0; i < additional; i++) {
            double[] coeff = new double[vars];
            for (int j = 0; j < vars; j++) {
                coeff[j] = data.consumeInt(-2, 2);
            }
            Relationship rel;
            int r = data.consumeInt(0, 2);
            if (r == 0) {
                rel = Relationship.LEQ;
            } else if (r == 1) {
                rel = Relationship.GEQ;
            } else {
                rel = Relationship.EQ;
            }
            double rhs = data.consumeInt(-2, 2);
            constraints.add(new LinearConstraint(coeff, rel, rhs));
        }

        if (data.consumeBoolean() && !constraints.isEmpty()) {
            constraints.add(constraints.get(data.consumeInt(0, constraints.size() - 1)));
        }

        return constraints;
    }

    private static double[] unitVector(int vars, int idx) {
        double[] v = new double[vars];
        if (idx >= 0 && idx < vars) {
            v[idx] = 1.0;
        }
        return v;
    }

    private static void exerciseTableauGetters(LinearObjectiveFunction f,
                                               List<LinearConstraint> constraints,
                                               GoalType goal,
                                               boolean restrictToNonNegative) {
        try {
            SimplexTableau tableau =
                    new SimplexTableau(f, constraints, goal, restrictToNonNegative, EPS, ULPS);
            int numObj = tableau.getNumObjectiveFunctions();
            int h = tableau.getHeight();
            int w = tableau.getWidth();
            int numArt = tableau.getNumArtificialVariables();
            int artOff = tableau.getArtificialVariableOffset();

            if (h > 0 && w > 0) {
                tableau.getEntry(0, 0);
                tableau.getEntry(h - 1, w - 1);
            }
            if (numArt > 0 && artOff < w) {
                tableau.getBasicRow(artOff);
                int limit = Math.min(numArt, Math.max(0, w - artOff));
                for (int i = 0; i < limit; i++) {
                    tableau.getBasicRow(artOff + i);
                    if (numObj < h) {
                        tableau.getEntry(numObj, artOff + i);
                    }
                }
            }
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathIllegalStateException e) {
            if (e instanceof MaxCountExceededException) {
                throw e;
            }
            return;
        }
    }

    private static PointValuePair runRealSolver(LinearObjectiveFunction f,
                                                List<LinearConstraint> constraints,
                                                GoalType goal,
                                                boolean restrictToNonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver(EPS, ULPS);
            return solver.optimize(f, constraints, goal, restrictToNonNegative);
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        } catch (MathIllegalStateException e) {
            if (e instanceof MaxCountExceededException) {
                throw e;
            }
            return null;
        }
    }

    private static boolean samePointLength(PointValuePair a, PointValuePair b) {
        double[] pa = a.getPointRef();
        double[] pb = b.getPointRef();
        return pa != null && pb != null && pa.length == pb.length;
    }

    private static boolean sameSolution(PointValuePair a, PointValuePair b) {
        if (!close(a.getValue(), b.getValue())) {
            return false;
        }
        double[] pa = a.getPointRef();
        double[] pb = b.getPointRef();
        if (pa == null || pb == null || pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (!close(pa[i], pb[i])) {
                return false;
            }
        }
        return true;
    }

    private static boolean close(double x, double y) {
        if (Double.doubleToLongBits(x) == Double.doubleToLongBits(y)) {
            return true;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
        return Math.abs(x - y) <= 1.0e-7 * scale;
    }
}
