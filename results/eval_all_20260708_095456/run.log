package org.apache.commons.lang.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseValidLongLiteral("-1");
        exerciseValidLongLiteral("01");
        exerciseValidLongLiteral("1");

        int mode = data.consumeInt(0, 5);
        String base;
        switch (mode) {
            case 0:
                base = buildDigits(data, true, true, false);
                break;
            case 1:
                base = buildDigits(data, false, true, false);
                break;
            case 2:
                base = buildDigits(data, true, true, true);
                break;
            case 3:
                base = buildDigits(data, false, true, true);
                break;
            case 4:
                base = data.consumeBoolean() ? "0" : "00";
                break;
            default:
                String ascii = data.consumeAsciiString(32);
                String digits = filterDigits(ascii);
                if (digits.length() == 0) {
                    digits = "1";
                }
                base = data.consumeBoolean() ? "-" + digits : digits;
                break;
        }

        exerciseValidLongLiteral(base);

        String invalid = data.consumeString(32);
        try {
            NumberUtils.createNumber(invalid);
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }

        String floatLike = buildFloatLike(data);
        try {
            NumberUtils.createNumber(floatLike);
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }

        String hexLike = (data.consumeBoolean() ? "-0x" : "0x") + filterHex(data.consumeAsciiString(16));
        try {
            NumberUtils.createNumber(hexLike);
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }
    }

    private static void exerciseValidLongLiteral(String base) {
        String candidate = base + "l";
        Number parsed;
        try {
            parsed = NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            throw new RuntimeException("valid long literal rejected: " + candidate, e);
        }

        Number expected = expectedIntegral(base);
        if (!sameNumber(parsed, expected)) {
            throw new RuntimeException("metamorphic violation: createNumber(x + \"l\") != integral parser for x: " + candidate);
        }
    }

    private static Number expectedIntegral(String base) {
        try {
            return NumberUtils.createLong(base);
        } catch (NumberFormatException e) {
            return NumberUtils.createBigInteger(base);
        }
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        return a.getClass().equals(b.getClass()) && a.toString().equals(b.toString());
    }

    private static String buildDigits(FuzzedDataProvider data, boolean allowNegative, boolean allowLeadingZeros, boolean longish) {
        int len = longish ? data.consumeInt(19, 80) : data.consumeInt(1, 18);
        String s = data.consumeAsciiString(len);
        String digits = filterDigits(s);
        while (digits.length() < len) {
            digits = digits + (char) ('0' + data.consumeInt(0, 9));
        }
        if (!allowLeadingZeros && digits.length() > 1) {
            char first = digits.charAt(0);
            if (first == '0') {
                digits = '1' + digits.substring(1);
            }
        }
        if (allowNegative && data.consumeBoolean()) {
            return "-" + digits;
        }
        return digits;
    }

    private static String buildFloatLike(FuzzedDataProvider data) {
        String left = filterDigits(data.consumeAsciiString(12));
        String right = filterDigits(data.consumeAsciiString(12));
        if (left.length() == 0) {
            left = "1";
        }
        if (right.length() == 0) {
            right = "0";
        }
        String s = (data.consumeBoolean() ? "-" : "") + left + "." + right;
        if (data.consumeBoolean()) {
            String exp = filterDigits(data.consumeAsciiString(6));
            if (exp.length() == 0) {
                exp = "1";
            }
            s = s + (data.consumeBoolean() ? "e" : "E") + (data.consumeBoolean() ? "-" : "") + exp;
        }
        if (data.consumeBoolean()) {
            s = s + (data.consumeBoolean() ? "f" : "d");
        }
        return s;
    }

    private static String filterDigits(String s) {
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String filterHex(String s) {
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            boolean ok = (c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F');
            if (ok) {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            out.append('1');
        }
        return out.toString();
    }
}
