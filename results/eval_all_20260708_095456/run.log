package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            StringEscapeUtils.escapeCsv(s);
        }

        String prefix = data.consumeString(32);
        String suffix = data.consumeRemainingAsString();
        int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);

        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append(prefix);
        }
        sb.append(Character.toChars(cp));
        if (data.consumeBoolean()) {
            sb.append(suffix);
        } else {
            sb.append(prefix).append(suffix);
        }

        int extraPairs = data.consumeInt(0, 3);
        for (int i = 0; i < extraPairs; i++) {
            int extraCp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
            if (data.consumeBoolean()) {
                sb.insert(0, Character.toChars(extraCp));
            } else {
                sb.append(Character.toChars(extraCp));
            }
        }

        try {
            StringEscapeUtils.escapeCsv(sb.toString());
        } catch (IllegalArgumentException e) {
            return;
        }

        String a = sanitizeCsvSafe(data.consumeAsciiString(16));
        String b = sanitizeCsvSafe(data.consumeAsciiString(16));
        String left;
        String rightA;
        String rightB;
        try {
            left = StringEscapeUtils.escapeCsv(a + b);
            rightA = StringEscapeUtils.escapeCsv(a);
            rightB = StringEscapeUtils.escapeCsv(b);
        } catch (IllegalArgumentException e) {
            return;
        }
        if (!left.equals(rightA + rightB)) {
            throw new RuntimeException("metamorphic violation: composition on csv-safe strings");
        }
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                out.append(c);
            }
        }
        return out.toString();
    }
}
