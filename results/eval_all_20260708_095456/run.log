package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.util.List;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.chart.util.Size2D;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            runAnchor(g2);
            runExplore(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchor(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer ok = new BlockContainer(new BorderArrangement());
        EmptyBlock center = new EmptyBlock(5.0, 6.0);
        ok.add(center);
        touchContainer(ok);
        Size2D s1 = arrangeOrRethrowRootCause(ok, g2, constraint);
        if (s1 != null) {
            Size2D s2 = arrangeOrRethrowRootCause(ok, g2, constraint);
            checkSameSize("anchor idempotence", s1, s2);
        }

        BlockContainer crash = new BlockContainer(new BorderArrangement());
        EmptyBlock right = new EmptyBlock(12.3, 45.6);
        crash.add(right, RectangleEdge.RIGHT);
        touchContainer(crash);
        arrangeOrRethrowRootCause(crash, g2, constraint);
    }

    private static void runExplore(FuzzedDataProvider data, Graphics2D g2) {
        int iterations = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < iterations; i++) {
            double fixedWidth = scaled(data.consumeInt(0, 300));
            double centerW = scaled(data.consumeInt(0, 400));
            double centerH = scaled(data.consumeInt(0, 400));
            double leftW = scaled(data.consumeInt(0, 500));
            double leftH = scaled(data.consumeInt(0, 500));
            double rightW = scaled(data.consumeInt(0, 500));
            double rightH = scaled(data.consumeInt(0, 500));
            double topW = scaled(data.consumeInt(0, 500));
            double topH = scaled(data.consumeInt(0, 500));
            double bottomW = scaled(data.consumeInt(0, 500));
            double bottomH = scaled(data.consumeInt(0, 500));

            boolean wantOversizedSide = data.consumeBoolean();
            boolean useLeft = data.consumeBoolean();
            boolean useRight = data.consumeBoolean();
            boolean useCenter = data.consumeBoolean();
            boolean useTop = data.consumeBoolean();
            boolean useBottom = data.consumeBoolean();

            if (!useLeft && !useRight) {
                if (data.consumeBoolean()) {
                    useLeft = true;
                } else {
                    useRight = true;
                }
            }

            if (wantOversizedSide) {
                double delta = 0.1 + scaled(data.consumeInt(1, 300));
                if (useLeft && (!useRight || data.consumeBoolean())) {
                    leftW = fixedWidth + delta;
                } else {
                    rightW = fixedWidth + delta;
                }
            }

            RectangleConstraint constraint = new RectangleConstraint(
                    fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                    0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
            );

            BlockContainer container = new BlockContainer(new BorderArrangement());
            if (useCenter) {
                container.add(new EmptyBlock(centerW, centerH));
            }
            if (useLeft) {
                container.add(new EmptyBlock(leftW, leftH), RectangleEdge.LEFT);
            }
            if (useRight) {
                container.add(new EmptyBlock(rightW, rightH), RectangleEdge.RIGHT);
            }
            if (useTop) {
                container.add(new EmptyBlock(topW, topH), RectangleEdge.TOP);
            }
            if (useBottom) {
                container.add(new EmptyBlock(bottomW, bottomH), RectangleEdge.BOTTOM);
            }

            touchContainer(container);
            Size2D first = arrangeOrRethrowRootCause(container, g2, constraint);
            if (first != null) {
                Size2D second = arrangeOrRethrowRootCause(container, g2, constraint);
                if (second != null) {
                    checkSameSize("arrange idempotence", first, second);
                }
            }
        }
    }

    private static void touchContainer(BlockContainer container) {
        List blocks = container.getBlocks();
        int count = blocks.size();
        for (int i = 0; i < count; i++) {
            Object o = blocks.get(i);
            if (o instanceof AbstractBlock) {
                AbstractBlock b = (AbstractBlock) o;
                b.getWidth();
                b.getHeight();
            }
        }
    }

    private static Size2D arrangeOrRethrowRootCause(BlockContainer container, Graphics2D g2,
                                                    RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return null;
        }
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException) {
                String msg = cur.getMessage();
                if (msg != null && msg.contains("Range(double, double): require lower")) {
                    for (StackTraceElement ste : cur.getStackTrace()) {
                        String cls = ste.getClassName();
                        if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                                || "org.jfree.data.Range".equals(cls)) {
                            return true;
                        }
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static void checkSameSize(String relation, Size2D a, Size2D b) {
        if (a == null || b == null) {
            return;
        }
        if (Double.doubleToLongBits(a.getWidth()) != Double.doubleToLongBits(b.getWidth())
                || Double.doubleToLongBits(a.getHeight()) != Double.doubleToLongBits(b.getHeight())) {
            throw new RuntimeException("metamorphic violation: " + relation);
        }
    }

    private static double scaled(int v) {
        return v / 10.0;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAsUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
