package org.apache.commons.math3.optimization.linear;

import java.util.ArrayList;
import java.util.Collection;
import java.util.List;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int numVars = data.consumeInt(1, 8);
        int pivotIndex = data.consumeInt(0, numVars - 1);
        int objectiveCoeff = data.consumeInt(1, 20);
        int a = data.consumeInt(1, 20);
        int rhs = data.consumeInt(1, 20);
        int scale = data.consumeInt(1, 20);
        int extraConstraints = data.consumeInt(0, 3);
        boolean addZeroEntryConstraint = data.consumeBoolean();

        try {
            PointValuePair withTie = solveTieProblem(numVars, pivotIndex, objectiveCoeff, a, rhs, scale, extraConstraints,
                    addZeroEntryConstraint, true, 1);
            if (withTie != null) {
                metamorphicCheck(numVars, pivotIndex, objectiveCoeff, a, rhs, scale, extraConstraints, addZeroEntryConstraint,
                        withTie);
            }
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (RuntimeException e) {
            return;
        }
    }

    private static void runAnchor() {
        solveTieProblem(1, 0, 1, 1, 1, 2, 0, false, false, 1);
    }

    private static PointValuePair solveTieProblem(int numVars, int pivotIndex, int objectiveCoeff, int a, int rhs, int scale,
            int extraConstraints, boolean addZeroEntryConstraint, boolean swallowNonBugExceptions, int maxIterations) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective(numVars, pivotIndex, objectiveCoeff), 0.0);
        Collection<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(singleColumn(numVars, pivotIndex, a), Relationship.LEQ, rhs));
        constraints.add(new LinearConstraint(singleColumn(numVars, pivotIndex, a * scale), Relationship.LEQ, rhs * scale));

        for (int i = 0; i < extraConstraints; i++) {
            if ((i & 1) == 0) {
                constraints.add(new LinearConstraint(singleColumn(numVars, pivotIndex, a), Relationship.LEQ, rhs + i + 1));
            } else {
                double[] c = new double[numVars];
                int other = (pivotIndex + i) % numVars;
                c[other] = i + 1;
                constraints.add(new LinearConstraint(c, Relationship.LEQ, rhs + scale + i + 1));
            }
        }

        if (addZeroEntryConstraint) {
            constraints.add(new LinearConstraint(new double[numVars], Relationship.LEQ, rhs + scale + 1));
        }

        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(maxIterations);
        try {
            return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (RuntimeException e) {
            if (swallowNonBugExceptions) {
                return null;
            }
            throw e;
        }
    }

    private static void metamorphicCheck(int numVars, int pivotIndex, int objectiveCoeff, int a, int rhs, int scale,
            int extraConstraints, boolean addZeroEntryConstraint, PointValuePair withTie) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective(numVars, pivotIndex, objectiveCoeff), 0.0);
        Collection<LinearConstraint> withoutDuplicate = new ArrayList<LinearConstraint>();
        withoutDuplicate.add(new LinearConstraint(singleColumn(numVars, pivotIndex, a), Relationship.LEQ, rhs));

        for (int i = 0; i < extraConstraints; i++) {
            if ((i & 1) == 0) {
                withoutDuplicate.add(new LinearConstraint(singleColumn(numVars, pivotIndex, a), Relationship.LEQ, rhs + i + 1));
            } else {
                double[] c = new double[numVars];
                int other = (pivotIndex + i) % numVars;
                c[other] = i + 1;
                withoutDuplicate.add(new LinearConstraint(c, Relationship.LEQ, rhs + scale + i + 1));
            }
        }

        if (addZeroEntryConstraint) {
            withoutDuplicate.add(new LinearConstraint(new double[numVars], Relationship.LEQ, rhs + scale + 1));
        }

        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(10);
        PointValuePair withoutTie;
        try {
            withoutTie = solver.optimize(f, withoutDuplicate, GoalType.MAXIMIZE, true);
        } catch (RuntimeException e) {
            return;
        }

        if (withoutTie == null || withTie == null) {
            return;
        }

        double v1 = withTie.getValue().doubleValue();
        double v2 = withoutTie.getValue().doubleValue();
        if (Math.abs(v1 - v2) > 1.0e-9) {
            throw new RuntimeException("metamorphic violation: duplicate proportional constraint changed optimum value");
        }
    }

    private static double[] objective(int numVars, int pivotIndex, int objectiveCoeff) {
        double[] obj = new double[numVars];
        obj[pivotIndex] = objectiveCoeff;
        return obj;
    }

    private static double[] singleColumn(int numVars, int pivotIndex, int coeff) {
        double[] row = new double[numVars];
        row[pivotIndex] = coeff;
        return row;
    }
}
