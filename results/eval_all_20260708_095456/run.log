    private static Day dayFromOrdinal(int ordinal) {
        int year = 2000 + (ordinal / 336);
        int rem = ordinal % 336;
        int month = 1 + (rem / 28);
        int day = 1 + (rem % 28);
        return new Day(day, month, year);
    }

    private static boolean isRootCause(IllegalArgumentException e) {
        String msg = e.getMessage();
        return msg != null && "Requires start <= end.".equals(msg);
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String which) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: " + which + " produced null");
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException("metamorphic violation: " + which + " itemCount");
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            if (!a.getTimePeriod(i).equals(b.getTimePeriod(i))) {
                throw new RuntimeException("metamorphic violation: " + which + " timePeriod");
            }
        }
    }
