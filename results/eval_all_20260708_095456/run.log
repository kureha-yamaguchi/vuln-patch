package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final java.util.Map REGISTRY = java.util.Collections.EMPTY_MAP;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchorPattern = "it''s a {0} 'test'!";
        ExtendedMessageFormat anchor = new ExtendedMessageFormat(anchorPattern, REGISTRY);
        anchor.format(new Object[] { "dummy" });

        String a = sanitize(data.consumeAsciiString(24));
        String b = sanitize(data.consumeAsciiString(24));
        String c = sanitize(data.consumeAsciiString(24));
        String arg = data.consumeBoolean() ? "{0}" : "";
        int variant = data.consumeInt(0, 4);

        String pattern;
        switch (variant) {
            case 0:
                pattern = a + "''" + b + arg + c;
                break;
            case 1:
                pattern = a + arg + "''" + b + c;
                break;
            case 2:
                pattern = "''" + a + b + arg + c;
                break;
            case 3:
                pattern = a + b + arg + c + "''";
                break;
            default:
                pattern = a + "x''y" + b + arg + c;
                break;
        }

        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, REGISTRY);
            Object[] args = new Object[] { sanitize(data.consumeString(24)) };
            String left = emf.format(args);
            String right = new java.text.MessageFormat(pattern).format(args);
            if (!left.equals(right)) {
                throw new RuntimeException("metamorphic violation: ExtendedMessageFormat != MessageFormat");
            }
        } catch (IllegalArgumentException expectedRejection) {
            return;
        }
    }

    private static String sanitize(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer out = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '{' || ch == '}' || ch == '\'') {
                out.append('x');
            } else {
                out.append(ch);
            }
        }
        return out.toString();
    }
}
