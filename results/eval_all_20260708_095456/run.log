        } catch (IllegalArgumentException expected) {
            // Clean rejection of invalid standard deviation is correct.
        }

        // EXPLORE: generate many REAL probabilities from the distribution itself:
        // p = CDF(x) for integer x values. Then inverseCumulativeProbability(p) must recover x.
        int trials = data.consumeInt(1, 6);
        for (int i = 0; i < trials; i++) {
            int x = data.consumeInt(-8, 8);
            try {
                double p = standard.cumulativeProbability((double) x);
                double inv = standard.inverseCumulativeProbability(p);
                if (Math.abs(inv - x) > 1.0e-12d) {
                    throw new RuntimeException("metamorphic violation: inv(CDF(x)) != x");
                }
            } catch (MathException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(e);
                }
            }
        }

        // Additional varied but still real inputs around the same root cause using a valid distribution.
        double sigma = Math.abs(data.consumeInt(-20, 20) + (data.consumeByte() / 64.0d));
        if (sigma <= 0.0d) {
