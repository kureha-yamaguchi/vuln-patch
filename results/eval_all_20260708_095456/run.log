    private static String buildUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int len = data.consumeInt(1, 16);
        String seed = data.consumeAsciiString(len);
        String alphabet = "0123456789abcdefABCDEF";
        String lastAlphabet = "abcdefABCDEF";
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < len - 1; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + (i % 10));
            int idx = (c & 0x7fffffff) % alphabet.length();
            digits.append(alphabet.charAt(idx));
        }
        digits.append(lastAlphabet.charAt(data.consumeInt(0, lastAlphabet.length() - 1)));
        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder allDigits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            allDigits.append('0');
        }
        allDigits.append(digits);
        return (negative ? "-0X" : "0X") + allDigits.toString();
    }

    private static String buildLongLiteral(FuzzedDataProvider data) {
        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        long value = hi ^ lo;
        return Long.toString(value) + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 9999));
        sb.append('.');
        sb.append(data.consumeInt(0, 999999));
        sb.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 800));
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'D');
        }
        return sb.toString();
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        int chunks = data.consumeInt(2, 8);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(1, 9));
        for (int i = 1; i < chunks; i++) {
            sb.append(Math.abs(data.consumeInt() % 10));
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 999999));
        if (data.consumeBoolean()) {
            sb.append('.');
            sb.append(data.consumeInt(0, 999999));
        } else {
            sb.append('.');
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'f' : 'd');
        }
        return sb.toString();
    }
}
