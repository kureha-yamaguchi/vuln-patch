package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String s : anchors) {
            exercise(s);
        }

        String prefix = data.consumeString(16);
        String suffix = data.consumeRemainingAsString();

        char high = (char) data.consumeInt(0xD800, 0xDBFF);
        char low = (char) data.consumeInt(0xDC00, 0xDFFF);
        String pair = new String(new char[] { high, low });

        int mode = data.consumeInt(0, 5);
        String fuzzed;
        switch (mode) {
            case 0:
                fuzzed = pair;
                break;
            case 1:
                fuzzed = prefix + pair;
                break;
            case 2:
                fuzzed = pair + suffix;
                break;
            case 3:
                fuzzed = prefix + pair + suffix;
                break;
            case 4:
                fuzzed = prefix + pair + "," + suffix;
                break;
            default:
                fuzzed = "\"" + prefix + pair + suffix + "\"";
                break;
        }

        exercise(fuzzed);
    }

    private static void exercise(String input) {
        String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (IllegalArgumentException e) {
            return;
        }

        String roundTrip;
        try {
            roundTrip = StringEscapeUtils.unescapeCsv(escaped);
        } catch (IllegalArgumentException e) {
            return;
        }

        if (!input.equals(roundTrip)) {
            throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(x)) != x");
        }
    }
}
