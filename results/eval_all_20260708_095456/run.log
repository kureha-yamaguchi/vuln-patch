    private static ArrayList<LinearConstraint> buildConstraints(
            int d1, int d2, int d3, int dn, int extraPos, int extraNeg, int eqCount, int rhsSkew) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(tweakPositive(P1, d1), Relationship.GEQ, 91.0 + rhsSkew));
        constraints.add(new LinearConstraint(tweakPositive(P2, d2), Relationship.GEQ, 54.0));
        constraints.add(new LinearConstraint(tweakPositive(P3, d3), Relationship.GEQ, 62.0));

        constraints.add(new LinearConstraint(tweakNegative(N1, dn), Relationship.LEQ, -33.0));

        for (int i = 0; i < extraPos; i++) {
            int which = i % 3;
            if (which == 0) {
                constraints.add(new LinearConstraint(tweakPositive(P1, d1), Relationship.GEQ, 91.0));
            } else if (which == 1) {
                constraints.add(new LinearConstraint(tweakPositive(P2, d2), Relationship.GEQ, 54.0));
            } else {
                constraints.add(new LinearConstraint(tweakPositive(P3, d3), Relationship.GEQ, 62.0));
            }
        }

        for (int i = 0; i < eqCount; i++) {
            int which = i % 3;
            if (which == 0) {
                constraints.add(new LinearConstraint(tweakPositive(P1, d1), Relationship.EQ, 91.0));
            } else if (which == 1) {
                constraints.add(new LinearConstraint(tweakPositive(P2, d2), Relationship.EQ, 54.0));
            } else {
                constraints.add(new LinearConstraint(tweakPositive(P3, d3), Relationship.EQ, 62.0));
            }
        }

        for (int i = 0; i < extraNeg; i++) {
            double[] row = tweakNegative(N1, dn + (i % 3) - 1);
            row[0] += i;
            int j = 1 + (i % (row.length - 1));
            row[j] -= 1.0;
            constraints.add(new LinearConstraint(row, Relationship.LEQ, -33.0 - (i % 2)));
        }

        return constraints;
    }

    private static double[] tweakPositive(double[] src, int delta) {
        double[] out = Arrays.copyOf(src, src.length);
        if (delta == 0) {
            return out;
        }
        for (int i = 1; i < out.length; i++) {
            if ((i % 7) == 0) {
                out[i] += delta;
                if (out[i] < 0.0) {
                    out[i] = 0.0;
                }
            }
        }
        out[0] = 0.0;
        return out;
    }

    private static double[] tweakNegative(double[] src, int delta) {
        double[] out = Arrays.copyOf(src, src.length);
        if (delta == 0) {
            return out;
        }
        out[0] += delta;
        if (out[0] < 1.0) {
            out[0] = 1.0;
        }
        for (int i = 1; i < out.length; i++) {
            if ((i % 5) == 0) {
                out[i] -= delta;
            }
            if (out[i] > -1.0) {
                out[i] = -1.0;
            }
        }
        return out;
    }

    private static ArrayList<LinearConstraint> copyConstraints(ArrayList<LinearConstraint> in) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(in.size());
        for (LinearConstraint c : in) {
            out.add(new LinearConstraint(
                Arrays.copyOf(c.getCoefficients().toArray(), c.getCoefficients().toArray().length),
                c.getRelationship(),
                c.getValue()));
        }
        return out;
    }

    private static boolean same(PointValuePair a, PointValuePair b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (Math.abs(a.getValue() - b.getValue()) > 1.0e-7) {
            return false;
        }
        double[] pa = a.getPoint();
        double[] pb = b.getPoint();
        if (pa == null || pb == null) {
            return pa == pb;
        }
        if (pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (Math.abs(pa[i] - pb[i]) > 1.0e-7) {
                return false;
            }
        }
        return true;
    }
}
