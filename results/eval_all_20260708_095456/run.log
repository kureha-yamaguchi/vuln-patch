        // no replacement can involve that suffix or cross into it. Therefore:
        // replaceEach(text + sentinel, searchList, replacementList) == replaceEach(text, searchList, replacementList) + sentinel
        String sentinel = "###";
        boolean applicable = true;
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].indexOf('#') != -1) {
