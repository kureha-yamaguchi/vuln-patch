public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
        double anchorP = 0.9772498680518209d;
        double anchorResult;
        try {
            anchorResult = anchor.inverseCumulativeProbability(anchorP);
        } catch (MathException e) {
            throw new RuntimeException(e);
        }
        if (Math.abs(anchorResult - 2.0d) > 1.0e-12d) {
            throw new RuntimeException("metamorphic violation: anchor inverse(cdf) seed should recover 2.0");
        }

        int meanInt = data.consumeInt(-100, 100);
        int sdInt = data.consumeInt(1, 20);
        int zInt = data.consumeInt(-8, 8);

        double mean = (double) meanInt;
        double sd = (double) sdInt;
        double x = mean + (sd * zInt);

        NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sd);
        } catch (IllegalArgumentException e) {
            return;
        }

        double p;
        try {
            p = normal.cumulativeProbability(x);
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        if (Double.isNaN(p) || p < 0.0d || p > 1.0d) {
            throw new RuntimeException("metamorphic violation: cumulativeProbability must produce a valid probability");
        }

        double inv;
        try {
            inv = normal.inverseCumulativeProbability(p);
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        double tol = Math.max(1.0e-9d, Math.abs(x) * 1.0e-9d);
        if (Double.isNaN(inv) || Math.abs(inv - x) > tol) {
            throw new RuntimeException("metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x)) != x");
        }
    }
}
