            if (preAdd) {
                plot.addDomainMarker(marker, layer);
            }
            if (useIndexOverload) {
                plot.removeDomainMarker(index, marker, layer, notify);
            } else {
                plot.removeDomainMarker(marker, layer);
            }
        }
    }

    private static void metamorphicCheck(FuzzedDataProvider data) {
        XYPlot plot = new XYPlot();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean useRange = data.consumeBoolean();

        if (useRange) {
            ValueMarker marker = new ValueMarker(data.consumeInt());
            plot.addRangeMarker(marker, layer);
            boolean first = plot.removeRangeMarker(marker, layer);
            boolean second = plot.removeRangeMarker(marker, layer);
            boolean third = plot.removeRangeMarker(marker, layer);
            if (first && second != third) {
                throw new RuntimeException("metamorphic violation: repeated removal of the same absent range marker must be idempotent");
            }
        } else {
            ValueMarker marker = new ValueMarker(data.consumeInt());
            plot.addDomainMarker(marker, layer);
            boolean first = plot.removeDomainMarker(marker, layer);
            boolean second = plot.removeDomainMarker(marker, layer);
            boolean third = plot.removeDomainMarker(marker, layer);
            if (first && second != third) {
                throw new RuntimeException("metamorphic violation: repeated removal of the same absent domain marker must be idempotent");
            }
        }
    }
