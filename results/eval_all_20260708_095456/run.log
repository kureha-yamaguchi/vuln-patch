public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        BufferedImage image = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = image.createGraphics();
        try {
            // ANCHOR: exact inputs visible in the regression test, first.
            arrangeOrSwallow(anchorCenterOnly(g2, 10.0, 5.0, 6.0));
            arrangeOrSwallow(anchorCenterOnly(g2, 10.0, 15.0, 16.0));
            arrangeOrSwallow(anchorRightOnly(g2, 10.0, 12.3, 45.6));

            // ANCHOR for the root-cause property through the real public API:
            // fixed width + height none, with both left and right present and left wider than total width.
            arrangeOrSwallow(buildAndArrange(g2, 10.0, true, false, true, true, false,
                    12.3, 4.0, 3.0, 2.0, 1.0,
                    8.0, 5.0, 6.0, 7.0, 9.0));

            // EXPLORE: vary real inputs satisfying the same property.
            double totalWidth = positiveFinite(data.consumeInt(0, 50)) / 2.0;
            double leftWidth = totalWidth + 0.5 + (positiveFinite(data.consumeInt(0, 200)) / 10.0);
            double rightWidth = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double centerWidth = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double topWidth = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double bottomWidth = positiveFinite(data.consumeInt(0, 200)) / 10.0;

            double leftHeight = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double rightHeight = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double centerHeight = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double topHeight = positiveFinite(data.consumeInt(0, 200)) / 10.0;
            double bottomHeight = positiveFinite(data.consumeInt(0, 200)) / 10.0;

            boolean includeTop = data.consumeBoolean();
            boolean includeBottom = data.consumeBoolean();
            boolean includeCenter = data.consumeBoolean();

            Result r1 = buildAndArrange(g2, totalWidth, true, includeTop, includeBottom, true, includeCenter,
                    leftWidth, rightWidth, centerWidth, topWidth, bottomWidth,
                    leftHeight, rightHeight, centerHeight, topHeight, bottomHeight);
            arrangeOrSwallow(r1);

            // Steer toward getBlocks/getWidth on real objects.
            double widthSum = 0.0;
            List blocks = r1.container.getBlocks();
            for (int i = 0; i < blocks.size(); i++) {
                Object obj = blocks.get(i);
                if (obj instanceof Block) {
                    widthSum += ((Block) obj).getWidth();
                }
            }

            // Additional exploration for arrangeFN with varied surrounding content.
            Result r2 = buildAndArrange(g2, totalWidth + (widthSum % 3.0), true,
                    data.consumeBoolean(), data.consumeBoolean(), true, data.consumeBoolean(),
                    leftWidth + (widthSum % 2.0), rightWidth, centerWidth, topWidth, bottomWidth,
                    leftHeight, rightHeight, centerHeight, topHeight, bottomHeight);
            arrangeOrSwallow(r2);

            // METAMORPHIC CHECK: arranging the same real container twice with the same constraint
