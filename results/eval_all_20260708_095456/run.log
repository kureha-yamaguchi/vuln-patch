        try {
            String joinedChar = StringUtils.join(array, charSep, startIndex, endIndex);
            StringUtils.length(joinedChar);

            String joinedString = StringUtils.join(array, stringSep, startIndex, endIndex);
            StringUtils.length(joinedString);

            if (stringSep != null && stringSep.length() == 1) {
                String lhs = StringUtils.join(array, charSep, startIndex, endIndex);
                String rhs = StringUtils.join(array, stringSep, startIndex, endIndex);
                if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
                    throw new RuntimeException("metamorphic violation: join(array, char, s, e) != join(array, String.valueOf(char), s, e)");
