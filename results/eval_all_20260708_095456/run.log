        double leftWidth = 0.1 + (leftBucket / 1000.0);
        double rightWidth = 0.1 + (rightBucket / 1000.0);

        if (leftWidth >= (Math.PI / 2.0)) {
            leftWidth = (Math.PI / 2.0) - 1e-6;
        }
        if (rightWidth >= (Math.PI / 2.0)) {
            rightWidth = (Math.PI / 2.0) - 1e-6;
        }

        double min = root - leftWidth;
        double max = root + rightWidth;

        int initChoice = Math.abs(data.consumeInt()) % 3;
