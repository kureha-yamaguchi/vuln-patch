package org.apache.commons.lang.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseExpectedValid("-1l");
        exerciseExpectedValid("01l");
        exerciseExpectedValid("1l");

        int known = data.consumeInt();
        String core = Integer.toString(known);
        String knownLower = core + "l";
        String knownUpper = core + "L";
        exerciseExpectedValid(knownLower);
        exerciseExpectedValid(knownUpper);

        int digit = data.consumeInt(0, 9);
        String singleDigit = Integer.toString(digit);
        exerciseExpectedValid(singleDigit + "l");
        exerciseExpectedValid(singleDigit + "L");

        int zeros = data.consumeInt(0, 8);
        StringBuilder prefixed = new StringBuilder();
        for (int i = 0; i < zeros; i++) {
            prefixed.append('0');
        }
        prefixed.append(singleDigit);
        boolean lower = data.consumeBoolean();
        exerciseExpectedValid(prefixed.toString() + (lower ? "l" : "L"));

        String raw = data.consumeAsciiString(32);
        String suffix = data.consumeBoolean() ? "l" : "L";
        safeCall(raw + suffix);

        String maybeSignedDigits = makeSignedDigits(data.consumeAsciiString(24), data.consumeBoolean(), data.consumeBoolean());
        exerciseExpectedValid(maybeSignedDigits + (data.consumeBoolean() ? "l" : "L"));

        String posCore = Integer.toString(Math.abs(data.consumeInt()));
        try {
            Number a = NumberUtils.createNumber(posCore + "l");
            Number b = NumberUtils.createNumber("0" + posCore + "l");
            if (a == null || b == null || !a.toString().equals(b.toString())) {
                throw new RuntimeException("metamorphic violation: leading-zero long suffix equivalence");
            }
        } catch (NumberFormatException e) {
            throw e;
        }
    }

    private static void exerciseExpectedValid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
            throw e;
        }
    }

    private static void safeCall(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }
    }

    private static String makeSignedDigits(String src, boolean allowSign, boolean negative) {
        StringBuilder sb = new StringBuilder();
        if (allowSign && negative) {
            sb.append('-');
        }
        for (int i = 0; i < src.length(); i++) {
            char c = src.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if ((allowSign && negative && sb.length() == 1) || (!allowSign && sb.length() == 0)) {
            sb.append('0');
        }
        return sb.toString();
    }
}
