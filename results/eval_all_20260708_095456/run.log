        }

        int len = data.consumeInt(2, 5);
        String[] searchList = new String[len];
        String[] replacementList = new String[len];

        int matchIdx = data.consumeInt(0, len - 1);
        int nullIdx = data.consumeInt(0, len - 1);
        if (nullIdx == matchIdx) {
            nullIdx = (nullIdx + 1) % len;
        }

        for (int i = 0; i < len; i++) {
            if (i == matchIdx) {
                searchList[i] = matchingSearch;
                replacementList[i] = matchingReplacement;
            } else if (i == nullIdx) {
                searchList[i] = nullReplacementSearch;
                replacementList[i] = null;
