public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (NumberFormatException ignored) {
        }

        String[] anchors = new String[] {
            "12345",
            "12345L",
            "12345678901234567890L",
            "1.1E200",
            "1.1E20",
            "1.1E-700F",
            "2.",
            "-12345",
            "0xFADE",
            "-0xFADE"
        };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException ignored) {
            }
        }

        String raw = data.consumeString(64);
        try {
            NumberUtils.createNumber(raw);
        } catch (NumberFormatException ignored) {
        }

        int hexLen = data.consumeInt(1, 32);
        String seed = data.consumeAsciiString(hexLen);
        char[] hex = new char[hexLen];
        for (int i = 0; i < hexLen; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + (i % 10));
            int v = c & 0x0F;
            hex[i] = "0123456789abcdef".charAt(v);
        }
        hex[hexLen - 1] = "abcdefABCDEF".charAt(data.consumeInt(0, 11));

        boolean negative = data.consumeBoolean();
        String digits = new String(hex);
        String upperX = (negative ? "-0X" : "0X") + digits;
        String lowerx = (negative ? "-0x" : "0x") + digits;

        try {
            NumberUtils.createNumber(upperX);
        } catch (NumberFormatException ignored) {
        }
        try {
            NumberUtils.createNumber(lowerx);
        } catch (NumberFormatException ignored) {
        }

        Number upper = null;
        Number lower = null;
        boolean upperOk = true;
        boolean lowerOk = true;

        try {
            upper = NumberUtils.createNumber(upperX);
        } catch (NumberFormatException ignored) {
            upperOk = false;
        }

        try {
            lower = NumberUtils.createNumber(lowerx);
        } catch (NumberFormatException ignored) {
            lowerOk = false;
        }

        if (upperOk != lowerOk) {
            throw new RuntimeException("metamorphic violation: 0x/0X equivalent inputs differ");
        }
        if (upperOk && lowerOk && !upper.equals(lower)) {
            throw new RuntimeException("metamorphic violation: 0x/0X equivalent inputs differ");
        }
    }
