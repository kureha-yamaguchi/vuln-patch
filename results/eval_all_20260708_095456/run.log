public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (CloneNotSupportedException e) {
            return;
        }

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];
        ords[0] = data.consumeInt(0, 20000);
        ords[1] = ords[0] + data.consumeInt(2, 40);
        for (int i = 2; i < count; i++) {
            ords[i] = ords[i - 1] + data.consumeInt(1, 40);
        }
        Arrays.sort(ords);

        TimeSeries series = new TimeSeries(data.consumeString(20));
        for (int i = 0; i < ords.length; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        Day gapStart = dayFromOrdinal(data.consumeInt(ords[0] + 1, ords[1] - 1));
        Day gapEnd = dayFromOrdinal(data.consumeInt(
                Math.max(ords[0] + 1, daysSince2000(gapStart)),
                ords[1] - 1));

        try {
            series.getIndex(gapStart);
            series.getIndex(gapEnd);

            TimeSeries gapCopy = series.createCopy(gapStart, gapEnd);
            assertEmptyCopy(series, gapCopy, "gap createCopy(start,end)");
        } catch (CloneNotSupportedException e) {
            return;
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod startExisting = series.getTimePeriod(i);
            RegularTimePeriod endExisting = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);
            TimeSeries byIndex = series.createCopy(i, j);

            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                throw new RuntimeException("metamorphic violation: existing-period copy != index copy itemCount");
            }
            for (int k = 0; k < byPeriod.getItemCount(); k++) {
                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {
                    throw new RuntimeException("metamorphic violation: existing-period copy != index copy timePeriod");
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }
    }
