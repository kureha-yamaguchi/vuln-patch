package org.apache.commons.math3.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathArithmeticException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.util.Pair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        List<Pair<Object, Double>> anchor = new ArrayList<Pair<Object, Double>>();
        anchor.add(new Pair<Object, Double>("seed", Double.valueOf(0.0)));
        anchor.add(new Pair<Object, Double>(Integer.valueOf(1), Double.valueOf(1.0)));
        new DiscreteDistribution<Object>(anchor).sample(1);

        try {
            int size = data.consumeInt(2, 6);
            int forcedIndex = data.consumeInt(1, size - 1);

            List<Pair<Object, Double>> heterogeneous = new ArrayList<Pair<Object, Double>>(size);
            Object first = makeObjectOfKind(data, 0);
            Object forced = makeDifferentObject(data, first);

            for (int i = 0; i < size; i++) {
                Object value;
                double probability;
                if (i == 0) {
                    value = first;
                    probability = 0.0;
                } else if (i == forcedIndex) {
                    value = forced;
                    probability = 1.0;
                } else {
                    value = makeObjectOfKind(data, data.consumeInt(0, 4));
                    probability = 0.0;
                }
                heterogeneous.add(new Pair<Object, Double>(value, Double.valueOf(probability)));
            }

            new DiscreteDistribution<Object>(heterogeneous).sample(data.consumeInt(1, 4));
        } catch (MathIllegalArgumentException e) {
            return;
        }

        try {
            int n = data.consumeInt(1, 6);
            double[] singletons = new double[n];
            double[] probabilities = new double[n];

            boolean anyPositive = false;
            for (int i = 0; i < n; i++) {
                singletons[i] = data.consumeInt(-1000, 1000) / 10.0;
                int w = data.consumeInt(0, 100);
                probabilities[i] = w;
                if (w > 0) {
                    anyPositive = true;
                }
            }
            if (!anyPositive) {
                probabilities[data.consumeInt(0, n - 1)] = 1.0;
            }

            DiscreteRealDistribution d1 = new DiscreteRealDistribution(singletons, probabilities);

            d1.getSupportLowerBound();
            d1.getSupportUpperBound();
            d1.getNumericalMean();
            d1.getNumericalVariance();
            d1.isSupportConnected();

            double x = data.consumeInt(-1000, 1000) / 10.0;
            d1.cumulativeProbability(x);

            double p = data.consumeInt(0, 1000) / 1000.0;
            d1.inverseCumulativeProbability(p);

            double[] scaled = new double[n];
            for (int i = 0; i < n; i++) {
                scaled[i] = probabilities[i] * 2.0;
            }
            DiscreteRealDistribution d2 = new DiscreteRealDistribution(singletons, scaled);

            double c1 = d1.cumulativeProbability(x);
            double c2 = d2.cumulativeProbability(x);
            if (Double.isFinite(c1) && Double.isFinite(c2) && Math.abs(c1 - c2) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: cumulativeProbability invariant under uniform probability scaling");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (MathArithmeticException e) {
            return;
        }
    }

    private static Object makeDifferentObject(FuzzedDataProvider data, Object first) {
        for (int i = 0; i < 8; i++) {
            Object candidate = makeObjectOfKind(data, data.consumeInt(0, 4));
            if (!candidate.getClass().equals(first.getClass())) {
                return candidate;
            }
        }
        if (!(first instanceof String)) {
            return "alt";
        }
        return Integer.valueOf(7);
    }

    private static Object makeObjectOfKind(FuzzedDataProvider data, int kind) {
        switch (kind) {
            case 0:
                return data.consumeAsciiString(8);
            case 1:
                return Integer.valueOf(data.consumeInt());
            case 2:
                return Double.valueOf(data.consumeInt(-1000, 1000) / 10.0);
            case 3:
                return Long.valueOf((long) data.consumeInt());
            default:
                return data.consumeBytes(data.consumeInt(0, 8));
        }
    }
}
