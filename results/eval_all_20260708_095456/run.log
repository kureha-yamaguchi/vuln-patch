        constraints.add(new LinearConstraint(new double[] { 0.5, -1.5, -0.5, 1.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { 1.0, 0.0, 0.0, 0.0 }, Relationship.LEQ, 1.0));

