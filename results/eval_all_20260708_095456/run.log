        if (Double.doubleToLongBits(a.getValue()) != Double.doubleToLongBits(b.getValue())) {
            return false;
        }
        double[] pa = a.getPointRef();
        double[] pb = b.getPointRef();
        if (pa == null || pb == null) {
            return pa == pb;
        }
        if (pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (Double.doubleToLongBits(pa[i]) != Double.doubleToLongBits(pb[i])) {
                return false;
            }
        }
        return true;
    }
