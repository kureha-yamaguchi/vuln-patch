package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Collections;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = Collections.EMPTY_MAP;
    private static final long HANG_TIMEOUT_MS = 50L;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkTerminates("it''s a test");
        checkTerminates(buildFuzzPattern(data));

        String valid = buildRoundTripPattern(data);
        ExtendedMessageFormat emf1 = new ExtendedMessageFormat(valid, REGISTRY);
        String out1 = emf1.format(new Object[] { "DUMMY" });
        String p2 = emf1.toPattern();
        ExtendedMessageFormat emf2 = new ExtendedMessageFormat(p2, REGISTRY);
        String out2 = emf2.format(new Object[] { "DUMMY" });
        if (!out1.equals(out2)) {
            throw new RuntimeException("metamorphic violation: format(toPattern(x)) changed output");
        }
    }

    private static void checkTerminates(final String pattern) {
        final Throwable[] thrown = new Throwable[1];
        Thread t = new Thread(new Runnable() {
            public void run() {
                try {
                    new ExtendedMessageFormat(pattern, REGISTRY);
                } catch (Throwable e) {
                    thrown[0] = e;
                }
            }
        });
        t.setDaemon(true);
        t.start();
        try {
            t.join(HANG_TIMEOUT_MS);
        } catch (InterruptedException e) {
            throw new RuntimeException(e);
        }
        if (t.isAlive()) {
            throw new RuntimeException("non-terminating applyPattern for pattern: " + pattern);
        }
        if (thrown[0] != null) {
            if (thrown[0] instanceof IllegalArgumentException) {
                return;
            }
            if (thrown[0] instanceof RuntimeException) {
                throw (RuntimeException) thrown[0];
            }
            if (thrown[0] instanceof Error) {
                throw (Error) thrown[0];
            }
            throw new RuntimeException(thrown[0]);
        }
    }

    private static String buildFuzzPattern(FuzzedDataProvider data) {
        String a = sanitize(data.consumeAsciiString(32));
        String b = sanitize(data.consumeAsciiString(32));
        String c = sanitize(data.consumeAsciiString(32));
        int variant = data.consumeInt(0, 5);

        switch (variant) {
            case 0:
                return "''";
            case 1:
                return a + "''";
            case 2:
                return "''" + a;
            case 3:
                return a + "''" + b;
            case 4:
                return a + " '' " + b;
            default:
                return a + "it''s " + b + c;
        }
    }

    private static String buildRoundTripPattern(FuzzedDataProvider data) {
        String a = sanitize(data.consumeAsciiString(16));
        String b = sanitize(data.consumeAsciiString(16));
        String c = sanitize(data.consumeAsciiString(16));
        int variant = data.consumeInt(0, 3);

        switch (variant) {
            case 0:
                return a + "{0}" + b;
            case 1:
                return a + " '" + c + "' " + "{0}" + b;
            case 2:
                return a + "{0}" + " '" + b + "'";
            default:
                return a + b + c;
        }
    }

    private static String sanitize(String s) {
        return s.replace('\'', 'Q').replace('{', 'A').replace('}', 'B');
    }
}
