package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = new HashMap();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryPattern("it''s a {0,lower} 'test'!", true);

        String prefix = sanitize(data.consumeAsciiString(64));
        String suffix = sanitize(data.consumeRemainingAsString());

        String middle = sanitize(prefix + suffix);
        String pattern;
        switch (data.consumeInt(0, 5)) {
            case 0:
                pattern = "''";
                break;
            case 1:
                pattern = prefix + "''" + suffix;
                break;
            case 2:
                pattern = prefix + "''" + suffix + " {0}";
                break;
            case 3:
                pattern = prefix + " '" + middle + "' " + "''" + suffix;
                break;
            case 4:
                pattern = prefix + "{0}" + "''" + suffix;
                break;
            default:
                pattern = prefix + "''" + suffix + " {0,lower}";
                break;
        }

        ExtendedMessageFormat emf = tryPattern(pattern, false);
        if (emf != null) {
            String p1 = emf.toPattern();
            ExtendedMessageFormat emf2 = tryPattern(p1, false);
            if (emf2 != null) {
                String p2 = emf2.toPattern();
                if (!p1.equals(p2)) {
                    throw new RuntimeException("metamorphic violation: toPattern idempotence");
                }
            }
        }
    }

    private static ExtendedMessageFormat tryPattern(String pattern, boolean doFormat) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.getDefault(), REGISTRY);
            if (doFormat) {
                try {
                    emf.format(new Object[] { "DUMMY" });
                } catch (IllegalArgumentException e) {
                    return null;
                }
            } else {
                try {
                    emf.format(new Object[] { "dummy" });
                } catch (IllegalArgumentException e) {
                    return emf;
                }
            }
            return emf;
        } catch (IllegalArgumentException e) {
            return null;
        }
    }

    private static String sanitize(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == ' ' || c == '_' || c == '-' || c == '.') {
                sb.append(c);
            } else {
                sb.append('a');
            }
        }
        return sb.toString();
    }
}
