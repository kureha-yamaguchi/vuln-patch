package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final java.util.Map EMPTY_REGISTRY = new java.util.HashMap();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        drive("it''s a {0} 'test'!");

        String prefix = sanitize(data.consumeAsciiString(32));
        String suffix = sanitize(data.consumeAsciiString(32));
        String quoted = sanitizeNoQuote(data.consumeAsciiString(32));
        String tail = sanitize(data.consumeRemainingAsString());

        String pattern;
        switch (data.consumeInt(0, 5)) {
            case 0:
                pattern = prefix + "''" + suffix + " {0}";
                break;
            case 1:
                pattern = prefix + "''" + suffix + " {0} '" + quoted + "'";
                break;
            case 2:
                pattern = "''" + prefix + " {0} " + suffix;
                break;
            case 3:
                pattern = prefix + " {0} " + suffix + "''" + tail;
                break;
            case 4:
                pattern = prefix + "''" + suffix + " {0} '" + quoted + "' " + tail;
                break;
            default:
                pattern = prefix + " {0} '' " + suffix;
                break;
        }

        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, EMPTY_REGISTRY);
            String once = emf.toPattern();
            String twice = new ExtendedMessageFormat(once, EMPTY_REGISTRY).toPattern();
            if (!once.equals(twice)) {
                throw new RuntimeException("metamorphic violation: toPattern reparse idempotence");
            }
            emf.format(new Object[] { "x" });
        } catch (IllegalArgumentException expected) {
        }
    }

    private static void drive(String pattern) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, EMPTY_REGISTRY);
        String once = emf.toPattern();
        String twice = new ExtendedMessageFormat(once, EMPTY_REGISTRY).toPattern();
        if (!once.equals(twice)) {
            throw new RuntimeException("metamorphic violation: toPattern reparse idempotence");
        }
        emf.format(new Object[] { "x" });
    }

    private static String sanitize(String s) {
        return s.replace("{", "A").replace("}", "B");
    }

    private static String sanitizeNoQuote(String s) {
        return sanitize(s).replace("'", "Q");
