package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static String runCase(int initialCapacity, String prefix, Object obj, String nullText, int width, char padChar) {
        StrBuilder sb = new StrBuilder(initialCapacity);
        if (nullText != null) {
            sb.setNullText(nullText);
        }
        if (prefix != null && prefix.length() > 0) {
            sb.append(prefix);
        }
        sb.appendFixedWidthPadRight(obj, width, padChar);
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1, "", "foo", null, 1, '-');

        String prefix = data.consumeString(32);
        int initialCapacity = data.consumeInt(1, 16);
        char padChar = (char) data.consumeInt(0, 0xffff);
        boolean useNullTextPath = data.consumeBoolean();

        String src = data.consumeString(64);
        if (src.length() < 2) {
            src = src + "XY";
        }
        int width = data.consumeInt(1, src.length() - 1);

        if (useNullTextPath) {
            runCase(initialCapacity, prefix, null, src, width, padChar);
        } else {
            runCase(initialCapacity, prefix, src, null, width, padChar);
        }

        String lhs = runCase(initialCapacity, prefix, src, null, width, padChar);
        String rhs = runCase(initialCapacity, prefix, src.substring(0, width), null, width, padChar);
        if (!lhs.equals(rhs)) {
            throw new RuntimeException("metamorphic violation: truncating obj to width before appendFixedWidthPadRight changed the result");
        }
    }
}
