package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1234.5");

        exercise("12345");
        exercise("1234.5D");
        exercise("1234.5d");
        exercise("1234.5F");
        exercise("1234.5f");
        exercise("12345L");
        exercise("12345l");
        exercise("-1234.5");
        exercise("-12345");
        exercise("0xFADE");
        exercise("-0xFADE");
        exercise("1.1E200");
        exercise("1.1E20");
        exercise("-1.1E200");
        exercise("1.1E-200");
        exercise("12345678901234567890L");
        exercise("1.1E-700F");
        exercise("2.");
        exercise("1eE");

        String fuzz = buildInterestingInput(data);
        exercise(fuzz);

        if (data.consumeBoolean()) {
            String a = data.consumeAsciiString(12).replace(".", "").replace("-", "").replace("+", "");
            String b = data.consumeAsciiString(12).replace(".", "").replace("-", "").replace("+", "");
            if (a.length() == 0) {
                a = "1";
            }
            if (b.length() == 0) {
                b = "1";
            }
            String mid = data.consumeBoolean() ? "e" : "E";
            String mixed = a + mid + b;
            exercise(mixed);
            exercise(a + "e" + "E");
            exercise(a + "E" + "e");
            exercise(a + "e" + b + "E");
            exercise(a + "E" + b + "e");
        }

        int known = data.consumeInt();
        Number parsed = NumberUtils.createNumber(Integer.toString(known));
        if (parsed == null || parsed.intValue() != known) {
            throw new RuntimeException("metamorphic violation: decimal int string should round-trip through createNumber");
        }
    }

    private static void exercise(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException expected) {
        }
    }

    private static String buildInterestingInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 7);
        String left = sanitizeDigits(data.consumeAsciiString(16));
        String right = sanitizeDigits(data.consumeAsciiString(16));
        String tail = sanitizeDigits(data.consumeAsciiString(16));

        if (left.length() == 0) {
            left = "1";
        }
        if (right.length() == 0) {
            right = "1";
        }

        switch (mode) {
            case 0:
                return left + "e" + "E";
            case 1:
                return left + "E" + "e";
            case 2:
                return left + "e" + right + "E";
            case 3:
                return left + "E" + right + "e";
            case 4:
                return (data.consumeBoolean() ? "-" : "") + left + "e" + right;
            case 5:
                return (data.consumeBoolean() ? "-" : "") + left + "E" + right;
            case 6:
                return (data.consumeBoolean() ? "-" : "") + left + "." + right;
            default:
                return (data.consumeBoolean() ? "-" : "") + left + "." + right + (data.consumeBoolean() ? "F" : "D") + tail;
        }
    }

    private static String sanitizeDigits(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        return out.toString();
    }
}
