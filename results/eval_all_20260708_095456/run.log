package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.geometry.euclidean.oned.IntervalsSet;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    private static final int[] INDICES = new int[] {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(anchorCoords());

        double[] coords = fuzzCoords(data);
        PolyhedronsSet base = null;
        double baseSize = Double.NaN;
        boolean baseOk = false;

        try {
            base = buildPolyhedron(coords);
            baseSize = base.getSize();
            base.getBarycenter();
            baseOk = true;
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isExpectedRejection(t)) {
                return;
            }
            return;
        }

        if (baseOk) {
            double tx = scaled(data.consumeInt(), 1000.0);
            double ty = scaled(data.consumeInt(), 1000.0);
            double tz = scaled(data.consumeInt(), 1000.0);
            double[] translated = translate(coords, tx, ty, tz);
            try {
                PolyhedronsSet moved = buildPolyhedron(translated);
                double movedSize = moved.getSize();
                moved.getBarycenter();
                if (!sameDouble(baseSize, movedSize)) {
                    throw new RuntimeException("metamorphic violation: translation should preserve size");
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                if (isExpectedRejection(t)) {
                    return;
                }
            }
        }
    }

    private static void runCase(double[] coords) {
        try {
            PolyhedronsSet set = buildPolyhedron(coords);
            set.getSize();
            set.getBarycenter();
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static PolyhedronsSet buildPolyhedron(double[] coords) {
        ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();
        for (int i = 0; i < INDICES.length; i += 3) {
            Vector3D a = vertex(coords, INDICES[i]);
            Vector3D b = vertex(coords, INDICES[i + 1]);
            Vector3D c = vertex(coords, INDICES[i + 2]);
            SubPlane facet = triangleFacet(a, b, c);
            facets.add(facet);
        }
        return new PolyhedronsSet(facets);
    }

    private static SubPlane triangleFacet(Vector3D a, Vector3D b, Vector3D c) {
        Plane plane = new Plane(a, b, c);
        Vector2D pa = plane.toSubSpace(a);
        Vector2D pb = plane.toSubSpace(b);
        Vector2D pc = plane.toSubSpace(c);

        ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>();
        edges.add(edge(pa, pb));
        edges.add(edge(pb, pc));
        edges.add(edge(pc, pa));

        PolygonsSet region = new PolygonsSet(edges);
        return new SubPlane(plane, region);
    }

    private static SubLine edge(Vector2D start, Vector2D end) {
        Line line = new Line(start, end);
        double s = line.toSubSpace(start).getX();
        double e = line.toSubSpace(end).getX();
        return new SubLine(line, new IntervalsSet(s, e));
    }

    private static Vector3D vertex(double[] coords, int index) {
        int i = index * 3;
        return new Vector3D(coords[i], coords[i + 1], coords[i + 2]);
    }

    private static double[] anchorCoords() {
        return new double[] {
            1.000000d, -1.000000d, -1.000000d,
            1.000000d, -1.000000d,  1.000000d,
           -1.000000d, -1.000000d,  1.000000d,
           -1.000000d, -1.000000d, -1.000000d,
            1.000000d,  1.000000d, -1.000000d,
            0.999999d,  1.000000d,  1.000000d,
           -1.000000d,  1.000000d,  1.000000d,
           -1.000000d,  1.000000d, -1.000000d
        };
    }

    private static double[] fuzzCoords(FuzzedDataProvider data) {
        double hx = positiveExtent(data);
        double hy = positiveExtent(data);
        double hz = positiveExtent(data);

        double ox = scaled(data.consumeInt(), 100.0);
        double oy = scaled(data.consumeInt(), 100.0);
        double oz = scaled(data.consumeInt(), 100.0);

        double dx = scaled(data.consumeInt(), 1000000.0);
        double dy = scaled(data.consumeInt(), 1000000.0);
        double dz = scaled(data.consumeInt(), 1000000.0);

        double[] c = new double[] {
             ox + hx, oy - hy, oz - hz,
             ox + hx, oy - hy, oz + hz,
             ox - hx, oy - hy, oz + hz,
             ox - hx, oy - hy, oz - hz,
             ox + hx, oy + hy, oz - hz,
             ox + hx + dx, oy + hy + dy, oz + hz + dz,
             ox - hx, oy + hy, oz + hz,
