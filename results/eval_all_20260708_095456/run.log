    private static boolean isRootCause(IllegalArgumentException e) {
        String msg = e.getMessage();
        return "Requires start <= end.".equals(msg);
    }

    private static int findGap(int[] ordinals) {
        for (int i = 0; i < ordinals.length - 1; i++) {
            if (ordinals[i + 1] - ordinals[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static Day dayFromOrdinal(int ordinal) {
        GregorianCalendar cal = new GregorianCalendar(2000, Calendar.JANUARY, 1);
        cal.setLenient(false);
        cal.add(Calendar.DAY_OF_MONTH, ordinal);
        return new Day(cal.getTime());
    }

    private static void sort(int[] values) {
        for (int i = 1; i < values.length; i++) {
            int v = values[i];
            int j = i - 1;
            while (j >= 0 && values[j] > v) {
                values[j + 1] = values[j];
                j--;
            }
            values[j + 1] = v;
        }
    }
