package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callAndSwallowExpected("1234.5");

        callAndSwallowExpected("12345");
        callAndSwallowExpected("1234.5D");
        callAndSwallowExpected("1234.5d");
        callAndSwallowExpected("1234.5F");
        callAndSwallowExpected("1234.5f");
        callAndSwallowExpected("-1234.5");
        callAndSwallowExpected("-12345");
        callAndSwallowExpected("0xFADE");
        callAndSwallowExpected("-0xFADE");
        callAndSwallowExpected("1.1E200");
        callAndSwallowExpected("1.1E20");
        callAndSwallowExpected("-1.1E200");
        callAndSwallowExpected("1.1E-200");
        callAndSwallowExpected("12345678901234567890L");
        callAndSwallowExpected("1.1E-700F");
        callAndSwallowExpected("2.");
        callAndSwallowExpected("1eE");
        callAndSwallowExpected("-1l");
        callAndSwallowExpected("01l");
        callAndSwallowExpected("1l");

        String fuzzed = buildCandidate(data);
        callAndSwallowExpected(fuzzed);

        String noExpDecimal = buildNoExponentDecimal(data);
        callAndSwallowExpected(noExpDecimal);

        String suffixed = noExpDecimal + (data.consumeBoolean() ? "F" : "D");
        callAndSwallowExpected(suffixed);

        String integral = buildIntegral(data);
        callAndSwallowExpected(integral);
        callAndSwallowExpected(integral + (data.consumeBoolean() ? "L" : "l"));

        String exponentForm = buildExponentForm(data);
        callAndSwallowExpected(exponentForm);

        int oracle = data.consumeInt();
        String oracleStr = Integer.toString(oracle);
        try {
            Number a = NumberUtils.createNumber(oracleStr);
            Integer b = NumberUtils.createInteger(oracleStr);
            if (a == null || b == null || a.intValue() != b.intValue()) {
                throw new RuntimeException("metamorphic violation: createNumber(int-string) != createInteger(int-string)");
            }
        } catch (NumberFormatException expected) {
        }
    }

    private static void callAndSwallowExpected(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException expected) {
        }
    }

    private static String buildCandidate(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 7);
        switch (mode) {
            case 0:
                return data.consumeAsciiString(16);
            case 1:
                return buildNoExponentDecimal(data);
            case 2:
                return buildExponentForm(data);
            case 3:
                return buildIntegral(data);
            case 4:
                return buildIntegral(data) + (data.consumeBoolean() ? "L" : "l");
            case 5:
                return buildNoExponentDecimal(data) + suffix(data);
            case 6:
                return (data.consumeBoolean() ? "" : "-") + "0x" + hexDigits(data);
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static String buildNoExponentDecimal(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        String left = digits(data, 1, 8);
        String right = digits(data, 0, 8);
        return sign + left + "." + right;
    }

    private static String buildIntegral(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        return sign + digits(data, 1, 12);
    }

    private static String buildExponentForm(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        String mant = digits(data, 1, 6);
        String frac = data.consumeBoolean() ? "." + digits(data, 0, 6) : "";
        char e = data.consumeBoolean() ? 'e' : 'E';
        String expSign = data.consumeBoolean() ? "-" : "";
        String exp = digits(data, 1, 4);
        String suf = data.consumeBoolean() ? "" : suffix(data);
        return sign + mant + frac + e + expSign + exp + suf;
    }

    private static String digits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String hexDigits(FuzzedDataProvider data) {
