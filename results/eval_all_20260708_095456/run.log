    private static void addEquivalent(BlockContainer a, BlockContainer b, double w, double h, RectangleEdge edge) {
        EmptyBlock b1 = new EmptyBlock(w, h);
        EmptyBlock b2 = new EmptyBlock(w, h);
        if (edge == null) {
            a.add(b1);
            b.add(b2);
        } else {
            a.add(b1, edge);
            b.add(b2, edge);
        }
    }

    private static Size2D arrangeOrRethrowRootCause(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
