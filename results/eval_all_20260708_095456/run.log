package org.jfree.data.xy;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        XYSeries anchor = new XYSeries("Series", true, true);
        anchor.addOrUpdate(Double.valueOf(1.0), Double.valueOf(1.0));
        anchor.addOrUpdate(Double.valueOf(1.0), Double.valueOf(2.0));

        try {
            String key = data.consumeString(32);
            int initialCount = data.consumeInt(1, 16);
            int start = data.consumeInt(-1000, 1000);
            int step = data.consumeInt(1, 50);
            boolean ascending = data.consumeBoolean();
            int extraDuplicates = data.consumeInt(0, 8);
            double yBase = data.consumeInt(-1000, 1000);

            XYSeries series = new XYSeries(key, true, true);
            double[] xs = new double[initialCount];

            for (int i = 0; i < initialCount; i++) {
                xs[i] = start + (double) (i * step);
            }

            if (ascending) {
                for (int i = 0; i < initialCount; i++) {
                    series.addOrUpdate(Double.valueOf(xs[i]), Double.valueOf(yBase + i));
                }
            } else {
                for (int i = initialCount - 1; i >= 0; i--) {
                    series.addOrUpdate(Double.valueOf(xs[i]), Double.valueOf(yBase + i));
                }
            }

            int dupIndex = data.consumeInt(0, initialCount - 1);
            Double duplicateX = Double.valueOf(xs[dupIndex]);

            int beforeCount = series.getItemCount();
            int beforeMatches = 0;
            for (int i = 0; i < beforeCount; i++) {
                if (duplicateX.equals(series.getX(i))) {
                    beforeMatches++;
                }
            }

            series.addOrUpdate(duplicateX, Double.valueOf(data.consumeInt(-1000, 1000)));

            int afterCount = series.getItemCount();
            int afterMatches = 0;
            for (int i = 0; i < afterCount; i++) {
                if (duplicateX.equals(series.getX(i))) {
                    afterMatches++;
                }
            }

            if (afterCount != beforeCount + 1 || afterMatches != beforeMatches + 1) {
                throw new RuntimeException("metamorphic violation: duplicate addOrUpdate must append one more item when duplicate X values are allowed");
            }

            for (int i = 0; i < extraDuplicates; i++) {
                Double x = Double.valueOf(xs[data.consumeInt(0, initialCount - 1)]);
                series.addOrUpdate(x, Double.valueOf(data.consumeInt(-1000, 1000)));
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
