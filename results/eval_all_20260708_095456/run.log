        double[] c4 = new double[] {
            83.0, -76.0, -94.0, -19.0, -15.0, -70.0, -72.0, -57.0, -63.0, -65.0,
            -22.0, -94.0, -22.0, -88.0, -86.0, -89.0, -72.0, -16.0, -80.0, -49.0,
            -70.0, -93.0, -95.0, -17.0, -83.0, -97.0, -31.0, -47.0, -31.0, -13.0,
            -23.0
        };

        double[][] negativeCandidates = new double[][] {
            c4,
            negate(c1),
            negate(c2),
            negate(c3)
        };

        Relationship[] rels = new Relationship[] {
            Relationship.LEQ,
            Relationship.GEQ,
            Relationship.EQ
        };

        double[] rhsVals = new double[] {
            -200.0, -150.0, -100.0, -95.0, -91.0, -83.0, -62.0, -54.0,
            -23.0, -1.0, 0.0, 1.0, 23.0, 54.0, 62.0, 83.0, 91.0, 95.0, 100.0
