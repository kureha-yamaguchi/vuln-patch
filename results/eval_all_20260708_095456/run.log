package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException e) {
                // Expected on fixed versions and for other invalid anchors.
            }
        }

        String single = data.consumeBoolean() ? "l" : "L";
        if (data.consumeBoolean()) {
            single = data.consumeAsciiString(0) + single;
            if (single.length() > 1) {
                single = single.substring(single.length() - 1);
            }
        }
        try {
            NumberUtils.createNumber(single);
        } catch (NumberFormatException e) {
            // Expected on fixed versions.
        }

        String prefix = data.consumeAsciiString(32);
        int mode = data.consumeInt(0, 7);
        String candidate;
        switch (mode) {
            case 0:
                candidate = prefix + "L";
                break;
            case 1:
                candidate = prefix + "l";
                break;
            case 2:
                candidate = prefix + "F";
                break;
            case 3:
                candidate = prefix + "f";
                break;
            case 4:
                candidate = prefix + "D";
                break;
            case 5:
                candidate = prefix + "d";
                break;
            case 6:
                candidate = prefix;
                break;
            default:
                candidate = data.consumeRemainingAsString();
                break;
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            // Clean rejection is valid.
        }

        String digits = data.consumeAsciiString(40);
        boolean negative = data.consumeBoolean();
        boolean withDecimal = data.consumeBoolean();
        boolean withExponent = data.consumeBoolean();
        boolean withSuffix = data.consumeBoolean();

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == (negative ? 1 : 0)) {
            sb.append(data.consumeInt(0, 9));
        }
        if (withDecimal) {
            sb.append('.');
            sb.append(data.consumeInt(0, 9));
            if (data.consumeBoolean()) {
                sb.append(data.consumeInt(0, 9));
            }
        }
        if (withExponent) {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
            if (data.consumeBoolean()) {
                sb.append(data.consumeBoolean() ? '-' : '+');
            }
            sb.append(data.consumeInt(0, 9));
            if (data.consumeBoolean()) {
                sb.append(data.consumeInt(0, 9));
            }
        }
        if (withSuffix) {
            char[] suffixes = new char[] { 'L', 'l', 'F', 'f', 'D', 'd' };
            sb.append(suffixes[data.consumeInt(0, suffixes.length - 1)]);
        }
        String numericCandidate = sb.toString();

        try {
            NumberUtils.createNumber(numericCandidate);
        } catch (NumberFormatException e) {
            // Clean rejection is valid.
        }

        String core = buildIntegralCore(data);
        try {
            Number left = NumberUtils.createNumber(core + "L");
            Number right = NumberUtils.createNumber(core + "l");
            if (left == null || right == null || !left.toString().equals(right.toString())) {
                throw new RuntimeException("metamorphic violation: createNumber(s+\"L\") != createNumber(s+\"l\")");
            }
        } catch (NumberFormatException e) {
            // Relation only applies when both variants are accepted.
        }
    }

    private static String buildIntegralCore(FuzzedDataProvider data) {
        String raw = data.consumeAsciiString(32);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0 || (sb.length() == 1 && sb.charAt(0) == '-')) {
            sb.append(data.consumeInt(0, 9));
            if (data.consumeBoolean()) {
                sb.append(data.consumeInt(0, 9));
            }
        }
        return sb.toString();
    }
}
