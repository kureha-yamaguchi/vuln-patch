<xref>
public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        {
            TimeSeries s = new TimeSeries("S");
            s.add(new Day(19, 8, 2005), 1);
            s.add(new Day(31, 1, 2006), 1);
            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);
            s.getIndex(start);
            s.getIndex(end);
            try {
                TimeSeries copy = s.createCopy(start, end);
                if (copy == null) {
                    throw new RuntimeException("null copy");
                }
                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("metamorphic violation: empty gap copy must be empty");
                }
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        final int maxOrd = 28 * 12 * 20 - 1;
        int count = data.consumeInt(2, 8);
        int[] values = new int[count];

        int first = data.consumeInt(0, maxOrd - 3);
        int gap = data.consumeInt(2, Math.min(32, maxOrd - first));
        int second = first + gap;
        values[0] = first;
        values[1] = second;

        int current = second;
        for (int i = 2; i < count; i++) {
            int remainingSlots = count - i;
            int maxStep = Math.max(1, (maxOrd - current - remainingSlots + 1));
            int step = data.consumeInt(1, maxStep);
            current += step;
            values[i] = current;
        }
        Arrays.sort(values);

        TimeSeries series = new TimeSeries(data.consumeString(20));
        for (int i = 0; i < values.length; i++) {
            int ord = values[i];
            int year = 2000 + (ord / 336);
            int rem = ord % 336;
            int month = 1 + (rem / 28);
            int dayOfMonth = 1 + (rem % 28);
            try {
                series.add(new Day(dayOfMonth, month, year), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int gapStartOrd = values[0] + 1;
        int gapEndOrd = values[1] - 1;
        if (gapStartOrd <= gapEndOrd) {
            int startOrd = data.consumeInt(gapStartOrd, gapEndOrd);
            int endOrd = data.consumeInt(startOrd, gapEndOrd);

            Day start = new Day(1 + (startOrd % 28), 1 + ((startOrd % 336) / 28), 2000 + (startOrd / 336));
            Day end = new Day(1 + (endOrd % 28), 1 + ((endOrd % 336) / 28), 2000 + (endOrd / 336));

            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            try {
                TimeSeries gapCopy = series.createCopy(start, end);
                if (gapCopy == null) {
                    throw new RuntimeException("null gap copy");
                }
                if (startIndex >= 0 || endIndex >= 0) {
                    return;
                }
                int insertionPoint = -(startIndex + 1);
                int endBefore = -(endIndex + 1) - 1;
                if (insertionPoint == 1 && endBefore == 0) {
                    if (gapCopy.getItemCount() != 0) {
                        throw new RuntimeException("metamorphic violation: copy over constructed empty first gap must be empty");
                    }
                }
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        if (data.consumeBoolean()) {
            int before = values[0] - 1;
            if (before >= 0) {
                Day d = new Day(1 + (before % 28), 1 + ((before % 336) / 28), 2000 + (before / 336));
                series.getIndex(d);
                try {
                    TimeSeries empty = series.createCopy(d, d);
                    if (empty == null) {
                        throw new RuntimeException("null clone-path copy");
                    }
                    if (empty.getItemCount() != 0) {
                        throw new RuntimeException("metamorphic violation: copy before first item must be empty");
                    }
                } catch (IllegalArgumentException e) {
                    return;
                } catch (CloneNotSupportedException e) {
                    return;
                }
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod startExisting = series.getTimePeriod(i);
            RegularTimePeriod endExisting = series.getTimePeriod(j);
            series.getIndex(startExisting);
            series.getIndex(endExisting);

            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);
            TimeSeries byIndex = series.createCopy(i, j);

