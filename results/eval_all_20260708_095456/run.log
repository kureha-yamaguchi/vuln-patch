package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;
import java.util.Calendar;
import java.util.GregorianCalendar;
import java.util.TimeZone;

public class FuzzHarness {
    private static Day dayFromOrdinal(int ordinal) {
        Calendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(2000, Calendar.JANUARY, 1, 0, 0, 0);
        cal.add(Calendar.DAY_OF_YEAR, ordinal);
        return new Day(cal.getTime());
    }

    private static void assertEmptyCopy(TimeSeries original, TimeSeries copy, String which) {
        if (copy == null) {
            throw new RuntimeException("metamorphic violation: " + which + " returned null");
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("metamorphic violation: " + which + " expected empty copy for empty range");
        }
        if (copy == original) {
            throw new RuntimeException("metamorphic violation: " + which + " returned original instance");
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        s.getIndex(start);
        s.getIndex(end);

        TimeSeries copy = s.createCopy(start, end);
        assertEmptyCopy(s, copy, "anchor createCopy(start,end)");
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
