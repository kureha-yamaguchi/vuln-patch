            1.8630791465263745E-16,
            6.288759227922111E-16,
            2.0204433920597856E-15,
            6.198768938576155E-15,
            1.821419346860626E-14,
            5.139176445538471E-14,
            1.3956427429045787E-13,
            3.655705706448139E-13,
            9.253753324779779E-13,
            2.267636001476696E-12,
            5.3880460095836855E-12,
            1.2431632654852931E-11
        };

        // ANCHOR: exact trigger from the failing test.
        runFit(anchor, 0.0, 1.0);

        // EXPLORE: generate many real positive, monotone-increasing Gaussian-tail inputs.
        int n = data.consumeInt(3, 64);
        double xStart = data.consumeInt(-1000, 1000);
        double xStep = data.consumeInt(1, 20);

        double[] ys = new double[n];
        if (data.consumeBoolean()) {
            // Construct a genuine Gaussian right-tail sampled before its peak.
            double mean = xStart + xStep * (n - 1 + data.consumeInt(1, 4 * n + 1));
            double sigma = data.consumeInt(1, 200);
            int log10Amp = data.consumeInt(-250, 50);
            double amp = Math.pow(10.0, log10Amp);
            for (int i = 0; i < n; i++) {
                double x = xStart + i * xStep;
                double z = (x - mean) / sigma;
                double y = amp * Math.exp(-0.5 * z * z);
                if (!(y > 0.0) || Double.isInfinite(y) || Double.isNaN(y)) {
                    y = Double.MIN_VALUE;
                }
                ys[i] = y;
            }
        } else {
            // Construct a generic positive increasing tail.
            double seed = Math.pow(10.0, data.consumeInt(-300, -1));
            double growth = 1.0 + (data.consumeInt(1, 1000) / 200.0);
            double cur = seed;
            for (int i = 0; i < n; i++) {
                if (!(cur > 0.0) || Double.isInfinite(cur) || Double.isNaN(cur)) {
                    cur = Double.MIN_VALUE;
                }
                ys[i] = cur;
                cur *= growth;
                if (Double.isInfinite(cur) || !(cur > 0.0)) {
                    cur = Math.nextUp(ys[i]);
                }
            }
        }

        try {
            double[] p1 = runFit(ys, xStart, xStep);

            // METAMORPHIC CHECK:
            // Equivalent inputs: two independent fitters fed the same observations
            // must produce the same fitted parameters.
            double[] p2 = runFit(copy(ys), xStart, xStep);
            if (!sameParams(p1, p2)) {
                throw new RuntimeException("metamorphic violation: same observations produced different fitted parameters");
            }
        } catch (NotStrictlyPositiveException e) {
            // Clean rejection/validation is acceptable in fuzzed exploration.
            return;
        } catch (NumberIsTooSmallException e) {
            return;
        } catch (OutOfRangeException e) {
            return;
        } catch (ZeroException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static double[] runFit(double[] ys, double xStart, double xStep) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ys.length; i++) {
            fitter.addObservedPoint(xStart + i * xStep, ys[i]);
        }
        return fitter.fit();
    }

    private static double[] copy(double[] in) {
        double[] out = new double[in.length];
        System.arraycopy(in, 0, out, 0, in.length);
        return out;
    }

    private static boolean sameParams(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            double x = a[i];
            double y = b[i];
            if (Double.isNaN(x) && Double.isNaN(y)) {
                continue;
            }
            if (Double.isInfinite(x) || Double.isInfinite(y)) {
                if (x != y) {
                    return false;
                }
                continue;
            }
            double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
            if (Math.abs(x - y) > 1e-9 * scale) {
                return false;
            }
        }
        return true;
    }
}
