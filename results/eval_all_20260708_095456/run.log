        java.lang.Deprecated ann = FuzzHarness.class.getAnnotation(java.lang.Deprecated.class);
        if (ann != null) {
            String annText = AnnotationUtils.toString(ann);
            StringUtils.length(annText);
        }

        int len = data.consumeInt(1, 8);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            int kind = data.consumeInt(0, 6);
            switch (kind) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(64);
                    break;
                case 2:
                    array[i] = data.consumeAsciiString(64);
                    break;
                case 3:
                    array[i] = ArrayUtils.toString(data.consumeBytes(16), null);
                    break;
                case 4:
                    array[i] = BooleanUtils.toString(data.consumeBoolean(), "T", "F", null);
                    break;
                case 5:
                    array[i] = ann;
                    break;
                default:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
            }
        }

        if (data.consumeBoolean()) {
            array[0] = null;
        }

        int startIndex = data.consumeInt(0, len);
        int endIndex = data.consumeInt(startIndex, len);
        if (data.consumeBoolean()) {
            startIndex = 0;
            endIndex = len;
        }

        char charSep = (char) data.consumeInt(0, Character.MAX_VALUE);
        String stringSep;
        if (data.consumeBoolean()) {
            stringSep = null;
        } else if (data.consumeBoolean()) {
            stringSep = String.valueOf(charSep);
