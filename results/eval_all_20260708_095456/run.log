                return;
            }
        }

        try {
            exploredPlot.removeDomainMarker(targetIndex, domainMarker, targetLayer, notify);
            exploredPlot.removeRangeMarker(targetIndex, rangeMarker, targetLayer, notify);
        } catch (IllegalArgumentException e) {
            return;
