package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.distribution.BinomialDistribution;
import org.apache.commons.math3.distribution.FDistribution;
import org.apache.commons.math3.exception.MathIllegalArgumentException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            for (int trials = 500000; trials < 20000000; trials += 100000) {
                BinomialDistribution dist = new BinomialDistribution(trials, 0.5);
                int p = dist.inverseCumulativeProbability(0.5);
                if (p != trials / 2) {
                    throw new RuntimeException("anchor violation: symmetric binomial median");
                }
            }

            FDistribution anchorF = new FDistribution(200000, 200000);
            double anchorResult = anchorF.inverseCumulativeProbability(0.01);
            if (!(anchorResult < 1.0) || Double.isNaN(anchorResult)) {
                throw new RuntimeException("anchor violation: F inverse cumulative result");
            }
        } catch (MathIllegalArgumentException e) {
            return;
        }

        int mode = data.consumeInt(0, 2);

        if (mode == 0) {
            int trials = data.consumeInt(5, 200) * 100000;
            try {
                BinomialDistribution dist = new BinomialDistribution(trials, 0.5);
                int p = dist.inverseCumulativeProbability(0.5);
                if (p != trials / 2) {
                    throw new RuntimeException("binomial exploration violation");
                }
            } catch (MathIllegalArgumentException e) {
                return;
            }
        } else {
            int df = data.consumeInt(100000, 1000000);
            double prob;
            if (mode == 1) {
                prob = 0.01;
            } else {
                prob = data.consumeInt(1, 999999) / 1000000.0;
            }

            try {
                FDistribution f = new FDistribution(df, df);
                double x = f.inverseCumulativeProbability(prob);
                if (Double.isNaN(x) || Double.isInfinite(x) || x <= 0.0) {
                    throw new RuntimeException("F exploration violation: non-finite quantile");
                }
                if (prob < 0.5 && !(x < 1.0)) {
                    throw new RuntimeException("F exploration violation: equal-df symmetry below median");
                }
                if (prob > 0.5 && !(x > 1.0)) {
                    throw new RuntimeException("F exploration violation: equal-df symmetry above median");
                }
            } catch (MathIllegalArgumentException e) {
                return;
            }
        }

