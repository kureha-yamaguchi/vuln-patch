    private static void runGuaranteedCrashAnchor() {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            RectangleConstraint constraint = fixedWidthNoHeightConstraint(10.0);
            BlockContainer container = new BlockContainer(new BorderArrangement());

            container.add(new EmptyBlock(5.0, 6.0));
            safeArrange(container, g2, constraint);

            container.clear();
            EmptyBlock right = new EmptyBlock(12.3, 45.6);
            double ignored = right.getWidth();
            if (ignored == Double.MIN_VALUE) {
                throw new RuntimeException("unreachable");
            }
            container.add(right, RectangleEdge.RIGHT);

            List blocks = container.getBlocks();
            if (blocks == null) {
                throw new RuntimeException("unexpected null block list");
            }

            safeArrange(container, g2, constraint);
        } finally {
            g2.dispose();
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(64, 64, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            double totalWidth = positiveTenth(data.consumeInt(0, 200));
            double overflow = positiveTenth(data.consumeInt(1, 200));
            double leftWidth = data.consumeBoolean() ? 0.0 : positiveTenth(data.consumeInt(0, 200));
            double rightWidth = totalWidth + overflow;
            double centerWidth = positiveTenth(data.consumeInt(0, 200));
            double topWidth = positiveTenth(data.consumeInt(0, 200));
            double bottomWidth = positiveTenth(data.consumeInt(0, 200));

            double leftHeight = positiveTenth(data.consumeInt(0, 200));
            double rightHeight = positiveTenth(data.consumeInt(0, 200));
            double centerHeight = positiveTenth(data.consumeInt(0, 200));
            double topHeight = positiveTenth(data.consumeInt(0, 200));
            double bottomHeight = positiveTenth(data.consumeInt(0, 200));

            boolean addLeft = data.consumeBoolean();
            boolean addRight = true;
            boolean addCenter = data.consumeBoolean();
            boolean addTop = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();

            RectangleConstraint constraint = fixedWidthNoHeightConstraint(totalWidth);

            BlockContainer c1 = new BlockContainer(new BorderArrangement());
            populate(c1, addTop, addBottom, addLeft, addRight, addCenter,
                    topWidth, topHeight, bottomWidth, bottomHeight,
                    leftWidth, leftHeight, rightWidth, rightHeight,
                    centerWidth, centerHeight);
            int before = c1.getBlocks().size();
            Size2D s1 = safeArrange(c1, g2, constraint);
            int after = c1.getBlocks().size();
            if (s1 != null && before != after) {
                throw new RuntimeException("metamorphic violation: arrange changed block membership");
            }

            BlockContainer c2 = new BlockContainer(new BorderArrangement());
            populate(c2, addTop, addBottom, addLeft, addRight, addCenter,
                    topWidth, topHeight, bottomWidth, bottomHeight,
                    leftWidth, leftHeight, rightWidth, rightHeight,
                    centerWidth, centerHeight);
            Size2D s2 = safeArrange(c2, g2, constraint);

            if (s1 != null && s2 != null) {
                if (Double.doubleToLongBits(s1.getWidth()) != Double.doubleToLongBits(s2.getWidth())
                        || Double.doubleToLongBits(s1.getHeight()) != Double.doubleToLongBits(s2.getHeight())) {
                    throw new RuntimeException("metamorphic violation: equivalent containers produced different arranged sizes");
                }
            }
        } finally {
            g2.dispose();
        }
    }

    private static void populate(BlockContainer container,
                                 boolean addTop, boolean addBottom, boolean addLeft,
                                 boolean addRight, boolean addCenter,
                                 double topWidth, double topHeight,
                                 double bottomWidth, double bottomHeight,
                                 double leftWidth, double leftHeight,
                                 double rightWidth, double rightHeight,
                                 double centerWidth, double centerHeight) {
        if (addCenter) {
            EmptyBlock center = new EmptyBlock(centerWidth, centerHeight);
            center.getWidth();
            container.add(center);
        }
        if (addTop) {
            EmptyBlock top = new EmptyBlock(topWidth, topHeight);
            top.getWidth();
            container.add(top, RectangleEdge.TOP);
        }
        if (addBottom) {
            EmptyBlock bottom = new EmptyBlock(bottomWidth, bottomHeight);
            bottom.getWidth();
            container.add(bottom, RectangleEdge.BOTTOM);
        }
        if (addLeft) {
            EmptyBlock left = new EmptyBlock(leftWidth, leftHeight);
            left.getWidth();
            container.add(left, RectangleEdge.LEFT);
        }
        if (addRight) {
            EmptyBlock right = new EmptyBlock(rightWidth, rightHeight);
            right.getWidth();
            container.add(right, RectangleEdge.RIGHT);
        }
        container.getBlocks();
    }

    private static RectangleConstraint fixedWidthNoHeightConstraint(double width) {
        return new RectangleConstraint(
                width, new Range(width, width), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );
    }

    private static Size2D safeArrange(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
            if (isExpectedRejection(t)) {
                return null;
            }
            rethrowUnchecked(t);
            return null;
        }
    }

    private static boolean isExpectedRejection(Throwable t) {
        if (t instanceof IllegalArgumentException) {
            return true;
        }
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            return "Not implemented.".equals(msg);
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            for (StackTraceElement ste : cur.getStackTrace()) {
                String cls = ste.getClassName();
                String method = ste.getMethodName();
                if ("org.jfree.chart.block.BorderArrangement".equals(cls) && "arrangeFF".equals(method)) {
                    return true;
                }
                if ("org.jfree.data.Range".equals(cls) && "<init>".equals(method)) {
                    return true;
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static double positiveTenth(int n) {
        return n / 10.0;
    }
}
