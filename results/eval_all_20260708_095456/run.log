public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int vars = data.consumeInt(2, 8);
        int constraintsCount = data.consumeInt(2, 10);

        double[] objective = new double[vars];
        objective[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            objective[i] = smallCoeff(data);
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] sharedA = positiveVector(data, vars);
        double[] sharedB = positiveVector(data, vars);

        double rhs1 = positiveRhs(data);
        double rhs2 = rhs1;
        double rhs3 = positiveRhs(data);

        constraints.add(new LinearConstraint(sharedA, Relationship.GEQ, rhs1));
        constraints.add(new LinearConstraint(Arrays.copyOf(sharedA, sharedA.length), Relationship.GEQ, rhs2));
        constraints.add(new LinearConstraint(sharedB, data.consumeBoolean() ? Relationship.GEQ : Relationship.EQ, rhs3));

        for (int i = constraints.size(); i < constraintsCount; i++) {
            double[] coeffs;
            if (data.consumeBoolean()) {
                coeffs = Arrays.copyOf(sharedA, sharedA.length);
                int pos = data.consumeInt(0, vars - 1);
                coeffs[pos] += data.consumeBoolean() ? 1.0 : -1.0;
            } else {
                coeffs = mixedVector(data, vars);
            }

            Relationship rel;
            int pick = data.consumeInt(0, 2);
            if (pick == 0) {
                rel = Relationship.GEQ;
            } else if (pick == 1) {
                rel = Relationship.EQ;
            } else {
                rel = Relationship.LEQ;
            }

            double rhs = data.consumeBoolean() ? positiveRhs(data) : smallCoeff(data);
            constraints.add(new LinearConstraint(coeffs, rel, rhs));
        }

        runAndMaybeCheck(objective, constraints, true);
        runAndMaybeCheck(objective, constraints, false);
    }

