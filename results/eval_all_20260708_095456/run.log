    private static GeneratedProblem generateProblem(FuzzedDataProvider data) {
        int vars = data.consumeInt(4, 12);
        int positiveRows = data.consumeInt(2, 4);
        int pivotIndex = data.consumeInt(0, vars - 1);

        double[] objective = new double[vars];
        objective[pivotIndex] = 1.0;
        for (int i = 0; i < vars; i++) {
            if (i != pivotIndex) {
                objective[i] = data.consumeInt(-1, 1);
            }
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        for (int r = 0; r < positiveRows; r++) {
            double[] coeff = new double[vars];
            coeff[pivotIndex] = 0.0;
            for (int i = 0; i < vars; i++) {
                if (i == pivotIndex) {
                    continue;
                }
                coeff[i] = data.consumeInt(1, 99);
            }
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, data.consumeInt(1, 99)));
        }

        double[] cyclingRow = new double[vars];
        cyclingRow[pivotIndex] = data.consumeInt(1, 99);
        for (int i = 0; i < vars; i++) {
            if (i == pivotIndex) {
                continue;
            }
            cyclingRow[i] = -data.consumeInt(1, 99);
        }
        constraints.add(new LinearConstraint(cyclingRow, Relationship.GEQ, 0.0));

        int explicitNonNeg = data.consumeInt(Math.max(1, vars / 2), vars);
        boolean[] added = new boolean[vars];
        added[pivotIndex] = true;
        for (int i = 0; i < explicitNonNeg; i++) {
            int idx = (i == 0) ? pivotIndex : data.consumeInt(0, vars - 1);
            if (!added[idx] || data.consumeBoolean()) {
                double[] unit = new double[vars];
                unit[idx] = 1.0;
                constraints.add(new LinearConstraint(unit, Relationship.GEQ, 0.0));
                added[idx] = true;
            }
        }
        for (int i = 0; i < vars; i++) {
            if (!added[i]) {
                double[] unit = new double[vars];
                unit[i] = 1.0;
                constraints.add(new LinearConstraint(unit, Relationship.GEQ, 0.0));
            }
        }

        GeneratedProblem gp = new GeneratedProblem();
        gp.objective = new LinearObjectiveFunction(objective, data.consumeInt(-3, 3));
        gp.constraints = constraints;
        gp.goalType = data.consumeBoolean() ? GoalType.MAXIMIZE : GoalType.MINIMIZE;
        gp.restrictToNonNegative = false;
        return gp;
    }

    private static List<LinearConstraint> scaleConstraints(List<LinearConstraint> constraints, double factor) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(constraints.size());
        for (LinearConstraint c : constraints) {
            out.add(new LinearConstraint(
                    scale(c.getCoefficients().toArray(), factor),
                    c.getRelationship(),
                    c.getValue() * factor));
        }
        return out;
    }

    private static double[] scale(double[] a, double factor) {
        double[] out = new double[a.length];
        for (int i = 0; i < a.length; i++) {
            out[i] = a[i] * factor;
        }
        return out;
    }

    private static boolean approximatelyEqual(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= 1.0e-8 * scale;
    }

    private static final class GeneratedProblem {
        LinearObjectiveFunction objective;
        List<LinearConstraint> constraints;
        GoalType goalType;
        boolean restrictToNonNegative;
    }
}
