            }
        }
        return new Line(a, b).wholeHyperplane();
    }

    private static void exercise(PolygonsSet set) {
        Vector2D[][] v1 = set.getVertices();
        double size1 = set.getSize();
        Vector2D bary1 = (Vector2D) set.getBarycenter();

