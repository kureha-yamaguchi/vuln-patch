        NormalDistributionImpl dist;
        try {
            dist = new NormalDistributionImpl((double) mean, 1.0);
        } catch (IllegalArgumentException e) {
            return;
        }

        int offset = data.consumeInt(-32, 32);
        if (offset == 0) {
            offset = 2;
        }

        double x = mean + offset;
        double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        if (!(p > 0.0 && p < 1.0) || Double.isNaN(p)) {
            return;
        }

        try {
            double inv = dist.inverseCumulativeProbability(p);
            if (Double.isNaN(inv) || Double.isInfinite(inv)) {
                throw new RuntimeException("unexpected non-finite inverse result");
            }

            double tol = 1.0e-12 * Math.max(1.0, Math.abs(x));
            if (Math.abs(inv - x) > tol) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(x)) != x");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }
    }

