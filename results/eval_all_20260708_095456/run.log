import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static String sanitizeLiteral(String s) {
        StringBuffer sb = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == '\'' || ch == '{' || ch == '}') {
                sb.append('a');
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String buildQuotedPattern(String left, String middle, String right, int variant) {
        switch (variant) {
            case 0:
                return "''";
            case 1:
                return left + "''";
            case 2:
                return "''" + right;
            case 3:
                return left + "''" + right;
            case 4:
                return left + " '' " + right;
            case 5:
                return left + "''" + middle + " {0}";
            case 6:
                return left + " {0} " + middle + "''" + right;
            default:
                return left + "''" + middle + " {0} " + right;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        java.util.Map registry = java.util.Collections.EMPTY_MAP;

        new ExtendedMessageFormat("it''s a {0,lower} 'test'!", java.util.Locale.getDefault(), registry);

        String left = sanitizeLiteral(data.consumeAsciiString(64));
