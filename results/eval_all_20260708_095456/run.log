import org.apache.commons.math3.exception.NumberIsTooSmallException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCycleExample();

        GeneratedProblem gp = buildDegenerateProblem(data);

        try {
            exerciseTableau(gp.objective, gp.constraints, gp.nonNegative);
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        PointValuePair base = null;
        PointValuePair dup = null;
        boolean baseOk = false;
        boolean dupOk = false;

        try {
            base = optimizeReal(gp.objective, gp.constraints, gp.nonNegative);
            baseOk = true;
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return;
        } catch (UnboundedSolutionException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        ArrayList<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(gp.constraints);
        if (!gp.constraints.isEmpty()) {
            duplicated.add(gp.constraints.get(0));
        }

        try {
            exerciseTableau(gp.objective, duplicated, gp.nonNegative);
            dup = optimizeReal(gp.objective, duplicated, gp.nonNegative);
            dupOk = true;
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
            return;
        } catch (UnboundedSolutionException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        if (baseOk && dupOk && !sameSolution(base, dup)) {
            throw new RuntimeException("metamorphic violation: duplicating an identical constraint changed the optimum");
        }
    }

    private static void runAnchorCycleExample() {
        LinearObjectiveFunction f =
                new LinearObjectiveFunction(new double[] {10.0, -57.0, -9.0, -24.0}, 0.0);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] {0.5, -5.5, -2.5, 9.0}, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] {0.5, -1.5, -0.5, 1.0}, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0, 0.0, 0.0}, Relationship.LEQ, 1.0));

        try {
            exerciseTableau(f, constraints, true);
            optimizeReal(f, constraints, true);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (NoFeasibleSolutionException e) {
        } catch (UnboundedSolutionException e) {
        } catch (MathIllegalArgumentException e) {
        } catch (IllegalArgumentException e) {
        }
    }

    private static PointValuePair optimizeReal(LinearObjectiveFunction f,
                                               Collection<LinearConstraint> constraints,
                                               boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, nonNegative);
    }

    private static void exerciseTableau(LinearObjectiveFunction f,
                                        Collection<LinearConstraint> constraints,
                                        boolean nonNegative) {
        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, nonNegative, 1.0e-6, 10);
        int objectives = tableau.getNumObjectiveFunctions();
        int height = tableau.getHeight();
        int width = tableau.getWidth();
        int artificials = tableau.getNumArtificialVariables();
        int artificialOffset = tableau.getArtificialVariableOffset();

        double sink = 0.0;
        for (int r = 0; r < height; r++) {
            sink += tableau.getEntry(r, width - 1);
        }
        for (int c = 0; c < width; c++) {
            Integer row = tableau.getBasicRow(c);
            if (row != null) {
                sink += row.intValue();
            }
        }
        sink += objectives + artificials + artificialOffset + height + width;
        if (Double.isNaN(sink)) {
            throw new RuntimeException("unexpected NaN");
        }
    }

    private static GeneratedProblem buildDegenerateProblem(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 6);
        int duplicates = data.consumeInt(2, 5);
        int extra = data.consumeInt(0, 4);
        int pivot = data.consumeInt(0, vars - 1);
        boolean nonNegative = true;

        double[] objective = new double[vars];
        for (int i = 0; i < vars; i++) {
            objective[i] = data.consumeInt(-3, 7);
        }
        objective[pivot] = Math.max(1.0, objective[pivot]);

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double rhs = data.consumeInt(1, 8);
        double pivotCoeff = data.consumeBoolean() ? 1.0 : 2.0;
        double[] dupCoeffs = new double[vars];
        dupCoeffs[pivot] = pivotCoeff;

        for (int i = 0; i < duplicates; i++) {
            constraints.add(new LinearConstraint(Arrays.copyOf(dupCoeffs, dupCoeffs.length), Relationship.LEQ, rhs));
        }

        for (int i = 0; i < vars; i++) {
            double[] upper = new double[vars];
            upper[i] = 1.0;
            constraints.add(new LinearConstraint(upper, Relationship.LEQ, data.consumeInt(1, 10)));
        }

        for (int i = 0; i < extra; i++) {
            double[] coeffs = new double[vars];
            for (int j = 0; j < vars; j++) {
                coeffs[j] = data.consumeInt(-2, 3);
            }
            coeffs[pivot] = Math.abs(coeffs[pivot]) + 1.0;
            double b = data.consumeInt(1, 12);
            constraints.add(new LinearConstraint(coeffs, data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ, b));
        }

        if (data.consumeBoolean()) {
            double[] eq = new double[vars];
            eq[pivot] = pivotCoeff;
            constraints.add(new LinearConstraint(eq, Relationship.LEQ, rhs));
        }

        return new GeneratedProblem(new LinearObjectiveFunction(objective, data.consumeInt(-5, 5)),
                constraints,
                nonNegative);
    }

    private static boolean sameSolution(PointValuePair a, PointValuePair b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (a.getPoint() == null || b.getPoint() == null) {
            return a.getPoint() == b.getPoint() && close(a.getValue(), b.getValue());
        }
        double[] pa = a.getPoint();
        double[] pb = b.getPoint();
        if (pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (!close(pa[i], pb[i])) {
                return false;
            }
        }
        return close(a.getValue(), b.getValue());
    }

    private static boolean close(double x, double y) {
        double diff = Math.abs(x - y);
        double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
        return diff <= 1.0e-6 * scale;
    }

    private static final class GeneratedProblem {
        final LinearObjectiveFunction objective;
        final ArrayList<LinearConstraint> constraints;
        final boolean nonNegative;

        GeneratedProblem(LinearObjectiveFunction objective,
                         ArrayList<LinearConstraint> constraints,
                         boolean nonNegative) {
            this.objective = objective;
            this.constraints = constraints;
            this.nonNegative = nonNegative;
        }
    }
}
