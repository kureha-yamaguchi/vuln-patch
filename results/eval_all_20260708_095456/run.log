package org.apache.commons.lang.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "-1l", "01l", "1l" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException e) {
                // Buggy versions reject valid lowercase long suffixes; don't report the known crash here.
            } catch (NullPointerException e) {
                // Defensive: invalid internal state should not happen for these anchors, but don't stop exploration.
            }
        }

        int firstKind = data.consumeInt(0, 2);
        boolean negative = data.consumeBoolean();
        int extraDigitsLen = data.consumeInt(0, 64);
        byte[] digitBytes = data.consumeBytes(extraDigitsLen);

        StringBuilder numeric = new StringBuilder();
        if (firstKind == 0) {
            numeric.append('-');
        } else {
            numeric.append((char) ('0' + (firstKind - 1)));
        }
        for (int i = 0; i < digitBytes.length; i++) {
            int d = digitBytes[i] & 0x0F;
            if (d >= 10) {
                d -= 10;
            }
            numeric.append((char) ('0' + d));
        }
        if (negative && numeric.length() > 0 && numeric.charAt(0) != '-') {
            numeric.insert(0, '-');
        }

        String suffix = data.consumeBoolean() ? "l" : "L";
        String candidate = numeric.toString() + suffix;

        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            // Clean rejection is acceptable for malformed fuzz inputs.
        } catch (IllegalArgumentException e) {
            // Clean rejection.
        }

        if (candidate.length() > 1) {
            String core = candidate.substring(0, candidate.length() - 1);
            try {
                if (core.length() > 1) {
                    NumberUtils.isDigits(core.substring(1));
                }
            } catch (RuntimeException e) {
                throw e;
            }

            try {
                NumberUtils.createLong(core);
            } catch (NumberFormatException e) {
                try {
                    NumberUtils.createBigInteger(core);
                } catch (NumberFormatException ignored) {
                    // Clean rejection.
                }
            }
        }

        String base = numeric.toString();
        if (base.length() > 0) {
            String upper = base + "L";
            String lower = base + "l";
            Number upperParsed = null;
            try {
                upperParsed = NumberUtils.createNumber(upper);
            } catch (NumberFormatException e) {
                upperParsed = null;
            }

            if (upperParsed != null) {
                try {
                    Number lowerParsed = NumberUtils.createNumber(lower);
                    if (lowerParsed == null
                            || !upperParsed.getClass().equals(lowerParsed.getClass())
                            || !upperParsed.toString().equals(lowerParsed.toString())) {
                        throw new RuntimeException("metamorphic violation: createNumber should parse 'l' and 'L' suffixes equivalently");
                    }
                } catch (NumberFormatException e) {
                    throw new RuntimeException("metamorphic violation: lowercase long suffix rejected while uppercase accepted");
                }
            }
        }
    }
}
