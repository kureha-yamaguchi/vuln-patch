package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test. On the buggy version this must
        // surface as the known MathException from inverseCumulativeProbability.
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double result = anchor.inverseCumulativeProbability(0.9772498680518209);
            if (!Double.isFinite(result)) {
                throw new RuntimeException("non-finite anchor result");
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        // EXPLORE: preserve the root-cause property while varying real inputs.
        // For a real normal distribution, if p = CDF(mean + 2 * sd), then
        // inverseCumulativeProbability(p) must recover mean + 2 * sd.
        // The buggy bracket logic can fail when one bracket endpoint is exactly a root.
        double mean = data.consumeInt(-100000, 100000);
        int sdToken = data.consumeInt(-1000, 1000);

        // Also try constructor validation paths (<init>, createIllegalArgumentException, buildMessage).
        try {
            new NormalDistributionImpl(mean, (double) sdToken);
        } catch (IllegalArgumentException expected) {
            // Clean rejection is correct post-fix behavior.
        }

        if (sdToken <= 0) {
            return;
        }

        double sd = (double) sdToken;
        final NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, sd);
        } catch (IllegalArgumentException expected) {
            return;
        }

        double target = mean + 2.0 * sd;
        if (!Double.isFinite(target)) {
            return;
        }

        try {
            double p = dist.cumulativeProbability(target);
            if (!(p > 0.0 && p < 1.0) || !Double.isFinite(p)) {
                return;
            }

            double inv = dist.inverseCumulativeProbability(p);
            if (!Double.isFinite(inv)) {
                throw new RuntimeException("non-finite inverse result");
            }

            // METAMORPHIC CHECK: oracle from the constructed input itself.
            // We built p from a known target, so a correct inverse must recover it.
            double tol = 1e-10 * Math.max(1.0, Math.abs(target));
            if (Math.abs(inv - target) > tol) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(mean+2*sd)) != mean+2*sd");
            }
        } catch (IllegalArgumentException expected) {
            // Deliberate input rejection is acceptable.
            return;
        } catch (MathException e) {
            throw new RuntimeException(e);
        }
    }
}
