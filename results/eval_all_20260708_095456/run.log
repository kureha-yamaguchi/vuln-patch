private static void requireUppercaseHexAcceptance(String s) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(s);
        } catch (NumberFormatException ignored) {
            return;
        }

        Number actual;
        try {
            actual = NumberUtils.createNumber(s);
        } catch (NumberFormatException e) {
            throw new RuntimeException("createNumber rejected valid uppercase-hex input: " + s, e);
        }

        if (actual == null || actual.intValue() != expected.intValue()) {
            throw new RuntimeException("createNumber disagrees with createInteger for valid uppercase hex: " + s);
        }
