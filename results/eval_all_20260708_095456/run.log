        if (s.length() <= width) {
            s = s + makeFallbackLongText(width);
        }
        return s;
    }

    private static String makeFallbackLongText(int width) {
        StringBuilder sb = new StringBuilder(width + 1);
        for (int i = 0; i < width + 1; i++) {
            sb.append((char) ('A' + (i % 26)));
        }
        return sb.toString();
    }
}
