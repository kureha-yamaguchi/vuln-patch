package org.jfree.chart.renderer;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Color;
import java.awt.Paint;

public class FuzzHarness {
    private static void requireColor(Paint actual, Color expected, String label) {
        if (!(actual instanceof Color) || !expected.equals(actual)) {
            throw new RuntimeException("unexpected color for " + label + ": " + actual);
        }
    }

    private static boolean samePaint(Paint a, Paint b) {
        return a == null ? b == null : a.equals(b);
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        GrayPaintScale anchor = new GrayPaintScale();
        requireColor(anchor.getPaint(0.0), Color.black, "anchor 0.0");
        requireColor(anchor.getPaint(1.0), Color.white, "anchor 1.0");
        requireColor(anchor.getPaint(-0.5), Color.black, "anchor -0.5");
        requireColor(anchor.getPaint(1.5), Color.white, "anchor 1.5");

        int base = data.consumeInt(-1000, 1000);
        int span = data.consumeInt(1, 1000);
        double lower = base;
        double upper = base + span;

        GrayPaintScale gps = new GrayPaintScale(lower, upper);

        boolean below = data.consumeBoolean();
        int offset1 = data.consumeInt(1, 1000);
        int offset2 = data.consumeInt(1, 1000);

        double probe1 = below ? lower - offset1 : upper + offset1;
        double probe2 = below ? lower - offset2 : upper + offset2;
        double boundary = below ? lower : upper;

        Paint p1 = gps.getPaint(probe1);
        Paint p2 = gps.getPaint(probe2);
        Paint pb = gps.getPaint(boundary);

        if (!samePaint(p1, pb)) {
            throw new RuntimeException("metamorphic violation: out-of-range input must map to nearest bound");
        }
        if (!samePaint(p2, pb)) {
            throw new RuntimeException("metamorphic violation: equivalent clamped inputs disagree");
        }
    }
}
