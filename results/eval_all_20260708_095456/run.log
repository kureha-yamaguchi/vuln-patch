package org.apache.commons.math3.optimization.linear;

import java.util.ArrayList;
import java.util.Collection;
import java.util.List;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchor();

        int extraVars = data.consumeInt(0, 6);
        double objectiveScale = positiveScale(data);
        int duplicateCount = data.consumeInt(0, 2);

        double[] objective = scaledObjective(extraVars, objectiveScale);
        Collection<LinearConstraint> constraints = buildCyclingFamily(data, extraVars, duplicateCount);

        PointValuePair base = solveMaybe(objective, constraints);
        if (base != null) {
            double metamorphicScale = 1.0 + data.consumeInt(1, 8);
            PointValuePair scaled = solveMaybe(scaledObjective(extraVars, objectiveScale * metamorphicScale), constraints);
            if (scaled != null) {
                if (!samePoint(base.getPoint(), scaled.getPoint(), 1e-6)) {
                    throw new RuntimeException("metamorphic violation: positive objective scaling changed optimizer point");
                }
                double expected = base.getValue() * metamorphicScale;
                if (Math.abs(expected - scaled.getValue()) > 1e-6 * Math.max(1.0, Math.abs(expected))) {
                    throw new RuntimeException("metamorphic violation: positive objective scaling changed objective value inconsistently");
                }
            }
        }
    }

    private static void runAnchor() {
        double[] objective = new double[] { 10.0, -57.0, -9.0, -24.0 };
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 0.5, -5.5, -2.5, 9.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { 0.5, -1.5, -0.5, 1.0 }, Relationship.LEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { 1.0, 0.0, 0.0, 0.0 }, Relationship.LEQ, 1.0));
        solveMaybe(objective, constraints);
    }

    private static Collection<LinearConstraint> buildCyclingFamily(FuzzedDataProvider data, int extraVars, int duplicateCount) {
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double s1 = positiveScale(data);
        double s2 = positiveScale(data);
        double s3 = positiveScale(data);

        constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                0.5 * s1, -5.5 * s1, -2.5 * s1, 9.0 * s1
        }), Relationship.LEQ, 0.0 * s1));

        constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                0.5 * s2, -1.5 * s2, -0.5 * s2, 1.0 * s2
        }), Relationship.LEQ, 0.0 * s2));

        constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                1.0 * s3, 0.0, 0.0, 0.0
        }), Relationship.LEQ, 1.0 * s3));

        for (int i = 0; i < duplicateCount; i++) {
            int which = data.consumeInt(0, 2);
            if (which == 0) {
                double sd = positiveScale(data);
                constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                        0.5 * sd, -5.5 * sd, -2.5 * sd, 9.0 * sd
                }), Relationship.LEQ, 0.0));
            } else if (which == 1) {
                double sd = positiveScale(data);
                constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                        0.5 * sd, -1.5 * sd, -0.5 * sd, 1.0 * sd
                }), Relationship.LEQ, 0.0));
            } else {
                double sd = positiveScale(data);
                constraints.add(new LinearConstraint(embed(extraVars, new double[] {
                        1.0 * sd, 0.0, 0.0, 0.0
                }), Relationship.LEQ, 1.0 * sd));
            }
        }

        return constraints;
    }

    private static PointValuePair solveMaybe(double[] objectiveCoefficients, Collection<LinearConstraint> constraints) {
        try {
            SimplexSolver solver = new SimplexSolver();
            solver.setMaxIterations(100);
            LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoefficients, 0.0);
            return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (MathIllegalArgumentException e) {
            return null;
        } catch (MathIllegalStateException e) {
            return null;
        } catch (RuntimeException e) {
            String name = e.getClass().getName();
            if (name.contains("Unbounded") || name.contains("NoFeasible")) {
                return null;
            }
            throw e;
        }
    }

    private static double[] scaledObjective(int extraVars, double scale) {
        return embed(extraVars, new double[] { 10.0 * scale, -57.0 * scale, -9.0 * scale, -24.0 * scale });
    }

    private static double[] embed(int extraVars, double[] core) {
        double[] out = new double[core.length + extraVars];
        System.arraycopy(core, 0, out, 0, core.length);
        return out;
    }

    private static double positiveScale(FuzzedDataProvider data) {
        int n = data.consumeInt(1, 9);
        return (double) n;
    }

    private static boolean samePoint(double[] a, double[] b, double tol) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            double diff = Math.abs(a[i] - b[i]);
            double bound = tol * Math.max(1.0, Math.max(Math.abs(a[i]), Math.abs(b[i])));
            if (diff > bound) {
                return false;
            }
        }
        return true;
    }
}
