package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        List<LinearConstraint> anchorConstraints = buildCyclingConstraints(1, 1, 1);
        solve(anchorConstraints);

        int s1 = data.consumeInt(1, 8);
        int s2 = data.consumeInt(1, 8);
        int s3 = data.consumeInt(1, 8);

        List<LinearConstraint> scaledConstraints = buildCyclingConstraints(s1, s2, s3);
        PointValuePair scaledResult = solve(scaledConstraints);

        PointValuePair anchorResult = solve(anchorConstraints);
        double v1 = anchorResult.getValue();
        double v2 = scaledResult.getValue();
        if (Double.isNaN(v1) != Double.isNaN(v2) || Math.abs(v1 - v2) > 1.0e-9) {
            throw new RuntimeException("metamorphic violation: positive row scaling changed optimum value");
        }
    }

    private static PointValuePair solve(List<LinearConstraint> constraints) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(
                new double[] {10.0, -57.0, -9.0, -24.0}, 0.0);
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static List<LinearConstraint> buildCyclingConstraints(int scale1, int scale2, int scale3) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(
                scale(new double[] {0.5, -5.5, -2.5, 9.0}, scale1),
                Relationship.LEQ,
                0.0 * scale1));

        constraints.add(new LinearConstraint(
                scale(new double[] {0.5, -1.5, -0.5, 1.0}, scale2),
                Relationship.LEQ,
                0.0 * scale2));

        constraints.add(new LinearConstraint(
                scale(new double[] {1.0, 0.0, 0.0, 0.0}, scale3),
                Relationship.LEQ,
                1.0 * scale3));

        return constraints;
    }

    private static double[] scale(double[] in, int factor) {
        double[] out = new double[in.length];
        for (int i = 0; i < in.length; i++) {
            out[i] = in[i] * factor;
        }
        return out;
    }
}
