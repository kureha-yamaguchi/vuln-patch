package org.jfree.data.xy;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        try {
            XYSeries series = new XYSeries(data.consumeString(32), true, true);

            int prefixCount = data.consumeInt(0, Math.min(32, data.remainingBytes() / 2 + 1));
            double[] inserted = new double[Math.max(1, prefixCount + 1)];

            boolean seeded = false;
            double seedX = 0.0;
            double seedY = 0.0;

            for (int i = 0; i < prefixCount; i++) {
                double x = normalizeNumber(data.consumeInt());
                double y = normalizeNumber(data.consumeInt());
                inserted[i] = x;
                series.addOrUpdate(new Double(x), new Double(y));
                if (!seeded) {
                    seedX = x;
                    seedY = y;
                    seeded = true;
                }
            }

            double duplicateX;
            if (seeded && data.consumeBoolean()) {
                int pick = data.consumeInt(0, prefixCount - 1);
                duplicateX = inserted[pick];
            } else {
                duplicateX = normalizeNumber(data.consumeInt());
                seedX = duplicateX;
                seedY = normalizeNumber(data.consumeInt());
                series.addOrUpdate(new Double(seedX), new Double(seedY));
                inserted[prefixCount] = duplicateX;
                seeded = true;
            }

            double duplicateY = normalizeNumber(data.consumeInt());
            XYSeries clone = (XYSeries) series.clone();

            series.addOrUpdate(new Double(duplicateX), new Double(duplicateY));
            clone.addOrUpdate(new Double(duplicateX), new Double(duplicateY));

            int count1 = series.getItemCount();
            int count2 = clone.getItemCount();
            if (count1 != count2) {
                throw new RuntimeException("metamorphic violation: clone diverged in item count");
            }
            for (int i = 0; i < count1; i++) {
                if (!numbersEqual(series.getX(i), clone.getX(i)) || !numbersEqual(series.getY(i), clone.getY(i))) {
                    throw new RuntimeException("metamorphic violation: clone diverged in contents");
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (org.jfree.data.general.SeriesException e) {
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void anchor() {
        XYSeries series = new XYSeries("Series", true, true);
        series.addOrUpdate(new Double(1.0), new Double(1.0));
        series.addOrUpdate(new Double(1.0), new Double(2.0));
        if (!numbersEqual(new Double(1.0), series.getY(0))) {
            throw new RuntimeException("anchor wrong y[0]");
        }
        if (!numbersEqual(new Double(2.0), series.getY(1))) {
            throw new RuntimeException("anchor wrong y[1]");
        }
        if (series.getItemCount() != 2) {
            throw new RuntimeException("anchor wrong item count");
        }
    }

    private static double normalizeNumber(int v) {
        if (v == Integer.MIN_VALUE) {
            return 0.0;
        }
        return (double) (v % 1024);
    }

    private static boolean numbersEqual(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        double da = a.doubleValue();
        double db = b.doubleValue();
        return Double.doubleToLongBits(da) == Double.doubleToLongBits(db);
    }
}
