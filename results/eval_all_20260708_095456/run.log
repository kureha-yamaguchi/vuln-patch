package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        TimeSeries series = buildGapSeries(data);
        if (series == null || series.getItemCount() < 2) {
            return;
        }

        Day first = (Day) series.getTimePeriod(0);
        Day second = (Day) series.getTimePeriod(1);

        int firstOrd = toOrdinal(first);
        int secondOrd = toOrdinal(second);
        if (secondOrd - firstOrd < 2) {
            return;
        }

        int startOrd = data.consumeInt(firstOrd + 1, secondOrd - 1);
        int endOrd = data.consumeInt(startOrd, secondOrd - 1);
        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            if (startIndex >= 0 || endIndex >= 0) {
                return;
            }

            TimeSeries gapCopy = series.createCopy(start, end);

            if (gapCopy.getItemCount() != 0) {
                throw new RuntimeException("oracle violation: copy of a gap-only range must be empty");
            }

            Day beforeFirst = dayFromOrdinal(firstOrd - 1);
            int beforeIndex = series.getIndex(beforeFirst);
            if (beforeIndex != -1) {
                TimeSeries clonePathCopy = series.createCopy(beforeFirst, beforeFirst);
                if (clonePathCopy.getItemCount() != 0) {
                    throw new RuntimeException("oracle violation: copy before first item must be empty");
                }
                int originalCount = series.getItemCount();
                clonePathCopy.add(beforeFirst, data.consumeInt());
                if (series.getItemCount() != originalCount) {
                    throw new RuntimeException("clone violation: modifying empty copy changed original");
                }
            }

            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);
            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);
            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
