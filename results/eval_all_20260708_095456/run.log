        String base = data.consumeString(64);
        String extra = data.consumeAsciiString(32);
        boolean addPrefixSpace = data.consumeBoolean();
        boolean addMiddleSpace = data.consumeBoolean();
        boolean addSuffixSpace = data.consumeBoolean();

        String str = base;
        if (addPrefixSpace) {
            str = " " + str;
        }
        if (addMiddleSpace) {
            str = str + " " + extra;
        } else {
            str = str + extra;
        }
        if (addSuffixSpace) {
            str = str + " ";
        }

        if (data.consumeBoolean()) {
            str = "0123456789";
        } else if (data.consumeBoolean()) {
            str = "012 3456789";
        }

        int len = str.length();
        int lower;
        int upper;

        if (data.consumeBoolean()) {
            lower = len + data.consumeInt(1, 32);
            upper = len + data.consumeInt(0, 32);
        } else {
            lower = data.consumeInt(0, len + 32);
            if (data.consumeBoolean()) {
                upper = -1;
            } else {
                upper = data.consumeInt(0, len + 32);
            }
        }

        String appendToEnd;
        if (data.consumeBoolean()) {
            appendToEnd = null;
        } else {
            appendToEnd = data.consumeAsciiString(16);
        }

        try {
            WordUtils.abbreviate(str, lower, upper, appendToEnd);
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            String left = WordUtils.abbreviate(str, lower, upper, null);
            String right = WordUtils.abbreviate(str, lower, upper, "");
            if (left == null ? right != null : !left.equals(right)) {
                throw new RuntimeException("metamorphic violation: null append and empty append must be equivalent");
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
