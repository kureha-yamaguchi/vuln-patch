package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        StringUtils.join((Object[]) null, ',');

        Object[] anchor = new Object[] { null };
        StringUtils.join(anchor, '/', 0, 1);

        int size = data.consumeInt(1, 16);
        Object[] array = new Object[size];

        int nullIndex = data.consumeInt(0, size - 1);
        for (int i = 0; i < size; i++) {
            if (i == nullIndex) {
                array[i] = null;
            } else {
                switch (data.consumeInt(0, 4)) {
                    case 0:
                        array[i] = data.consumeString(32);
                        break;
                    case 1:
                        array[i] = data.consumeAsciiString(32);
                        break;
                    case 2:
                        array[i] = Integer.valueOf(data.consumeInt());
                        break;
                    case 3:
                        array[i] = Boolean.valueOf(data.consumeBoolean());
                        break;
                    default:
                        array[i] = Long.valueOf((long) data.consumeInt());
                        break;
                }
            }
        }

        int startIndex;
        int endIndex;
        if (data.consumeBoolean()) {
            startIndex = nullIndex;
            endIndex = data.consumeBoolean() ? startIndex + 1 : data.consumeInt(startIndex + 1, size);
        } else {
            startIndex = data.consumeInt(-2, size + 2);
            endIndex = data.consumeInt(-2, size + 2);
        }

        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString = data.consumeBoolean() ? null : data.consumeString(8);

        try {
            StringUtils.join(array, sepChar, startIndex, endIndex);
        } catch (ArrayIndexOutOfBoundsException e) {
            return;
        } catch (IndexOutOfBoundsException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            StringUtils.join(array, sepString, startIndex, endIndex);
        } catch (ArrayIndexOutOfBoundsException e) {
            return;
        } catch (IndexOutOfBoundsException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            if (startIndex >= 0 && endIndex >= startIndex && endIndex <= array.length) {
                String left = StringUtils.join(array, sepChar, startIndex, endIndex);
                String right = StringUtils.join(array, String.valueOf(sepChar), startIndex, endIndex);
                if (left == null ? right != null : !left.equals(right)) {
                    throw new RuntimeException("metamorphic violation: char and single-character String separators must agree");
                }
            }
        } catch (ArrayIndexOutOfBoundsException e) {
            return;
        } catch (IndexOutOfBoundsException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
