            Number av = a.getValue(i);
            Number bv = b.getValue(i);
            if (av == null) {
                if (bv != null) {
                    throw new RuntimeException("metamorphic violation: " + label + " value");
                }
            } else if (!av.equals(bv)) {
                throw new RuntimeException("metamorphic violation: " + label + " value");
            }
        }
