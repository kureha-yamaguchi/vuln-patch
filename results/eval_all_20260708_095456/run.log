    private static void runExplore(FuzzedDataProvider data) {
        int vars = data.consumeInt(4, 10);
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective(vars), 0.0);

        int families = data.consumeInt(4, 10);
        for (int k = 0; k < families; k++) {
            ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

            double[] a = new double[vars];
            double[] b = new double[vars];
            double[] c = new double[vars];

            for (int i = 0; i < vars; i++) {
                a[i] = data.consumeInt(0, 12);
                b[i] = data.consumeInt(0, 12);
                c[i] = data.consumeInt(0, 12);
            }
            a[0] = 0.0;
            b[0] = 0.0;
            c[0] = 0.0;

            if (allZero(a)) {
                a[vars > 1 ? 1 : 0] = 1.0;
            }
            if (allZero(b)) {
                b[vars > 1 ? 1 : 0] = 1.0;
            }
            if (allZero(c)) {
                c[vars > 1 ? 1 : 0] = 1.0;
            }

            double rhsA = data.consumeInt(1, 30);
            double rhsB = data.consumeInt(1, 30);
            double rhsC = data.consumeInt(1, 30);

            constraints.add(new LinearConstraint(a.clone(), Relationship.GEQ, rhsA));
            constraints.add(new LinearConstraint(a.clone(), Relationship.GEQ, rhsA));
            constraints.add(new LinearConstraint(b.clone(), Relationship.GEQ, rhsB));
            constraints.add(new LinearConstraint(c.clone(), Relationship.GEQ, rhsC));

            double[] neg = new double[vars];
            neg[0] = data.consumeInt(1, 20);
            for (int i = 1; i < vars; i++) {
                neg[i] = data.consumeInt(-20, 0);
            }

            int relPick = data.consumeInt(0, 2);
            Relationship rel;
            if (relPick == 0) {
                rel = Relationship.LEQ;
            } else if (relPick == 1) {
                rel = Relationship.GEQ;
            } else {
                rel = Relationship.EQ;
            }
            constraints.add(new LinearConstraint(neg, rel, data.consumeInt(-40, 40)));

            int extraCount = data.consumeInt(0, 4);
            for (int e = 0; e < extraCount; e++) {
                double[] extra = new double[vars];
                boolean nonZero = false;
                for (int i = 0; i < vars; i++) {
                    extra[i] = data.consumeInt(-4, 8);
                    if (extra[i] != 0.0) {
                        nonZero = true;
                    }
                }
                if (!nonZero) {
                    extra[data.consumeInt(0, vars - 1)] = 1.0;
                }
                int rp = data.consumeInt(0, 2);
                Relationship er;
                if (rp == 0) {
                    er = Relationship.GEQ;
                } else if (rp == 1) {
                    er = Relationship.LEQ;
                } else {
                    er = Relationship.EQ;
                }
                constraints.add(new LinearConstraint(extra, er, data.consumeInt(-20, 30)));
            }

            optimizeOrIgnore(f, constraints, GoalType.MINIMIZE, true);
            metamorphicDuplicateConstraintCheck(f, constraints, GoalType.MINIMIZE, true);
        }
    }

    private static PointValuePair optimizeOrIgnore(LinearObjectiveFunction f,
                                                   ArrayList<LinearConstraint> constraints,
                                                   GoalType goal,
                                                   boolean nonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver(EPS, MAX_ITER);
            return solver.optimize(f, constraints, goal, nonNegative);
        } catch (NoFeasibleSolutionException e) {
            return null;
        } catch (UnboundedSolutionException e) {
            return null;
        } catch (MaxCountExceededException e) {
            throw e;
        }
    }

    private static void metamorphicDuplicateConstraintCheck(LinearObjectiveFunction f,
                                                            ArrayList<LinearConstraint> constraints,
                                                            GoalType goal,
                                                            boolean nonNegative) {
        PointValuePair p1 = optimizeOrIgnore(f, constraints, goal, nonNegative);
        if (p1 == null || constraints.isEmpty()) {
            return;
        }

        ArrayList<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(constraints);
        LinearConstraint first = constraints.get(0);
        duplicated.add(new LinearConstraint(first.getCoefficients(), first.getRelationship(), first.getValue()));

        PointValuePair p2 = optimizeOrIgnore(f, duplicated, goal, nonNegative);
        if (p2 == null) {
            return;
        }

        double v1 = p1.getValue();
        double v2 = p2.getValue();
        if (Double.isNaN(v1) || Double.isNaN(v2) || Double.isInfinite(v1) || Double.isInfinite(v2)) {
            return;
        }
        if (Math.abs(v1 - v2) > 1.0e-6) {
            throw new RuntimeException("metamorphic violation: duplicating an existing constraint changed the optimum value");
        }
    }

    private static double[] objective(int vars) {
        double[] o = new double[vars];
        o[0] = 1.0;
        return o;
    }

    private static boolean allZero(double[] x) {
        for (int i = 0; i < x.length; i++) {
            if (x[i] != 0.0) {
                return false;
            }
        }
        return true;
    }

    private static double[] negate(double[] in) {
        double[] out = new double[in.length];
        for (int i = 0; i < in.length; i++) {
            out[i] = -in[i];
        }
        return out;
    }
}
