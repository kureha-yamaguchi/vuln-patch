package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.GregorianCalendar;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        try {
            explore(data);
        } catch (IllegalArgumentException e) {
            if (isRootCauseMessage(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void anchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);
        try {
            s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void explore(FuzzedDataProvider data) throws CloneNotSupportedException {
        TimeSeries series = new TimeSeries(data.consumeString(20));

        int itemTarget = data.consumeInt(2, 12);
        for (int i = 0; i < itemTarget; i++) {
            Day d = consumeValidDay(data);
            Number value = new Integer(data.consumeInt());
            try {
                series.add(d, value);
            } catch (IllegalArgumentException e) {
                if (isRootCauseMessage(e)) {
                    throw e;
                }
            } catch (RuntimeException e) {
                // Duplicate periods or other documented input rejections are fine.
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int leftIndex = data.consumeInt(0, series.getItemCount() - 2);
        Day left = (Day) series.getTimePeriod(leftIndex);
        Day right = (Day) series.getTimePeriod(leftIndex + 1);

        long leftMs = left.getFirstMillisecond();
        long rightMs = right.getFirstMillisecond();
        long dayMs = 24L * 60L * 60L * 1000L;
        long gapDays = (rightMs - leftMs) / dayMs;

        if (gapDays < 3) {
            return;
        }

        int startOffset = data.consumeInt(1, (int) gapDays - 2);
        int endOffset = data.consumeInt(startOffset, (int) gapDays - 1);

        Day start = dayFromMillis(leftMs + startOffset * dayMs);
        Day end = dayFromMillis(leftMs + endOffset * dayMs);

        if (start.compareTo(end) > 0) {
            return;
        }

        TimeSeries copy = series.createCopy(start, end);
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("metamorphic violation: empty gap range should copy zero items");
        }

        int innerStartOffset = data.consumeInt(startOffset, endOffset);
        int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
        Day innerStart = dayFromMillis(leftMs + innerStartOffset * dayMs);
        Day innerEnd = dayFromMillis(leftMs + innerEndOffset * dayMs);

        TimeSeries copy2 = series.createCopy(innerStart, innerEnd);
        if (copy2.getItemCount() != 0 || copy.getItemCount() != copy2.getItemCount()) {
            throw new RuntimeException("metamorphic violation: subranges inside the same empty gap must agree");
        }
    }

    private static Day consumeValidDay(FuzzedDataProvider data) {
        int year = data.consumeInt(1900, 2100);
        int month = data.consumeInt(1, 12);
        int day = data.consumeInt(1, 28);
        return new Day(day, month, year);
    }

    private static Day dayFromMillis(long millis) {
        Calendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.setTimeInMillis(millis);
        return new Day(cal.getTime());
    }

    private static boolean isRootCauseMessage(IllegalArgumentException e) {
        String msg = e.getMessage();
        return msg != null && ("Requires start <= end.".equals(msg) || "Requires start on or before end.".equals(msg));
    }
}
