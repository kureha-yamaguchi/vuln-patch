package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression-test inputs. Buggy versions throw NPE here.
        {
            BisectionSolver solver = new BisectionSolver();
            try {
                solver.solve(f, 3.0, 3.2, 3.1);
            } catch (FunctionEvaluationException e) {
                return;
            } catch (MaxIterationsExceededException e) {
                return;
            } catch (IllegalArgumentException e) {
                return;
            }
        }

        // EXPLORE: generate many real inputs with the same root-cause property:
        // call the 4-argument public API with a real non-null function and an
        // initial guess inside [min, max]. Use sin over intervals bracketing k*pi.
        final int k = data.consumeInt(-1000, 1000);
        final int scale = data.consumeInt(1, 1_000_000);
        final double delta = Math.min(1.0, scale / 1_000_000.0);
        final double root = k * Math.PI;
        final double min = root - delta;
        final double max = root + delta;

        final int initialSelector = data.consumeInt(-1_000_000, 1_000_000);
        final double fraction = (initialSelector + 1_000_000.0) / 2_000_000.0;
        final double initial1 = min + (max - min) * fraction;

        final int initialSelector2 = data.consumeInt(-1_000_000, 1_000_000);
        final double fraction2 = (initialSelector2 + 1_000_000.0) / 2_000_000.0;
        final double initial2 = min + (max - min) * fraction2;

        Double r1;
        Double r2;
        try {
            BisectionSolver solver1 = new BisectionSolver();
            r1 = solver1.solve(f, min, max, initial1);

            BisectionSolver solver2 = new BisectionSolver();
            r2 = solver2.solve(f, min, max, initial2);

            double tol = Math.max(solver1.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy());
            if (Math.abs(r1.doubleValue() - r2.doubleValue()) > tol) {
                throw new RuntimeException("metamorphic violation: bisection 4-arg solve should be independent of initial guess");
            }
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
