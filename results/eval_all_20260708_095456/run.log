    private static TimeSeries buildGapSeries(FuzzedDataProvider data) {
        int count = data.consumeInt(2, 8);
        int maxOrdinal = 31 * 12 * 40 - 1;
        int[] values = new int[count];
        int filled = 0;

        while (filled < count) {
            int v = data.consumeInt(0, maxOrdinal);
            boolean dup = false;
            for (int i = 0; i < filled; i++) {
                if (values[i] == v) {
                    dup = true;
                    break;
                }
            }
            if (!dup) {
                values[filled++] = v;
            }
        }

        Arrays.sort(values);

        boolean hasLeadingGap = values[1] - values[0] >= 2;
        if (!hasLeadingGap) {
            int base = values[0];
            if (base >= maxOrdinal - 2) {
                base = maxOrdinal - 3;
            }
            values[0] = base;
            values[1] = base + 2;
            for (int i = 2; i < values.length; i++) {
                if (values[i] <= values[i - 1]) {
                    values[i] = Math.min(maxOrdinal, values[i - 1] + 1);
                }
            }
            for (int i = values.length - 2; i >= 0; i--) {
                if (values[i] >= values[i + 1]) {
                    values[i] = Math.max(0, values[i + 1] - 1);
                }
            }
            if (values[1] - values[0] < 2) {
                return null;
            }
        }

        TimeSeries series = new TimeSeries(data.consumeString(20));
        for (int i = 0; i < values.length; i++) {
            try {
                series.add(dayFromOrdinal(values[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return null;
            }
        }
        return series;
    }

    private static Day dayFromOrdinal(int ordinal) {
        int o = ordinal;
        int year = 2000 + (o / (31 * 12));
        o %= (31 * 12);
        int month = 1 + (o / 31);
        int day = 1 + (o % 31);
        return new Day(day, month, year);
    }

    private static int toOrdinal(Day day) {
        return (day.getYear() - 2000) * 31 * 12 + (day.getMonth() - 1) * 31 + (day.getDayOfMonth() - 1);
    }
