    private static void metamorphicDuplicateConstraint(LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        if (constraints.isEmpty()) {
            return;
        }

        PointValuePair a;
        PointValuePair b;
        try {
            a = solve(f, constraints);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (Throwable t) {
            if (isBenign(t)) {
                return;
            }
            sneakyThrow(t);
            return;
        }

        ArrayList<LinearConstraint> dup = new ArrayList<LinearConstraint>(constraints);
        dup.add(constraints.get(0));

        try {
            b = solve(f, dup);
        } catch (MaxCountExceededException e) {
            throw e;
        } catch (Throwable t) {
            if (isBenign(t)) {
                return;
            }
            sneakyThrow(t);
            return;
        }

        if (a == null || b == null) {
            return;
        }

        double va = a.getValue();
        double vb = b.getValue();
        if (Double.isNaN(va) || Double.isNaN(vb) || Double.isInfinite(va) || Double.isInfinite(vb)) {
            return;
        }
        double diff = Math.abs(va - vb);
        double scale = Math.max(1.0, Math.max(Math.abs(va), Math.abs(vb)));
        if (diff > 1e-7 * scale) {
            throw new RuntimeException("metamorphic violation: duplicate constraint changed optimum value");
        }
    }

