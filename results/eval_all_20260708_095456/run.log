package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException e) {
            }
        }

        String raw = data.consumeAsciiString(32);
        String digits = digitsOnly(raw, false, true);
        String signedDigits = digitsOnly(raw, true, true);

        String longCandidate = signedDigits + (data.consumeBoolean() ? "L" : "l");
        String hugeLongCandidate = digits + digits + digits + (data.consumeBoolean() ? "L" : "l");
        String floatCandidate = signedDigits + "." + digits + (data.consumeBoolean() ? "F" : "f");
        String doubleCandidate = signedDigits + "." + digits + "E" + digitsOnly(data.consumeAsciiString(8), true, true)
                + (data.consumeBoolean() ? "D" : "d");

        String maybeSingleSuffix;
        switch (data.consumeInt(0, 5)) {
            case 0:
                maybeSingleSuffix = "l";
                break;
            case 1:
                maybeSingleSuffix = "L";
                break;
            case 2:
                maybeSingleSuffix = "f";
                break;
            case 3:
                maybeSingleSuffix = "F";
                break;
            case 4:
                maybeSingleSuffix = "d";
                break;
            default:
                maybeSingleSuffix = "D";
                break;
        }

        String[] candidates = new String[] {
                raw,
                maybeSingleSuffix,
                longCandidate,
                hugeLongCandidate,
                floatCandidate,
                doubleCandidate,
                signedDigits,
                "0x" + hexOnly(data.consumeAsciiString(16), true),
                "-" + digits + "L",
                digits + "L",
                digits + "l"
        };

        for (int i = 0; i < candidates.length; i++) {
            try {
                NumberUtils.createNumber(candidates[i]);
            } catch (NumberFormatException e) {
            } catch (NullPointerException e) {
            }
        }

        String base = data.consumeBoolean() ? signedDigits : digits;
        if (isSignedDecimalDigits(base)) {
            try {
                Number lower = NumberUtils.createNumber(base + "l");
                Number upper = NumberUtils.createNumber(base + "L");
                if (!sameNumber(lower, upper)) {
                    throw new RuntimeException("metamorphic violation: createNumber(x+'l') != createNumber(x+'L')");
                }
            } catch (NumberFormatException e) {
            } catch (NullPointerException e) {
            }
        }
    }

    private static String digitsOnly(String s, boolean allowLeadingMinus, boolean ensureNonEmpty) {
        StringBuffer out = new StringBuffer();
        if (s != null) {
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if (allowLeadingMinus && out.length() == 0 && c == '-') {
                    out.append(c);
                } else if (c >= '0' && c <= '9') {
                    out.append(c);
                }
            }
        }
        if (out.length() == 0 || (out.length() == 1 && out.charAt(0) == '-')) {
            return ensureNonEmpty ? "1" : "";
        }
        return out.toString();
    }

    private static String hexOnly(String s, boolean ensureNonEmpty) {
        StringBuffer out = new StringBuffer();
        if (s != null) {
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if ((c >= '0' && c <= '9')
                        || (c >= 'a' && c <= 'f')
                        || (c >= 'A' && c <= 'F')) {
                    out.append(c);
                }
            }
        }
        if (out.length() == 0 && ensureNonEmpty) {
            return "1";
        }
        return out.toString();
    }

    private static boolean isSignedDecimalDigits(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = 0;
        if (s.charAt(0) == '-') {
            if (s.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        return a.getClass().equals(b.getClass()) && a.toString().equals(b.toString());
    }
}
