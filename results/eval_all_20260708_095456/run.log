package org.apache.commons.math.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ConcurrentModificationException;
import org.apache.commons.math.linear.OpenMapRealVector;
import org.apache.commons.math.linear.RealVector;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            RealVector u = new OpenMapRealVector(3, 1e-6);
            u.setEntry(0, 1);
            u.setEntry(1, 0);
            u.setEntry(2, 2);

            RealVector v1 = new OpenMapRealVector(3, 1e-6);
            double[] v2 = new double[3];
            v1.setEntry(0, 0);
            v2[0] = 0;
            v1.setEntry(1, 3);
            v2[1] = 3;
            v1.setEntry(2, 0);
            v2[2] = 0;

            RealVector w;
            w = u.ebeMultiply(v1);
            w = u.ebeMultiply(v2);
            w = u.ebeDivide(v1);
            w = u.ebeDivide(v2);
        } catch (Throwable t) {
            Throwable c = t;
            while (c != null) {
                if (c instanceof ConcurrentModificationException || c.getClass().getName().indexOf("ConcurrentModification") >= 0) {
                    throwUnchecked(t);
                }
                c = c.getCause();
            }
            if (t instanceof IllegalArgumentException) {
                return;
            }
            throwUnchecked(t);
        }

        try {
            int dimension = data.consumeInt(1, 32);
            OpenMapRealVector u = new OpenMapRealVector(dimension, 1e-6);
            OpenMapRealVector vVec = new OpenMapRealVector(dimension, 1e-6);
            double[] vArr = new double[dimension];

            for (int i = 0; i < dimension; i++) {
                int rawU = data.consumeInt(-3, 3);
                int rawV = data.consumeInt(-3, 3);

                double uVal = data.consumeBoolean() ? 0.0 : (double) rawU;
                double vVal = data.consumeBoolean() ? 0.0 : (double) rawV;

                u.setEntry(i, uVal);
                vVec.setEntry(i, vVal);
                vArr[i] = vVal;
            }

            int triggerIndex = data.consumeInt(0, dimension - 1);
            u.setEntry(triggerIndex, data.consumeBoolean() ? 1.0 : -1.0);
            vVec.setEntry(triggerIndex, 0.0);
            vArr[triggerIndex] = 0.0;

            if (dimension > 1) {
                int secondIndex = (triggerIndex + 1) % dimension;
                u.setEntry(secondIndex, 0.0);
                double nz = data.consumeBoolean() ? 2.0 : -2.0;
                vVec.setEntry(secondIndex, nz);
                vArr[secondIndex] = nz;
            }

            RealVector mulVec = u.ebeMultiply(vVec);
            RealVector mulArr = u.ebeMultiply(vArr);
            RealVector divVec = u.ebeDivide(vVec);
            RealVector divArr = u.ebeDivide(vArr);

            for (int i = 0; i < dimension; i++) {
                long a = Double.doubleToLongBits(mulVec.getEntry(i));
                long b = Double.doubleToLongBits(mulArr.getEntry(i));
                if (a != b) {
                    throw new RuntimeException("metamorphic violation: ebeMultiply(vector) != ebeMultiply(array)");
                }
            }

            if (divVec.getDimension() != divArr.getDimension()) {
                throw new RuntimeException("metamorphic violation: dimension mismatch");
            }
        } catch (Throwable t) {
            Throwable c = t;
            while (c != null) {
                if (c instanceof ConcurrentModificationException || c.getClass().getName().indexOf("ConcurrentModification") >= 0) {
                    throwUnchecked(t);
                }
                c = c.getCause();
            }
            if (t instanceof IllegalArgumentException) {
                return;
            }
            throwUnchecked(t);
        }
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
