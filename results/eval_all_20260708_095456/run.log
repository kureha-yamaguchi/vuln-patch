import java.awt.Color;
import java.awt.Paint;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        GrayPaintScale anchor = new GrayPaintScale();
        Color c = (Color) anchor.getPaint(0.0);
        if (!Color.black.equals(c)) {
            throw new RuntimeException("anchor violation: 0.0 should map to black");
        }
        c = (Color) anchor.getPaint(1.0);
        if (!Color.white.equals(c)) {
            throw new RuntimeException("anchor violation: 1.0 should map to white");
        }
        c = (Color) anchor.getPaint(-0.5);
        if (!Color.black.equals(c)) {
            throw new RuntimeException("anchor violation: -0.5 should clamp to black");
        }
        c = (Color) anchor.getPaint(1.5);
        if (!Color.white.equals(c)) {
            throw new RuntimeException("anchor violation: 1.5 should clamp to white");
        }

        int iterations = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < iterations; i++) {
            int base = data.consumeInt(-10000, 10000);
            int span = data.consumeInt(1, 10000);
            double lower = base / 16.0;
            double upper = lower + (span / 16.0);

            GrayPaintScale gps;
            try {
                gps = new GrayPaintScale(lower, upper);
            } catch (IllegalArgumentException e) {
                return;
            }

            gps.getPaint(lower);
            gps.getPaint(upper);

            boolean below = data.consumeBoolean();
            int offsetRaw = data.consumeInt(1, 10000);
            double offset = offsetRaw / 16.0;
            double probe = below ? (lower - offset) : (upper + offset);

            Paint out = gps.getPaint(probe);

            Paint boundary = below ? gps.getPaint(lower) : gps.getPaint(upper);
            if (!boundary.equals(out)) {
                throw new RuntimeException("metamorphic violation: clamped out-of-range input must match boundary color");
            }
        }
    }
}
