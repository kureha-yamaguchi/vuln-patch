package org.apache.commons.math3.util;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.distribution.BinomialDistribution;
import org.apache.commons.math3.distribution.FDistribution;
import org.apache.commons.math3.exception.ConvergenceException;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exactBinomialTrigger();
        exactFTrigger();

        if (data.consumeBoolean()) {
            exploreBinomial(data);
        } else {
            exploreFDistribution(data);
        }

        metamorphicFQuantileSymmetry(data);
    }

    private static void exactBinomialTrigger() {
        BinomialDistribution dist = new BinomialDistribution(500000, 0.5);
        int p = dist.inverseCumulativeProbability(0.5);
        if (p != 250000) {
            throw new RuntimeException("metamorphic violation: fair binomial median");
        }
    }

    private static void exactFTrigger() {
        FDistribution f = new FDistribution(200000, 200000);
        double result = f.inverseCumulativeProbability(0.01);
        if (!(result < 1.0)) {
            throw new RuntimeException("metamorphic violation: equal-df F quantile below 1 for p<0.5");
        }
    }

    private static void exploreBinomial(FuzzedDataProvider data) {
        int trials = data.consumeInt(500000, 20000000);
        if ((trials & 1) != 0) {
            trials++;
            if (trials <= 0) {
                trials = 500000;
            }
        }

        BinomialDistribution dist = new BinomialDistribution(trials, 0.5);
        int median = dist.inverseCumulativeProbability(0.5);

        if (median != trials / 2) {
            throw new RuntimeException("metamorphic violation: fair binomial median");
        }

        int k = (trials / 2) + data.consumeInt(-8, 8);
        if (k < 0) {
            k = 0;
        } else if (k > trials) {
            k = trials;
        }

        double c1 = dist.cumulativeProbability(k);
        double c2 = dist.cumulativeProbability(trials - k - 1);
        if (Double.isFinite(c1) && Double.isFinite(c2)) {
            double sum = c1 + c2;
            if (Math.abs(sum - 1.0) > 1e-9) {
                throw new RuntimeException("metamorphic violation: fair binomial symmetry");
            }
        }
    }

    private static void exploreFDistribution(FuzzedDataProvider data) {
        int base = data.consumeInt(100000, 2000000);
        int delta = data.consumeInt(-32, 32);
        int d1 = base;
        int d2 = base + delta;
        if (d2 <= 0) {
            d2 = base;
        }

        int pMicros = data.consumeInt(1, 499999);
        double p = pMicros / 1000000.0;

        try {
            FDistribution f = new FDistribution(d1, d2);
            double q = f.inverseCumulativeProbability(p);
            if (Double.isNaN(q)) {
                throw new RuntimeException("metamorphic violation: NaN quantile");
            }
        } catch (ConvergenceException e) {
            throw e;
        }
    }

    private static void metamorphicFQuantileSymmetry(FuzzedDataProvider data) {
        int df = data.consumeInt(100000, 2000000);
        int pMicros = data.consumeInt(1, 499999);
        double p = pMicros / 1000000.0;

        FDistribution f = new FDistribution(df, df);
        double q1 = f.inverseCumulativeProbability(p);
        double q2 = f.inverseCumulativeProbability(1.0 - p);

        if (Double.isFinite(q1) && Double.isFinite(q2) && q1 > 0.0 && q2 > 0.0) {
            double prod = q1 * q2;
            double err = Math.abs(prod - 1.0);
            if (err > 1e-4) {
                throw new RuntimeException("metamorphic violation: equal-df F quantile reciprocity");
            }
        } else if (Double.isNaN(q1) || Double.isNaN(q2)) {
            throw new RuntimeException("metamorphic violation: NaN equal-df F quantile");
        }
    }
}
