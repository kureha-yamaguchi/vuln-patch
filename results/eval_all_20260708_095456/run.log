package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact failing test input.
        try {
            UnivariateRealSolver solver = new BisectionSolver();
            solver.solve(f, 3.0, 3.2, 3.1);
        } catch (NullPointerException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        }

        // EXPLORE: same root-cause property with varied valid intervals and initial guesses.
        int multiple = data.consumeInt(-128, 128);
        double root = multiple * Math.PI;

        double leftWidth = data.consumeInt(1, 1000) / 1000.0;
        double rightWidth = data.consumeInt(1, 1000) / 1000.0;
        double min = root - leftWidth;
        double max = root + rightWidth;

        double initial1;
        if (data.consumeBoolean()) {
            initial1 = root;
        } else {
            double fraction = data.consumeInt(0, 1000) / 1000.0;
            initial1 = min + (max - min) * fraction;
        }

        try {
            UnivariateRealSolver solver = new BisectionSolver();
            solver.solve(f, min, max, initial1);
        } catch (NullPointerException e) {
            throw e;
        } catch (IllegalArgumentException e) {
            return;
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        }

        // METAMORPHIC CHECK: for bisection, different initial guesses on the same
        // function and bracket must produce the same root.
        double initial2 = (min + max) / 2.0;
