package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction anchorFunction = new SinFunction();

        try {
            new BisectionSolver().solve(anchorFunction, 3.0, 3.2, 3.1);
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-100000, 100000);
        double root = k * Math.PI;

        double left = 1.0e-12 + (data.consumeInt(1, 1000000) / 1000000.0) * 1.0;
        double right = 1.0e-12 + (data.consumeInt(1, 1000000) / 1000000.0) * 1.0;

        double min = root - left;
        double max = root + right;

        int initSelector = data.consumeInt(0, 1000000);
        double initial = min + (max - min) * (initSelector / 1000000.0);

        try {
            new BisectionSolver().solve(f, min, max, initial);
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            BisectionSolver solverWithInitial = new BisectionSolver();
            BisectionSolver solverWithoutInitial = new BisectionSolver();

            double r1 = solverWithInitial.solve(f, min, max, initial);
            double r2 = solverWithoutInitial.solve(f, min, max);

            double tol = Math.max(solverWithInitial.getAbsoluteAccuracy(), solverWithoutInitial.getAbsoluteAccuracy());
            if (Math.abs(r1 - r2) > tol) {
                throw new RuntimeException("metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)");
            }
        } catch (FunctionEvaluationException e) {
            return;
        } catch (MaxIterationsExceededException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }
}
