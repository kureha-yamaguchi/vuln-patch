<xref>
public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        requireUppercaseHexAcceptance("0Xfade");

        try {
            NumberUtils.createNumber("12345");
            NumberUtils.createNumber("1234.5D");
            NumberUtils.createNumber("1234.5d");
            NumberUtils.createNumber("1234.5F");
            NumberUtils.createNumber("1234.5f");
            NumberUtils.createNumber("12345L");
            NumberUtils.createNumber("12345l");
            NumberUtils.createNumber("-1234.5");
            NumberUtils.createNumber("-12345");
            NumberUtils.createNumber("0xFADE");
            NumberUtils.createNumber("-0xFADE");
            NumberUtils.createNumber("-0Xfade");
            NumberUtils.createNumber("1.1E200");
            NumberUtils.createNumber("1.1E20");
            NumberUtils.createNumber("-1.1E200");
            NumberUtils.createNumber("1.1E-200");
            NumberUtils.createNumber("12345678901234567890L");
            NumberUtils.createNumber("1.1E-700F");
            NumberUtils.createNumber("2.");
        } catch (NumberFormatException ignored) {
        }

        String arbitrary = data.consumeString(64);
        try {
            NumberUtils.createNumber(arbitrary);
        } catch (NumberFormatException ignored) {
        }

        String candidate = buildUppercaseHexCandidate(data);
        requireUppercaseHexAcceptance(candidate);

        String lowerEquivalent = candidate.startsWith("-0X")
                ? "-0x" + candidate.substring(3)
                : "0x" + candidate.substring(2);

        try {
            Number upper = NumberUtils.createNumber(candidate);
            Number lower = NumberUtils.createNumber(lowerEquivalent);
            if (upper == null || lower == null || !upper.equals(lower)) {
                throw new RuntimeException("metamorphic violation: 0X and 0x forms must be equivalent");
            }
        } catch (NumberFormatException e) {
            try {
                NumberUtils.createInteger(candidate);
                throw new RuntimeException("metamorphic violation: valid uppercase hex rejected", e);
            } catch (NumberFormatException ignored) {
            }
        }

        String remainder = data.consumeRemainingAsString();
        try {
            NumberUtils.createNumber(remainder);
        } catch (NumberFormatException ignored) {
        }
    }
