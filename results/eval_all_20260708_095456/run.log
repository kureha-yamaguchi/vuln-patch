            StringUtils.replaceEach("aba", new String[0], null);
            StringUtils.replaceEach("aba", null, new String[0]);
            StringUtils.replaceEach("aba", new String[]{"a"}, null);
            StringUtils.replaceEach("aba", new String[]{null}, new String[]{"a"});
            StringUtils.replaceEach("aba", new String[]{"a", "b"}, new String[]{"c", null});
        } catch (IllegalArgumentException e) {
            return;
        }

        // EXPLORE: generate many real inputs with the same root-cause property:
        // equal-length arrays, at least one match in text, and at least one null replacement element.
        int n = data.consumeInt(1, 4);
        String[] searchList = new String[n];
        String[] replacementList = new String[n];

        int matchedIndex = data.consumeInt(0, n - 1);
        int nullReplacementIndex = data.consumeInt(0, n - 1);

        String token = data.consumeAsciiString(4);
        if (token.length() == 0) {
            token = "A";
        }

        String prefix = data.consumeString(8);
        String suffix = data.consumeRemainingAsString();
        String text = prefix + token + suffix;

        for (int i = 0; i < n; i++) {
            if (i == matchedIndex) {
                searchList[i] = token;
            } else {
                int kind = data.consumeInt(0, 3);
                if (kind == 0) {
                    searchList[i] = null;
                } else if (kind == 1) {
                    searchList[i] = "";
                } else {
                    String s = data.consumeAsciiString(4);
                    if (s.length() == 0 || s.equals(token)) {
                        s = "Z" + i;
                    }
                    searchList[i] = s;
                }
            }

            if (i == nullReplacementIndex) {
                replacementList[i] = null;
            } else {
                replacementList[i] = data.consumeString(6);
            }
        }

        // Touch the related real library helper explicitly as well.
        StringUtils.length(text);
        StringUtils.length(token);

        try {
            StringUtils.replaceEach(text, searchList, replacementList);
        } catch (IllegalArgumentException e) {
            return;
        }

        // METAMORPHIC CHECK:
        // Replacing a non-empty token with itself must be equivalent to doing no replacements at all.
        String idToken = data.consumeAsciiString(4);
        if (idToken.length() == 0) {
            idToken = "Q";
        }
        String idText = data.consumeString(12) + idToken + data.consumeString(12);

        String lhs;
        String rhs;
        try {
            lhs = StringUtils.replaceEach(idText, new String[]{idToken}, new String[]{idToken});
            rhs = StringUtils.replaceEach(idText, new String[0], new String[0]);
        } catch (IllegalArgumentException e) {
            return;
        }
        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException("metamorphic violation: identity replacement must equal no replacement");
        }
    }
