public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            runAnchorInputs(g2);
            exploreInputs(data, g2);
            runMetamorphicCheck(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void runAnchorInputs(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());

        container.add(new EmptyBlock(5.0, 6.0));
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(15.0, 16.0));
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
        arrangeOrSwallow(container, g2, constraint);

        container.clear();
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.LEFT);
        container.add(new EmptyBlock(1.0, 2.0), RectangleEdge.RIGHT);
        arrangeOrSwallow(container, g2, constraint);
        container.getBlocks();
    }

    private static void exploreInputs(FuzzedDataProvider data, Graphics2D g2) {
        double fixedWidth = scaled(data.consumeInt(1, 3000), 100.0);
        double leftWidth = fixedWidth + scaled(data.consumeInt(1, 3000), 100.0);
        double leftHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double rightWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double rightHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double centerWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double centerHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double topWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double topHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double bottomWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double bottomHeight = scaled(data.consumeInt(0, 5000), 100.0);

        RectangleConstraint constraint = new RectangleConstraint(
                fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(topWidth, topHeight), RectangleEdge.TOP);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(bottomWidth, bottomHeight), RectangleEdge.BOTTOM);
        }

        container.add(new EmptyBlock(leftWidth, leftHeight), RectangleEdge.LEFT);
        container.add(new EmptyBlock(rightWidth, rightHeight), RectangleEdge.RIGHT);

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(centerWidth, centerHeight));
        }

        List blocks = container.getBlocks();
        if (blocks != null && !blocks.isEmpty()) {
            Object first = blocks.get(0);
            if (first instanceof EmptyBlock) {
                ((EmptyBlock) first).getWidth();
            }
        }

        arrangeOrSwallow(container, g2, constraint);
    }

    private static void runMetamorphicCheck(FuzzedDataProvider data, Graphics2D g2) {
        double fixedWidth = scaled(data.consumeInt(1, 3000), 100.0);
        double leftWidth = fixedWidth + scaled(data.consumeInt(1, 3000), 100.0);
        double leftHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double rightWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double rightHeight = scaled(data.consumeInt(0, 5000), 100.0);
        double centerWidth = scaled(data.consumeInt(0, 5000), 100.0);
        double centerHeight = scaled(data.consumeInt(0, 5000), 100.0);

        RectangleConstraint constraint = new RectangleConstraint(
                fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer c1 = new BlockContainer(new BorderArrangement());
        c1.add(new EmptyBlock(leftWidth, leftHeight), RectangleEdge.LEFT);
        c1.add(new EmptyBlock(rightWidth, rightHeight), RectangleEdge.RIGHT);
        if (data.consumeBoolean()) {
            c1.add(new EmptyBlock(centerWidth, centerHeight));
        }

        BlockContainer c2 = new BlockContainer(new BorderArrangement());
        c2.add(new EmptyBlock(leftWidth, leftHeight), RectangleEdge.LEFT);
        c2.add(new EmptyBlock(rightWidth, rightHeight), RectangleEdge.RIGHT);
        if (c1.getBlocks().size() == 3) {
            c2.add(new EmptyBlock(centerWidth, centerHeight));
        }

        Size2D s1 = tryArrange(c1, g2, constraint);
        Size2D s2 = tryArrange(c2, g2, constraint);
        if (s1 != null && s2 != null) {
            if (Double.compare(s1.getWidth(), s2.getWidth()) != 0
                    || Double.compare(s1.getHeight(), s2.getHeight()) != 0) {
                throw new RuntimeException("metamorphic violation: equivalent containers must arrange to identical size");
            }
        }
    }

    private static void arrangeOrSwallow(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        Size2D ignored = tryArrange(container, g2, constraint);
    }

    private static Size2D tryArrange(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return null;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof ArrayIndexOutOfBoundsException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException) {
            return true;
        }
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            StackTraceElement[] stack = cur.getStackTrace();
            if (stack != null) {
                for (int i = 0; i < stack.length; i++) {
                    String cls = stack[i].getClassName();
                    String method = stack[i].getMethodName();
                    if ("org.jfree.data.Range".equals(cls) && "<init>".equals(method)) {
                        return true;
                    }
                    if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                            && ("arrangeFF".equals(method) || "arrangeFN".equals(method))) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private static double scaled(int value, double divisor) {
        return ((double) value) / divisor;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
