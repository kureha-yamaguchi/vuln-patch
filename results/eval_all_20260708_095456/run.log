            case 4:
                return data.consumeBoolean() ? 1.0e-6 : -1.0e-6;
            default:
                return data.consumeBoolean() ? 0.0 : -0.0;
        }
    }

    private static boolean sameVertices(Vector2D[][] a, Vector2D[][] b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            Vector2D[] aa = a[i];
