        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);
            String out1 = emf.format(new Object[] { "DUMMY" });
            String canonical = emf.toPattern();
            ExtendedMessageFormat emf2 = new ExtendedMessageFormat(canonical, registry);
            String out2 = emf2.format(new Object[] { "DUMMY" });
            if (!out1.equals(out2) || !canonical.equals(emf2.toPattern())) {
                throw new RuntimeException("metamorphic violation: toPattern/format round-trip");
