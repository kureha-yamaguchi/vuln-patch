        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException e) {
                // Expected clean rejection on fixed versions.
            }
        }

        int mode = data.consumeInt(0, 5);
        String candidate;
        switch (mode) {
            case 0:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                candidate = data.consumeAsciiString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 2:
                candidate = data.consumeString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 3:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 4:
                candidate = data.consumeRemainingAsString();
                if (candidate.length() > 1) {
                    candidate = candidate.substring(0, 1);
                }
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            default:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException e) {
            // Expected for invalid inputs.
        }

        String prefix = data.consumeAsciiString(32);
        if (data.consumeBoolean()) {
            prefix = "-" + prefix;
        }
        if (prefix.length() == 0 || "-".equals(prefix)) {
            prefix = String.valueOf(data.consumeInt());
        }

        try {
            Number left = NumberUtils.createNumber(prefix + "l");
            Number right = NumberUtils.createNumber(prefix + "L");
            if (left != null && right != null) {
                if (!left.getClass().equals(right.getClass()) || !left.toString().equals(right.toString())) {
                    throw new RuntimeException("metamorphic violation: createNumber(s+'l') != createNumber(s+'L')");
