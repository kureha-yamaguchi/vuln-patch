package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.MathRuntimeException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        // Exercise constructor validation/buildMessage/createIllegalArgumentException via real code.
        try {
            double badMean = toFiniteDouble(data.consumeInt());
            double badSd = data.consumeBoolean() ? 0.0 : -Math.abs(toFiniteDouble(data.consumeInt()));
            new NormalDistributionImpl(badMean, badSd);
        } catch (IllegalArgumentException e) {
            // Expected clean rejection for invalid standard deviation.
        }

        double mean = toFiniteDouble(data.consumeInt());
        double sd = Math.max(1.0e-12, Math.abs(toFiniteDouble(data.consumeInt())));

        final NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sd);
        } catch (IllegalArgumentException e) {
            return;
        }

        // EXPLORE strategy:
        // The bug triggers when inverseCumulativeProbability is asked to invert a probability
        // that is exactly the CDF at a point lying on a bracket endpoint, yielding f(a)==0 or f(b)==0.
        // Construct many such probabilities using the real CDF, then invert them via the public API.
        int mode = data.consumeInt(0, 4);
        double x;
        switch (mode) {
            case 0:
                x = 2.0;
                break;
            case 1:
                x = data.consumeInt(-8, 8);
                break;
            case 2:
                x = data.consumeInt(-8, 8) + 0.5;
                break;
            case 3:
                x = mean + sd * data.consumeInt(-8, 8);
                break;
            default:
                x = toFiniteDouble(data.consumeInt());
                break;
        }

        try {
            double p = normal.cumulativeProbability(x);
            double inv = normal.inverseCumulativeProbability(p);

            // Metamorphic oracle-from-input: inv(CDF(x)) == x for real-valued x generated above.
            if (Double.isFinite(x) && Double.isFinite(inv)) {
                double tol = Math.max(1.0e-9, Math.abs(x) * 1.0e-9);
                if (Math.abs(inv - x) > tol) {
                    throw new RuntimeException("metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x)) != x");
                }
            }
        } catch (MathException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(e);
            }
            return;
        } catch (IllegalArgumentException e) {
            return;
        }

        // Also probe direct probabilities, including invalid ones, but swallow documented rejections.
        double p2;
        switch (data.consumeInt(0, 5)) {
            case 0:
                p2 = 0.0;
                break;
            case 1:
                p2 = 1.0;
                break;
            case 2:
                p2 = 0.5;
                break;
            case 3:
                try {
                    p2 = normal.cumulativeProbability(data.consumeInt(-16, 16));
                } catch (MathException e) {
                    if (isRootCause(e)) {
                        throw new RuntimeException(e);
                    }
                    return;
                }
                break;
            case 4:
                p2 = -Math.abs(toUnitDouble(data.consumeInt()));
                break;
            default:
                p2 = 1.0 + Math.abs(toUnitDouble(data.consumeInt()));
                break;
        }

        try {
            normal.inverseCumulativeProbability(p2);
        } catch (MathException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(e);
            }
        } catch (IllegalArgumentException e) {
            // Expected clean rejection.
        }
    }

    private static void runAnchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);
            normal.inverseCumulativeProbability(0.9772498680518209);
        } catch (MathException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(e);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        while (t != null) {
            String cls = t.getClass().getName();
            String msg = t.getMessage();
            if ((cls.contains("MathException") || cls.contains("ConvergenceException"))
                    && msg != null
                    && msg.contains("ConvergenceException")
                    && msg.contains("number of iterations=")) {
                return true;
            }
            t = t.getCause();
        }
        return false;
    }

    private static double toFiniteDouble(int v) {
        return v / 1024.0;
    }

    private static double toUnitDouble(int v) {
        long lv = v & 0xffffffffL;
        return lv / (double) 0xffffffffL;
    }
}
