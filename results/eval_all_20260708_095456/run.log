import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int mode = data.consumeInt(0, 3);
        try {
            switch (mode) {
                case 0:
                    runBoundaryAttributeLeafCase(data, false);
                    break;
                case 1:
                    runBoundaryAttributeLeafCase(data, true);
                    break;
                case 2:
                    runBooleanLeafCase(data.consumeBoolean());
                    break;
                default:
                    runProjectedTrianglePolyhedronCase(data);
                    break;
            }
        } catch (ClassCastException e) {
            throw e;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static void runAnchor() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f, 1.000000f,
            -1.000000f, -1.000000f, 1.000000f,
            -1.000000f, -1.000000f, -1.000000f,
            1.000000f, 1.000000f, -1.000000f,
            0.999999f, 1.000000f, 1.000000f,
            -1.000000f, 1.000000f, 1.000000f,
            -1.000000f, 1.000000f, -1.000000f
        };
        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int i = 0; i < indices.length; i += 3) {
            Vector3D v1 = vertex(coords, indices[i]);
            Vector3D v2 = vertex(coords, indices[i + 1]);
            Vector3D v3 = vertex(coords, indices[i + 2]);
            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);
            PolygonsSet facetRegion = new PolygonsSet(1.0e-10, p1, p2, p3);
            facets.add(new SubPlane(plane, facetRegion));
        }

        PolyhedronsSet polyhedron = new PolyhedronsSet(facets);
        polyhedron.getSize();
        polyhedron.getBarycenter();
    }

    private static Vector3D vertex(float[] coords, int index) {
        int base = index * 3;
        return new Vector3D(coords[base], coords[base + 1], coords[base + 2]);
    }

    private static void runBoundaryAttributeLeafCase(FuzzedDataProvider data, boolean withRealBoundary) {
        BoundaryAttribute<Euclidean2D> attribute;
        if (withRealBoundary) {
            Vector2D a = new Vector2D(consumeFiniteDouble(data), consumeFiniteDouble(data));
            Vector2D b = new Vector2D(consumeFiniteDouble(data), consumeFiniteDouble(data));
            if (samePoint(a, b)) {
                b = new Vector2D(a.getX() + 1.0, a.getY());
            }
            Line line = new Line(a, b);
            @SuppressWarnings("unchecked")
            SubHyperplane<Euclidean2D> whole = line.wholeHyperplane();
            attribute = new BoundaryAttribute<Euclidean2D>(
                data.consumeBoolean() ? whole : null,
                data.consumeBoolean() ? whole : null,
                null
            );
        } else {
            attribute = new BoundaryAttribute<Euclidean2D>(null, null, null);
        }

        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(attribute);
        PolygonsSet set = new PolygonsSet(tree);

        set.getVertices();
        set.getSize();
        set.getBarycenter();

        checkVerticesIdempotence(set);
    }

    private static void runBooleanLeafCase(boolean inside) {
        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
        PolygonsSet set = new PolygonsSet(tree);

        set.getVertices();
        set.getSize();
        set.getBarycenter();

        checkVerticesIdempotence(set);
    }

    private static void runProjectedTrianglePolyhedronCase(FuzzedDataProvider data) {
        Vector3D v1 = new Vector3D(consumeFiniteDouble(data), consumeFiniteDouble(data), consumeFiniteDouble(data));
        Vector3D v2 = new Vector3D(consumeFiniteDouble(data), consumeFiniteDouble(data), consumeFiniteDouble(data));
        Vector3D v3 = new Vector3D(consumeFiniteDouble(data), consumeFiniteDouble(data), consumeFiniteDouble(data));

        if (v1.distance(v2) == 0.0 || v2.distance(v3) == 0.0 || v1.distance(v3) == 0.0) {
            return;
        }

        Plane plane = new Plane(v1, v2, v3);
        Vector2D p1 = plane.toSubSpace(v1);
        Vector2D p2 = plane.toSubSpace(v2);
        Vector2D p3 = plane.toSubSpace(v3);
        PolygonsSet facetRegion = new PolygonsSet(1.0e-10, p1, p2, p3);

        facetRegion.getVertices();
        facetRegion.getSize();
        facetRegion.getBarycenter();
        checkVerticesIdempotence(facetRegion);

        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        facets.add(new SubPlane(plane, facetRegion));
        PolyhedronsSet polyhedron = new PolyhedronsSet(facets);
        polyhedron.getSize();
        polyhedron.getBarycenter();
    }

    private static void checkVerticesIdempotence(PolygonsSet set) {
        Vector2D[][] first = set.getVertices();
        Vector2D[][] second = set.getVertices();
        if (!sameVertices(first, second)) {
            throw new RuntimeException("metamorphic violation: getVertices idempotence");
        }
    }

    private static boolean sameVertices(Vector2D[][] a, Vector2D[][] b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            Vector2D[] ai = a[i];
            Vector2D[] bi = b[i];
            if (ai == null || bi == null) {
                if (ai != bi) {
