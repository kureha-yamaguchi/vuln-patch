    private static void runCase(Object attribute) {
        if (attribute instanceof Boolean) {
            return;
        }

        try {
            BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(attribute);
            PolygonsSet set = new PolygonsSet(tree);

            Vector2D[][] v1 = set.getVertices();
            double s1 = set.getSize();
            Vector2D b1 = (Vector2D) set.getBarycenter();

            Vector2D[][] v2 = set.getVertices();
            double s2 = set.getSize();
            Vector2D b2 = (Vector2D) set.getBarycenter();

            if (v1.length != v2.length) {
                throw new RuntimeException("metamorphic violation: repeated getVertices length changed");
            }
            if (!sameDouble(s1, s2)) {
                throw new RuntimeException("metamorphic violation: repeated getSize changed");
            }
            if (!sameVector(b1, b2)) {
                throw new RuntimeException("metamorphic violation: repeated getBarycenter changed");
            }
        } catch (ClassCastException e) {
            throw e;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        }
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }
