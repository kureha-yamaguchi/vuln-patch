    private static RectangleConstraint fixedWidthHeightNone(double width) {
        return new RectangleConstraint(
                width, new Range(width, width), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );
    }

    private static Result anchorCenterOnly(Graphics2D g2, double totalWidth, double centerWidth, double centerHeight) {
        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(centerWidth, centerHeight));
        RectangleConstraint constraint = fixedWidthHeightNone(totalWidth);
        Size2D size = container.arrange(g2, constraint);
