    private static BigDecimal[] makeBigVector(FuzzedDataProvider data, int len) {
        BigDecimal[] out = new BigDecimal[len];
        for (int i = 0; i < len; i++) {
            out[i] = new BigDecimal(data.consumeInt(-10, 10));
        }
        return out;
