package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        checkLongSuffixBoundary("0", 'L');
        checkLongSuffixBoundary("7", 'l');
        checkLongSuffixBoundary("-1", 'L');
        checkLongSuffixBoundary(Integer.toString(data.consumeInt(-999999, 999999)),
                data.consumeBoolean() ? 'L' : 'l');

        String ascii = data.consumeAsciiString(24);
        if (ascii.length() > 0) {
            String digitsOnly = keepDigitsAndLeadingMinus(ascii);
            if (isValidCanonicalInteger(digitsOnly)) {
                checkLongSuffixBoundary(digitsOnly, data.consumeBoolean() ? 'L' : 'l');
            }
        }
    }

    private static void runAnchor() {
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            try {
                NumberUtils.createNumber(badInputs[i]);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isKnownRootCause(t)) {
                    continue;
                }
            }
        }
    }

    private static void checkLongSuffixBoundary(String core, char suffix) {
        if (!isValidCanonicalInteger(core)) {
            return;
        }

        String suffixedText = core + suffix;
        try {
            Number suffixed = NumberUtils.createNumber(suffixedText);
            Number plain = NumberUtils.createNumber(core);

            if (suffixed == null || plain == null) {
                return;
            }

            /* Contract/oracle:
             * createNumber(String) parses a numeric string, and adding 'L'/'l' requests the long type
             * for an otherwise valid integer string. For any integer text within long range, the numeric
             * value must be preserved and the requested type must be a Long.
             * A patch that merely suppresses the old crash or overfits the one-character seed can still
             * violate this boundary behavior for nearby valid inputs such as "0L", "7l", "-1L".
             */
            if (!(suffixed instanceof Long)) {
                throw new RuntimeException("[oracle:flip-l-boundary] metamorphic violation: expected Long for input="
                        + suffixedText + " got=" + suffixed.getClass().getName() + " value=" + suffixed);
            }

            long lhs = suffixed.longValue();
            long rhs = plain.longValue();
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:flip-l-boundary] metamorphic violation: suffix changed numeric value input="
                        + suffixedText + " lhs=" + lhs + " rhs=" + rhs);
            }

            String reparsedText = suffixed.toString() + suffix;
            try {
                Number reparsed = NumberUtils.createNumber(reparsedText);
                if (reparsed == null) {
                    return;
                }
                if (!(reparsed instanceof Long) || reparsed.longValue() != lhs) {
                    throw new RuntimeException("[oracle:long-roundtrip] metamorphic violation: reparse disagrees input="
                            + suffixedText + " reparsedInput=" + reparsedText + " first=" + suffixed + " second="
                            + reparsed);
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isKnownRootCause(t)) {
                    throw asRuntime(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isKnownRootCause(t)) {
                throw asRuntime(t);
            }
        }
    }

    private static boolean isValidCanonicalInteger(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        if ("-".equals(s)) {
            return false;
        }
        int start = 0;
        if (s.charAt(0) == '-') {
            start = 1;
            if (s.length() == 1) {
                return false;
            }
        }
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        if (start < s.length() - 1 && s.charAt(start) == '0') {
            return false;
        }
        return true;
    }

    private static String keepDigitsAndLeadingMinus(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder();
        if (s.charAt(0) == '-') {
            sb.append('-');
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)
                        || "substring".equals(method)
                        || "charAt".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static RuntimeException asRuntime(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
