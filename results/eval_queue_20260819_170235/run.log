package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("l");
        runAnchor("L");
        runAnchor("f");
        runAnchor("F");
        runAnchor("junk");
        runAnchor("bobL");

        String maybeSingle = data.consumeAsciiString(1);
        if (maybeSingle.length() == 1) {
            exerciseInvalid(maybeSingle);
        }

        String invalidLike = buildInvalidLikeInput(data);
        exerciseInvalid(invalidLike);

        String numeric = buildValidLongNumeric(data);
        char suffix = data.consumeBoolean() ? 'L' : 'l';
        String withSuffix = numeric + suffix;

        Number parsed;
        try {
            parsed = NumberUtils.createNumber(withSuffix);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInReachableRegion(t)) {
                throw t;
            }
            return;
        }

        Number expected;
        try {
            expected = NumberUtils.createLong(numeric);
        } catch (RuntimeException t) {
            return;
        }

        if (!sameNumericValueAndType(parsed, expected)) {
            throw new RuntimeException(
                "[oracle:createNumber-long-family] metamorphic violation: createNumber(\"" + withSuffix
                    + "\") must agree with createLong(\"" + numeric + "\") for valid integral L/l-suffixed inputs"
                    + " lhs=" + describe(parsed) + " rhs=" + describe(expected));
        }

        String upper = numeric + "L";
        String lower = numeric + "l";
        try {
            Number upperParsed = NumberUtils.createNumber(upper);
            Number lowerParsed = NumberUtils.createNumber(lower);
            if (!sameNumericValueAndType(upperParsed, lowerParsed)) {
                throw new RuntimeException(
                    "[oracle:createNumber-suffix-case] metamorphic violation: equivalent L/l suffix inputs disagree"
                        + " upper=" + describe(upperParsed) + " lower=" + describe(lowerParsed)
                        + " inputUpper=" + upper + " inputLower=" + lower);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInReachableRegion(t)) {
                throw t;
            }
        }
    }

    private static void runAnchor(String input) {
        try {
            Number n = NumberUtils.createNumber(input);
            throw new RuntimeException(
                "[oracle:reject-invalid] metamorphic violation: invalid input should be rejected, but returned "
                    + describe(n) + " for input=" + input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (("l".equals(input) || "L".equals(input)) && isRootCauseInReachableRegion(t)) {
                throw t;
            }
        }
    }

    private static void exerciseInvalid(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (("l".equals(input) || "L".equals(input)) && isRootCauseInReachableRegion(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseInReachableRegion(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if (!"org.apache.commons.lang.NumberUtils".equals(e.getClassName())) {
                continue;
            }
            String m = e.getMethodName();
            if ("createNumber".equals(m)
                || "createInteger".equals(m)
                || "isAllZeros".equals(m)
                || "charAt".equals(m)
                || "substring".equals(m)
                || "isDigits".equals(m)
                || "createLong".equals(m)
                || "createBigInteger".equals(m)
                || "createFloat".equals(m)
                || "createDouble".equals(m)
                || "createBigDecimal".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidLongNumeric(FuzzedDataProvider data) {
        int value = data.consumeInt(-1_000_000, 1_000_000);
        String numeric = Integer.toString(value);

        int zeros = data.consumeInt(0, 3);
        boolean negative = numeric.startsWith("-");
        String digits = negative ? numeric.substring(1) : numeric;

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }
        for (int i = 0; i < zeros; i++) {
            sb.append('0');
        }
        sb.append(digits);

        String out = sb.toString();
        if ("-".equals(out) || out.length() == 0) {
            return "0";
        }
        return out;
    }

    private static String buildInvalidLikeInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 4);
        switch (mode) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return data.consumeBoolean() ? "f" : "F";
            case 2: {
                String prefix = data.consumeAsciiString(8);
                if (prefix.length() == 0) {
                    prefix = "x";
                }
                return prefix + (data.consumeBoolean() ? "L" : "l");
            }
            case 3: {
                String s = data.consumeAsciiString(8);
                if (s.length() == 0) {
                    s = "junk";
                }
                return s;
            }
            default:
                return data.consumeBoolean() ? "bobL" : "junk";
        }
    }

    private static boolean sameNumericValueAndType(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (!a.getClass().equals(b.getClass())) {
            return false;
        }
        return a.toString().equals(b.toString());
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + n.toString();
    }
}
