            case 3:
                return Long.valueOf(data.consumeInt(-1000, 1000));
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            case 5:
                return new StringBuilder(data.consumeAsciiString(8));
            default:
                return data.consumeBytes(8);
        }
    }

    private static String buildValidCanonicalClassName(FuzzedDataProvider data) {
        String[] bases = new String[] {
                "java.lang.String",
                "java.lang.Integer",
                "java.lang.Double",
                "java.lang.Long",
                "java.lang.Boolean",
                "java.lang.Object",
                "int",
                "double",
                "boolean",
                "byte"
        };
        String base = bases[data.consumeInt(0, bases.length - 1)];
        int dims = data.consumeInt(0, 2);
        StringBuilder sb = new StringBuilder(base);
        for (int i = 0; i < dims; i++) {
            sb.append("[]");
        }
        return sb.toString();
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static Object sameClassReplacement(Object o) {
        if (o instanceof String) {
            return new String((String) o);
        }
        if (o instanceof Integer) {
            return Integer.valueOf(((Integer) o).intValue() + 1);
        }
        if (o instanceof Double) {
            return Double.valueOf(((Double) o).doubleValue() + 1.0d);
        }
        if (o instanceof Long) {
            return Long.valueOf(((Long) o).longValue() + 1L);
        }
        if (o instanceof Boolean) {
            return Boolean.valueOf(!((Boolean) o).booleanValue());
        }
        if (o instanceof StringBuilder) {
            return new StringBuilder(o.toString()).append('x');
        }
        if (o instanceof byte[]) {
            byte[] in = (byte[]) o;
            byte[] out = new byte[in.length + 1];
            System.arraycopy(in, 0, out, 0, in.length);
            out[in.length] = 1;
            return out;
        }
        return null;
    }

    private static String describeArray(Object[] array) {
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < array.length; i++) {
            if (i > 0) {
                sb.append(", ");
            }
            Object o = array[i];
            if (o == null) {
                sb.append("null");
            } else {
                sb.append(o.getClass().getName());
            }
        }
        sb.append(']');
        return sb.toString();
    }
