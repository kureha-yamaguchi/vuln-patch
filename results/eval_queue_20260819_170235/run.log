public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        PolygonsSet anchor = new PolygonsSet(
                new BSPTree<Euclidean2D>(new BoundaryAttribute<Euclidean2D>(null, null)));
        anchor.computeGeometricalProperties();
        assertEmptyGeometry(anchor, "anchor");

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            BoundaryAttribute<Euclidean2D> attr = new BoundaryAttribute<Euclidean2D>(null, null);
            PolygonsSet leaf = new PolygonsSet(new BSPTree<Euclidean2D>(attr));
            leaf.computeGeometricalProperties();
            assertEmptyGeometry(leaf, "leaf-" + i);

            boolean whole = data.consumeBoolean();
            PolygonsSet booleanLeaf = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(whole)));
            booleanLeaf.computeGeometricalProperties();
            if (whole) {
                assertWholeGeometry(booleanLeaf, "bool-whole-" + i);
            } else {
                assertEmptyGeometry(booleanLeaf, "bool-empty-" + i);
            }
