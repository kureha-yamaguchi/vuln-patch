package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    private static final double ANCHOR_P = 0.9772498680518209d;
    private static final double ANCHOR_X = 2.0d;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);

        // ANCHOR: exact failing test input first.
        try {
            double result = normal.inverseCumulativeProbability(ANCHOR_P);
            if (Math.abs(result - ANCHOR_X) > 1.0e-12) {
                throw new RuntimeException(
                    "[oracle:anchor-value] metamorphic violation: inverseCumulativeProbability(" +
                    ANCHOR_P + ") should recover the documented test point 2.0 but got " + result);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        // POST-CONDITION / METAMORPHIC CHECK:
        // For a correct normal distribution, inverseCumulativeProbability is monotone:
        // if p1 < p2 then invCDF(p1) <= invCDF(p2). This still detects a silent wrong-value
        // patch even if the original MathException is merely suppressed.
        try {
            double pLeft = Math.nextAfter(ANCHOR_P, 0.0d);
            double pRight = Math.nextAfter(ANCHOR_P, 1.0d);
            double xLeft = normal.inverseCumulativeProbability(pLeft);
            double xMid = normal.inverseCumulativeProbability(ANCHOR_P);
            double xRight = normal.inverseCumulativeProbability(pRight);
            if (!(xLeft <= xMid && xMid <= xRight)) {
                throw new RuntimeException(
                    "[oracle:anchor-monotone] metamorphic violation: expected invCDF(" +
                    pLeft + ") <= invCDF(" + ANCHOR_P + ") <= invCDF(" + pRight +
                    ") but got " + xLeft + ", " + xMid + ", " + xRight);
            }
            if (!(xLeft <= ANCHOR_X + 1.0e-10 && xRight >= ANCHOR_X - 1.0e-10)) {
                throw new RuntimeException(
                    "[oracle:anchor-bracket] metamorphic violation: probabilities immediately around " +
                    ANCHOR_P + " must bracket x=2.0 but got left=" + xLeft + " right=" + xRight);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        exploreAroundPatchedBoundary(normal, data);
        exploreGeneralMonotonicity(normal, data);
    }

    private static void exploreAroundPatchedBoundary(NormalDistribution normal, FuzzedDataProvider data) {
        int belowSteps = data.consumeInt(1, 128);
        int aboveSteps = data.consumeInt(1, 128);

        double pBelow = stepProbability(ANCHOR_P, false, belowSteps);
        double pAbove = stepProbability(ANCHOR_P, true, aboveSteps);

        try {
            double xBelow = normal.inverseCumulativeProbability(pBelow);
            double xAnchor = normal.inverseCumulativeProbability(ANCHOR_P);
            double xAbove = normal.inverseCumulativeProbability(pAbove);

            if (!(pBelow < ANCHOR_P && ANCHOR_P < pAbove)) {
                return;
            }
            if (!(xBelow <= xAnchor && xAnchor <= xAbove)) {
                throw new RuntimeException(
                    "[oracle:boundary-order] metamorphic violation: expected invCDF to preserve order around anchor; " +
                    "pBelow=" + pBelow + " pAnchor=" + ANCHOR_P + " pAbove=" + pAbove +
                    " xBelow=" + xBelow + " xAnchor=" + xAnchor + " xAbove=" + xAbove);
            }
            if (!(xBelow <= ANCHOR_X + 1.0e-9 && xAbove >= ANCHOR_X - 1.0e-9)) {
                throw new RuntimeException(
                    "[oracle:boundary-flip] metamorphic violation: values on both sides of the anchor probability " +
                    "must stay on both sides of x=2.0; pBelow=" + pBelow + " pAbove=" + pAbove +
                    " xBelow=" + xBelow + " xAbove=" + xAbove);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void exploreGeneralMonotonicity(NormalDistribution normal, FuzzedDataProvider data) {
        int checks = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < checks; i++) {
            double p1 = validProbabilityFromInt(data.consumeInt());
            double p2 = validProbabilityFromInt(data.consumeInt());

            if (p1 == p2) {
                p2 = Math.nextAfter(p2, 1.0d);
                if (!(p2 > 0.0d && p2 < 1.0d)) {
                    continue;
                }
            }

            double loP = Math.min(p1, p2);
            double hiP = Math.max(p1, p2);

            try {
                double loX = normal.inverseCumulativeProbability(loP);
                double hiX = normal.inverseCumulativeProbability(hiP);

                // Correct inverse CDFs are monotone on valid probabilities in (0,1).
                if (loP < hiP && !(loX <= hiX)) {
                    throw new RuntimeException(
                        "[oracle:monotone] metamorphic violation: p1=" + loP + " p2=" + hiP +
                        " but invCDF(p1)=" + loX + " > invCDF(p2)=" + hiX);
                }

                // Independent consistency check from the same public API:
                // cumulativeProbability is monotone, so applying it back to ordered inverse outputs
                // must preserve the same order. This is a second observable beyond just "no exception".
                double backLo = normal.cumulativeProbability(loX);
                double backHi = normal.cumulativeProbability(hiX);
                if (!(backLo <= backHi)) {
                    throw new RuntimeException(
                        "[oracle:cdf-order] consistency violation: cumulativeProbability(invCDF(" + loP +
                        "))=" + backLo + " should be <= cumulativeProbability(invCDF(" + hiP +
                        "))=" + backHi);
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
                return;
            }
        }
    }

    private static double validProbabilityFromInt(int raw) {
        long unsigned = raw & 0xffffffffL;
        double p = (unsigned + 1.0d) / ((double) (1L << 32) + 2.0d);
        if (p <= 0.0d) {
            return Math.nextAfter(0.0d, 1.0d);
        }
        if (p >= 1.0d) {
            return Math.nextAfter(1.0d, 0.0d);
        }
        return p;
    }

    private static double stepProbability(double base, boolean upward, int steps) {
        double p = base;
        for (int i = 0; i < steps; i++) {
            p = Math.nextAfter(p, upward ? 1.0d : 0.0d);
            if (!(p > 0.0d && p < 1.0d)) {
                break;
            }
        }
        return p;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        boolean hasMathException = false;
        boolean hasRelevantFrame = false;

        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof MathException) {
                hasMathException = true;
            }
            StackTraceElement[] stack = cur.getStackTrace();
            if (stack == null) {
                continue;
            }
            for (int i = 0; i < stack.length; i++) {
                StackTraceElement ste = stack[i];
                String cls = ste.getClassName();
                String method = ste.getMethodName();
                if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                        && "bracket".equals(method))
                    || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                        && "inverseCumulativeProbability".equals(method))) {
                    hasRelevantFrame = true;
                    break;
                }
            }
        }

        return hasMathException && hasRelevantFrame;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
