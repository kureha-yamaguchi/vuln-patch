private static void assertEmptyGeometry(PolygonsSet poly, String label) {
        Vector2D[][] vertices = poly.getVertices();
        if (vertices == null || vertices.length != 0) {
            throw new RuntimeException("[oracle:empty-vertices] metamorphic violation: expected zero loops input="
                    + label + " loops=" + verticesSummary(vertices));
        }

        double size1 = poly.getSize();
        Vector2D bc1 = asVector(poly.getBarycenter());
        if (!sameDouble(size1, 0.0) || bc1 == null || !sameDouble(bc1.getX(), 0.0) || !sameDouble(bc1.getY(), 0.0)) {
            throw new RuntimeException("[oracle:empty-geometry] metamorphic violation: expected empty geometry input="
                    + label + " size=" + size1 + " barycenter=" + pointToString(bc1));
        }

        /*
         * Contract from computeGeometricalProperties():
         * when getVertices().length == 0 and the tree does not represent whole space,
         * it must set size to 0 and barycenter to (0,0). Re-running it on the same
         * region must preserve that observable summary.
         */
        poly.computeGeometricalProperties();
        double size2 = poly.getSize();
        Vector2D bc2 = asVector(poly.getBarycenter());
        if (!sameDouble(size1, size2) || !sameVector(bc1, bc2)) {
            throw new RuntimeException("[oracle:idempotence-empty] metamorphic violation: repeated computeGeometricalProperties changed empty geometry input="
                    + label + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                    + " rhs=size=" + size2 + ",bc=" + pointToString(bc2));
        }
    }
