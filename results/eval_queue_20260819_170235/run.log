package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;

    private static final class Problem {
        final LinearObjectiveFunction f;
        final List<LinearConstraint> constraints;
        final GoalType goalType;
        final boolean nonNegative;

        Problem(LinearObjectiveFunction f, List<LinearConstraint> constraints, GoalType goalType, boolean nonNegative) {
            this.f = f;
            this.constraints = constraints;
            this.goalType = goalType;
            this.nonNegative = nonNegative;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runProblem(buildAnchorLikeProblem(), 10);

        int variants = data.consumeInt(1, 4);
        for (int i = 0; i < variants; i++) {
            Problem p = buildFuzzProblem(data);
            int maxUlps = Math.max(1, data.consumeInt(1, 20));
            runProblem(p, maxUlps);
        }
    }

    private static void runProblem(Problem p, int maxUlps) {
        try {
            // Cross-check internal tableau state from a second, independently-constructed real object.
            // For a correct simplex tableau, every reported basic artificial variable column must have a 1
            // in its reported basic row, which is the same quantity getPivotRow relies on.
            checkArtificialBasisConsistency(p);

            PointValuePair first = optimizeOnce(p, maxUlps);
            if (first == null) {
                return;
            }

            // Post-condition copied from the library's own tests:
            // any returned solution must satisfy all constraints.
            if (!validSolution(first, p.constraints, EPS)) {
                throw new RuntimeException("[oracle:valid-solution] metamorphic violation: returned solution violates constraints value="
                        + first.getValue() + " point=" + Arrays.toString(first.getPoint()));
            }

            // Determinism / recomputation consistency:
            // two fresh, identically-constructed solvers on the same problem must agree.
            PointValuePair second = optimizeOnce(p, maxUlps);
            if (second == null) {
                return;
            }
            if (!samePointValue(first, second)) {
                throw new RuntimeException("[oracle:repeatable] metamorphic violation: identical solves disagree lhsValue="
                        + first.getValue() + " rhsValue=" + second.getValue()
                        + " lhsPoint=" + Arrays.toString(first.getPoint())
                        + " rhsPoint=" + Arrays.toString(second.getPoint()));
            }
        } catch (RuntimeException e) {
            throw e;
        }
    }

    private static PointValuePair optimizeOnce(Problem p, int maxUlps) {
        try {
            SimplexSolver solver = new SimplexSolver(EPS, maxUlps);
            return solver.optimize(p.f, p.constraints, p.goalType, p.nonNegative);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw sneakyRuntime(t);
            }
            if (isCleanRejection(t)) {
                return null;
            }
            return null;
        }
    }

    private static void checkArtificialBasisConsistency(Problem p) {
        try {
            SimplexTableau tableau = new SimplexTableau(p.f, p.constraints, p.goalType, p.nonNegative, EPS);
            int numArtificial = tableau.getNumArtificialVariables();
            int offset = tableau.getArtificialVariableOffset();
            for (int i = 0; i < numArtificial; i++) {
                int column = offset + i;
                Integer row = tableau.getBasicRow(column);
                if (row != null) {
                    double entry = tableau.getEntry(row.intValue(), column);
                    if (!Precision.equals(entry, 1.0d, 10)) {
                        throw new RuntimeException("[oracle:artificial-basis] consistency violation: basic artificial column="
                                + column + " row=" + row + " entry=" + entry + " numArtificial=" + numArtificial);
                    }
                }
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw sneakyRuntime(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            int len = Math.min(vals.length, coeffs.length);
            for (int i = 0; i < len; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean samePointValue(PointValuePair a, PointValuePair b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (!Precision.equals(a.getValue(), b.getValue(), EPS)) {
            return false;
        }
        double[] pa = a.getPoint();
        double[] pb = b.getPoint();
        if (pa.length != pb.length) {
            return false;
        }
        for (int i = 0; i < pa.length; i++) {
            if (!Precision.equals(pa[i], pb[i], EPS)) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        if (t instanceof MaxCountExceededException) {
            return false;
        }
        Package p = t.getClass().getPackage();
        if (p != null) {
            String name = p.getName();
            if (name.startsWith("org.apache.commons.math3.exception")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getNumObjectiveFunctions".equals(method)
                    || "getHeight".equals(method)
                    || "getWidth".equals(method)
                    || "getEntry".equals(method)
                    || "getNumArtificialVariables".equals(method)
                    || "getArtificialVariableOffset".equals(method)
                    || "getBasicRow".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(method) || "equals".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.AbstractRealMatrix".equals(cls)
                    || "org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls)
                    || "org.apache.commons.math3.linear.BlockRealMatrix".equals(cls)) {
                if ("getRowDimension".equals(method)
                        || "getColumnDimension".equals(method)
                        || "getEntry".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static RuntimeException sneakyRuntime(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

