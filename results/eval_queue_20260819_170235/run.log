package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    private static final int ACCEPT = 0;
    private static final int CLEAN_REJECT = 1;
    private static final int ROOT_CAUSE = 2;
    private static final int OTHER = 3;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runBoundaryExploration(data);
        runPrecisionFallbackOracle(data);
    }

    private static void runAnchor() {
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            int outcome = classifyCreateNumber(badInputs[i]);
            if (outcome != CLEAN_REJECT) {
                throw new RuntimeException("[oracle:anchor-reject] invalid input must be rejected cleanly: input="
                        + badInputs[i] + " outcome=" + outcome);
            }
        }
    }

    private static void runBoundaryExploration(FuzzedDataProvider data) {
        char suffix = data.consumeBoolean() ? 'L' : 'l';

        // Contract used for this oracle:
        // createNumber is the public parser/factory for numbers; for a valid integral string
        // with an L/l type suffix, it must agree with the dedicated createLong/createBigInteger
        // parser on the same numeric payload. A throw-deleting or overfitted boundary patch that
        // mishandles the length==1 guard can still break just past the boundary.
        String signedDigits = buildValidLongPayload(data);
        String validLongInput = signedDigits + suffix;
        try {
            Number actual = NumberUtils.createNumber(validLongInput);
            Long expected = NumberUtils.createLong(signedDigits);
            if (!(actual instanceof Long) || actual.longValue() != expected.longValue()) {
                throw new RuntimeException("[oracle:long-suffix] metamorphic violation: input=" + validLongInput
                        + " actual=" + describe(actual) + " expected=" + describe(expected));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            throw e;
        }

        String huge = buildOverflowPayload(data);
        String hugeInput = huge + suffix;
        try {
            Number actualHuge = NumberUtils.createNumber(hugeInput);
            BigInteger expectedHuge = NumberUtils.createBigInteger(huge);
            if (!(actualHuge instanceof BigInteger)
                    || !expectedHuge.equals((BigInteger) actualHuge)) {
                throw new RuntimeException("[oracle:bigint-fallback] metamorphic violation: input=" + hugeInput
                        + " actual=" + describe(actualHuge) + " expected=" + describe(expectedHuge));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            throw e;
        }

        String invalidSingle = String.valueOf(suffix);
        int outcome = classifyCreateNumber(invalidSingle);
        if (outcome != CLEAN_REJECT) {
            throw new RuntimeException("[oracle:length-boundary] single-character suffix-only input must be rejected cleanly: input="
                    + invalidSingle + " outcome=" + outcome);
        }
    }

    private static void runPrecisionFallbackOracle(FuzzedDataProvider data) {
        // Contract used for this oracle:
        // for valid decimal input with an F suffix, createNumber first tries Float/Double and
        // falls back to BigDecimal when precision/range is insufficient. The test suite documents
        // this with 1.1E-700F -> BigDecimal("1.1E-700"). This checks a different observable in
        // the same reachable region (createFloat/createDouble/createBigDecimal).
        String frac = digitsOnly(data.consumeAsciiString(8));
        if (frac.length() == 0) {
            frac = "1";
        }
        String numeric = "1." + frac + "E-700";
        String input = numeric + (data.consumeBoolean() ? "F" : "f");
        try {
            Number actual = NumberUtils.createNumber(input);
            BigDecimal expected = NumberUtils.createBigDecimal(numeric);
            if (!(actual instanceof BigDecimal) || ((BigDecimal) actual).compareTo(expected) != 0) {
