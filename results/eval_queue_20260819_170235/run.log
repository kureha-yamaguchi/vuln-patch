package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);

        // ANCHOR: exact regression input from NormalDistributionTest.testMath280.
        try {
            double result = normal.inverseCumulativeProbability(0.9772498680518209d);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                        "[oracle:anchor] metamorphic violation: inverseCumulativeProbability(CDF(2)) must recover 2.0"
                                + " input=0.9772498680518209 result=" + result + " expected=2.0");
            }
        } catch (Throwable t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                sneakyThrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        // EXPLORE: build valid probabilities by construction from the real public API.
        // For a correct NormalDistribution, inverseCumulativeProbability(cumulativeProbability(x))
        // must recover x for moderate x in the interior of the domain.
        int trials = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < trials; i++) {
            double base = data.consumeInt(-6, 6);
            double frac = data.consumeInt(-3, 3) / 4.0d;
            double x = base + frac;

            try {
                double p = normal.cumulativeProbability(x);
                if (!(p > 0.0d && p < 1.0d)) {
                    continue;
                }
                double recovered = normal.inverseCumulativeProbability(p);
                if (Math.abs(recovered - x) > 1.0e-6d) {
                    throw new RuntimeException(
                            "[oracle:roundtrip] metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x))"
                                    + " input=" + x + " p=" + p + " lhs=" + recovered + " rhs=" + x);
                }
            } catch (Throwable t) {
                if (isOracleFailure(t) || isRootCause(t)) {
                    sneakyThrow(t);
                }
                if (isCleanRejection(t)) {
                    continue;
                }
            }

            // Independent consistency cross-check using the same real API:
            // standard normal is symmetric, so for valid p in (0,1),
            // inverseCumulativeProbability(1 - p) == -inverseCumulativeProbability(p).
            try {
                double p = normal.cumulativeProbability(x);
                if (!(p > 1.0e-12d && p < 1.0d - 1.0e-12d)) {
                    continue;
                }
                double q1 = normal.inverseCumulativeProbability(p);
                double q2 = normal.inverseCumulativeProbability(1.0d - p);
                if (Math.abs(q1 + q2) > 1.0e-6d) {
                    throw new RuntimeException(
                            "[oracle:symmetry] metamorphic violation: inv(1-p) must equal -inv(p)"
                                    + " x=" + x + " p=" + p + " lhs=" + q2 + " rhs=" + (-q1));
                }
            } catch (Throwable t) {
                if (isOracleFailure(t) || isRootCause(t)) {
                    sneakyThrow(t);
                }
                if (isCleanRejection(t)) {
                    continue;
                }
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof MathException && hasRelevantFrame(cur)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
