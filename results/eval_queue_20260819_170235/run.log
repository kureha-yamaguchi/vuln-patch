package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.Point;
import org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseBoundaryAttributeLeaf(new BoundaryAttribute<Euclidean2D>(null, null), "anchor-boundaryattr");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            exerciseBooleanLeaf(true, "anchor-whole");
            exerciseBooleanLeaf(false, "anchor-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 12);
        for (int i = 0; i < cases; i++) {
            try {
                if (data.consumeBoolean()) {
                    exerciseBoundaryAttributeLeaf(new BoundaryAttribute<Euclidean2D>(null, null), "direct-leaf-" + i);
                } else {
                    double x1 = finiteCoord(data.consumeInt());
                    double x2 = finiteCoord(data.consumeInt());
                    double y1 = finiteCoord(data.consumeInt());
                    double y2 = finiteCoord(data.consumeInt());

                    if (x1 == x2) {
                        x2 = x1 + 1.0;
                    }
                    if (y1 == y2) {
                        y2 = y1 + 1.0;
                    }

                    double minX = Math.min(x1, x2);
                    double maxX = Math.max(x1, x2);
                    double minY = Math.min(y1, y2);
                    double maxY = Math.max(y1, y2);

                    PolygonsSet source = new PolygonsSet(minX, maxX, minY, maxY);
                    Object attr = source.getTree(false).getAttribute();
                    if (attr instanceof BoundaryAttribute) {
                        exerciseBoundaryAttributeLeaf((BoundaryAttribute<Euclidean2D>) attr, "rect-attr-" + i);
                    }
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }

            try {
                boolean whole = data.consumeBoolean();
                exerciseBooleanLeaf(whole, "bool-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }
    }

    private static void exerciseBoundaryAttributeLeaf(BoundaryAttribute<Euclidean2D> attr, String label) {
        PolygonsSet poly = new PolygonsSet(new BSPTree<Euclidean2D>(attr));

        try {
            Vector2D[][] vertices = poly.getVertices();
            if (vertices == null || vertices.length != 0) {
                return;
            }
            poly.getSize();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        try {
            double size = poly.getSize();
            Vector2D barycenter = asVector(poly.getBarycenter());
            boolean empty = poly.isEmpty();

            /*
             * Contract visible in computeGeometricalProperties(): when getVertices().length == 0
             * and the region does not cover the whole space, it must set size to 0 and barycenter
             * to (0,0). A throw-deleting patch that merely suppresses the cast but skips that
             * bookkeeping would leave the region summary inconsistent with isEmpty().
             */
            if (!empty) {
                throw new RuntimeException("[oracle:leaf-nonwhole-emptyflag] metamorphic violation: zero-vertex leaf with non-Boolean attribute must not become non-empty input="
                        + label + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
            if (!sameDouble(size, 0.0) || barycenter == null
                    || !sameDouble(barycenter.getX(), 0.0)
                    || !sameDouble(barycenter.getY(), 0.0)) {
                throw new RuntimeException("[oracle:leaf-summary] metamorphic violation: zero-vertex non-whole leaf must summarize as empty input="
                        + label + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void exerciseBooleanLeaf(boolean whole, String label) {
        PolygonsSet poly = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(whole)));

        Vector2D[][] vertices;
        boolean emptyBefore;
        try {
            vertices = poly.getVertices();
            emptyBefore = poly.isEmpty();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
            return;
        }

        if (vertices == null || vertices.length != 0) {
            return;
        }

        double size;
        Vector2D barycenter;
        boolean emptyAfter;
        try {
            size = poly.getSize();
            barycenter = asVector(poly.getBarycenter());
            emptyAfter = poly.isEmpty();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
            return;
        }

        /*
         * For a zero-vertex region, !isEmpty() means whole space and isEmpty() means empty space.
         * computeGeometricalProperties() must therefore produce the matching summary:
         * whole -> infinite size and NaN barycenter; empty -> zero size and (0,0) barycenter.
         * This cross-check uses isEmpty() as an independent observable, so a patch that flips
         * the branch condition or silently skips the bookkeeping still fails here.
         */
        if (whole) {
            if (emptyBefore || emptyAfter) {
                throw new RuntimeException("[oracle:whole-emptiness-flag] metamorphic violation: Boolean.TRUE leaf must remain non-empty input="
                        + label + " before=" + emptyBefore + " after=" + emptyAfter
                        + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
            if (!Double.isInfinite(size) || size < 0.0 || barycenter == null
                    || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                throw new RuntimeException("[oracle:whole-flag-summary] metamorphic violation: non-empty zero-vertex region must summarize as whole space input="
                        + label + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
        } else {
            if (!emptyBefore || !emptyAfter) {
                throw new RuntimeException("[oracle:empty-emptiness-flag] metamorphic violation: Boolean.FALSE leaf must remain empty input="
                        + label + " before=" + emptyBefore + " after=" + emptyAfter
                        + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
            if (!sameDouble(size, 0.0) || barycenter == null
                    || !sameDouble(barycenter.getX(), 0.0) || !sameDouble(barycenter.getY(), 0.0)) {
                throw new RuntimeException("[oracle:empty-flag-summary] metamorphic violation: empty zero-vertex region must summarize as empty space input="
                        + label + " size=" + size + " barycenter=" + pointToString(barycenter));
            }
        }

        try {
            PolygonsSet twin = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(whole)));
            double twinSize = twin.getSize();
            Vector2D twinBarycenter = asVector(twin.getBarycenter());
            boolean twinEmpty = twin.isEmpty();
            if (emptyAfter != twinEmpty || !sameDouble(size, twinSize) || !sameVector(barycenter, twinBarycenter)) {
                throw new RuntimeException("[oracle:boolean-twin-consistency] metamorphic violation: identically-constructed Boolean leaves disagreed input="
                        + label + " lhs=empty:" + emptyAfter + ",size:" + size + ",bc:" + pointToString(barycenter)
                        + " rhs=empty:" + twinEmpty + ",size:" + twinSize + ",bc:" + pointToString(twinBarycenter));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static double finiteCoord(int value) {
        return value / 1024.0;
    }

    private static Vector2D asVector(Point<Euclidean2D> point) {
        if (point == null) {
            return null;
        }
        return (Vector2D) point;
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        return Double.isNaN(a) && Double.isNaN(b);
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static String pointToString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return "(" + p.getX() + "," + p.getY() + ")";
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math3.exception.")
                && name.indexOf("Internal") < 0;
    }

