                        || "setBarycenter".equals(method)
                        || "visit".equals(method)
                        || "isEmpty".equals(method)
                        || "getSmallest".equals(method)
                        || "followLoop".equals(method)
                        || "getLine".equals(method)
                        || "toSpace".equals(method)
                        || "getStart".equals(method)
