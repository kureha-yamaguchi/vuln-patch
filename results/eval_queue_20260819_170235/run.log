private static void exerciseLeafBoundaryAttribute(PolygonsSet source, String label) {
        Object attr = extractBoundaryAttribute(source.getTree(false));
        if (!(attr instanceof BoundaryAttribute)) {
            return;
        }

        PolygonsSet leaf = new PolygonsSet(new BSPTree<Euclidean2D>(attr));

        try {
            leaf.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = leaf.getVertices();
            if (vertices == null || vertices.length != 0) {
                return;
            }

            /*
             * Contract from computeGeometricalProperties():
             * when getVertices().length == 0 and the tree does not represent whole space,
             * size must become 0 and barycenter must become (0,0).
             * A patch that merely suppresses the cast/throw but skips the intended bookkeeping
             * violates this observable state.
             */
            assertEmptyGeometry(leaf, label + "-leaf");

            PolygonsSet twin = new PolygonsSet(new BSPTree<Euclidean2D>(attr));
            try {
                twin.computeGeometricalProperties();
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }

            double size1 = leaf.getSize();
            Vector2D bc1 = asVector(leaf.getBarycenter());
            double size2 = twin.getSize();
            Vector2D bc2 = asVector(twin.getBarycenter());
            if (!sameDouble(size1, size2) || !sameVector(bc1, bc2)) {
                throw new RuntimeException("[oracle:fresh-recompute] metamorphic violation: identically-constructed leaf regions disagreed input="
                        + label + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                        + " rhs=size=" + size2 + ",bc=" + pointToString(bc2));
            }

            try {
                leaf.computeGeometricalProperties();
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }

            double size3 = leaf.getSize();
            Vector2D bc3 = asVector(leaf.getBarycenter());
            if (!sameDouble(size1, size3) || !sameVector(bc1, bc3)) {
                throw new RuntimeException("[oracle:idempotence] metamorphic violation: computeGeometricalProperties must be idempotent input="
                        + label + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                        + " rhs=size=" + size3 + ",bc=" + pointToString(bc3));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }
