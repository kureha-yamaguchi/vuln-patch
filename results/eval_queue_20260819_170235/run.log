    private static double finiteCoord(int x) {
        return (x % 20001) - 10000;
    }

    private static double positiveSpan(int x) {
        return 1.0 + Math.abs(x % 1000);
    }

    private static Vector2D asVector(Object p) {
        if (p instanceof Vector2D) {
