        String chosen = anchors[data.consumeInt(0, anchors.length - 1)];
        try {
            NumberUtils.createNumber(chosen);
        } catch (NumberFormatException expectedOnFixed) {
        }

        String suffixOnly = data.consumeBoolean() ? "l" : "L";
        NumberUtils.createNumber(suffixOnly);

        String core = buildCanonicalInteger(data);
        if (core != null) {
            char suffix = data.consumeBoolean() ? 'L' : 'l';
            String suffixed = core + suffix;
            try {
                Number plain = NumberUtils.createNumber(core);
                Number withSuffix = NumberUtils.createNumber(suffixed);

                if (plain != null && withSuffix != null) {
                    /* Contract used for this oracle:
                     * createNumber parses numeric strings, and an integral string with an 'L'/'l'
                     * suffix requests the long-typed form of the same numeric value. Thus for any
                     * canonical decimal integer text we construct here, parsing core and core+'L'
                     * must preserve the numeric value, and the suffixed form must be a Long.
                     */
                    if (!(withSuffix instanceof Long)) {
                        throw new RuntimeException("[oracle:long-suffix-type] metamorphic violation: input=" + suffixed
                                + " resultType=" + withSuffix.getClass().getName() + " value=" + withSuffix);
                    }
                    long lhs = plain.longValue();
                    long rhs = withSuffix.longValue();
                    if (lhs != rhs) {
                        throw new RuntimeException("[oracle:long-suffix-value] metamorphic violation: input=" + suffixed
                                + " plain=" + lhs + " suffixed=" + rhs);
                    }
                }
            } catch (IllegalArgumentException skipInvalidOrRejected) {
            }
        }
    }

    private static String buildCanonicalInteger(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 18);
        boolean negative = data.consumeBoolean();
        String digits = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < digits.length(); i++) {
            char c = digits.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        while (sb.length() < len) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (sb.length() == 0) {
            return null;
        }
        if (sb.charAt(0) == '0' && sb.length() > 1) {
            sb.setCharAt(0, (char) ('1' + data.consumeInt(0, 8)));
        }
        String core = sb.toString();
        if (negative) {
            core = "-" + core;
        }
        return core;
    }
