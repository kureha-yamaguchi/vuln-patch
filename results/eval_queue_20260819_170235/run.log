package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract exercised from ClassUtilsTest.testToClass_object:
        // toClass(null) == null; toClass(empty) == EMPTY_CLASS_ARRAY; and null array elements
        // are preserved as nulls in the returned Class<?>[] instead of crashing.
        if (ClassUtils.toClass(null) != null) {
            throw new RuntimeException("[oracle:anchor-null] metamorphic violation: toClass(null) must return null");
        }
        if (ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY) != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: empty array must return EMPTY_CLASS_ARRAY singleton");
        }

        Class<?>[] anchorNonNull = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        Class<?>[] expectedNonNull = new Class<?>[] { String.class, Integer.class, Double.class };
        if (!Arrays.equals(anchorNonNull, expectedNonNull)) {
            throw new RuntimeException("[oracle:anchor-baseline] metamorphic violation: input=[\"Test\",1,99d] lhs="
                    + Arrays.toString(anchorNonNull) + " rhs=" + Arrays.toString(expectedNonNull));
        }

        // Mandatory anchor using the exact failing test input. A throw-deleting or overfitted patch
        // could avoid the old NPE but still produce the wrong mapping, so we assert the full result.
        Object[] exact = new Object[] { "Test", null, Double.valueOf(99d) };
        Class<?>[] exactExpected = new Class<?>[] { String.class, null, Double.class };
        try {
            Class<?>[] exactActual = ClassUtils.toClass(exact);
            if (!Arrays.equals(exactActual, exactExpected)) {
                throw new RuntimeException("[oracle:anchor-null-slot] metamorphic violation: input="
                        + describe(exact) + " lhs=" + Arrays.toString(exactActual)
                        + " rhs=" + Arrays.toString(exactExpected));
            }
        } catch (RuntimeException t) {
            if (isRootCauseNpeFromToClass(t)) {
                throw new RuntimeException("[oracle:anchor-null-slot] metamorphic violation: valid input with a null element must map that slot to null, not throw; input="
                        + describe(exact), t);
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }

        // Strategy (c): flip the patched condition by varying null presence, count, and position.
        // Sound post-condition from the API behavior shown by the tests:
        // for every index i, result[i] is null iff input[i] is null; otherwise result[i] == input[i].getClass().
        Object[] varied = buildVariedArray(data);
        try {
            Class<?>[] actual = ClassUtils.toClass(varied);
            if (actual == null || actual.length != varied.length) {
                throw new RuntimeException("[oracle:null-slot-shape] metamorphic violation: input="
                        + describe(varied) + " resultLength=" + (actual == null ? "null" : actual.length)
                        + " expectedLength=" + varied.length);
            }
            for (int i = 0; i < varied.length; i++) {
                Class<?> expected = varied[i] == null ? null : varied[i].getClass();
                if (actual[i] != expected) {
                    throw new RuntimeException("[oracle:null-slot-shape] metamorphic violation: input="
                            + describe(varied) + " index=" + i + " lhs=" + actual[i] + " rhs=" + expected);
                }
            }

            // Independent metamorphic cross-check on the same quantity: removing all nulls and calling
            // the real API again must give exactly the subsequence of non-null classes from the original result.
            Object[] compact = compactNonNull(varied);
            try {
                Class<?>[] compactActual = ClassUtils.toClass(compact);
                Class<?>[] projected = projectNonNull(actual, varied);
                if (!Arrays.equals(compactActual, projected)) {
                    throw new RuntimeException("[oracle:nonnull-projection] metamorphic violation: input="
                            + describe(varied) + " lhs=" + Arrays.toString(compactActual)
                            + " rhs=" + Arrays.toString(projected));
                }
            } catch (RuntimeException ignored) {
                return;
            }
        } catch (RuntimeException t) {
            if (isRootCauseNpeFromToClass(t)) {
                throw new RuntimeException("[oracle:null-slot-shape] metamorphic violation: valid Object[] with null slots must be accepted; input="
                        + describe(varied), t);
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }

        // Additional check outside the already-covered toClass symptom:
        // with the thread context loader set to a chosen loader, getClass(name, init) must agree
        // with getClass(loader, name, init) on the same valid class name.
        String className = pickValidClassName(data);
        boolean initialize = data.consumeBoolean();
        ClassLoader loader = ClassUtils.class.getClassLoader();
        Thread thread = Thread.currentThread();
        ClassLoader original = thread.getContextClassLoader();
        try {
            thread.setContextClassLoader(loader);
            try {
                Class<?> viaLoader = ClassUtils.getClass(loader, className, initialize);
                Class<?> viaContext = ClassUtils.getClass(className, initialize);
                if (viaLoader != viaContext) {
                    throw new RuntimeException("[oracle:getclass-overload] metamorphic violation: name="
                            + className + " init=" + initialize + " lhs=" + viaLoader + " rhs=" + viaContext);
                }
            } catch (ClassNotFoundException e) {
                return;
            } catch (RuntimeException t) {
                if (!isCleanRejection(t)) {
                    return;
                }
            }
        } finally {
            thread.setContextClassLoader(original);
        }
    }

    private static Object[] buildVariedArray(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 8);
        Object[] out = new Object[len];

        boolean forceNull = data.consumeBoolean();
        int forcedIndex = data.consumeInt(0, len - 1);

        for (int i = 0; i < len; i++) {
            boolean useNull = data.consumeBoolean();
            if (forceNull && i == forcedIndex) {
                useNull = true;
            }
            out[i] = useNull ? null : buildRealObject(data);
        }

        if (allNonNull(out)) {
            out[forcedIndex] = null;
        }
        return out;
    }

    private static boolean allNonNull(Object[] array) {
        for (Object o : array) {
            if (o == null) {
                return false;
            }
        }
        return true;
    }

    private static Object buildRealObject(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 7)) {
            case 0:
                return data.consumeString(16);
            case 1:
                return Integer.valueOf(data.consumeInt(-1000, 1000));
            case 2:
                return Double.valueOf(data.consumeInt(-1000, 1000));
            case 3:
                return Long.valueOf(data.consumeInt(-1000, 1000));
            case 4:
                return Boolean.valueOf(data.consumeBoolean());
            case 5:
                return Byte.valueOf(data.consumeByte());
            case 6:
                return data.consumeBytes(12);
            default:
                return new StringBuilder(data.consumeAsciiString(12));
        }
    }

    private static Object[] compactNonNull(Object[] input) {
        int count = 0;
        for (Object o : input) {
            if (o != null) {
                count++;
            }
        }
        Object[] out = new Object[count];
        int j = 0;
        for (Object o : input) {
            if (o != null) {
                out[j++] = o;
            }
        }
        return out;
    }

    private static Class<?>[] projectNonNull(Class<?>[] classes, Object[] input) {
        int count = 0;
        for (Object o : input) {
            if (o != null) {
                count++;
            }
        }
        Class<?>[] out = new Class<?>[count];
        int j = 0;
        for (int i = 0; i < input.length; i++) {
            if (input[i] != null) {
                out[j++] = classes[i];
            }
        }
        return out;
    }

    private static String pickValidClassName(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 7)) {
            case 0:
                return "java.lang.String";
            case 1:
                return "java.lang.Integer";
            case 2:
                return "java.lang.String[]";
            case 3:
                return "int";
            case 4:
                return "double";
            case 5:
                return "long[][]";
            case 6:
                return "boolean[]";
            default:
                return "java.lang.Object";
        }
    }

    private static boolean isRootCauseNpeFromToClass(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && "toClass".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String describe(Object[] array) {
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < array.length; i++) {
            if (i != 0) {
                sb.append(", ");
            }
            Object o = array[i];
            if (o == null) {
                sb.append("null");
            } else {
                sb.append(o.getClass().getName()).append(':').append(String.valueOf(o));
            }
        }
        sb.append(']');
        return sb.toString();
    }
}
