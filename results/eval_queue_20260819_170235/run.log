public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "anchor-whole");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "anchor-empty");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet anchorSource = new PolygonsSet(-1.0, 1.0, -1.0, 1.0);
            exerciseLeafBoundaryAttribute(anchorSource, "anchor-rect");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());

            if (x1 == x2) {
                x2 = x1 + 1.0;
            }
            if (y1 == y2) {
                y2 = y1 + 1.0;
            }

            double minX = Math.min(x1, x2);
            double maxX = Math.max(x1, x2);
            double minY = Math.min(y1, y2);
            double maxY = Math.max(y1, y2);

            try {
                PolygonsSet source = new PolygonsSet(minX, maxX, minY, maxY);
                exerciseLeafBoundaryAttribute(source, "rect-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }

            try {
                double cx = finiteCoord(data.consumeInt());
                double cy = finiteCoord(data.consumeInt());
                double w = positiveSpan(data.consumeInt());
                double h = positiveSpan(data.consumeInt());
                PolygonsSet shifted = new PolygonsSet(cx - w, cx + w, cy - h, cy + h);
                exerciseLeafBoundaryAttribute(shifted, "shifted-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }
    }
