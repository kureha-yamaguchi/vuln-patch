package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchor();
        explorePatchedBoundary(data);
        checkHexDelegationOracle(data);
    }

    private static void runAnchor() {
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            try {
                NumberUtils.createNumber(badInputs[i]);
            } catch (IllegalArgumentException expected) {
                // Clean rejection is correct post-fix.
            } catch (RuntimeException t) {
                // The known buggy symptom is already covered elsewhere; do not re-report it here.
                if (!isKnownRootCause(t)) {
                    return;
                }
            }
        }
    }

    private static void explorePatchedBoundary(FuzzedDataProvider data) {
        String candidate;
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                candidate = String.valueOf(pickSuffix(data));
                break;
            case 1:
                candidate = data.consumeBoolean() ? "-" + pickSuffix(data) : "+" + pickSuffix(data);
                break;
            case 2:
                candidate = data.consumeAsciiString(3) + pickSuffix(data);
                break;
            case 3:
                candidate = data.consumeAsciiString(1) + pickSuffix(data);
                break;
            case 4:
                candidate = data.consumeRemainingAsString() + pickSuffix(data);
                break;
            default:
                String s = data.consumeAsciiString(2);
                candidate = s.length() == 0 ? String.valueOf(pickSuffix(data)) : s;
                break;
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (IllegalArgumentException expected) {
            // Correct fix may reject malformed strings with any validation exception in this family.
        } catch (RuntimeException t) {
            // Do not turn already-known crash-only behavior into a duplicate finding.
            if (!isKnownRootCause(t)) {
                return;
            }
        }
    }

    private static void checkHexDelegationOracle(FuzzedDataProvider data) {
        int magnitude = data.consumeInt(0, 1_000_000);
        boolean negative = data.consumeBoolean();
        boolean uppercase = data.consumeBoolean();

        String digits = Integer.toHexString(magnitude);
        if (uppercase) {
            digits = digits.toUpperCase();
        }

        String input = (negative ? "-" : "") + "0x" + digits;

        Number viaCreateNumber;
        Integer viaCreateInteger;
        try {
            viaCreateNumber = NumberUtils.createNumber(input);
            viaCreateInteger = NumberUtils.createInteger(input);
        } catch (RuntimeException t) {
            return;
        }

        if (!(viaCreateNumber instanceof Integer)) {
            throw new RuntimeException("[oracle:hex-delegate] metamorphic violation: createNumber must delegate hex input to createInteger input="
                    + input + " resultClass=" + (viaCreateNumber == null ? "null" : viaCreateNumber.getClass().getName()));
        }

        if (viaCreateNumber.intValue() != viaCreateInteger.intValue()) {
            throw new RuntimeException("[oracle:hex-delegate] metamorphic violation: equivalent real-library parsers disagree input="
                    + input + " lhs=" + viaCreateNumber + " rhs=" + viaCreateInteger);
        }

        // The code path shown for createNumber explicitly returns createInteger(val)
        // for inputs starting with 0x or -0x, so both real-library calls must agree.
        String normalized = (negative ? "-" : "") + "0x" + digits.toLowerCase();
        try {
            Number n1 = NumberUtils.createNumber(input);
            Number n2 = NumberUtils.createNumber(normalized);
            if (n1 instanceof Integer && n2 instanceof Integer && n1.intValue() != n2.intValue()) {
                throw new RuntimeException("[oracle:hex-case] metamorphic violation: hex digit case changed parsed value input="
                        + input + " normalized=" + normalized + " lhs=" + n1 + " rhs=" + n2);
            }
        } catch (RuntimeException t) {
            // Exceptions mean the relation does not apply for this input.
        }
    }

    private static char pickSuffix(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 3)) {
            case 0:
                return 'l';
            case 1:
                return 'L';
            case 2:
                return 'f';
            default:
                return 'F';
        }
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.NumberUtils".equals(e.getClassName())
                    && "createNumber".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
