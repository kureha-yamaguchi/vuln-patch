        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (Character.isLetterOrDigit(ch) || ch == ' ' || ch == '_' || ch == '-' || ch == '.') {
                out.append(ch);
            }
        }
        if (out.length() == 0) {
            out.append('X');
        }
