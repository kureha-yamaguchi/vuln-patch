    private static Problem buildFuzzProblem(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 12);
        int constraintsCount = data.consumeInt(2, 8);

        double[] objective = new double[vars];
        objective[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            objective[i] = data.consumeInt(-3, 3);
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        double[] seedA = new double[vars];
        double[] seedB = new double[vars];

        int pivotCol = data.consumeInt(0, vars - 1);
        int commonCoeff = data.consumeInt(1, 8);
        int commonRhs = data.consumeInt(1, 20);

        for (int j = 0; j < vars; j++) {
            int v = data.consumeInt(0, 12);
            seedA[j] = v;
            seedB[j] = v;
        }
        seedA[pivotCol] = commonCoeff;
        seedB[pivotCol] = commonCoeff;

        if (allZero(seedA)) {
            seedA[pivotCol] = 1.0;
        }
        if (allZero(seedB)) {
            seedB[pivotCol] = 1.0;
        }

        constraints.add(new LinearConstraint(seedA, Relationship.GEQ, commonRhs));
        constraints.add(new LinearConstraint(seedB, Relationship.GEQ, commonRhs));

        for (int i = 2; i < constraintsCount; i++) {
            double[] coeffs = new double[vars];
            boolean makeMostlyPositive = data.consumeBoolean();
            for (int j = 0; j < vars; j++) {
                int raw = makeMostlyPositive ? data.consumeInt(0, 12) : data.consumeInt(-12, 12);
                coeffs[j] = raw;
            }
            if (allZero(coeffs)) {
                coeffs[data.consumeInt(0, vars - 1)] = 1.0;
            }

            Relationship rel;
            int choice = data.consumeInt(0, 2);
            if (choice == 0) {
                rel = Relationship.GEQ;
            } else if (choice == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }

            double rhs = data.consumeInt(-20, 20);
            if (rel == Relationship.GEQ && rhs == 0.0) {
                rhs = 1.0;
            }
            constraints.add(new LinearConstraint(coeffs, rel, rhs));
        }

        return new Problem(new LinearObjectiveFunction(objective, data.consumeInt(-5, 5)),
                constraints,
                data.consumeBoolean() ? GoalType.MAXIMIZE : GoalType.MINIMIZE,
                true);
