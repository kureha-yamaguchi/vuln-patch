private static void assertWholeGeometry(PolygonsSet poly, String label) {
        Vector2D[][] vertices = poly.getVertices();
        if (vertices == null || vertices.length != 0) {
            throw new RuntimeException("[oracle:whole-vertices] metamorphic violation: expected zero loops input="
                    + label + " loops=" + verticesSummary(vertices));
        }

        double size1 = poly.getSize();
        Vector2D bc1 = asVector(poly.getBarycenter());
        if (!Double.isInfinite(size1) || size1 < 0.0 || bc1 == null || !Double.isNaN(bc1.getX()) || !Double.isNaN(bc1.getY())) {
            throw new RuntimeException("[oracle:whole-geometry] metamorphic violation: expected whole-space geometry input="
                    + label + " size=" + size1 + " barycenter=" + pointToString(bc1));
