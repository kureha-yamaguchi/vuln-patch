package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorAndExploreInvalidSuffixes(data);
        runCanonicalIntegerConsistencyOracle(data);
    }

    private static void runAnchorAndExploreInvalidSuffixes(FuzzedDataProvider data) {
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            try {
                NumberUtils.createNumber(badInputs[i]);
            } catch (IllegalArgumentException e) {
                // Clean rejection of invalid input is correct post-fix behavior.
            } catch (RuntimeException e) {
                // The known buggy symptom is already covered elsewhere; this harness
                // uses the anchor only to reach the patched code and then relies on
                // the independent oracle below for a distinct signal.
                if (isOracleViolation(e)) {
                    throw e;
                }
            }
        }

        String suffixes = "lLfF";
        char suffix = suffixes.charAt(data.consumeInt(0, suffixes.length() - 1));
        int mode = data.consumeInt(0, 5);
        String fuzz = data.consumeAsciiString(12);

        String candidate;
        switch (mode) {
            case 0:
                candidate = String.valueOf(suffix);
                break;
            case 1:
                candidate = fuzz + suffix;
                break;
            case 2:
                candidate = "-" + fuzz + suffix;
                break;
            case 3:
                candidate = "." + fuzz + suffix;
                break;
            case 4:
                candidate = fuzz.length() == 0 ? String.valueOf(suffix) : fuzz.substring(0, 1) + suffix;
                break;
            default:
                candidate = data.consumeBoolean() ? ("0" + suffix) : ("00" + fuzz + suffix);
                break;
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (IllegalArgumentException e) {
            // Correct rejection.
        } catch (RuntimeException e) {
            if (isOracleViolation(e)) {
                throw e;
            }
        }
    }

    private static void runCanonicalIntegerConsistencyOracle(FuzzedDataProvider data) {
        int n = data.consumeInt(-1_000_000, 1_000_000);
        String s = Integer.toString(n);
        int defaultValue = (n == Integer.MAX_VALUE) ? Integer.MIN_VALUE : (n + 1);

        try {
            Number created = NumberUtils.createNumber(s);
            Integer asInteger = NumberUtils.createInteger(s);
            Long asLong = NumberUtils.createLong(s);
            int parsed1 = NumberUtils.stringToInt(s);
            int parsed2 = NumberUtils.stringToInt(s, defaultValue);

            if (created == null) {
                throw new RuntimeException("[oracle:int-consistency] metamorphic violation: createNumber returned null for canonical int input=" + s);
            }

            // Contract used: for a canonical decimal string created from a known int,
            // createNumber(String), createInteger(String), createLong(String), and both
            // stringToInt overloads are all parsing the same valid value. A throw-deleting
            // or branch-skipping patch in createNumber could avoid the known crash yet still
            // return a numerically inconsistent result; these independent real-library parses
            // must agree on the same quantity for every correct implementation.
            int createdInt = created.intValue();
            long createdLong = created.longValue();

            if (createdInt != n || createdLong != (long) n) {
                throw new RuntimeException(
                    "[oracle:int-consistency] metamorphic violation: createNumber disagrees with constructed input input="
                        + s + " expected=" + n + " intValue=" + createdInt + " longValue=" + createdLong);
            }
            if (asInteger.intValue() != n) {
                throw new RuntimeException(
                    "[oracle:int-consistency] metamorphic violation: createInteger disagrees input="
                        + s + " expected=" + n + " got=" + asInteger);
            }
            if (asLong.longValue() != (long) n) {
                throw new RuntimeException(
                    "[oracle:int-consistency] metamorphic violation: createLong disagrees input="
                        + s + " expected=" + n + " got=" + asLong);
            }
            if (parsed1 != n || parsed2 != n) {
                throw new RuntimeException(
                    "[oracle:int-consistency] metamorphic violation: stringToInt overloads disagree input="
                        + s + " expected=" + n + " parsed1=" + parsed1 + " parsed2=" + parsed2);
            }
            if (createdInt != asInteger.intValue() || createdLong != asLong.longValue() || createdInt != parsed1 || createdInt != parsed2) {
                throw new RuntimeException(
                    "[oracle:int-consistency] metamorphic violation: parser family disagreement input="
                        + s + " createNumber=" + created + " createInteger=" + asInteger + " createLong=" + asLong
                        + " stringToInt=" + parsed1 + " stringToIntDefault=" + parsed2);
            }
        } catch (IllegalArgumentException e) {
            // If any library method rejects unexpectedly, skip rather than misclassify.
        } catch (RuntimeException e) {
            if (isOracleViolation(e)) {
                throw e;
            }
        }
    }

    private static boolean isOracleViolation(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
}
