                Vector3D v1 = (Vector3D) bc1;
                Vector3D v2 = (Vector3D) bc2;
                sameBary =
                        sameDouble(v1.getX(), v2.getX()) &&
                        sameDouble(v1.getY(), v2.getY()) &&
                        sameDouble(v1.getZ(), v2.getZ());
            } else {
                sameBary = (bc1 == bc2) || (bc1 != null && bc1.equals(bc2));
