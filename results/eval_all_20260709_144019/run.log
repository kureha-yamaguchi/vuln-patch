    private static Day dayFromOrdinal(int ord) {
        int day = (ord % 28) + 1;
        int month = ((ord / 28) % 12) + 1;
        int year = 2000 + (ord / (28 * 12));
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i < ords.length - 1; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static void assertEquivalent(TimeSeries a, TimeSeries b, String what) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: " + what + " null result");
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: " + what + " itemCount lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            if (!a.getTimePeriod(i).equals(b.getTimePeriod(i))) {
                throw new RuntimeException(
                    "metamorphic violation: " + what + " period mismatch at " + i + " lhs=" + a.getTimePeriod(i)
                        + " rhs=" + b.getTimePeriod(i));
            }
        }
    }

    private static boolean isValidationFamily(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.indexOf("SeriesException") >= 0 || name.indexOf("Validation") >= 0 || name.indexOf("Invalid") >= 0) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException) {
                StackTraceElement[] st = cur.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    String cls = st[i].getClassName();
                    String method = st[i].getMethodName();
                    if ("org.jfree.data.time.TimeSeries".equals(cls)) {
                        if ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method)) {
                            return true;
                        }
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }
