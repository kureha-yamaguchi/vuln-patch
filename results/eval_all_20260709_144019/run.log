                mant = "0";
            }
            if (frac.length() == 0) {
                frac = "0";
            }
            char suffix = data.consumeBoolean() ? 'f' : 'F';
            input = mant + "." + frac + suffix;
        } else if (mode == 4) {
            String mant = data.consumeAsciiString(16);
            String exp = data.consumeAsciiString(8);
            if (mant.length() == 0) {
                mant = "1";
            }
            if (exp.length() == 0) {
                exp = "0";
            }
            char suffix = data.consumeBoolean() ? 'd' : 'D';
            input = mant + "E" + exp + suffix;
        } else {
            String hex = data.consumeAsciiString(16);
            if (hex.length() == 0) {
                hex = "0";
            }
            input = (data.consumeBoolean() ? "-0x" : "0x") + hex;
        }

        try {
            NumberUtils.createNumber(input);
        } catch (NumberFormatException e) {
            // Expected for many malformed fuzz inputs.
        }

        String extra = data.consumeRemainingAsString();
        if (extra != null && extra.length() > 0) {
            try {
                NumberUtils.createNumber(extra);
            } catch (NumberFormatException e) {
                // Expected.
            }
        }

        String numeric = data.consumeAsciiString(24);
        if (numeric.length() > 0) {
            boolean digitsOnly = true;
            for (int i = 0; i < numeric.length(); i++) {
                char c = numeric.charAt(i);
                if (c < '0' || c > '9') {
                    digitsOnly = false;
                    break;
                }
            }
            if (digitsOnly) {
                String base = (data.consumeBoolean() ? "-" : "") + numeric;
                try {
                    Number left = NumberUtils.createNumber(base + "l");
                    Number right = NumberUtils.createNumber(base + "L");
                    if (left == null ? right != null : !left.equals(right)) {
                        throw new RuntimeException("metamorphic violation: createNumber(x+'l') == createNumber(x+'L')");
                    }
                } catch (NumberFormatException e) {
                    // Skip when the library legitimately rejects the constructed input.
                }
            }
        }
    }
