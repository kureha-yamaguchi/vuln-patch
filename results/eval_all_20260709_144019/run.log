            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void exploreMalformedLeafAttributes(FuzzedDataProvider data) {
        Object attribute = buildMalformedAttribute(data);
        try {
            PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(attribute));
            if (data.consumeBoolean()) {
                set.getSize();
            } else {
                set.getBarycenter();
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static Object buildMalformedAttribute(FuzzedDataProvider data) {
        int choice = data.consumeInt(0, 4);
        switch (choice) {
            case 0:
                return new BoundaryAttribute<Euclidean2D>(null, null);
            case 1: {
                double x1 = finiteCoord(data);
                double y1 = finiteCoord(data);
                double x2 = finiteCoord(data);
                double y2 = finiteCoord(data);
                if (x1 == x2 && y1 == y2) {
                    x2 += 1.0;
                }
                return new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
            }
            case 2:
                return new Vector2D(finiteCoord(data), finiteCoord(data));
            case 3:
                return data.consumeAsciiString(16);
            default:
                return Integer.valueOf(data.consumeInt());
        }
    }

    private static double finiteCoord(FuzzedDataProvider data) {
        return data.consumeInt(-1000, 1000) / 16.0;
    }

    private static void assertLeafRegionContracts(FuzzedDataProvider data) {
        // Contract visible in PolygonsSet.computeGeometricalProperties:
        // when getVertices() is empty and the tree is a leaf,
        // Boolean.TRUE means whole space => size=+INF, barycenter=NaN;
        // otherwise => size=0, barycenter=(0,0).
        // A throw-deleting or bookkeeping-skipping patch would violate these observables.
        boolean wholeSpace = data.consumeBoolean();
