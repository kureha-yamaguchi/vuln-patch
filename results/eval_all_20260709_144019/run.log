        // values outside the default [0.0, 1.0] bounds.
        // Since getPaint() clamps out-of-range values, for every correct implementation:
        //   x < 0.0  => getPaint(x).equals(getPaint(0.0))
        //   x > 1.0  => getPaint(x).equals(getPaint(1.0))
        // This uses only real library calls on both sides.
        double candidate = buildOutOfRangeValue(data);
