        } catch (RuntimeException e) {
            if (isOurViolation(e)) {
                throw e;
            }
            // Any library exception means this input was rejected or hit unrelated noise;
            // per harness rules, skip the post-condition for that execution.
        }
    }

    private static void assertLeafEmptySpaceContract() {
        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));

            Vector2D[][] vertices = empty.getVertices();
            double size1 = empty.getSize();
            Vector2D bary1 = (Vector2D) empty.getBarycenter();
            double size2 = empty.getSize();
            Vector2D bary2 = (Vector2D) empty.getBarycenter();

            if (vertices == null || vertices.length != 0) {
                throw new RuntimeException(
                    "metamorphic violation: empty-leaf empty-space must expose zero vertex loops input=false verticesLength=" +
                    (vertices == null ? -1 : vertices.length));
            }
            if (size1 != 0.0d || size2 != 0.0d) {
                throw new RuntimeException(
                    "metamorphic violation: empty-space leaf must have zero size input=false lhs=" +
                    size1 + " rhs=" + size2);
            }
            if (bary1 == null || bary1.getX() != 0.0d || bary1.getY() != 0.0d ||
                bary2 == null || bary2.getX() != 0.0d || bary2.getY() != 0.0d) {
                throw new RuntimeException(
                    "metamorphic violation: empty-space leaf must have origin barycenter input=false lhs=(" +
                    (bary1 == null ? "null" : bary1.getX() + "," + bary1.getY()) + ") rhs=(" +
                    (bary2 == null ? "null" : bary2.getX() + "," + bary2.getY()) + ")");
            }
        } catch (RuntimeException e) {
            if (isOurViolation(e)) {
                throw e;
            }
        }
    }

    private static void exerciseLeafAttribute(Object attribute) {
        try {
            PolygonsSet poly = new PolygonsSet(new BSPTree<Euclidean2D>(attribute));
            poly.getVertices();
            poly.getSize();
            poly.getBarycenter();
        } catch (RuntimeException e) {
            if (isOurViolation(e)) {
                throw e;
            }
        }
    }

    private static boolean isOurViolation(RuntimeException e) {
        String message = e.getMessage();
        return message != null && message.startsWith("metamorphic violation:");
    }
}
