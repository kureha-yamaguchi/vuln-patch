package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorChecks();

        Chronology chrono = data.consumeBoolean() ? chronoSafeUtc() : chronoSafeLocal();
        MonthDay base = makeInterestingMonthDay(data.consumeInt(0, 9), chrono);

        int monthAmount = data.consumeInt(-12, 12);
        if (monthAmount != 0) {
            tryMonthsEquivalence(base, monthAmount);
        }

        int dayAmount = data.consumeInt(-40, 40);
        if (dayAmount != 0) {
            tryDaysEquivalence(base, dayAmount);
        }

        int chainedMonthAmount = data.consumeInt(-3, 3);
        if (chainedMonthAmount != 0) {
            tryStepwiseMonths(base, chainedMonthAmount);
        }

        int chainedDayAmount = data.consumeInt(-3, 3);
        if (chainedDayAmount != 0) {
            tryStepwiseDays(base, chainedDayAmount);
        }
    }

    private static void runAnchorChecks() {
        MonthDay leapUtc = new MonthDay(2, 29, chronoSafeUtc());
        MonthDay endOfMonthUtc = new MonthDay(3, 31, chronoSafeUtc());

        requireExpected(leapUtc, Operation.PLUS_MONTHS, -1, 1, 29, "testPlusMonths_int_negativeFromLeap");
        requireExpected(leapUtc, Operation.MINUS_DAYS, -1, 3, 1, "testMinusDays_int_negativeFromLeap");
        requireExpected(leapUtc, Operation.PLUS_MONTHS, 1, 3, 29, "testPlusMonths_int_fromLeap");
        requireExpected(endOfMonthUtc, Operation.PLUS_MONTHS, -1, 2, 29, "testPlusMonths_int_negativeEndOfMonthAdjust");
        requireExpected(endOfMonthUtc, Operation.MINUS_MONTHS, 1, 2, 29, "testMinusMonths_int_endOfMonthAdjust");
        requireExpected(leapUtc, Operation.MINUS_MONTHS, -1, 3, 29, "testMinusMonths_int_negativeFromLeap");
        requireExpected(leapUtc, Operation.MINUS_MONTHS, 1, 1, 29, "testMinusMonths_int_fromLeap");
        requireExpected(leapUtc, Operation.PLUS_DAYS, 1, 3, 1, "testPlusDays_int_fromLeap");
    }

    private static void requireExpected(MonthDay base, Operation op, int amount, int expectedMonth, int expectedDay, String label) {
        try {
            MonthDay result = apply(base, op, amount);
            if (result.getMonthOfYear() != expectedMonth || result.getDayOfMonth() != expectedDay) {
                throw new RuntimeException(
                    "metamorphic violation: documented MonthDay result mismatch label=" + label +
                    " base=" + describe(base) +
                    " op=" + op +
                    " amount=" + amount +
                    " actual=" + describe(result) +
                    " expected=" + expectedMonth + "-" + expectedDay);
            }
        } catch (RuntimeException t) {
            if (isValidationFamily(t) && passesThroughReachableRegion(t)) {
                throw new RuntimeException(
                    "metamorphic violation: valid MonthDay operation rejected label=" + label +
                    " base=" + describe(base) +
                    " op=" + op +
                    " amount=" + amount, t);
            }
            throw t;
        } catch (Error t) {
            if (passesThroughReachableRegion(t)) {
                throw new RuntimeException(
                    "metamorphic violation: valid MonthDay operation errored label=" + label +
                    " base=" + describe(base) +
                    " op=" + op +
                    " amount=" + amount, t);
            }
            throw t;
        }
    }

    private static void tryMonthsEquivalence(MonthDay base, int amount) {
        try {
            MonthDay lhs = base.plusMonths(amount);
            MonthDay rhs = base.minusMonths(-amount);
            if (!sameMonthDay(lhs, rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: plusMonths(a) == minusMonths(-a) base=" + describe(base) +
                    " amount=" + amount +
                    " lhs=" + describe(lhs) +
                    " rhs=" + describe(rhs));
            }
        } catch (Throwable t) {
            if (isValidationFamily(t) || t instanceof ArithmeticException) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
        }
    }

    private static void tryDaysEquivalence(MonthDay base, int amount) {
        try {
            MonthDay lhs = base.plusDays(amount);
            MonthDay rhs = base.minusDays(-amount);
            if (!sameMonthDay(lhs, rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: plusDays(a) == minusDays(-a) base=" + describe(base) +
                    " amount=" + amount +
                    " lhs=" + describe(lhs) +
                    " rhs=" + describe(rhs));
            }
        } catch (Throwable t) {
            if (isValidationFamily(t) || t instanceof ArithmeticException) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
        }
    }

    private static void tryStepwiseMonths(MonthDay base, int amount) {
        try {
            MonthDay direct = base.plusMonths(amount);
            MonthDay stepped = base;
            int step = amount > 0 ? 1 : -1;
            for (int i = 0; i < Math.abs(amount); i++) {
                stepped = stepped.plusMonths(step);
            }
            if (!sameMonthDay(direct, stepped)) {
                throw new RuntimeException(
                    "metamorphic violation: plusMonths(a) matches repeated plusMonths(sign(a)) base=" + describe(base) +
                    " amount=" + amount +
                    " direct=" + describe(direct) +
                    " stepped=" + describe(stepped));
            }
        } catch (Throwable t) {
            if (isValidationFamily(t) || t instanceof ArithmeticException) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
        }
    }

    private static void tryStepwiseDays(MonthDay base, int amount) {
        try {
            MonthDay direct = base.plusDays(amount);
            MonthDay stepped = base;
            int step = amount > 0 ? 1 : -1;
            for (int i = 0; i < Math.abs(amount); i++) {
                stepped = stepped.plusDays(step);
            }
            if (!sameMonthDay(direct, stepped)) {
                throw new RuntimeException(
                    "metamorphic violation: plusDays(a) matches repeated plusDays(sign(a)) base=" + describe(base) +
                    " amount=" + amount +
                    " direct=" + describe(direct) +
                    " stepped=" + describe(stepped));
            }
        } catch (Throwable t) {
            if (isValidationFamily(t) || t instanceof ArithmeticException) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
        }
    }

    private static MonthDay apply(MonthDay base, Operation op, int amount) {
        switch (op) {
            case PLUS_MONTHS:
                return base.plusMonths(amount);
            case MINUS_MONTHS:
                return base.minusMonths(amount);
            case PLUS_DAYS:
                return base.plusDays(amount);
            case MINUS_DAYS:
                return base.minusDays(amount);
            default:
                throw new RuntimeException("unexpected operation");
        }
    }

    private static MonthDay makeInterestingMonthDay(int selector, Chronology chrono) {
        switch (selector) {
            case 0:
                return new MonthDay(2, 29, chrono);
            case 1:
                return new MonthDay(3, 31, chrono);
            case 2:
                return new MonthDay(1, 29, chrono);
            case 3:
                return new MonthDay(3, 29, chrono);
            case 4:
                return new MonthDay(1, 31, chrono);
            case 5:
                return new MonthDay(5, 31, chrono);
            case 6:
                return new MonthDay(7, 31, chrono);
            case 7:
                return new MonthDay(8, 31, chrono);
            case 8:
                return new MonthDay(10, 31, chrono);
            default:
                return new MonthDay(12, 31, chrono);
        }
    }

    private static boolean sameMonthDay(MonthDay a, MonthDay b) {
        return a.getMonthOfYear() == b.getMonthOfYear() && a.getDayOfMonth() == b.getDayOfMonth();
    }

    private static String describe(MonthDay md) {
        return md.getMonthOfYear() + "-" + md.getDayOfMonth();
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || t.getClass().getName().contains("IllegalFieldValue")
            || t.getClass().getName().contains("Invalid")
            || t.getClass().getName().contains("IllegalInstant");
    }

    private static boolean passesThroughReachableRegion(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.joda.time.MonthDay".equals(cls)
                    && ("withFieldAdded".equals(method) || "indexOfSupported".equals(method) || "<init>".equals(method))) {
                return true;
            }
            if ("getValues".equals(method) || "getField".equals(method) || "add".equals(method)) {
                if (cls.startsWith("org.joda.time.")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static Chronology chronoSafeUtc() {
        return org.joda.time.chrono.ISOChronology.getInstanceUTC();
    }

    private static Chronology chronoSafeLocal() {
        return org.joda.time.chrono.ISOChronology.getInstance();
    }

    private enum Operation {
        PLUS_MONTHS,
        MINUS_MONTHS,
        PLUS_DAYS,
        MINUS_DAYS
    }
}
