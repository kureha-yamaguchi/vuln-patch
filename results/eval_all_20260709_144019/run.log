package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1, 1, new int[0], new int[0]);
        int extraVars = data.consumeInt(0, 3);
        int coeff = data.consumeInt(1, 5);
        int rhs = data.consumeInt(1, 5);
        int[] leqExtra = new int[extraVars];
        int[] geqExtra = new int[extraVars];
        for (int i = 0; i < extraVars; i++) {
            leqExtra[i] = data.consumeInt(-3, 3);
            geqExtra[i] = data.consumeInt(-3, 3);
        }
        runCase(coeff, rhs, leqExtra, geqExtra);
    }

    private static void runCase(int coeff, int rhs, int[] leqExtra, int[] geqExtra) {
        int vars = 1 + leqExtra.length;
        double[] objective = new double[vars];
        objective[0] = 1.0;
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);

        double[] leq = new double[vars];
        double[] geq = new double[vars];
        leq[0] = coeff;
        geq[0] = coeff;
        for (int i = 1; i < vars; i++) {
            leq[i] = leqExtra[i - 1];
            geq[i] = geqExtra[i - 1];
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(leq, Relationship.LEQ, rhs));
        constraints.add(new LinearConstraint(geq, Relationship.GEQ, rhs));

        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, 10);

        Integer pivotCol = computePivotColumn(tableau);
        if (pivotCol == null) {
            return;
        }

        Integer expectedRow = computePatchedPivotRow(tableau, pivotCol.intValue(), 10);
        if (expectedRow == null) {
            return;
        }

        if (!hasArtificialTieCandidate(tableau, pivotCol.intValue(), 10)) {
            return;
        }

        SimplexSolver solver = new SimplexSolver();
        solver.doIteration(tableau);

        Integer actualRow = tableau.getBasicRow(pivotCol.intValue());

        if (!expectedRow.equals(actualRow)) {
            throw new RuntimeException(
                    "metamorphic violation: tied pivot row must follow Bland rule after ignoring artificial-variable shortcut; " +
                    "expectedRow=" + expectedRow +
                    " actualRow=" + actualRow +
                    " pivotCol=" + pivotCol +
                    " width=" + tableau.getWidth() +
                    " height=" + tableau.getHeight());
        }
    }

    private static Integer computePivotColumn(SimplexTableau tableau) {
        double minValue = 0.0;
        Integer minPos = null;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (entry < minValue) {
                minValue = entry;
                minPos = Integer.valueOf(i);
            }
        }
        return minPos;
    }

    private static Integer computePatchedPivotRow(SimplexTableau tableau, int col, int maxUlps) {
        ArrayList<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0.0, maxUlps) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions.clear();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }

        if (minRatioPositions.isEmpty()) {
            return null;
        }
        if (minRatioPositions.size() == 1) {
            return minRatioPositions.get(0);
        }

        Integer minRow = null;
        int minIndex = tableau.getWidth();
        for (Integer row : minRatioPositions) {
            int i = tableau.getNumObjectiveFunctions();
            for (; i < tableau.getWidth() - 1 && minRow != row; i++) {
                if (row.equals(tableau.getBasicRow(i))) {
                    if (i < minIndex) {
                        minIndex = i;
                        minRow = row;
                    }
                }
            }
        }
        return minRow;
    }

    private static boolean hasArtificialTieCandidate(SimplexTableau tableau, int col, int maxUlps) {
        ArrayList<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0.0, maxUlps) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions.clear();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }

        if (minRatioPositions.size() <= 1) {
            return false;
        }

        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                double entry = tableau.getEntry(row.intValue(), column);
                if (Precision.equals(entry, 1.0, maxUlps) && row.equals(tableau.getBasicRow(column))) {
                    return true;
                }
            }
        }
        return false;
    }
}
