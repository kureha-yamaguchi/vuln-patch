    private static boolean equalBigDecimalArrays(BigDecimal[] a, BigDecimal[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            BigDecimal x = a[i];
            BigDecimal y = b[i];
            if (x == null || y == null) {
                return false;
            }
            if (x.compareTo(y) != 0) {
                return false;
            }
        }
        return true;
    }

    private static boolean equalDoubleArrays(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (Double.doubleToLongBits(a[i]) != Double.doubleToLongBits(b[i])) {
                return false;
            }
        }
        return true;
    }

