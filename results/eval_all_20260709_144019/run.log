package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted below:
         * For a continuous distribution, cumulativeProbability(inverseCumulativeProbability(p))
         * should recover p for valid probabilities, and for NormalDistribution specifically
         * the failing regression test documents that inverseCumulativeProbability(0.9772498680518209)
         * equals 2.0 for N(0,1). A "fix" that merely deletes or bypasses the throw in bracket()
         * could return a wrong quantile instead of rejecting/solving correctly; these checks make
         * that observable.
         */

        // ANCHOR: exact regression input from the failing test.
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double p = 0.9772498680518209;
            double q = anchor.inverseCumulativeProbability(p);

            if (Math.abs(q - 2.0) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: anchor oracle input=" + p + " result=" + q + " expected=2.0");
            }

            try {
                double roundTrip = anchor.cumulativeProbability(q);
                if (Math.abs(roundTrip - p) > 1.0e-12) {
                    throw new RuntimeException("metamorphic violation: cdf(icdf(p)) input=" + p + " lhs=" + roundTrip + " rhs=" + p);
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (Throwable t) {
            boolean rootCause = false;
            for (Throwable c = t; c != null; c = c.getCause()) {
                if (c instanceof MathException) {
                    StackTraceElement[] st = c.getStackTrace();
                    if (st != null) {
                        for (int i = 0; i < st.length; i++) {
                            String cls = st[i].getClassName();
                            String m = st[i].getMethodName();
                            if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls) && "bracket".equals(m))
                                    || ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls) && "value".equals(m))
                                    || ("org.apache.commons.math.MathRuntimeException".equals(cls) && "createIllegalArgumentException".equals(m))
                                    || ("org.apache.commons.math.MathRuntimeException".equals(cls) && "buildMessage".equals(m))) {
                                rootCause = true;
                                break;
                            }
                        }
                    }
                }
                if (rootCause) {
                    break;
                }
            }
            if (rootCause) {
                throw (RuntimeException) new RuntimeException(t);
            }
            return;
        }

        // EXPLORE: generate many valid-by-construction NormalDistribution inputs with the same root-cause property:
        // choose x = mean + 2*sigma, compute p = CDF(x) via the real library, then ask the real inverse to recover x.
        int cases = 1;
        if (data.remainingBytes() > 0) {
            cases += data.consumeInt(0, 4);
        }

        for (int i = 0; i < cases; i++) {
            double mean = data.consumeInt(-1000, 1000) / 10.0;
            double sigma = data.consumeInt(1, 1000) / 100.0;
            if (sigma <= 0.0 || Double.isNaN(mean) || Double.isInfinite(mean) || Double.isNaN(sigma) || Double.isInfinite(sigma)) {
                continue;
            }

            try {
                NormalDistribution dist = new NormalDistributionImpl(mean, sigma);
                double x = mean + (2.0 * sigma);
                double p = dist.cumulativeProbability(x);

                if (Double.isNaN(p) || Double.isInfinite(p) || p <= 0.0 || p >= 1.0) {
                    continue;
                }

                double inv = dist.inverseCumulativeProbability(p);

                double tol = Math.max(1.0e-12, Math.abs(x) * 1.0e-12);
                if (Math.abs(inv - x) > tol) {
                    throw new RuntimeException("metamorphic violation: icdf(cdf(x)) mean=" + mean + " sigma=" + sigma + " x=" + x + " lhs=" + inv + " rhs=" + x);
                }

                try {
                    double roundTrip = dist.cumulativeProbability(inv);
                    if (Math.abs(roundTrip - p) > 1.0e-12) {
                        throw new RuntimeException("metamorphic violation: cdf(icdf(p)) mean=" + mean + " sigma=" + sigma + " p=" + p + " lhs=" + roundTrip + " rhs=" + p);
                    }
                } catch (Throwable ignored) {
                    return;
                }
            } catch (Throwable t) {
                boolean rootCause = false;
                for (Throwable c = t; c != null; c = c.getCause()) {
                    if (c instanceof MathException) {
                        StackTraceElement[] st = c.getStackTrace();
