package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            BooleanUtils.toBoolean("off");
        } catch (Throwable t) {
            boolean inTarget = false;
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                        && "toBoolean".equals(ste.getMethodName())) {
                    inTarget = true;
                    break;
                }
            }
            if (inTarget && t instanceof StringIndexOutOfBoundsException) {
                throw (StringIndexOutOfBoundsException) t;
            }
        }

        String fuzz = data.consumeString(32);

        String candidate1 = fuzz;
        String candidate2;
        {
            String s = data.consumeAsciiString(3);
            StringBuilder sb = new StringBuilder();
            while (sb.length() < 3) {
                sb.append('a');
            }
            if (s != null && s.length() > 0) {
                sb.setCharAt(0, s.charAt(0));
            } else {
