package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryCreateNumber(anchors[i]);
        }

        String candidate;
        switch (data.consumeInt(0, 8)) {
            case 0:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 2:
                candidate = data.consumeBoolean() ? "d" : "D";
                break;
            case 3:
                candidate = singleCharOrFallback(data.consumeAsciiString(1), data.consumeBoolean() ? "l" : "L");
                break;
            case 4:
                candidate = singleCharOrFallback(data.consumeString(1), data.consumeBoolean() ? "l" : "L");
                break;
            case 5:
                String rem = data.consumeRemainingAsString();
                if (rem.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                } else {
                    candidate = rem.substring(0, 1);
                }
                break;
            case 6:
                candidate = data.consumeAsciiString(16) + (data.consumeBoolean() ? "l" : "L");
                break;
            case 7:
                candidate = data.consumeAsciiString(16) + (data.consumeBoolean() ? "f" : "F");
                break;
            default:
                candidate = data.consumeAsciiString(16) + (data.consumeBoolean() ? "d" : "D");
                break;
        }
        tryCreateNumber(candidate);

        String raw = data.consumeAsciiString(32);
        String digits = digitsOnly(raw, false);
        String signedDigits = digitsOnly(raw, true);

        String[] explore = new String[] {
                raw,
                data.consumeBoolean() ? "l" : "L",
                data.consumeBoolean() ? "f" : "F",
                data.consumeBoolean() ? "d" : "D",
                signedDigits + (data.consumeBoolean() ? "l" : "L"),
                digits + digits + digits + (data.consumeBoolean() ? "l" : "L"),
                signedDigits + "." + nonEmptyDigits(digits) + (data.consumeBoolean() ? "f" : "F"),
                signedDigits + "." + nonEmptyDigits(digits) + "E" + digitsOnly(data.consumeAsciiString(8), true)
                        + (data.consumeBoolean() ? "d" : "D"),
                "0x" + hexOnly(data.consumeAsciiString(16)),
                "-0x" + hexOnly(data.consumeAsciiString(16)),
                "bobL",
                "junk"
        };
        for (int i = 0; i < explore.length; i++) {
            tryCreateNumber(explore[i]);
        }

        String integralBase = buildIntegralBase(data);
        try {
            Number lower = NumberUtils.createNumber(integralBase + "l");
            Number upper = NumberUtils.createNumber(integralBase + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + integralBase
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (IllegalArgumentException e) {
        } catch (RuntimeException e) {
            if (isOwnViolation(e)) {
                throw e;
            }
            if (isRootCause(e)) {
                return;
            }
        }

        String decimalBase = buildDecimalBase(data);
        try {
            Number lower = NumberUtils.createNumber(decimalBase + "f");
            Number upper = NumberUtils.createNumber(decimalBase + "F");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'f') != createNumber(x+'F') input=" + decimalBase
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (IllegalArgumentException e) {
        } catch (RuntimeException e) {
            if (isOwnViolation(e)) {
                throw e;
            }
            if (isRootCause(e)) {
                return;
            }
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (IllegalArgumentException e) {
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
