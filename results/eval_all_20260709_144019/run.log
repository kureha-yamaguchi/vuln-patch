            bigA = new BigMatrixImpl(makeBigData(data, rows, cols), false);
            realA = new RealMatrixImpl(makeRealData(data, rows, cols), false);
        } catch (IllegalArgumentException e) {
            return;
        }

        int bigRows = bigA.getRowDimension();
        int bigCols = bigA.getColumnDimension();
        int realRows = realA.getRowDimension();
        int realCols = realA.getColumnDimension();

        try {
            BigDecimal[] bigVec = makeBigVector(data, bigCols);
            double[] realVec = makeRealVector(data, realCols);

            BigDecimal[] bigOut = bigA.operate(bigVec);
            double[] realOut = realA.operate(realVec);

            if (bigOut.length != bigRows) {
                throw new RuntimeException("metamorphic violation: BigMatrixImpl operate result length");
            }
            if (realOut.length != realRows) {
                throw new RuntimeException("metamorphic violation: RealMatrixImpl operate result length");
            }
        } catch (IllegalArgumentException e) {
            return;
        }

        try {
            BigMatrixImpl bigI = identityBig(bigCols);
            RealMatrixImpl realI = identityReal(realCols);

            BigMatrixImpl bigProd = bigA.multiply(bigI);
            RealMatrixImpl realProd = realA.multiply(realI);

            if (bigProd.getRowDimension() != bigA.getRowDimension()
                    || bigProd.getColumnDimension() != bigA.getColumnDimension()) {
                throw new RuntimeException("metamorphic violation: BigMatrixImpl A*I dimensions");
            }
            if (realProd.getRowDimension() != realA.getRowDimension()
                    || realProd.getColumnDimension() != realA.getColumnDimension()) {
                throw new RuntimeException("metamorphic violation: RealMatrixImpl A*I dimensions");
            }

            for (int r = 0; r < bigRows; r++) {
                for (int c = 0; c < bigCols; c++) {
                    if (bigProd.getEntry(r, c).compareTo(bigA.getEntry(r, c)) != 0) {
                        throw new RuntimeException("metamorphic violation: BigMatrixImpl A*I == A");
                    }
                }
            }
            for (int r = 0; r < realRows; r++) {
                for (int c = 0; c < realCols; c++) {
                    if (realProd.getEntry(r, c) != realA.getEntry(r, c)) {
                        throw new RuntimeException("metamorphic violation: RealMatrixImpl A*I == A");
                    }
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        }
    }
