    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistribution standard = new NormalDistributionImpl(0.0, 1.0);

        // ANCHOR: exact failing-test input first, through the real public API.
        // Contract/oracle: for the standard normal distribution, inverseCumulativeProbability(p)
        // returns the x such that cumulativeProbability(x) = p. The regression test establishes
        // that this exact p corresponds to x = 2.0.
        final double anchorP = 0.9772498680518209d;
        try {
            double anchorQ = standard.inverseCumulativeProbability(anchorP);
            if (Math.abs(anchorQ - 2.0d) > 1.0e-12d) {
                throw new IllegalStateException(
                        "oracle violation: standard normal icdf exact anchor input=" + anchorP +
                        " expected=2.0 actual=" + anchorQ);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (hasBracketPath(t)) {
                throw new IllegalStateException(
                        "valid standard-normal icdf rejected for exact anchor p=" + anchorP, t);
