                TimeSeries emptyCloneCopy = series.createCopy(beforeFirst, beforeFirst);
                if (emptyCloneCopy == null) {
                    throw new RuntimeException("null clone-path copy");
                }
                if (emptyCloneCopy.getItemCount() != 0) {
                    throw new RuntimeException("metamorphic violation: before-first copy must be empty");
                }
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        int gapLeft = -1;
        for (int i = 0; i < ords.length - 1; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                gapLeft = i;
                break;
            }
        }
        if (gapLeft == -1) {
            return;
        }

        int leftOrd = ords[gapLeft];
        int rightOrd = ords[gapLeft + 1];
        int gapStartOrd = data.consumeInt(leftOrd + 1, rightOrd - 1);
        int gapEndOrd = data.consumeInt(gapStartOrd, rightOrd - 1);

        Day gapStart = dayFromOrdinal(gapStartOrd);
        Day gapEnd = dayFromOrdinal(gapEndOrd);

        series.getIndex(gapStart);
        series.getIndex(gapEnd);

        try {
            TimeSeries gapCopy = series.createCopy(gapStart, gapEnd);
            if (gapCopy == null) {
                throw new RuntimeException("null gap copy");
            }

            if (rightOrd - leftOrd >= 3) {
                int gapStartOrd2 = data.consumeInt(leftOrd + 1, rightOrd - 1);
                int gapEndOrd2 = data.consumeInt(gapStartOrd2, rightOrd - 1);

                Day gapStart2 = dayFromOrdinal(gapStartOrd2);
                Day gapEnd2 = dayFromOrdinal(gapEndOrd2);

                series.getIndex(gapStart2);
                series.getIndex(gapEnd2);

