package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkDeleteThenIndex("onetwo", "three");

        int prefixLen = data.consumeInt(0, 64);
        int needleLen = data.consumeInt(1, 32);

        char prefixChar = mappedChar(data.consumeByte());
        char needleChar = mappedChar(data.consumeByte());
        if (prefixChar == needleChar) {
            needleChar = prefixChar == 'a' ? 'b' : 'a';
        }

        String prefix = repeat(prefixChar, prefixLen);
        String needle = repeat(needleChar, needleLen);
        checkDeleteThenIndex(prefix, needle);

        String fuzzPrefix = data.consumeAsciiString(48);
        String fuzzNeedle = data.consumeAsciiString(16);
        if (fuzzNeedle.length() == 0) {
            fuzzNeedle = "X";
        }
        if (fuzzPrefix.indexOf(fuzzNeedle) == -1) {
            checkDeleteThenIndex(fuzzPrefix, fuzzNeedle);
        }
    }

    private static void checkDeleteThenIndex(String prefix, String needle) {
        if (needle.length() == 0) {
            return;
        }
        if (prefix.indexOf(needle) != -1) {
            return;
        }

        StrBuilder sb = new StrBuilder(prefix + needle);
        sb.deleteFirst(needle);

        int idx = sb.indexOf(needle);
        String actual = sb.toString();

        /*
         * Contract/post-condition:
         * The builder starts as prefix + needle, with prefix constructed so it does
         * not already contain needle. Therefore there is exactly one occurrence of
         * needle, at the end. After deleteFirst(needle), the logical contents must
         * be exactly prefix, so indexOf(needle) must return -1.
         *
         * The buggy indexOf reads stale characters from the backing buffer beyond
         * the current logical length and may incorrectly report the deleted suffix
         * as still present. The fixed code adds the missing logical-length check.
         */
        if (!prefix.equals(actual)) {
            throw new RuntimeException(
                "metamorphic violation: deleteFirst changed contents incorrectly; prefix="
                    + prefix + " needle=" + needle + " actual=" + actual);
        }
        if (idx != -1) {
            throw new RuntimeException(
                "metamorphic violation: deleted unique suffix still found; prefix="
                    + prefix + " needle=" + needle + " index=" + idx + " actual=" + actual);
        }
    }

    private static char mappedChar(byte b) {
        return (char) ('A' + ((b & 0xFF) % 26));
    }

    private static String repeat(char c, int len) {
        StringBuffer sb = new StringBuffer(len);
        for (int i = 0; i < len; i++) {
            sb.append(c);
        }
        return sb.toString();
    }
