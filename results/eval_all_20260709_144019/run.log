package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        java.util.function.Predicate<Throwable> isRootCause = t -> {
            if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
                return false;
            }
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.apache.commons.lang.text.StrBuilder".equals(ste.getClassName())
                        && "appendFixedWidthPadRight".equals(ste.getMethodName())) {
                    return true;
                }
            }
            return false;
        };

        java.util.function.Predicate<Throwable> isCleanRejection = t -> {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            String name = t.getClass().getName().toLowerCase(java.util.Locale.ROOT);
            return name.contains("invalid") || name.contains("validation");
        };

        // ANCHOR: exact failing test input first.
        try {
            StrBuilder sb = new StrBuilder(1);
            sb.appendFixedWidthPadRight("foo", 1, '-');

            // Contract asserted: appendFixedWidthPadRight appends exactly width characters:
            // - if the string is longer than width, it appends the leftmost width chars;
            // - otherwise it appends the string then right-pads with padChar.
            // A throw-deleting / branch-skipping patch would violate this observable result.
            String actual = sb.toString();
            String expected = "f";
            if (!expected.equals(actual)) {
                throw new RuntimeException("metamorphic violation: anchor contract input=obj=foo,width=1,pad=- lhs="
                        + actual + " rhs=" + expected);
            }
        } catch (RuntimeException t) {
            if (isRootCause.test(t)) {
                throw t;
            }
            if (!isCleanRejection.test(t)) {
                // Swallow unrelated runtime failures to avoid false positives outside this patch.
            }
        }

        // EXPLORE: vary the real inputs that exercise the same code path.
        // Root-cause property: positive width plus a small initial capacity can make the buggy
        // ensureCapacity(size + 5) insufficient for copying width chars.
        int initialCapacity = data.consumeInt(0, 8);
        int prefixLen = data.consumeInt(0, 8);
        String prefix = data.consumeString(prefixLen);
        boolean useNullObj = data.consumeBoolean();
        String obj = useNullObj ? null : data.consumeString(64);
        int width = data.consumeInt(1, 64);
        char pad = (char) (data.consumeByte() & 0xff);

        try {
            StrBuilder sb = new StrBuilder(initialCapacity);
            if (prefix.length() > 0) {
                sb.append(prefix);
            }
            int oldLen = sb.length();

            sb.appendFixedWidthPadRight(obj, width, pad);

            // Post-condition from the method contract:
            // for width > 0, length increases by exactly width and the appended segment is the
            // truncated-or-right-padded form of the input object's string value.
            // If this call throws, the check does not apply and is skipped by the catch below.
            String nullText = sb.getNullText();
            String src = (obj == null ? nullText : obj.toString());

            // If null text is itself null, the implementation will dereference it; do not assert.
            if (src != null) {
                String expectedAppended;
                if (src.length() >= width) {
                    expectedAppended = src.substring(0, width);
                } else {
                    StringBuilder tmp = new StringBuilder(width);
                    tmp.append(src);
                    while (tmp.length() < width) {
                        tmp.append(pad);
                    }
                    expectedAppended = tmp.toString();
                }

                String actual = sb.toString();
                if (actual.length() != oldLen + width) {
                    throw new RuntimeException("metamorphic violation: length-growth input=cap=" + initialCapacity
                            + ",prefix=" + prefix + ",obj=" + String.valueOf(obj) + ",width=" + width + ",pad="
                            + (int) pad + " lhs=" + actual.length() + " rhs=" + (oldLen + width));
                }
                String actualAppended = actual.substring(oldLen);
                if (!expectedAppended.equals(actualAppended)) {
                    throw new RuntimeException("metamorphic violation: appendFixedWidthPadRight contract input=cap="
                            + initialCapacity + ",prefix=" + prefix + ",obj=" + String.valueOf(obj) + ",width="
                            + width + ",pad=" + (int) pad + " lhs=" + actualAppended + " rhs=" + expectedAppended);
                }
            }
        } catch (RuntimeException t) {
            if (isRootCause.test(t)) {
                throw t;
            }
            if (!isCleanRejection.test(t)) {
                // Swallow unrelated exceptions so only the verified root cause is reported.
            }
        }

        // Additional exploration biased toward the insufficient-capacity scenario.
        int smallCap = data.consumeInt(0, 2);
        int existingLen = data.consumeInt(0, 3);
        String existing = data.consumeAsciiString(existingLen);
        String longObj = data.consumeAsciiString(96);
        if (longObj.length() == 0) {
            longObj = "A";
        }
        int wide = data.consumeInt(6, 96);

        try {
            StrBuilder sb = new StrBuilder(smallCap);
            if (existing.length() > 0) {
                sb.append(existing);
            }
            int oldLen = sb.length();

            sb.appendFixedWidthPadRight(longObj, wide, 'X');

            // Same documented contract check as above.
            String expectedAppended;
            if (longObj.length() >= wide) {
                expectedAppended = longObj.substring(0, wide);
            } else {
                StringBuilder tmp = new StringBuilder(wide);
                tmp.append(longObj);
                while (tmp.length() < wide) {
                    tmp.append('X');
                }
                expectedAppended = tmp.toString();
            }

            String actual = sb.toString();
            if (actual.length() != oldLen + wide) {
                throw new RuntimeException("metamorphic violation: biased-length-growth input=cap=" + smallCap
                        + ",existing=" + existing + ",obj=" + longObj + ",width=" + wide + " lhs="
                        + actual.length() + " rhs=" + (oldLen + wide));
            }
            String actualAppended = actual.substring(oldLen);
            if (!expectedAppended.equals(actualAppended)) {
                throw new RuntimeException("metamorphic violation: biased-contract input=cap=" + smallCap
                        + ",existing=" + existing + ",obj=" + longObj + ",width=" + wide + " lhs="
                        + actualAppended + " rhs=" + expectedAppended);
            }
        } catch (RuntimeException t) {
            if (isRootCause.test(t)) {
                throw t;
            }
            if (!isCleanRejection.test(t)) {
                // Swallow unrelated exceptions.
            }
        }
    }
