public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // In computeGeometricalProperties, when getVertices() is empty (leaf tree, no cut),
        // a leaf with Boolean.TRUE "covers the whole space" and must set:
        //   size = +Infinity, barycenter = Vector2D.NaN
        // while Boolean.FALSE must set:
        //   size = 0, barycenter = (0, 0).
        // A patch that merely suppresses the bad cast or guards the branch incorrectly
        // breaks this observable API behaviour without throwing.

        assertLeafWholeSpaceContract();
        assertLeafEmptySpaceContract();

        // ANCHOR/EXPLORE for the root-cause property:
        // reach the patched branch with many leaf trees whose cut is null and whose
        // attribute varies, including malformed non-Boolean attributes.
        // Any exception here is treated as rejection/non-target noise for this harness;
        // this harness wins via the post-condition above.
