    private static void metamorphicCategoryDomain(String label) {
        CategoryPlot plot = new CategoryPlot();
        CategoryMarker marker = new CategoryMarker(label);

        try {
            plot.addDomainMarker(marker);
            boolean first = plot.removeDomainMarker(marker);
            boolean second = plot.removeDomainMarker(marker);

