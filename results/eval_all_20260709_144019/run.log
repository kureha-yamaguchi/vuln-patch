public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1234.5");

        boolean negative = data.consumeBoolean();
        int intLen = data.consumeInt(0, 12);
        int fracLen = data.consumeInt(0, 12);
        boolean trailingType = data.consumeBoolean();
        int suffixMode = data.consumeInt(0, 2);

        String intSrc = data.consumeAsciiString(intLen);
        String fracSrc = data.consumeAsciiString(fracLen);

        StringBuilder sb = new StringBuilder();
        if (negative) {
            sb.append('-');
        }

        if (intSrc.length() == 0) {
            sb.append('0');
        } else {
            for (int i = 0; i < intSrc.length(); i++) {
                sb.append((char) ('0' + (intSrc.charAt(i) % 10)));
            }
        }

        sb.append('.');

        if (fracSrc.length() == 0) {
            sb.append('0');
        } else {
            for (int i = 0; i < fracSrc.length(); i++) {
                sb.append((char) ('0' + (fracSrc.charAt(i) % 10)));
            }
        }

        if (trailingType) {
            if (suffixMode == 0) {
                sb.append('D');
            } else if (suffixMode == 1) {
                sb.append('d');
            } else {
                sb.append('F');
            }
        }

        String candidate = sb.toString();
        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException expected) {
        }

        String wholeDigits = digitize(data.consumeAsciiString(data.consumeInt(0, 18)));
        String fracDigits = digitize(data.consumeAsciiString(data.consumeInt(0, 18)));
        if (wholeDigits.length() == 0) {
            wholeDigits = "0";
        }
        if (fracDigits.length() == 0) {
            fracDigits = "0";
        }

        String candidate2 = (data.consumeBoolean() ? "-" : "") + wholeDigits + "." + fracDigits;
        try {
            Number parsed = NumberUtils.createNumber(candidate2);
            Number parsedD = NumberUtils.createNumber(candidate2 + "D");
            if (parsed != null && parsedD != null && parsed.doubleValue() != parsedD.doubleValue()) {
                throw new RuntimeException("metamorphic violation: decimal and decimal+D should denote same value");
            }
        } catch (NumberFormatException expected) {
        }
    }
