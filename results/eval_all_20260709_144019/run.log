package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.joda.time.chrono.ISOChronology;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorInputs();

        int scenario = data.consumeInt(0, 5);
        int amount = data.consumeInt(-48, 48);
        if (amount == 0) {
            amount = data.consumeBoolean() ? 1 : -1;
        }

        MonthDay base;
        switch (scenario) {
            case 0:
                base = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
                checkMonthArithmetic(base, amount);
                break;
            case 1:
                base = new MonthDay(3, 31, ISOChronology.getInstanceUTC());
                checkMonthArithmetic(base, amount);
                break;
            case 2:
                base = new MonthDay(1, 31, ISOChronology.getInstanceUTC());
                checkMonthArithmetic(base, amount);
                break;
            case 3:
                base = new MonthDay(2, 29, ISOChronology.getInstanceUTC());
                checkDayArithmetic(base, amount);
                break;
            case 4:
                base = constructValidMonthDay(data);
                checkMonthArithmetic(base, amount);
                break;
            default:
                base = constructValidMonthDay(data);
                checkDayArithmetic(base, amount);
                break;
        }

        if (data.remainingBytes() > 0) {
            int directAmount = data.consumeInt(-48, 48);
            DurationFieldType fieldType = data.consumeBoolean() ? DurationFieldType.months() : DurationFieldType.days();
            MonthDay directBase = scenario % 2 == 0
                    ? new MonthDay(2, 29, ISOChronology.getInstanceUTC())
                    : new MonthDay(3, 31, ISOChronology.getInstanceUTC());
            checkDirectWithFieldAdded(directBase, fieldType, directAmount);
        }
    }

    private static void runAnchorInputs() {
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "plusMonths",
                -1,
                new MonthDay(1, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "plusMonths",
                1,
                new MonthDay(3, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "minusMonths",
                1,
                new MonthDay(1, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "minusMonths",
                -1,
                new MonthDay(3, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(3, 31, ISOChronology.getInstanceUTC()),
                "plusMonths",
                -1,
                new MonthDay(2, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(3, 31, ISOChronology.getInstanceUTC()),
                "minusMonths",
                1,
                new MonthDay(2, 29, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "plusDays",
                1,
                new MonthDay(3, 1, ISOChronology.getInstance())
        );
        anchorExpected(
                new MonthDay(2, 29, ISOChronology.getInstanceUTC()),
                "minusDays",
                -1,
                new MonthDay(3, 1, ISOChronology.getInstance())
        );
    }

    private static void anchorExpected(MonthDay base, String op, int amount, MonthDay expected) {
        try {
            MonthDay actual = apply(base, op, amount);
            if (!expected.equals(actual)) {
                throw new RuntimeException(
                        "anchor mismatch op=" + op +
                        " amount=" + amount +
                        " base=" + base +
                        " expected=" + expected +
                        " actual=" + actual);
            }
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                if (stackTouchesPatchedRegion(ex)) {
                    throw new RuntimeException(
                            "valid MonthDay arithmetic rejected op=" + op +
                            " amount=" + amount +
                            " base=" + base +
                            " rejection=" + ex.getClass().getName(),
                            ex);
                }
                return;
            }
            throw ex;
        }
    }

    private static void checkMonthArithmetic(MonthDay base, int amount) {
        MonthDay lhs;
        MonthDay rhs;
        try {
            lhs = base.plusMonths(amount);
            rhs = base.minusMonths(-amount);
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }

        /* Contract used for this metamorphic check:
           plusMonths(n) and minusMonths(-n) are equivalent public API operations.
           A "fix" that only suppresses the original throw or skips the real wrapped-add
           semantics can make both calls return a value, but the wrong value; then the
           two equivalent calls may disagree observably. */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                    "metamorphic violation: plusMonths(amount) != minusMonths(-amount) " +
                    "base=" + base + " amount=" + amount + " lhs=" + lhs + " rhs=" + rhs);
        }

        try {
            MonthDay roundTrip = lhs.minusMonths(amount);
            /* For these bases we construct valid MonthDay instances and only assert after
               both library calls succeed. A correct implementation should make adding n
               months and then subtracting n months recover the original MonthDay. */
            if (!base.equals(roundTrip)) {
                throw new RuntimeException(
                        "metamorphic violation: minusMonths is not inverse of plusMonths " +
                        "base=" + base + " amount=" + amount + " intermediate=" + lhs + " roundTrip=" + roundTrip);
            }
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }
    }

    private static void checkDayArithmetic(MonthDay base, int amount) {
        MonthDay lhs;
        MonthDay rhs;
        try {
            lhs = base.plusDays(amount);
            rhs = base.minusDays(-amount);
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }

        /* Contract used for this metamorphic check:
           plusDays(n) and minusDays(-n) are equivalent public API operations.
           If the patched wrapped-partial logic is bypassed or corrupted, one side can
           silently compute a different MonthDay even when no exception is thrown. */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                    "metamorphic violation: plusDays(amount) != minusDays(-amount) " +
                    "base=" + base + " amount=" + amount + " lhs=" + lhs + " rhs=" + rhs);
        }

        try {
            MonthDay roundTrip = lhs.minusDays(amount);
            if (!base.equals(roundTrip)) {
                throw new RuntimeException(
                        "metamorphic violation: minusDays is not inverse of plusDays " +
                        "base=" + base + " amount=" + amount + " intermediate=" + lhs + " roundTrip=" + roundTrip);
            }
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }
    }

    private static void checkDirectWithFieldAdded(MonthDay base, DurationFieldType fieldType, int amount) {
        MonthDay lhs;
        MonthDay rhs;
        try {
            lhs = base.withFieldAdded(fieldType, amount);
            rhs = base.withFieldAdded(fieldType, 0).withFieldAdded(fieldType, amount);
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }

        /* Contract used for this metamorphic check:
           withFieldAdded(field, 0) returns this, so composing a zero-add before a real
           add must not change the result. This directly exercises withFieldAdded while
           observing externally visible behavior after the patched line. */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                    "metamorphic violation: zero field-add changed result " +
                    "base=" + base + " field=" + fieldType + " amount=" + amount +
                    " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static MonthDay apply(MonthDay base, String op, int amount) {
        if ("plusMonths".equals(op)) {
            return base.plusMonths(amount);
        }
        if ("minusMonths".equals(op)) {
            return base.minusMonths(amount);
        }
        if ("plusDays".equals(op)) {
            return base.plusDays(amount);
        }
        return base.minusDays(amount);
    }

    private static MonthDay constructValidMonthDay(FuzzedDataProvider data) {
        int month = data.consumeInt(1, 12);
        int maxDay;
        switch (month) {
            case 2:
                maxDay = 29;
                break;
            case 4:
            case 6:
            case 9:
            case 11:
                maxDay = 30;
                break;
            default:
                maxDay = 31;
                break;
        }
        int day = data.consumeInt(1, maxDay);
        return new MonthDay(month, day, data.consumeBoolean() ? ISOChronology.getInstanceUTC() : ISOChronology.getInstance());
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.joda.time.Illegal");
