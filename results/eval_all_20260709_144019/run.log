        // supplied function and called solve(min, max), so any real non-null function
        // with a valid bracketing interval can reach the buggy NPE. Construct many such
        // intervals around k*pi, where sin has a guaranteed root.
        int k = data.consumeInt(-1000, 1000);
        double center = k * Math.PI;

        int leftScale = data.consumeInt(1, 1_000_000);
        int rightScale = data.consumeInt(1, 1_000_000);
        double leftDelta = leftScale / 1_000_000.0d;
        double rightDelta = rightScale / 1_000_000.0d;

        // Keep the bracket local to one root to avoid spanning multiple periods.
        if (leftDelta > 1.0d) {
            leftDelta = 1.0d;
        }
        if (rightDelta > 1.0d) {
            rightDelta = 1.0d;
        }

        double min = center - leftDelta;
        double max = center + rightDelta;
        if (min == max) {
            max = min + 1.0e-6d;
        }

        int pick = data.consumeInt(0, 1_000_000);
        double initial = min + (max - min) * (pick / 1_000_000.0d);
        runOne(f, min, max, initial, false);

        // More varied but still valid-by-construction intervals around another root.
        int k2 = data.consumeInt(-1000, 1000);
        double center2 = k2 * Math.PI;
        double width = (data.consumeInt(1, 500_000) / 1_000_000.0d) + 1.0e-6d;
        double min2 = center2 - width;
        double max2 = center2 + width;
        double initial2;
        if (data.consumeBoolean()) {
            initial2 = center2;
        } else if (data.consumeBoolean()) {
            initial2 = min2;
        } else {
            initial2 = max2;
        }
        runOne(f, min2, max2, initial2, false);
    }

    private static void runOne(UnivariateRealFunction f, double min, double max, double initial, boolean anchor) {
        BisectionSolver solver = new BisectionSolver();

        try {
            double withInitial = solver.solve(f, min, max, initial);

            // Metamorphic/post-condition:
            // For BisectionSolver, the 4-arg overload should behave like the 3-arg overload
            // on the same function and interval. The patch itself implements this by delegating
            // solve(f, min, max, initial) to solve(f, min, max). A "fix" that merely suppresses
            // the crash or returns an unrelated value would violate this observable contract.
            try {
                BisectionSolver solver2 = new BisectionSolver();
                double withoutInitial = solver2.solve(f, min, max);
                double tol = Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy());
                if (!(Math.abs(withInitial - withoutInitial) <= tol)) {
                    throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                            + " input=min=" + min
                            + " max=" + max
                            + " initial=" + initial
                            + " lhs=" + withInitial
                            + " rhs=" + withoutInitial);
                }
            } catch (Throwable t) {
                // If either side throws, the relation does not apply to this input.
                return;
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
