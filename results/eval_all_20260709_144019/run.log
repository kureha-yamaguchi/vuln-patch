package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing-test trigger first.
        exerciseInvalidMean(-1.0d, true);

        // EXPLORE: the patched line is guarded by the property "mean <= 0".
        int selector = data.consumeInt(0, 7);
        double mean;
        switch (selector) {
            case 0:
                mean = 0.0d;
                break;
            case 1:
                mean = -0.0d;
                break;
            case 2:
                mean = -Math.abs((double) data.consumeInt());
                break;
            case 3:
                mean = -Math.abs((double) data.consumeByte());
                break;
            case 4:
                mean = -Math.abs((double) data.consumeInt(0, Integer.MAX_VALUE));
                break;
            case 5:
                mean = -1.0d * (1.0d + Math.abs((double) data.consumeInt(0, 1_000_000)));
                break;
            case 6:
                mean = data.consumeBoolean() ? 0.0d : -1.0d;
                break;
            default:
                mean = -Math.abs((double) data.remainingBytes());
                break;
        }
        exerciseInvalidMean(mean, false);

        // Post-condition / metamorphic check:
        // Contract visible from the failing test and the PoissonDistribution API usage:
        // for a positive mean, construction succeeds and getMean() returns that mean.
        // A "fix" that deletes bookkeeping/assignment or makes construction silently wrong
        // would violate this observable property even if no exception is thrown.
        double positiveMean = 1.0d + Math.abs((double) data.consumeInt(0, 1_000_000));
        double epsilon = 1.0e-12d + (double) (data.consumeInt(0, 1_000_000) + 1) / 1.0e12d;
        int maxIterations = Math.max(1, data.consumeInt(1, 1_000_000));

        try {
            PoissonDistribution a = new PoissonDistributionImpl(positiveMean);
            PoissonDistribution b = new PoissonDistributionImpl(positiveMean, epsilon, maxIterations);

            double lhs = a.getMean();
            double rhs = b.getMean();

            if (Double.doubleToLongBits(lhs) != Double.doubleToLongBits(positiveMean)) {
                throw new RuntimeException(
                    "metamorphic violation: positive constructor/getMean round-trip input="
                        + positiveMean + " lhs=" + lhs + " rhs=" + positiveMean);
            }
            if (Double.doubleToLongBits(rhs) != Double.doubleToLongBits(positiveMean)) {
                throw new RuntimeException(
                    "metamorphic violation: 3-arg constructor/getMean round-trip input="
                        + positiveMean + " lhs=" + rhs + " rhs=" + positiveMean
                        + " epsilon=" + epsilon + " maxIterations=" + maxIterations);
            }
            if (Double.doubleToLongBits(lhs) != Double.doubleToLongBits(rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: equivalent constructors disagree input="
                        + positiveMean + " lhs=" + lhs + " rhs=" + rhs
                        + " epsilon=" + epsilon + " maxIterations=" + maxIterations);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return;
        }
    }

    private static void exerciseInvalidMean(double mean, boolean anchor) {
        try {
            new PoissonDistributionImpl(mean);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            // Clean rejection on fixed versions: swallow.
            return;
        }

        // If invalid input is silently accepted, that's a semantic bug:
        // the constructor is required to reject non-positive means.
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(1.0d);
            if (dist == null) {
                throw new RuntimeException("metamorphic violation: unexpected null distribution");
            }
        } catch (Throwable ignored) {
            // Do not turn unrelated failures into findings.
        }

        throw new RuntimeException(
            "metamorphic violation: non-positive mean accepted mean=" + mean + " anchor=" + anchor);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }

        String className = t.getClass().getName();
        if (!className.startsWith("org.apache.commons.math.MathRuntimeException$")) {
            return false;
        }

        for (StackTraceElement ste : t.getStackTrace()) {
            String cn = ste.getClassName();
            String mn = ste.getMethodName();
            if (("org.apache.commons.math.MathRuntimeException".equals(cn)
                    && "createIllegalArgumentException".equals(mn))
                || ("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(cn)
                    && "<init>".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
