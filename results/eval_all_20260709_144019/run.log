package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact trigger from the regression test.
        runCase(f, Math.PI, 3.0, 3.2, 3.1, true);

        // EXPLORE: same root-cause property, but with many valid intervals and initials.
        // The buggy code ignores the provided function in the 4-arg overload, so any call
        // through this public API can hit the patched line. We build valid bracketing
        // intervals around known sin roots k*pi so a correct implementation is obliged to
        // solve them, not reject them as bad input.
        int k = data.consumeInt(-20, 20);
        double root = k * Math.PI;

        int leftScale = Math.abs(data.consumeInt());
        int rightScale = Math.abs(data.consumeInt());
        double leftWidth = 1.0e-6 + (leftScale % 1000000) / 1000000.0;
        double rightWidth = 1.0e-6 + (rightScale % 1000000) / 1000000.0;

        if (leftWidth > 1.0) {
            leftWidth = 1.0;
        }
        if (rightWidth > 1.0) {
            rightWidth = 1.0;
        }

        double min = root - leftWidth;
        double max = root + rightWidth;

        int selector = data.consumeInt(0, 4);
        double initial;
        switch (selector) {
            case 0:
                initial = root;
                break;
            case 1:
                initial = min;
                break;
            case 2:
                initial = max;
                break;
            case 3:
                initial = min + (max - min) * 0.25;
                break;
            default:
                initial = min + (max - min) * 0.75;
                break;
        }

        runCase(f, root, min, max, initial, true);
    }

    private static void runCase(UnivariateRealFunction f, double expectedRoot, double min, double max, double initial, boolean checkOracle) {
        BisectionSolver solver = new BisectionSolver();
        double result;
        try {
            result = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (!checkOracle) {
            return;
        }

        // Contract/oracle check:
        // We deliberately construct intervals [root-a, root+b] around a known root of sin(x),
        // namely expectedRoot = k*pi. A correct bisection solve on this valid bracketing input
        // must return a finite value within the interval and close to that known root.
        // A "fix" that merely deletes/skirts the failing path and returns an arbitrary value
        // would violate this observable post-condition.
        if (Double.isNaN(result) || Double.isInfinite(result)) {
            throw new RuntimeException("metamorphic violation: non-finite result input=[" + min + "," + max + "," + initial + "] result=" + result);
        }
        if (result < min || result > max) {
            throw new RuntimeException("metamorphic violation: result escaped interval input=[" + min + "," + max + "," + initial + "] result=" + result);
        }

        double tol = Math.max(solver.getAbsoluteAccuracy() * 4.0, 1.0e-6);
        if (Math.abs(result - expectedRoot) > tol) {
            throw new RuntimeException(
                "metamorphic violation: known sin root not recovered input=[" + min + "," + max + "," + initial + "] expected=" + expectedRoot + " actual=" + result
            );
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        String simple = t.getClass().getSimpleName();
        return name.contains("Convergence")
                || name.contains("Evaluation")
                || name.contains("MaxIterations")
                || name.contains("Math")
                || simple.contains("Argument")
                || simple.contains("Convergence")
                || simple.contains("Evaluation")
                || simple.contains("Iteration")
                || simple.contains("Value");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
