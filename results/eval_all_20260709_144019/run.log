        } catch (RuntimeException t) {
            if (isValidation(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            StringUtils.join(array, sepString, startIndex, endIndex);
        } catch (RuntimeException t) {
            if (isValidation(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /* Contract/metamorphic check:
         * Both overloads join(Object[], char, int, int) and join(Object[], String, int, int)
         * append the same elements in the same order and differ only in how the separator is
         * supplied. Therefore, for any valid input and separator c, using c and String.valueOf(c)
         * must produce identical results, including with null elements and empty strings.
         * A patch that merely suppresses the crashing path or skips intended appends would break
         * this equality without necessarily throwing.
