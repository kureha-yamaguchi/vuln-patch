private static void metamorphicLongSuffixCase(FuzzedDataProvider data) {
        int n = data.consumeInt();
        String base = Integer.toString(n);
        try {
            Number lower = NumberUtils.createNumber(base + "l");
            Number upper = NumberUtils.createNumber(base + "L");
            if (lower == null || upper == null) {
                return;
            }
            if (!lower.getClass().equals(upper.getClass()) || lower.longValue() != upper.longValue()) {
                throw new RuntimeException("metamorphic violation: createNumber(n + \"l\") != createNumber(n + \"L\")");
            }
        } catch (NumberFormatException e) {
        } catch (NullPointerException e) {
        }
    }
