        StringBuffer sb = new StringBuffer();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i > 0) {
                sb.append(',');
            }
            sb.append(a[i]);
        }
        sb.append(']');
        return sb.toString();
    }

    private static String doubleArrayToString(double[] a) {
        if (a == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
