        // For any integer k, sin(k*pi) = 0. Choosing min < k*pi < max guarantees a real root
        // inside the interval, and initial is chosen within [min, max].
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftScale = data.consumeInt(1, 1000);
        int rightScale = data.consumeInt(1, 1000);
        double left = leftScale / 1000.0;
        double right = rightScale / 1000.0;

        double min = root - left;
        double max = root + right;
        if (!(min < max) || Double.isNaN(min) || Double.isNaN(max) ||
                Double.isInfinite(min) || Double.isInfinite(max)) {
            return;
        }

        double initial;
        switch (data.consumeInt(0, 4)) {
            case 0:
                initial = min;
                break;
            case 1:
                initial = max;
                break;
            case 2:
                initial = root;
                break;
            case 3:
                initial = (min + max) / 2.0;
                break;
            default:
                int pos = data.consumeInt(0, 1000);
                initial = min + (max - min) * (pos / 1000.0);
                break;
        }

        runSolveAndPropagateRootCause(f, min, max, initial);

        // Metamorphic check:
        // Contract exercised by the patch: BisectionSolver.solve(f, min, max, initial)
        // should behave like solving the same function on the same interval, i.e. the
        // 4-arg overload must use the supplied function and compute the same root as the
        // 3-arg overload. A "fix" that merely suppresses the crash or returns a bogus value
        // would violate this equivalence.
        //
        // Hygiene rule: if either side throws anything, this check does not apply.
        try {
            BisectionSolver solverWithInitial = new BisectionSolver();
            double lhs = solverWithInitial.solve(f, min, max, initial);

            BisectionSolver solverNoInitial = new BisectionSolver();
            double rhs = solverNoInitial.solve(f, min, max);

            double tol = Math.max(solverWithInitial.getAbsoluteAccuracy(), solverNoInitial.getAbsoluteAccuracy());
            if (Double.isNaN(lhs) || Double.isNaN(rhs) || Math.abs(lhs - rhs) > tol) {
