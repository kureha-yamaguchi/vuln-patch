        int fracLen = data.consumeInt(0, 12);
        boolean trailingType = data.consumeBoolean();
        int suffixMode = data.consumeInt(0, 2);

        String intSrc = data.consumeAsciiString(intLen);
        String fracSrc = data.consumeAsciiString(fracLen);

