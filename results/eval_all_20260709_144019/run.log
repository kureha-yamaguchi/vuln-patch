package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression input from the failing test.
        runCase(f, 3.0, 3.2, 3.1, Math.PI, true);

        // EXPLORE:
        // Root-cause property: calling BisectionSolver.solve(f, min, max, initial)
        // with a real non-null function. On the buggy version, the 4-arg overload
        // drops f and dereferences internal null state. We generate many valid,
        // bracketed sine intervals around known roots k*pi so a correct solver is
        // obligated to accept them.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;
        double delta = data.consumeInt(1, 1000) / 1000.0; // (0, 1]
        double min = root - delta;
        double max = root + delta;
        double frac = data.consumeInt(0, 1000) / 1000.0;
        double initial = min + frac * (max - min);

        runCase(f, min, max, initial, root, true);

        // A second varied valid interval shape around another sine root.
        int k2 = data.consumeInt(-1000, 1000);
        double root2 = k2 * Math.PI;
        double left = data.consumeInt(1, 1500) / 2000.0;   // (0, 0.75]
        double right = data.consumeInt(1, 1500) / 2000.0;  // (0, 0.75]
        double min2 = root2 - left;
        double max2 = root2 + right;
        double frac2 = data.consumeInt(0, 1000) / 1000.0;
        double initial2 = min2 + frac2 * (max2 - min2);

        runCase(f, min2, max2, initial2, root2, true);
    }

    private static void runCase(UnivariateRealFunction f, double min, double max, double initial,
                                double expectedRoot, boolean checkOracle) {
        BisectionSolver solver4 = new BisectionSolver();
        double r4;
        try {
            r4 = solver4.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        // Contract/oracle:
        // For these inputs we construct a valid bracketing interval around the known
        // sine root expectedRoot = k*pi, with no other sine root inside since each side
        // is < pi. A correct bisection solve must therefore return that root within the
        // solver's advertised absolute accuracy. A "fix" that merely avoids the crash
        // but returns the initial guess / endpoint / stale state violates this.
        if (checkOracle) {
            double tol = Math.max(solver4.getAbsoluteAccuracy() * 4.0, 1.0e-8);
            if (Double.isNaN(r4) || Double.isInfinite(r4) || Math.abs(r4 - expectedRoot) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: known-root oracle input=[" + min + "," + max + "], initial=" + initial +
                    " expected=" + expectedRoot + " got=" + r4 + " tol=" + tol);
            }
        }

        BisectionSolver solver3 = new BisectionSolver();
        double r3;
        try {
            r3 = solver3.solve(f, min, max);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        // Contract/metamorphic relation:
        // BisectionSolver's 4-arg overload should solve the same problem as the 3-arg
        // overload for the same function and interval; for bisection, the initial guess
        // must not change the located root. A patch that simply skips the real solve or
        // returns some other value breaks this equivalence.
        double tolEq = Math.max(Math.max(solver4.getAbsoluteAccuracy(), solver3.getAbsoluteAccuracy()) * 4.0, 1.0e-8);
        if (Double.isNaN(r3) || Double.isInfinite(r3) || Math.abs(r4 - r3) > tolEq) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input=[" + min + "," + max +
                "], initial=" + initial + " lhs=" + r4 + " rhs=" + r3 + " tol=" + tolEq);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
            || name.contains("MathRuntimeException")
            || name.contains("NoBracketing")
            || name.contains("NotStrictlyPositive")
            || name.contains("NumberIsToo")
            || name.contains("IllegalArgument")
            || name.contains("Invalid");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
