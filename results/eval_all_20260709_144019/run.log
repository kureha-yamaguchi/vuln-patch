package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Contract asserted:
         * NumberUtils.createNumber is the public parser API and malformed numeric strings like "l"/"L"/"f"/"F"
         * are supposed to be rejected as invalid input, not crash with an internal StringIndexOutOfBoundsException.
         * A throw-deleting or branch-skipping patch could hide the original crash while still mishandling suffix
         * parsing, so we also assert a metamorphic relation for valid integral inputs:
         * createNumber(x+"l") and createNumber(x+"L") must parse to the same numeric result.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            assertCleanInvalidRejection(anchors[i]);
        }

        String candidate;
        switch (data.consumeInt(0, 7)) {
            case 0:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 2:
                candidate = data.consumeBoolean() ? "d" : "D";
                break;
            case 3:
                candidate = data.consumeAsciiString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 4:
                candidate = data.consumeString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 5:
                candidate = data.consumeRemainingAsString();
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                } else if (candidate.length() > 1) {
                    candidate = candidate.substring(candidate.length() - 1);
                }
                break;
            case 6:
                candidate = sanitizeNumericPrefix(data.consumeAsciiString(24), true, true)
                        + (data.consumeBoolean() ? "l" : "L");
                break;
            default:
                candidate = buildNumericCandidate(data);
                break;
        }
        tryCreateNumber(candidate);

        String oneCharSuffix = suffixOnly(data.consumeInt(0, 5));
        assertCleanInvalidRejection(oneCharSuffix);

        String base = buildIntegralCore(data);
        try {
            Number lower = NumberUtils.createNumber(base + "l");
            Number upper = NumberUtils.createNumber(base + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e instanceof RuntimeException && e.getClass() == RuntimeException.class) {
                throw e;
            }
            if (isRootCauseFromCreateNumber(e)) {
                return;
            }
        }

        String bigBase = repeatDigits(base, data.consumeInt(1, 3));
        if (isSignedDecimalDigits(bigBase)) {
            try {
                Number lower = NumberUtils.createNumber(bigBase + "l");
                Number upper = NumberUtils.createNumber(bigBase + "L");
                if (!sameNumber(lower, upper)) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(big+'l') != createNumber(big+'L') input=" + bigBase
                                    + " lhs=" + describe(lower) + " rhs=" + describe(upper));
                }
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    return;
                }
                if (e instanceof RuntimeException && e.getClass() == RuntimeException.class) {
                    throw e;
                }
                if (isRootCauseFromCreateNumber(e)) {
                    return;
                }
            }
        }
    }

    private static void assertCleanInvalidRejection(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw new RuntimeException(
                        "invalid input was not rejected cleanly: input=" + s + " throwable=" + t.getClass().getName(),
                        t);
            }
            return;
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.NumberUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("createNumber".equals(m) || "createInteger".equals(m) || "isAllZeros".equals(m)
                        || "isDigits".equals(m) || "createLong".equals(m) || "createBigInteger".equals(m)
                        || "createFloat".equals(m) || "createDouble".equals(m) || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("charAt".equals(m) || "substring".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static String suffixOnly(int mode) {
        switch (mode) {
            case 0:
                return "l";
            case 1:
                return "L";
            case 2:
                return "f";
