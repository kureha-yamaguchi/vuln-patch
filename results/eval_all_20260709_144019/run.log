                Vector3D b = new Vector3D(coords[ib], coords[ib + 1], coords[ib + 2]);
                Vector3D c = new Vector3D(coords[ic], coords[ic + 1], coords[ic + 2]);

                Plane plane = new Plane(a, b, c);
                Vector2D a2 = plane.toSubSpace(a);
                Vector2D b2 = plane.toSubSpace(b);
                Vector2D c2 = plane.toSubSpace(c);

                PolygonsSet triangle = new PolygonsSet(a2, b2, c2);
                facets.add(new SubPlane(plane, triangle));
            }

            PolyhedronsSet poly = new PolyhedronsSet(facets);

            double s1 = poly.getSize();
            org.apache.commons.math3.geometry.Point<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D> bc1 = poly.getBarycenter();

