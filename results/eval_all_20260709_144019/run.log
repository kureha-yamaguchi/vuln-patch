package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("off");

        exercise("oof");
        exercise("yep");
        exercise("tru");

        String base = data.consumeAsciiString(16);
        String candidate = forceLengthThree(base, data);
        candidate = forceFirstCharNotY(candidate, data);
        exercise(candidate);

        String bigger = data.consumeAsciiString(32);
        if (bigger.length() >= 3) {
            int start = data.consumeInt(0, bigger.length() - 3);
            String slice = bigger.substring(start, start + 3);
            slice = forceFirstCharNotY(slice, data);
            exercise(slice);
        }

        String candidateT = forceLengthThree(data.consumeAsciiString(8), data);
        candidateT = "t" + candidateT.substring(1);
        exercise(candidateT);

        String candidateUpperT = forceLengthThree(data.consumeAsciiString(8), data);
        candidateUpperT = "T" + candidateUpperT.substring(1);
        exercise(candidateUpperT);

        String metamorphicInput = data.consumeAsciiString(16);
        checkAsciiCaseMetamorphic(metamorphicInput);
    }

    private static void exercise(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String forceLengthThree(String s, FuzzedDataProvider data) {
        if (s == null) {
            s = "";
        }
        if (s.length() == 3) {
            return s;
        }
        if (s.length() > 3) {
            int start = data.consumeInt(0, s.length() - 3);
            return s.substring(start, start + 3);
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < 3) {
            char c = (char) ('a' + Math.abs(data.consumeByte()) % 26);
            sb.append(c);
        }
        return sb.substring(0, 3);
    }

    private static String forceFirstCharNotY(String s, FuzzedDataProvider data) {
        if (s.length() != 3) {
            s = forceLengthThree(s, data);
        }
        char first = s.charAt(0);
        if (first != 'y' && first != 'Y') {
            return s;
        }
        char replacement = (char) ('a' + Math.abs(data.consumeByte()) % 26);
        if (replacement == 'y' || replacement == 'Y') {
            replacement = 'o';
        }
        return replacement + s.substring(1);
    }

    private static void checkAsciiCaseMetamorphic(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s.toUpperCase());
            boolean rhs2 = BooleanUtils.toBoolean(s.toLowerCase());

            /*
             * Contract visible in BooleanUtils.toBoolean(String): the recognized tokens are
             * matched by explicit upper/lower-case character comparisons ("on", "yes", "true"),
             * and every other string returns false. Therefore for ASCII input, changing only case
             * must not change the result. A patch that merely suppresses the crash by skipping a
             * branch or returning the wrong default can violate this observable equivalence.
             */
            if (lhs != rhs) {
                throw new RuntimeException("metamorphic violation: ascii-case-upper input=" + s + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != rhs2) {
                throw new RuntimeException("metamorphic violation: ascii-case-lower input=" + s + " lhs=" + lhs + " rhs=" + rhs2);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
                throw t;
            }
        }
    }
}
