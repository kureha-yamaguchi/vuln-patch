package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.optimization.GoalType;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        checkOneVariableTie(1.0, 1.0, 1.0);
        checkOneVariableTie(1.0, 2.0, 2.0);
        checkOneVariableTie(2.0, 1.0, 2.0);
    }

    private static void runExplore(FuzzedDataProvider data) {
        double geqCoeff = 1.0 + data.consumeInt(0, 4);
        double leqCoeff = 1.0 + data.consumeInt(0, 4);
        double xValue = 1.0 + data.consumeInt(0, 4);
        checkOneVariableTie(geqCoeff, leqCoeff, xValue);

        int extra = data.consumeInt(0, 3);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { geqCoeff, 0.0 }, Relationship.GEQ, geqCoeff * xValue));
        constraints.add(new LinearConstraint(new double[] { leqCoeff, 0.0 }, Relationship.LEQ, leqCoeff * xValue));
        for (int i = 0; i < extra; i++) {
            double[] coeffs = new double[] { 0.0, 0.0 };
            int var = data.consumeInt(0, 1);
            coeffs[var] = data.consumeInt(0, 3);
            Relationship rel;
            int relKind = data.consumeInt(0, 2);
            if (relKind == 0) {
                rel = Relationship.LEQ;
            } else if (relKind == 1) {
                rel = Relationship.GEQ;
            } else {
                rel = Relationship.EQ;
            }
            double rhs = data.consumeInt(0, 6);
            constraints.add(new LinearConstraint(coeffs, rel, rhs));
        }
        checkPivotBehavior(new double[] { 1.0, 0.0 }, constraints);
    }

    private static void checkOneVariableTie(double geqCoeff, double leqCoeff, double xValue) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { geqCoeff }, Relationship.GEQ, geqCoeff * xValue));
        constraints.add(new LinearConstraint(new double[] { leqCoeff }, Relationship.LEQ, leqCoeff * xValue));
        checkPivotBehavior(new double[] { 1.0 }, constraints);
    }

    private static void checkPivotBehavior(double[] objectiveCoefficients, ArrayList<LinearConstraint> constraints) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoefficients, 0.0);
        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, 10);

        int numArtificial = tableau.getNumArtificialVariables();
        if (numArtificial <= 0) {
            return;
        }

        int artificialOffset = tableau.getArtificialVariableOffset();
        Integer[] artificialBasicBefore = new Integer[numArtificial];
        boolean hadArtificialBasis = false;
        for (int i = 0; i < numArtificial; i++) {
            artificialBasicBefore[i] = tableau.getBasicRow(artificialOffset + i);
            if (artificialBasicBefore[i] != null) {
                hadArtificialBasis = true;
            }
        }
        if (!hadArtificialBasis) {
            return;
        }

        SimplexSolver solver = new SimplexSolver();
        solver.doIteration(tableau);

        for (int i = 0; i < numArtificial; i++) {
            Integer before = artificialBasicBefore[i];
            Integer after = tableau.getBasicRow(artificialOffset + i);
            /*
             * The changed code is exactly the "return row" that forces an artificial variable
             * out of the basis when the minimum-ratio test ties. In a tableau built from one
             * GEQ row and one LEQ row at the same bound, that branch is reachable. On the buggy
             * version, one iteration chooses that tied artificial-basic row and the artificial
             * variable leaves the basis immediately. On the fixed version, that special-case
             * return is gone, so the same first iteration chooses a different tied row.
             */
            if (before != null && after == null) {
                throw new RuntimeException(
                    "buggy getPivotRow behavior observed: artificial variable forced out on first tied pivot; " +
                    "objectiveDim=" + objectiveCoefficients.length +
                    " numArtificial=" + numArtificial +
                    " artificialIndex=" + i +
                    " beforeRow=" + before);
            }
        }
    }
}
