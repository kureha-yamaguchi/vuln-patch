public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (CloneNotSupportedException e) {
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];

        int first = data.consumeInt(0, maxOrd - (count + 4));
        int gap = data.consumeInt(2, 40);
        ords[0] = first;
        ords[1] = Math.min(maxOrd, first + gap);

        for (int i = 2; i < count; i++) {
            int minNext = ords[i - 1] + 1;
            int maxNext = maxOrd - (count - 1 - i);
            if (minNext > maxNext) {
                return;
            }
            ords[i] = data.consumeInt(minNext, maxNext);
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < ords.length; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        try {
            series.getIndex(series.getTimePeriod(0));
            series.getIndex(series.getTimePeriod(series.getItemCount() - 1));
        } catch (IllegalArgumentException e) {
            return;
        }

        int beforeFirst = ords[0] - 1;
        if (beforeFirst >= 0) {
            Day before = dayFromOrdinal(beforeFirst);
            try {
                series.getIndex(before);
                TimeSeries emptyClone = series.createCopy(before, before);
                if (emptyClone == null) {
                    throw new RuntimeException("null clone-path copy");
                }
                if (emptyClone.getItemCount() != 0) {
                    throw new RuntimeException("metamorphic violation: copy before first item must be empty");
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }

        int left = ords[0];
        int right = ords[1];
        if (right - left >= 2) {
            int startOrd1 = data.consumeInt(left + 1, right - 1);
            int endOrd1 = data.consumeInt(startOrd1, right - 1);
            Day start1 = dayFromOrdinal(startOrd1);
            Day end1 = dayFromOrdinal(endOrd1);

            try {
                int idx1 = series.getIndex(start1);
                int idx2 = series.getIndex(end1);
                TimeSeries gapCopy = series.createCopy(start1, end1);
                if (gapCopy == null) {
                    throw new RuntimeException("null gap copy");
                }
                if (idx1 >= 0 || idx2 >= 0) {
                    return;
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }

            if (right - left >= 3) {
                int startOrd2 = data.consumeInt(left + 1, right - 1);
                int endOrd2 = data.consumeInt(startOrd2, right - 1);
                Day start2 = dayFromOrdinal(startOrd2);
                Day end2 = dayFromOrdinal(endOrd2);

                try {
                    TimeSeries copyA = series.createCopy(start1, end1);
                    TimeSeries copyB = series.createCopy(start2, end2);
                    assertEquivalentCopies(copyA, copyB, "same-gap ranges");
                } catch (CloneNotSupportedException e) {
                    return;
                } catch (IllegalArgumentException e) {
                    if (isRootCause(e)) {
                        throw e;
                    }
                    return;
                }
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod startExisting = series.getTimePeriod(i);
            RegularTimePeriod endExisting = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);
            TimeSeries byIndex = series.createCopy(i, j);
            assertEquivalentCopies(byPeriod, byIndex, "existing-period copy equals index copy");
        } catch (CloneNotSupportedException e) {
            return;
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }
