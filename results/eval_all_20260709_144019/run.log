        }
        Boolean rhs = callToBoolean(toggled);
        if (rhs == null) {
            return;
        }
        if (lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "metamorphic violation: case-equivalence input=" + printable(explore) +
                " toggled=" + printable(toggled) +
                " lhs=" + lhs + " rhs=" + rhs);
        }
