        if (duplicated > 1) {
            Collections.reverse(permuted.subList(0, duplicated));
        } else {
            Collections.reverse(permuted);
        }
        metamorphicOrderInvariant(f, constraints, permuted, maximize ? GoalType.MAXIMIZE : GoalType.MINIMIZE);
    }

