package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        double mean = data.consumeInt(-1000, 1000) / 8.0;
        double sd = data.consumeInt(1, 1000) / 16.0;
        int k = data.consumeInt(-8, 8);

        exploreRoundTrip(mean, sd, k);

        int altK = data.consumeInt(-8, 8);
        if (altK != k) {
            exploreRoundTrip(mean, sd, altK);
        }

        if (data.consumeBoolean()) {
            double mean2 = data.consumeInt(-1000, 1000) / 4.0;
            double sd2 = data.consumeInt(1, 2000) / 32.0;
            int k2 = data.consumeInt(-8, 8);
            exploreRoundTrip(mean2, sd2, k2);
        }
    }

    private static void anchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            double p = 0.9772498680518209d;
            double result = normal.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(CDF(2)) exact anchor input=0.9772498680518209 result=" + result + " expected=2.0");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static void exploreRoundTrip(double mean, double sd, int k) {
        NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, sd);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return;
        }

        double x = mean + (sd * k);
        if (Double.isNaN(x) || Double.isInfinite(x)) {
            return;
        }

        final double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return;
        }

        if (Double.isNaN(p) || Double.isInfinite(p) || p < 0.0d || p > 1.0d) {
            return;
        }

        try {
            double inv = dist.inverseCumulativeProbability(p);

            /*
             * Contract asserted: for a continuous distribution, inverseCumulativeProbability
             * is the inverse of cumulativeProbability on valid in-range probabilities.
             * Here p is VALID BY CONSTRUCTION because it is produced by the same real
             * distribution's cumulativeProbability at x = mean + sd*k. A patch that merely
             * deletes the throw or otherwise corrupts bracketing can silently return a wrong
             * quantile instead of x, violating this round-trip relation.
             */
            double tol = Math.max(1.0e-12d, Math.abs(x) * 1.0e-12d);
            if (Double.isNaN(inv) || Double.isInfinite(inv) || Math.abs(inv - x) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x))!=x mean=" + mean +
                    " sd=" + sd +
                    " k=" + k +
                    " x=" + x +
                    " p=" + p +
                    " inv=" + inv);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || classNameContains(t, "IllegalArgument")
            || classNameContains(t, "Invalid")
            || classNameContains(t, "NotStrictlyPositive")
            || classNameContains(t, "OutOfRange");
    }

    private static boolean classNameContains(Throwable t, String token) {
        Class<?> c = t.getClass();
        while (c != null) {
            if (c.getName().contains(token)) {
                return true;
            }
            c = c.getSuperclass();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MathException) && !(t instanceof RuntimeException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (StackTraceElement e : stack) {
            String cn = e.getClassName();
            String mn = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cn)
                    && "bracket".equals(mn)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cn)
                    && "inverseCumulativeProbability".equals(mn)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cn)
                    && ("createIllegalArgumentException".equals(mn) || "buildMessage".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
