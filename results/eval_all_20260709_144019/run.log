        double size1;
        double size2;
        Vector2D bary1;
        Vector2D bary2;
        try {
            size1 = set.getSize();
            bary1 = set.getBarycenter();
            size2 = set.getSize();
            bary2 = set.getBarycenter();
        } catch (Throwable t) {
            return;
        }

        if (wholeSpace) {
            if (!Double.isInfinite(size1) || !Double.isInfinite(size2)) {
                throw new RuntimeException("metamorphic violation: whole-space leaf must have infinite size lhs=" + size1 + " rhs=" + size2);
