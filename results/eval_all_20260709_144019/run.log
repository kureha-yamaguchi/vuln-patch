package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkDeleteThenIndex("onetwo", "three", 0, false);

        String needle = data.consumeAsciiString(8);
        if (needle.length() == 0) {
            needle = "A";
        }

        String prefix = data.consumeAsciiString(32);
        prefix = removeNeedleOccurrences(prefix, needle);

        int start = data.consumeInt(-8, prefix.length() + needle.length() + 8);
        boolean useDeleteAll = data.consumeBoolean();

        checkDeleteThenIndex(prefix, needle, start, useDeleteAll);

        if (data.consumeBoolean()) {
            String marker = data.consumeAsciiString(8);
            if (marker.length() == 0) {
                marker = "%";
            }
            String middle = data.consumeRemainingAsString();
            String left = "\n" + marker;
            String surrounding = left + middle + left;
            checkDeleteAllThenIndex(surrounding, left);
        }
    }

    private static void checkDeleteThenIndex(String prefix, String needle, int start, boolean useDeleteAll) {
        StrBuilder sb = new StrBuilder(prefix + needle);

        final String result;
        final int idxDefault;
        final int idxStart;
        final boolean empty;

        try {
            if (useDeleteAll) {
                sb.deleteAll(needle);
            } else {
                sb.deleteFirst(needle);
            }
            result = sb.toString();
            idxDefault = sb.indexOf(needle);
            idxStart = sb.indexOf(needle, start);
            empty = sb.isEmpty();
        } catch (Throwable t) {
            if (isCleanRejection(t) || !isRelevantLibraryThrowable(t)) {
                return;
            }
            rethrowUnchecked(t);
            return;
        }

        /* Contract/post-condition:
         * We construct the builder as prefix + needle with prefix forced not to contain needle.
         * Therefore there is exactly one occurrence of needle, at the end.
         * After deleteFirst/deleteAll(needle), a correct implementation must leave exactly prefix,
         * so indexOf(needle) and indexOf(needle, start) must both report no match (-1).
         * Also isEmpty() must agree with the resulting length being zero.
         * A patch that merely suppresses the crash or skips the comparison can silently return a stale match.
         */
        if (!result.equals(prefix)) {
            throw new RuntimeException(
                "metamorphic violation: delete result mismatch inputPrefix=" + quote(prefix)
                    + " needle=" + quote(needle)
                    + " deleteAll=" + useDeleteAll
                    + " result=" + quote(result));
        }
        if (idxDefault != -1) {
            throw new RuntimeException(
                "metamorphic violation: deleted suffix still found by indexOf inputPrefix=" + quote(prefix)
                    + " needle=" + quote(needle)
                    + " deleteAll=" + useDeleteAll
                    + " result=" + quote(result)
                    + " idx=" + idxDefault);
        }
        if (idxStart != -1) {
            throw new RuntimeException(
                "metamorphic violation: deleted suffix still found by indexOf(str,start) inputPrefix=" + quote(prefix)
                    + " needle=" + quote(needle)
                    + " start=" + start
                    + " deleteAll=" + useDeleteAll
                    + " result=" + quote(result)
                    + " idx=" + idxStart);
        }
        if (empty != (prefix.length() == 0)) {
            throw new RuntimeException(
                "metamorphic violation: isEmpty inconsistent with result length inputPrefix=" + quote(prefix)
                    + " needle=" + quote(needle)
                    + " deleteAll=" + useDeleteAll
                    + " result=" + quote(result)
                    + " isEmpty=" + empty);
        }
    }

    private static void checkDeleteAllThenIndex(String input, String needle) {
        StrBuilder sb = new StrBuilder(input);

        final String result;
        final int idx;
        final boolean empty;

        try {
            sb.deleteAll(needle);
            result = sb.toString();
            idx = sb.indexOf(needle, 0);
            empty = sb.isEmpty();
        } catch (Throwable t) {
            if (isCleanRejection(t) || !isRelevantLibraryThrowable(t)) {
                return;
            }
            rethrowUnchecked(t);
            return;
        }

        /* Contract/post-condition:
         * After deleteAll(x), the resulting text must contain no occurrence of x.
         * This mirrors the real regression test shape using repeated markers.
         */
        if (result.indexOf(needle) == -1) {
            if (idx != -1) {
                throw new RuntimeException(
                    "metamorphic violation: deleteAll removed text but StrBuilder.indexOf still reports it input="
                        + quote(input) + " needle=" + quote(needle) + " result=" + quote(result) + " idx=" + idx);
            }
            if (empty != (result.length() == 0)) {
                throw new RuntimeException(
                    "metamorphic violation: isEmpty inconsistent after deleteAll input="
                        + quote(input) + " needle=" + quote(needle) + " result=" + quote(result)
                        + " isEmpty=" + empty);
            }
        }
    }

    private static String removeNeedleOccurrences(String prefix, String needle) {
        if (needle.length() == 0) {
            return prefix;
        }
        String out = prefix;
        int guard = 0;
        while (out.indexOf(needle) != -1 && guard++ < 16) {
            out = out.replace(needle, "");
        }
        if (out.indexOf(needle) != -1) {
            out = "";
        }
        return out;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isRelevantLibraryThrowable(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())
                && ("indexOf".equals(e.getMethodName()) || "isEmpty".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void rethrowUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
