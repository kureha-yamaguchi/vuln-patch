        if (series.getItemCount() < 2) {
            return;
        }

        int beforeFirstOrd = ords[0] - 1;
        if (beforeFirstOrd >= 0) {
            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);
            series.getIndex(beforeFirst);
            try {
