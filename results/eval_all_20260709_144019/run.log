                break;
            default:
                exerciseLeafAttribute(data.consumeRemainingAsString());
                break;
        }
    }

    private static void assertLeafWholeSpaceContract() {
        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));

            Vector2D[][] vertices = whole.getVertices();
            double size1 = whole.getSize();
            Vector2D bary1 = (Vector2D) whole.getBarycenter();
            double size2 = whole.getSize();
            Vector2D bary2 = (Vector2D) whole.getBarycenter();

            if (vertices == null || vertices.length != 0) {
                throw new RuntimeException(
                    "metamorphic violation: empty-leaf whole-space must expose zero vertex loops input=true verticesLength=" +
                    (vertices == null ? -1 : vertices.length));
            }
            if (!Double.isInfinite(size1) || size1 <= 0.0) {
                throw new RuntimeException(
                    "metamorphic violation: whole-space leaf must have infinite positive size input=true size=" + size1);
            }
            if (bary1 == null || !Double.isNaN(bary1.getX()) || !Double.isNaN(bary1.getY())) {
                throw new RuntimeException(
                    "metamorphic violation: whole-space leaf must have NaN barycenter input=true barycenter=" +
                    String.valueOf(bary1));
            }
            if (size1 != size2) {
                throw new RuntimeException(
                    "metamorphic violation: getSize must be stable across repeated reads input=true lhs=" +
                    size1 + " rhs=" + size2);
            }
            if (Double.doubleToLongBits(bary1.getX()) != Double.doubleToLongBits(bary2.getX()) ||
                Double.doubleToLongBits(bary1.getY()) != Double.doubleToLongBits(bary2.getY())) {
                throw new RuntimeException(
                    "metamorphic violation: getBarycenter must be stable across repeated reads input=true lhs=(" +
                    bary1.getX() + "," + bary1.getY() + ") rhs=(" + bary2.getX() + "," + bary2.getY() + ")");
