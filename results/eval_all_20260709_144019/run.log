    private static void runExplore(FuzzedDataProvider data) {
        int meanInt = data.consumeInt(-20, 20);
        int xInt = data.consumeInt(2, 200);
        boolean alsoCheckSymmetry = data.consumeBoolean();

        double mean = (double) meanInt;
        double sigma = 1.0d;
        double x = mean + xInt;

        NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sigma);
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted:
         * For a continuous distribution, inverseCumulativeProbability is the inverse
         * of cumulativeProbability on valid probabilities. Since we construct
         * p = cumulativeProbability(x) from the real library for a real NormalDistribution,
         * p is valid by construction and a correct implementation must recover x.
         * A patch that merely deletes the throw or returns an arbitrary value would violate
         * this observable round-trip property.
         */
        final double p;
        try {
            p = normal.cumulativeProbability(x);
        } catch (Throwable t) {
            return;
        }

        if (!(p >= 0.0d && p <= 1.0d) || Double.isNaN(p)) {
            return;
        }

        try {
            double q = normal.inverseCumulativeProbability(p);
            if (!approximatelyEqual(q, x, 1.0e-9d)) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) != x mean=" + mean +
                    " sigma=" + sigma + " x=" + x + " p=" + p + " q=" + q);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseThrowable(t)) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) threw for valid input mean=" + mean +
                    " sigma=" + sigma + " x=" + x + " p=" + p, t);
            }
            return;
        }

        /*
         * Additional real-API metamorphic relation for the standard symmetry of the
         * normal distribution: for any valid p, icdf(1 - p) == 2*mean - icdf(p).
         * If either side throws, the check is skipped.
         */
        if (alsoCheckSymmetry && p > 0.0d && p < 1.0d) {
            try {
                double q1 = normal.inverseCumulativeProbability(p);
                double q2 = normal.inverseCumulativeProbability(1.0d - p);
                double expected = 2.0d * mean - q1;
                if (!approximatelyEqual(q2, expected, 1.0e-9d)) {
                    throw new RuntimeException(
                        "metamorphic violation: normal symmetry broken mean=" + mean +
