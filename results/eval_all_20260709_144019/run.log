public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class CountingListener implements PlotChangeListener {
            int count;

            public void plotChanged(PlotChangeEvent event) {
                count++;
            }
        }

        class HarnessLogic {
            boolean isValidation(Throwable t) {
                return t instanceof IllegalArgumentException
                        || t instanceof NumberFormatException;
            }

            boolean hasPatchedFrame(Throwable t) {
                for (StackTraceElement e : t.getStackTrace()) {
                    String cls = e.getClassName();
                    String method = e.getMethodName();
                    if (("org.jfree.chart.plot.CategoryPlot".equals(cls)
                            || "org.jfree.chart.plot.XYPlot".equals(cls))
                            && ("removeDomainMarker".equals(method)
                            || "removeRangeMarker".equals(method))) {
                        return true;
                    }
                    if ("java.util.HashMap".equals(cls) && "get".equals(method)) {
                        return true;
                    }
                    if ("org.jfree.chart.plot.Plot".equals(cls)
                            && "fireChangeEvent".equals(method)) {
                        return true;
                    }
                }
                return false;
            }

            RuntimeException semanticFailure(String what, String detail, Throwable cause) {
                return new RuntimeException("metamorphic violation: " + what + " " + detail, cause);
            }

            void checkCategoryRange(int index, Layer layer, double value, boolean notify) {
                ValueMarker marker = new ValueMarker(value);

                CategoryPlot empty = new CategoryPlot();
                CountingListener emptyListener = new CountingListener();
                empty.addChangeListener(emptyListener);

                try {
                    boolean removed = empty.removeRangeMarker(index, marker, layer, notify);
                    /* Contract used:
                     * - The public tests for this library assert that removing a marker that was never added
                     *   returns false.
                     * - The implementation only calls fireChangeEvent() when removed && notify.
                     * Therefore, for an absent marker on a fresh plot, a correct implementation must:
                     *   (1) return false, and
                     *   (2) not notify listeners.
                     * A patch that merely suppresses the crash but returns true or fires an event violates this.
                     */
                    if (removed) {
                        throw semanticFailure(
                                "absent CategoryPlot.removeRangeMarker must return false",
                                "index=" + index + " layer=" + layer + " value=" + value + " removed=" + removed,
                                null);
                    }
                    if (emptyListener.count != 0) {
                        throw semanticFailure(
                                "absent CategoryPlot.removeRangeMarker must not fire change events",
                                "index=" + index + " layer=" + layer + " value=" + value + " events=" + emptyListener.count,
                                null);
                    }
                } catch (RuntimeException t) {
                    if (isValidation(t)) {
                        return;
                    }
                    if (t instanceof NullPointerException && hasPatchedFrame(t)) {
                        throw semanticFailure(
                                "CategoryPlot.removeRangeMarker should handle absent marker cleanly",
                                "index=" + index + " layer=" + layer + " value=" + value,
                                t);
