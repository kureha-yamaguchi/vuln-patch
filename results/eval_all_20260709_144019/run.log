package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        checkDeleteThenIndex("onetwothree", "three");
    }

    private static void runExplore(FuzzedDataProvider data) {
        char marker = pickMarker(data.consumeByte());
        int needleLen = data.consumeInt(1, 16);

        String needle = repeat(marker, needleLen);
        String prefix = scrub(data.consumeAsciiString(24), marker);
        String suffix = scrub(data.consumeRemainingAsString(), marker);

        checkDeleteThenIndex(prefix + needle + suffix, needle);

        // Also exercise the same public API with the deleted occurrence at the end,
        // matching the failing test's shape while varying lengths and surrounding data.
        String tailNeedle = repeat(marker, data.consumeInt(1, 8));
        String body = scrub(data.consumeAsciiString(32), marker);
        checkDeleteThenIndex(body + tailNeedle, tailNeedle);
    }

    /*
     * Contract used for the post-condition:
     * deleteFirst(str) removes the first occurrence of str if present. For inputs
     * constructed here, the builder contains exactly one occurrence of needle,
     * because needle is marker-only and prefix/suffix are scrubbed to contain no
     * marker at all. Therefore, after deleteFirst(needle), indexOf(needle) must
     * return -1. A patch that merely suppresses a crash or leaves stale buffer
     * contents observable through indexOf violates this post-condition.
     *
     * Additional observable invariant to steer into reachable code:
     * isEmpty() must agree with length() == 0 for every correct StrBuilder state.
     */
    private static void checkDeleteThenIndex(String initial, String needle) {
        try {
            StrBuilder sb = new StrBuilder(initial);
            sb.deleteFirst(needle);

            boolean empty = sb.isEmpty();
            boolean zeroLength = sb.length() == 0;
            if (empty != zeroLength) {
                throw new RuntimeException(
                        "metamorphic violation: isEmpty/length disagreement initial=" + quote(initial)
                                + " needle=" + quote(needle)
                                + " isEmpty=" + empty
                                + " length=" + sb.length());
            }

            int idx = sb.indexOf(needle);
            if (idx != -1) {
                throw new RuntimeException(
                        "metamorphic violation: unique occurrence survived deleteFirst initial=" + quote(initial)
                                + " needle=" + quote(needle)
                                + " result=" + quote(sb.toString())
                                + " index=" + idx);
            }

            String onceDeleted = sb.toString();
            try {
                sb.deleteFirst(needle);
                String twiceDeleted = sb.toString();
                if (!onceDeleted.equals(twiceDeleted)) {
                    throw new RuntimeException(
                            "metamorphic violation: deleteFirst not idempotent after unique deletion initial="
                                    + quote(initial)
                                    + " needle=" + quote(needle)
                                    + " once=" + quote(onceDeleted)
                                    + " twice=" + quote(twiceDeleted));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    rethrowUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException || t instanceof AssertionError)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("indexOf".equals(m) || "isEmpty".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static char pickMarker(byte b) {
        int v = b & 0xFF;
        return (char) ('A' + (v % 26));
    }

    private static String repeat(char ch, int len) {
        StringBuffer sb = new StringBuffer(len);
        for (int i = 0; i < len; i++) {
            sb.append(ch);
        }
        return sb.toString();
    }

    private static String scrub(String s, char forbidden) {
        if (s == null || s.length() == 0) {
            return "";
        }
        char replacement = forbidden == 'Z' ? 'Y' : 'Z';
        StringBuffer sb = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == forbidden) {
                sb.append(replacement);
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
