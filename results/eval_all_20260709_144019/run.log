package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        double mean = boundedDouble(data.consumeInt(), -1000.0, 1000.0);
        double sd = boundedPositiveDouble(data.consumeInt(), 1.0e-9, 1000.0);

        exerciseRoundTrip(mean, sd, mean + 2.0 * sd);
        exerciseRoundTrip(mean, sd, mean - 2.0 * sd);

        if (data.consumeBoolean()) {
            double mean2 = boundedDouble(data.consumeInt(), -10.0, 10.0);
            double sd2 = boundedPositiveDouble(data.consumeInt(), 1.0e-6, 10.0);
            exerciseRoundTrip(mean2, sd2, mean2 + 2.0 * sd2);
        }
    }

    private static void runAnchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);
            double p = 0.9772498680518209d;
            double result = normal.inverseCumulativeProbability(p);
            if (!approximatelyEqual(result, 2.0d, 1.0e-12)) {
                throw new RuntimeException(
                        "metamorphic violation: standard-normal known point inputP=" + p +
                        " expected=2.0 actual=" + result);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: inverseCumulativeProbability should return 2.0 for the documented standard-normal quantile inputP=0.9772498680518209", t);
            }
        }
    }

    private static void exerciseRoundTrip(double mean, double sd, double x) {
        try {
            NormalDistribution normal = new NormalDistributionImpl(mean, sd);

            /*
             * Contract used for this oracle:
             * For a continuous, strictly increasing distribution like NormalDistribution,
             * inverseCumulativeProbability(cumulativeProbability(x)) should recover x
             * (up to floating-point error) for finite x in the support.
             * A patch that merely deletes or bypasses the bracket failure can silently
             * return a wrong quantile; this round-trip detects that.
             */
            double p = normal.cumulativeProbability(x);
            double recovered;
            try {
                recovered = normal.inverseCumulativeProbability(p);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw new RuntimeException(
                            "metamorphic violation: round-trip inverseCumulativeProbability(cumulativeProbability(x)) threw for valid normal parameters mean=" +
                            mean + " sd=" + sd + " x=" + x + " p=" + p, t);
                }
                return;
            }

            if (!Double.isFinite(recovered)) {
                throw new RuntimeException(
                        "metamorphic violation: round-trip produced non-finite result mean=" +
                        mean + " sd=" + sd + " x=" + x + " p=" + p + " recovered=" + recovered);
            }

            double tol = 1.0e-10 * Math.max(1.0d, Math.abs(x));
            if (!approximatelyEqual(recovered, x, tol)) {
                throw new RuntimeException(
                        "metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x)) != x mean=" +
                        mean + " sd=" + sd + " x=" + x + " p=" + p + " recovered=" + recovered + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid normal-distribution round-trip hit patched region mean=" +
                        mean + " sd=" + sd + " x=" + x, t);
            }
        }
    }

    private static boolean approximatelyEqual(double a, double b, double tol) {
        return Math.abs(a - b) <= tol;
    }

    private static double boundedDouble(int raw, double min, double max) {
        long u = raw & 0xffffffffL;
        double fraction = u / (double) 0xffffffffL;
        return min + (max - min) * fraction;
    }

    private static double boundedPositiveDouble(int raw, double min, double max) {
        double v = boundedDouble(raw, min, max);
        if (v <= 0.0d || !Double.isFinite(v)) {
            return min;
        }
        return v;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof MathException || cur instanceof RuntimeException) {
                if (hasRelevantFrame(cur)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && ("createIllegalArgumentException".equals(method) || "buildMessage".equals(method) || "<init>".equals(method))) {
                return true;
            }
            if ("value".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
