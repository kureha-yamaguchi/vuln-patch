        ords[1] = ords[0] + data.consumeInt(2, Math.min(64, maxOrd - ords[0]));
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - ords[i - 1] - remaining;
            if (maxStep < 1) {
                ords[i] = ords[i - 1] + 1;
            } else {
                ords[i] = ords[i - 1] + data.consumeInt(1, maxStep);
            }
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < count; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

