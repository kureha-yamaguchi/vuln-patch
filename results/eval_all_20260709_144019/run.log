package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression input from the failing test.
        try {
            StrBuilder anchor = new StrBuilder(1);
            String before = anchor.toString();
            anchor.appendFixedWidthPadRight("foo", 1, '-');
            // Contract: appendFixedWidthPadRight appends exactly width characters,
            // truncating or padding on the right as needed. Deleting/skipping the
            // real append logic would violate this observable result.
            if (!"f".equals(anchor.toString())) {
                throw new RuntimeException(
                        "metamorphic violation: exact regression contract input=foo width=1 lhs="
                                + anchor.toString() + " rhs=f before=" + before);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // EXPLORE: vary widths, capacities, existing content, and repeated calls.
        String prefix = data.consumeString(24);
        String s1 = data.consumeString(64);
        String s2 = data.consumeString(64);
        int width1 = chooseWidth(data, s1);
        int width2 = chooseWidth(data, s2);
        int initialCapacity = data.consumeInt(0, 16);
        char pad1 = (char) (data.consumeByte() & 0xff);
        char pad2 = (char) (data.consumeByte() & 0xff);

        try {
            StrBuilder sb = new StrBuilder(initialCapacity);
            sb.append(prefix);

            checkAppendFixedWidthPadRight(sb, s1, width1, pad1);

            if (data.consumeBoolean()) {
                checkAppendFixedWidthPadRight(sb, s2, width2, pad2);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static int chooseWidth(FuzzedDataProvider data, String s) {
        int mode = data.consumeInt(0, 5);
        if (mode == 0) {
            return 1;
        }
        if (mode == 1) {
            return 6 + data.consumeInt(0, 58);
        }
        if (mode == 2) {
            return Math.max(0, s.length() - 1);
        }
        if (mode == 3) {
            return s.length();
        }
        if (mode == 4) {
            return s.length() + data.consumeInt(1, 32);
        }
        return data.consumeInt(-2, 64);
    }

    private static void checkAppendFixedWidthPadRight(StrBuilder sb, String input, int width, char padChar) {
        String before = sb.toString();
        int beforeLen = sb.length();

        sb.appendFixedWidthPadRight(input, width, padChar);

        // Contract asserted from the API semantics and regression test:
        // for width > 0 the method appends exactly `width` characters; if the
        // string is longer it is truncated on the right, otherwise padded on the
        // right with padChar. For width <= 0 it is a no-op. A patch that merely
        // suppresses the crash or skips the branch would violate this.
        String after = sb.toString();
        if (width <= 0) {
            if (!before.equals(after)) {
                throw new RuntimeException(
                        "metamorphic violation: nonpositive width should be no-op input="
                                + printable(input) + " width=" + width + " lhs="
                                + printable(after) + " rhs=" + printable(before));
            }
            return;
        }

        if (after.length() != beforeLen + width) {
            throw new RuntimeException(
                    "metamorphic violation: appended length input=" + printable(input)
                            + " width=" + width + " beforeLen=" + beforeLen
                            + " afterLen=" + after.length());
        }

        String appended = after.substring(beforeLen);
        String expected = expectedFixedWidthRight(input, width, padChar);
        if (!expected.equals(appended)) {
            throw new RuntimeException(
                    "metamorphic violation: fixed-width right append input="
                            + printable(input) + " width=" + width + " pad="
                            + (int) padChar + " lhs=" + printable(appended)
                            + " rhs=" + printable(expected));
        }
    }

    private static String expectedFixedWidthRight(String s, int width, char padChar) {
        if (width <= 0) {
            return "";
        }
        if (s.length() >= width) {
            return s.substring(0, width);
        }
        StringBuilder out = new StringBuilder(width);
        out.append(s);
        while (out.length() < width) {
            out.append(padChar);
        }
