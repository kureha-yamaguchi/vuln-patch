package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing test input first.
        try {
            runOneCase("", 1, "foo", 1, '-');
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // EXPLORE: same root-cause property with varied real inputs.
        // Root cause property: width > 0, obj.toString().length() > width, and the builder's
        // current capacity is only size + width, so appendFixedWidthPadRight copies too many chars.
        String prefix = data.consumeAsciiString(32);
        String content = data.consumeString(64);
        if (content == null) {
            content = "";
        }
        if (content.length() < 2) {
            content = content + "AB";
        }

        int width = data.consumeInt(1, content.length() - 1);
        char padChar = (char) (data.consumeByte() & 0xFF);

        Object obj;
        if (data.consumeBoolean()) {
            obj = content;
        } else {
            obj = new StrBuilder(content);
        }

        int capacity = prefix.length() + width;
        try {
            runOneCase(prefix, capacity, obj, width, padChar);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // Additional varied but valid-by-construction cases to probe surrounding behavior.
        int extraCases = data.consumeInt(0, 3);
        for (int i = 0; i < extraCases; i++) {
            String p = data.consumeAsciiString(16);
            String s = data.consumeString(32);
            if (s == null) {
                s = "";
            }
            if (s.length() < 2) {
                s = s + "XY";
            }
            int w = data.consumeInt(1, s.length() - 1);
            char pc = (char) (data.consumeByte() & 0xFF);
            Object o = data.consumeBoolean() ? (Object) s : (Object) new StrBuilder(s);
            int cap = p.length() + w;
            try {
                runOneCase(p, cap, o, w, pc);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            } catch (Error t) {
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static void runOneCase(String prefix, int capacity, Object obj, int width, char padChar) {
        StrBuilder sb = new StrBuilder(capacity);
        sb.append(prefix);

        int beforeLen = sb.length();
        String before = sb.toString();

        sb.appendFixedWidthPadRight(obj, width, padChar);

        // Post-condition from appendFixedWidthPadRight's contract visible in the implementation:
        // when width > 0, it must increase size by exactly width and append either the first
        // width chars of obj.toString(), or the whole string plus padding. A patch that merely
        // suppresses the throw, skips the copy, or updates size incorrectly breaks this.
        if (width > 0) {
            String after = sb.toString();
            int afterLen = sb.length();
            int expectedLen = beforeLen + width;
            if (afterLen != expectedLen) {
                throw new RuntimeException("metamorphic violation: length increment input=" + describe(prefix, capacity, obj, width, padChar) + " beforeLen=" + beforeLen + " afterLen=" + afterLen + " expectedLen=" + expectedLen);
            }
            if (!after.startsWith(before)) {
                throw new RuntimeException("metamorphic violation: prefix preservation input=" + describe(prefix, capacity, obj, width, padChar) + " before=" + before + " after=" + after);
            }

            String str = (obj == null ? sb.getNullText() : obj.toString());
            if (str != null) {
                String expectedSuffix;
                if (str.length() >= width) {
                    expectedSuffix = str.substring(0, width);
                } else {
                    StringBuffer tmp = new StringBuffer(width);
                    tmp.append(str);
                    while (tmp.length() < width) {
                        tmp.append(padChar);
                    }
                    expectedSuffix = tmp.toString();
                }
                String actualSuffix = after.substring(beforeLen);
                if (!expectedSuffix.equals(actualSuffix)) {
                    throw new RuntimeException("metamorphic violation: appended segment input=" + describe(prefix, capacity, obj, width, padChar) + " expectedSuffix=" + expectedSuffix + " actualSuffix=" + actualSuffix);
                }
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String describe(String prefix, int capacity, Object obj, int width, char padChar) {
        String objDesc;
        if (obj == null) {
            objDesc = "null";
        } else {
            objDesc = obj.getClass().getName() + ":" + String.valueOf(obj);
        }
        return "{prefix=" + prefix + ",capacity=" + capacity + ",obj=" + objDesc + ",width=" + width + ",pad=" + ((int) padChar) + "}";
    }
}
