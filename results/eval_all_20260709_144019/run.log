            obj = null;
            source = nullText;
        } else {
            String payload = data.consumeRemainingAsString();
            if (data.consumeBoolean() && payload.length() < width) {
                String extra = "XXXXXXXXXXXXXXXX";
                while (payload.length() < width) {
                    payload += extra;
                }
            }
            obj = payload;
            source = payload;
        }

        runCase(sb, obj, source, width, padChar);
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        runCase(sb, "foo", "foo", 1, '-');
        String got = sb.toString();
        if (!"f".equals(got)) {
            throw new RuntimeException("metamorphic violation: anchor expected=f got=" + got);
        }

        StrBuilder sbNull = new StrBuilder(1);
        sbNull.setNullText("foo");
        runCase(sbNull, null, "foo", 1, '-');
        String gotNull = sbNull.toString();
        if (!"f".equals(gotNull)) {
            throw new RuntimeException("metamorphic violation: nullText anchor expected=f got=" + gotNull);
        }
    }

    private static void runCase(StrBuilder sb, Object obj, String source, int width, char padChar) {
        int oldLen = sb.length();
        String prefix = sb.toString();

        StrBuilder oracle = new StrBuilder(oldLen + width + 8);
        oracle.append(prefix);
        try {
            oracle.append(expectedSegment(source, width, padChar));
        } catch (RuntimeException t) {
            return;
        }
        String oracleOut = oracle.toString();

        try {
