        int chosenVar = data.consumeInt(0, n - 1);
        double rhs = 1.0 + data.consumeInt(0, 3);
        double upper = rhs + data.consumeInt(0, 3);
        boolean maximize = data.consumeBoolean();

        LinearObjectiveFunction f = new LinearObjectiveFunction(makeObjective(n, data), 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        for (int i = 0; i < duplicated; i++) {
            double[] a = new double[n];
            a[chosenVar] = 1.0;
            int noiseTerms = data.consumeInt(0, Math.min(2, n - 1));
            for (int j = 0; j < noiseTerms; j++) {
                int idx = data.consumeInt(0, n - 1);
                if (idx != chosenVar) {
                    a[idx] = 0.0;
                }
            }
            constraints.add(new LinearConstraint(a, Relationship.GEQ, rhs));
        }

        for (int i = 0; i < n; i++) {
            double[] ub = new double[n];
            ub[i] = 1.0;
            double lim = (i == chosenVar) ? upper : data.consumeInt(0, 4);
            constraints.add(new LinearConstraint(ub, Relationship.LEQ, lim));
        }

        if (data.consumeBoolean()) {
            double[] eq = new double[n];
            eq[chosenVar] = 1.0;
            constraints.add(new LinearConstraint(eq, Relationship.LEQ, upper));
        }

        exerciseTableauAccessors(f, constraints);
        solveAndCheck(f, constraints, maximize ? GoalType.MAXIMIZE : GoalType.MINIMIZE);

