        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                int v = data.consumeInt(-20, 20);
                bigAData[r][c] = BigDecimal.valueOf(v);
                realAData[r][c] = v;
            }
        }

        BigDecimal[] bigVec = new BigDecimal[cols];
        double[] realVec = new double[cols];
        for (int i = 0; i < cols; i++) {
            int v = data.consumeInt(-20, 20);
            bigVec[i] = BigDecimal.valueOf(v);
            realVec[i] = v;
        }

        BigMatrixImpl bigA = new BigMatrixImpl(bigAData, false);
        RealMatrixImpl realA = new RealMatrixImpl(realAData, false);

        if (bigA.getRowDimension() != rows || bigA.getColumnDimension() != cols) {
            throw new RuntimeException("dimension mismatch in BigMatrixImpl");
        }
        if (realA.getRowDimension() != rows || realA.getColumnDimension() != cols) {
            throw new RuntimeException("dimension mismatch in RealMatrixImpl");
        }

        try {
            BigDecimal[] bigOut = bigA.operate(bigVec);
            if (bigOut.length != rows) {
                throw new RuntimeException("BigMatrixImpl.operate returned wrong length");
            }
        } catch (IllegalArgumentException e) {
        }

        try {
            double[] realOut = realA.operate(realVec);
            if (realOut.length != rows) {
                throw new RuntimeException("RealMatrixImpl.operate returned wrong length");
            }
        } catch (IllegalArgumentException e) {
        }

        BigDecimal[][] bigBData = new BigDecimal[cols][k];
        double[][] realBData = new double[cols][k];
        for (int r = 0; r < cols; r++) {
            for (int c = 0; c < k; c++) {
                int v = data.consumeInt(-10, 10);
                bigBData[r][c] = BigDecimal.valueOf(v);
                realBData[r][c] = v;
            }
        }

