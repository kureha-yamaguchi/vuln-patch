        if (oracleResult.booleanValue() != expected[idx]) {
            throw new RuntimeException(
                "metamorphic violation: canonical boolean token parsed incorrectly input=" + printable(validToken) +
                " expected=" + expected[idx] + " actual=" + oracleResult);
