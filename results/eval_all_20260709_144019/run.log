        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(C1, Relationship.GEQ, rhs1));
        constraints.add(new LinearConstraint(C2, Relationship.GEQ, rhs2));
        constraints.add(new LinearConstraint(C3, Relationship.GEQ, rhs3));
        constraints.add(new LinearConstraint(C4, Relationship.GEQ, rhs4));

        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        solver.optimize(f, constraints, goalType, nonNegative);
    }

    private static double[] makeObjective() {
        double[] c = new double[31];
        c[0] = 1.0;
        return c;
