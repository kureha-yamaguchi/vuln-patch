        if (emptyResult != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("ClassUtils.toClass(empty) should return EMPTY_CLASS_ARRAY");
        }

        Class<?>[] normalResult = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
