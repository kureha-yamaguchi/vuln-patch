        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.ClassUtils".equals(e.getClassName())
                    && ("toClass".equals(e.getMethodName()) || "getClass".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
