        double[] realX = new double[k];
        for (int i = 0; i < k; i++) {
            int v = data.consumeInt(-10, 10);
            bigX[i] = BigDecimal.valueOf(v);
            realX[i] = v;
        }

        BigMatrixImpl bigB = new BigMatrixImpl(bigBData, false);
        RealMatrixImpl realB = new RealMatrixImpl(realBData, false);

        try {
            BigDecimal[] left = ((BigMatrixImpl) bigA.multiply(bigB)).operate(bigX);
            BigDecimal[] bx = bigB.operate(bigX);
            BigDecimal[] right = bigA.operate(bx);
            if (!equalBigDecimalArrays(left, right)) {
                throw new RuntimeException("metamorphic violation: (A*B)*x == A*(B*x) for BigMatrixImpl");
            }
        } catch (IllegalArgumentException e) {
        }

        try {
            double[] left = ((RealMatrixImpl) realA.multiply(realB)).operate(realX);
            double[] bx = realB.operate(realX);
            double[] right = realA.operate(bx);
            if (!equalDoubleArrays(left, right)) {
                throw new RuntimeException("metamorphic violation: (A*B)*x == A*(B*x) for RealMatrixImpl");
