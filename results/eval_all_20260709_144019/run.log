        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)) {
                if ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "getSize".equals(method)
                        || "getBarycenter".equals(method)
                        || "<init>".equals(method)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.geometry.partitioning.BSPTree".equals(cls)
                    && "visit".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid")
                || name.contains("Parse")
                || name.contains("MathIllegal")
                || name.contains("IllegalArgument");
    }

    private static boolean isNaNPoint(Vector2D p) {
        return p != null && Double.isNaN(p.getX()) && Double.isNaN(p.getY());
    }

    private static boolean isZeroPoint(Vector2D p) {
        return p != null && p.getX() == 0.0 && p.getY() == 0.0;
    }

    private static boolean samePoint(Vector2D a, Vector2D b) {
        return a != null && b != null && sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        return a == b || (Double.isNaN(a) && Double.isNaN(b));
    }

    private static String pointString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return "(" + p.getX() + "," + p.getY() + ")";
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
