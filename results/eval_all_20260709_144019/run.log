package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        double center = 3.14159265358979323846;
        double leftDelta = consumePositiveDelta(data, 1.0e-6, 0.5);
        double rightDelta = consumePositiveDelta(data, 1.0e-6, 0.5);
        double min = center - leftDelta;
        double max = center + rightDelta;

        double initial;
        switch (data.consumeInt(0, 2)) {
            case 0:
                initial = center;
                break;
            case 1:
                initial = min + (max - min) * 0.5;
                break;
            default:
                double extra = consumePositiveDelta(data, 0.0, 0.25);
                initial = data.consumeBoolean() ? (min - extra) : (max + extra);
                break;
        }

        UnivariateRealFunction f = new SinFunction();
        callAndCheck(f, min, max, initial);

        if (data.consumeBoolean()) {
            double initial2;
            if (data.consumeBoolean()) {
                initial2 = center;
            } else {
                initial2 = min + (max - min) * (data.consumeInt(0, 1000) / 1000.0);
            }
            checkInitialGuessMetamorphic(f, min, max, initial, initial2);
        }
    }

    private static void runAnchor() {
        UnivariateRealFunction f = new SinFunction();
        callAndCheck(f, 3.0, 3.2, 3.1);
        checkInitialGuessMetamorphic(f, 3.0, 3.2, 3.1, 3.05);
    }

    private static void callAndCheck(UnivariateRealFunction f, double min, double max, double initial) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, min, max, initial);

            /* Contract asserted: solve(f, min, max, initial) is the same operation as solve(f, min, max)
             * for BisectionSolver; the patch itself changes the delegation target. Therefore, for any valid
             * bracketed interval, both public API calls must return the same root regardless of initial. A
             * throw-deleting or wrong-delegation patch can return a different value or skip solving entirely.
             */
            BisectionSolver oracle = new BisectionSolver();
            double expected = oracle.solve(f, min, max);
            if (Double.doubleToLongBits(result) != Double.doubleToLongBits(expected)) {
                throw new RuntimeException(
                    "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input="
                        + "[" + min + "," + max + "], initial=" + initial
                        + " lhs=" + result + " rhs=" + expected);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void checkInitialGuessMetamorphic(UnivariateRealFunction f, double min, double max,
                                                     double initial1, double initial2) {
        double r1;
        try {
            r1 = new BisectionSolver().solve(f, min, max, initial1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        double r2;
        try {
            r2 = new BisectionSolver().solve(f, min, max, initial2);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        /* Contract asserted: bisection uses the interval endpoints to isolate the root; the initial guess
         * parameter must not change which root is returned for the same function and same bracketing
         * interval. The patch changes only delegation, so a correct implementation must be invariant under
         * changing 'initial' here.
         */
        if (Double.doubleToLongBits(r1) != Double.doubleToLongBits(r2)) {
            throw new RuntimeException(
                "metamorphic violation: initial-guess invariance input="
                    + "[" + min + "," + max + "], initial1=" + initial1 + ", initial2=" + initial2
                    + " lhs=" + r1 + " rhs=" + r2);
        }
    }

    private static double consumePositiveDelta(FuzzedDataProvider data, double minValue, double maxValue) {
        int raw = data.consumeInt(0, 1_000_000);
        double frac = raw / 1_000_000.0;
        return minValue + (maxValue - minValue) * frac;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.contains("ConvergenceException")
                || name.contains("MaxIterationsExceededException")
                || name.contains("FunctionEvaluationException")) {
            return true;
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
