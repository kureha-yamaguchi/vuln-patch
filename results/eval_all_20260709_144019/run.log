    }

    private static String buildDecimalBase(FuzzedDataProvider data) {
        String left = digitsOnly(data.consumeAsciiString(16), true);
        String right = digitsOnly(data.consumeAsciiString(16), false);
        String exp = digitsOnly(data.consumeAsciiString(8), true);

        if (left.length() == 0 || "-".equals(left)) {
            left = Integer.toString(data.consumeInt());
        }
        if (right.length() == 0) {
            right = "0";
        }

        StringBuffer sb = new StringBuffer();
        sb.append(left);
        sb.append('.');
        sb.append(right);

        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
            if (exp.length() == 0 || "-".equals(exp)) {
                sb.append('0');
            } else {
