        String canonicalInt = Integer.toString(data.consumeInt());
        try {
            Number a = NumberUtils.createNumber(canonicalInt);
            Integer b = NumberUtils.createInteger(canonicalInt);
            /* Contract used for this oracle:
             * createNumber first tries createInteger for strings with no decimal point and no exponent.
             * Therefore, for a canonical decimal int string built from an actual int, both real library
             * calls must succeed and denote the same value/type. A patch that only suppresses exceptions
             * or skips intended parsing logic would break this observable equality.
