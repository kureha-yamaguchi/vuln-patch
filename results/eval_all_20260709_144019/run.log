    private static String buildExploreInput(FuzzedDataProvider data, String[] canonical) {
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return randomizeCase(canonical[data.consumeInt(0, canonical.length - 1)], data);
            case 1: {
                String[] observed = new String[] {
                    "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
                    "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
                    "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs", "yES",
                    "Yes", "YeS", "YEs", "YES", "yes?", "tru"
                };
                return randomizeCase(observed[data.consumeInt(0, observed.length - 1)], data);
            }
            case 2: {
                String base = canonical[data.consumeInt(0, canonical.length - 1)];
                String prefix = data.consumeAsciiString(3);
                String suffix = data.consumeAsciiString(3);
                return prefix + randomizeCase(base, data) + suffix;
            }
            case 3:
                return data.consumeAsciiString(8);
            case 4:
                return data.consumeString(8);
            default: {
                int len = data.consumeInt(0, 8);
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < len; i++) {
                    int kind = data.consumeInt(0, 4);
                    switch (kind) {
                        case 0:
                            sb.append((char) ('a' + data.consumeInt(0, 25)));
                            break;
                        case 1:
                            sb.append((char) ('A' + data.consumeInt(0, 25)));
                            break;
                        case 2:
                            sb.append((char) ('0' + data.consumeInt(0, 9)));
                            break;
                        case 3:
                            sb.append('?');
                            break;
                        default:
                            sb.append('_');
                            break;
                    }
                }
                return sb.toString();
            }
        }
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(c));
            } else {
                sb.append(Character.toLowerCase(c));
            }
        }
        return sb.toString();
    }

    private static String toggleCase(String s) {
        if (s == null) {
            return null;
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isUpperCase(c)) {
                sb.append(Character.toLowerCase(c));
            } else if (Character.isLowerCase(c)) {
                sb.append(Character.toUpperCase(c));
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static void exerciseForCrash(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static Boolean callToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return String.valueOf(s);
    }
