        String right = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 8)));

        callTarget(left + "e" + middle + "E" + right);
        callTarget(left + "E" + middle + "e" + right);

        String prefix = data.consumeBoolean() ? "-" : "";
        callTarget(prefix + left + "e" + middle + "E");
        callTarget(prefix + left + "E" + middle + "e");

        int known = data.consumeInt();
        String intStr = Integer.toString(known);

