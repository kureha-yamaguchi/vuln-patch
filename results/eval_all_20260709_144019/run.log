                || normalResult.length != 3
                || normalResult[0] != String.class
                || normalResult[1] != Integer.class
                || normalResult[2] != Double.class) {
            throw new RuntimeException("unexpected result for non-null anchor input");
        }

        ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });

        int len = data.consumeInt(1, 16);
        Object[] array = new Object[len];
        int forcedNullPos = data.consumeInt(0, len - 1);

        for (int i = 0; i < len; i++) {
            if (i == forcedNullPos || data.consumeBoolean()) {
                array[i] = null;
                continue;
            }

            switch (data.consumeInt(0, 5)) {
                case 0:
                    array[i] = data.consumeString(32);
                    break;
                case 1:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 2:
                    array[i] = Double.valueOf((double) data.consumeInt());
                    break;
                case 3:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 4:
                    try {
                        Class<?> c = tryLoadClass(data);
                        array[i] = c != null ? c : data.consumeAsciiString(32);
                    } catch (ClassNotFoundException e) {
                        array[i] = data.consumeAsciiString(32);
                    }
                    break;
                default:
                    array[i] = data.consumeRemainingAsString();
                    break;
            }
        }

        Class<?>[] classes = ClassUtils.toClass(array);
        if (classes == null || classes.length != array.length) {
            throw new RuntimeException("unexpected toClass result shape");
        }
        for (int i = 0; i < array.length; i++) {
            if (array[i] == null) {
                if (classes[i] != null) {
                    throw new RuntimeException("null element should map to null class");
                }
            } else if (classes[i] != array[i].getClass()) {
                throw new RuntimeException("incorrect class mapping");
            }
