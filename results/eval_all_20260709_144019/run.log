    private static void solveAndCheck(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean restrictToNonNegative) {
        try {
            SimplexSolver solver = new SimplexSolver();
            solver.optimize(f, constraints, GoalType.MINIMIZE, restrictToNonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void checkScaledConstraintMetamorphic(LinearObjectiveFunction f,
                                                         Collection<LinearConstraint> original,
                                                         Collection<LinearConstraint> scaled,
                                                         boolean restrictToNonNegative) {
        PointValuePair lhs;
        PointValuePair rhs;
        try {
            lhs = solveForResult(f, original, restrictToNonNegative);
            rhs = solveForResult(f, scaled, restrictToNonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t) || isRootCause(t)) {
                return;
            }
            return;
        }
        if (lhs == null || rhs == null) {
            return;
        }

        /*
         * Contract asserted:
         * Scaling one linear constraint by a positive constant preserves the feasible set,
         * therefore a correct optimizer must return the same optimum for both LPs whenever
         * both calls succeed. A patch that merely suppresses the buggy tie-breaking/cycling
         * path can silently change pivot selection and return a different solution/value.
         */
        if (Math.abs(lhs.getValue() - rhs.getValue()) > 1.0e-6 || !samePoint(lhs.getPointRef(), rhs.getPointRef(), 1.0e-6)) {
            throw new RuntimeException(
                    "metamorphic violation: positive scaling of one constraint changed optimum " +
                    "lhsValue=" + lhs.getValue() +
                    " rhsValue=" + rhs.getValue());
        }
    }

    private static PointValuePair solveForResult(LinearObjectiveFunction f,
                                                 Collection<LinearConstraint> constraints,
                                                 boolean restrictToNonNegative) {
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, GoalType.MINIMIZE, restrictToNonNegative);
    }

    private static boolean samePoint(double[] a, double[] b, double eps) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (Math.abs(a[i] - b[i]) > eps) {
                return false;
            }
        }
        return true;
    }

    private static double[] makeObjective(int vars) {
        double[] obj = new double[vars];
        obj[0] = 1.0;
        return obj;
    }

    private static ArrayList<LinearConstraint> deepCopy(Collection<LinearConstraint> constraints) {
        ArrayList<LinearConstraint> copy = new ArrayList<LinearConstraint>();
        for (LinearConstraint c : constraints) {
            copy.add(new LinearConstraint(c.getCoefficients().toArray(), c.getRelationship(), c.getValue()));
        }
        return copy;
    }

    private static LinearConstraint scaleConstraint(LinearConstraint c, double factor) {
        double[] coeff = c.getCoefficients().toArray();
        for (int i = 0; i < coeff.length; i++) {
            coeff[i] *= factor;
        }
        return new LinearConstraint(coeff, c.getRelationship(), c.getValue() * factor);
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.startsWith("org.apache.commons.math3.exception.")) {
            if (t instanceof MaxCountExceededException) {
                return false;
            }
            return true;
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException) && !(t instanceof RuntimeException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls) &&
                    ("getPivotRow".equals(m) || "doIteration".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls) &&
                    ("getNumObjectiveFunctions".equals(m) ||
                     "getHeight".equals(m) ||
                     "getWidth".equals(m) ||
                     "getEntry".equals(m) ||
                     "getNumArtificialVariables".equals(m) ||
                     "getArtificialVariableOffset".equals(m) ||
                     "getBasicRow".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls) &&
                    ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls) &&
                    ("getRowDimension".equals(m) || "getColumnDimension".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }

    private static final class LPCase {
        final LinearObjectiveFunction f;
        final ArrayList<LinearConstraint> constraints;
        final boolean restrictToNonNegative;

        LPCase(LinearObjectiveFunction f, ArrayList<LinearConstraint> constraints, boolean restrictToNonNegative) {
            this.f = f;
            this.constraints = constraints;
            this.restrictToNonNegative = restrictToNonNegative;
        }
    }
