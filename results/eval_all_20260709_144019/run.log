                            + doubleArrayToString(b));
                }
            }
        } catch (RuntimeException t) {
            if (!isKnownOperateRootCause(t) && !isValidationLike(t)) {
                throw t;
            }
        }
    }

    private static void fillMatrixData(FuzzedDataProvider data, BigDecimal[][] big, double[][] real, int min, int max) {
        for (int r = 0; r < big.length; r++) {
            for (int c = 0; c < big[r].length; c++) {
                int v = data.consumeInt(min, max);
                big[r][c] = BigDecimal.valueOf(v);
                real[r][c] = v;
            }
        }
    }

    private static void fillVectorData(FuzzedDataProvider data, BigDecimal[] big, double[] real, int min, int max) {
        for (int i = 0; i < big.length; i++) {
            int v = data.consumeInt(min, max);
            big[i] = BigDecimal.valueOf(v);
            real[i] = v;
        }
    }

    private static BigDecimal[] realLengthGuardBig(BigMatrixImpl m, BigDecimal[] v, int expectedRows) {
        BigDecimal[] out = m.operate(v);
        if (out.length != expectedRows) {
            throw new RuntimeException("metamorphic violation: BigMatrixImpl intermediate operate result length expected="
                    + expectedRows + " actual=" + out.length);
        }
        return out;
    }

    private static double[] realLengthGuardReal(RealMatrixImpl m, double[] v, int expectedRows) {
        double[] out = m.operate(v);
        if (out.length != expectedRows) {
            throw new RuntimeException("metamorphic violation: RealMatrixImpl intermediate operate result length expected="
                    + expectedRows + " actual=" + out.length);
        }
        return out;
    }

    private static boolean equalBigDecimalArrays(BigDecimal[] a, BigDecimal[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (a[i] == null || b[i] == null) {
                if (a[i] != b[i]) {
                    return false;
                }
            } else if (a[i].compareTo(b[i]) != 0) {
                return false;
            }
        }
        return true;
    }

    private static boolean equalDoubleArrays(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (Double.doubleToLongBits(a[i]) != Double.doubleToLongBits(b[i])) {
                return false;
            }
        }
        return true;
    }

    private static boolean isValidationLike(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Singular") || name.contains("Convergence")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isKnownOperateRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if (("org.apache.commons.math.linear.BigMatrixImpl".equals(cls)
                    || "org.apache.commons.math.linear.RealMatrixImpl".equals(cls))
                    && ("operate".equals(method)
                    || "getRowDimension".equals(method)
                    || "getColumnDimension".equals(method)
                    || "multiply".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String bigArrayToString(BigDecimal[] a) {
        if (a == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(a[i]);
        }
        sb.append(']');
        return sb.toString();
    }

    private static String doubleArrayToString(double[] a) {
        if (a == null) {
            return "null";
        }
        StringBuffer sb = new StringBuffer();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i != 0) {
