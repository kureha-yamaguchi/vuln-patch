import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        runEndpointPropertyCase(data);
        runGeneralRoundTripCase(data);
        runSymmetryCase(data);
    }

    private static void runAnchor() {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);
        double p = 0.9772498680518209;
        try {
            double x = normal.inverseCumulativeProbability(p);

            /* Contract asserted: for a continuous distribution, inverseCumulativeProbability(p)
             * should return a quantile whose cumulativeProbability is p (up to numerical error)
             * for valid p in (0, 1). A patch that merely deletes the throw or silently returns a
             * wrong value violates this observable round-trip property.
             */
            try {
                double roundTrip = normal.cumulativeProbability(x);
                if (Double.isNaN(x) || Double.isInfinite(x)
                        || Math.abs(roundTrip - p) > 1.0e-12) {
                    throw new RuntimeException(
                            "metamorphic violation: cdf(icdf(p))~=p anchor input=" + p
                                    + " x=" + x + " roundTrip=" + roundTrip);
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (Throwable t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid inverseCumulativeProbability input rejected in anchor p=" + p,
                        t);
            }
        }
    }

    private static void runEndpointPropertyCase(FuzzedDataProvider data) {
        int raw = data.consumeInt(1, 1000000);
        double sd = raw / 1000.0;
        if (!(sd > 0.0) || Double.isInfinite(sd) || Double.isNaN(sd)) {
            return;
        }

        NormalDistribution normal = new NormalDistributionImpl(0.0, sd);
        double expected = 2.0 * sd;
        double p;
        try {
            p = normal.cumulativeProbability(expected);
        } catch (Throwable ignored) {
            return;
        }

        if (!(p > 0.0 && p < 1.0) || Double.isNaN(p) || Double.isInfinite(p)) {
            return;
        }

        try {
            double actual = normal.inverseCumulativeProbability(p);

            /* Contract asserted: x -> cumulativeProbability(x) and p -> inverseCumulativeProbability(p)
             * are inverse operations on valid inputs. Here p is constructed from a real library call
             * as p = CDF(2*sd), so a correct implementation is obliged to accept it and recover 2*sd.
             * A throw-deleting or guard-skipping patch can return a silent wrong answer, which this
             * oracle-from-the-input check exposes.
             */
            if (Double.isNaN(actual) || Double.isInfinite(actual)
                    || Math.abs(actual - expected) > Math.max(1.0e-10, Math.abs(expected) * 1.0e-10)) {
                throw new RuntimeException(
                        "metamorphic violation: icdf(cdf(x))~=x endpoint-property sd=" + sd
                                + " p=" + p + " expected=" + expected + " actual=" + actual);
            }
        } catch (Throwable t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid icdf(cdf(x)) input rejected sd=" + sd
                                + " expected=" + expected + " p=" + p,
                        t);
            }
        }
    }

    private static void runGeneralRoundTripCase(FuzzedDataProvider data) {
        int meanRaw = data.consumeInt(-1000, 1000);
