package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.MessageFormat;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        // ANCHOR: exact failing test pattern first.
        exerciseRealEntryPoint("it''s a {0,lower} 'test'!", registry, new Object[] { "DUMMY" }, false);

        String arg = data.consumeString(32);
        String left = safeLiteral(data.consumeAsciiString(24));
        String mid = safeLiteral(data.consumeAsciiString(24));
        String right = safeLiteral(data.consumeAsciiString(24));
        String raw = data.consumeRemainingAsString();

        // EXPLORE: property is a non-null registry plus a pattern containing a doubled quote
        // that must be parsed by ExtendedMessageFormat through its public constructor.
        exerciseRealEntryPoint(left + "''" + mid + "{0}" + right, registry, new Object[] { arg }, true);
        exerciseRealEntryPoint(left + "''" + mid, registry, new Object[] { arg }, false);
        exerciseRealEntryPoint(left + "{0}''" + right, registry, new Object[] { arg }, true);
        exerciseRealEntryPoint("x''y {0}", registry, new Object[] { arg }, true);
        exerciseRealEntryPoint(left + "''" + raw, registry, new Object[] { arg }, false);
        exerciseRealEntryPoint(raw + "''" + left, registry, new Object[] { arg }, false);
    }

    private static void exerciseRealEntryPoint(String pattern, Map registry, Object[] args, boolean checkMetamorphic) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
            if (args != null) {
                emf.format(args);
            }

            if (checkMetamorphic) {
                checkEquivalentToMessageFormat(pattern, args, registry);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (Error) t;
            }
            return;
        }
    }

    private static void checkEquivalentToMessageFormat(String pattern, Object[] args, Map registry) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
            String lhs = emf.format(args);

            MessageFormat mf = new MessageFormat(pattern, Locale.US);
            String rhs = mf.format(args);

            /*
             * Contract asserted: ExtendedMessageFormat extends MessageFormat and only adds
             * support for extended/custom format syntax. For patterns that use only ordinary
             * MessageFormat constructs (here: literal text, doubled apostrophe escaping, and
             * {0}), formatting must therefore remain equivalent to MessageFormat.
             * A bad patch that merely skips the quote-handling bookkeeping can avoid the crash
             * yet silently drop/misparse the apostrophe, making these outputs differ.
             */
            if (!lhs.equals(rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: ExtendedMessageFormat must match MessageFormat for standard pattern input="
                        + pattern + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (Error) t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || t instanceof IndexOutOfBoundsException
            || t instanceof UnsupportedOperationException
            || t instanceof NullPointerException
            || classNameContains(t, "Validation")
            || classNameContains(t, "Invalid");
    }

    private static boolean classNameContains(Throwable t, String needle) {
        String n = t.getClass().getName();
        return n != null && n.indexOf(needle) >= 0;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(ste.getClassName())
                && "appendQuotedString".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String safeLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '{' || c == '}' || c == '\'') {
                b.append('x');
            } else if (c == '\u0000') {
                b.append('y');
            } else {
                b.append(c);
            }
