        // Contract from GrayPaintScale.getPaint(): values are clamped into [lowerBound, upperBound],
        // so any x below lower must produce the same paint as lower, and any x above upper must
        // produce the same paint as upper.
        int a = data.consumeInt(-1000, 999);
        int width = data.consumeInt(1, 1000);
        double lower = a / 10.0;
        double upper = lower + (width / 10.0);
