    private static String digitsOnly(String s, boolean allowLeadingSign) {
        StringBuffer out = new StringBuffer();
        if (s == null || s.length() == 0) {
            return allowLeadingSign ? "0" : "0";
        }
        int i = 0;
        if (allowLeadingSign && s.length() > 0) {
            char first = s.charAt(0);
            if (first == '-' || first == '+') {
                if (first == '-') {
                    out.append('-');
                }
                i = 1;
            }
        }
        for (; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0 || "-".equals(out.toString())) {
            return allowLeadingSign && out.length() == 1 ? "-0" : "0";
        }
        return out.toString();
    }

    private static String nonEmptyDigits(String s) {
        if (s == null || s.length() == 0 || "-".equals(s)) {
            return "0";
        }
