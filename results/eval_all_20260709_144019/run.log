package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int mean = data.consumeInt(-20, 20);
        int sdInt = data.consumeInt(1, 10);
        int n = data.consumeInt(-8, 8);

        double sigma = (double) sdInt;
        double x = mean + sigma * n;

        runRoundTripCase(mean, sigma, x);

        int extraCases = data.consumeInt(0, 4);
        for (int i = 0; i < extraCases; i++) {
            int mean2 = data.consumeInt(-50, 50);
            int sd2 = data.consumeInt(1, 20);
            int n2 = data.consumeInt(-10, 10);
            runRoundTripCase(mean2, (double) sd2, mean2 + ((double) sd2) * n2);
        }
    }

    private static void runAnchor() {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);
        double p = 0.9772498680518209d;
        try {
            double result = normal.inverseCumulativeProbability(p);
            checkRoundTrip(normal, p, result, "anchor");
            checkExpectedValue(result, 2.0d, "anchor");
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void runRoundTripCase(double mean, double sigma, double x) {
        try {
            NormalDistribution dist = new NormalDistributionImpl(mean, sigma);

            double p;
            try {
                p = dist.cumulativeProbability(x);
            } catch (Throwable t) {
                return;
            }

            double inv;
            try {
                inv = dist.inverseCumulativeProbability(p);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isGroundTruthRootCause(t)) {
                    sneakyThrow(t);
                }
                return;
            }

            /* Contract asserted: for a valid probability p produced by cumulativeProbability(x),
               inverseCumulativeProbability(p) should recover x (modulo solver tolerance), and
               cumulativeProbability(inverseCumulativeProbability(p)) should return p.
               A "fix" that merely suppresses the throw or skips correct bracketing can silently
               return the wrong quantile, violating this round-trip relation. */
            checkExpectedValue(inv, x, "inverse(cdf(x))");
            checkRoundTrip(dist, p, inv, "cdf(inverse(p))");
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void checkExpectedValue(double actual, double expected, String label) {
        double tol = tolerance(expected);
        if (!approximatelyEqual(actual, expected, tol)) {
            throw new RuntimeException(
                "metamorphic violation: " + label +
                " expected=" + expected +
                " actual=" + actual +
                " tol=" + tol);
        }
    }

    private static void checkRoundTrip(NormalDistribution dist, double p, double x, String label) {
        try {
            double roundTrip = dist.cumulativeProbability(x);
            double tol = tolerance(p);
            if (!approximatelyEqual(roundTrip, p, tol)) {
                throw new RuntimeException(
                    "metamorphic violation: " + label +
                    " p=" + p +
                    " x=" + x +
                    " roundTrip=" + roundTrip +
                    " tol=" + tol);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean approximatelyEqual(double a, double b, double tol) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (a == b) {
            return true;
        }
        return Math.abs(a - b) <= tol;
    }

    private static double tolerance(double reference) {
        return Math.max(1.0e-12, Math.abs(reference) * 1.0e-10);
    }

    private static boolean isGroundTruthRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        return hasBracketFrameInChain(t);
    }

    private static boolean hasBracketFrameInChain(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            StackTraceElement[] st = cur.getStackTrace();
            if (st != null) {
                for (StackTraceElement e : st) {
                    String cls = e.getClassName();
                    String method = e.getMethodName();
                    if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                            && "bracket".equals(method)) {
                        return true;
                    }
                    if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                            && "createIllegalArgumentException".equals(method)) {
                        return true;
                    }
                    if ("org.apache.commons.math.exception.util.DummyLocalizable".equals(cls)
                            && "<init>".equals(method)) {
                        return true;
                    }
                    if ("org.apache.commons.math.MathException".equals(cls)
                            && "buildMessage".equals(method)) {
                        return true;
                    }
                    if (cls != null && cls.startsWith("org.apache.commons.math")
                            && "value".equals(method)) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("IllegalArgument")
                || name.contains("NumberFormat")
                || name.contains("Invalid")
                || name.contains("OutOfRange")
                || name.contains("NotStrictlyPositive")
                || name.contains("NullArgument");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
