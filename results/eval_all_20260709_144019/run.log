        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = toAsciiLetter(data.consumeByte());
        char c2 = toAsciiLetter(data.consumeByte());
        String badLen3 = new String(new char[] { c0, c1, c2 });

        // EXPLORE: root-cause property is a 3-character string that does not start with y/Y.
        // On the buggy version, such inputs fall through from case 3 into case 4 and may read charAt(3).
        exercise(badLen3, false);

        String carrier = prefix + badLen3 + suffix;
        exercise(carrier, false);
        exercise(carrier.substring(prefix.length(), prefix.length() + 3), false);
        exercise("?" + badLen3, false);
        exercise(badLen3 + "?", false);

        int extraCount = data.consumeInt(1, 4);
        for (int i = 0; i < extraCount; i++) {
            String extraPrefix = data.consumeAsciiString(6);
            String extraSuffix = data.consumeAsciiString(6);

            char d0 = toAsciiLetter(data.consumeByte());
            if (d0 == 'y' || d0 == 'Y') {
                d0 = 't';
            }
            char d1 = toAsciiLetter(data.consumeByte());
            char d2 = toAsciiLetter(data.consumeByte());
            String s = extraPrefix + new String(new char[] { d0, d1, d2 }) + extraSuffix;

            exercise(s, false);
            if (s.length() >= 3) {
                int start = extraPrefix.length();
                exercise(s.substring(start, start + 3), false);
            }
        }

        // A few real literals observed near the failing test.
        exercise("oof", false);
        exercise("yep", false);
        exercise("tru", false);
        exercise("yes?", false);
    }

    private static void exercise(String s, boolean anchor) {
        Boolean base = safeToBoolean(s);
        if (base == null) {
            return;
        }

        // Contract asserted from the implementation: accepted literals are checked case-insensitively
        // ("on", "yes", "true"), and all other inputs return false. Therefore changing case must not
        // change the boolean result for any ASCII input. A patch that merely deletes the throwing read
        // but corrupts case-handling would violate this.
        Boolean upper = safeToBoolean(s.toUpperCase(Locale.ROOT));
        if (upper == null) {
            return;
        }
        Boolean lower = safeToBoolean(s.toLowerCase(Locale.ROOT));
        if (lower == null) {
            return;
        }

        if (!base.equals(upper) || !base.equals(lower)) {
            throw new RuntimeException(
                "metamorphic violation: case-insensitive parse input=" + repr(s)
                    + " lhs=" + base
                    + " upper=" + upper
                    + " lower=" + lower
                    + " anchor=" + anchor);
        }
    }

    private static Boolean safeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static char toAsciiLetter(byte b) {
        return (char) ('a' + (b & 0xFF) % 26);
    }

    private static String repr(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
