package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAndCheck("off");

        String[] observed = new String[] {
            "oof", "yep", "tru", "yes?", "false", "a"
        };
        for (int i = 0; i < observed.length; i++) {
            exerciseAndCheck(observed[i]);
        }

        String invalidLen3 = buildInvalidLen3(data);
        exerciseAndCheck(invalidLen3);

        int extraCount = data.consumeInt(1, 6);
        for (int i = 0; i < extraCount; i++) {
            String candidate;
            switch (data.consumeInt(0, 4)) {
                case 0:
                    candidate = buildInvalidLen3(data);
                    break;
                case 1: {
                    String s = data.consumeAsciiString(8);
                    if (s.length() == 3) {
                        char c0 = s.charAt(0);
                        if (c0 == 'y' || c0 == 'Y') {
                            s = "x" + s.substring(1);
                        }
                    }
                    candidate = s;
                    break;
                }
                case 2: {
                    String surround = data.consumeAsciiString(5);
                    String core = buildInvalidLen3(data);
                    int mode = data.consumeInt(0, 2);
                    candidate = mode == 0 ? surround + core : mode == 1 ? core + surround : surround + core + surround;
                    break;
                }
                case 3:
                    candidate = data.consumeRemainingAsString();
                    break;
                default:
                    candidate = data.consumeString(12);
                    break;
            }
            exerciseAndCheck(candidate);
        }

        checkKnownTrueToken(data);
    }

    private static void exerciseAndCheck(String input) {
        try {
            BooleanUtils.toBoolean(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static String buildInvalidLen3(FuzzedDataProvider data) {
        char c0 = pickNonYChar(data);
        char c1 = toAsciiChar(data.consumeByte());
        char c2 = toAsciiChar(data.consumeByte());
        return new String(new char[] { c0, c1, c2 });
    }

    private static char pickNonYChar(FuzzedDataProvider data) {
        char c;
        do {
            c = toAsciiChar(data.consumeByte());
        } while (c == 'y' || c == 'Y');
        return c;
    }

    private static char toAsciiChar(byte b) {
        return (char) (' ' + (b & 0x3f));
    }

    private static void checkKnownTrueToken(FuzzedDataProvider data) {
        String base;
        switch (data.consumeInt(0, 2)) {
            case 0:
                base = "yes";
                break;
            case 1:
                base = "on";
                break;
            default:
                base = "true";
                break;
        }

        String variant = randomCase(base, data);

        boolean result;
