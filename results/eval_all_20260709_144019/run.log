package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test / ground truth.
        callAndPropagateOnlyRootCause("off");

        // EXPLORE: fuzz strings with the same root-cause shape.
        // In the buggy implementation, switch fall-through makes certain short strings
        // reach charAt(3) inside BooleanUtils.toBoolean.
        for (int i = 0; i < 6; i++) {
            String candidate;
            switch (data.consumeInt(0, 5)) {
                case 0:
                    candidate = forceLength3NotStartingWithY(data.consumeAsciiString(8));
                    break;
                case 1:
                    candidate = forceLength2NotOn(data.consumeAsciiString(8));
                    break;
                case 2:
                    candidate = data.consumeAsciiString(8);
                    break;
                case 3:
                    candidate = data.consumeString(8);
                    break;
                case 4:
                    candidate = pickObservedLiteral(data.consumeInt());
                    break;
                default:
                    candidate = surround(forceLength3NotStartingWithY(data.consumeAsciiString(5)),
                            data.consumeAsciiString(2), data.consumeAsciiString(2), data.consumeBoolean());
                    break;
            }
            callAndPropagateOnlyRootCause(candidate);
        }

        // POST-CONDITION / ORACLE:
        // The visible contract from the failing test is that mixed-case variants of "true"
        // must return true, and literals such as "off" must return false. A patch that merely
        // avoids the exception by skipping the branch or returning a default value would violate
        // these observable results even if it never throws.
        String trueVariant = buildCaseVariant("true", data.consumeInt());
        Boolean trueResult = callAndSwallowNonRoot(trueVariant);
        if (trueResult != null && !trueResult.booleanValue()) {
            throw new RuntimeException("metamorphic violation: mixed-case 'true' must parse as true input="
                    + repr(trueVariant) + " result=" + trueResult);
        }

        String onVariant = buildCaseVariant("on", data.consumeInt());
        Boolean onResult = callAndSwallowNonRoot(onVariant);
        if (onResult != null && !onResult.booleanValue()) {
            throw new RuntimeException("metamorphic violation: mixed-case 'on' must parse as true input="
                    + repr(onVariant) + " result=" + onResult);
        }

        String yesVariant = buildCaseVariant("yes", data.consumeInt());
        Boolean yesResult = callAndSwallowNonRoot(yesVariant);
        if (yesResult != null && !yesResult.booleanValue()) {
            throw new RuntimeException("metamorphic violation: mixed-case 'yes' must parse as true input="
                    + repr(yesVariant) + " result=" + yesResult);
        }

        String offVariant = buildCaseVariant("off", data.consumeInt());
        Boolean offResult = callAndSwallowNonRoot(offVariant);
        if (offResult != null && offResult.booleanValue()) {
            throw new RuntimeException("metamorphic violation: mixed-case 'off' must parse as false input="
                    + repr(offVariant) + " result=" + offResult);
        }

        // Additional equivalent-input relation:
        // Since the API is case-insensitive for the recognized boolean tokens and otherwise
        // returns false, uppercasing an input must not change the boolean outcome for any
        // correct implementation of BooleanUtils.toBoolean.
        String relationInput = data.consumeAsciiString(12);
        Boolean lhs = callAndSwallowNonRoot(relationInput);
        Boolean rhs = callAndSwallowNonRoot(relationInput == null ? null : relationInput.toUpperCase());
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException("metamorphic violation: case-insensitive outcome input="
                    + repr(relationInput) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void callAndPropagateOnlyRootCause(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static Boolean callAndSwallowNonRoot(String s) {
        try {
            return BooleanUtils.toBoolean(s) ? Boolean.TRUE : Boolean.FALSE;
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return null;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String forceLength3NotStartingWithY(String s) {
        String base = s == null ? "" : s;
        StringBuilder b = new StringBuilder(base);
        while (b.length() < 3) {
            b.append('a');
        }
        if (b.length() > 3) {
            b.setLength(3);
        }
        char c0 = b.charAt(0);
        if (c0 == 'y' || c0 == 'Y') {
            b.setCharAt(0, 'o');
        }
        return b.toString();
    }

    private static String forceLength2NotOn(String s) {
        String base = s == null ? "" : s;
        StringBuilder b = new StringBuilder(base);
        while (b.length() < 2) {
            b.append('a');
        }
        if (b.length() > 2) {
            b.setLength(2);
        }
        String out = b.toString();
        if ("on".equalsIgnoreCase(out)) {
            return "no";
        }
        return out;
    }

    private static String buildCaseVariant(String token, int bits) {
        StringBuffer sb = new StringBuffer(token.length());
        for (int i = 0; i < token.length(); i++) {
            char ch = token.charAt(i);
            if (((bits >> i) & 1) == 0) {
                sb.append(Character.toLowerCase(ch));
            } else {
                sb.append(Character.toUpperCase(ch));
            }
        }
        return sb.toString();
    }

    private static String pickObservedLiteral(int n) {
        switch (Math.abs(n % 10)) {
            case 0: return "oof";
            case 1: return "yep";
            case 2: return "trux";
            case 3: return "false";
            case 4: return "a";
            case 5: return "truE";
            case 6: return "yes?";
            case 7: return "tru";
            case 8: return "no";
            default: return "off";
        }
    }

    private static String surround(String core, String left, String right, boolean keepCoreOnly) {
        if (keepCoreOnly) {
            return core;
        }
        String l = left == null ? "" : left;
        String r = right == null ? "" : right;
        String combined = l + core + r;
        return combined.length() <= 12 ? combined : combined.substring(0, 12);
    }

    private static String repr(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
