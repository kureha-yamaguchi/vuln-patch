        // for valid, in-range x. A throw-deleting patch that silently returns the wrong value
        // breaks this post-condition even if no exception is thrown.
        double mean = data.consumeInt(-1000, 1000) / 10.0d;
        double sigma = data.consumeInt(1, 1000) / 100.0d;
        int k = data.consumeInt(2, 30);

        NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, sigma);
        } catch (Throwable t) {
            return;
        }

        double target = mean + sigma * k;
        double p;
        try {
            p = dist.cumulativeProbability(target);
        } catch (Throwable t) {
            return;
        }

        // Keep only strictly interior probabilities, which a correct implementation is obliged to handle.
        if (!(p > 0.0d && p < 1.0d) || Double.isNaN(p)) {
            return;
        }

