            }
        }

        int tinyCapacity = prefix.length() <= 0 ? 1 : prefix.length();
        checkCapacityInvariant(prefix, source, width, padChar, tinyCapacity);

        String nullText = data.consumeString(24);
        if (nullText == null) {
