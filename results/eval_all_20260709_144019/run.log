package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // The regression test NumberUtilsTest.testLang457 documents that inputs like "l", "L", "f", "F", "junk", and "bobL"
        // must be rejected cleanly as bad numbers. A correct implementation may reject with NumberFormatException or another
        // IllegalArgumentException-family validation exception, but it must not leak internal StringIndexOutOfBoundsException.
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            assertCleanInvalidRejection(anchors[i]);
        }

        String singleSuffix;
        switch (data.consumeInt(0, 3)) {
            case 0:
                singleSuffix = "l";
                break;
            case 1:
                singleSuffix = "L";
                break;
            case 2:
                singleSuffix = "f";
                break;
            default:
                singleSuffix = "F";
                break;
        }
        assertCleanInvalidRejection(singleSuffix);

        String raw = data.consumeString(32);
        if (raw.length() > 0) {
            tryCreateNumber(raw);
            tryCreateNumber(raw + suffixFromMode(data.consumeInt(0, 5)));
        }

        String ascii = data.consumeAsciiString(32);
        tryCreateNumber(ascii);

        String digits = digitsOnly(ascii, false);
        String signedDigits = digitsOnly(ascii, true);
        String expDigits = digitsOnly(data.consumeAsciiString(8), true);

        tryCreateNumber(signedDigits);
        tryCreateNumber(signedDigits + (data.consumeBoolean() ? "l" : "L"));
        tryCreateNumber(digits + digits + digits + (data.consumeBoolean() ? "l" : "L"));
        tryCreateNumber(signedDigits + "." + digits + (data.consumeBoolean() ? "f" : "F"));
        tryCreateNumber(signedDigits + "." + digits + "E" + expDigits + (data.consumeBoolean() ? "d" : "D"));
        tryCreateNumber((data.consumeBoolean() ? "-0x" : "0x") + hexOnly(data.consumeAsciiString(16)));

        String tail = data.consumeRemainingAsString();
        if (tail != null && tail.length() > 0) {
            tryCreateNumber(tail);
        }

        // Metamorphic relation asserted:
        // For any valid decimal integral representation x, createNumber(x + "l") and createNumber(x + "L")
        // must denote the same numeric result because NumberUtils explicitly treats both suffixes as the same long-type request.
