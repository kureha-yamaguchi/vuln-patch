package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final String[] TOKENS = new String[] {
        "true", "false", "on", "off", "yes", "no"
    };

    private static final String[] OBSERVED = new String[] {
        "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
        "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
        "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs", "yES",
        "Yes", "YeS", "YEs", "YES", "yes?", "tru"
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryBoolean("off");

        String candidate = buildCandidate(data);
        tryBoolean(candidate);

        String token = TOKENS[data.consumeInt(0, TOKENS.length - 1)];
        String mixed = mutateCase(token, data);
        tryBoolean(mixed);

        /* Contract asserted: the public BooleanUtils string parser is case-insensitive for
         * the recognized textual boolean tokens exercised by the project tests and the patch
         * ("true"/"false"/"on"/"off"/"yes"/"no"). Therefore parsing any mixed-case form of a
         * recognized token must produce the same result as parsing its canonical lowercase form.
         * A patch that merely suppresses the crash or skips the intended branch could violate this
         * without throwing, so we check the observable result through real library calls. */
        Boolean lhs = safeToBoolean(mixed);
        Boolean rhs = safeToBoolean(token);
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "metamorphic violation: case-insensitive token parsing input=" + mixed +
                " lhs=" + lhs + " rhs=" + rhs
            );
        }
    }

    private static String buildCandidate(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 6);
        switch (mode) {
            case 0:
                return data.consumeAsciiString(8);
            case 1: {
                String base = OBSERVED[data.consumeInt(0, OBSERVED.length - 1)];
                return mutateCase(base, data);
            }
            case 2: {
                String base = OBSERVED[data.consumeInt(0, OBSERVED.length - 1)];
                if (base.length() == 0) {
                    return base;
                }
                int pos = data.consumeInt(0, base.length() - 1);
                char c = (char) ('a' + data.consumeInt(0, 25));
                return base.substring(0, pos) + c + base.substring(pos + 1);
            }
            case 3: {
                String base = OBSERVED[data.consumeInt(0, OBSERVED.length - 1)];
                char c = (char) ('a' + data.consumeInt(0, 25));
                int pos = data.consumeInt(0, base.length());
                return base.substring(0, pos) + c + base.substring(pos);
            }
            case 4: {
                String base = OBSERVED[data.consumeInt(0, OBSERVED.length - 1)];
                if (base.length() == 0) {
                    return base;
                }
                int pos = data.consumeInt(0, base.length() - 1);
                return base.substring(0, pos) + base.substring(pos + 1);
            }
            case 5: {
                String prefix = data.consumeAsciiString(2);
                String suffix = data.consumeAsciiString(2);
                String base = OBSERVED[data.consumeInt(0, OBSERVED.length - 1)];
                return prefix + base + suffix;
            }
            default: {
                int len = data.consumeInt(0, 5);
                String s = data.consumeAsciiString(len);
                if (s.length() == 0 && len > 0) {
                    s = "x";
                }
                return s;
            }
        }
    }

    private static String mutateCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(Character.toLowerCase(ch));
            }
        }
        return sb.toString();
    }

    private static void tryBoolean(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static Boolean safeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        FuzzHarness.<RuntimeException>throwAny(t);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAny(Throwable t) throws T {
        throw (T) t;
    }
}
