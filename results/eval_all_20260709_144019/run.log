                        throw semanticFailure(
                                "present CategoryPlot.removeRangeMarker must return true",
                                "index=" + index + " layer=" + layer + " value=" + value + " removed=" + removed,
                                null);
                    }
                    int expectedEvents = notify ? 2 : 1;
                    if (presentListener.count != expectedEvents) {
                        throw semanticFailure(
                                "CategoryPlot marker add/remove event accounting",
                                "index=" + index + " layer=" + layer + " value=" + value
                                        + " notify=" + notify + " events=" + presentListener.count
                                        + " expected=" + expectedEvents,
                                null);
                    }
                } catch (RuntimeException t) {
                    if (!isValidation(t)) {
                        return;
                    }
                }
            }

