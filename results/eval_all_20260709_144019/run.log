package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
        runInvalidInputProbes(data);
    }

    private static void runAnchor() {
        try {
            checkRoundTrip(0.0, 1.0, 2.0);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthFamily(t) && isThroughPatchedRegion(t)) {
                return;
            }
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        int meanInt = data.consumeInt(-1000000, 1000000);
        double mean = (double) meanInt;

        /* Contract asserted:
         * For a valid NormalDistributionImpl, inverseCumulativeProbability is the inverse of
         * cumulativeProbability on probabilities produced by the same distribution.
         * We construct p via cumulativeProbability(x) and then require inverseCumulativeProbability(p)
         * to recover x. A throw-deleting or branch-skipping patch in the bracketing path can silently
         * return a wrong quantile, which this round-trip detects.
         *
         * Hygiene: if either real library call throws, the relation does not apply and we skip.
         */
        checkRoundTrip(mean, 1.0, mean + 2.0);

        if (data.consumeBoolean()) {
            checkRoundTrip(mean, 1.0, mean + 2.0);
        }
    }

    private static void runInvalidInputProbes(FuzzedDataProvider data) {
        double mean = (double) data.consumeInt(-1000, 1000);

        double sigma;
        if (data.consumeBoolean()) {
            sigma = 0.0;
        } else {
            sigma = -(double) Math.abs(data.consumeInt());
        }

        try {
            new NormalDistributionImpl(mean, sigma);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
        }

        try {
            NormalDistributionImpl dist = new NormalDistributionImpl(mean, 1.0);
            double p;
            if (data.consumeBoolean()) {
                p = -Math.abs((double) data.consumeInt());
            } else {
                p = 1.0 + Math.abs((double) data.consumeInt());
            }
            dist.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthFamily(t) && isThroughPatchedRegion(t)) {
                return;
            }
        }
    }

    private static void checkRoundTrip(double mean, double sigma, double x) {
        try {
            NormalDistributionImpl dist = new NormalDistributionImpl(mean, sigma);
            double p = dist.cumulativeProbability(x);
            double q = dist.inverseCumulativeProbability(p);
            if (Math.abs(q - x) > 1.0e-12) {
                throw new RuntimeException(
                    "metamorphic violation: normal round-trip mean=" + mean +
                    " sigma=" + sigma +
                    " x=" + x +
                    " p=" + p +
                    " inverse=" + q);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && !(isGroundTruthFamily(t) || isCleanRejection(t))) {
                throw (RuntimeException) t;
            }
            if (t instanceof Error) {
                throw (Error) t;
            }
        }
    }

    private static boolean isGroundTruthFamily(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            String name = cur.getClass().getName();
            if ("org.apache.commons.math.MathException".equals(name)
                    || "org.apache.commons.math.ConvergenceException".equals(name)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal")
                    || name.contains("Invalid")
                    || name.contains("OutOfRange")
                    || name.contains("NotPositive")
                    || name.contains("NullArgument")) {
                return true;
            }
            if (hasFrame(cur, "org.apache.commons.math.MathRuntimeException", "createIllegalArgumentException")
                    || hasFrame(cur, "org.apache.commons.math.MathRuntimeException", "buildMessage")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isThroughPatchedRegion(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (hasFrame(cur, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils", "bracket")) {
                return true;
            }
            if (hasFrame(cur, "org.apache.commons.math.distribution.AbstractContinuousDistribution", "inverseCumulativeProbability")) {
                return true;
            }
            if (hasMethod(cur, "value")
                    || hasMethod(cur, "buildMessage")
                    || hasMethod(cur, "createIllegalArgumentException")) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasFrame(Throwable t, String cls, String method) {
        StackTraceElement[] frames = t.getStackTrace();
        for (int i = 0; i < frames.length; i++) {
            if (cls.equals(frames[i].getClassName()) && method.equals(frames[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasMethod(Throwable t, String method) {
        StackTraceElement[] frames = t.getStackTrace();
        for (int i = 0; i < frames.length; i++) {
            if (method.equals(frames[i].getMethodName())) {
                return true;
            }
        }
        return false;
    }
