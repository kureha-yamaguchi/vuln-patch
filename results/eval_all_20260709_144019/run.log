public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract used for the metamorphic check:
        // For a valid probability p in [0,1], inverseCumulativeProbability(p) returns x such that
        // cumulativeProbability(x) = p (up to numerical tolerance). If a patch merely suppresses the
        // buggy throw or returns the wrong quantile, this round-trip check will detect it.

        NormalDistribution anchorDist = new NormalDistributionImpl(0.0, 1.0);
        try {
            double anchorP = 0.9772498680518209d;
            double anchorX = anchorDist.inverseCumulativeProbability(anchorP);
            checkRoundTrip(anchorDist, anchorP, anchorX, "anchor");
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }

        int iterations = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < iterations; i++) {
            double mean = boundedFinite(data.consumeInt(), -1000.0, 1000.0);
            double sd = Math.abs(boundedFinite(data.consumeInt(), 1.0e-6, 1000.0)) + 1.0e-6;

            NormalDistribution dist;
            try {
                dist = new NormalDistributionImpl(mean, sd);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
                continue;
            }

            int mode = data.consumeInt(0, 4);
            double p;

            try {
                if (mode == 0) {
                    p = 0.9772498680518209d;
                } else if (mode == 1) {
                    double x = mean + 2.0 * sd;
                    p = dist.cumulativeProbability(x);
                } else if (mode == 2) {
                    int k = data.consumeInt(0, 12);
                    double x = mean + k * sd;
                    p = dist.cumulativeProbability(x);
                } else if (mode == 3) {
                    int numerator = Math.abs(data.consumeInt());
                    p = (numerator % 1000000) / 1000000.0;
                } else {
                    byte[] bytes = data.consumeBytes(8);
                    long acc = 0L;
                    for (byte b : bytes) {
                        acc = (acc << 8) ^ (b & 0xffL);
                    }
                    p = (acc & 0x1fffffffffffffL) / (double) 0x20000000000000L;
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
                continue;
            }

            if (!(p >= 0.0 && p <= 1.0) || Double.isNaN(p)) {
                continue;
            }

            try {
                double x = dist.inverseCumulativeProbability(p);
                checkRoundTrip(dist, p, x, "explore");
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
            }
        }
    }

    private static double boundedFinite(int seed, double min, double max) {
        double span = max - min;
        long u = ((long) seed) - (long) Integer.MIN_VALUE;
        double fraction = u / 4294967295.0d;
        return min + span * fraction;
    }

    private static void checkRoundTrip(NormalDistribution dist, double p, double x, String tag) {
        try {
            double p2 = dist.cumulativeProbability(x);
            double tol = Math.max(1.0e-12, Math.abs(p) * 1.0e-9);
            if (Double.isNaN(x) || Double.isNaN(p2) || Math.abs(p2 - p) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: cumulativeProbability(inverseCumulativeProbability(p))~=p tag="
                        + tag + " p=" + p + " x=" + x + " roundTrip=" + p2 + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof IllegalArgumentException || c instanceof NumberFormatException) {
                return true;
            }
            String name = c.getClass().getName();
            if (name.contains("IllegalArgument")
                || name.contains("NumberFormat")
                || name.contains("OutOfRange")
                || name.contains("Invalid")
                || name.contains("NoData")
                || name.contains("NullArgument")
                || name.contains("NotPositive")
                || name.contains("NotStrictlyPositive")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if ((c instanceof MathException || c instanceof RuntimeException) && hasBracketFrame(c)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasBracketFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(e.getClassName())
                && "bracket".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(e.getClassName())
                && "inverseCumulativeProbability".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
