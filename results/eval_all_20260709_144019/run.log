package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("", "foo", false, 1, '-', 1, 16);

        if (data.remainingBytes() == 0) {
            return;
        }

        String prefix = data.consumeString(32);
        int width = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xFF);
        boolean useNullObject = data.consumeBoolean();

        int minSourceLen = width + 1;
        int maxExtra = Math.min(32, Math.max(1, data.remainingBytes()));
        int sourceLen = minSourceLen + data.consumeInt(0, maxExtra);
        String seed = data.consumeString(sourceLen);
        String tail = data.consumeRemainingAsString();
        String source = normalizeLength(seed + tail, sourceLen);

        int exactCapacity = prefix.length() + width;
        int roomyCapacity = prefix.length() + Math.max(source.length(), width) + 16;

        runCase(prefix, source, useNullObject, width, padChar, exactCapacity, roomyCapacity);
    }

    private static void runCase(String prefix, String source, boolean useNullObject, int width, char padChar,
                                int exactCapacity, int roomyCapacity) {
        Object obj = useNullObject ? null : source;

        StrBuilder exact = new StrBuilder(Math.max(0, exactCapacity));
        if (useNullObject) {
            exact.setNullText(source);
        }
        try {
            exact.append(prefix);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        int oldLen = exact.length();
        String before;
        try {
            before = exact.toString();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        StrBuilder roomy = new StrBuilder(Math.max(roomyCapacity, prefix.length() + Math.max(source.length(), width) + 1));
        if (useNullObject) {
            roomy.setNullText(source);
        }
        try {
            roomy.append(prefix);
        } catch (RuntimeException t) {
            return;
        }

        String roomyOut;
        try {
            roomy.appendFixedWidthPadRight(obj, width, padChar);
            roomyOut = roomy.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        String exactOut;
        try {
            exact.appendFixedWidthPadRight(obj, width, padChar);
            exactOut = exact.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (exact.length() != oldLen + width) {
            throw new RuntimeException(
                "metamorphic violation: length must grow by width"
                    + " prefix=" + quote(before)
                    + " source=" + quote(source)
                    + " useNullObject=" + useNullObject
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " expectedLen=" + (oldLen + width)
                    + " actualLen=" + exact.length()
                    + " output=" + quote(exactOut));
        }

        /*
         * Contract exercised by the public API and visible in the method body:
         * appendFixedWidthPadRight appends exactly width visible characters derived from the
         * supplied object/nullText, and that observable result must not depend on internal
         * buffer capacity. A throw-deleting or branch-skipping patch could avoid the crash
         * while silently producing different output for the same logical call on a builder
         * with a different initial capacity.
         */
        if (!roomyOut.equals(exactOut)) {
            throw new RuntimeException(
                "metamorphic violation: capacity-independent appendFixedWidthPadRight output mismatch"
                    + " prefix=" + quote(before)
                    + " source=" + quote(source)
                    + " useNullObject=" + useNullObject
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " exactCapacity=" + exactCapacity
                    + " roomyCapacity=" + roomyCapacity
                    + " lhs=" + quote(exactOut)
                    + " rhs=" + quote(roomyOut));
        }
    }

    private static String normalizeLength(String s, int targetLen) {
        if (targetLen <= 0) {
            return "";
        }
        if (s == null) {
            s = "";
        }
        if (s.length() == targetLen) {
            return s;
        }
        if (s.length() > targetLen) {
            return s.substring(0, targetLen);
        }
        StringBuilder b = new StringBuilder(targetLen);
        b.append(s);
        while (b.length() < targetLen) {
            b.append('A');
        }
        return b.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
