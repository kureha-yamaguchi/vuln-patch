    private static void runExplore(FuzzedDataProvider data) {
        int n = data.consumeInt(4, 12);
        double[] objective = new double[n];
        objective[0] = 1.0;
        if (data.consumeBoolean()) {
            for (int i = 1; i < n; i++) {
                objective[i] = data.consumeInt(-2, 2);
            }
        }

        Collection<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        int geqCount = data.consumeInt(2, 4);
        for (int r = 0; r < geqCount; r++) {
            double[] a = new double[n];
            a[0] = 0.0;
            for (int i = 1; i < n; i++) {
                a[i] = data.consumeInt(1, 100);
            }
            double rhs = data.consumeInt(1, 100);
            constraints.add(new LinearConstraint(a, Relationship.GEQ, rhs));
        }

        int mixedCount = data.consumeInt(1, 4);
        for (int r = 0; r < mixedCount; r++) {
            double[] a = new double[n];
            a[0] = data.consumeInt(1, 100);
            for (int i = 1; i < n; i++) {
                a[i] = -data.consumeInt(1, 100);
            }
            int pick = data.consumeInt(0, 2);
            Relationship rel = pick == 0 ? Relationship.LEQ : (pick == 1 ? Relationship.EQ : Relationship.GEQ);
            double rhs = data.consumeInt(-20, 120);
            constraints.add(new LinearConstraint(a, rel, rhs));
        }

        int extras = data.consumeInt(0, 3);
        for (int r = 0; r < extras; r++) {
            double[] a = new double[n];
            for (int i = 0; i < n; i++) {
                a[i] = data.consumeInt(-5, 5);
            }
            Relationship rel = data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ;
            double rhs = data.consumeInt(-20, 120);
            constraints.add(new LinearConstraint(a, rel, rhs));
        }

        executeAndCheck(objective, constraints, false);
    }

    private static void executeAndCheck(double[] objective, Collection<LinearConstraint> constraints, boolean anchored) {
        try {
            SimplexSolver solver = new SimplexSolver();
            PointValuePair p1 = solver.optimize(
                    new LinearObjectiveFunction(objective, 0.0),
                    constraints,
                    GoalType.MAXIMIZE,
                    true);

            /*
             * Metamorphic relation: maximizing k*f over the same feasible region for any k>0
             * must scale the optimal objective value by k. This follows from linear programming:
             * multiplying the objective by a positive constant does not change the ordering of
             * feasible points. A patch that only suppresses the bad pivot-row behavior can silently
             * return a wrong optimum/value and break this relation even when no exception is thrown.
             * Per harness hygiene, if either optimization throws, the check is skipped.
             */
            try {
                double[] scaled = new double[objective.length];
                for (int i = 0; i < objective.length; i++) {
                    scaled[i] = 2.0 * objective[i];
                }
                SimplexSolver solver2 = new SimplexSolver();
                PointValuePair p2 = solver2.optimize(
                        new LinearObjectiveFunction(scaled, 0.0),
                        constraints,
                        GoalType.MAXIMIZE,
                        true);
                if (p1 != null && p2 != null) {
                    double lhs = p2.getValue();
                    double rhs = 2.0 * p1.getValue();
                    if (Double.isFinite(lhs) && Double.isFinite(rhs) && Math.abs(lhs - rhs) > EPS * Math.max(1.0, Math.max(Math.abs(lhs), Math.abs(rhs)))) {
                        throw new RuntimeException("metamorphic violation: positive-objective-scaling objectiveLength="
                                + objective.length + " anchored=" + anchored + " lhs=" + lhs + " rhs=" + rhs);
                    }
                }
            } catch (Throwable t) {
                if (isMetamorphicViolation(t) || isRootCause(t)) {
                    throw t;
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
