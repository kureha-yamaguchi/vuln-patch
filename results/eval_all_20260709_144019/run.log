            callAndMaybePropagate(base);
            callAndMaybePropagate(flipAsciiCase(base));
            callAndMaybePropagate(base + fuzzAscii);
            callAndMaybePropagate(fuzzAscii + base);
            callAndMaybePropagate(insertAt(base, fuzzAscii, data.consumeInt()));
