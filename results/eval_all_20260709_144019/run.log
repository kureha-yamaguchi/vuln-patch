package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        BisectionSolver solver = new BisectionSolver();
        SinFunction f = new SinFunction();
        try {
            double result = solver.solve(f, 3.0, 3.2, 3.1);
            double tol = Math.max(solver.getAbsoluteAccuracy() * 4.0, 1.0e-8);
            if (Math.abs(result - Math.PI) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: anchored sine root not recovered input=[3.0,3.2], initial=3.1 result="
                        + result + " expected=" + Math.PI);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        SinFunction f = new SinFunction();

        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int widthSteps = data.consumeInt(1, 1_000_000);
        double minWidth = 1.0e-6;
        double maxWidth = (Math.PI / 2.0) - 1.0e-6;
        double width = minWidth + (maxWidth - minWidth) * (widthSteps / 1_000_000.0);

        double min = root - width;
        double max = root + width;

        int initSteps = data.consumeInt(0, 1_000_000);
        double initial = min + (max - min) * (initSteps / 1_000_000.0);

        BisectionSolver solverWithInitial = new BisectionSolver();
        try {
            double result = solverWithInitial.solve(f, min, max, initial);

            double tol = Math.max(solverWithInitial.getAbsoluteAccuracy() * 4.0, 1.0e-8);
            if (!Double.isNaN(result) && !Double.isInfinite(result) && Math.abs(result - root) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: unique sine root not recovered input=["
                        + min + "," + max + "], initial=" + initial
                        + " result=" + result + " expected=" + root);
            }
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        /*
         * Contract asserted: both solve(f, min, max) and solve(f, min, max, initial)
         * are solver entrypoints for finding a zero in the same interval. For the
         * intervals constructed here, SinFunction has exactly one zero (k*pi) in
         * [min, max], so any correct implementation must return that same unique root
         * regardless of the initial guess. A patch that merely avoids the crash by
         * skipping the real delegated call or returning an unrelated value would break
         * this equivalence.
         *
         * Hygiene rule: if either side throws, the relation does not apply and we return.
         */
        BisectionSolver solverA = new BisectionSolver();
        BisectionSolver solverB = new BisectionSolver();
        double lhs;
        double rhs;
        try {
            lhs = solverA.solve(f, min, max, initial);
            rhs = solverB.solve(f, min, max);
        } catch (Throwable t) {
            handleThrowable(t);
            return;
        }

        double relationTol = Math.max(Math.max(solverA.getAbsoluteAccuracy(), solverB.getAbsoluteAccuracy()) * 4.0, 1.0e-8);
        if (!Double.isNaN(lhs) && !Double.isNaN(rhs)
                && !Double.isInfinite(lhs) && !Double.isInfinite(rhs)
                && Math.abs(lhs - rhs) > relationTol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input=["
                    + min + "," + max + "], initial=" + initial
                    + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void handleThrowable(Throwable t) {
        if (t instanceof RuntimeException) {
            if (t instanceof NullPointerException && isPatchedRegion(t)) {
                throw (RuntimeException) t;
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            return;
        }
        return;
    }

    private static boolean isPatchedRegion(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                    && "solve".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
