package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkExact(DurationFieldType.months(), -1, 2, 29, 1, 29);
        checkExact(DurationFieldType.months(), 1, 2, 29, 3, 29);
        checkExact(DurationFieldType.months(), -1, 3, 31, 2, 29);
        checkExact(DurationFieldType.days(), 1, 2, 29, 3, 1);

        int month = data.consumeInt(1, 12);
        int maxDay = new LocalDate(2000, month, 1, org.joda.time.chrono.ISOChronology.getInstanceUTC())
                .dayOfMonth().getMaximumValue();

        int day;
        if (data.consumeBoolean()) {
            int delta = data.consumeInt(0, 3);
            day = maxDay - delta;
            if (day < 1) {
                day = 1;
            }
        } else {
            day = data.consumeInt(1, maxDay);
        }

        int amount = data.consumeInt(-48, 48);
        if (amount == 0) {
            amount = data.consumeBoolean() ? 1 : -1;
        }

        MonthDay start = new MonthDay(month, day, org.joda.time.chrono.ISOChronology.getInstanceUTC());

        if (data.consumeBoolean()) {
            compareWithConvenience(start, DurationFieldType.months(), amount);
            compareInverseMonths(start, amount);
        } else {
            compareWithConvenience(start, DurationFieldType.days(), amount);
            compareInverseDays(start, amount);
        }
    }

    /*
     * Contract asserted:
     * - MonthDay.withFieldAdded(months|days, n) is the underlying public API used by the
     *   convenience methods and must produce the same observable MonthDay as plusMonths/plusDays.
     * - plusMonths(n) and minusMonths(-n) are equivalent public operations.
     * - plusDays(n) and minusDays(-n) are equivalent public operations.
     *
     * A throw-deleting or branch-skipping patch can silently return the wrong MonthDay while avoiding
     * the historical exception. These checks catch that by comparing real library calls.
     * For the anchor cases, the expected outputs come directly from the project tests and are valid by
     * construction, so rejecting them is itself a bug.
     */
    private static void checkExact(DurationFieldType fieldType, int amount,
                                   int startMonth, int startDay,
                                   int expectedMonth, int expectedDay) {
        MonthDay input = new MonthDay(startMonth, startDay, org.joda.time.chrono.ISOChronology.getInstanceUTC());
        MonthDay expected = new MonthDay(expectedMonth, expectedDay, org.joda.time.chrono.ISOChronology.getInstance());

        try {
            MonthDay actual = input.withFieldAdded(fieldType, amount);
            if (!actual.equals(expected)) {
                throw new RuntimeException(
                        "metamorphic violation: exact oracle input=" + input +
                        " fieldType=" + fieldType +
                        " amount=" + amount +
                        " expected=" + expected +
                        " actual=" + actual);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t) && isPatchedRegion(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid MonthDay rejected input=" + input +
                        " fieldType=" + fieldType +
                        " amount=" + amount, t);
            }
        }
    }

    private static void compareWithConvenience(MonthDay start, DurationFieldType fieldType, int amount) {
        try {
            MonthDay viaTarget = start.withFieldAdded(fieldType, amount);
            MonthDay viaConvenience;
            if (fieldType == DurationFieldType.months()) {
                viaConvenience = start.plusMonths(amount);
            } else {
                viaConvenience = start.plusDays(amount);
            }
            if (!viaTarget.equals(viaConvenience)) {
                throw new RuntimeException(
                        "metamorphic violation: withFieldAdded vs convenience start=" + start +
                        " fieldType=" + fieldType +
                        " amount=" + amount +
                        " lhs=" + viaTarget +
                        " rhs=" + viaConvenience);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t) && isPatchedRegion(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid equivalence rejected start=" + start +
                        " fieldType=" + fieldType +
                        " amount=" + amount, t);
            }
        }
    }

    private static void compareInverseMonths(MonthDay start, int amount) {
        try {
            MonthDay lhs = start.plusMonths(amount);
            MonthDay rhs = start.minusMonths(-amount);
            if (!lhs.equals(rhs)) {
                throw new RuntimeException(
                        "metamorphic violation: plusMonths(n) == minusMonths(-n) start=" + start +
                        " amount=" + amount +
                        " lhs=" + lhs +
                        " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t) && isPatchedRegion(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid month arithmetic rejected start=" + start +
                        " amount=" + amount, t);
            }
        }
    }

    private static void compareInverseDays(MonthDay start, int amount) {
        try {
            MonthDay lhs = start.plusDays(amount);
            MonthDay rhs = start.minusDays(-amount);
            if (!lhs.equals(rhs)) {
                throw new RuntimeException(
                        "metamorphic violation: plusDays(n) == minusDays(-n) start=" + start +
                        " amount=" + amount +
                        " lhs=" + lhs +
                        " rhs=" + rhs);
