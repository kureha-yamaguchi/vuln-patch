    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        s.getIndex(start);
        s.getIndex(end);

        TimeSeries copy = s.createCopy(start, end);
        if (copy != null && copy.getItemCount() != 0) {
            throw new RuntimeException(
                "metamorphic violation: anchor gap copy must be empty itemCount=" + copy.getItemCount());
        }

        Day beforeFirst = new Day(18, 8, 2005);
        s.getIndex(beforeFirst);
        TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
        if (empty != null && empty.getItemCount() != 0) {
            throw new RuntimeException(
                "metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
        }
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i < ords.length - 1; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static Day dayFromOrdinal(int ordinal) {
        int year = 1900 + (ordinal / (28 * 12));
        int withinYear = ordinal % (28 * 12);
        int month = (withinYear / 28) + 1;
        int day = (withinYear % 28) + 1;
        return new Day(day, month, year);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
