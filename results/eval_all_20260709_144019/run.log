            }

            for (int r = 0; r < bigRows; r++) {
                for (int c = 0; c < bigCols; c++) {
                    if (bigProd.getEntry(r, c).compareTo(bigA.getEntry(r, c)) != 0) {
                        throw new RuntimeException("metamorphic violation: BigMatrixImpl A*I == A");
