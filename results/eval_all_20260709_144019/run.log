public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1234.5");

        String sign = data.consumeBoolean() ? "-" : "";
        String intPart = data.consumeAsciiString(12);
        String fracPart = data.consumeAsciiString(12);
        String expPart = data.consumeAsciiString(12);
        int mode = data.consumeInt(0, 8);

        if (intPart.length() == 0) {
            intPart = String.valueOf(Math.abs(data.consumeInt()));
        }
        if (fracPart.length() == 0 && data.consumeBoolean()) {
            fracPart = String.valueOf(Math.abs(data.consumeInt(0, 999999)));
        }

        String candidate;
        switch (mode) {
            case 0:
                candidate = sign + intPart + "." + fracPart;
                break;
            case 1:
                candidate = sign + intPart + ".";
                break;
            case 2:
                candidate = sign + intPart + "." + fracPart + "e";
                break;
            case 3:
                candidate = sign + intPart + "." + fracPart + "E";
                break;
            case 4:
                candidate = sign + intPart + "." + fracPart + (data.consumeBoolean() ? "f" : "F");
                break;
            case 5:
                candidate = sign + intPart + "." + fracPart + (data.consumeBoolean() ? "d" : "D");
                break;
            case 6:
                candidate = sign + intPart + (data.consumeBoolean() ? "e" : "E") + expPart;
                break;
            case 7:
                candidate = sign + intPart + (data.consumeBoolean() ? "l" : "L");
                break;
            default:
                candidate = data.consumeRemainingAsString();
                break;
        }

        try {
            NumberUtils.createNumber(candidate);
        } catch (NumberFormatException expected) {
        }

        String decimalNoExp = sign + intPart + "." + fracPart;
        try {
            NumberUtils.createNumber(decimalNoExp);
