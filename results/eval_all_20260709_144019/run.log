    private static void checkAnchorContracts() {
        Class<?>[] nullResult = ClassUtils.toClass(null);
        if (nullResult != null) {
            throw new RuntimeException("metamorphic violation: toClass(null) should return null");
        }

        Class<?>[] emptyResult = ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        if (emptyResult != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("metamorphic violation: toClass(empty) should return EMPTY_CLASS_ARRAY");
        }

        Class<?>[] normalResult = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        if (normalResult == null
                || normalResult.length != 3
                || normalResult[0] != String.class
                || normalResult[1] != Integer.class
                || normalResult[2] != Double.class) {
            throw new RuntimeException("metamorphic violation: unexpected anchor mapping "
                    + Arrays.toString(normalResult));
        }
    }

    private static void checkAnchorBehavior() {
        try {
            Class<?>[] result = ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });
            if (result == null
                    || result.length != 3
                    || result[0] != String.class
                    || result[1] != null
                    || result[2] != Double.class) {
                throw new RuntimeException("metamorphic violation: anchor null-element mapping lhs="
                        + Arrays.toString(result) + " rhs=[class java.lang.String, null, class java.lang.Double]");
            }
        } catch (RuntimeException e) {
            if (isBuggyNullElementCrash(e)) {
                return;
            }
            throw e;
        }
    }

    private static void exerciseToClass(Object[] array) {
        Class<?>[] direct;
        try {
            direct = ClassUtils.toClass(array);
        } catch (RuntimeException e) {
            if (isCleanRejection(e) || isBuggyNullElementCrash(e)) {
                return;
            }
            return;
        }

        if (direct == null || direct.length != array.length) {
            throw new RuntimeException("metamorphic violation: result shape input="
                    + Arrays.deepToString(array) + " result=" + Arrays.toString(direct));
        }

        /* Contract visible in ClassUtils.toClass: output[i] is array[i].getClass() for non-null
         * elements, and the patch preserves null elements as null. A throw-deleting or
         * branch-skipping patch would break this observable mapping. */
        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (direct[i] != expected) {
                throw new RuntimeException("metamorphic violation: elementwise mapping input="
                        + Arrays.deepToString(array) + " index=" + i + " lhs=" + direct[i] + " rhs=" + expected);
            }
        }

        int split = array.length == 0 ? 0 : array.length / 2;
        Object[] left = ArrayUtils.subarray(array, 0, split);
        Object[] right = ArrayUtils.subarray(array, split, array.length);

        try {
            /* The method transforms each element independently, so toClass(left + right)
             * must equal toClass(left) + toClass(right) for every correct implementation. */
            Class<?>[] whole = ClassUtils.toClass(ArrayUtils.addAll(left, right));
            Class<?>[] parts = ArrayUtils.addAll(ClassUtils.toClass(left), ClassUtils.toClass(right));
            if (!Arrays.equals(whole, parts)) {
                throw new RuntimeException("metamorphic violation: composition input="
                        + Arrays.deepToString(array) + " lhs=" + Arrays.toString(whole)
                        + " rhs=" + Arrays.toString(parts));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e) || isBuggyNullElementCrash(e)) {
                return;
            }
        }

        try {
            /* Cloning an Object[] preserves elements and order, so the class mapping must be
             * identical. A patch that silently drops bookkeeping or skips null handling would
             * violate this relation without necessarily throwing. */
            Object[] clone = ArrayUtils.clone(array);
            Class<?>[] cloned = ClassUtils.toClass(clone);
            if (!Arrays.equals(direct, cloned)) {
                throw new RuntimeException("metamorphic violation: clone equivalence input="
                        + Arrays.deepToString(array) + " lhs=" + Arrays.toString(direct)
                        + " rhs=" + Arrays.toString(cloned));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e) || isBuggyNullElementCrash(e)) {
                return;
            }
        }
    }

    private static void exerciseGetClass(Object[] array, FuzzedDataProvider data) {
        ClassLoader cl = Thread.currentThread().getContextClassLoader();
        if (cl == null) {
