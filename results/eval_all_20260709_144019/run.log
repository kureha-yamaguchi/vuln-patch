        double candidate = outsideDefaultBounds(data);
        Paint p1 = gps.getPaint(candidate);
        Paint p2 = gps.getPaint(clamp01(candidate));

        // Metamorphic relation implied by the implementation contract:
        // for any correct implementation, getPaint(v) == getPaint(clamp(v, 0, 1)).
        if (!p1.equals(p2)) {
