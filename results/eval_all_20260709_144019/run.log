package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            StringUtils.join((Object[]) null, ',');
        } catch (RuntimeException t) {
            if (isRelevantRootCause(t)) {
                return;
            }
        }

        try {
            StringUtils.join((Object[]) null);
            StringUtils.join((Object) null);
        } catch (RuntimeException t) {
            if (isRelevantRootCause(t)) {
                return;
            }
        }

        int size = data.consumeInt(0, 8);
        Object[] array = new Object[size];
        for (int i = 0; i < size; i++) {
            if (data.consumeBoolean()) {
                array[i] = null;
            } else {
                array[i] = data.consumeString(32);
            }
        }

        int startIndex = data.consumeInt(0, size);
        int endIndex = data.consumeInt(0, size);
        if (startIndex > endIndex) {
            int tmp = startIndex;
            startIndex = endIndex;
            endIndex = tmp;
        }

        char separatorChar = (char) (data.consumeByte() & 0xFF);
        String separatorString = String.valueOf(separatorChar);

        try {
            StringUtils.join(array, separatorChar, startIndex, endIndex);
        } catch (RuntimeException t) {
            if (isRelevantRootCause(t)) {
                return;
            }
        }

        try {
            StringUtils.join(array, separatorString, startIndex, endIndex);
        } catch (RuntimeException t) {
            if (isRelevantRootCause(t)) {
                return;
            }
        }

        /* Contract/metamorphic check:
           For any valid array slice and any one-character separator, the char overload and
           the String overload execute the same join logic and must produce identical results.
           A patch that merely suppresses the crash or skips intended appends can make the
           methods diverge or return silently wrong output. Null elements are valid by
           construction here because the implementation explicitly handles them in the loop. */
        String lhs;
        String rhs;
        try {
            lhs = StringUtils.join(array, separatorChar, startIndex, endIndex);
            rhs = StringUtils.join(array, separatorString, startIndex, endIndex);
        } catch (Throwable ignored) {
            return;
        }
        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "metamorphic violation: char-vs-string separator equivalence inputSize=" + size
                    + " start=" + startIndex
                    + " end=" + endIndex
                    + " sepChar=" + (int) separatorChar
                    + " lhs=" + lhs
                    + " rhs=" + rhs);
        }

        /* Additional contract check:
           The String separator overload treats a null separator as EMPTY, so joining with
           null separator must equal joining with the empty string on the same valid slice. */
        String nullSepResult;
        String emptySepResult;
        try {
            nullSepResult = StringUtils.join(array, (String) null, startIndex, endIndex);
            emptySepResult = StringUtils.join(array, "", startIndex, endIndex);
        } catch (Throwable ignored) {
            return;
        }
        if (nullSepResult == null ? emptySepResult != null : !nullSepResult.equals(emptySepResult)) {
            throw new RuntimeException(
                "metamorphic violation: null-separator-equals-empty inputSize=" + size
                    + " start=" + startIndex
                    + " end=" + endIndex
                    + " lhs=" + nullSepResult
                    + " rhs=" + emptySepResult);
        }
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("join".equals(method) || "length".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.AnnotationUtils".equals(cls)
                    && "toString".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
