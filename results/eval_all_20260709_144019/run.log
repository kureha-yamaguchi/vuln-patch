        String[] seeds = new String[] {
            "12345",
            "1234.5D",
            "1234.5d",
            "1234.5F",
            "1234.5f",
            "12345L",
            "12345l",
            "-1234.5",
            "-12345",
            "0xFADE",
            "-0xFADE",
            "1.1E200",
            "1.1E20",
            "-1.1E200",
            "1.1E-200",
            "12345678901234567890L",
            "1.1E-700F",
            "2.",
            "1eE",
            "-1l",
            "01l",
            "1l"
        };
        for (int i = 0; i < seeds.length; i++) {
            exercise(seeds[i]);
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String left = digitize(data.consumeAsciiString(data.consumeInt(0, 16)));
        String right = digitize(data.consumeAsciiString(data.consumeInt(0, 16)));
        String expDigits = digitize(data.consumeAsciiString(data.consumeInt(0, 8)));
        if (left.length() == 0) {
            left = "0";
        }

        String suffix = "";
        switch (data.consumeInt(0, 6)) {
            case 1:
                suffix = "F";
                break;
            case 2:
                suffix = "f";
                break;
            case 3:
                suffix = "D";
                break;
            case 4:
                suffix = "d";
                break;
            case 5:
                suffix = "L";
                break;
            case 6:
                suffix = "l";
                break;
            default:
                break;
        }

        int mode = data.consumeInt(0, 8);
        String candidate;
        switch (mode) {
            case 0:
                candidate = sign + left + "." + right;
                break;
            case 1:
                candidate = sign + left + "." + right + suffix;
                break;
            case 2:
                candidate = sign + left + (data.consumeBoolean() ? "e" : "E");
                break;
            case 3:
                candidate = sign + left + (data.consumeBoolean() ? "e" : "E") + expDigits;
                break;
            case 4:
                candidate = sign + left + "." + right + (data.consumeBoolean() ? "e" : "E");
                break;
            case 5:
                candidate = sign + left + "." + right + (data.consumeBoolean() ? "e" : "E") + expDigits;
                break;
            case 6:
                candidate = sign + left + "." + right + (data.consumeBoolean() ? "e" : "E") + expDigits + suffix;
                break;
            case 7:
                candidate = sign + left + suffix;
                break;
            default:
                candidate = data.consumeString(24);
                break;
        }
        exercise(candidate);

        String trailingExpDecimal = sign + left + "." + right + (data.consumeBoolean() ? "e" : "E");
        exercise(trailingExpDecimal);

        String noExpDecimal = sign + left + "." + right;
        exercise(noExpDecimal);

        String sciLower = sign + left + "e" + (expDigits.length() == 0 ? "0" : expDigits);
        String sciUpper = sign + left + "E" + (expDigits.length() == 0 ? "0" : expDigits);
