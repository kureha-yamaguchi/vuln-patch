package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();
        exerciseExplore(data);
    }

    private static void exerciseAnchor() {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0.0, 1.0);
            double p = 0.9772498680518209;
            double x = normal.inverseCumulativeProbability(p);
            checkInverseOracle(normal, p, 2.0, x, "anchor");
        } catch (Throwable t) {
            handleThrowable(t, "anchor");
        }
    }

    private static void exerciseExplore(FuzzedDataProvider data) {
        double mean = data.consumeInt(-1000, 1000);
        int sigmaScale = data.consumeInt(1, 1000);
        double sigma = sigmaScale / 10.0;

        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(mean, sigma);

            /*
             * Contract/oracle used:
             * inverseCumulativeProbability(p) is the inverse of cumulativeProbability(p)
             * for valid probabilities. We construct p using the real library itself as
             * p = CDF(expected), so a correct implementation must recover expected.
             *
             * Choosing expected = mean + 2*sigma steers execution through the real
             * inverse-CDF path that reaches UnivariateRealSolverUtils.bracket; on the
             * buggy version this valid input can be rejected when one bracket endpoint
             * evaluates to exactly zero.
             */
            double expected = mean + (2.0 * sigma);
            double p = normal.cumulativeProbability(expected);
            double actual = normal.inverseCumulativeProbability(p);
            checkInverseOracle(normal, p, expected, actual, "explore");
        } catch (Throwable t) {
            handleThrowable(t, "explore");
        }
    }

    private static void checkInverseOracle(NormalDistributionImpl normal, double p, double expected, double actual, String where) throws MathException {
        if (!Double.isFinite(actual) || !approximatelyEqual(expected, actual)) {
            throw new RuntimeException(
                "metamorphic violation: inverse(cdf(x)) != x where=" + where +
                " p=" + p + " expected=" + expected + " actual=" + actual);
        }

        /*
         * Additional round-trip relation using only real library calls:
         * for valid p and x = inverseCumulativeProbability(p), cumulativeProbability(x)
         * must return the original p.
         */
        double roundTrip = normal.cumulativeProbability(actual);
        if (!Double.isFinite(roundTrip) || Math.abs(roundTrip - p) > 1.0e-12) {
            throw new RuntimeException(
                "metamorphic violation: cdf(inverse(p)) != p where=" + where +
                " p=" + p + " actual=" + actual + " roundTrip=" + roundTrip);
        }
    }

    private static boolean approximatelyEqual(double a, double b) {
        double tol = 1.0e-12 * Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= tol;
    }

    private static void handleThrowable(Throwable t, String where) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCauseFromPatchedRegion(t)) {
            throw new RuntimeException(
                "metamorphic violation: inverseCumulativeProbability rejected valid probability where=" +
                where + " cause=" + t.getClass().getName() + ": " + t.getMessage(), t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Illegal")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCauseFromPatchedRegion(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException) {
                for (StackTraceElement ste : cur.getStackTrace()) {
                    String cls = ste.getClassName();
                    String method = ste.getMethodName();
                    if (cls.equals("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils")
                            && method.equals("bracket")) {
                        return true;
                    }
                    if (cls.equals("org.apache.commons.math.distribution.AbstractContinuousDistribution")
                            && method.equals("inverseCumulativeProbability")) {
                        return true;
                    }
                    if (cls.equals("org.apache.commons.math.MathRuntimeException")
                            && (method.equals("createIllegalArgumentException") || method.equals("buildMessage"))) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }
}
