     * when obj == null, appendFixedWidthPadRight uses getNullText() as the source string.
     * Therefore, after setting a non-null nullText, appending null must behave exactly like
     * appending that same string explicitly. This directly exercises the getNullText path.
     */
    private static void checkNullTextEquivalence(String prefix, String nullText, int width, char padChar) {
        StrBuilder viaNull = new StrBuilder(prefix.length() + nullText.length() + width + 8);
        StrBuilder viaExplicit = new StrBuilder(prefix.length() + nullText.length() + width + 8);

        try {
