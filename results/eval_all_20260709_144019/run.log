package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        double mean = finiteDoubleFromInt(data.consumeInt(), 8.0);
        double sd = positiveScaleFromInt(data.consumeInt());
        NormalDistribution normal;
        try {
            normal = new NormalDistributionImpl(mean, sd);
        } catch (RuntimeException e) {
            return;
        }

        exploreConstructedProbabilities(data, normal, mean, sd);
        exploreSeedLikeProbabilities(data, normal, mean, sd);
    }

    private static void anchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);
            double x = normal.inverseCumulativeProbability(0.9772498680518209d);
            if (!approximatelyEqual(x, 2.0d, 1.0e-12d)) {
                throw new RuntimeException("metamorphic violation: anchor inverseCumulativeProbability(0.9772498680518209) input=0.9772498680518209 lhs=" + x + " rhs=2.0");
            }
        } catch (Throwable t) {
            if (isRootCauseThrowable(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void exploreConstructedProbabilities(FuzzedDataProvider data, NormalDistribution normal, double mean, double sd) {
        int trials = 1 + Math.max(0, Math.min(8, data.remainingBytes()));
        for (int i = 0; i < trials; i++) {
            int k = data.consumeInt(-8, 8);
            double xKnown = mean + sd * k;
            double p;
            try {
                p = normal.cumulativeProbability(xKnown);
            } catch (Throwable t) {
                continue;
            }

            try {
                double inv = normal.inverseCumulativeProbability(p);

                /*
                 * Contract used: for a distribution inverse, inverseCumulativeProbability(cumulativeProbability(x))
                 * should recover x for values built from the same real distribution API, up to numerical tolerance.
                 * A throw-deleting or branch-skipping patch in bracket can silently return a wrong quantile instead of
                 * rejecting or finding the exact bracketed root; this check catches that observable misbehaviour.
                 */
                if (!approximatelyEqual(inv, xKnown, toleranceFor(xKnown, sd))) {
                    throw new RuntimeException(
                        "metamorphic violation: inverse(cdf(x))~=x input=" + xKnown +
                        " p=" + p + " lhs=" + inv + " rhs=" + xKnown +
                        " mean=" + mean + " sd=" + sd + " k=" + k
                    );
                }

                double pRoundTrip;
                try {
                    pRoundTrip = normal.cumulativeProbability(inv);
                } catch (Throwable t) {
                    continue;
                }

                /*
                 * Contract used: cumulativeProbability(inverseCumulativeProbability(p)) should recover p for valid
                 * probabilities produced by cumulativeProbability itself. This is another observable consequence of a
                 * correct inverse implementation and detects silent wrong outputs if the exception path is removed.
                 */
                if (!approximatelyEqual(pRoundTrip, p, 1.0e-12d)) {
                    throw new RuntimeException(
                        "metamorphic violation: cdf(inverse(p))~=p input=" + p +
                        " lhs=" + pRoundTrip + " rhs=" + p +
                        " inv=" + inv + " mean=" + mean + " sd=" + sd + " k=" + k
                    );
                }
            } catch (Throwable t) {
                if (isRootCauseThrowable(t)) {
                    throwUnchecked(t);
                }
            }
        }
    }

    private static void exploreSeedLikeProbabilities(FuzzedDataProvider data, NormalDistribution normal, double mean, double sd) {
        double base;
        try {
            base = normal.cumulativeProbability(mean + 2.0d * sd);
        } catch (Throwable t) {
            return;
        }

        int variants = 1 + Math.max(0, Math.min(8, data.remainingBytes()));
        for (int i = 0; i < variants; i++) {
            int mode = data.consumeInt(0, 3);
            double p = base;
            if (mode == 1) {
                p = Math.nextAfter(base, 0.0d);
            } else if (mode == 2) {
                p = Math.nextAfter(base, 1.0d);
            } else if (mode == 3) {
                int steps = 1 + Math.abs(data.consumeByte());
                boolean up = data.consumeBoolean();
                for (int s = 0; s < steps; s++) {
                    p = Math.nextAfter(p, up ? 1.0d : 0.0d);
                }
            }

            if (!(p > 0.0d && p < 1.0d) || Double.isNaN(p)) {
                continue;
            }

            try {
                double inv = normal.inverseCumulativeProbability(p);
                double p2;
                try {
                    p2 = normal.cumulativeProbability(inv);
                } catch (Throwable t) {
                    continue;
                }

                /*
                 * Contract used: for valid probabilities strictly inside (0,1), applying inverse then cumulative
                 * probability should recover the original probability. Using probabilities near cdf(mean+2*sd)
                 * exercises the same boundary-root property as the bug-triggering seed while varying surrounding
                 * floating-point neighbourhood.
                 */
                if (!approximatelyEqual(p2, p, 1.0e-12d)) {
                    throw new RuntimeException(
                        "metamorphic violation: near-seed cdf(inverse(p))~=p input=" + p +
                        " lhs=" + p2 + " rhs=" + p +
                        " inv=" + inv + " mean=" + mean + " sd=" + sd
                    );
                }
            } catch (Throwable t) {
                if (isRootCauseThrowable(t)) {
                    throwUnchecked(t);
                }
            }
        }
    }

    private static boolean isRootCauseThrowable(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls) && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls) && "createIllegalArgumentException".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathException".equals(cls) && "buildMessage".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static double finiteDoubleFromInt(int v, double scale) {
        return ((double) v) / scale;
    }

    private static double positiveScaleFromInt(int v) {
        int mag = Math.abs(v % 1000) + 1;
        return ((double) mag) / 100.0d;
    }

    private static double toleranceFor(double x, double sd) {
        double ax = Math.abs(x);
        double asd = Math.abs(sd);
        return 1.0e-12d * Math.max(1.0d, Math.max(ax, asd));
    }

    private static boolean approximatelyEqual(double a, double b, double tol) {
        return Math.abs(a - b) <= tol;
    }
}
