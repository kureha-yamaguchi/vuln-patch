            }
        } else {
            if (size1 != 0.0 || size2 != 0.0) {
                throw new RuntimeException("metamorphic violation: empty leaf must have zero size lhs=" + size1 + " rhs=" + size2);
            }
            if (!isZeroPoint(bary1) || !isZeroPoint(bary2)) {
                throw new RuntimeException("metamorphic violation: empty leaf must have zero barycenter lhs=" + pointString(bary1) + " rhs=" + pointString(bary2));
            }
