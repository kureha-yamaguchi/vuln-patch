            Paint p1 = gps.getPaint(1.0);
            Paint pn = gps.getPaint(-0.5);
            Paint po = gps.getPaint(1.5);

            if (!(p0 instanceof Color) || !Color.black.equals(p0)) {
                throw new RuntimeException("metamorphic violation: anchor 0.0 must map to black input=0.0 got=" + p0);
            }
            if (!(p1 instanceof Color) || !Color.white.equals(p1)) {
                throw new RuntimeException("metamorphic violation: anchor 1.0 must map to white input=1.0 got=" + p1);
            }
            if (!(pn instanceof Color) || !Color.black.equals(pn)) {
                throw new RuntimeException("metamorphic violation: lower-bound clamping input=-0.5 got=" + pn + " expected=" + Color.black);
            }
            if (!(po instanceof Color) || !Color.white.equals(po)) {
                throw new RuntimeException("metamorphic violation: upper-bound clamping input=1.5 got=" + po + " expected=" + Color.white);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            throw t;
