     * internal buffer capacity. A throw-deleting or branch-skipping patch could avoid the
     * original exception yet still produce different output for small vs large buffers.
     */
    private static void checkCapacityInvariantSeed() {
        checkCapacityInvariant("", "foo", 1, '-', 1);
    }

    private static void checkCapacityInvariant(String prefix, String source, int width, char padChar, int tinyCapacity) {
        StrBuilder small = new StrBuilder(tinyCapacity);
        StrBuilder large = new StrBuilder(prefix.length() + source.length() + width + 8);

        try {
            small.append(prefix);
            large.append(prefix);
        } catch (RuntimeException t) {
            return;
        }

        String expected;
        try {
            large.appendFixedWidthPadRight(source, width, padChar);
            expected = large.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                return;
            }
            return;
        }

        try {
            small.appendFixedWidthPadRight(source, width, padChar);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight must be capacity-invariant"
                        + " prefix=" + quote(prefix)
                        + " source=" + quote(source)
                        + " width=" + width
                        + " pad=" + (int) padChar
                        + " tinyCapacity=" + tinyCapacity
                        + " expected=" + quote(expected),
                    t);
            }
            return;
        }

        String actual;
        try {
            actual = small.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (small.length() != prefix.length() + width) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight must increase length by width"
                    + " prefix=" + quote(prefix)
                    + " source=" + quote(source)
                    + " width=" + width
                    + " tinyCapacity=" + tinyCapacity
                    + " actualLength=" + small.length()
                    + " output=" + quote(actual));
        }

        if (!expected.equals(actual)) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight result changed with capacity"
                    + " prefix=" + quote(prefix)
                    + " source=" + quote(source)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " tinyCapacity=" + tinyCapacity
                    + " lhs=" + quote(actual)
                    + " rhs=" + quote(expected));
        }
