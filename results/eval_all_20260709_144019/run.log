package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // - PoissonDistributionImpl requires a strictly positive mean; a correct implementation must reject p <= 0.
        //   If a "fix" simply deletes the throw and allows construction, getMean() would expose an invalid non-positive mean.
        // - For a valid mean, getMean() must return the configured mean, as exercised by the upstream test.
        //
        // ANCHOR: exact regression-test inputs first.
        exerciseInvalidMean(-1.0, true);
        exerciseInvalidMean(-1.0, false);
        exerciseValidMean(10.0);

        // EXPLORE: same root-cause property, but with many varied real inputs satisfying p <= 0.
        double fuzzMean;
        int choice = data.consumeInt(0, 5);
        switch (choice) {
            case 0:
                fuzzMean = 0.0;
                break;
            case 1:
                fuzzMean = -1.0 * (double) (1 + Math.abs(data.consumeInt()));
                break;
            case 2:
                fuzzMean = (double) Integer.MIN_VALUE;
                break;
            case 3:
                fuzzMean = -((double) data.consumeInt(0, Integer.MAX_VALUE));
                break;
            case 4:
                fuzzMean = -((double) data.consumeByte());
                if (fuzzMean > 0) {
                    fuzzMean = -fuzzMean;
                }
                break;
            default:
                fuzzMean = data.consumeBoolean() ? 0.0 : -((double) data.consumeInt(1, 1024));
                break;
        }

        exerciseInvalidMean(fuzzMean, data.consumeBoolean());

        // Also explore valid means for the observable getter contract.
        double validMean = 1.0 + (double) data.consumeInt(0, 1000000);
        exerciseValidMean(validMean);
    }

    private static void exerciseInvalidMean(double mean, boolean useOneArgConstructor) {
        try {
            PoissonDistributionImpl dist;
            if (useOneArgConstructor) {
                dist = new PoissonDistributionImpl(mean);
            } else {
                dist = new PoissonDistributionImpl(mean, 1.0e-12, 10000000);
            }

            // Documented/in-code invariant: mean must be strictly positive.
            // If construction succeeds for mean <= 0, a throw-deleting patch made the invalid state observable.
            double observed = dist.getMean();
            if (!(observed > 0.0)) {
                throw new RuntimeException(
                    "metamorphic violation: non-positive mean accepted input=" + mean + " observedMean=" + observed
                );
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static void exerciseValidMean(double mean) {
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(mean);
            double observed = dist.getMean();
            if (Double.doubleToLongBits(observed) != Double.doubleToLongBits(mean)) {
                throw new RuntimeException(
                    "metamorphic violation: getMean must return configured mean input=" + mean + " observed=" + observed
                );
            }
        } catch (Throwable t) {
            // Per hygiene rules, if either side throws, skip the check for this input.
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("NotStrictlyPositive")
            || name.contains("MathIllegal")
            || name.contains("Invalid")
            || name.contains("Illegal");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof RuntimeException || t instanceof Error)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if (("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(cls) && "<init>".equals(method))
                || ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && "createIllegalArgumentException".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
