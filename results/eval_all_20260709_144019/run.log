package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callAndPropagateRootCause("off");

        String raw = data.consumeString(8);
        callAndPropagateRootCause(raw);

        String threeChar = buildThreeCharFallthroughCandidate(data);
        callAndPropagateRootCause(threeChar);

        String observed = buildObservedLiteralVariant(data);
        callAndPropagateRootCause(observed);

        String token = buildKnownBooleanToken(data);
        boolean expected = expectedBooleanForToken(token);

        try {
            boolean actual = BooleanUtils.toBoolean(token);
            /*
             * Contract/oracle asserted:
             * BooleanUtils.toBoolean(String) is documented by its own implementation and tests
             * to accept the real boolean literals "true"/"on"/"yes" as true and
             * "false"/"off"/"no" as false, case-insensitively.
             * We construct only those valid literals, so a correct implementation must not
             * silently return the wrong value. A patch that merely deletes the crashing path
             * or makes it unreachable while changing behavior would violate this oracle.
             */
            if (actual != expected) {
                throw new RuntimeException(
                    "metamorphic violation: valid boolean token parsed incorrectly input=" + printable(token) +
                    " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isValidationFamily(t)) {
                return;
            }
        }

        String token2 = varyCase(token, data.consumeInt(), data.consumeBoolean());
        try {
            boolean lhs = BooleanUtils.toBoolean(token);
            boolean rhs = BooleanUtils.toBoolean(token2);
            /*
             * Equivalent-input relation:
             * Parsing is case-insensitive for the accepted literals above, so changing only
             * character case must preserve the result for every correct implementation.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: case-insensitive equivalents disagree input1=" + printable(token) +
                    " lhs=" + lhs + " input2=" + printable(token2) + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isValidationFamily(t)) {
                return;
            }
        }
    }

    private static void callAndPropagateRootCause(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isValidationFamily(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildThreeCharFallthroughCandidate(FuzzedDataProvider data) {
        String src = data.consumeAsciiString(6);
        char c0 = pickUnsafeLen3FirstChar(data, src);
        char c1 = src.length() > 0 ? src.charAt(0) : (char) ('a' + Math.abs(data.consumeByte()) % 26);
        char c2 = src.length() > 1 ? src.charAt(1) : (char) ('a' + Math.abs(data.consumeByte()) % 26);
        return new String(new char[] { c0, c1, c2 });
    }

    private static char pickUnsafeLen3FirstChar(FuzzedDataProvider data, String src) {
        int selector = Math.abs(data.consumeInt()) % 8;
        switch (selector) {
            case 0: return 'o';
            case 1: return 'O';
            case 2: return 't';
            case 3: return 'T';
            case 4: return 'a';
            case 5: return 'x';
            case 6: return src.length() > 0 && src.charAt(0) != 'y' && src.charAt(0) != 'Y' ? src.charAt(0) : 'q';
            default: return 'n';
        }
    }

    private static String buildObservedLiteralVariant(FuzzedDataProvider data) {
        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        String base = literals[Math.abs(data.consumeInt()) % literals.length];
        return varyCase(base, data.consumeInt(), data.consumeBoolean());
    }

    private static String buildKnownBooleanToken(FuzzedDataProvider data) {
        String[] tokens = new String[] { "true", "false", "on", "off", "yes", "no" };
        String base = tokens[Math.abs(data.consumeInt()) % tokens.length];
        return varyCase(base, data.consumeInt(), data.consumeBoolean());
    }

    private static boolean expectedBooleanForToken(String token) {
        String lower = token.toLowerCase();
        return "true".equals(lower) || "on".equals(lower) || "yes".equals(lower);
    }

    private static String varyCase(String s, int mask, boolean invert) {
        char[] chars = s.toCharArray();
        int bits = mask;
        for (int i = 0; i < chars.length; i++) {
            boolean upper = ((bits & 1) != 0) ^ invert;
            chars[i] = upper ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
            bits >>>= 1;
        }
        return new String(chars);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
