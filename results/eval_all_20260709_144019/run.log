    private static void drivePolyhedronsSet(double[] coords, int[] indices) {
        try {
            ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
                    new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();

            for (int i = 0; i < indices.length; i += 3) {
                int ia = indices[i] * 3;
                int ib = indices[i + 1] * 3;
                int ic = indices[i + 2] * 3;

                Vector3D a = new Vector3D(coords[ia], coords[ia + 1], coords[ia + 2]);
                Vector3D b = new Vector3D(coords[ib], coords[ib + 1], coords[ib + 2]);
                Vector3D c = new Vector3D(coords[ic], coords[ic + 1], coords[ic + 2]);

                Plane plane = new Plane(a, b, c);
                Vector2D a2 = plane.toSubSpace(a);
                Vector2D b2 = plane.toSubSpace(b);
                Vector2D c2 = plane.toSubSpace(c);

                ArrayList<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
                edges.add(new SubLine(a2, b2));
                edges.add(new SubLine(b2, c2));
                edges.add(new SubLine(c2, a2));
                PolygonsSet triangle = new PolygonsSet(edges);

                facets.add(new SubPlane(plane, triangle));
            }

            PolyhedronsSet poly = new PolyhedronsSet(facets);

            double s1 = poly.getSize();
            Object bc1 = poly.getBarycenter();
            double s2 = poly.getSize();
            Object bc2 = poly.getBarycenter();

            boolean sameSize = sameDouble(s1, s2);
            boolean sameBary = sameBarycenter(bc1, bc2);

            if (!sameSize || !sameBary) {
                throw new RuntimeException("metamorphic violation: repeated PolyhedronsSet observations must be stable"
                        + " size1=" + s1 + " size2=" + s2
                        + " bary1=" + String.valueOf(bc1)
                        + " bary2=" + String.valueOf(bc2));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw propagate(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean sameBarycenter(Object a, Object b) {
        if (a == b) {
            return true;
        }
        if (a instanceof Vector3D && b instanceof Vector3D) {
            Vector3D v1 = (Vector3D) a;
            Vector3D v2 = (Vector3D) b;
            return sameDouble(v1.getX(), v2.getX())
                    && sameDouble(v1.getY(), v2.getY())
                    && sameDouble(v1.getZ(), v2.getZ());
        }
        return a != null && a.equals(b);
    }

    private static boolean sameDouble(double a, double b) {
        return a == b || (Double.isNaN(a) && Double.isNaN(b));
    }

    private static double finiteInRange(int raw, double min, double max) {
        long positive = raw & 0xffffffffL;
        double unit = positive / (double) 0xffffffffL;
        return min + (max - min) * unit;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException) && !(t instanceof RuntimeException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getSize".equals(method)
                    || "getBarycenter".equals(method)
                    || "<init>".equals(method))) {
                return t instanceof ClassCastException || t instanceof RuntimeException;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.startsWith("org.apache.commons.math3.exception.")) {
            return true;
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isCleanRejection(cause);
    }

    private static RuntimeException propagate(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
