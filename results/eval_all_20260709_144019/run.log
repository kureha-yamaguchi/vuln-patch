package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runDeleteThenIndexCase("onetwo", "three");

        int prefixLen = data.consumeInt(0, 64);
        int needleLen = data.consumeInt(1, 32);

        char prefixChar = printableFromByte(data.consumeByte());
        char needleChar = printableFromByte(data.consumeByte());
        if (prefixChar == needleChar) {
            needleChar = prefixChar == 'Z' ? 'Y' : 'Z';
        }

        String prefix = repeat(prefixChar, prefixLen);
        String needle = repeat(needleChar, needleLen);

        runDeleteThenIndexCase(prefix, needle);

        if (data.consumeBoolean()) {
            String extraPrefix = data.consumeAsciiString(32);
            if (needle.length() != 0 && extraPrefix.indexOf(needle) == -1) {
                runDeleteThenIndexCase(extraPrefix, needle);
            }
        }
    }

    private static void runDeleteThenIndexCase(String prefix, String needle) {
        if (needle == null || needle.length() == 0) {
            return;
        }
        if (prefix == null) {
            return;
        }
        if (prefix.indexOf(needle) != -1) {
            return;
        }

        String original = prefix + needle;
        StrBuilder sb = new StrBuilder(original);
        try {
            sb.deleteFirst(needle);
            int idx = sb.indexOf(needle);

            /*
             * Contract used for this post-condition:
             * deleteFirst(String) removes the first occurrence, and indexOf(String)
             * searches the current logical contents of the builder. For a builder
             * constructed as prefix + needle where prefix is guaranteed not to
             * contain needle, there is exactly one occurrence before deletion.
             * Therefore after deleteFirst(needle), the builder must equal prefix
             * and indexOf(needle) must be -1. A patch that merely suppresses a
             * throw or skips correct bounds handling can silently return a stale
             * match from buffer contents past size, violating this observable API
             * behaviour.
             */
            String after = sb.toString();
            if (!prefix.equals(after)) {
                throw new RuntimeException(
                    "metamorphic violation: deleteFirst should leave exact prefix input="
                        + original + " needle=" + needle + " expected=" + prefix + " actual=" + after);
            }
            if (idx != -1) {
                throw new RuntimeException(
                    "metamorphic violation: deleted unique suffix must not be found input="
                        + original + " needle=" + needle + " index=" + idx + " actualBuilder=" + after);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseThrowable(t)) {
                rethrowUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.contains("invalid") || lower.contains("validation")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCauseThrowable(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException
                || t instanceof StringIndexOutOfBoundsException
                || t instanceof IndexOutOfBoundsException
                || classNameEndsWith(t, "AssertionFailedError"))) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement e : stack) {
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("indexOf".equals(m) || "length".equals(m) || "isEmpty".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean classNameEndsWith(Throwable t, String suffix) {
        String name = t.getClass().getName();
        return name != null && name.endsWith(suffix);
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
    }

    private static char printableFromByte(byte b) {
        int v = b & 0xFF;
        return (char) ('!' + (v % 94));
    }

    private static String repeat(char c, int count) {
        StringBuilder sb = new StringBuilder(count);
        for (int i = 0; i < count; i++) {
            sb.append(c);
        }
        return sb.toString();
    }
}
