package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            StrBuilder anchor = new StrBuilder(1);
            anchor.appendFixedWidthPadRight("foo", 1, '-');
            if (!"f".equals(anchor.toString())) {
                throw new RuntimeException("metamorphic violation: anchor expected=f actual=" + anchor.toString());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        runOneCase(data, false);
        runOneCase(data, true);
    }

    private static void runOneCase(FuzzedDataProvider data, boolean useNullObject) {
        int initialCapacity = data.consumeInt(0, 8);
        int width = data.consumeInt(0, 32);
        char padChar = (char) (data.consumeByte() & 0xff);

        StrBuilder lhs = new StrBuilder(initialCapacity);
        StrBuilder rhs = new StrBuilder(initialCapacity);

        String source;
        Object obj;
        if (useNullObject) {
            String nullText = data.consumeString(32);
            lhs.setNullText(nullText);
            rhs.setNullText(nullText);
            source = nullText;
            obj = null;
        } else {
            source = data.consumeString(32);
            obj = source;
        }

        if (source == null) {
            return;
        }

        if (data.consumeBoolean()) {
            String prefix = data.consumeAsciiString(8);
            lhs.append(prefix);
            rhs.append(prefix);
        }

        int beforeLen = lhs.length();
        String lhsResult;
        String rhsResult;

        try {
            lhs.appendFixedWidthPadRight(obj, width, padChar);
            lhsResult = lhs.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            int copyLen = source.length() >= width ? width : source.length();
            if (copyLen > 0) {
                rhs.append(source.substring(0, copyLen));
            }
            if (width > copyLen) {
                rhs.appendPadding(width - copyLen, padChar);
            }
            rhsResult = rhs.toString();
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted:
         * appendFixedWidthPadRight appends exactly width characters:
         * - if source length >= width, it appends the leftmost width chars;
         * - otherwise it appends the whole source then pad chars to width.
         * The RHS builds that same result only through real StrBuilder API calls
         * (append + appendPadding), so a patch that merely suppresses the throw,
         * skips copying, or corrupts size/buffer bookkeeping will disagree here.
         */
        if (!lhsResult.equals(rhsResult)) {
            throw new RuntimeException(
                    "metamorphic violation: fixedWidthPadRight equivalence source=" + printable(source)
                            + " width=" + width
                            + " pad=" + (int) padChar
                            + " initialCapacity=" + initialCapacity
                            + " beforeLen=" + beforeLen
                            + " lhs=" + printable(lhsResult)
                            + " rhs=" + printable(rhsResult));
        }

        if (lhs.length() != beforeLen + width) {
            throw new RuntimeException(
                    "metamorphic violation: length increment source=" + printable(source)
                            + " width=" + width
                            + " beforeLen=" + beforeLen
                            + " actualLen=" + lhs.length());
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s;
    }
}
