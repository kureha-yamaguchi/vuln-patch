package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.optimization.GoalType;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorSearch();

        int vars = data.consumeInt(1, 5);
        int pivot = data.consumeInt(0, vars - 1);
        int ratio = data.consumeInt(1, 8);
        int geqCoeff = data.consumeInt(1, 8);
        int leqCoeff = data.consumeInt(1, 8);
        int extraConstraints = data.consumeInt(0, 3);

        double[] objective = new double[vars];
        objective[pivot] = 1.0;

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] geq = new double[vars];
        geq[pivot] = geqCoeff;
        constraints.add(new LinearConstraint(geq, Relationship.GEQ, geqCoeff * ratio));

        double[] leq = new double[vars];
        leq[pivot] = leqCoeff;
        constraints.add(new LinearConstraint(leq, Relationship.LEQ, leqCoeff * ratio));

        for (int i = 0; i < extraConstraints; i++) {
            double[] c = new double[vars];
            int kind = data.consumeInt(0, 2);
            int idx = data.consumeInt(0, vars - 1);
            int coeff = data.consumeInt(0, 3);
            if (idx == pivot && coeff == 0) {
                coeff = 1;
            }
            c[idx] = coeff;
            double value = coeff * data.consumeInt(0, ratio + 2);
            Relationship rel = kind == 0 ? Relationship.LEQ : (kind == 1 ? Relationship.GEQ : Relationship.EQ);
            constraints.add(new LinearConstraint(c, rel, value));
        }

        checkForceArtificialOut(objective, constraints);
    }

    private static void runAnchorSearch() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, 1.0));
        checkForceArtificialOut(new double[] { 1.0 }, constraints);
    }

    private static void checkForceArtificialOut(double[] objectiveCoefficients, Collection<LinearConstraint> constraints) {
        try {
            LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoefficients, 0.0);
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, 10);

            if (tableau.getNumArtificialVariables() <= 0) {
                return;
            }

            final int objectiveRow = 0;
            int pivotCol = -1;
            double minValue = 0.0;
            for (int c = tableau.getNumObjectiveFunctions(); c < tableau.getWidth() - 1; c++) {
                double v = tableau.getEntry(objectiveRow, c);
                if (v < minValue) {
                    minValue = v;
                    pivotCol = c;
                }
            }
            if (pivotCol < 0) {
                return;
            }

            Integer[] tiedRows = new Integer[tableau.getHeight()];
            int tiedCount = 0;
            double minRatio = Double.MAX_VALUE;
            for (int r = tableau.getNumObjectiveFunctions(); r < tableau.getHeight(); r++) {
                double rhs = tableau.getEntry(r, tableau.getWidth() - 1);
                double entry = tableau.getEntry(r, pivotCol);
                if (entry > 0.0) {
                    double ratio = rhs / entry;
                    int cmp = Double.compare(ratio, minRatio);
                    if (cmp == 0) {
                        tiedRows[tiedCount++] = Integer.valueOf(r);
                    } else if (cmp < 0) {
                        minRatio = ratio;
                        tiedCount = 0;
                        tiedRows[tiedCount++] = Integer.valueOf(r);
                    }
                }
            }
            if (tiedCount <= 1) {
                return;
            }

            int artOffset = tableau.getArtificialVariableOffset();
            Integer forcedRow = null;
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int artCol = artOffset + i;
                Integer basicRow = tableau.getBasicRow(artCol);
                if (basicRow == null) {
                    continue;
                }
                boolean inTie = false;
                for (int t = 0; t < tiedCount; t++) {
                    if (basicRow.equals(tiedRows[t])) {
                        inTie = true;
                        break;
                    }
                }
                if (!inTie) {
                    continue;
                }
                double entry = tableau.getEntry(basicRow.intValue(), artCol);
                if (entry == 1.0d) {
                    forcedRow = basicRow;
                    break;
                }
            }
            if (forcedRow == null) {
                return;
            }

            Integer before = tableau.getBasicRow(artOffset);

            SimplexSolver solver = new SimplexSolver();
            solver.doIteration(tableau);

            Integer after = tableau.getBasicRow(artOffset);

            /*
             * Contract asserted from the patched method's own documented intent:
             * when minimum-ratio rows tie, getPivotRow first "check[s] if there's an artificial
             * variable that can be forced out of the basis". Therefore, if we construct a tied
             * pivot where an artificial variable is basic on one tied row, one iteration must
             * pivot that artificial variable out instead of leaving it basic on the same row.
             * A throw-deleting patch at the highlighted return site breaks exactly this guarantee.
             */
            if (before != null && forcedRow.equals(before) && after != null && after.equals(forcedRow)) {
                throw new RuntimeException(
                    "metamorphic violation: artificial variable was not forced out of basis"
                    + " objectiveDim=" + objectiveCoefficients.length
                    + " pivotCol=" + pivotCol
                    + " forcedRow=" + forcedRow
                    + " artificialOffset=" + artOffset
                    + " before=" + before
                    + " after=" + after);
            }
        } catch (RuntimeException e) {
            if (e.getMessage() != null && e.getMessage().startsWith("metamorphic violation:")) {
                throw e;
            }
        } catch (Exception e) {
            return;
        }
    }
}
