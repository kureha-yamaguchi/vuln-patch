        } else {
            for (int i = 0; i < fracSrc.length(); i++) {
                sb.append((char) ('0' + (fracSrc.charAt(i) % 10)));
            }
        }

        if (trailingType) {
            if (suffixMode == 0) {
                sb.append('D');
            } else if (suffixMode == 1) {
                sb.append('d');
            } else {
                sb.append('F');
