            case 1:
                return 1.5d;
            case 2:
                return -magnitude;
            case 3:
                return 1.0d + magnitude;
            case 4:
                return -((double) magnitude) / 255.0d;
            case 5:
                return 1.0d + ((double) magnitude) / 255.0d;
            case 6:
                return -((double) magnitude) / 1024.0d;
            default:
                return 1.0d + ((double) magnitude) / 1024.0d;
