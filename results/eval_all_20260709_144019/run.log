package org.jfree.chart.plot;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.jfree.chart.util.Layer;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorCategoryDomain();
        anchorCategoryRange();
        anchorXYDomain();
        anchorXYRange();

        exploreXYRange(data);
        exploreOtherMarkerRemovals(data);
        checkRemovalPostConditions(data);
    }

    private static void anchorCategoryDomain() {
        try {
            CategoryPlot plot = new CategoryPlot();
            plot.removeDomainMarker(new CategoryMarker("Category 1"));
        } catch (RuntimeException t) {
            if (isAlreadyCoveredCategoryOrDomainCrash(t)) {
                return;
            }
        }
    }

    private static void anchorCategoryRange() {
        try {
            CategoryPlot plot = new CategoryPlot();
            plot.removeRangeMarker(new ValueMarker(0.5));
        } catch (RuntimeException t) {
            if (isAlreadyCoveredCategoryOrDomainCrash(t)) {
                return;
            }
        }
    }

    private static void anchorXYDomain() {
        try {
            XYPlot plot = new XYPlot();
            plot.removeDomainMarker(new ValueMarker(0.5));
        } catch (RuntimeException t) {
            if (isAlreadyCoveredCategoryOrDomainCrash(t)) {
                return;
            }
        }
    }

    private static void anchorXYRange() {
        try {
            XYPlot plot = new XYPlot();
            plot.removeRangeMarker(new ValueMarker(0.5));
        } catch (RuntimeException t) {
            if (isRootCauseXYRange(t)) {
                throw t;
            }
        }
    }

    private static void exploreXYRange(FuzzedDataProvider data) {
        XYPlot plot = new XYPlot();
        int index = data.consumeInt();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean notify = data.consumeBoolean();
        double value = data.consumeInt();

        try {
            plot.removeRangeMarker(index, new ValueMarker(value), layer, notify);
        } catch (RuntimeException t) {
            if (isRootCauseXYRange(t)) {
                throw t;
            }
        }

        try {
            plot.removeRangeMarker(new ValueMarker(value + 1.0));
        } catch (RuntimeException t) {
            if (isRootCauseXYRange(t)) {
                throw t;
            }
        }
    }

    private static void exploreOtherMarkerRemovals(FuzzedDataProvider data) {
        String category = data.consumeString(32);
        if (category == null || category.length() == 0) {
            category = "C";
        }
        int index = data.consumeInt();
        Layer layer = data.consumeBoolean() ? Layer.FOREGROUND : Layer.BACKGROUND;
        boolean notify = data.consumeBoolean();
        double value = data.consumeInt();

        try {
            CategoryPlot cp = new CategoryPlot();
