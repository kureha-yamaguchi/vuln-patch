package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkAnchorContracts();

        Object[] array = buildArray(data);

        Class<?>[] classes;
        try {
            classes = ClassUtils.toClass(array);
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid Object[] with null elements must be accepted and preserve null positions input="
                                + Arrays.deepToString(array),
                        t);
            }
            return;
        }

        /* Contract asserted from ClassUtilsTest.testToClass_object:
         * ClassUtils.toClass(new Object[] { "Test", null, 99d }) returns
         * new Class[] { String.class, null, Double.class }.
         * Therefore, for any Object[] input, a correct implementation must:
         *   - return an array of the same length,
         *   - map each non-null element to element.getClass(),
         *   - preserve null elements as null in the output.
         * A throw-deleting or branch-skipping patch could silently return wrong
         * classes or collapse null positions; this post-condition catches that.
         */
        if (classes == null || classes.length != array.length) {
            throw new RuntimeException(
                    "metamorphic violation: toClass shape mismatch input="
                            + Arrays.deepToString(array)
                            + " output="
                            + Arrays.toString(classes));
        }
        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (classes[i] != expected) {
                throw new RuntimeException(
                        "metamorphic violation: null/class preservation input="
                                + Arrays.deepToString(array)
                                + " index="
                                + i
                                + " expected="
                                + expected
                                + " actual="
                                + classes[i]);
            }
        }

        Object[] clone = ArrayUtils.clone(array);
        try {
            Class<?>[] clonedClasses = ClassUtils.toClass(clone);
            if (!Arrays.equals(classes, clonedClasses)) {
                throw new RuntimeException(
                        "metamorphic violation: toClass(array) != toClass(clone(array)) input="
                                + Arrays.deepToString(array)
                                + " lhs="
                                + Arrays.toString(classes)
                                + " rhs="
                                + Arrays.toString(clonedClasses));
            }
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: clone-equivalent inputs must produce equal toClass outputs input="
                                + Arrays.deepToString(array),
                        t);
            }
            return;
        }

        exerciseGetClass(data, classes);
    }

    private static void checkAnchorContracts() {
        Class<?>[] nullResult = ClassUtils.toClass(null);
        if (nullResult != null) {
            throw new RuntimeException("metamorphic violation: toClass(null) must return null");
        }

        Class<?>[] emptyResult = ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        if (emptyResult != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("metamorphic violation: toClass(empty) must return EMPTY_CLASS_ARRAY");
        }

        Class<?>[] normalResult = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        Class<?>[] normalExpected = new Class<?>[] { String.class, Integer.class, Double.class };
        if (!Arrays.equals(normalExpected, normalResult)) {
            throw new RuntimeException(
                    "metamorphic violation: anchor non-null mapping expected="
                            + Arrays.toString(normalExpected)
                            + " actual="
                            + Arrays.toString(normalResult));
        }

        try {
            Class<?>[] nullElementResult = ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });
            Class<?>[] nullElementExpected = new Class<?>[] { String.class, null, Double.class };
            if (!Arrays.equals(nullElementExpected, nullElementResult)) {
                throw new RuntimeException(
                        "metamorphic violation: anchor null-element mapping expected="
                                + Arrays.toString(nullElementExpected)
                                + " actual="
                                + Arrays.toString(nullElementResult));
            }
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: anchor input with a null element must not throw", t);
            }
        }
    }

    private static void exerciseGetClass(FuzzedDataProvider data, Class<?>[] classes) {
        ClassLoader cl = Thread.currentThread().getContextClassLoader();
        if (cl == null) {
            cl = ClassUtils.class.getClassLoader();
        }

        /* Contract from ClassUtils.getClass overloads:
         * getClass(String, boolean) chooses the context/default loader and delegates
         * to getClass(ClassLoader, String, boolean). For any binary name that these
         * overloads accept, both overloads must resolve to the same Class object.
         * Using names obtained from real Class instances makes the inputs valid by
         * construction for the active loader.
         */
        for (int i = 0; i < classes.length; i++) {
            Class<?> c = classes[i];
            if (c == null) {
                continue;
            }
            String name = c.getName();
            try {
                Class<?> viaLoader = ClassUtils.getClass(cl, name, false);
                Class<?> viaDefault = ClassUtils.getClass(name, false);
                if (viaLoader != viaDefault || viaLoader != c) {
                    throw new RuntimeException(
                            "metamorphic violation: getClass overload equivalence name="
                                    + name
                                    + " original="
                                    + c
                                    + " viaLoader="
                                    + viaLoader
                                    + " viaDefault="
                                    + viaDefault);
                }
            } catch (ClassNotFoundException e) {
                return;
            } catch (LinkageError e) {
                return;
            } catch (SecurityException e) {
                return;
            } catch (IllegalArgumentException e) {
                return;
            }
        }

        String arbitraryName = data.consumeAsciiString(64);
        if (arbitraryName.length() != 0) {
            try {
                ClassUtils.getClass(cl, arbitraryName, data.consumeBoolean());
            } catch (ClassNotFoundException e) {
            } catch (LinkageError e) {
            } catch (SecurityException e) {
            } catch (IllegalArgumentException e) {
            }
        }
