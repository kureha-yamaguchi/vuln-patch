            }
            return;
        }

        String expected = before + expectedSegment(source, width, padChar);

        try {
            if (useNullObject) {
                sb.appendFixedWidthPadRight(null, width, padChar);
            } else {
                sb.appendFixedWidthPadRight(objString, width, padChar);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid fixed-width append should not throw"
                                + " prefix=" + quote(prefix)
                                + " source=" + quote(source)
                                + " width=" + width
                                + " pad=" + (int) padChar
                                + " useNullObject=" + useNullObject,
                        t);
            }
            return;
        }

        String out;
        try {
            out = sb.toString();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("metamorphic violation: toString after append should not fail", t);
            }
            return;
        }

        if (sb.length() != oldLen + width) {
            throw new RuntimeException(
                    "metamorphic violation: length must grow by width"
                            + " oldLen=" + oldLen
                            + " width=" + width
                            + " newLen=" + sb.length()
                            + " output=" + quote(out));
        }

        /*
         * Contract visible in appendFixedWidthPadRight's body:
         * it appends exactly width characters; if source is longer than width,
         * the appended region is the leftmost width chars, otherwise source plus pad chars.
         * A throw-deleting or branch-skipping patch can avoid the buggy exception but still
         * append the wrong number/content of characters, so we assert the exact post-state.
         */
        if (!expected.equals(out)) {
            throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight output mismatch"
                            + " prefix=" + quote(prefix)
                            + " source=" + quote(source)
                            + " width=" + width
                            + " pad=" + (int) padChar
                            + " lhs=" + quote(out)
                            + " rhs=" + quote(expected)
                            + " useNullObject=" + useNullObject);
        }
    }

    private static String expectedSegment(String source, int width, char padChar) {
        if (source.length() >= width) {
            return source.substring(0, width);
        }
        StrBuilder oracle = new StrBuilder(width);
        oracle.append(source);
        for (int i = source.length(); i < width; i++) {
            oracle.append(padChar);
        }
        return oracle.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
