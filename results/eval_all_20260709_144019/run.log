package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryCreateNumber(anchors[i]);
        }

        String direct = data.consumeBoolean() ? "l" : "L";
        tryCreateNumber(direct);

        String candidate;
        switch (data.consumeInt(0, 7)) {
            case 0:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 2:
                candidate = data.consumeAsciiString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 3:
                candidate = data.consumeString(1);
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                } else {
                    candidate = candidate.substring(0, 1);
                }
                break;
            case 4:
                candidate = buildPossiblyPrefixedSuffix(data, true);
                break;
            case 5:
                candidate = buildPossiblyPrefixedSuffix(data, false);
                break;
            case 6:
                candidate = data.consumeRemainingAsString();
                if (candidate.length() == 0) {
                    candidate = data.consumeBoolean() ? "l" : "L";
                }
                if (data.consumeBoolean() && candidate.length() > 1) {
                    candidate = candidate.substring(0, 1);
                }
                break;
            default:
                candidate = buildNumericLikeCandidate(data);
                break;
        }
        tryCreateNumber(candidate);

        String prefix = sanitizeIntegralCore(data.consumeAsciiString(32), data.consumeBoolean());
        tryMetamorphicLongSuffix(prefix);

        int known = data.consumeInt();
        tryMetamorphicLongSuffix(Integer.toString(known));

        String another = sanitizeIntegralCore(data.consumeRemainingAsString(), data.consumeBoolean());
        tryMetamorphicLongSuffix(another);
    }

    private static String buildPossiblyPrefixedSuffix(FuzzedDataProvider data, boolean upper) {
        String prefix = data.consumeAsciiString(8);
        char suffix = upper ? 'L' : 'l';
        String candidate = prefix + suffix;
        if (data.consumeBoolean()) {
            if (candidate.length() > 0) {
                candidate = candidate.substring(candidate.length() - 1);
            }
        }
        if (candidate.length() == 0) {
            candidate = String.valueOf(suffix);
        }
        return candidate;
    }

    private static String buildNumericLikeCandidate(FuzzedDataProvider data) {
        String raw = data.consumeAsciiString(24);
        String core = sanitizeIntegralCore(raw, data.consumeBoolean());
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return core + "l";
            case 1:
                return core + "L";
            case 2:
                return core + ".0F";
            case 3:
                return core + ".0D";
            case 4:
                return "0x" + hexOnly(data.consumeAsciiString(16));
            default:
                return data.consumeBoolean() ? "l" : "L";
        }
    }

    private static String sanitizeIntegralCore(String raw, boolean allowNegative) {
        StringBuilder sb = new StringBuilder();
        if (allowNegative) {
            sb.append('-');
        }
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0 || (sb.length() == 1 && sb.charAt(0) == '-')) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static String hexOnly(String raw) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static void tryMetamorphicLongSuffix(String core) {
        try {
            Number lower = NumberUtils.createNumber(core + "l");
            Number upper = NumberUtils.createNumber(core + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        return a.getClass().equals(b.getClass()) && a.toString().equals(b.toString());
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + n.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                    && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
