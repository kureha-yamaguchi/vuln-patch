package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression input from the failing test.
        runOne(f, 3.0d, 3.2d, 3.1d, true);

        // EXPLORE: the root cause is calling BisectionSolver.solve(f, min, max, initial)
        // on a fresh solver. In the buggy version, that overload ignores the provided
        // function and delegates to solve(min, max), leading to a NullPointerException.
        // Build many valid bracketing intervals for sin(x) around known roots k*pi.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftScale = data.consumeInt(1, 1_000_000);
        int rightScale = data.consumeInt(1, 1_000_000);
        double left = leftScale / 1_000_000.0d;
        double right = rightScale / 1_000_000.0d;

        double min = root - left;
        double max = root + right;

        int selector = data.consumeInt(0, 2);
        double initial;
        if (selector == 0) {
            initial = (min + max) / 2.0d;
        } else if (selector == 1) {
            double frac = data.consumeInt(0, 1_000_000) / 1_000_000.0d;
            initial = min + (max - min) * frac;
        } else {
            initial = root;
        }

        runOne(f, min, max, initial, false);
    }

    private static void runOne(UnivariateRealFunction f, double min, double max, double initial, boolean anchor) {
        // Contract / metamorphic relation:
        // For BisectionSolver, solve(f, min, max, initial) delegates to solve(f, min, max),
        // so for every correct implementation both public API calls must return the same root
        // on the same valid interval. A "fix" that merely suppresses the crash or skips the
        // intended delegation would violate this observable equivalence.
        Double lhs = null;
        Double rhs = null;
        double lhsAcc = Double.NaN;
        double rhsAcc = Double.NaN;

        try {
            BisectionSolver solver1 = new BisectionSolver();
            lhsAcc = solver1.getAbsoluteAccuracy();
            lhs = Double.valueOf(solver1.solve(f, min, max, initial));
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t) || anchor || !anchor) {
                return;
            }
        }

        try {
            BisectionSolver solver2 = new BisectionSolver();
            rhsAcc = solver2.getAbsoluteAccuracy();
            rhs = Double.valueOf(solver2.solve(f, min, max));
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (lhs == null || rhs == null) {
            return;
        }

        double tol = Math.max(Math.max(Math.abs(lhsAcc), Math.abs(rhsAcc)), 1.0e-12d);
        if (Math.abs(lhs.doubleValue() - rhs.doubleValue()) > tol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                    + " input=min=" + min
                    + " max=" + max
                    + " initial=" + initial
                    + " lhs=" + lhs
                    + " rhs=" + rhs
            );
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
            || name.contains("FunctionEvaluationException")
            || name.contains("MaxIterationsExceededException")
            || name.contains("MathException");
    }

    private static boolean isRootCause(Throwable t) {
