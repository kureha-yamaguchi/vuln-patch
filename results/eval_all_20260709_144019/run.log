        for (int i = 0; i < cols; i++) {
            int v = data.consumeInt(-20, 20);
            bigVec[i] = BigDecimal.valueOf(v);
            realVec[i] = v;
        }

        BigMatrixImpl bigA = new BigMatrixImpl(bigAData, false);
        RealMatrixImpl realA = new RealMatrixImpl(realAData, false);

