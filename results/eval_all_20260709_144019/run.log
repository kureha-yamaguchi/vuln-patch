                CategoryPlot present = new CategoryPlot();
                CountingListener presentListener = new CountingListener();
                present.addChangeListener(presentListener);
                try {
                    present.addRangeMarker(index, marker, layer);
                    boolean removed = present.removeRangeMarker(index, marker, layer, notify);
