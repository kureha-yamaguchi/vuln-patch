package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        double mean = finiteFromInt(data.consumeInt(), 1024.0);
        double sd = positiveFiniteFromInt(data.consumeInt(), 16.0);

        org.apache.commons.math.distribution.NormalDistributionImpl dist;
        try {
            dist = new org.apache.commons.math.distribution.NormalDistributionImpl(mean, sd);
        } catch (Throwable t) {
            if (isValidationException(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        double x = mean + (2.0 * sd);

        final double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (Throwable t) {
            if (isValidationException(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        try {
            double roundTrip = dist.inverseCumulativeProbability(p);

            if (Double.isNaN(roundTrip) || Double.isInfinite(roundTrip)) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) produced non-finite result x=" + x +
                    " p=" + p + " result=" + roundTrip + " mean=" + mean + " sd=" + sd);
            }

            /*
             * Contract asserted:
             * For a continuous distribution, inverseCumulativeProbability is the inverse of
             * cumulativeProbability on valid probabilities. We construct a valid input by first
             * computing p = cumulativeProbability(x) from the real library, then require
             * inverseCumulativeProbability(p) to recover x (within numerical tolerance).
             * A patch that merely deletes/suppresses the throw in the bracketing path could
             * silently return an incorrect quantile, which this check detects.
             */
            double tol = 1.0e-9 * Math.max(1.0, Math.abs(x));
            if (Math.abs(roundTrip - x) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) != x input=" + x +
                    " p=" + p + " lhs=" + roundTrip + " rhs=" + x +
                    " mean=" + mean + " sd=" + sd);
            }

            double mirroredP = 1.0 - p;
            try {
                double left = dist.inverseCumulativeProbability(mirroredP);
                double right = (2.0 * mean) - roundTrip;
                double tol2 = 1.0e-9 * Math.max(1.0, Math.max(Math.abs(left), Math.abs(right)));
                if (!Double.isNaN(left) && !Double.isInfinite(left) && Math.abs(left - right) > tol2) {
                    throw new RuntimeException(
                        "metamorphic violation: normal symmetry inv(1-p)=2*mean-inv(p) p=" + p +
                        " lhs=" + left + " rhs=" + right +
                        " mean=" + mean + " sd=" + sd);
                }
            } catch (Throwable t) {
                if (t instanceof RuntimeException && t.getMessage() != null
                        && t.getMessage().startsWith("metamorphic violation:")) {
                    throw (RuntimeException) t;
                }
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && t.getMessage() != null
                    && t.getMessage().startsWith("metamorphic violation:")) {
                throw (RuntimeException) t;
            }
            if (isValidationException(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void anchor() {
        org.apache.commons.math.distribution.NormalDistributionImpl normal;
        try {
            normal = new org.apache.commons.math.distribution.NormalDistributionImpl(0.0, 1.0);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        try {
            double result = normal.inverseCumulativeProbability(0.9772498680518209d);
            if (Double.isNaN(result) || Double.isInfinite(result) || Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor inverseCumulativeProbability expected 2.0 input=0.9772498680518209 lhs="
                    + result + " rhs=2.0");
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && t.getMessage() != null
                    && t.getMessage().startsWith("metamorphic violation:")) {
                throw (RuntimeException) t;
            }
            if (isValidationException(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof org.apache.commons.math.MathException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(e.getClassName())
                    && "bracket".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(e.getClassName())
                    && "inverseCumulativeProbability".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationException(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("IllegalArgument")
                || name.contains("Invalid")
                || name.contains("OutOfRange")
                || name.contains("NotPositive")
                || name.contains("NullArgument");
    }

    private static double finiteFromInt(int v, double scale) {
        return ((double) v) / scale;
    }

    private static double positiveFiniteFromInt(int v, double scale) {
        int n = v == Integer.MIN_VALUE ? Integer.MAX_VALUE : Math.abs(v);
        return (((double) (n % 100000)) / scale) + 1.0e-6;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
