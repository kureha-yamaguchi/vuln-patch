public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException e) {
            }
        }

        String raw = data.consumeAsciiString(32);
        String digits = digitsOnly(raw, false, true);
        String signedDigits = digitsOnly(raw, true, true);

        String longCandidate = signedDigits + (data.consumeBoolean() ? "L" : "l");
        String hugeLongCandidate = digits + digits + digits + (data.consumeBoolean() ? "L" : "l");
        String floatCandidate = signedDigits + "." + digits + (data.consumeBoolean() ? "F" : "f");
        String doubleCandidate = signedDigits + "." + digits + "E" + digitsOnly(data.consumeAsciiString(8), true, true)
                + (data.consumeBoolean() ? "D" : "d");

        String maybeSingleSuffix;
        switch (data.consumeInt(0, 5)) {
            case 0:
                maybeSingleSuffix = "l";
                break;
            case 1:
                maybeSingleSuffix = "L";
                break;
            case 2:
                maybeSingleSuffix = "f";
                break;
            case 3:
                maybeSingleSuffix = "F";
                break;
            case 4:
                maybeSingleSuffix = "d";
                break;
            default:
                maybeSingleSuffix = "D";
                break;
        }

        String[] candidates = new String[] {
                raw,
                maybeSingleSuffix,
                longCandidate,
                hugeLongCandidate,
                floatCandidate,
                doubleCandidate,
                signedDigits,
                "0x" + hexOnly(data.consumeAsciiString(16), true),
                "-" + digits + "L",
                digits + "L",
                digits + "l"
        };

        for (int i = 0; i < candidates.length; i++) {
            try {
                NumberUtils.createNumber(candidates[i]);
            } catch (NumberFormatException e) {
            } catch (NullPointerException e) {
