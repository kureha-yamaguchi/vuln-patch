    private static void handleThrowable(Throwable t) {
        if (isValidationException(t)) {
            return;
        }
        if (isNovelRootCause(t)) {
            rethrow(t);
        }
    }

    private static boolean isValidationException(Throwable t) {
        while (t != null) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            t = t.getCause();
        }
        return false;
    }

    private static boolean isNovelRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.chart.plot.CategoryPlot".equals(cls)
                    && "removeDomainMarker".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.plot.XYPlot".equals(cls)
                    && ("removeDomainMarker".equals(method)
                        || "removeRangeMarker".equals(method))) {
                return true;
            }
            if (("org.jfree.chart.plot.CategoryPlot".equals(cls)
                    || "org.jfree.chart.plot.XYPlot".equals(cls))
                    && ("fireChangeEvent".equals(method) || "get".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
