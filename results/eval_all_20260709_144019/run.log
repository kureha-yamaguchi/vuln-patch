    private static void verifyCase(String prefix, String objString, boolean useNullObject, String nullText, int width, char padChar) {
        if (width <= 0) {
            return;
        }

        String source = useNullObject ? nullText : objString;
        if (source == null || source.length() < width + 1) {
            return;
        }

        int initialCapacity = Math.max(1, prefix.length());
        StrBuilder sb = new StrBuilder(initialCapacity);
        sb.append(prefix);
        if (useNullObject) {
