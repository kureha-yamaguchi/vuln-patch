package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            // Anchor from StrBuilderTest.testIndexOfLang294:
            // after deleting the only trailing occurrence of "three" from "onetwothree",
            // searching for "three" must behave exactly like searching in a fresh builder
            // created from the visible post-delete content "onetwo".
            checkDeleteThenIndex("onetwo", "three", 0, false);
        } catch (Throwable t) {
            handleThrowable(t);
        }

        String term = makeLowercaseToken(data.consumeAsciiString(12));
        String prefix = makeUppercaseToken(data.consumeAsciiString(32));
        int start = data.consumeInt(-8, prefix.length() + term.length() + 8);
        boolean deleteAll = data.consumeBoolean();

        try {
            checkDeleteThenIndex(prefix, term, start, deleteAll);
        } catch (Throwable t) {
            handleThrowable(t);
        }

        try {
            // Also exercise the empty-result case to steer toward isEmpty().
            checkDeleteThenIndex("", term, start, deleteAll);
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void checkDeleteThenIndex(String prefix, String term, int startIndex, boolean deleteAll) {
        StrBuilder sb = new StrBuilder(prefix + term);
        if (deleteAll) {
            sb.deleteAll(term);
        } else {
            sb.deleteFirst(term);
        }

        StrBuilder expected = new StrBuilder(prefix);

        // Contract / metamorphic relation:
        // deleteFirst/deleteAll updates the builder's logical content. Therefore any subsequent
        // indexOf(term, start) result must match a fresh StrBuilder built from that visible content.
        // This catches stale-buffer bugs where toString() is correct but indexOf() still scans past
        // length() and finds deleted trailing characters.
        int lhs = sb.indexOf(term, startIndex);
        int rhs = expected.indexOf(term, startIndex);
        if (lhs != rhs) {
            throw new RuntimeException(
                "metamorphic violation: delete-then-index disagrees with visible content " +
                "prefix=" + prefix + " term=" + term + " start=" + startIndex +
                " deleteAll=" + deleteAll + " lhs=" + lhs + " rhs=" + rhs +
                " sb=" + sb.toString() + " expected=" + expected.toString());
        }

        // Contract: isEmpty() reflects whether the current logical content has length zero.
        boolean emptyLhs = sb.isEmpty();
        boolean emptyRhs = expected.isEmpty();
        if (emptyLhs != emptyRhs) {
            throw new RuntimeException(
                "metamorphic violation: isEmpty disagrees with visible content " +
                "prefix=" + prefix + " term=" + term + " start=" + startIndex +
                " deleteAll=" + deleteAll + " lhs=" + emptyLhs + " rhs=" + emptyRhs +
                " sb=" + sb.toString() + " expected=" + expected.toString());
        }
    }

    private static void handleThrowable(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:")) {
            throw (RuntimeException) t;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCauseThrowable(t)) {
            sneakyThrow(t);
