                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String digitize(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                int v = c % 10;
                if (v < 0) {
                    v = -v;
                }
                sb.append((char) ('0' + v));
            }
        }
        return sb.toString();
    }

    private static String nonEmptyHex(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            int v;
            if (c >= '0' && c <= '9') {
                v = c - '0';
            } else if (c >= 'a' && c <= 'f') {
                v = c - 'a' + 10;
            } else if (c >= 'A' && c <= 'F') {
                v = c - 'A' + 10;
            } else {
                v = c & 0xF;
            }
            if (v < 10) {
                sb.append((char) ('0' + v));
            } else {
                sb.append((char) ('A' + (v - 10)));
            }
        }
        if (sb.length() == 0) {
            return "0";
        }
        return sb.toString();
    }

    private static String buildBothExponentMarkersNoDot(FuzzedDataProvider data) {
        String a = digitize(data.consumeAsciiString(data.consumeInt(0, 8)));
        String b = digitize(data.consumeAsciiString(data.consumeInt(0, 8)));
        String c = digitize(data.consumeAsciiString(data.consumeInt(0, 8)));
        if (a.length() == 0) {
            a = "1";
        }
        if (b.length() == 0) {
            b = "1";
        }
        if (c.length() == 0) {
            c = "1";
        }

        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return a + "e" + "E";
            case 1:
                return a + "E" + "e";
            case 2:
                return a + "e" + b + "E";
            case 3:
                return a + "E" + b + "e";
            case 4:
                return (data.consumeBoolean() ? "-" : "") + a + "e" + b + "E" + c;
            default:
                return (data.consumeBoolean() ? "-" : "") + a + "E" + b + "e" + c;
        }
    }

    private static String valueDesc(Object o) {
        if (o == null) {
            return "null";
        }
        return o.getClass().getName() + ":" + o.toString();
    }
