package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callAndMaybePropagate("off");

        String[] observed = new String[] {
            "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue",
            "TrUE", "TrUe", "TruE", "True", "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES",
            "yes?", "tru", "no", "NO", "off", "OFF"
        };
        for (int i = 0; i < 3 && data.remainingBytes() > 0; i++) {
            callAndMaybePropagate(observed[data.consumeInt(0, observed.length - 1)]);
        }

        String[] canonical = new String[] { "true", "false", "on", "off", "yes", "no" };
        String base = canonical[data.consumeInt(0, canonical.length - 1)];
        String variant = randomCase(base, data);

        callAndMaybePropagate(variant);

        /* Contract asserted: BooleanUtils.toBoolean(String) recognizes the documented
         * boolean words case-insensitively ("true"/"false"/"on"/"off"/"yes"/"no").
         * Therefore any case-variant of one canonical token must produce the same result
         * as the canonical lower-case token. A patch that merely suppresses the crash or
         * makes the crashing branch unreachable but returns the wrong boolean for some
         * variants would violate this observable API behaviour.
         */
        checkEquivalentInputs(base, variant);

        String mutated = mutateNearLiteral(base, data);
        callAndMaybePropagate(mutated);

        String prefix = data.consumeAsciiString(3);
        String suffix = data.consumeAsciiString(3);
        callAndMaybePropagate(prefix + base);
        callAndMaybePropagate(base + suffix);
        callAndMaybePropagate(prefix + base + suffix);

        int maxLen = data.consumeInt(0, 8);
        String randomAscii = data.consumeAsciiString(maxLen);
        callAndMaybePropagate(randomAscii);

        if (data.consumeBoolean()) {
            String remaining = data.consumeRemainingAsString();
            callAndMaybePropagate(remaining);
        }
    }

    private static void checkEquivalentInputs(String canonical, String variant) {
        try {
            boolean lhs = BooleanUtils.toBoolean(canonical);
            boolean rhs = BooleanUtils.toBoolean(variant);
            if (lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: case-insensitive equivalent inputs input=" + quote(variant)
                        + " lhs=" + lhs + " rhs=" + rhs + " canonical=" + quote(canonical));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static void callAndMaybePropagate(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (data.consumeBoolean()) {
                out.append(Character.toUpperCase(c));
            } else {
                out.append(Character.toLowerCase(c));
            }
        }
        return out.toString();
    }

    private static String mutateNearLiteral(String s, FuzzedDataProvider data) {
        StringBuffer out = new StringBuffer(s);
        int action = data.consumeInt(0, 3);
        if (action == 0 && out.length() > 0) {
            int idx = data.consumeInt(0, out.length() - 1);
            out.setCharAt(idx, data.consumeAsciiString(1).length() == 0 ? 'X' : data.consumeAsciiString(1).charAt(0));
        } else if (action == 1) {
            int idx = out.length() == 0 ? 0 : data.consumeInt(0, out.length());
            String add = data.consumeAsciiString(1);
