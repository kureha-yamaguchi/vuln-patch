        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int first = data.consumeInt(0, maxOrd - 3);\n        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first));\n        int second = first + initialGap;\n        ords[0] = first;\n        ords[1] = second;\n\n        int current = second;\n        for (int i = 2; i < count; i++) {\n            int remaining = count - i;\n            int maxStep = maxOrd - current - remaining + 1;\n            if (maxStep < 1) {\n                maxStep = 1;\n            }\n            int step = data.consumeInt(1, Math.min(64, maxStep));\n            current += step;\n            ords[i] = current;\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < count; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int gapIndex = findGap(ords);\n        if (gapIndex == -1) {\n            return;\n        }\n\n        int left = ords[gapIndex];\n        int right = ords[gapIndex + 1];\n        if (right - left < 2) {\n            return;\n        }\n\n        int startOrd = data.consumeInt(left + 1, right - 1);\n        int endOrd = data.consumeInt(startOrd, right - 1);\n\n        Day start = dayFromOrdinal(startOrd);\n        Day end = dayFromOrdinal(endOrd);\n\n        try {\n            series.getIndex(start);\n            series.getIndex(end);\n\n            TimeSeries copy = series.createCopy(start, end);\n            if (copy == null) {\n                throw new RuntimeException(\"null copy\");\n            }\n\n            if (copy.getItemCount() != 0) {\n                throw new RuntimeException(\"metamorphic violation: copy wholly inside a gap must be empty\");\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        if (right - left >= 3) {\n            int startOrd2 = data.consumeInt(left + 1, right - 1);\n            int endOrd2 = data.consumeInt(startOrd2, right - 1);\n\n            Day start2 = dayFromOrdinal(startOrd2);\n            Day end2 = dayFromOrdinal(endOrd2);\n\n            try {\n                TimeSeries copyA = series.createCopy(start, end);\n                TimeSeries copyB = series.createCopy(start2, end2);\n                if (copyA.getItemCount() != copyB.getItemCount()) {\n                    throw new RuntimeException(\"metamorphic violation: two copies from the same empty gap disagree on itemCount\");\n                }\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            if (byPeriod.getItemCount() != byIndex.getItemCount()) {\n                throw new RuntimeException(\"metamorphic violation: existing-period copy != index copy itemCount\");\n            }\n            for (int k = 0; k < byPeriod.getItemCount(); k++) {\n                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {\n                    throw new RuntimeException(\"metamorphic violation: existing-period copy != index copy periods\");\n                }\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int first = data.consumeInt(0, maxOrd - (count + 4));\n        int gap = data.consumeInt(2, 40);\n        ords[0] = first;\n        ords[1] = Math.min(maxOrd, first + gap);\n\n        for (int i = 2; i < count; i++) {\n            int minNext = ords[i - 1] + 1;\n            int maxNext = maxOrd - (count - 1 - i);\n            if (minNext > maxNext) {\n                return;\n            }\n            ords[i] = data.consumeInt(minNext, maxNext);\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < ords.length; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        try {\n            series.getIndex(series.getTimePeriod(0));\n            series.getIndex(series.getTimePeriod(series.getItemCount() - 1));\n        } catch (IllegalArgumentException e) {\n            return;\n        }\n\n        int beforeFirst = ords[0] - 1;\n        if (beforeFirst >= 0) {\n            Day before = dayFromOrdinal(beforeFirst);\n            try {\n                series.getIndex(before);\n                TimeSeries emptyClone = series.createCopy(before, before);\n                if (emptyClone == null) {\n                    throw new RuntimeException(\"null clone-path copy\");\n                }\n                if (emptyClone.getItemCount() != 0) {\n                    throw new RuntimeException(\"metamorphic violation: copy before first item must be empty\");\n                }\n            } catch (CloneNotSupportedException e) {\n                return;\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            }\n        }\n\n        int left = ords[0];\n        int right = ords[1];\n        if (right - left >= 2) {\n            int startOrd1 = data.consumeInt(left + 1, right - 1);\n            int endOrd1 = data.consumeInt(startOrd1, right - 1);\n            Day start1 = dayFromOrdinal(startOrd1);\n            Day end1 = dayFromOrdinal(endOrd1);\n\n            try {\n                int idx1 = series.getIndex(start1);\n                int idx2 = series.getIndex(end1);\n                TimeSeries gapCopy = series.createCopy(start1, end1);\n                if (gapCopy == null) {\n                    throw new RuntimeException(\"null gap copy\");\n                }\n                if (idx1 >= 0 || idx2 >= 0) {\n                    return;\n                }\n            } catch (CloneNotSupportedException e) {\n                return;\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            }\n\n            if (right - left >= 3) {\n                int startOrd2 = data.consumeInt(left + 1, right - 1);\n                int endOrd2 = data.consumeInt(startOrd2, right - 1);\n                Day start2 = dayFromOrdinal(startOrd2);\n                Day end2 = dayFromOrdinal(endOrd2);\n\n                try {\n                    TimeSeries copyA = series.createCopy(start1, end1);\n                    TimeSeries copyB = series.createCopy(start2, end2);\n                    assertEquivalentCopies(copyA, copyB, \"same-gap ranges\");\n                } catch (CloneNotSupportedException e) {\n                    return;\n                } catch (IllegalArgumentException e) {\n                    if (isRootCause(e)) {\n                        throw e;\n                    }\n                    return;\n                }\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n            RegularTimePeriod startExisting = series.getTimePeriod(i);\n            RegularTimePeriod endExisting = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);\n            TimeSeries byIndex = series.createCopy(i, j);\n            assertEquivalentCopies(byPeriod, byIndex, \"existing-period copy equals index copy\");\n        } catch (CloneNotSupportedException e) {\n            return;\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n        int maxOrd = 28 * 12 * 30 - 1;\n\n        ords[0] = data.consumeInt(0, maxOrd - 3);\n        ords[1] = ords[0] + data.consumeInt(2, Math.min(64, maxOrd - ords[0]));\n        for (int i = 2; i < count; i++) {\n            int remaining = count - i;\n            int maxStep = maxOrd - ords[i - 1] - remaining;\n            if (maxStep < 1) {\n                ords[i] = ords[i - 1] + 1;\n            } else {\n                ords[i] = ords[i - 1] + data.consumeInt(1, maxStep);\n            }\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < count; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int beforeFirstOrd = ords[0] - 1;\n        if (beforeFirstOrd >= 0) {\n            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);\n            series.getIndex(beforeFirst);\n            try {\n                TimeSeries emptyCloneCopy = series.createCopy(beforeFirst, beforeFirst);\n                if (emptyCloneCopy == null) {\n                    throw new RuntimeException(\"null clone-path copy\");\n                }\n                if (emptyCloneCopy.getItemCount() != 0) {\n                    throw new RuntimeException(\"metamorphic violation: before-first copy must be empty\");\n                }\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        int gapLeft = -1;\n        for (int i = 0; i < ords.length - 1; i++) {\n            if (ords[i + 1] - ords[i] >= 2) {\n                gapLeft = i;\n                break;\n            }\n        }\n        if (gapLeft == -1) {\n            return;\n        }\n\n        int leftOrd = ords[gapLeft];\n        int rightOrd = ords[gapLeft + 1];\n        int gapStartOrd = data.consumeInt(leftOrd + 1, rightOrd - 1);\n        int gapEndOrd = data.consumeInt(gapStartOrd, rightOrd - 1);\n\n        Day gapStart = dayFromOrdinal(gapStartOrd);\n        Day gapEnd = dayFromOrdinal(gapEndOrd);\n\n        series.getIndex(gapStart);\n        series.getIndex(gapEnd);\n\n        try {\n            TimeSeries gapCopy = series.createCopy(gapStart, gapEnd);\n            if (gapCopy == null) {\n                throw new RuntimeException(\"null gap copy\");\n            }\n\n            if (rightOrd - leftOrd >= 3) {\n                int gapStartOrd2 = data.consumeInt(leftOrd + 1, rightOrd - 1);\n                int gapEndOrd2 = data.consumeInt(gapStartOrd2, rightOrd - 1);\n\n                Day gapStart2 = dayFromOrdinal(gapStartOrd2);\n                Day gapEnd2 = dayFromOrdinal(gapEndOrd2);\n\n                series.getIndex(gapStart2);\n                series.getIndex(gapEnd2);\n\n                TimeSeries gapCopy2 = series.createCopy(gapStart2, gapEnd2);\n                assertSameSeries(gapCopy, gapCopy2, \"same-gap ranges\");\n            }\n\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            series.getIndex(existingStart);\n            series.getIndex(existingEnd);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n            assertSameSeries(byPeriod, byIndex, \"existing-period copy vs index copy\");\n  