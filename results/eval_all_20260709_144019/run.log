        }

        int count = data.consumeInt(2, 8);
        int maxOrd = 28 * 12 * 20 - 1;
        int[] ords = new int[count];

        int first = data.consumeInt(0, maxOrd - 3);
        int gap = data.consumeInt(2, Math.min(64, maxOrd - first));
        int second = first + gap;
        ords[0] = first;
        ords[1] = second;

        int current = second;
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - current - remaining + 1;
            if (maxStep < 1) {
                maxStep = 1;
            }
            int step = data.consumeInt(1, maxStep);
            current += step;
            ords[i] = current;
        }
        Arrays.sort(ords);

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < ords.length; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int gapStartOrd = ords[0] + 1;
        int gapEndOrd = ords[1] - 1;
        if (gapStartOrd <= gapEndOrd) {
            int startOrd1 = data.consumeInt(gapStartOrd, gapEndOrd);
            int endOrd1 = data.consumeInt(startOrd1, gapEndOrd);

            Day start1 = dayFromOrdinal(startOrd1);
            Day end1 = dayFromOrdinal(endOrd1);

            int startIndex = series.getIndex(start1);
            int endIndex = series.getIndex(end1);

            try {
                TimeSeries gapCopy = series.createCopy(start1, end1);
                if (startIndex < 0 && endIndex < 0) {
                    int insertionPoint = -(startIndex + 1);
                    int endBefore = -(endIndex + 1) - 1;
                    if (endBefore < insertionPoint && gapCopy.getItemCount() != 0) {
                        throw new RuntimeException("metamorphic violation: copy over empty gap must be empty");
                    }
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }

            if (gapEndOrd - gapStartOrd >= 1) {
                int startOrd2 = data.consumeInt(gapStartOrd, gapEndOrd);
                int endOrd2 = data.consumeInt(startOrd2, gapEndOrd);

                Day start2 = dayFromOrdinal(startOrd2);
                Day end2 = dayFromOrdinal(endOrd2);

                try {
                    TimeSeries copy1 = series.createCopy(start1, end1);
                    TimeSeries copy2 = series.createCopy(start2, end2);
                    if (copy1.getItemCount() != copy2.getItemCount()) {
                        throw new RuntimeException("metamorphic violation: same-gap ranges produced different item counts");
                    }
                    for (int i = 0; i < copy1.getItemCount(); i++) {
                        if (!copy1.getTimePeriod(i).equals(copy2.getTimePeriod(i))) {
                            throw new RuntimeException("metamorphic violation: same-gap ranges produced different periods");
                        }
                    }
                } catch (IllegalArgumentException e) {
                    if (isRootCause(e)) {
                        throw e;
                    }
                    return;
                } catch (CloneNotSupportedException e) {
                    return;
                }
            }
        }

        int beforeFirst = ords[0] - 1;
        if (beforeFirst >= 0) {
            Day d = dayFromOrdinal(beforeFirst);
            try {
                series.getIndex(d);
                TimeSeries empty = series.createCopy(d, d);
                if (empty == null) {
                    throw new RuntimeException("null clone-path copy");
                }
                if (empty.getItemCount() != 0) {
                    throw new RuntimeException("metamorphic violation: copy before first item must be empty");
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod startExisting = series.getTimePeriod(i);
            RegularTimePeriod endExisting = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(startExisting, endExisting);
            TimeSeries byIndex = series.createCopy(i, j);

            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                throw new RuntimeException("metamorphic violation: existing-period copy != index copy itemCount");
            }
            for (int k = 0; k < byPeriod.getItemCount(); k++) {
                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {
                    throw new RuntimeException("metamorphic violation: existing-period copy != index copy timePeriod");
                }
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
