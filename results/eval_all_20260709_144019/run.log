package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int k = data.consumeInt(-20, 20);
        double baseRoot = k * Math.PI;

        double leftPad = 0.01 + (Math.abs(data.consumeInt()) % 1000) / 1000.0;
        double rightPad = 0.01 + (Math.abs(data.consumeInt()) % 1000) / 1000.0;
        double min = baseRoot - leftPad;
        double max = baseRoot + rightPad;
        if (min > max) {
            double t = min;
            min = max;
            max = t;
        }

        double initial;
        if (data.consumeBoolean()) {
            initial = min + (max - min) / 2.0;
        } else {
            int bucket = data.consumeInt(0, 1000);
            initial = min + (max - min) * (bucket / 1000.0);
        }

        runScenario(new SinFunction(), min, max, initial);

        double shift = (Math.abs(data.consumeInt()) % 1000) / 1000000.0;
        runScenario(new SinFunction(), min - shift, max + shift, initial);
    }

    private static void anchor() {
        runScenario(new SinFunction(), 3.0, 3.2, 3.1);
    }

    private static void runScenario(UnivariateRealFunction f, double min, double max, double initial) {
        BisectionSolver solverWithInitial = new BisectionSolver();
        double withInitial;
        try {
            withInitial = solverWithInitial.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        BisectionSolver solverWithoutInitial = new BisectionSolver();
        double withoutInitial;
        try {
            withoutInitial = solverWithoutInitial.solve(f, min, max);
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract/metamorphic check:
         * In this implementation, solve(f, min, max, initial) is supposed to delegate to solve(f, min, max),
         * so for every correctly accepted input both public API calls must produce the same root.
         * A bogus "fix" that merely avoids the crash but skips or changes the delegated behavior would violate this.
         * Per the hygiene rule, if either side throws, the relation does not apply and we already returned.
         */
        double diff = Math.abs(withInitial - withoutInitial);
        double tol = Math.max(solverWithInitial.getAbsoluteAccuracy(), solverWithoutInitial.getAbsoluteAccuracy()) * 2.0 + 1e-12;
        if (!(diff <= tol || (Double.isNaN(withInitial) && Double.isNaN(withoutInitial)))) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input="
                    + min + "," + max + "," + initial + " lhs=" + withInitial + " rhs=" + withoutInitial);
        }

        if (f instanceof SinFunction && min <= Math.PI && Math.PI <= max) {
            double expected = Math.PI;
            if (Math.abs(withInitial - expected) > solverWithInitial.getAbsoluteAccuracy() * 2.0 + 1e-12) {
