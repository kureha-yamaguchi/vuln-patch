    private static double[] makeObjective(int n, FuzzedDataProvider data) {
        double[] c = new double[n];
        c[0] = data.consumeBoolean() ? 1.0 : 0.0;
        for (int i = 1; i < n; i++) {
            c[i] = data.consumeInt(-1, 1);
        }
        return c;
    }

    private static double[] makeAnchorObjective(int n) {
        double[] c = new double[n];
        c[0] = 1.0;
        return c;
    }

    private static void exerciseTableauAccessors(LinearObjectiveFunction f, List<LinearConstraint> constraints) {
        try {
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6);
            int numObj = tableau.getNumObjectiveFunctions();
            int h = tableau.getHeight();
            int w = tableau.getWidth();
            int numArt = tableau.getNumArtificialVariables();
            int artOff = tableau.getArtificialVariableOffset();

            if (h > 0 && w > 0) {
                tableau.getEntry(0, 0);
                tableau.getEntry(h - 1, w - 1);
            }

            if (numArt > 0) {
                int c = artOff;
                if (c >= 0 && c < w) {
                    tableau.getBasicRow(c);
                    if (numObj < h) {
                        tableau.getEntry(numObj, c);
                    }
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void solveAndCheck(LinearObjectiveFunction f, List<LinearConstraint> constraints, GoalType goalType) {
        try {
            SimplexSolver solver = new SimplexSolver();
            solver.setMaxIterations(100);
            PointValuePair p = solver.optimize(f, constraints, goalType, true);
            if (p != null) {
                assertSatisfies(constraints, p.getPoint());
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void metamorphicOrderInvariant(LinearObjectiveFunction f,
                                                  List<LinearConstraint> original,
                                                  List<LinearConstraint> permuted,
                                                  GoalType goalType) {
        PointValuePair left;
        PointValuePair right;
        try {
            SimplexSolver s1 = new SimplexSolver();
            s1.setMaxIterations(100);
            left = s1.optimize(f, original, goalType, true);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
        try {
            SimplexSolver s2 = new SimplexSolver();
            s2.setMaxIterations(100);
            right = s2.optimize(f, permuted, goalType, true);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (left == null || right == null) {
            return;
        }

        try {
            assertSatisfies(original, left.getPoint());
            assertSatisfies(permuted, right.getPoint());
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted: reordering a collection of linear constraints does not change the LP's feasible set
         * or optimum, because the constraints are conjunctive and SimplexSolver's public API takes a Collection of
         * LinearConstraint, not an ordered program. A patch that merely suppresses the cycling path or skips the
         * intended tie-breaking behavior can silently make the result depend on row order.
         */
        double lv = left.getValue();
        double rv = right.getValue();
        if (Math.abs(lv - rv) > 1.0e-6) {
            throw new RuntimeException(
                    "metamorphic violation: constraint-order optimum changed lhs=" + lv + " rhs=" + rv
                            + " originalSize=" + original.size() + " permutedSize=" + permuted.size());
        }
    }

    private static void assertSatisfies(List<LinearConstraint> constraints, double[] point) {
        if (point == null) {
            throw new RuntimeException("metamorphic violation: null solution point");
        }
        for (int i = 0; i < constraints.size(); i++) {
            LinearConstraint c = constraints.get(i);
            double lhs = dot(c.getCoefficients().toArray(), point);
            double rhs = c.getValue();
            Relationship r = c.getRelationship();
            if (r == Relationship.LEQ) {
                if (lhs - rhs > 1.0e-6) {
                    throw new RuntimeException("metamorphic violation: LEQ violated at " + i + " lhs=" + lhs + " rhs=" + rhs);
                }
            } else if (r == Relationship.GEQ) {
                if (rhs - lhs > 1.0e-6) {
                    throw new RuntimeException("metamorphic violation: GEQ violated at " + i + " lhs=" + lhs + " rhs=" + rhs);
                }
            } else {
                if (Math.abs(lhs - rhs) > 1.0e-6) {
                    throw new RuntimeException("metamorphic violation: EQ violated at " + i + " lhs=" + lhs + " rhs=" + rhs);
                }
            }
        }
    }

    private static double dot(double[] a, double[] b) {
        int n = Math.min(a.length, b.length);
        double s = 0.0;
        for (int i = 0; i < n; i++) {
            s += a[i] * b[i];
        }
        return s;
    }

    private static boolean isCleanRejection(Throwable t) {
        return (t instanceof IllegalArgumentException)
                || (t instanceof NumberFormatException)
                || (t instanceof MathIllegalArgumentException);
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof RuntimeException && !(t instanceof MaxCountExceededException)) {
            return true;
        }
        if (!(t instanceof MaxCountExceededException) && !(t instanceof MathIllegalStateException)) {
