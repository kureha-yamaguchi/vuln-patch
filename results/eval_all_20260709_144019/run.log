package org.jfree.chart.renderer;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Color;
import java.awt.Paint;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        GrayPaintScale anchor = new GrayPaintScale();

        // ANCHOR: exact regression inputs from GrayPaintScaleTests.testGetPaint().
        // These inputs are valid by construction: getPaint() is supposed to clamp
        // values outside the bounds and return black/white rather than throw.
        callAndPropagateOnlyRootCause(anchor, -0.5d);
        callAndPropagateOnlyRootCause(anchor, 1.5d);

        // Also assert the observable contract from the regression test:
        // values below the lower bound map to Color.black and values above the
        // upper bound map to Color.white. A "fix" that merely deletes the throw
        // but returns the wrong color would violate this.
        try {
            Paint pLow = anchor.getPaint(-0.5d);
            Paint pHigh = anchor.getPaint(1.5d);
            if ((pLow instanceof Color) && !Color.black.equals((Color) pLow)) {
                throw new RuntimeException("metamorphic violation: anchored below-lower-bound should map to black input=-0.5 got=" + pLow);
            }
            if ((pHigh instanceof Color) && !Color.white.equals((Color) pHigh)) {
                throw new RuntimeException("metamorphic violation: anchored above-upper-bound should map to white input=1.5 got=" + pHigh);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // EXPLORE:
        // Root-cause property: any value outside the scale bounds must be clamped
        // before converting to a Color component. Therefore getPaint(v) must be
        // equivalent to getPaint(clamp(v, lower, upper)).
        //
        // We generate valid-by-construction scales with lower < upper and values
        // below, within, and above the bounds, emphasizing out-of-range values.
        double lower = data.consumeInt(-1000, 1000);
        double span = data.consumeInt(1, 1000);
        double upper = lower + span;
        GrayPaintScale gps;
        try {
            gps = new GrayPaintScale(lower, upper);
        } catch (RuntimeException t) {
            // Constructor rejection here is outside the patched method and not a finding.
            return;
        }

        double value = chooseValue(data, lower, upper);

        // First, directly exercise the real public API and propagate only the
        // verified root cause from GrayPaintScale.getPaint().
        callAndPropagateOnlyRootCause(gps, value);

        // Mandatory metamorphic/post-condition check:
        // By the method's own logic, out-of-range inputs are clamped into
        // [lowerBound, upperBound] before color computation. Therefore for every
        // correct implementation:
        //   getPaint(v) == getPaint(clamp(v, lower, upper))
        // for all finite v, including edge cases at and beyond the bounds.
        // If either side throws, hygiene rules say the relation does not apply.
        double clamped = clamp(value, lower, upper);
        try {
            Paint lhs = gps.getPaint(value);
            Paint rhs = gps.getPaint(clamped);
            if (lhs instanceof Color && rhs instanceof Color) {
                if (!lhs.equals(rhs)) {
                    throw new RuntimeException(
                        "metamorphic violation: getPaint(v) must equal getPaint(clamp(v))"
                            + " input=" + value
                            + " lower=" + lower
                            + " upper=" + upper
                            + " clamped=" + clamped
                            + " lhs=" + lhs
                            + " rhs=" + rhs);
                }
            } else if (lhs != null ? !lhs.equals(rhs) : rhs != null) {
                throw new RuntimeException(
                    "metamorphic violation: getPaint(v) must equal getPaint(clamp(v))"
                        + " input=" + value
                        + " lower=" + lower
                        + " upper=" + upper
                        + " clamped=" + clamped
                        + " lhs=" + lhs
                        + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (isMetamorphicViolation(t)) {
                throw t;
            }
            return;
        }
    }

    private static double chooseValue(FuzzedDataProvider data, double lower, double upper) {
        int mode = data.consumeInt(0, 7);
        double delta = Math.abs(data.consumeInt()) + 1.0;
        switch (mode) {
            case 0:
                return lower - delta; // definitely below
            case 1:
                return upper + delta; // definitely above
            case 2:
                return lower; // exact lower bound
            case 3:
                return upper; // exact upper bound
            case 4:
                return lower + (upper - lower) / 2.0; // interior
            case 5:
                return lower - (delta / 255.0); // small below-bound offset
            case 6:
                return upper + (delta / 255.0); // small above-bound offset
            default:
                int numerator = data.consumeInt(-1000000, 1000000);
                return lower + ((upper - lower) * numerator) / 1000000.0;
        }
    }

    private static double clamp(double v, double lower, double upper) {
        double x = Math.max(v, lower);
        return Math.min(x, upper);
    }

    private static void callAndPropagateOnlyRootCause(GrayPaintScale gps, double value) {
        try {
            gps.getPaint(value);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
