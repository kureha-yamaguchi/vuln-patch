package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int meanInt = data.consumeInt(-8, 8);
        int step = data.consumeInt(0, 8);
        int scale = data.consumeInt(1, 20);
        double mean = meanInt;
        double sd = scale / 4.0;
        double x = mean + step;

        try {
            NormalDistributionImpl dist = new NormalDistributionImpl(mean, sd);
            double p = dist.cumulativeProbability(x);
            double inv = dist.inverseCumulativeProbability(p);

            /* Contract asserted: for a continuous strictly increasing distribution,
             * inverseCumulativeProbability(cumulativeProbability(x)) should recover x.
             * This is an oracle-from-input relation built entirely from real library calls.
             * A patch that merely suppresses the bracketing failure but returns the wrong
             * endpoint/value would violate this even if no exception is thrown.
             */
            if (Double.isFinite(inv) && Math.abs(inv - x) > 1.0e-9) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x))!=x input="
                        + "mean=" + mean
                        + " sd=" + sd
                        + " x=" + x
                        + " p=" + p
                        + " inv=" + inv);
            }

            double q = 1.0 - p;
            try {
                double invQ = dist.inverseCumulativeProbability(q);
                /* Contract asserted: for Normal(mean, sd), symmetry implies
                 * inverseCumulativeProbability(1-p) == 2*mean - inverseCumulativeProbability(p).
                 * Both sides are real library calls/values from the same distribution.
                 */
                double reflected = 2.0 * mean - inv;
                if (Double.isFinite(invQ) && Math.abs(invQ - reflected) > 1.0e-9) {
                    throw new RuntimeException(
                        "metamorphic violation: normal symmetry input="
                            + "mean=" + mean
                            + " sd=" + sd
                            + " p=" + p
                            + " inv(p)=" + inv
                            + " inv(1-p)=" + invQ
                            + " reflected=" + reflected);
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
                if (!isCleanRejection(t)) {
                    return;
                }
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void anchor() {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);
            double result = normal.inverseCumulativeProbability(0.9772498680518209d);
            if (Math.abs(result - 2.0d) > 1.0e-12) {
                throw new RuntimeException(
                    "metamorphic violation: anchor quantile expected 2.0 got " + result);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            if (!isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.startsWith("org.apache.commons.math")) {
                String simple = cur.getClass().getSimpleName();
                if (simple.contains("Illegal") || simple.contains("Invalid")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        boolean classMatch = false;
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof MathException) {
                classMatch = true;
                break;
            }
        }
        if (!classMatch && !(t instanceof RuntimeException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && ("createIllegalArgumentException".equals(method) || "buildMessage".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math.distribution.NormalDistributionImpl".equals(cls)
                    && ("value".equals(method) || "<init>".equals(method))) {
                return true;
            }
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
