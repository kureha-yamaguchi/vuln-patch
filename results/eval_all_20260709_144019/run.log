package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        probeGetClass(data);

        Class<?>[] nullResult = ClassUtils.toClass(null);
        if (nullResult != null) {
            throw new RuntimeException("metamorphic violation: toClass(null) should return null");
        }

        Class<?>[] emptyResult = ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        if (emptyResult != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("metamorphic violation: toClass(empty) should return EMPTY_CLASS_ARRAY");
        }

        Class<?>[] normalResult = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        if (normalResult == null
                || normalResult.length != 3
                || normalResult[0] != String.class
                || normalResult[1] != Integer.class
                || normalResult[2] != Double.class) {
            throw new RuntimeException("metamorphic violation: unexpected mapping for non-null anchor input");
        }

        exerciseToClass(new Object[] { "Test", null, Double.valueOf(99d) });

        int len = data.consumeInt(0, 32);
        Object[] array = new Object[len];
        boolean mustInsertNull = len > 0 && data.consumeBoolean();
        int forcedNullIndex = len > 0 ? data.consumeInt(0, len - 1) : -1;

        for (int i = 0; i < len; i++) {
            if (mustInsertNull && i == forcedNullIndex) {
                array[i] = null;
                continue;
            }
            switch (data.consumeInt(0, 9)) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(64);
                    break;
                case 2:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    array[i] = Long.valueOf((long) data.consumeInt());
                    break;
                case 4:
                    array[i] = Double.valueOf((double) data.consumeInt());
                    break;
                case 5:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 6:
                    array[i] = data.consumeBytes(data.consumeInt(0, Math.min(16, data.remainingBytes())));
                    break;
                case 7:
                    array[i] = new Object[] { data.consumeAsciiString(8), data.consumeBoolean() ? null : Integer.valueOf(data.consumeInt()) };
                    break;
                case 8:
                    array[i] = new int[] { data.consumeInt(), data.consumeInt() };
                    break;
                default:
                    array[i] = chooseKnownObject(data);
                    break;
            }
        }

        exerciseToClass(array);

        if (array.length > 0) {
            int split = data.consumeInt(0, array.length);
            Object[] left = ArrayUtils.subarray(array, 0, split);
            Object[] right = ArrayUtils.subarray(array, split, array.length);
            exerciseCompositionRelation(left, right);
        }
    }

    private static void probeGetClass(FuzzedDataProvider data) {
        ClassLoader cl = Thread.currentThread().getContextClassLoader();
        if (cl == null) {
            cl = ClassUtils.class.getClassLoader();
        }

        try {
            Class<?> a = ClassUtils.getClass(cl, "java.lang.String", false);
            Class<?> b = ClassUtils.getClass("java.lang.String", false);
            if (a != b) {
                throw new RuntimeException("metamorphic violation: getClass overload equivalence lhs=" + a + " rhs=" + b);
            }
        } catch (ClassNotFoundException e) {
            return;
        } catch (LinkageError e) {
            return;
        } catch (SecurityException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (!isCleanRejection(e)) {
                return;
            }
        }

        String name = data.consumeAsciiString(64);
        if (name.length() == 0) {
            return;
        }
        try {
            ClassUtils.getClass(cl, name, data.consumeBoolean());
        } catch (ClassNotFoundException e) {
        } catch (LinkageError e) {
        } catch (SecurityException e) {
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static Object chooseKnownObject(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                return String.class;
            case 1:
                return Integer.class;
            case 2:
                return ArrayUtils.EMPTY_OBJECT_ARRAY;
            case 3:
                return ArrayUtils.EMPTY_CLASS_ARRAY;
            case 4:
                return data.consumeRemainingAsString();
            default:
                return new Object[] { "seed", null, Integer.valueOf(7) };
        }
    }

    private static void exerciseToClass(Object[] array) {
        final Class<?>[] classes;
        try {
            classes = ClassUtils.toClass(array);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            return;
        }

        if (classes == null || classes.length != array.length) {
            throw new RuntimeException("metamorphic violation: result shape mismatch inputLength="
                    + array.length + " resultLength=" + (classes == null ? -1 : classes.length));
        }

        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (classes[i] != expected) {
                throw new RuntimeException("metamorphic violation: element mapping mismatch at index="
                        + i + " input=" + String.valueOf(array[i]) + " expected=" + expected + " actual=" + classes[i]);
            }
        }

        // Contract visible from the test and implementation: toClass maps each element independently to
        // element.getClass(), preserving nulls and array length. Therefore cloning the input array must not
        // change the result; a patch that merely suppresses work or skips elements would violate this.
        try {
            Class<?>[] clonedResult = ClassUtils.toClass(ArrayUtils.clone(array));
            if (!java.util.Arrays.equals(classes, clonedResult)) {
                throw new RuntimeException("metamorphic violation: toClass(array) != toClass(clone(array)) lhs="
                        + java.util.Arrays.toString(classes) + " rhs=" + java.util.Arrays.toString(clonedResult));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void exerciseCompositionRelation(Object[] left, Object[] right) {
        Class<?>[] whole;
        Class<?>[] lhs;
        Class<?>[] rhs;
        try {
            whole = ClassUtils.toClass(ArrayUtils.addAll(left, right));
            lhs = ClassUtils.toClass(left);
            rhs = ClassUtils.toClass(right);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        Class<?>[] parts;
        try {
            parts = ArrayUtils.addAll(lhs, rhs);
        } catch (RuntimeException e) {
            return;
        }

        // Each output position depends only on the corresponding input element, so applying toClass to a
        // concatenation must equal concatenating the per-part results.
        if (!java.util.Arrays.equals(whole, parts)) {
            throw new RuntimeException("metamorphic violation: composition left="
                    + java.util.Arrays.toString(left)
                    + " right=" + java.util.Arrays.toString(right)
                    + " whole=" + java.util.Arrays.toString(whole)
                    + " parts=" + java.util.Arrays.toString(parts));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof SecurityException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException) && !(t instanceof RuntimeException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && ("toClass".equals(ste.getMethodName()) || "getClass".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
