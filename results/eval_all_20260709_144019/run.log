            StringUtils.join(new Object[] { nullToStringObject }, '/', 0, 1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // Also drive the sibling patched overload.
        try {
            StringUtils.join(new Object[] { nullToStringObject }, "/", 0, 1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        int len = data.consumeInt(1, 6);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            int kind = data.consumeInt(0, 4);
            switch (kind) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(32);
                    break;
                case 2:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                default:
                    array[i] = ArrayUtils.toString(data.consumeBytes(8));
                    break;
            }
        }

        int startIndex = data.consumeInt(0, len - 1);
        int endIndex = data.consumeInt(startIndex, len);

        // EXPLORE the root-cause property: the element at startIndex has a toString() that returns null.
        if (data.consumeBoolean()) {
            array[startIndex] = nullToStringObject;
            if (endIndex <= startIndex) {
                endIndex = startIndex + 1;
            }
        }

        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString;
        if (data.consumeBoolean()) {
            sepString = String.valueOf(sepChar);
        } else if (data.consumeBoolean()) {
            sepString = null;
        } else {
            sepString = data.consumeString(3);
        }

        try {
            StringUtils.join(array, sepChar, startIndex, endIndex);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        try {
            StringUtils.join(array, sepString, startIndex, endIndex);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // Metamorphic check:
        // For any correct implementation, using the char overload and the String overload with the
        // one-character equivalent separator must produce the same joined result on the same slice.
        // A throw-deleting or behaviour-skipping patch in either overload would violate this observable contract.
        try {
            String lhs = StringUtils.join(array, sepChar, startIndex, endIndex);
            String rhs = StringUtils.join(array, String.valueOf(sepChar), startIndex, endIndex);
            if (lhs != null ? !lhs.equals(rhs) : rhs != null) {
                throw new RuntimeException(
                    "metamorphic violation: char-vs-string separator equivalence input[start=" + startIndex
                        + ",end=" + endIndex + ",sep=" + ((int) sepChar) + "] lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && t.getMessage() != null
                    && t.getMessage().startsWith("metamorphic violation:")) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static Object makeNullToStringObject() {
        InvocationHandler handler = new InvocationHandler() {
            public Object invoke(Object proxy, Method method, Object[] args) {
                String name = method.getName();
                if ("toString".equals(name)) {
                    return null;
                }
                if ("hashCode".equals(name)) {
                    return Integer.valueOf(0);
                }
                if ("equals".equals(name)) {
                    return Boolean.valueOf(proxy == (args == null || args.length == 0 ? null : args[0]));
                }
                return null;
            }
        };
        return Proxy.newProxyInstance(
            FuzzHarness.class.getClassLoader(),
            new Class<?>[] { Runnable.class },
            handler);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.StringUtils".equals(cls)
                    && ("join".equals(method) || "length".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.AnnotationUtils".equals(cls) && "toString".equals(method)) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
