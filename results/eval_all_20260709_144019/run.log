        } catch (NumberFormatException expected) {
        }

        try {
            NumberUtils.createNumber(decimalNoExponent + "D");
        } catch (NumberFormatException expected) {
        }

        try {
            NumberUtils.createNumber(decimalNoExponent + "F");
        } catch (NumberFormatException expected) {
        }

        String digits = data.consumeAsciiString(20);
        StringBuilder intSb = new StringBuilder();
        if (data.consumeBoolean()) {
            intSb.append('-');
        }
        if (digits.length() == 0) {
            intSb.append('0');
        } else {
            for (int i = 0; i < digits.length(); i++) {
                intSb.append((char) ('0' + (digits.charAt(i) % 10)));
            }
        }
        String integerLike = intSb.toString();

        try {
            NumberUtils.createNumber(integerLike);
        } catch (NumberFormatException expected) {
        }

        try {
            NumberUtils.createNumber(integerLike + "L");
        } catch (NumberFormatException expected) {
        }

        String expDigitsSrc = data.consumeAsciiString(8);
        StringBuilder expSb = new StringBuilder();
        if (expDigitsSrc.length() == 0) {
            expSb.append('0');
        } else {
            if (data.consumeBoolean()) {
                expSb.append('-');
            }
            for (int i = 0; i < expDigitsSrc.length(); i++) {
                expSb.append((char) ('0' + (expDigitsSrc.charAt(i) % 10)));
            }
        }
        String exponentPart = expSb.toString();
        String scientific = decimalNoExponent + (data.consumeBoolean() ? "E" : "e") + exponentPart;

        try {
            NumberUtils.createNumber(scientific);
        } catch (NumberFormatException expected) {
        }

        try {
            NumberUtils.createNumber(scientific + (data.consumeBoolean() ? "d" : "f"));
        } catch (NumberFormatException expected) {
        }

        int oracle = data.consumeInt();
        String oracleStr = Integer.toString(oracle);
        try {
            Number parsed = NumberUtils.createNumber(oracleStr);
            Number parsedLower = NumberUtils.createNumber(oracleStr + "l");
            if (parsed == null || parsedLower == null
                    || parsed.intValue() != oracle
                    || parsedLower.longValue() != (long) oracle) {
                throw new RuntimeException("metamorphic violation: canonical integer parse");
            }
        } catch (NumberFormatException expected) {
        }

        try {
            Number upper = NumberUtils.createNumber(decimalNoExponent + "D");
            Number lower = NumberUtils.createNumber(decimalNoExponent + "d");
            if (upper != null && lower != null && !upper.equals(lower)) {
                throw new RuntimeException("metamorphic violation: D/d suffix equivalence");
            }
        } catch (NumberFormatException expected) {
        }
    }
