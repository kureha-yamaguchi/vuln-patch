package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkValidPlainDecimal("1234.5");

        exerciseKnownLiteral("12345");
        exerciseKnownLiteral("1234.5D");
        exerciseKnownLiteral("1234.5d");
        exerciseKnownLiteral("1234.5F");
        exerciseKnownLiteral("1234.5f");
        exerciseKnownLiteral("-1234.5");
        exerciseKnownLiteral("-12345");
        exerciseKnownLiteral("0xFADE");
        exerciseKnownLiteral("-0xFADE");
        exerciseKnownLiteral("1.1E200");
        exerciseKnownLiteral("1.1E20");
        exerciseKnownLiteral("-1.1E200");
        exerciseKnownLiteral("1.1E-200");
        exerciseKnownLiteral("12345L");
        exerciseKnownLiteral("12345l");
        exerciseKnownLiteral("12345678901234567890L");
        exerciseKnownLiteral("1.1E-700F");
        exerciseKnownLiteral("2.");
        exerciseKnownLiteral("-1l");
        exerciseKnownLiteral("01l");
        exerciseKnownLiteral("1l");

        String sign = data.consumeBoolean() ? "-" : "";
        String whole = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 6)));
        String frac = digitsOnly(data.consumeAsciiString(data.consumeInt(1, 6)));
        if (whole.length() == 0) {
            whole = "0";
        }
        if (frac.length() == 0) {
            frac = "0";
        }

        String plainDecimal = sign + whole + "." + frac;
        checkValidPlainDecimal(plainDecimal);

        String trailingDot = sign + whole + ".";
        exerciseKnownLiteral(trailingDot);

        String floatSuffix = plainDecimal + (data.consumeBoolean() ? "F" : "f");
        exerciseKnownLiteral(floatSuffix);

        String doubleSuffix = plainDecimal + (data.consumeBoolean() ? "D" : "d");
        exerciseKnownLiteral(doubleSuffix);

        String expDigits = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 6)));
        if (expDigits.length() == 0) {
            expDigits = "0";
        }
        String sci = sign + whole + "." + frac + (data.consumeBoolean() ? "e" : "E")
                + (data.consumeBoolean() ? "-" : "") + expDigits;
        exerciseKnownLiteral(sci);

        String integerLike = sign + whole;
        checkCanonicalInteger(integerLike);

        String hex = (data.consumeBoolean() ? "-" : "") + "0x" + Integer.toHexString(data.consumeInt());
        exerciseKnownLiteral(hex);

        if (data.remainingBytes() > 0) {
            String raw = data.consumeRemainingAsString();
            String mutatedWhole = digitsOnly(raw);
            if (mutatedWhole.length() == 0) {
                mutatedWhole = "0";
            }
            String mutatedFrac = digitsOnly(new StringBuilder(raw).reverse().toString());
            if (mutatedFrac.length() == 0) {
                mutatedFrac = "0";
            }
            String explore = (data.consumeBoolean() ? "-" : "") + mutatedWhole + "." + mutatedFrac;
            checkValidPlainDecimal(explore);
        }
    }

    private static void exerciseKnownLiteral(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("metamorphic violation: documented/seed literal should be handled without internal substring failure input=" + quote(s), t);
            }
        }
    }

    private static void checkValidPlainDecimal(String s) {
        /*
         * Contract used for this check:
         * For a valid decimal string with a decimal point and no exponent/suffix,
         * createNumber goes down the float/double/bigdecimal path. For small,
         * finite, non-underflowing decimals such as the ones we construct here,
         * the implementation first creates a Float and returns it.
         * Therefore, for these valid-by-construction inputs, createNumber(s)
         * must agree with createFloat(s), and a patch that merely suppresses
         * the old crash or skips the intended parsing branch would violate this.
         */
        Float oracle;
        try {
            oracle = NumberUtils.createFloat(s);
        } catch (RuntimeException t) {
            return;
        }

        try {
            Number parsed = NumberUtils.createNumber(s);
            if (!(parsed instanceof Float) || !oracle.equals(parsed)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(valid plain decimal) != createFloat input="
                                + quote(s) + " oracle=" + oracle + " parsed="
                                + String.valueOf(parsed) + " parsedClass="
                                + (parsed == null ? "null" : parsed.getClass().getName()));
            }
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid plain decimal should parse like createFloat input="
                                + quote(s) + " oracle=" + oracle, t);
            }
        }
    }

    private static void checkCanonicalInteger(String s) {
        /*
         * Contract used for this check:
         * For a canonical base-10 integer string with no suffix, createNumber
         * tries createInteger first, then wider integral types only on overflow.
         * Thus when we build s from Integer.toString(int)-style digits in range,
         * createNumber(s) must agree with createInteger(s).
         */
        try {
            Integer oracle = NumberUtils.createInteger(s);
            Number parsed = NumberUtils.createNumber(s);
            if (oracle != null && parsed != null) {
                if (!(parsed instanceof Integer) || parsed.intValue() != oracle.intValue()) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(canonical int) != createInteger input="
                                    + quote(s) + " oracle=" + oracle + " parsed="
                                    + String.valueOf(parsed) + " parsedClass="
                                    + parsed.getClass().getName());
                }
            }
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: canonical integer should not hit internal substring failure input="
                                + quote(s), t);
            }
        }
    }

    private static boolean isValidationRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)
                    && ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String digitsOnly(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + (c & 7)));
            }
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
