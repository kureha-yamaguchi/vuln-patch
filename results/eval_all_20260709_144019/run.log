package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            throw e;
        } catch (CloneNotSupportedException e) {
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];

        int first = data.consumeInt(0, maxOrd - (count + 4));
        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first));
        ords[0] = first;
        ords[1] = first + initialGap;

        int current = ords[1];
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - current - remaining + 1;
            if (maxStep < 1) {
                maxStep = 1;
            }
            int step = data.consumeInt(1, Math.min(64, maxStep));
            current += step;
            ords[i] = current;
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < count; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int beforeFirstOrd = ords[0] - 1;
        if (beforeFirstOrd >= 0) {
            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);
            try {
                series.getIndex(beforeFirst);
                TimeSeries empty = series.createCopy(beforeFirst, beforeFirst);
                if (empty == null) {
                    throw new RuntimeException("metamorphic violation: clone-path createCopy returned null");
                }
                if (empty.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: range before first item must copy to empty series itemCount="
                            + empty.getItemCount());
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: valid range before first item should be accepted and yield empty series",
                        e);
                }
                return;
            }
        }

        int gapIndex = findGap(ords);
        if (gapIndex == -1) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);

        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            /* Contract exercised from real API:
             * when start/end are valid non-null periods with start <= end and both lie strictly
             * inside the same gap in a sorted TimeSeries, there are no matching data items, so
             * createCopy(start, end) must return an empty TimeSeries rather than reject or invent
             * items. A throw-deleting or bookkeeping-breaking patch would violate this observable
             * itemCount post-condition or disagreement with same-gap copies below.
             */
            if (startIndex >= 0 || endIndex >= 0) {
                return;
            }
            int insertionPoint = -(startIndex + 1);
            int endBefore = -(endIndex + 1) - 1;
            if (endBefore >= insertionPoint) {
                return;
            }

            TimeSeries gapCopy = series.createCopy(start, end);
            if (gapCopy == null) {
                throw new RuntimeException("metamorphic violation: gap copy returned null");
            }
            if (gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: copy wholly inside gap must be empty startOrd=" + startOrd
                        + " endOrd=" + endOrd
                        + " itemCount=" + gapCopy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: valid same-gap range should be accepted and yield empty copy startOrd="
                        + startOrd + " endOrd=" + endOrd,
                    e);
            }
            return;
        }

        if (right - left >= 3) {
            int startOrd2 = data.consumeInt(left + 1, right - 1);
            int endOrd2 = data.consumeInt(startOrd2, right - 1);

            Day start2 = dayFromOrdinal(startOrd2);
            Day end2 = dayFromOrdinal(endOrd2);

            try {
                TimeSeries copyA = series.createCopy(start, end);
                TimeSeries copyB = series.createCopy(start2, end2);
                assertEquivalentCopies(copyA, copyB, "same-gap ranges " + startOrd + ".." + endOrd
                    + " vs " + startOrd2 + ".." + endOrd2);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: two valid same-gap ranges should both produce equivalent empty copies",
                        e);
                }
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);

            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);

            /* Contract exercised from public API examples: copying by existing start/end periods
             * must agree with copying by the corresponding indexes. This checks real createCopy
             * behavior on accepted inputs and catches silent wrong-output fixes.
             */
            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);
            assertEquivalentCopies(byPeriod, byIndex, "existing-period copy vs index copy " + i + ".." + j);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: copy by existing periods should agree with copy by indexes",
                    e);
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor createCopy returned null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid same-gap range should be accepted and produce empty copy",
                    e);
            }
            throw e;
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor clone-path copy returned null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first valid range should be accepted and produce empty copy",
                    e);
            }
            throw e;
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor existing-period copy should agree with index copy",
                    e);
            }
            throw e;
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 2000 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i < ords.length - 1; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String label) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: " + label + " null copy");
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: " + label + " itemCount lhs=" + a.getItemCount()
                    + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: " + label + " period[" + i + "] lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null) {
                if (vb != null) {
                    throw new RuntimeException(
                        "metamorphic violation: " + label + " value[" + i + "] lhs=null rhs=" + vb);
                }
            } else if (!va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: " + label + " value[" + i + "] lhs=" + va + " rhs=" + vb);
