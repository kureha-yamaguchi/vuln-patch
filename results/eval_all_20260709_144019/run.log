package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from NormalDistributionTest.testMath280.
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            exercise(anchor, 0.9772498680518209d, true);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }

        // EXPLORE: same root-cause property, but with many real inputs.
        // Build valid distributions and probabilities by construction using the real API:
        // choose a distribution N(mean, sd), choose x = mean + 2*sd, and set p = CDF(x).
        // For the implementation under test this drives inverseCumulativeProbability(p)
        // through the same bracketing path where the upper bracket endpoint can evaluate
        // exactly to a root (f(b) == 0), which is the patched condition.
        double mean = sanitizeFiniteDouble(data.consumeInt(), data.consumeInt());
        double sd = sanitizePositiveFiniteDouble(data.consumeInt(), data.consumeInt());

        try {
            NormalDistribution dist = new NormalDistributionImpl(mean, sd);

            double targetX = mean + 2.0d * sd;
            if (Double.isFinite(targetX)) {
                try {
                    double p = dist.cumulativeProbability(targetX);
                    if (Double.isFinite(p) && p > 0.0d && p < 1.0d) {
                        exercise(dist, p, false);
                    }
                } catch (Throwable t) {
                    if (isRootCause(t)) {
                        throwAsUnchecked(t);
                    }
                }
            }

            // Additional varied, still-valid probabilities from real calls.
            int rounds = 1 + Math.abs(data.consumeInt() % 4);
            for (int i = 0; i < rounds; i++) {
                int k = data.consumeInt(-8, 8);
                double x = mean + ((double) k) * sd;
                if (!Double.isFinite(x)) {
                    continue;
                }
                try {
                    double p = dist.cumulativeProbability(x);
                    if (Double.isFinite(p) && p > 0.0d && p < 1.0d) {
                        exercise(dist, p, false);
                    }
                } catch (Throwable t) {
                    if (isRootCause(t)) {
                        throwAsUnchecked(t);
                    }
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static void exercise(NormalDistribution dist, double p, boolean anchor) throws MathException {
        try {
            double x = dist.inverseCumulativeProbability(p);

            if (anchor) {
                if (!(Math.abs(x - 2.0d) <= 1.0e-12d)) {
                    throw new RuntimeException("metamorphic violation: anchor inverseCumulativeProbability exact regression p="
                            + p + " result=" + x + " expected=2.0");
                }
            }

            // Contract-based metamorphic check:
            // inverseCumulativeProbability is the inverse of cumulativeProbability on probabilities in (0,1).
            // Therefore, for any successful call returning x, cumulativeProbability(x) must recover p
            // (up to normal floating-point tolerance). A patch that merely suppresses the throw or
            // returns an arbitrary value breaks this observable API guarantee.
            try {
                double roundTrip = dist.cumulativeProbability(x);
                if (Double.isFinite(roundTrip) && Double.isFinite(p)) {
                    double tol = Math.max(1.0e-12d, Math.abs(p) * 1.0e-12d);
                    if (Math.abs(roundTrip - p) > tol) {
                        throw new RuntimeException("metamorphic violation: cdf(invcdf(p))≈p p="
                                + p + " x=" + x + " roundTrip=" + roundTrip);
                    }
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException && hasRelevantFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && ("value".equals(method) || "<init>".equals(method) || "buildMessage".equals(method)
                    || "createIllegalArgumentException".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static double sanitizeFiniteDouble(int a, int b) {
        double v = ((double) a) / 16.0d + ((double) (b % 17));
        if (!Double.isFinite(v)) {
            return 0.0d;
        }
        return v;
    }

    private static double sanitizePositiveFiniteDouble(int a, int b) {
        double v = 1.0d + (Math.abs((double) a) % 32.0d) + (Math.abs((double) b) / 1024.0d);
        if (!Double.isFinite(v) || v <= 0.0d) {
            return 1.0d;
        }
        return v;
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
