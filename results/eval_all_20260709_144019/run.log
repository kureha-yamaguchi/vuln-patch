package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            BooleanUtils.toBoolean("off");
        } catch (Throwable t) {
            boolean root = t instanceof StringIndexOutOfBoundsException;
            if (root) {
                StackTraceElement[] st = t.getStackTrace();
                for (int i = 0; i < st.length; i++) {
                    if ("org.apache.commons.lang.BooleanUtils".equals(st[i].getClassName())
                            && "toBoolean".equals(st[i].getMethodName())) {
                        throw (RuntimeException) t;
                    }
                }
            }
        }

        for (int i = 0; i < 6; i++) {
            String candidate;
            int mode = data.consumeInt(0, 5);
            if (mode == 0) {
                candidate = data.consumeAsciiString(8);
            } else if (mode == 1) {
                int len = data.consumeInt(2, 3);
                String s = data.consumeAsciiString(len);
                if (s.length() > len) {
                    s = s.substring(0, len);
                }
                while (s.length() < len) {
                    s = s + "A";
                }
                candidate = s;
            } else if (mode == 2) {
                String[] seeds = new String[] {
                    "off", "oof", "yep", "tru", "yes?", "on", "yes", "true", "false", "no"
                };
                String base = seeds[data.consumeInt(0, seeds.length - 1)];
                StringBuffer sb = new StringBuffer();
                for (int j = 0; j < base.length(); j++) {
                    char c = base.charAt(j);
                    if (Character.isLetter(c) && data.consumeBoolean()) {
                        c = Character.isUpperCase(c) ? Character.toLowerCase(c) : Character.toUpperCase(c);
                    }
                    sb.append(c);
                }
                candidate = sb.toString();
            } else if (mode == 3) {
                String outer = data.consumeAsciiString(12);
                if (outer.length() >= 3) {
                    int start = data.consumeInt(0, outer.length() - 2);
                    int maxLen = Math.min(3, outer.length() - start);
                    int len = data.consumeInt(2, maxLen);
                    candidate = outer.substring(start, start + len);
                } else {
                    candidate = outer;
                }
            } else if (mode == 4) {
                String base = data.consumeAsciiString(3);
                if (base.length() == 0) {
                    candidate = "off";
                } else if (base.length() == 1) {
                    candidate = base + "f";
                } else {
                    candidate = base.substring(0, Math.min(base.length(), 3));
                }
            } else {
                candidate = data.consumeBoolean() ? null : data.consumeString(8);
            }

            try {
                BooleanUtils.toBoolean(candidate);
            } catch (Throwable t) {
                if (t instanceof IllegalArgumentException) {
                    return;
                }
                boolean root = t instanceof StringIndexOutOfBoundsException;
                if (root) {
                    StackTraceElement[] st = t.getStackTrace();
                    for (int j = 0; j < st.length; j++) {
                        if ("org.apache.commons.lang.BooleanUtils".equals(st[j].getClassName())
                                && "toBoolean".equals(st[j].getMethodName())) {
                            throw (RuntimeException) t;
                        }
                    }
                }
                return;
            }
        }

        String[] canonical = new String[] { "true", "false", "on", "off", "yes", "no" };
        String token = canonical[data.consumeInt(0, canonical.length - 1)];
        StringBuffer variantBuilder = new StringBuffer();
        for (int i = 0; i < token.length(); i++) {
            char c = token.charAt(i);
            if (data.consumeBoolean()) {
                c = Character.toUpperCase(c);
            } else {
                c = Character.toLowerCase(c);
            }
            variantBuilder.append(c);
        }
        String variant = variantBuilder.toString();

        try {
            boolean lhs = BooleanUtils.toBoolean(token);
            boolean rhs = BooleanUtils.toBoolean(variant);
            /*
             * Contract asserted: BooleanUtils.toBoolean(String) is case-insensitive for the
             * documented boolean words exercised by the library's own tests ("true"/"false",
             * "on"/"off", "yes"/"no"). A patch that merely avoids the crash by skipping the
             * branch or returning a default value would violate this observable equivalence.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: case-insensitive boolean token parsing input="
                        + variant + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException
                    && !(t instanceof IllegalArgumentException)
                    && !(t instanceof StringIndexOutOfBoundsException)) {
                throw (RuntimeException) t;
            }
        }
    }
}
