package org.apache.commons.math.optimization.fitting;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Arrays;
import org.apache.commons.math.optimization.general.LevenbergMarquardtOptimizer;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int n = data.consumeInt(3, 30);
        double norm = positiveFromInt(data.consumeInt(), 1.0, 200.0);
        double sigma = positiveFromInt(data.consumeInt(), 1.0, 10.0);
        double mean = scaledFromInt(data.consumeInt(), -5.0, n + 5.0);
        boolean reverse = data.consumeBoolean();

        double[] ys = new double[n];
        for (int i = 0; i < n; i++) {
            double x = i;
            double dx = x - mean;
            ys[i] = norm * Math.exp(-(dx * dx) / (2.0 * sigma * sigma));
        }

        // Valid-by-construction input: points come from a real Gaussian with strictly positive sigma.
        // A correct GaussianFitter.fit() must handle these observations without surfacing
        // Gaussian.Parametric's sigma-validation failure.
        double[] fitForward = null;
        double[] fitReverse = null;
        try {
            fitForward = fitYValues(ys, false);
            assertValidGaussianParameters(fitForward, "forward", ys);
        } catch (Throwable t) {
            handleThrowable(t, true);
            return;
        }

        try {
            fitReverse = fitYValues(ys, true);
            assertValidGaussianParameters(fitReverse, "reverse", ys);
        } catch (Throwable t) {
            handleThrowable(t, true);
            return;
        }

        // Metamorphic relation: fitting depends on the set of observed points, not the order
        // in which the same observations were added. Reversing insertion order must therefore
        // produce the same fitted parameters up to small numerical tolerance.
        if (fitForward != null && fitReverse != null) {
            if (!approximatelyEqual(fitForward[0], fitReverse[0], 1e-6, 1e-6) ||
                !approximatelyEqual(fitForward[1], fitReverse[1], 1e-6, 1e-6) ||
                !approximatelyEqual(fitForward[2], fitReverse[2], 1e-6, 1e-6)) {
                throw new RuntimeException(
                    "metamorphic violation: order independence input=" + Arrays.toString(ys) +
                    " lhs=" + Arrays.toString(fitForward) +
                    " rhs=" + Arrays.toString(fitReverse));
            }
        }

        if (reverse) {
            try {
                double[] fitAgain = fitYValues(ys, true);
                assertValidGaussianParameters(fitAgain, "extra-reverse", ys);
            } catch (Throwable t) {
                handleThrowable(t, true);
            }
        }
    }

    private static void runAnchor() {
        double[] data = new double[] {
            1.1143831578403364E-29,
            4.95281403484594E-28,
            1.1171347211930288E-26,
            1.7044813962636277E-25,
            1.9784716574832164E-24,
            1.8630236407866774E-23,
            1.4820532905097742E-22,
            1.0241963854632831E-21,
            6.275077366673128E-21,
            3.461808994532493E-20,
            1.7407124684715706E-19,
            8.056687953553974E-19,
            3.460193945992071E-18,
            1.3883326374011525E-17,
            5.233894983671116E-17,
            1.8630791465263745E-16,
            6.288759227922111E-16,
            2.0204433920597856E-15,
            6.198768938576155E-15,
            1.821419346860626E-14,
            5.139176445538471E-14,
            1.3956427429045787E-13,
            3.655705706448139E-13,
            9.253753324779779E-13,
            2.267636001476696E-12,
            5.3880460095836855E-12,
            1.2431632654852931E-11
        };

        try {
            double[] p = fitYValues(data, false);
            // Post-condition: Gaussian sigma is a standard deviation, so a successful fit must
            // return finite parameters with sigma > 0. A throw-deleting or bookkeeping-breaking
            // patch could return NaN/invalid parameters instead of a usable fit.
            assertValidGaussianParameters(p, "anchor", data);
        } catch (Throwable t) {
            handleThrowable(t, true);
        }
    }

    private static double[] fitYValues(double[] y, boolean reverseOrder) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        if (!reverseOrder) {
            for (int i = 0; i < y.length; i++) {
                fitter.addObservedPoint(i, y[i]);
            }
        } else {
            for (int i = y.length - 1; i >= 0; i--) {
                fitter.addObservedPoint(i, y[i]);
            }
        }
        return fitter.fit();
    }

    private static void assertValidGaussianParameters(double[] p, String label, double[] input) {
        if (p == null || p.length != 3) {
            throw new RuntimeException("metamorphic violation: invalid parameter shape label=" + label +
                                       " input=" + Arrays.toString(input) +
                                       " params=" + Arrays.toString(p));
        }
        for (int i = 0; i < p.length; i++) {
            if (Double.isNaN(p[i]) || Double.isInfinite(p[i])) {
                throw new RuntimeException("metamorphic violation: non-finite parameter label=" + label +
                                           " input=" + Arrays.toString(input) +
                                           " params=" + Arrays.toString(p));
            }
        }
        if (!(p[2] > 0.0)) {
            throw new RuntimeException("metamorphic violation: non-positive sigma label=" + label +
                                       " input=" + Arrays.toString(input) +
                                       " params=" + Arrays.toString(p));
        }
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (t instanceof RuntimeException && t.getMessage() != null &&
            t.getMessage().startsWith("metamorphic violation:")) {
            throw (RuntimeException) t;
        }

        if (validByConstruction && isRootCause(t)) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            throw new RuntimeException(t);
        }

        if (isCleanRejection(t)) {
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (t == null) {
            return false;
        }
        String name = t.getClass().getName();
        if (!name.equals("org.apache.commons.math.exception.NotStrictlyPositiveException")) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if (("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls) && "fit".equals(method)) ||
                ("org.apache.commons.math.analysis.function.Gaussian$Parametric".equals(cls) && "validateParameters".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        Package p = t.getClass().getPackage();
        if (p != null) {
            String pkg = p.getName();
            if ("org.apache.commons.math.exception".equals(pkg) ||
                pkg.startsWith("org.apache.commons.math.exception.")) {
                return true;
            }
        }
        String n = t.getClass().getName();
        return n.startsWith("org.apache.commons.math.exception.");
    }

    private static boolean approximatelyEqual(double a, double b, double relTol, double absTol) {
        if (Double.isNaN(a) || Double.isNaN(b) || Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double diff = Math.abs(a - b);
        if (diff <= absTol) {
            return true;
        }
        double scale = Math.max(Math.abs(a), Math.abs(b));
        return diff <= relTol * Math.max(1.0, scale);
    }

    private static double positiveFromInt(int v, double min, double max) {
        long u = v & 0x7fffffffL;
        double f = (u % 1000000L) / 999999.0;
        return min + (max - min) * f;
    }

    private static double scaledFromInt(int v, double min, double max) {
        long u = v & 0x7fffffffL;
        double f = (u % 1000000L) / 999999.0;
        return min + (max - min) * f;
    }
}
