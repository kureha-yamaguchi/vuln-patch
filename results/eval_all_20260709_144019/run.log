            if (isGroundTruthRootCause(t)) {
                sneakyThrow(t);
                return;
            }
        }

        // EXPLORE: the buggy branch in bracket is triggered when the lower endpoint
        // already has a non-negative function value after the first expansion, which
        // happens for standard normal inverse-CDF requests whose true quantile is
        // exactly at a small integer boundary such as x = 2.0. Generate probabilities
        // from known quantiles so inputs are valid-by-construction and flow through the
        // real NormalDistribution public API.
        int mode = data.consumeInt(0, 5);
        double q;
        switch (mode) {
            case 0:
                q = 2.0;
                break;
            case 1:
                q = 2.0 + data.consumeInt(-8, 8) * Math.pow(2.0, -20);
                break;
            case 2:
                q = 1.0 + data.consumeInt(-1024, 1024) / 1024.0;
                break;
            case 3:
                q = -1.0 + data.consumeInt(-1024, 1024) / 1024.0;
                break;
            case 4:
                q = data.consumeInt(-6, 6);
                break;
            default:
                q = data.consumeInt(-6, 6) + data.consumeInt(-1000000, 1000000) / 1000000.0;
                break;
        }

        // Construct a valid probability via the real CDF, so a correct implementation
        // is obliged to accept it: 0 < p < 1 for finite q under a standard normal.
        double p;
        try {
            p = normal.cumulativeProbability(q);
        } catch (Throwable t) {
            return;
        }

        if (!(p > 0.0 && p < 1.0) || Double.isNaN(p) || Double.isInfinite(p)) {
            return;
        }

        // Contract/metamorphic check:
        // For a correct inverse cumulative distribution implementation,
        // cumulativeProbability(inverseCumulativeProbability(p)) == p
        // for valid probabilities p in (0, 1), modulo numerical tolerance.
        // A patch that merely suppresses the throw or returns an arbitrary value would
        // violate this observable API-level round-trip relation.
        double x;
        try {
            x = normal.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthRootCause(t)) {
                sneakyThrow(t);
                return;
            }
            return;
        }

        double roundTrip;
        try {
            roundTrip = normal.cumulativeProbability(x);
        } catch (Throwable t) {
            return;
        }

        double tol = 1.0e-12 + 1.0e-10 * Math.abs(p);
        if (Double.isNaN(x) || Double.isInfinite(x) || Double.isNaN(roundTrip) || Math.abs(roundTrip - p) > tol) {
            throw new RuntimeException(
                "metamorphic violation: normal cdf/icdf round-trip inputP=" + p +
                " quantileSeed=" + q +
                " x=" + x +
                " roundTrip=" + roundTrip +
                " tol=" + tol);
        }

        // Additional equivalent-input relation for the standard normal:
        // icdf(p) == -icdf(1-p). Both sides use the real library.
        double x2;
        try {
            x2 = normal.inverseCumulativeProbability(1.0 - p);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isGroundTruthRootCause(t)) {
                sneakyThrow(t);
                return;
            }
            return;
        }

        double tol2 = 1.0e-12 + 1.0e-10 * Math.max(Math.abs(x), Math.abs(x2));
        if (Double.isNaN(x2) || Double.isInfinite(x2) || Math.abs(x + x2) > tol2) {
            throw new RuntimeException(
                "metamorphic violation: standard normal symmetry inputP=" + p +
                " lhs=" + x +
                " rhs=" + x2 +
                " sum=" + (x + x2) +
                " tol=" + tol2);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isGroundTruthRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        return hasRelevantFrame(t);
    }

    private static boolean hasRelevantFrame(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            StackTraceElement[] stack = cur.getStackTrace();
            if (stack != null) {
                for (int i = 0; i < stack.length; i++) {
                    StackTraceElement e = stack[i];
                    String cls = e.getClassName();
                    String m = e.getMethodName();
