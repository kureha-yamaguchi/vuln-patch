        String sepString = String.valueOf(sepChar);

        try {
            String lhs = StringUtils.join(array, sepChar, startIndex, endIndex);
            String rhs = StringUtils.join(array, sepString, startIndex, endIndex);

            /* Contract-based metamorphic check:
             * The two public overloads shown in StringUtils.join iterate over the same range,
             * insert the separator between items under the same condition, and append the same
             * non-null elements. Therefore for any correct implementation, using separator c
             * must produce exactly the same result as using String.valueOf(c), including when
             * elements are null and when the selected slice is empty. A throw-deleting or
             * branch-skipping patch can violate this observable equality without crashing.
             */
            if (lhs != null ? !lhs.equals(rhs) : rhs != null) {
                throw new RuntimeException(
                    "metamorphic violation: char-vs-string separator inputLen=" + len +
                    " start=" + startIndex +
                    " end=" + endIndex +
                    " sepChar=" + (int) sepChar +
                    " lhs=" + lhs +
                    " rhs=" + rhs
                );
            }
        } catch (RuntimeException t) {
