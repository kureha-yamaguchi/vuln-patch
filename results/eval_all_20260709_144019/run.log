        String fuzzAny = data.consumeString(16);
        String fuzzTail = data.consumeRemainingAsString();

        String[] observed = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru", "no", "NO", "No", "nO"
        };

