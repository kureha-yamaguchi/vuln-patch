            boolean first = plot.removeRangeMarker(marker);
            boolean second = plot.removeRangeMarker(marker);

            /* Contract exercised through the public API:
             * removing a marker immediately after adding it must succeed exactly once.
             */
            if (!first || second) {
                throw new RuntimeException(
                    "metamorphic violation: XYPlot range remove-after-add input="
                        + value + " first=" + first + " second=" + second);
            }
