    private static String decimalDigitsOnly(String in, boolean allowSign) {
        StringBuffer sb = new StringBuffer();
        if (in == null) {
            return "";
        }
        for (int i = 0; i < in.length(); i++) {
            char c = in.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else if (allowSign && sb.length() == 0 && (c == '-' || c == '+')) {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String hexDigitsOnly(String in) {
        StringBuffer sb = new StringBuffer();
        if (in == null) {
            return "0";
        }
        for (int i = 0; i < in.length(); i++) {
            char c = in.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            return "0";
        }
        return sb.toString();
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + n.toString();
    }
