public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkAnchorBehavior();

        ClassLoader loader = Thread.currentThread().getContextClassLoader();
        if (loader == null) {
            loader = ClassUtils.class.getClassLoader();
        }

        try {
            Class<?> a = ClassUtils.getClass(loader, "java.lang.String", false);
            Class<?> b = ClassUtils.getClass("java.lang.String", false);
            if (a != b) {
                throw new RuntimeException("metamorphic violation: getClass overload equivalence input=java.lang.String lhs=" + a + " rhs=" + b);
            }
        } catch (ClassNotFoundException e) {
            return;
        } catch (LinkageError e) {
            return;
        } catch (SecurityException e) {
            return;
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        String fuzzClassName = data.consumeAsciiString(64);
        if (fuzzClassName.length() != 0) {
            try {
                Class<?> viaLoader = ClassUtils.getClass(loader, fuzzClassName, data.consumeBoolean());
                Class<?> viaDefault = ClassUtils.getClass(fuzzClassName, false);
                if (viaLoader != null && viaDefault != null && !fuzzClassName.equals("java.lang.String") && viaLoader != viaDefault) {
                    throw new RuntimeException("metamorphic violation: getClass overloads disagree input=" + fuzzClassName + " lhs=" + viaLoader + " rhs=" + viaDefault);
                }
            } catch (ClassNotFoundException e) {
            } catch (LinkageError e) {
            } catch (SecurityException e) {
            } catch (IllegalArgumentException e) {
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }

        exerciseToClass(data, loader);
    }

    private static void checkAnchorBehavior() {
        Class<?>[] nullResult = ClassUtils.toClass(null);
        if (nullResult != null) {
            throw new RuntimeException("metamorphic violation: toClass(null) should return null lhs=" + Arrays.toString(nullResult));
        }

        Class<?>[] emptyResult = ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        if (emptyResult != ArrayUtils.EMPTY_CLASS_ARRAY) {
            throw new RuntimeException("metamorphic violation: toClass(empty) should return EMPTY_CLASS_ARRAY lhs=" + Arrays.toString(emptyResult));
        }

        Class<?>[] normalResult = ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        Class<?>[] expectedNormal = new Class<?>[] { String.class, Integer.class, Double.class };
        if (!Arrays.equals(normalResult, expectedNormal)) {
            throw new RuntimeException("metamorphic violation: anchor non-null mapping input=[Test,1,99d] lhs=" + Arrays.toString(normalResult) + " rhs=" + Arrays.toString(expectedNormal));
        }

        Object[] documentedValid = new Object[] { "Test", null, Double.valueOf(99d) };
        try {
            Class<?>[] result = ClassUtils.toClass(documentedValid);
            Class<?>[] expected = new Class<?>[] { String.class, null, Double.class };
            if (!Arrays.equals(result, expected)) {
                throw new RuntimeException("metamorphic violation: documented null-element mapping input=" + Arrays.toString(documentedValid) + " lhs=" + Arrays.toString(result) + " rhs=" + Arrays.toString(expected));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: documented null-element input must not crash input=" + Arrays.toString(documentedValid), e);
            }
            throw e;
        }
    }

    private static void exerciseToClass(FuzzedDataProvider data, ClassLoader loader) {
        int len = data.consumeInt(1, 24);
        Object[] array = new Object[len];
        int forcedNullIndex = data.consumeInt(0, len - 1);

        for (int i = 0; i < len; i++) {
            if (i == forcedNullIndex || data.consumeBoolean()) {
                array[i] = null;
                continue;
            }
            switch (data.consumeInt(0, 8)) {
                case 0:
                    array[i] = data.consumeString(32);
                    break;
                case 1:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 2:
                    array[i] = Long.valueOf(data.consumeInt());
                    break;
                case 3:
                    array[i] = Double.valueOf(data.consumeInt());
                    break;
                case 4:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 5:
                    array[i] = Byte.valueOf(data.consumeByte());
                    break;
                case 6:
                    array[i] = data.consumeBytes(data.consumeInt(0, Math.min(16, data.remainingBytes())));
                    break;
                case 7:
                    array[i] = new Object[] { data.consumeString(8), data.consumeBoolean() ? null : Integer.valueOf(data.consumeInt()) };
                    break;
                default:
                    array[i] = data.consumeAsciiString(16);
                    break;
            }
        }

        for (Object o : array) {
            if (o != null) {
                try {
                    String binaryName = o.getClass().getName();
                    Class<?> c1 = ClassUtils.getClass(loader, binaryName, false);
                    Class<?> c2 = ClassUtils.getClass(binaryName, false);
                    if (c1 != c2) {
                        throw new RuntimeException("metamorphic violation: getClass resolved differently for same binary name input=" + binaryName + " lhs=" + c1 + " rhs=" + c2);
                    }
                } catch (ClassNotFoundException e) {
                    return;
                } catch (LinkageError e) {
                    return;
                } catch (SecurityException e) {
                    return;
                } catch (IllegalArgumentException e) {
                    return;
                } catch (RuntimeException e) {
                    if (isRootCause(e)) {
                        throw e;
                    }
                    return;
                }
            }
        }

        try {
            Class<?>[] classes = ClassUtils.toClass(array);

            if (classes == null || classes.length != array.length) {
                throw new RuntimeException("metamorphic violation: toClass result shape input=" + Arrays.toString(array) + " lhs=" + Arrays.toString(classes));
            }

            for (int i = 0; i < array.length; i++) {
                Class<?> expected = array[i] == null ? null : array[i].getClass();
                if (classes[i] != expected) {
                    throw new RuntimeException("metamorphic violation: element-wise class mapping input=" + Arrays.toString(array) + " index=" + i + " lhs=" + classes[i] + " rhs=" + expected);
                }
            }

            Object[] cloned = ArrayUtils.clone(array);
            try {
                Class<?>[] clonedClasses = ClassUtils.toClass(cloned);
                if (!Arrays.equals(classes, clonedClasses)) {
                    throw new RuntimeException("metamorphic violation: toClass(array) == toClass(clone(array)) input=" + Arrays.toString(array) + " lhs=" + Arrays.toString(classes) + " rhs=" + Arrays.toString(clonedClasses));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("metamorphic violation: clone(array) preserves elements so toClass(clone(array)) must also succeed input=" + Arrays.toString(array), e);
                }
                return;
            }

            int split = data.consumeInt(0, array.length);
            Object[] left = ArrayUtils.subarray(array, 0, split);
            Object[] right = ArrayUtils.subarray(array, split, array.length);
            try {
                Class<?>[] whole = ClassUtils.toClass(ArrayUtils.addAll(left, right));
                Class<?>[] parts = ArrayUtils.addAll(ClassUtils.toClass(left), ClassUtils.toClass(right));
                if (!Arrays.equals(whole, parts)) {
                    throw new RuntimeException("metamorphic violation: composition input=" + Arrays.toString(array) + " split=" + split + " lhs=" + Arrays.toString(whole) + " rhs=" + Arrays.toString(parts));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("metamorphic violation: composition over concatenation should succeed for valid null-containing arrays input=" + Arrays.toString(array) + " split=" + split, e);
                }
                return;
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: documented contract says null elements map to null classes input=" + Arrays.toString(array), e);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.ClassUtils".equals(ste.getClassName())
                    && ("toClass".equals(ste.getMethodName()) || "getClass".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
