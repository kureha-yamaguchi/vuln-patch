package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("", "foo", false, 1, '-', 1);

        int cases = 1 + data.consumeInt(0, 3);
        for (int i = 0; i < cases; i++) {
            String prefix = data.consumeAsciiString(data.consumeInt(0, 16));
            int width = data.consumeInt(1, 16);
            int extra = data.consumeInt(1, 16);
            int objLen = width + extra;
            String objText = data.consumeString(objLen);
            if (objText.length() < objLen) {
                StringBuilder sb = new StringBuilder(objText);
                while (sb.length() < objLen) {
                    sb.append('X');
                }
                objText = sb.toString();
            } else if (objText.length() > objLen) {
                objText = objText.substring(0, objLen);
            }
            boolean useStrBuilderObject = data.consumeBoolean();
            char pad = (char) (data.consumeByte() & 0xff);
            int initialCapacity = prefix.length() + width;
            if (initialCapacity < 0) {
                initialCapacity = 0;
            }
            runCase(prefix, objText, useStrBuilderObject, width, pad, initialCapacity);
        }
    }

    private static void runCase(String prefix, String objText, boolean useStrBuilderObject, int width, char pad, int initialCapacity) {
        Object obj = objText;
        if (useStrBuilderObject) {
            StrBuilder objBuilder = new StrBuilder(objText.length());
            objBuilder.append(objText);
            obj = objBuilder;
        }

        StrBuilder target = new StrBuilder(initialCapacity);
        target.append(prefix);
        int beforeLen = target.length();

        try {
            target.appendFixedWidthPadRight(obj, width, pad);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        String objAsString = String.valueOf(obj);
        String actual = target.toString();

        if (target.length() != beforeLen + width) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight must increase length by width"
                    + " inputPrefix=" + prefix
                    + " obj=" + objAsString
                    + " width=" + width
                    + " pad=" + (int) pad
                    + " beforeLen=" + beforeLen
                    + " afterLen=" + target.length());
        }

        String expectedSuffix;
        if (objAsString.length() >= width) {
            expectedSuffix = objAsString.substring(0, width);
        } else {
            StringBuilder sb = new StringBuilder(width);
            sb.append(objAsString);
            while (sb.length() < width) {
                sb.append(pad);
            }
            expectedSuffix = sb.toString();
        }

        String expected = prefix + expectedSuffix;

        /*
         * Contract asserted: appendFixedWidthPadRight appends exactly a fixed-width rendering
         * of obj to the existing content: if obj is longer than width, only the first width
         * characters are appended; otherwise obj is appended and padded on the right.
         * The failing test demonstrates this with "foo", width 1 -> "f".
         * A throw-deleting or branch-skipping patch could avoid crashing but silently append
         * the wrong characters or wrong amount, which this observable post-condition detects.
         */
        if (!expected.equals(actual)) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight output mismatch"
                    + " inputPrefix=" + prefix
                    + " obj=" + objAsString
                    + " width=" + width
                    + " pad=" + (int) pad
                    + " expected=" + expected
                    + " actual=" + actual);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
