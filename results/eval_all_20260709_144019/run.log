package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeString(32);
        String source = data.consumeString(64);
        char padChar = (char) (data.consumeByte() & 0xFF);

        if (source == null) {
            source = "";
        }

        int sourceLen = source.length();
        if (sourceLen > 0) {
            int width = data.consumeInt(1, sourceLen);
            int capacityMin = prefix.length() + width;
            int capacityMax = prefix.length() + sourceLen - 1;
            if (capacityMin <= capacityMax) {
                int initialCapacity = data.consumeInt(capacityMin, capacityMax);
                runCase(false, initialCapacity, prefix, source, width, padChar);
            }
        }

        String nullText = data.consumeString(64);
        if (nullText == null) {
            nullText = "";
        }
        int nullLen = nullText.length();
        if (nullLen > 0) {
            int width = data.consumeInt(1, nullLen);
            int capacityMin = prefix.length() + width;
            int capacityMax = prefix.length() + nullLen - 1;
            if (capacityMin <= capacityMax) {
                int initialCapacity = data.consumeInt(capacityMin, capacityMax);
                runCase(true, initialCapacity, prefix, nullText, width, padChar);
            }
        }

        if (data.consumeBoolean()) {
            String extraPrefix = data.consumeRemainingAsString();
            if (extraPrefix == null) {
                extraPrefix = "";
            }
            String combinedPrefix = prefix + extraPrefix;
            if (sourceLen > 0) {
                int width = data.consumeInt(1, sourceLen);
                int capacityMin = combinedPrefix.length() + width;
                int capacityMax = combinedPrefix.length() + sourceLen - 1;
                if (capacityMin <= capacityMax) {
                    int initialCapacity = capacityMin;
                    runCase(false, initialCapacity, combinedPrefix, source, width, padChar);
                }
            }
        }
    }

    private static void runAnchor() {
        runCase(false, 1, "", "foo", 1, '-');
    }

    private static void runCase(boolean useNullObject, int initialCapacity, String prefix, String source, int width, char padChar) {
        if (initialCapacity < 0 || width <= 0 || source == null) {
            return;
        }

        StrBuilder sb;
        StrBuilder oracle;
        try {
            sb = new StrBuilder(initialCapacity);
            oracle = new StrBuilder(initialCapacity + 8);
        } catch (RuntimeException t) {
            return;
        }

        try {
            if (useNullObject) {
                sb.setNullText(source);
            }
            sb.append(prefix);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isMetamorphicViolation(t)) {
                throw t;
            }
            return;
        }

        try {
            oracle.append(prefix);
            appendExpected(oracle, source, width, padChar);
        } catch (RuntimeException t) {
            return;
        }

        try {
            if (useNullObject) {
                sb.appendFixedWidthPadRight(null, width, padChar);
            } else {
                sb.appendFixedWidthPadRight(source, width, padChar);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight should accept this valid input"
                        + " useNullObject=" + useNullObject
                        + " initialCapacity=" + initialCapacity
                        + " prefix=" + quote(prefix)
                        + " source=" + quote(source)
                        + " width=" + width
                        + " pad=" + (int) padChar,
                    t);
            }
            if (isMetamorphicViolation(t)) {
                throw t;
            }
            return;
        }

        String out;
        String oracleOut;
        try {
            out = sb.toString();
            oracleOut = oracle.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (sb.length() != prefix.length() + width) {
            throw new RuntimeException(
                "metamorphic violation: length must grow by exactly width"
                    + " useNullObject=" + useNullObject
                    + " initialCapacity=" + initialCapacity
                    + " prefix=" + quote(prefix)
                    + " source=" + quote(source)
                    + " width=" + width
                    + " actualLength=" + sb.length()
                    + " output=" + quote(out));
        }

        /*
         * Contract visible in the method body: appendFixedWidthPadRight appends exactly width
         * characters, taking the leftmost width chars when the source is long enough, otherwise
         * appending the source and then pad chars. A throw-deleting or branch-skipping patch can
         * avoid the original exception yet still produce the wrong appended content, so we compare
         * against a second StrBuilder built only from real library operations.
         */
        if (!oracleOut.equals(out)) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight output mismatch"
                    + " useNullObject=" + useNullObject
                    + " initialCapacity=" + initialCapacity
                    + " prefix=" + quote(prefix)
                    + " source=" + quote(source)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " lhs=" + quote(out)
                    + " rhs=" + quote(oracleOut));
        }
    }

    private static void appendExpected(StrBuilder oracle, String source, int width, char padChar) {
        if (width <= 0) {
            return;
        }
        if (source.length() >= width) {
            oracle.append(source.substring(0, width));
        } else {
            oracle.append(source);
            int padLen = width - source.length();
            for (int i = 0; i < padLen; i++) {
                oracle.append(padChar);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if (!"org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                continue;
            }
            String m = e.getMethodName();
            if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
