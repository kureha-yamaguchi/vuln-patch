            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static BigMatrixImpl identityBig(int n) {
        BigDecimal[][] d = new BigDecimal[n][n];
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {
                d[r][c] = (r == c) ? BigDecimal.ONE : BigDecimal.ZERO;
            }
        }
        return new BigMatrixImpl(d, false);
    }

    private static RealMatrixImpl identityReal(int n) {
        double[][] d = new double[n][n];
        for (int r = 0; r < n; r++) {
            d[r][r] = 1.0;
        }
        return new RealMatrixImpl(d, false);
    }

    private static boolean equalBigDecimalArrays(BigDecimal[] a, BigDecimal[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (a[i] == null || b[i] == null) {
                if (a[i] != b[i]) {
                    return false;
                }
            } else if (a[i].compareTo(b[i]) != 0) {
                return false;
            }
        }
        return true;
    }

    private static boolean equalDoubleArrays(double[] a, double[] b) {
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (Double.doubleToLongBits(a[i]) != Double.doubleToLongBits(b[i])) {
                return false;
            }
        }
        return true;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if (("org.apache.commons.math.linear.BigMatrixImpl".equals(cls)
                    || "org.apache.commons.math.linear.RealMatrixImpl".equals(cls))
                    && ("operate".equals(method)
                        || "multiply".equals(method)
                        || "getRowDimension".equals(method)
                        || "getColumnDimension".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
