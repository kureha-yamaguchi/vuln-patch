package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class Helper {
            boolean isValidation(Throwable t) {
                return t instanceof IllegalArgumentException
                        || t instanceof NumberFormatException;
            }

            boolean hasRelevantFrame(Throwable t) {
                StackTraceElement[] frames = t.getStackTrace();
                for (int i = 0; i < frames.length; i++) {
                    String cls = frames[i].getClassName();
                    String m = frames[i].getMethodName();
                    if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                            && ("appendFixedWidthPadRight".equals(m)
                            || "ensureCapacity".equals(m)
                            || "getNullText".equals(m))) {
                        return true;
                    }
                }
                return false;
            }

            boolean isRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantFrame(t);
            }

            void checkTruncationRelation(int initialCapacity, String source, int width, char padChar, boolean useNullTextPath) {
                if (width <= 0 || source == null || source.length() < width) {
                    return;
                }

                StrBuilder expected = new StrBuilder(initialCapacity);
                try {
                    if (useNullTextPath) {
                        expected.setNullText(source);
                    }
                    /*
                     * Contract asserted:
                     * when the source text is at least `width` characters long,
                     * appendFixedWidthPadRight(obj, width, pad) must append exactly the first
                     * `width` characters of the source and increase length by exactly `width`.
                     * A throw-deleting/branch-skipping patch would violate this observable result.
                     */
                    expected.append(source.substring(0, width));
                } catch (Throwable t) {
                    return;
                }

                StrBuilder actual = new StrBuilder(initialCapacity);
                try {
                    if (useNullTextPath) {
                        actual.setNullText(source);
                        actual.appendFixedWidthPadRight(null, width, padChar);
                    } else {
                        actual.appendFixedWidthPadRight(source, width, padChar);
                    }
                } catch (Throwable t) {
                    if (isValidation(t)) {
                        return;
                    }
                    if (isRootCause(t)) {
                        throw new RuntimeException(
                                "metamorphic violation: truncation relation threw on valid input"
                                        + " initialCapacity=" + initialCapacity
                                        + " width=" + width
                                        + " pad=" + (int) padChar
                                        + " useNullTextPath=" + useNullTextPath
                                        + " source=" + source,
                                t);
                    }
                    return;
                }

                try {
                    String lhs = actual.toString();
                    String rhs = expected.toString();
                    if (!lhs.equals(rhs) || actual.length() != width) {
                        throw new RuntimeException(
                                "metamorphic violation: truncation relation"
                                        + " initialCapacity=" + initialCapacity
                                        + " width=" + width
                                        + " pad=" + (int) padChar
                                        + " useNullTextPath=" + useNullTextPath
                                        + " source=" + source
                                        + " lhs=" + lhs
                                        + " rhs=" + rhs
                                        + " lhsLen=" + actual.length());
                    }
                } catch (RuntimeException e) {
                    throw e;
                } catch (Throwable t) {
                    return;
                }
            }
        }

        Helper h = new Helper();

        h.checkTruncationRelation(1, "foo", 1, '-', false);

        int initialCapacity = data.consumeInt(0, 8);
        int width = data.consumeInt(1, 8);
        char padChar = (char) (data.consumeByte() & 0xff);

        String source = data.consumeAsciiString(32);
        if (source.length() < width + 1) {
            String extra = data.consumeAsciiString(32);
            StringBuilder sb = new StringBuilder(source);
            while (sb.length() < width + 1) {
                if (extra.length() > 0) {
                    sb.append(extra);
                } else {
                    sb.append('X');
                }
            }
            source = sb.toString();
        }

        h.checkTruncationRelation(initialCapacity, source, width, padChar, false);

        String nullText = data.consumeString(32);
        if (nullText == null) {
            nullText = "";
        }
        if (nullText.length() < width + 1) {
            StringBuilder sb = new StringBuilder(nullText);
            while (sb.length() < width + 1) {
                sb.append('N');
            }
            nullText = sb.toString();
        }

        h.checkTruncationRelation(initialCapacity, nullText, width, padChar, true);
    }
}
