package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact trigger from the regression test.
        runCase(f, 3.0, 3.2, 3.1);

        // EXPLORE: same root-cause property with many real inputs.
        // Property: call the 4-arg public API on a fresh BisectionSolver with a non-null function
        // and a valid interval [min, max] that brackets a real SinFunction root.
        int cases = 1 + (data.consumeInt(0, 4));
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-50, 50);
            double root = k * Math.PI;

            double left = ((data.consumeInt() & 0x7fffffff) % 100000 + 1) / 100000.0;
            double right = ((data.consumeInt() & 0x7fffffff) % 100000 + 1) / 100000.0;

            double min = root - left;
            double max = root + right;
            if (!(min < max)) {
                continue;
            }

            int selector = data.consumeInt(0, 4);
            double initial;
            switch (selector) {
                case 0:
                    initial = root;
                    break;
                case 1:
                    initial = min;
                    break;
                case 2:
                    initial = max;
                    break;
                case 3:
                    initial = min + (max - min) * (((data.consumeInt() & 0x7fffffff) % 1000) / 1000.0);
                    break;
                default:
                    initial = (min + max) / 2.0;
                    break;
            }

            runCase(f, min, max, initial);
        }
    }

    private static void runCase(UnivariateRealFunction f, double min, double max, double initial) {
        double result;
        UnivariateRealSolver solver = new BisectionSolver();

        try {
            result = solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isOwnViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        // Post-condition from the solver contract:
        // for a valid bracketing interval containing a root, a correct solver must return
        // an approximation to a root in the interval. A "fix" that merely dodges the buggy
        // path or returns an arbitrary value would violate this observable API guarantee.
        double tol = Math.max(1.0e-6, solver.getAbsoluteAccuracy() * 4.0);
        if (Double.isNaN(result) || Double.isInfinite(result) || result < min || result > max
                || Math.abs(Math.sin(result)) > 1.0e-6) {
            throw new RuntimeException(
                    "metamorphic violation: root-in-bracket contract input=min=" + min
                            + " max=" + max + " initial=" + initial + " result=" + result);
        }

        // Metamorphic relation using only real library calls:
        // on the same valid bracket and function, the 4-arg API should agree with the 3-arg API
        // up to solver accuracy. The failing patch changed the delegation target, so this directly
        // checks that the overloaded entry point preserves the same solving behavior.
        try {
            double rhs = new BisectionSolver().solve(f, min, max);
            if (!Double.isNaN(rhs) && !Double.isInfinite(rhs) && Math.abs(result - rhs) > tol) {
                throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial) vs solve(f,min,max) input=min="
                                + min + " max=" + max + " initial=" + initial
                                + " lhs=" + result + " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (isOwnViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            // If either side throws, the relation does not apply for this input.
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || hasStackFrame(t, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverImpl", "verifyInterval")
                || hasStackFrame(t, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverImpl", "verifyBracketing")
                || hasStackFrame(t, "org.apache.commons.math.analysis.solvers.UnivariateRealSolverImpl", "verifySequence")
                || hasStackFrame(t, "org.apache.commons.math.analysis.solvers.BisectionSolver", "solve");
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof NullPointerException
                && hasStackFrame(t, "org.apache.commons.math.analysis.solvers.BisectionSolver", "solve");
    }

    private static boolean isOwnViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean hasStackFrame(Throwable t, String className, String methodName) {
        for (StackTraceElement e : t.getStackTrace()) {
            if (className.equals(e.getClassName()) && methodName.equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
