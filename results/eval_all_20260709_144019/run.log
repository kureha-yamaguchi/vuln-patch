            }
            return;
        }

        String out;
        try {
            out = sb.toString();
        } catch (RuntimeException t) {
            return;
        }

        if (sb.length() != oldLen + width) {
            throw new RuntimeException(
                "metamorphic violation: length must grow by width"
                    + " oldLen=" + oldLen
                    + " width=" + width
                    + " newLen=" + sb.length()
                    + " output=" + quote(out));
        }

        /*
         * Contract exercised by the failing test and by the method body:
         * appendFixedWidthPadRight appends exactly width visible characters:
         * - if source is longer than width, the appended region is the leftmost width chars
         * - otherwise source followed by pad chars.
         * A throw-deleting or branch-skipping patch can avoid the crash yet silently produce
         * the wrong appended content; comparing against a second real StrBuilder call detects that.
         */
        if (!oracleOut.equals(out)) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight output mismatch"
                    + " prefix=" + quote(prefix)
                    + " source=" + quote(source)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " lhs=" + quote(out)
                    + " rhs=" + quote(oracleOut));
        }
    }

    private static String expectedSegment(String source, int width, char padChar) {
        String s = source == null ? "" : source;
        if (s.length() >= width) {
            return s.substring(0, width);
        }
        StrBuilder tmp = new StrBuilder(width);
        tmp.append(s);
        for (int i = s.length(); i < width; i++) {
            tmp.append(padChar);
        }
        return tmp.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                && ("appendFixedWidthPadRight".equals(m)
                    || "ensureCapacity".equals(m)
                    || "getNullText".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r");
    }
}
