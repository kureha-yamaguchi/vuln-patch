        int[] leapYears = new int[] { 1996, 2000, 2004, 2008, 2012, 2016, 2020, 2024, 2028, 2032 };
        int[] nonLeapYears = new int[] { 1999, 2001, 2002, 2003, 2005, 2006, 2010, 2014, 2018, 2019 };

