package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact input from the failing test
        BooleanUtils.toBoolean("off");

        // EXPLORE: Generate many varied inputs that hit the length-3 path.
        // Property: length == 3 and not equalIgnoreCase("yes")
        int loopsTargeted = data.consumeInt(0, 64);
        for (int i = 0; i < loopsTargeted; i++) {
            // Target crashers: start with 't' or 'T' to force the buggy case-4 evaluation on 3-char inputs.
            char c0 = data.consumeBoolean() ? 't' : 'T';
            char c1;
            char c2;
            int mode = data.consumeInt(0, 3);
            if (mode == 0) {
                c1 = 'r';
                c2 = 'u';
            } else if (mode == 1) {
                c1 = data.consumeBoolean() ? 'r' : 'R';
                c2 = data.consumeBoolean() ? 'u' : 'U';
            } else if (mode == 2) {
                c1 = (char) ('A' + data.consumeInt(0, 25));
                c2 = (char) ('a' + data.consumeInt(0, 25));
            } else {
                c1 = (char) ('a' + data.consumeInt(0, 25));
