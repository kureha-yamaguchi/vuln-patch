        MutableDateTime nyStartOfYear = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York"));
        formatter.parseInto(nyStartOfYear, "2 29", 0);

        // Test case 2: Tokyo, end of year
        MutableDateTime tokyoEndOfYear = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo"));
        formatter.parseInto(tokyoEndOfYear, "2 29", 0);

        // Explore: generate varied real inputs that exercise default-year usage.
        String[] ZONES = new String[] {
            "UTC",
            "America/New_York",
            "Europe/London",
            "Asia/Tokyo",
            "Pacific/Kiritimati",
            "Pacific/Pago_Pago",
            "Asia/Kathmandu",
            "Australia/Lord_Howe",
            "Asia/Tehran",
            "Pacific/Chatham",
            "America/Los_Angeles",
            "Europe/Berlin",
            "Africa/Cairo",
            "Asia/Shanghai",
            "Indian/Mauritius",
            "Atlantic/Azores"
        };
        int[] LEAP_YEARS = new int[] { 1996, 2000, 2004, 2008, 2012, 2016, 2020, 2024 };

        int iterations = 1;
        if (data.remainingBytes() > 0) {
            try {
                iterations = Math.max(1, Math.min(32, data.consumeInt(1, 32)));
            } catch (Throwable t) {
                iterations = 1;
            }
        }

        for (int i = 0; i < iterations; i++) {
            String zoneId = ZONES[data.consumeInt(0, ZONES.length - 1)];
            DateTimeZone zone;
            try {
                zone = DateTimeZone.forID(zoneId);
            } catch (IllegalArgumentException e) {
                zone = DateTimeZone.getDefault();
            }

            int baseYear = LEAP_YEARS[data.consumeInt(0, LEAP_YEARS.length - 1)];
            boolean atStartOfYear = data.consumeBoolean();

            int baseMonth = atStartOfYear ? 1 : 12;
            int baseDay = atStartOfYear ? 1 : 31;
            int baseHour = atStartOfYear ? 0 : 23;
            int baseMinute = atStartOfYear ? 0 : 59;
            int baseSecond = atStartOfYear ? 0 : 59;
            int baseMillis = atStartOfYear ? 0 : 999;

            MutableDateTime base = new MutableDateTime(baseYear, baseMonth, baseDay, baseHour, baseMinute, baseSecond, baseMillis, zone);

            // Build input "M d" with varied values but bias towards Feb 29.
            int month;
            int day;
            if (data.consumeBoolean()) {
                month = 2;
                day = 29;
            } else {
                month = 1 + Math.abs(data.consumeInt()) % 12;
                day = 1 + Math.abs(data.consumeInt()) % 31;
            }
            String input = month + " " + day;

            // Determine if Feb 29 should be valid for the correct default year (using the patched logic).
            Chronology chrono = base.getChronology();
            long instantMillis = base.getMillis();
            int correctDefaultYear = chrono.year().get(instantMillis);
            boolean isLeap = (correctDefaultYear % 4 == 0) && ((correctDefaultYear % 100 != 0) || (correctDefaultYear % 400 == 0));
            boolean shouldBeValid = (month == 2 && day == 29 && isLeap);

            // Use a fresh instance each time since parseInto mutates it.
            MutableDateTime target = new MutableDateTime(baseYear, baseMonth, baseDay, baseHour, baseMinute, baseSecond, baseMillis, zone);

            try {
                formatter.parseInto(target, input, 0);
            } catch (IllegalFieldValueException ex) {
                // If Feb 29 SHOULD be valid for the correct default year, this exception indicates the buggy path.
                if (shouldBeValid) {
                    throw ex;
                }
                // Otherwise, it's a legitimate rejection of invalid input; swallow.
            } catch (IllegalArgumentException ex) {
                // Legitimate parse/config rejection; swallow.
            }
        }
    }
