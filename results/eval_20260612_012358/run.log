package org.joda.time.format;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;
import org.joda.time.MutableDateTime;
import org.joda.time.DateTimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: Known failing scenario on buggy version
        DateTimeFormatter formatter = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

        // New York at start of year
        MutableDateTime nyStart = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York"));
        formatter.parseInto(nyStart, "2 29", 0);

        // Tokyo at end of year
        MutableDateTime tokyoEnd = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo"));
        formatter.parseInto(tokyoEnd, "2 29", 0);

        // EXPLORE: Vary zones, years (leap), and string positions/surroundings
        String[] zoneIds = new String[] {
            "UTC",
            "Europe/London",
            "Europe/Paris",
            "America/New_York",
            "America/Los_Angeles",
            "America/Sao_Paulo",
            "Asia/Tokyo",
            "Asia/Kolkata",
            "Asia/Kathmandu",
            "Australia/Sydney",
            "Pacific/Auckland",
            "Pacific/Honolulu"
        };

        int iterations = 1 + data.consumeInt(0, 6);
        for (int i = 0; i < iterations; i++) {
            // Choose a time zone
            DateTimeZone zone = DateTimeZone.forID(zoneIds[data.consumeInt(0, zoneIds.length - 1)]);

            // Choose a leap year close to boundary conditions; avoid non-leap centuries
            int y = 1904 + 4 * data.consumeInt(0, 70); // range roughly 1904..2184
            if ((y % 100) == 0 && (y % 400) != 0) {
                y += 4; // skip non-leap centuries
            }

            // Choose boundary: start or end of year
            boolean atStart = data.consumeBoolean();
            MutableDateTime base;
            if (atStart) {
                base = new MutableDateTime(y, 1, 1, 0, 0, 0, 0, zone);
            } else {
                base = new MutableDateTime(y, 12, 31, 23, 59, 59, 999, zone);
            }

            // Build input string with "2 29" at a random position
            String prefix = data.consumeBoolean() ? data.consumeAsciiString(16) : "";
            String suffix = data.consumeBoolean() ? data.consumeAsciiString(16) : "";
            String toParse = prefix + "2 29" + suffix;
            int position = prefix.length();

            try {
                formatter.parseInto(base, toParse, position);
            } catch (IllegalArgumentException | UnsupportedOperationException e) {
                // Expected for many fuzzed cases (invalid positions, invalid contexts).
                // Swallow and continue to explore other inputs.
            }
        }
    }
}
