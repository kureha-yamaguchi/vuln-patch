            }

            long millisUtc(int year, int month, int dayOfMonth) {
                Calendar cal = new GregorianCalendar(UTC);
                cal.clear();
                cal.set(year, month - 1, dayOfMonth, 12, 0, 0);
                return cal.getTime().getTime();
            }

