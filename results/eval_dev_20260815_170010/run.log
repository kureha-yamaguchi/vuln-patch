package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String input : anchors) {
            try {
                String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
                /*
                 * Contract/oracle:
                 * escapeCsv only needs to quote/escape fields containing CSV meta-characters
                 * (comma, quote, CR, LF). These anchor inputs are valid UTF-16 surrogate pairs
                 * and contain none of those characters, so a correct implementation must return
                 * the original string unchanged. A patch that merely suppresses the crash but
                 * skips/mangles surrogate handling will violate this equality.
                 */
                if (!input.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV field should remain unchanged input="
                            + repr(input) + " lhs=" + repr(out) + " rhs=" + repr(input));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw (RuntimeException) t;
                }
            }
        }

        int cases = 1 + Math.min(4, Math.max(0, data.remainingBytes() / 4));
        for (int i = 0; i < cases; i++) {
            String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
            String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

            int pairCount = data.consumeInt(1, 3);
            StringBuilder mid = new StringBuilder();
            for (int j = 0; j < pairCount; j++) {
                int cp = data.consumeInt(0x10000, 0x10FFFF);
                mid.append(Character.toChars(cp));
                if (j + 1 < pairCount) {
                    mid.append(sanitizeCsvSafe(data.consumeAsciiString(4)));
                }
            }

            String input;
            switch (data.consumeInt(0, 2)) {
                case 0:
                    input = prefix + mid.toString() + suffix;
                    break;
                case 1:
                    input = mid.toString() + prefix + suffix;
                    break;
                default:
                    input = prefix + suffix + mid.toString();
                    break;
            }

            try {
                String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
                /*
                 * Contract/oracle:
                 * We construct input by construction as a valid, non-empty UTF-16 string
                 * containing at least one real supplementary code point and excluding all CSV
                 * special characters (comma, quote, CR, LF). Therefore escapeCsv must accept it
                 * and leave it unchanged. This exercises the real public API used by production
                 * callers while checking more than "does not throw".
                 */
                if (!input.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV field should remain unchanged input="
                            + repr(input) + " lhs=" + repr(out) + " rhs=" + repr(input));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t)) {
                    throw (RuntimeException) t;
                }
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid") || name.contains("validation");
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String repr(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '\\' && c != '"') {
                sb.append(c);
            } else {
                sb.append(String.format("\\u%04X", (int) c));
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
