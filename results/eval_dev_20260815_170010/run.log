package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();
        exploreInvalidRejections(data);
        exploreValidFamilyAgreement(data);
    }

    private static void exerciseAnchor() {
        // Contract/oracle: malformed numeric strings like the failing test's inputs must be
        // rejected cleanly by the public parser, not accepted and not crashed by an unrelated
        // String index error. A throw-deleting patch that simply returns/accepts would violate this.
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            assertCleanRejection(badInputs[i], "anchor");
        }
    }

    private static void exploreInvalidRejections(FuzzedDataProvider data) {
        // Same documented guarantee as above: invalid numeric text should be rejected cleanly.
        // We vary the malformed shape around the patched suffix-handling region.
        int mode = data.consumeInt(0, 5);
        String input;
        switch (mode) {
            case 0: {
                char suffix = chooseSuffix(data);
                input = String.valueOf(suffix);
                break;
            }
            case 1: {
                char suffix = chooseSuffix(data);
                String prefix = alphaPrefix(data, true);
                input = prefix + suffix;
                break;
            }
            case 2: {
                char suffix = chooseSuffix(data);
                String prefix = data.consumeAsciiString(8);
                if (prefix.length() == 0) {
                    prefix = "-";
                }
                input = prefix + suffix;
                break;
            }
            case 3: {
                char suffix = chooseSuffix(data);
                String middle = alphaPrefix(data, false);
                input = "-" + middle + suffix;
                break;
            }
            case 4: {
                char suffix = chooseSuffix(data);
                String maybeExp = data.consumeBoolean() ? "e" : "E";
                String body = alphaPrefix(data, true);
                input = body + maybeExp + suffix;
                break;
            }
            default: {
                char suffix = chooseSuffix(data);
                String body = data.consumeAsciiString(6);
                if (body.length() == 0) {
                    body = "+";
                }
                input = body + suffix;
                break;
            }
        }
        assertCleanRejection(input, "explore");
    }

    private static void exploreValidFamilyAgreement(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 3);
        try {
            switch (mode) {
                case 0:
                    checkDecimalIntAgreement(data);
                    break;
                case 1:
                    checkHexAgreement(data);
                    break;
                case 2:
                    checkLongAgreement(data);
                    break;
                default:
                    checkBigIntegerAgreement(data);
                    break;
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            // If either side throws, the relation does not apply to this input.
        }
    }

    private static void checkDecimalIntAgreement(FuzzedDataProvider data) {
        int n = data.consumeInt(-1_000_000, 1_000_000);
        String s = Integer.toString(n);
        Number a;
        Integer b;
        try {
            a = NumberUtils.createNumber(s);
            b = NumberUtils.createInteger(s);
        } catch (Throwable t) {
            return;
        }
        if (!(a instanceof Integer) || !a.equals(b)) {
            throw new RuntimeException("[oracle:family-agree] metamorphic violation: createNumber(decimal-int) must agree with createInteger for canonical int input="
                    + s + " lhs=" + describe(a) + " rhs=" + describe(b));
        }
    }

    private static void checkHexAgreement(FuzzedDataProvider data) {
        int n = data.consumeInt(0, 1_000_000);
        String digits = Integer.toHexString(n);
        String s = data.consumeBoolean() ? "0x" + digits : "-0x" + digits;
        Number a;
        Integer b;
        try {
            a = NumberUtils.createNumber(s);
            b = NumberUtils.createInteger(s);
        } catch (Throwable t) {
            return;
        }
        if (!(a instanceof Integer) || !a.equals(b)) {
            throw new RuntimeException("[oracle:family-agree] metamorphic violation: createNumber(hex) must agree with createInteger on valid hex input="
                    + s + " lhs=" + describe(a) + " rhs=" + describe(b));
        }
