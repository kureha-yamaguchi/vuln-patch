package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.TreeSet;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        if (data.remainingBytes() == 0) {
            return;
        }

        TimeSeries series = buildGapSeries(data);
        if (series == null || series.getItemCount() < 2) {
            return;
        }

        checkSeriesConsistency(series, "src");

        int[] gap = findGap(series);
        if (gap == null) {
            return;
        }

        int leftDay = gap[0];
        int rightDay = gap[1];
        int year = gap[2];
        if (rightDay - leftDay <= 1) {
            return;
        }

        int startDay = data.consumeInt(leftDay + 1, rightDay - 1);
        int endDay = data.consumeInt(startDay, rightDay - 1);

        Day start = new Day(startDay, 1, year);
        Day end = new Day(endDay, 1, year);

        // Documented precondition: start <= end. We construct that by design.
        // For a correct implementation, an empty range inside a gap must return an
        // empty copy, not reject the input. A throw-deleting patch could still
        // return a malformed copy, so we also check metadata/state consistency.
        try {
            TimeSeries copy = series.createCopy(start, end);
            checkSeriesConsistency(copy, "copy");
            checkMetadataPreserved(series, copy, "gap");
            if (copy.getItemCount() != 0) {
                throw new RuntimeException("[oracle:gap-empty] metamorphic violation: gap copy should be empty start="
                        + start + " end=" + end + " count=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                if (hasCreateCopyFrame(e)) {
                    throw new RuntimeException("[oracle:gap-accept] metamorphic violation: valid empty gap range was rejected start="
                            + start + " end=" + end + " ex=" + e.getClass().getName(), e);
                }
                return;
            }
            if (isOurOracle(e)) {
                throw e;
            }
            return;
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), new Integer(1));
        s.add(new Day(31, 1, 2006), new Integer(1));
        checkSeriesConsistency(s, "anchor-src");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            TimeSeries copy = s.createCopy(start, end);
            checkSeriesConsistency(copy, "anchor-copy");
            checkMetadataPreserved(s, copy, "anchor");
            if (copy.getItemCount() != 0) {
                throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor gap copy should be empty count="
                        + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isCleanRejection(e) && hasCreateCopyFrame(e)) {
                throw new RuntimeException("[oracle:anchor-accept] metamorphic violation: exact valid trigger input was rejected", e);
            }
            if (isOurOracle(e)) {
                throw e;
            }
        }
    }

    private static TimeSeries buildGapSeries(FuzzedDataProvider data) {
        String name = data.consumeAsciiString(12);
        if (name == null || name.length() == 0) {
            name = "S";
        }
        int year = data.consumeInt(1990, 2030);

        TreeSet days = new TreeSet();
        int requested = data.consumeInt(2, 12);
        for (int i = 0; i < requested; i++) {
            days.add(new Integer(data.consumeInt(1, 28)));
        }

        if (days.size() < 2 || !hasInternalGap(days)) {
            days.clear();
            days.add(new Integer(1));
            days.add(new Integer(28));
        }

        TimeSeries series = new TimeSeries(name, Day.class);
        List ordered = new ArrayList(days);
        Collections.sort(ordered);
        for (int i = 0; i < ordered.size(); i++) {
            int d = ((Integer) ordered.get(i)).intValue();
            series.add(new Day(d, 1, year), new Integer(i + 1));
        }
        return series;
    }

    private static boolean hasInternalGap(TreeSet days) {
        Integer prev = null;
        for (Object o : days) {
            Integer cur = (Integer) o;
            if (prev != null && cur.intValue() - prev.intValue() > 1) {
                return true;
            }
            prev = cur;
        }
        return false;
    }

    private static int[] findGap(TimeSeries series) {
        for (int i = 0; i + 1 < series.getItemCount(); i++) {
            Day left = (Day) series.getTimePeriod(i);
            Day right = (Day) series.getTimePeriod(i + 1);
            int leftDay = left.getDayOfMonth();
            int rightDay = right.getDayOfMonth();
            if (left.getMonth() == 1 && right.getMonth() == 1
                    && left.getYear() == right.getYear()
                    && rightDay - leftDay > 1) {
                return new int[] { leftDay, rightDay, left.getYear() };
            }
        }
        return null;
    }

    private static void checkMetadataPreserved(TimeSeries src, TimeSeries copy, String tag) {
        if (src.getTimePeriodClass() != copy.getTimePeriodClass()) {
            throw new RuntimeException("[oracle:meta-class] metamorphic violation: time period class changed tag="
                    + tag + " src=" + src.getTimePeriodClass() + " copy=" + copy.getTimePeriodClass());
        }
        String srcDomain = src.getDomainDescription();
        String copyDomain = copy.getDomainDescription();
        if (srcDomain == null ? copyDomain != null : !srcDomain.equals(copyDomain)) {
            throw new RuntimeException("[oracle:meta-domain] metamorphic violation: domain description changed tag="
                    + tag + " src=" + srcDomain + " copy=" + copyDomain);
        }
        String srcRange = src.getRangeDescription();
        String copyRange = copy.getRangeDescription();
        if (srcRange == null ? copyRange != null : !srcRange.equals(copyRange)) {
            throw new RuntimeException("[oracle:meta-range] metamorphic violation: range description changed tag="
                    + tag + " src=" + srcRange + " copy=" + copyRange);
        }
    }

    private static void checkSeriesConsistency(TimeSeries ts, String tag) {
        // Sound consistency check: getItemCount() reports the number of items, and
        // getItems() exposes the same backing data as an unmodifiable list.
        int count = ts.getItemCount();
        List items = ts.getItems();
        if (items.size() != count) {
            throw new RuntimeException("[oracle:count-items] metamorphic violation: count disagrees with items.size tag="
                    + tag + " count=" + count + " size=" + items.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem byIndex = ts.getDataItem(i);
            TimeSeriesDataItem byList = (TimeSeriesDataItem) items.get(i);
            RegularTimePeriod p = byIndex.getPeriod();
            int idx = ts.getIndex(p);
            if (idx != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex(getDataItem(i).getPeriod()) != i tag="
                        + tag + " i=" + i + " idx=" + idx + " period=" + p);
            }
            if (byList.getPeriod().compareTo(p) != 0) {
                throw new RuntimeException("[oracle:list-order] metamorphic violation: getItems disagrees with getDataItem tag="
                        + tag + " i=" + i + " listPeriod=" + byList.getPeriod() + " indexPeriod=" + p);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean hasCreateCopyFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.jfree.data.time.TimeSeries".equals(e.getClassName())
                    && "createCopy".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOurOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().indexOf("[oracle:") >= 0;
    }
}
