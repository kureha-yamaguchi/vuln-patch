package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact regression-test inputs. On the buggy build these valid surrogate-pair
        // inputs reach CharSequenceTranslator.translate(...) and throw
        // StringIndexOutOfBoundsException from the patched bookkeeping loop.
        exerciseEscapeCsv("\uD83D\uDE30", true, true);
        exerciseEscapeCsv("\uD800\uDC00", true, true);
        exerciseEscapeCsv("\uD834\uDD1E", true, true);
        exerciseEscapeCsv("\uDBFF\uDFFD", true, true);

        // Explore the root-cause property: valid-by-construction strings that contain one or more
        // supplementary code points (hence UTF-16 surrogate pairs) and no CSV metacharacters.
        // Documented CSV escaping behavior is to return such inputs unchanged, so this is also our
        // post-condition: a throw-deleting / branch-skipping patch that silently drops or mangles
        // characters would violate equality with the original string.
        String fuzzed = buildSafeStringWithSurrogatePairs(data);
        exerciseEscapeCsv(fuzzed, true, true);

        // Also probe a related shape with more surrounding content to vary positions/lengths.
        String left = sanitizeCsvSafe(data.consumeAsciiString(12));
        String right = sanitizeCsvSafe(data.consumeRemainingAsString());
        if (right.length() > 24) {
            right = right.substring(0, 24);
        }
        String composite = left + fuzzed + right;
        exerciseEscapeCsv(composite, true, true);
    }

    private static void exerciseEscapeCsv(String input, boolean validByConstruction, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            if (assertIdentity && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe strings input="
                        + repr(input) + " lhs=" + repr(escaped) + " rhs=" + repr(input));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildSafeStringWithSurrogatePairs(FuzzedDataProvider data) {
        int pairs = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < pairs; i++) {
            sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.appendCodePoint(cp);
        }
        sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));

        if (sb.length() == 0) {
            sb.appendCodePoint(0x10000);
        }
        return sb.toString();
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String repr(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
