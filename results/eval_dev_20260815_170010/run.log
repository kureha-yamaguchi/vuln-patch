package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        try {
            TimeSeries s = new TimeSeries("S");
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));

            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);

            assertCopyMatchesManualSelection(s, start, end, "anchor-empty");
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            // Swallow unrelated setup issues.
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        String name = data.consumeAsciiString(16);
        if (name == null || name.length() == 0) {
            name = "S";
        }

        TimeSeries series;
        try {
            series = new TimeSeries(name, Year.class);
        } catch (RuntimeException e) {
            return;
        }

        int itemCount = data.consumeInt(3, 8);
        int year = data.consumeInt(1900, 2090);
        int[] years = new int[itemCount];

        for (int i = 0; i < itemCount; i++) {
            int step = data.consumeInt(1, 4);
            if (i == 0) {
                years[i] = year;
            } else {
                years[i] = years[i - 1] + step;
            }
            try {
                series.add(new Year(years[i]), new Integer(data.consumeInt(-1000000, 1000000)));
            } catch (RuntimeException e) {
                return;
            }
        }

        int[] gapStarts = new int[itemCount - 1];
        int gapCount = 0;
        for (int i = 0; i < itemCount - 1; i++) {
            if (years[i + 1] - years[i] > 1) {
                gapStarts[gapCount++] = i;
            }
        }
        if (gapCount == 0) {
            return;
        }

        // Valid-by-construction empty-range probe:
        // start <= end, both non-null, but there is no data item in [start, end].
        // A correct createCopy(RegularTimePeriod, RegularTimePeriod) must return an empty series.
        int gapIndex = gapStarts[data.consumeInt(0, gapCount - 1)];
        int gapSize = years[gapIndex + 1] - years[gapIndex] - 1;
        int leftOffset = data.consumeInt(1, gapSize);
        int rightRemaining = gapSize - leftOffset;
        int endOffset = leftOffset + data.consumeInt(0, rightRemaining);
        Year emptyStart = new Year(years[gapIndex] + leftOffset);
        Year emptyEnd = new Year(years[gapIndex] + endOffset);
        assertCopyMatchesManualSelection(series, emptyStart, emptyEnd, "gap-empty");

        // Additional absent-boundaries probe:
        // choose a segment bracketed by gaps so both bounds are absent from the series,
        // yet the expected copy is non-empty and can be recomputed independently.
        if (gapCount >= 2) {
            int leftGapPos = data.consumeInt(0, gapCount - 1);
            int rightGapPos = data.consumeInt(leftGapPos + 1, gapCount - 1);

            int leftGap = gapStarts[leftGapPos];
            int rightGap = gapStarts[rightGapPos];

            int fromIndex = leftGap + 1;
            int toIndex = rightGap;
            if (fromIndex <= toIndex) {
                int leftGapSize = years[fromIndex] - years[fromIndex - 1] - 1;
                int rightGapSize = years[toIndex + 1] - years[toIndex] - 1;
                if (leftGapSize > 0 && rightGapSize > 0) {
                    Year nonEmptyStart = new Year(years[fromIndex - 1] + data.consumeInt(1, leftGapSize));
                    Year nonEmptyEnd = new Year(years[toIndex] + data.consumeInt(0, rightGapSize - 1));
                    assertCopyMatchesManualSelection(series, nonEmptyStart, nonEmptyEnd, "gap-bracketed");
                }
            }
        }
    }

    private static void assertCopyMatchesManualSelection(
            TimeSeries original,
            RegularTimePeriod start,
            RegularTimePeriod end,
            String oracleId) {
        java.util.ArrayList expectedPeriods = new java.util.ArrayList();
        java.util.ArrayList expectedValues = new java.util.ArrayList();

        for (int i = 0; i < original.getItemCount(); i++) {
            RegularTimePeriod p = original.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                expectedPeriods.add(p);
                expectedValues.add(original.getValue(i));
            }
        }

        TimeSeries copy;
        try {
            copy = original.createCopy(start, end);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] valid createCopy(start,end) rejected for a range that manual selection accepts; "
                                + "expectedPeriods=" + expectedPeriods.size()
                                + " start=" + start + " end=" + end, e);
            }
            return;
        }

        // Contract asserted:
        // createCopy(start,end) returns a copy of the subset of data items whose periods
        // fall in the requested range. We recompute that subset independently by scanning
        // the original series, then require the copy's sequence of periods and values to
        // match exactly. A patch that merely deletes the throw or returns the wrong empty/
        // non-empty copy violates this observable post-condition.
        try {
            if (copy.getItemCount() != expectedPeriods.size()) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] metamorphic violation: itemCount mismatch start="
                                + start + " end=" + end
                                + " reported=" + copy.getItemCount()
                                + " expected=" + expectedPeriods.size());
            }

            java.util.Collection periodsView = copy.getTimePeriods();
            if (periodsView.size() != expectedPeriods.size()) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] consistency violation: getTimePeriods().size()="
                                + periodsView.size() + " expected=" + expectedPeriods.size());
            }

            for (int i = 0; i < expectedPeriods.size(); i++) {
                Object expectedPeriod = expectedPeriods.get(i);
                Object actualPeriod = copy.getTimePeriod(i);
                if (!expectedPeriod.equals(actualPeriod)) {
                    throw new RuntimeException(
                            "[oracle:" + oracleId + "] metamorphic violation: period sequence mismatch index="
                                    + i + " start=" + start + " end=" + end
                                    + " actual=" + actualPeriod + " expected=" + expectedPeriod);
                }

                Number expectedValue = (Number) expectedValues.get(i);
                Number actualValue = copy.getValue(i);
                if (expectedValue == null) {
                    if (actualValue != null) {
                        throw new RuntimeException(
                                "[oracle:" + oracleId + "] metamorphic violation: value nullness mismatch index="
                                        + i + " actual=" + actualValue + " expected=null");
                    }
                } else if (actualValue == null || expectedValue.doubleValue() != actualValue.doubleValue()) {
                    throw new RuntimeException(
                            "[oracle:" + oracleId + "] metamorphic violation: value mismatch index="
                                    + i + " actual=" + actualValue + " expected=" + expectedValue);
                }
            }

            java.util.List itemsView = copy.getItems();
            if (itemsView.size() != expectedPeriods.size()) {
                throw new RuntimeException(
                        "[oracle:" + oracleId + "] consistency violation: getItems().size()="
                                + itemsView.size() + " expected=" + expectedPeriods.size());
            }

            for (int i = 0; i < copy.getItemCount(); i++) {
                if (copy.getIndex(copy.getTimePeriod(i)) != i) {
                    throw new RuntimeException(
                            "[oracle:" + oracleId + "] consistency violation: getIndex(getTimePeriod(i)) mismatch index="
                                    + i + " period=" + copy.getTimePeriod(i)
                                    + " reportedIndex=" + copy.getIndex(copy.getTimePeriod(i)));
                }
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            // If a post-condition read itself is unsupported for this input/state, skip.
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
