                break;
            case 1:
                candidate = middle.toString() + prefix.toString() + suffix.toString();
                break;
            default:
                candidate = prefix.toString() + suffix.toString() + middle.toString();
                break;
        }

        try {
            String out = StringEscapeUtils.escapeCsv(candidate);

            /*
             * Contract/oracle: escapeCsv only quotes/escapes when required for CSV syntax.
             * This candidate is built by construction to be non-null, well-formed UTF-16,
