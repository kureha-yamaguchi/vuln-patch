package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;

public class FuzzHarness {
    private static final int[] CUBE_TRIANGLES = {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        float[] anchor = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };

        runValidScenario(anchor, CUBE_TRIANGLES);

        int variants = 1 + data.consumeInt(0, 3);
        for (int i = 0; i < variants; i++) {
            float x0 = bounded(data.consumeInt(), -20.0f, 20.0f);
            float y0 = bounded(data.consumeInt(), -20.0f, 20.0f);
            float z0 = bounded(data.consumeInt(), -20.0f, 20.0f);

            float sx = 0.5f + bounded(data.consumeInt(), 0.0f, 10.0f);
            float sy = 0.5f + bounded(data.consumeInt(), 0.0f, 10.0f);
            float sz = 0.5f + bounded(data.consumeInt(), 0.0f, 10.0f);

            float delta = bounded(data.consumeInt(), 0.000001f, 0.25f * sx);
            if (data.consumeBoolean()) {
                delta = Math.min(delta, 0.000001f * (1.0f + bounded(data.consumeInt(), 0.0f, 1000.0f)));
            }

            float[] coords = new float[] {
                 x0 + sx, y0 - sy, z0 - sz,
                 x0 + sx, y0 - sy, z0 + sz,
                 x0 - sx, y0 - sy, z0 + sz,
                 x0 - sx, y0 - sy, z0 - sz,
                 x0 + sx, y0 + sy, z0 - sz,
                 x0 + sx - delta, y0 + sy, z0 + sz,
                 x0 - sx, y0 + sy, z0 + sz,
                 x0 - sx, y0 + sy, z0 - sz
            };

            if (data.consumeBoolean()) {
                coords[15] = x0 + sx - Math.min(delta, 0.25f * sx);
            }
            runValidScenario(coords, CUBE_TRIANGLES);
        }
    }

    private static void runValidScenario(float[] coords, int[] indices) {
        try {
            exerciseAndCrossCheck(coords, indices);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrow(t);
            }
        }
    }

    private static void exerciseAndCrossCheck(float[] coords, int[] indices) {
        PolyhedronsSet poly = buildPolyhedron(coords, indices);
        double size1 = poly.getSize();
        Vector3D bary1 = (Vector3D) poly.getBarycenter();

        double size1b = poly.getSize();
        Vector3D bary1b = (Vector3D) poly.getBarycenter();
        if (!close(size1, size1b) || !closeVec(bary1, bary1b)) {
            throw new RuntimeException("[oracle:stable-read] metamorphic violation: repeated getSize/getBarycenter on the same region changed size="
                + size1 + "/" + size1b + " bary=" + vecToString(bary1) + "/" + vecToString(bary1b));
        }

        try {
            PolyhedronsSet twin = buildPolyhedron(coords, indices);
            double size2 = twin.getSize();
            Vector3D bary2 = (Vector3D) twin.getBarycenter();

            /* Contract used for this oracle:
             * getSize/getBarycenter are geometrical properties of the region defined by the boundary.
             * Two freshly identically-constructed regions describe the same shape, so these read-only values
             * must agree. A "fix" that only suppresses the exception or skips setSize/setBarycenter in the
             * patched branch can leave stale/default cached values and violate this equality.
             */
            if (!close(size1, size2) || !closeVec(bary1, bary2)) {
                throw new RuntimeException("[oracle:twin-region] metamorphic violation: identical PolyhedronsSet instances disagree size="
                    + size1 + "/" + size2 + " bary=" + vecToString(bary1) + "/" + vecToString(bary2));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t) || isRootCause(t)) {
                throwAsNeeded(t);
            }
        }
    }

    private static void throwAsNeeded(Throwable t) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            rethrow(t);
        }
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords, int[] indices) {
        Collection<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
            new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();

        for (int idx = 0; idx < indices.length; idx += 3) {
            int ia = indices[idx] * 3;
            int ib = indices[idx + 1] * 3;
            int ic = indices[idx + 2] * 3;

            Vector3D a = new Vector3D(coords[ia], coords[ia + 1], coords[ia + 2]);
            Vector3D b = new Vector3D(coords[ib], coords[ib + 1], coords[ib + 2]);
            Vector3D c = new Vector3D(coords[ic], coords[ic + 1], coords[ic + 2]);

            Plane plane = new Plane(a, b, c);

            Vector2D pA = plane.toSubSpace(a);
            Vector2D pB = plane.toSubSpace(b);
            Vector2D pC = plane.toSubSpace(c);

            ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>> edges =
                new ArrayList<SubHyperplane<org.apache.commons.math3.geometry.euclidean.twod.Euclidean2D>>();
            edges.add(new SubLine(pA, pB));
            edges.add(new SubLine(pB, pC));
            edges.add(new SubLine(pC, pA));

            PolygonsSet polygon = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, polygon));
        }

        return new PolyhedronsSet(facets);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method)
                    || "getSize".equals(method)
                    || "setSize".equals(method)
                    || "setBarycenter".equals(method)
                    || "getBarycenter".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("MathIllegal") || n.contains("Invalid") || n.contains("NoData");
    }

    private static void rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
    }

    private static float bounded(int raw, float min, float max) {
        float span = max - min;
        int mod = raw == Integer.MIN_VALUE ? 0 : Math.abs(raw);
        return min + (mod % 1000000) * (span / 1000000.0f);
    }

    private static boolean close(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return Double.isNaN(a) && Double.isNaN(b);
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-9 * scale;
    }

    private static boolean closeVec(Vector3D a, Vector3D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return close(a.getX(), b.getX()) && close(a.getY(), b.getY()) && close(a.getZ(), b.getZ());
    }

    private static String vecToString(Vector3D v) {
        if (v == null) {
            return "null";
        }
        return "(" + v.getX() + "," + v.getY() + "," + v.getZ() + ")";
    }
}
