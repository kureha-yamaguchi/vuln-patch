package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            if (isOracle(e) || isRootCause(e)) {
                throw e;
            }
        }

        try {
            exerciseAndCheck(data);
        } catch (RuntimeException e) {
            if (isOracle(e) || isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), 1);
        s.add(new Day(31, 1, 2006), 1);

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        checkGetIndexConsistency(s, start);
        checkGetIndexConsistency(s, end);
        checkGetIndexConsistency(s, new Day(19, 8, 2005));
        checkGetIndexConsistency(s, new Day(31, 1, 2006));

        try {
            TimeSeries copy = s.createCopy(start, end);

            // Contract asserted: createCopy(start, end) returns a copy of the
            // subset of items whose periods lie within [start, end]. A patch
            // that merely deletes the throw but returns the wrong subset would
            // violate this range-membership post-condition.
            checkCopyWithinRange(copy, start, end);
            checkGetIndexConsistency(copy, start);
            checkGetIndexConsistency(copy, end);
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException("[oracle:anchor-clone] unexpected CloneNotSupportedException", e);
        }
    }

    private static void exerciseAndCheck(FuzzedDataProvider data) {
        int itemCount = data.consumeInt(2, 8);
        int baseOffset = data.consumeInt(0, 2000);

        TimeSeries series = new TimeSeries(
                nonEmpty(data.consumeAsciiString(20)),
                "domain",
                "range",
                Day.class);

        int[] offsets = new int[itemCount];
        int current = baseOffset;
        for (int i = 0; i < itemCount; i++) {
            if (i > 0) {
                current += data.consumeInt(2, 20);
            }
            offsets[i] = current;
            series.add(dayFromOffset(current), data.consumeInt(-1000, 1000));
        }

        int gapIndex = data.consumeInt(0, itemCount - 2);
        int left = offsets[gapIndex];
        int right = offsets[gapIndex + 1];
        int gap = right - left;
        if (gap < 2) {
            return;
        }

        int startOffset = left + data.consumeInt(1, gap - 1);
        int endOffset = startOffset + data.consumeInt(0, right - startOffset - 1);

        Day start = dayFromOffset(startOffset);
        Day end = dayFromOffset(endOffset);

        if (start.compareTo(end) > 0) {
            return;
        }

        checkGetIndexConsistency(series, dayFromOffset(left));
        checkGetIndexConsistency(series, dayFromOffset(right));
        checkGetIndexConsistency(series, start);
        checkGetIndexConsistency(series, end);

        try {
            TimeSeries copy = series.createCopy(start, end);

            checkCopyWithinRange(copy, start, end);
            checkGetIndexConsistency(copy, start);
            checkGetIndexConsistency(copy, end);

            int expectedCount = 0;
            for (int i = 0; i < series.getItemCount(); i++) {
                RegularTimePeriod p = series.getTimePeriod(i);
                if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                    expectedCount++;
                }
            }
            if (copy.getItemCount() != expectedCount) {
                throw new RuntimeException(
                        "[oracle:copy-count] metamorphic violation: expectedCount="
                                + expectedCount + " actualCount=" + copy.getItemCount()
                                + " start=" + start + " end=" + end);
            }

            for (int i = 0; i < copy.getItemCount(); i++) {
                checkGetIndexConsistency(copy, copy.getTimePeriod(i));
            }

            // Exercise the clone-reachable branch through a guaranteed empty valid range.
            Day emptyStart = dayFromOffset(offsets[itemCount - 1] + 1);
            Day emptyEnd = dayFromOffset(offsets[itemCount - 1] + data.consumeInt(1, 10));
            if (emptyStart.compareTo(emptyEnd) <= 0) {
                TimeSeries emptyCopy = series.createCopy(emptyStart, emptyEnd);
                checkCopyWithinRange(emptyCopy, emptyStart, emptyEnd);
                checkGetIndexConsistency(emptyCopy, emptyStart);
                checkGetIndexConsistency(emptyCopy, emptyEnd);
                if (emptyCopy.getItemCount() != 0) {
                    throw new RuntimeException(
                            "[oracle:empty-copy] metamorphic violation: expected empty copy but got "
                                    + emptyCopy.getItemCount());
                }
            }
        } catch (CloneNotSupportedException e) {
            throw new RuntimeException("[oracle:clone] unexpected CloneNotSupportedException", e);
        }
    }

    private static void checkCopyWithinRange(TimeSeries copy, RegularTimePeriod start, RegularTimePeriod end) {
        for (int i = 0; i < copy.getItemCount(); i++) {
            RegularTimePeriod p = copy.getTimePeriod(i);
            if (p.compareTo(start) < 0 || p.compareTo(end) > 0) {
                throw new RuntimeException(
                        "[oracle:copy-range] metamorphic violation: period outside requested range"
                                + " index=" + i + " period=" + p + " start=" + start + " end=" + end);
            }
        }
    }

    private static void checkGetIndexConsistency(TimeSeries s, RegularTimePeriod period) {
        int idx = s.getIndex(period);
        int count = s.getItemCount();
        if (idx >= 0) {
            if (idx >= count) {
                throw new RuntimeException(
                        "[oracle:getindex-neighbors] metamorphic violation: index beyond item count idx="
                                + idx + " count=" + count);
            }
            RegularTimePeriod found = s.getTimePeriod(idx);
            if (found.compareTo(period) != 0) {
                throw new RuntimeException(
                        "[oracle:getindex-neighbors] metamorphic violation: exact hit mismatch idx="
                                + idx + " query=" + period + " found=" + found);
            }
        } else {
            int insertionPoint = -(idx + 1);
            if (insertionPoint < 0 || insertionPoint > count) {
                throw new RuntimeException(
                        "[oracle:getindex-neighbors] metamorphic violation: invalid insertion point idx="
                                + idx + " ip=" + insertionPoint + " count=" + count);
            }
            if (insertionPoint > 0) {
                RegularTimePeriod before = s.getTimePeriod(insertionPoint - 1);
                if (before.compareTo(period) >= 0) {
                    throw new RuntimeException(
                            "[oracle:getindex-neighbors] metamorphic violation: left neighbor not less than query"
                                    + " ip=" + insertionPoint + " before=" + before + " query=" + period);
                }
            }
            if (insertionPoint < count) {
                RegularTimePeriod after = s.getTimePeriod(insertionPoint);
                if (after.compareTo(period) <= 0) {
                    throw new RuntimeException(
                            "[oracle:getindex-neighbors] metamorphic violation: right neighbor not greater than query"
                                    + " ip=" + insertionPoint + " after=" + after + " query=" + period);
                }
            }
        }
    }

    private static Day dayFromOffset(int offset) {
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(2000, Calendar.JANUARY, 1, 12, 0, 0);
        cal.add(Calendar.DAY_OF_MONTH, offset);
        Date d = cal.getTime();
        return new Day(d);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String nonEmpty(String s) {
        if (s == null || s.length() == 0) {
            return "S";
        }
        return s;
    }
}
