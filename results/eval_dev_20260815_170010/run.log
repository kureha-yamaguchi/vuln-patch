package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("1234.5", true);

        String base = buildValidDecimal(data);

        Number parsedBase = exercise(base, true);
        Number parsedFloatSuffix = exercise(base + "F", true);
        exercise(base + "f", true);
        exercise(base + "D", true);
        exercise(base + "d", true);

        /*
         * Contract used for this oracle:
         * - In createNumber, for a modest decimal string with no exponent and no type suffix,
         *   the implementation "starts small" and returns createFloat(str) when that float is
         *   finite and not an underflowed non-zero.
         * - For the same numeric text plus an 'F' suffix, the implementation explicitly requests
         *   Float and returns createFloat(numeric) under the same guard.
         *
         * We build such inputs by construction: digits '.' digits, no exponent, magnitude kept
         * moderate, and non-zero value. Therefore a correct implementation must make all three
         * real-library computations agree on the same float value:
         *   createNumber(s), createNumber(s + "F"), createFloat(s)
         *
         * This catches "throw-deleting" or branch-skipping patches that avoid the crash but stop
         * returning the documented/implemented type-selection result.
         */
        try {
            Float helper = NumberUtils.createFloat(base);
            if (helper != null && parsedBase != null && parsedFloatSuffix != null) {
                float expected = helper.floatValue();
                float gotBase = parsedBase.floatValue();
                float gotSuffix = parsedFloatSuffix.floatValue();
                if (Float.compare(expected, gotBase) != 0 || Float.compare(expected, gotSuffix) != 0) {
                    throw new RuntimeException(
                        "[oracle:createNumber-float-agreement] metamorphic violation: " +
                        "equivalent decimal/float-suffixed inputs disagree " +
                        "input=" + base +
                        " helper=" + expected +
                        " createNumber(base)=" + gotBase +
                        " createNumber(base+F)=" + gotSuffix
                    );
                }
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e) && hasRelevantStack(e)) {
                throw e;
            }
            if (isOracleViolation(e)) {
                throw e;
            }
        }
    }

    private static Number exercise(String s, boolean validByConstruction) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return null;
            }
            if (validByConstruction && isRootCause(e) && hasRelevantStack(e)) {
                throw e;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException;
    }

    private static boolean hasRelevantStack(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement f = stack[i];
            if ("org.apache.commons.lang3.math.NumberUtils".equals(f.getClassName())) {
                String m = f.getMethodName();
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleViolation(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();

        int intWidth = data.consumeInt(1, 6);
        int fracWidth = data.consumeInt(1, 6);

        String intPart = digits(data, intWidth);
        String fracPart = digits(data, fracWidth);

        if (allZeros(intPart) && allZeros(fracPart)) {
            intPart = "1";
        }

        if (negative) {
            return "-" + intPart + "." + fracPart;
        }
        return intPart + "." + fracPart;
    }

    private static String digits(FuzzedDataProvider data, int width) {
        StringBuilder sb = new StringBuilder(width);
        for (int i = 0; i < width; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean allZeros(String s) {
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) != '0') {
                return false;
            }
        }
        return true;
    }
}
