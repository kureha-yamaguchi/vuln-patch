    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean expectedToBoolean(String s) {
        if (s == null) {
            return false;
        }
        return equalsIgnoreCaseAscii(s, "true")
                || equalsIgnoreCaseAscii(s, "on")
                || equalsIgnoreCaseAscii(s, "yes");
    }

    private static boolean equalsIgnoreCaseAscii(String a, String b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char ca = a.charAt(i);
            char cb = b.charAt(i);
            if (toLowerAscii(ca) != toLowerAscii(cb)) {
                return false;
            }
        }
        return true;
    }

    private static char toLowerAscii(char c) {
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static String buildRandomCase(String token, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(token.length());
        for (int i = 0; i < token.length(); i++) {
            char c = token.charAt(i);
            if (data.consumeBoolean()) {
                if (c >= 'a' && c <= 'z') {
                    c = (char) (c - ('a' - 'A'));
                }
            }
            sb.append(c);
        }
        return sb.toString();
    }

    private static String buildLengthThreeCandidate(FuzzedDataProvider data, char first) {
        char c0 = first;
        if (data.consumeBoolean() && c0 >= 'a' && c0 <= 'z') {
            c0 = (char) (c0 - ('a' - 'A'));
        }
        char c1 = randomAsciiLetter(data);
        char c2 = randomAsciiLetter(data);
        return new String(new char[] { c0, c1, c2 });
    }

    private static char randomAsciiLetter(FuzzedDataProvider data) {
        int n = data.consumeInt(0, 51);
        if (n < 26) {
            return (char) ('a' + n);
        }
        return (char) ('A' + (n - 26));
    }

    private static String toggleAsciiCase(String s) {
        if (s == null) {
            return null;
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 'a' && c <= 'z') {
                sb.append((char) (c - ('a' - 'A')));
            } else if (c >= 'A' && c <= 'Z') {
                sb.append((char) (c + ('a' - 'A')));
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }
}
