package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String anchor : anchors) {
            try {
                String out = StringEscapeUtils.escapeCsv(anchor);
                if (!anchor.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must leave inputs without CSV special characters unchanged input=" + anchor + " lhs=" + out + " rhs=" + anchor);
                }
            } catch (Throwable t) {
                boolean cleanRejection =
                    t instanceof IllegalArgumentException ||
                    t instanceof NumberFormatException;
                if (cleanRejection) {
                    return;
                }
                boolean rootCauseType = t instanceof StringIndexOutOfBoundsException;
                boolean throughPatchedRegion = false;
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                            && "translate".equals(ste.getMethodName())) {
                        throughPatchedRegion = true;
                        break;
                    }
                }
                if (rootCauseType && throughPatchedRegion) {
                    throw t;
                }
                return;
            }
        }

        String rawPrefix = data.consumeAsciiString(16);
        String rawMiddle = data.consumeAsciiString(16);
        String rawSuffix = data.consumeAsciiString(16);

        StringBuilder prefix = new StringBuilder();
        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                prefix.append(c);
            }
        }

        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < rawMiddle.length(); i++) {
            char c = rawMiddle.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                middle.append(c);
            }
        }

        StringBuilder suffix = new StringBuilder();
        for (int i = 0; i < rawSuffix.length(); i++) {
            char c = rawSuffix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                suffix.append(c);
            }
        }

        int pairCount = data.consumeInt(1, 3);
        StringBuilder surrogateCore = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            char high = (char) data.consumeInt(0xD800, 0xDBFF);
            char low = (char) data.consumeInt(0xDC00, 0xDFFF);
            surrogateCore.append(high).append(low);
            if (i + 1 < pairCount) {
                surrogateCore.append(middle);
            }
        }

        String candidate = prefix.toString() + surrogateCore.toString() + suffix.toString();

        try {
            String out = StringEscapeUtils.escapeCsv(candidate);

            /*
             * Documented contract for escapeCsv: when the input contains no CSV special characters
             * (comma, quote, CR, LF), it is returned unchanged. We construct candidate to satisfy
             * that precondition by construction while still containing at least one valid surrogate pair.
             * A "fix" that merely suppresses the crash but skips or corrupts translation would violate this.
             */
            if (!candidate.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must leave inputs without CSV special characters unchanged input=" + candidate + " lhs=" + out + " rhs=" + candidate);
            }

            String left = prefix.toString() + surrogateCore.toString();
            String right = suffix.toString();
            try {
                String whole = StringEscapeUtils.escapeCsv(left + right);
                String split = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);
                if (!whole.equals(split)) {
                    throw new RuntimeException("[oracle:csv-compose] metamorphic violation: for inputs with no CSV special characters, escaping a concatenation must equal concatenating escaped parts input=" + candidate + " lhs=" + whole + " rhs=" + split);
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (Throwable t) {
            boolean cleanRejection =
                t instanceof IllegalArgumentException ||
                t instanceof NumberFormatException;
            if (cleanRejection) {
                return;
            }
            boolean rootCauseType = t instanceof StringIndexOutOfBoundsException;
            boolean throughPatchedRegion = false;
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                        && "translate".equals(ste.getMethodName())) {
                    throughPatchedRegion = true;
                    break;
                }
            }
            if (rootCauseType && throughPatchedRegion) {
                throw t;
            }
        }
    }
