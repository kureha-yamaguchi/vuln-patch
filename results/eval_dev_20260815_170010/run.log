package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor("\uD83D\uDE30");
        exerciseAnchor("\uD800\uDC00");
        exerciseAnchor("\uD834\uDD1E");
        exerciseAnchor("\uDBFF\uDFFD");

        String fuzzed = buildValidSafeCsvInput(data);
        exerciseOracle(fuzzed);
    }

    private static void exerciseAnchor(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            if (!input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return the original string when the input contains no comma, quote, CR, or LF input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exerciseOracle(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            /*
             * Documented contract of CSV escaping: only values containing comma, double quote,
             * CR, or LF need escaping/quoting. This input is built by construction to contain
             * none of those characters, while still containing one or more valid surrogate pairs.
             * Therefore every correct implementation must return the original input unchanged.
             * A patch that merely suppresses the crash by skipping translation/bookkeeping could
             * still violate this observable equality.
             */
            if (!input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return the original string when the input contains no comma, quote, CR, or LF input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidSafeCsvInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        String prefix = sanitizeSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeSafeAscii(data.consumeAsciiString(16));
        sb.append(prefix);

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                sb.append(anchorPair(data.consumeInt(0, 3)));
            } else {
                int cp = data.consumeInt(0x10000, 0x10FFFF);
                sb.append(new String(Character.toChars(cp)));
            }
            if (i + 1 < pairCount) {
                sb.append(sanitizeSafeAscii(data.consumeAsciiString(8)));
            }
        }

        sb.append(suffix);

        if (sb.length() == 0) {
            sb.append(anchorPair(0));
        }
        return sb.toString();
    }

    private static String anchorPair(int which) {
        switch (which) {
            case 0:
                return "\uD83D\uDE30";
            case 1:
                return "\uD800\uDC00";
            case 2:
                return "\uD834\uDD1E";
            default:
                return "\uDBFF\uDFFD";
        }
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('a');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
