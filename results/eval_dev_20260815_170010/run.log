package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runValidCase("\uD83D\uDE30");
        runValidCase("\uD800\uDC00");
        runValidCase("\uD834\uDD1E");
        runValidCase("\uDBFF\uDFFD");

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

        int pairs = data.consumeInt(1, 4);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < pairs; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            middle.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                middle.append(sanitizeCsvSafe(data.consumeAsciiString(4)));
            }
        }

        runValidCase(prefix + middle.toString() + suffix);

        if (data.consumeBoolean()) {
            String extraPrefix = sanitizeCsvSafe(data.consumeAsciiString(8));
            String extraSuffix = sanitizeCsvSafe(data.consumeAsciiString(8));
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            runValidCase(extraPrefix + new String(Character.toChars(cp)) + extraSuffix);
        }
    }

    private static void runValidCase(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted:
             * StringEscapeUtils.escapeCsv returns the input unchanged when it contains
             * no comma, quote, CR, or LF. We construct inputs to satisfy that precondition
             * and to contain at least one valid surrogate pair, so a throw-deleting or
             * branch-skipping patch that silently mangles/skips translation is caught.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must return unchanged input for CSV-safe text input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
