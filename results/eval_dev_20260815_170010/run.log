public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class H {
            boolean isCleanRejection(Throwable t) {
                return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
            }

            boolean hasRelevantFrame(Throwable t) {
                for (StackTraceElement e : t.getStackTrace()) {
                    String cn = e.getClassName();
                    String mn = e.getMethodName();
                    if ("translate".equals(mn) && (
                            "org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cn) ||
                            "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cn) ||
                            "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cn) ||
                            "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cn))) {
                        return true;
                    }
                }
                return false;
            }

            boolean isRootCause(Throwable t) {
                return t instanceof StringIndexOutOfBoundsException && hasRelevantFrame(t);
            }

            String sanitizeSafeAscii(String s) {
                StringBuilder sb = new StringBuilder(s.length());
                for (int i = 0; i < s.length(); i++) {
                    char c = s.charAt(i);
                    if (c == ',' || c == '"' || c == '\n' || c == '\r') {
                        sb.append('A');
                    } else if (c >= 32 && c <= 126) {
                        sb.append(c);
                    } else {
                        sb.append('B');
                    }
                }
                return sb.toString();
            }

            String buildValidInput() {
                String left = sanitizeSafeAscii(data.consumeAsciiString(8));
                String right = sanitizeSafeAscii(data.consumeAsciiString(8));
                int pairCount = data.consumeInt(1, 4);
                StringBuilder mid = new StringBuilder();
                for (int i = 0; i < pairCount; i++) {
                    int cp;
                    do {
                        cp = data.consumeInt(0x10000, 0x10FFFF);
                    } while (!Character.isValidCodePoint(cp));
                    mid.append(Character.toChars(cp));
                    if (data.consumeBoolean()) {
                        mid.append(sanitizeSafeAscii(data.consumeAsciiString(3)));
                    }
                }
                return left + mid.toString() + right;
            }

            void callAndCheck(String input, boolean assertIdentity) {
                try {
                    String out = StringEscapeUtils.escapeCsv(input);

                    if (assertIdentity) {
                        /*
                         * Contract used for this oracle:
                         * escapeCsv only needs to quote/escape when the input contains CSV special
                         * characters. For strings we construct here, there are no commas, quotes,
                         * CR, or LF, so a correct implementation must return the input unchanged.
