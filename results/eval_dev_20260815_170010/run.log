public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();
        exerciseCoverageSeeds();
        explorePatchedBoundary(data);
        checkFloatSuffixCaseOracle(data);
        checkDoubleSuffixCaseOracle(data);
    }

    private static void exerciseAnchor() {
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < badInputs.length; i++) {
            safeCreateNumber(badInputs[i], false);
        }
    }

    private static void exerciseCoverageSeeds() {
        safeCreateNumber("0x10", true);
        safeCreateNumber("-0x10", true);
        safeCreateNumber("12345L", true);
        safeCreateNumber("1.25F", true);
        safeCreateNumber("1.25D", true);
        safeCreateNumber("1.1E-700F", true);
        safeCreateNumber("0.0", true);
        safeCreateNumber("10", true);
    }

    private static void explorePatchedBoundary(FuzzedDataProvider data) {
        char suffix;
        switch (data.consumeInt(0, 5)) {
            case 0:
                suffix = 'l';
                break;
            case 1:
                suffix = 'L';
                break;
            case 2:
                suffix = 'f';
                break;
            case 3:
                suffix = 'F';
                break;
            case 4:
                suffix = 'd';
                break;
            default:
                suffix = 'D';
                break;
        }

        String prefix = data.consumeAsciiString(8);
        String middle = data.consumeAsciiString(8);

        safeCreateNumber(String.valueOf(suffix), false);
        safeCreateNumber(prefix + suffix, false);
        safeCreateNumber(suffix + middle, false);
        safeCreateNumber(prefix + middle + suffix, false);

        int n = data.consumeInt(-1_000_000, 1_000_000);
        String canonicalInt = Integer.toString(n);
        safeCreateNumber(canonicalInt + 'L', true);
        safeCreateNumber(canonicalInt + 'l', true);

        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        String coreDecimal = Integer.toString(whole) + "." + Integer.toString(frac);
        safeCreateNumber(coreDecimal + 'F', true);
        safeCreateNumber(coreDecimal + 'f', true);
        safeCreateNumber(coreDecimal + 'D', true);
        safeCreateNumber(coreDecimal + 'd', true);

        int expWhole = data.consumeInt(-1000, 1000);
        int expFrac = data.consumeInt(0, 9999);
        int exp = data.consumeInt(-30, 30);
        String scientific = Integer.toString(expWhole) + "." + Integer.toString(expFrac) + "E" + Integer.toString(exp);
        safeCreateNumber(scientific + 'F', true);
        safeCreateNumber(scientific + 'D', true);
    }

    private static void checkFloatSuffixCaseOracle(FuzzedDataProvider data) {
        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        String core = Integer.toString(whole) + "." + Integer.toString(frac);

        try {
            Number upper = NumberUtils.createNumber(core + "F");
            Number lower = NumberUtils.createNumber(core + "f");
            Float direct = NumberUtils.createFloat(core);

            if (!(upper instanceof Float) || !(lower instanceof Float)) {
                return;
            }

            int upperBits = Float.floatToIntBits(((Float) upper).floatValue());
            int lowerBits = Float.floatToIntBits(((Float) lower).floatValue());
            int directBits = Float.floatToIntBits(direct.floatValue());

            if (upperBits != lowerBits || upperBits != directBits) {
                throw new RuntimeException(
                    "[oracle:float-suffix-case] metamorphic violation: equivalent F/f suffix parse disagrees input="
                        + core + " upper=" + upper + " lower=" + lower + " direct=" + direct);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkDoubleSuffixCaseOracle(FuzzedDataProvider data) {
        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        String core = Integer.toString(whole) + "." + Integer.toString(frac);

        try {
            Number upper = NumberUtils.createNumber(core + "D");
            Number lower = NumberUtils.createNumber(core + "d");
            Double direct = NumberUtils.createDouble(core);

            if (!(upper instanceof Double) || !(lower instanceof Double)) {
                return;
            }

            long upperBits = Double.doubleToLongBits(((Double) upper).doubleValue());
            long lowerBits = Double.doubleToLongBits(((Double) lower).doubleValue());
            long directBits = Double.doubleToLongBits(direct.doubleValue());

            if (upperBits != lowerBits || upperBits != directBits) {
                throw new RuntimeException(
                    "[oracle:double-suffix-case] metamorphic violation: equivalent D/d suffix parse disagrees input="
                        + core + " upper=" + upper + " lower=" + lower + " direct=" + direct);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void safeCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)
            && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)
                    || "isAllZeros".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls)
                && ("charAt".equals(method) || "substring".equals(method))) {
                for (int j = i + 1; j < trace.length; j++) {
                    StackTraceElement caller = trace[j];
                    if ("org.apache.commons.lang.NumberUtils".equals(caller.getClassName())
                        && "createNumber".equals(caller.getMethodName())) {
                        return true;
                    }
                }
            }
        }
        return false;
    }
}
