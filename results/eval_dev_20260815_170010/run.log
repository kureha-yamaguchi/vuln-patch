package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract/oracle used below:
        // From the implementation and failing test, the only 3-character strings accepted as true
        // are case-insensitive variants of "yes". Therefore:
        //   - any non-null 3-char string whose first char is neither 'y' nor 'Y' must return false
        //   - any case variant of "yes" must return true
        // These are observable post-conditions on the public API. A "fix" that merely avoids the
        // crash by returning false for all 3-char inputs would violate the second property.

        // ANCHOR: exact ground-truth trigger from the failing test.
        checkThreeCharNonYesMustBeFalse("off");

        // EXPLORE: recognized 3-char true token with fuzzed casing, to catch overfitted "always false".
        String yesVariant = ""
                + (data.consumeBoolean() ? 'y' : 'Y')
                + (data.consumeBoolean() ? 'e' : 'E')
                + (data.consumeBoolean() ? 's' : 'S');
        checkYesVariantMustBeTrue(yesVariant);

        // EXPLORE: many valid-by-construction 3-char strings that are not "yes"/"YES" variants.
        int rounds = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < rounds; i++) {
            String direct = new String(new char[] {
                    pickNonY(data.consumeByte()),
                    pickAscii(data.consumeByte()),
                    pickAscii(data.consumeByte())
            });
            checkThreeCharNonYesMustBeFalse(direct);

            String prefix = data.consumeAsciiString(4);
            String suffix = data.consumeAsciiString(4);
            String surrounded = prefix + direct + suffix;
            String sliced = surrounded.substring(prefix.length(), prefix.length() + 3);
            checkThreeCharNonYesMustBeFalse(sliced);
        }

        // Additional varied real inputs flowing through the same public API.
        if (data.remainingBytes() > 0) {
            String arbitrary = data.consumeString(12);
            try {
                BooleanUtils.toBoolean(arbitrary);
            } catch (RuntimeException t) {
                if (isRootCause(t) && arbitrary != null && arbitrary.length() == 3
                        && arbitrary.charAt(0) != 'y' && arbitrary.charAt(0) != 'Y') {
                    throw t;
                }
                if (isOracleViolation(t)) {
                    throw t;
                }
            }
        }
    }

    private static void checkThreeCharNonYesMustBeFalse(String s) {
        if (s == null || s.length() != 3) {
            return;
        }
        char c0 = s.charAt(0);
        if (c0 == 'y' || c0 == 'Y') {
            return;
        }

        try {
            boolean result = BooleanUtils.toBoolean(s);
            if (result) {
                throw new RuntimeException(
                        "[oracle:nonyes3] metamorphic violation: unrecognized 3-char input must be false input="
                                + quote(s) + " result=" + result);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkYesVariantMustBeTrue(String s) {
        if (s == null || s.length() != 3) {
            return;
        }
        try {
            boolean result = BooleanUtils.toBoolean(s);
            if (!result) {
                throw new RuntimeException(
                        "[oracle:yes3] metamorphic violation: case-insensitive \"yes\" must be true input="
                                + quote(s) + " result=" + result);
            }
        } catch (RuntimeException t) {
            if (isOracleViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement e : stack) {
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Validation") || name.contains("Invalid");
    }

    private static boolean isOracleViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static char pickNonY(byte b) {
        int v = b & 0xFF;
        char c = (char) ('A' + (v % 26));
        if (c == 'Y') {
            c = 'X';
        }
        if ((v & 1) == 1) {
            c = Character.toLowerCase(c);
            if (c == 'y') {
                c = 'x';
            }
        }
        return c;
    }

    private static char pickAscii(byte b) {
        return (char) (32 + ((b & 0xFF) % 95));
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
