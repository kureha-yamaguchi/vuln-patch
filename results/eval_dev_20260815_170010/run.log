package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));
        } catch (RuntimeException e) {
            return;
        }

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            TimeSeries copy = s.createCopy(start, end);

            /* Contract/oracle: createCopy(start,end) on a valid empty range should return
             * a series containing the items in that range, here none. A throw-deleting patch
             * that returns a wrong non-empty copy violates this; a clone/data aliasing bug is
             * caught by mutating the copy and requiring the source to stay unchanged.
             */
            if (copy.getItemCount() != 0 || copy.getItems().size() != 0) {
                throw new RuntimeException(
                    "[oracle:anchor-empty-clone] metamorphic violation: valid empty range must copy zero items"
                    + " count=" + copy.getItemCount()
                    + " itemsSize=" + copy.getItems().size());
            }
            int sourceCount = s.getItemCount();
            copy.add(start, new Integer(7));
            if (s.getItemCount() != sourceCount) {
                throw new RuntimeException(
                    "[oracle:anchor-clone-independence] metamorphic violation: mutating copy changed source"
                    + " sourceCountBefore=" + sourceCount
                    + " sourceCountAfter=" + s.getItemCount());
            }
            if (s.getIndex(start) >= 0) {
                throw new RuntimeException(
                    "[oracle:anchor-clone-independence] metamorphic violation: source unexpectedly contains copied period");
            }
            if (copy.getIndex(start) < 0 || copy.getItemCount() != 1) {
                throw new RuntimeException(
                    "[oracle:anchor-clone-independence] metamorphic violation: copy mutation not reflected in copy"
                    + " copyIndex=" + copy.getIndex(start)
                    + " copyCount=" + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isValidByConstructionRootCause(e)) {
                throw new RuntimeException(
                    "[oracle:anchor-valid-reject] metamorphic violation: valid createCopy(start,end) rejected", e);
            }
        } catch (Error e) {
            if (isInCreateCopyRegion(e)) {
                throw e;
            }
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        String name = data.consumeString(16);
        if (name == null || name.length() == 0) {
            name = "S";
