        exerciseEscapeCsvOnValidSafeInput("\uD800\uDC00");
        exerciseEscapeCsvOnValidSafeInput("\uD834\uDD1E");
        exerciseEscapeCsvOnValidSafeInput("\uDBFF\uDFFD");

        // EXPLORE: build many valid UTF-16 strings containing at least one supplementary
        // code point, but no CSV metacharacters. By construction, escapeCsv is obligated
        // to accept them and return them unchanged.
        String fuzzed = buildValidSafeCsvInput(data);
        if (fuzzed != null) {
            exerciseEscapeCsvOnValidSafeInput(fuzzed);
        }
    }

    private static void exerciseEscapeCsvOnValidSafeInput(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle: escapeCsv only needs to add quoting/escaping when the input
            // contains CSV special characters (comma, quote, CR, LF). Our inputs are built
            // to exclude all of them and are valid UTF-16 by construction, so a correct
            // implementation must return the original string unchanged. This catches
            // throw-deleting or branch-skipping patches that avoid the crash but corrupt
            // the output.
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve safe non-special valid input"
                        + " input=" + printable(input)
                        + " lhs=" + printable(escaped)
                        + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static String buildValidSafeCsvInput(FuzzedDataProvider data) {
        int codePoints = data.consumeInt(1, 8);
        int forcedSupplementaryIndex = data.consumeInt(0, codePoints - 1);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < codePoints; i++) {
            boolean useSupplementary = (i == forcedSupplementaryIndex) || data.consumeBoolean();
            if (useSupplementary) {
                int cp = nextSupplementaryCodePoint(data);
                sb.append(Character.toChars(cp));
            } else {
                sb.append(nextSafeAsciiChar(data));
            }
        }

        return sb.toString();
    }

    private static int nextSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp) && Character.isSupplementaryCodePoint(cp)) {
                return cp;
            }
        }
    }

    private static char nextSafeAsciiChar(FuzzedDataProvider data) {
        final String alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-./:;!@#$%^&*()[]{}=+?~ ";
        return alphabet.charAt(data.consumeInt(0, alphabet.length() - 1));
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("translate".equals(method)
                && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) ch));
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
