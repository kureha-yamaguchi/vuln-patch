        if (plainParsed == null || suffixedParsed == null || directLong == null) {
            return;
        }

        long a = plainParsed.longValue();
        long b = suffixedParsed.longValue();
        long c = directLong.longValue();
        if (a != c || b != c) {
            throw new RuntimeException(
                "[oracle:long-suffix] metamorphic violation: equivalent canonical integer forms disagreed input="
                    + plain + " plain=" + plainParsed + "/" + plainParsed.getClass().getName()
                    + " suffixed=" + suffixedParsed + "/" + suffixedParsed.getClass().getName()
                    + " direct=" + directLong);
        }
    }

    private static void checkBigIntegerFallbackMetamorphic(FuzzedDataProvider data) {
        int digits = data.consumeInt(19, 32);
        StringBuilder sb = new StringBuilder(digits + 2);
