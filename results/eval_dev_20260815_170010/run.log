        checkBigIntegerSuffixAgreement(data);
    }

    private static String buildFlipConditionInput(FuzzedDataProvider data) {
        int prefixLen = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder(prefixLen + 3);
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < prefixLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                sb.append("eE");
                break;
            case 1:
                sb.append("Ee");
                break;
            case 2:
                sb.append("ee");
                break;
            case 3:
                sb.append("EE");
                break;
            case 4:
                sb.append('e');
                break;
            default:
                sb.append('E');
                break;
        }
        return sb.toString();
    }

    private static void checkLongSuffixAgreement(FuzzedDataProvider data) {
        long n = data.consumeInt(-1_000_000, 1_000_000);
        String plain = Long.toString(n);
        String suffixed = plain + (data.consumeBoolean() ? 'L' : 'l');

        Number a;
        Number b;
        Long c;
        try {
            a = NumberUtils.createNumber(plain);
            b = NumberUtils.createNumber(suffixed);
            c = NumberUtils.createLong(plain);
        } catch (RuntimeException ignored) {
            return;
        }

        if (a == null || b == null || c == null) {
            return;
        }

        if (a.longValue() != c.longValue() || b.longValue() != c.longValue()) {
            throw new RuntimeException(
                "[oracle:long-suffix] metamorphic violation: equivalent integer spellings must parse to the same long value"
                    + " input=" + plain
                    + " plain=" + a + "/" + a.getClass().getName()
                    + " suffixed=" + b + "/" + b.getClass().getName()
                    + " direct=" + c);
        }
    }

    private static void checkBigIntegerSuffixAgreement(FuzzedDataProvider data) {
        int digits = data.consumeInt(19, 40);
        StringBuilder sb = new StringBuilder(digits + 2);
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < digits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        String numeric = sb.toString();
        String suffixed = numeric + (data.consumeBoolean() ? 'L' : 'l');

        Number parsed;
        BigInteger expected;
        try {
            parsed = NumberUtils.createNumber(suffixed);
            expected = NumberUtils.createBigInteger(numeric);
        } catch (RuntimeException ignored) {
            return;
        }

        if (parsed == null || expected == null) {
            return;
        }

        BigInteger actual;
        try {
            actual = (parsed instanceof BigInteger) ? (BigInteger) parsed : new BigInteger(parsed.toString());
        } catch (RuntimeException ignored) {
            return;
        }

        if (!expected.equals(actual)) {
            throw new RuntimeException(
                "[oracle:bigint-suffix] metamorphic violation: oversized L-suffixed integer must agree with createBigInteger"
                    + " input=" + suffixed
                    + " parsed=" + parsed + "/" + parsed.getClass().getName()
                    + " expected=" + expected);
        }
    }
}
