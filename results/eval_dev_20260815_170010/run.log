package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor("l");
        exerciseAnchor("L");
        exerciseAnchor("f");
        exerciseAnchor("F");
        exerciseAnchor("junk");
        exerciseAnchor("bobL");

        char suffix = pickSuffix(data.consumeInt(0, 5));
        String a = data.consumeAsciiString(8);
        String b = data.consumeAsciiString(8);
        String c = data.consumeAsciiString(8);

        exerciseExploration(String.valueOf(suffix));
        exerciseExploration(a + suffix);
        exerciseExploration("-" + a + suffix);
        exerciseExploration(a + "." + b + suffix);
        exerciseExploration(a + "e" + b + suffix);
        exerciseExploration(a + "E" + b + suffix);
        exerciseExploration("0" + a + suffix);
        exerciseExploration(c);

        /* Contract/oracle:
         * For canonical base-10 integer strings, createNumber(String) must parse the same value
         * as the specific createLong/createInteger family member on the equivalent valid form.
         * A patch that merely blocks the crashing branch or silently changes semantics would break
         * this equivalence on valid inputs even if no exception is thrown.
         */
        int n = data.consumeInt(-1_000_000, 1_000_000);
        String canonical = Integer.toString(n);
        String withUpperL = canonical + "L";
        String withLowerL = canonical + "l";

        try {
            Number parsedUpper = NumberUtils.createNumber(withUpperL);
            Number parsedLower = NumberUtils.createNumber(withLowerL);
            Long expected = NumberUtils.createLong(canonical);
            Integer expectedInt = NumberUtils.createInteger(canonical);

            long upper = parsedUpper.longValue();
            long lower = parsedLower.longValue();
            long exp = expected.longValue();
            long expInt = expectedInt.longValue();

            if (upper != exp || lower != exp || upper != lower || exp != expInt) {
                throw new RuntimeException(
                    "[oracle:num-long-suffix] metamorphic violation: equivalent canonical integer parses disagree input="
                        + canonical + " upper=" + upper + " lower=" + lower + " createLong=" + exp
                        + " createInteger=" + expInt);
            }
        } catch (RuntimeException ignored) {
            if (isRootCause(ignored)) {
                throw ignored;
            }
            return;
        }
    }

    private static void exerciseAnchor(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void exerciseExploration(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e instanceof StringIndexOutOfBoundsException && isInCreateNumberPath(e) && isDefinitelyValid(input)) {
                throw e;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof StringIndexOutOfBoundsException && isInCreateNumberPath(t);
    }

    private static boolean isInCreateNumberPath(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String method = stack[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang.NumberUtils".equals(cls)
                && ("createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method))) {
                return true;
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isDefinitelyValid(String s) {
        if (s == null || s.length() < 2) {
            return false;
        }
        char last = s.charAt(s.length() - 1);
        if (last != 'l' && last != 'L') {
            return false;
        }
        String numeric = s.substring(0, s.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        int start = numeric.charAt(0) == '-' ? 1 : 0;
        if (start == numeric.length()) {
            return false;
        }
        for (int i = start; i < numeric.length(); i++) {
            if (!Character.isDigit(numeric.charAt(i))) {
                return false;
            }
        }
        return true;
    }

    private static char pickSuffix(int idx) {
        switch (idx) {
            case 0:
                return 'l';
            case 1:
                return 'L';
            case 2:
                return 'f';
            case 3:
                return 'F';
            case 4:
                return 'd';
            default:
                return 'D';
        }
    }
}
