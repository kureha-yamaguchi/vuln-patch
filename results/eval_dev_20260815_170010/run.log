    private static boolean isValidByConstruction(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        return series != null && start != null && end != null && start.compareTo(end) <= 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException
            || t instanceof IndexOutOfBoundsException
            || t instanceof ClassCastException
            || t instanceof NullPointerException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement el = trace[i];
            String cls = el.getClassName();
            String method = el.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void checkSeriesInternalCount(TimeSeries series) {
        int reported = series.getItemCount();
        List items = series.getItems();
        int independent = items.size();
        if (reported != independent) {
            throw new RuntimeException(
                "[oracle:itemcount] consistency violation: getItemCount()=" + reported
                    + " but getItems().size()=" + independent
            );
        }
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int firstIndexInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                return i;
            }
        }
        return -1;
    }

    private static int lastIndexInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        for (int i = series.getItemCount() - 1; i >= 0; i--) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                return i;
            }
        }
        return -1;
    }

    private static void checkCopyMatchesFilteredOriginal(
        TimeSeries original, TimeSeries copy, RegularTimePeriod start, RegularTimePeriod end) {

        int expectedIndex = 0;
        for (int i = 0; i < original.getItemCount(); i++) {
            RegularTimePeriod p = original.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                if (expectedIndex >= copy.getItemCount()) {
                    throw new RuntimeException(
                        "[oracle:filtered-order] metamorphic violation: copy ended early at expected index "
                            + expectedIndex
                    );
                }
                RegularTimePeriod copied = copy.getTimePeriod(expectedIndex);
                if (!p.equals(copied)) {
                    throw new RuntimeException(
                        "[oracle:filtered-order] metamorphic violation: copy differs from filtered original"
                            + " expectedPeriod=" + p + " actualPeriod=" + copied
                            + " atCopyIndex=" + expectedIndex
                    );
                }
                expectedIndex++;
            }
        }
        if (expectedIndex != copy.getItemCount()) {
            throw new RuntimeException(
                "[oracle:filtered-order] metamorphic violation: copy has extra items"
                    + " expectedCount=" + expectedIndex + " actualCount=" + copy.getItemCount()
            );
        }
    }

    private static String nonEmptyName(FuzzedDataProvider data) {
        String s = data.consumeAsciiString(16);
        if (s == null || s.length() == 0) {
            return "S";
        }
        return s;
    }

    private static int serial(int year, int month, int day) {
        return year * 372 + month * 31 + day;
    }

    private static Day dayFromSerial(int serial) {
        int year = serial / 372;
        int rem = serial % 372;
        if (rem <= 0) {
            rem += 372;
            year--;
        }
        int month = rem / 31;
        int day = rem % 31;
        if (day == 0) {
            day = 31;
            month--;
        }
        if (month <= 0) {
            month += 12;
            year--;
        }
        if (month > 12) {
            month = 12;
        }
        if (day < 1) {
            day = 1;
        } else if (day > 28) {
            day = 28;
        }
        if (year < 1900) {
            year = 1900;
        } else if (year > 9999) {
            year = 9999;
        }
        return new Day(day, month, year);
    }
}
