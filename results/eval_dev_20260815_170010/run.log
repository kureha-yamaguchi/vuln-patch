            String joinedEscaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(joined);
            String piecewise = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(left)
                + org.apache.commons.lang3.StringEscapeUtils.escapeCsv(right);
