package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.NodesSet;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException t) {
            if (isOracleFailure(t) || isRootCause(t)) {
                throw t;
            }
        }

        int scenarios = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < scenarios; i++) {
            try {
                runScenario(data);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isOracleFailure(t) || isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static void runAnchor() {
        PolygonsSet emptyLeaf = buildExplicitEmpty();
        PolygonsSet internalEmpty = buildInternalEmpty(0.0, 0.0, 1.0, 0.0);
        exerciseAndCrossCheck(emptyLeaf, internalEmpty, "anchor");
    }

    private static void runScenario(FuzzedDataProvider data) {
        double x1 = bounded(data.consumeInt());
        double y1 = bounded(data.consumeInt());
        double x2 = bounded(data.consumeInt());
        double y2 = bounded(data.consumeInt());

        if (x1 == x2 && y1 == y2) {
            x2 = x1 + 1.0;
        }

        if (data.consumeBoolean()) {
            x2 = x1 + signedNonZero(data.consumeInt(-1000, 1000));
        }
        if (data.consumeBoolean()) {
            y2 = y1 + signedNonZero(data.consumeInt(-1000, 1000));
        }

        PolygonsSet emptyLeaf = buildExplicitEmpty();
        PolygonsSet internalEmpty = buildInternalEmpty(x1, y1, x2, y2);
        exerciseAndCrossCheck(emptyLeaf, internalEmpty, "explore");
    }

    private static PolygonsSet buildExplicitEmpty() {
