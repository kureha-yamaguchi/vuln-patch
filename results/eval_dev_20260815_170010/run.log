package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact failing-test inputs first. These are valid strings containing one surrogate pair
        // and no CSV-special characters, so escapeCsv must leave them unchanged.
        checkEscapeCsvIdentity("\uD83D\uDE30", true);
        checkEscapeCsvIdentity("\uD800\uDC00", true);
        checkEscapeCsvIdentity("\uD834\uDD1E", true);
        checkEscapeCsvIdentity("\uDBFF\uDFFD", true);

        String fuzzed = buildValidNoCsvStringWithSurrogatePairs(data);
        checkEscapeCsvIdentity(fuzzed, true);

        // Additional exploration: concatenation of two independently valid safe strings is still valid and
        // still contains no CSV-special chars, so escapeCsv must also leave the concatenation unchanged.
        String left = buildValidNoCsvStringWithSurrogatePairs(data);
        String right = buildValidNoCsvStringWithSurrogatePairs(data);
        checkEscapeCsvIdentity(left + right, true);
    }

    private static void checkEscapeCsvIdentity(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle: CSV escaping only adds quoting/escaping when the input contains CSV special
            // characters (comma, quote, CR, LF). For strings we construct without those characters, a
