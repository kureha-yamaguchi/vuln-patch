package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            tryEscapeCsvIdentity(anchors[i], true);
        }

        String fuzzed = buildValidSafeCsvInput(data);
        tryEscapeCsvIdentity(fuzzed, true);

        String extra = data.consumeRemainingAsString();
        if (extra != null && extra.length() > 0) {
            String combined = insertOnlySafeAscii(fuzzed, extra);
            tryEscapeCsvIdentity(combined, true);
        }
    }

    /*
     * Contract/oracle asserted:
     * StringEscapeUtils.escapeCsv escapes CSV content. For inputs containing no CSV special
     * characters (comma, double quote, CR, LF), a correct implementation must leave the
     * content unchanged. The failing test demonstrates that valid surrogate pairs are such
     * accepted inputs and must be preserved exactly. A throw-deleting or branch-skipping patch
     * could avoid the crash but silently drop or alter characters; this identity check catches that.
     */
    private static void tryEscapeCsvIdentity(String input, boolean validByConstruction) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            if (validByConstruction && out != null && !out.equals(input)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidSafeCsvInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int leadingParts = data.consumeInt(0, 3);
        for (int i = 0; i < leadingParts; i++) {
            sb.append(safeAscii(data.consumeAsciiString(8)));
        }

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                sb.append(safeAscii(data.consumeAsciiString(6)));
            }
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(codePoint));
            if (data.consumeBoolean()) {
                sb.append(safeAscii(data.consumeAsciiString(6)));
            }
        }

        int trailingParts = data.consumeInt(0, 3);
        for (int i = 0; i < trailingParts; i++) {
            sb.append(safeAscii(data.consumeAsciiString(8)));
        }

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x10000));
        }
        return sb.toString();
    }

    private static String insertOnlySafeAscii(String base, String extra) {
        String safe = safeAscii(extra);
        if (safe.length() == 0) {
            return base;
        }
        return safe + base + safe;
    }

    private static String safeAscii(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                continue;
            }
            if (c >= 0x20 && c <= 0x7e) {
                sb.append(c);
            }
        }
        if (sb.length() == 0 && s.length() > 0) {
            sb.append('A');
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\\' || c == '"') {
                sb.append('\\').append(c);
            } else if (c >= 0x20 && c <= 0x7e) {
                sb.append(c);
            } else {
                sb.append("\\u");
                String hex = Integer.toHexString(c);
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
