            String method = ste.getMethodName();
            if ("translate".equals(method)
                && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildCsvSafeStringWithSurrogatePair(FuzzedDataProvider data) {
        String prefix = sanitizeCsvSafe(data.consumeString(8));
        String suffix = sanitizeCsvSafe(data.consumeString(8));

        int high = data.consumeInt(0xD800, 0xDBFF);
        int low = data.consumeInt(0xDC00, 0xDFFF);
        String pair = new String(new char[] { (char) high, (char) low });

        int mode = data.consumeInt(0, 2);
        String built;
        if (mode == 0) {
            built = pair + prefix + suffix;
        } else if (mode == 1) {
            built = prefix + pair + suffix;
        } else {
            built = prefix + suffix + pair;
        }

        if (built.length() == 0) {
            return pair;
        }
        return built;
    }

    private static String sanitizeCsvSafe(String s) {
        if (s == null || s.length() == 0) {
            return "A";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); ) {
            int cp = s.codePointAt(i);
            i += Character.charCount(cp);
            if (cp == ',' || cp == '"' || cp == '\r' || cp == '\n') {
                sb.append('X');
            } else if (Character.isHighSurrogate((char) cp) || Character.isLowSurrogate((char) cp)) {
                sb.append('Y');
            } else if (Character.isISOControl(cp)) {
                sb.append('Z');
            } else {
                sb.appendCodePoint(cp);
            }
        }
        if (sb.length() == 0) {
            sb.append('A');
        }
        return sb.toString();
    }

    private static boolean isCsvSafe(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static boolean hasValidSurrogatePair(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i + 1 < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i)) && Character.isLowSurrogate(s.charAt(i + 1))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '\\' && c != '"') {
                sb.append(c);
            } else {
                String hex = Integer.toHexString(c);
                sb.append("\\u");
                for (int p = hex.length(); p < 4; p++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
