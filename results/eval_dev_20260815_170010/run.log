package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            exerciseEscapeCsvIdentity(anchors[i], "anchor-" + i);
        }

        String exploratory = buildValidNoCsvStringWithSupplementaryCodePoints(data);
        exerciseEscapeCsvIdentity(exploratory, "explore");

        if (data.consumeBoolean()) {
            String left = buildValidNoCsvStringWithSupplementaryCodePoints(data);
            String right = buildValidNoCsvStringWithSupplementaryCodePoints(data);
            exerciseConcatenationIdentity(left, right);
        }
    }

    private static void exerciseEscapeCsvIdentity(String input, String tag) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            // Contract/post-condition used as oracle:
            // CSV escaping returns the input unchanged when it contains none of:
            // comma, double-quote, CR, or LF. We construct inputs by construction
            // from safe ASCII plus valid supplementary code points, so every correct
            // implementation must return exactly the original string. A patch that
            // merely suppresses the throw but skips/duplicates characters violates this.
            if (!input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve strings without CSV metacharacters input="
                        + printable(input) + " out=" + printable(out) + " tag=" + tag);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void exerciseConcatenationIdentity(String left, String right) {
        try {
            String whole = left + right;
            String outWhole = StringEscapeUtils.escapeCsv(whole);
            String outParts = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);

            // Same documented guarantee: when neither side contains CSV metacharacters,
            // escapeCsv is the identity on each operand and on their concatenation, so
            // escapeCsv(left + right) == escapeCsv(left) + escapeCsv(right) == left + right.
            if (!outWhole.equals(outParts)) {
                throw new RuntimeException("[oracle:csv-concat] metamorphic violation: identity/composition on safe CSV input left="
                        + printable(left) + " right=" + printable(right)
                        + " lhs=" + printable(outWhole) + " rhs=" + printable(outParts));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidNoCsvStringWithSupplementaryCodePoints(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        sb.append(sanitizeAscii(data.consumeAsciiString(8)));

        int pairs = data.consumeInt(1, 3);
        for (int i = 0; i < pairs; i++) {
            sb.append(sanitizeAscii(data.consumeAsciiString(4)));
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(codePoint));
            sb.append(sanitizeAscii(data.consumeAsciiString(4)));
        }

        sb.append(sanitizeAscii(data.consumeAsciiString(8)));

        if (sb.length() == 0) {
            sb.append("A");
            sb.append(Character.toChars(0x10000));
        }
        return sb.toString();
    }

    private static String sanitizeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append("\\u");
                        String hex = Integer.toHexString(c);
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
