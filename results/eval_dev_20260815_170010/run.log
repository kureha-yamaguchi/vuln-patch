                if ("createCopy".equals(m) || "getIndex".equals(m) || "clone".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static Day dayFromSerial(int serial) {
        return new Day(org.jfree.date.SerialDate.createInstance(serial));
    }

    private static void addOne(TimeSeries s, Day d, int v) {
        s.add(d, new Integer(v));
    }

    private static String nonEmptyName(FuzzedDataProvider data) {
        String s = data.consumeAsciiString(20);
        if (s == null || s.length() == 0) {
            return "S";
        }
        return s;
    }
