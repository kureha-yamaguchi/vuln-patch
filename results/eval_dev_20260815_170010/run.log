package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        safeCreateNumber("1234.5");

        safeCreateNumber("1eE");

        String malformed = buildBoundaryMalformed(data);
        safeCreateNumber(malformed);

        String anotherMalformed = buildDualExponentMalformed(data);
        safeCreateNumber(anotherMalformed);

        checkLongSuffixAgreement(data);
        checkBigIntegerSuffixAgreement(data);
    }

    private static void safeCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isKnownRootCauseInPatchedRegion(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCauseInPatchedRegion(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String buildBoundaryMalformed(FuzzedDataProvider data) {
        String base = digitsOnly(data.consumeInt(1, 12));
        if (data.consumeBoolean()) {
            base = "-" + base;
        }
        return base + (data.consumeBoolean() ? "e" : "E");
    }

    private static String buildDualExponentMalformed(FuzzedDataProvider data) {
        String left = digitsOnly(data.consumeInt(1, 8));
        String mid = data.consumeBoolean() ? "eE" : "Ee";
        String right = data.consumeAsciiString(data.consumeInt(0, 2));
        if (data.consumeBoolean()) {
            left = "-" + left;
        }
        return left + mid + right;
    }

    private static String digitsOnly(int len) {
        StringBuilder sb = new StringBuilder(len);
        sb.append('1');
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + (i % 10)));
        }
        return sb.toString();
    }

    private static void checkLongSuffixAgreement(FuzzedDataProvider data) {
        long delta = data.consumeInt(1, 1_000_000);
        long n = data.consumeBoolean()
                ? ((long) Integer.MAX_VALUE + delta)
                : ((long) Integer.MIN_VALUE - delta);
        String plain = Long.toString(n);
        String suffixed = plain + (data.consumeBoolean() ? "L" : "l");

        Number parsedPlain;
        Number parsedSuffixed;
        Long viaLong;
        try {
            parsedPlain = NumberUtils.createNumber(plain);
            parsedSuffixed = NumberUtils.createNumber(suffixed);
            viaLong = NumberUtils.createLong(plain);
        } catch (RuntimeException t) {
            return;
        }
        if (parsedPlain == null || parsedSuffixed == null || viaLong == null) {
            return;
        }

        long a = parsedPlain.longValue();
        long b = parsedSuffixed.longValue();
        long c = viaLong.longValue();

        if (a != c || b != c) {
            throw new RuntimeException(
                    "[oracle:long-suffix] metamorphic violation: canonical long string and explicit long suffix must denote the same numeric value"
                            + " input=" + plain
                            + " plain=" + parsedPlain + "/" + parsedPlain.getClass().getName()
                            + " suffixed=" + parsedSuffixed + "/" + parsedSuffixed.getClass().getName()
                            + " createLong=" + viaLong);
        }
    }

    private static void checkBigIntegerSuffixAgreement(FuzzedDataProvider data) {
        int digits = data.consumeInt(19, 40);
        StringBuilder sb = new StringBuilder(digits + 1);
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < digits; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        String numeric = sb.toString();
        String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");

        Number parsed;
        BigInteger expected;
        try {
            parsed = NumberUtils.createNumber(suffixed);
            expected = NumberUtils.createBigInteger(numeric);
        } catch (RuntimeException t) {
            return;
        }
        if (parsed == null || expected == null) {
            return;
        }

        BigInteger actual;
        if (parsed instanceof BigInteger) {
            actual = (BigInteger) parsed;
        } else {
            actual = new BigInteger(parsed.toString());
        }

        if (!expected.equals(actual)) {
            throw new RuntimeException(
                    "[oracle:bigint-suffix] metamorphic violation: oversized integer with L suffix must agree with createBigInteger after long overflow fallback"
                            + " input=" + suffixed
                            + " parsed=" + parsed + "/" + parsed.getClass().getName()
                            + " expected=" + expected);
        }
    }
}
