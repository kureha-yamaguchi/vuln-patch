        if (data.consumeBoolean()) {
            out[15] = 1.0d - data.consumeInt(1, 5000) / 1000000.0;
        }

        return out;
    }

    private static boolean isPlausiblyValid(double[] coords) {
        for (int i = 0; i < coords.length; i++) {
            double v = coords[i];
            if (Double.isNaN(v) || Double.isInfinite(v) || v < -10.0 || v > 10.0) {
                return false;
            }
        }

        for (int i = 0; i < INDICES.length; i += 3) {
