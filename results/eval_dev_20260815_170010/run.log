package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        safeCreateNumber("1234.5", false);
        safeCreateNumber("1eE", true);

        String explored = buildBothExponentInput(data);
        safeCreateNumber(explored, false);

        checkIntHelperConsistency(data);
        checkDecimalHelperConsistency(data);
        checkExponentCaseMetamorphic(data);
    }

    private static void safeCreateNumber(String s, boolean propagateKnownRootCause) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (propagateKnownRootCause && isKnownRootCauseFromCreateNumber(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.math.NumberUtils".equals(ste.getClassName())
                    && "createNumber".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildBothExponentInput(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        int left = data.consumeInt(1, 9999);
        String middle = data.consumeAsciiString(8);
        if (middle.indexOf('.') >= 0) {
            middle = middle.replace(".", "");
        }
        if (middle.length() == 0) {
            middle = data.consumeBoolean() ? "+" : "0";
        }
        boolean firstLower = data.consumeBoolean();
        boolean secondAtEnd = data.consumeBoolean();
        String first = firstLower ? "e" : "E";
        String second = firstLower ? "E" : "e";
        if (secondAtEnd) {
            return sign + left + first + middle + second;
        }
        int tail = data.consumeInt(0, 999);
        return sign + left + first + middle + second + tail;
    }

    private static void checkIntHelperConsistency(FuzzedDataProvider data) {
        int n = data.consumeInt(-1000000, 1000000);
        String s = Integer.toString(n);
        try {
            Number parsed = NumberUtils.createNumber(s);
            Integer helper = NumberUtils.createInteger(s);
            if (parsed == null || helper == null) {
                return;
            }
            if (!(parsed instanceof Integer) || parsed.intValue() != helper.intValue()) {
                throw new RuntimeException("[oracle:int-helper] metamorphic violation: createNumber/createInteger disagree input="
                        + s + " lhs=" + parsed + " rhs=" + helper);
            }
        } catch (RuntimeException t) {
            if (isKnownRootCauseFromCreateNumber(t)) {
                throw t;
            }
        }
    }

    private static void checkDecimalHelperConsistency(FuzzedDataProvider data) {
        int whole = data.consumeInt(-100000, 100000);
        String s = Integer.toString(whole) + ".0";
        try {
            Number parsed = NumberUtils.createNumber(s);
            Float helper = NumberUtils.createFloat(s);
            if (parsed == null || helper == null) {
                return;
            }
            if (!(parsed instanceof Float) || Float.compare(parsed.floatValue(), helper.floatValue()) != 0) {
                throw new RuntimeException("[oracle:decimal-helper] metamorphic violation: createNumber/createFloat disagree input="
                        + s + " lhs=" + parsed + " rhs=" + helper);
            }
        } catch (RuntimeException t) {
            if (isKnownRootCauseFromCreateNumber(t)) {
                throw t;
            }
        }
    }

    private static void checkExponentCaseMetamorphic(FuzzedDataProvider data) {
        int mantissa = data.consumeInt(1, 100);
        int exponent = data.consumeInt(0, 4);
        String sign = data.consumeBoolean() ? "-" : "";
        String lower = sign + mantissa + "e" + exponent;
        String upper = sign + mantissa + "E" + exponent;

        try {
            Number a = NumberUtils.createNumber(lower);
            Number b = NumberUtils.createNumber(upper);
            if (a == null || b == null) {
                return;
            }
            if (Double.compare(a.doubleValue(), b.doubleValue()) != 0) {
                throw new RuntimeException("[oracle:exp-case] metamorphic violation: exponent-case equivalent inputs disagree input="
                        + lower + "/" + upper + " lhs=" + a + " rhs=" + b);
            }
        } catch (RuntimeException t) {
            if (isKnownRootCauseFromCreateNumber(t)) {
                throw t;
            }
        }
    }
