package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsvIdentity(s, true);
        }

        String fuzzed = buildValidSafeCsvStringWithSurrogates(data);
        if (fuzzed != null) {
            exerciseEscapeCsvIdentity(fuzzed, true);
        }

        if (data.consumeBoolean()) {
            String maybeInvalid = buildPossiblyInvalidString(data);
            exerciseEscapeCsvIdentity(maybeInvalid, false);
        }
    }

    private static void exerciseEscapeCsvIdentity(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle: CSV escaping only adds quoting/escaping when CSV special characters
             * are present. For inputs built here by construction, we exclude comma, quote, CR, and LF,
             * so a correct implementation must leave the string unchanged. The failing test itself
             * asserts this for surrogate-pair-only inputs; this catches a throw-deleting patch that
             * silently drops/duplicates code units instead of crashing.
             */
            if (validByConstruction && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for CSV-safe input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidSafeCsvStringWithSurrogates(FuzzedDataProvider data) {
        int pairCount = data.consumeInt(1, 6);
        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int middleChunks = data.consumeInt(0, 6);

        StringBuilder sb = new StringBuilder();
        appendSafeAscii(sb, data, prefixLen);

        for (int i = 0; i < pairCount; i++) {
            appendValidSurrogatePair(sb, data);
            if (i < middleChunks) {
                appendSafeAscii(sb, data, data.consumeInt(0, 4));
            }
        }

        appendSafeAscii(sb, data, suffixLen);
        return sb.toString();
    }

    private static String buildPossiblyInvalidString(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 20);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int choice = data.consumeInt(0, 4);
            char ch;
            switch (choice) {
                case 0:
                    ch = (char) data.consumeInt(0x20, 0x7e);
                    break;
                case 1:
                    ch = (char) data.consumeInt(0xD800, 0xDBFF);
                    break;
                case 2:
                    ch = (char) data.consumeInt(0xDC00, 0xDFFF);
                    break;
                default:
                    ch = (char) data.consumeInt(0, 0xFFFF);
                    break;
            }
            sb.append(ch);
        }
        return sb.toString();
    }

    private static void appendValidSurrogatePair(StringBuilder sb, FuzzedDataProvider data) {
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        sb.append(Character.toChars(cp));
    }

    private static void appendSafeAscii(StringBuilder sb, FuzzedDataProvider data, int len) {
        for (int i = 0; i < len; i++) {
            sb.append(randomSafeCsvChar(data));
        }
    }

    private static char randomSafeCsvChar(FuzzedDataProvider data) {
        while (true) {
            char c = (char) data.consumeInt(0x20, 0x7e);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                return c;
            }
        }
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
