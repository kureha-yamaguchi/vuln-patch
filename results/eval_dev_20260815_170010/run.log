    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1234.5");

        String candidate = buildDecimalLikeInput(data);
        try {
            NumberUtils.createNumber(candidate);
        } catch (IllegalArgumentException ignored) {
        }

        checkLongSuffixMetamorphic(data);
        checkBigIntegerFallbackMetamorphic(data);
    }

    private static String buildDecimalLikeInput(FuzzedDataProvider data) {
        int leftLen = data.consumeInt(1, 8);
        int rightLen = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder(leftLen + rightLen + 3);
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(nonZeroDigit());
        for (int i = 1; i < leftLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        sb.append('.');
        for (int i = 0; i < rightLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }

        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            sb.append('e');
        } else if (mode == 1) {
            sb.append('E');
        } else if (mode == 2) {
            sb.append(data.consumeBoolean() ? 'F' : 'D');
        }
        return sb.toString();
    }

    private static char nonZeroDigit() {
        return '1';
    }

    private static void checkLongSuffixMetamorphic(FuzzedDataProvider data) {
        long base = data.consumeInt(-1_000_000, 1_000_000);
        String plain = Long.toString(base);
        String suffixed = plain + (data.consumeBoolean() ? "L" : "l");

        Number plainParsed;
        Number suffixedParsed;
        Long directLong;
        try {
            plainParsed = NumberUtils.createNumber(plain);
            suffixedParsed = NumberUtils.createNumber(suffixed);
            directLong = NumberUtils.createLong(plain);
        } catch (RuntimeException ignored) {
