    private static int safeGetIndex(TimeSeries s, RegularTimePeriod p) {
        try {
            return s.getIndex(p);
        } catch (RuntimeException e) {
            return Integer.MIN_VALUE;
        }
    }

    private static Day advanceDay(Day day, int steps) {
        RegularTimePeriod p = day;
        for (int i = 0; i < steps; i++) {
            p = p.next();
            if (!(p instanceof Day)) {
                return null;
            }
        }
        return (Day) p;
    }

    private static int daysBetweenExclusive(Day left, Day right) {
        int count = 0;
        RegularTimePeriod p = left;
        while (true) {
            p = p.next();
            if (!(p instanceof Day)) {
                return -1;
            }
            if (p.equals(right)) {
                return count;
            }
            count++;
            if (count > 400) {
                return -1;
            }
        }
    }

    private static boolean isValidByConstructionRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        return isInCreateCopyRegion(t);
    }

    private static boolean isInCreateCopyRegion(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
