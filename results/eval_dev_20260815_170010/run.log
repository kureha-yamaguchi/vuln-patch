package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), 1);
            s.add(new Day(31, 1, 2006), 1);
        } catch (RuntimeException e) {
            return;
        }
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        assertEmptyGapCopy(s, start, end, "anchor");
    }

    private static void runExplore(FuzzedDataProvider data) {
        int month = data.consumeInt(1, 12);
        int year = data.consumeInt(1995, 2010);

        int desiredCount = data.consumeInt(3, 8);
        int[] days = new int[desiredCount];
        int count = 0;

        int current = data.consumeInt(1, 3);
        while (count < desiredCount && current <= 28) {
            days[count++] = current;
            current += data.consumeInt(2, 5);
        }
        if (count < 3) {
            return;
        }

        TimeSeries s = new TimeSeries("Fuzz", Day.class);
        for (int i = 0; i < count; i++) {
            try {
                s.add(new Day(days[i], month, year), i + 1);
            } catch (RuntimeException e) {
                return;
            }
        }

        int gapSlot = data.consumeInt(1, count - 1);
        int leftDay = days[gapSlot - 1];
        int rightDay = days[gapSlot];
        int gap = rightDay - leftDay - 1;
        if (gap <= 0) {
            return;
        }

        int startOffset = data.consumeInt(1, gap);
        int endOffset = data.consumeInt(startOffset, gap);
        Day start = new Day(leftDay + startOffset, month, year);
        Day end = new Day(leftDay + endOffset, month, year);
        assertEmptyGapCopy(s, start, end, "gap-main");

        if (gap >= 2) {
            int innerStartOffset = data.consumeInt(1, gap);
            int innerEndOffset = data.consumeInt(innerStartOffset, gap);
            Day start2 = new Day(leftDay + innerStartOffset, month, year);
            Day end2 = new Day(leftDay + innerEndOffset, month, year);
            assertEquivalentEmptyCopies(s, start, end, start2, end2);
        }

        if (gapSlot + 1 < count) {
            int nextLeft = days[gapSlot];
            int nextRight = days[gapSlot + 1];
            int nextGap = nextRight - nextLeft - 1;
            if (nextGap > 0) {
                int sOff = data.consumeInt(1, nextGap);
                int eOff = data.consumeInt(sOff, nextGap);
                Day start3 = new Day(nextLeft + sOff, month, year);
                Day end3 = new Day(nextLeft + eOff, month, year);
                assertEmptyGapCopy(s, start3, end3, "gap-next");
            }
        }
    }

    private static void assertEmptyGapCopy(TimeSeries s, Day start, Day end, String tag) {
        TimeSeries copy;
        try {
            copy = s.createCopy(start, end);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:gap-boundary] valid empty-gap interval threw for " + tag
                        + " start=" + start + " end=" + end, e);
            }
            return;
        }

        int count = copy.getItemCount();
        int itemsSize = copy.getItems().size();
        if (count != 0 || itemsSize != 0) {
            throw new RuntimeException("[oracle:gap-boundary] empty-gap copy not empty for " + tag
                    + " start=" + start + " end=" + end
                    + " itemCount=" + count + " itemsSize=" + itemsSize);
        }

        int startIndex = copy.getIndex(start);
        int endIndex = copy.getIndex(end);
        if (startIndex != -1 || endIndex != -1) {
            throw new RuntimeException("[oracle:empty-copy-index] empty copy should not contain probed periods for "
                    + tag + " startIndex=" + startIndex + " endIndex=" + endIndex
                    + " start=" + start + " end=" + end);
        }
    }

    private static void assertEquivalentEmptyCopies(TimeSeries s, Day start1, Day end1, Day start2, Day end2) {
        TimeSeries c1;
        TimeSeries c2;
        try {
            c1 = s.createCopy(start1, end1);
            c2 = s.createCopy(start2, end2);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException("[oracle:gap-equivalent] valid empty-gap interval threw while comparing equivalent gaps", e);
            }
            return;
        }

        int c1Count = c1.getItemCount();
        int c2Count = c2.getItemCount();
        int c1Items = c1.getItems().size();
        int c2Items = c2.getItems().size();
        if (c1Count != 0 || c2Count != 0 || c1Items != 0 || c2Items != 0) {
            throw new RuntimeException("[oracle:gap-equivalent] two intervals fully inside gaps should both yield empty copies"
                    + " first=(" + start1 + "," + end1 + ") count=" + c1Count + "/" + c1Items
                    + " second=(" + start2 + "," + end2 + ") count=" + c2Count + "/" + c2Items);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
