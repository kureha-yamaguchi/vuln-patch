                throw t;
            }
        }
    }

    private static int manualInclusiveCount(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        List items = s.getItems();
        for (int i = 0; i < items.size(); i++) {
            TimeSeriesDataItem item = (TimeSeriesDataItem) items.get(i);
            RegularTimePeriod p = item.getPeriod();
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int firstIncludedIndex(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                return i;
            }
        }
        return -1;
    }

    private static int lastIncludedIndex(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        for (int i = s.getItemCount() - 1; i >= 0; i--) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                return i;
            }
        }
        return -1;
    }

