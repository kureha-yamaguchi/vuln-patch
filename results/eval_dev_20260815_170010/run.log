package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runValidCase("\uD83D\uDE30");
        runValidCase("\uD800\uDC00");
        runValidCase("\uD834\uDD1E");
        runValidCase("\uDBFF\uDFFD");

        String prefix = sanitizeSafeCsv(data.consumeAsciiString(16));
        String suffix = sanitizeSafeCsv(data.consumeAsciiString(16));
        int extraPairs = data.consumeInt(0, 4);

        StringBuilder sb = new StringBuilder(prefix.length() + suffix.length() + 2 * (extraPairs + 1));
        sb.append(prefix);
        sb.append(validSupplementaryPair(data));
        for (int i = 0; i < extraPairs; i++) {
            if (data.consumeBoolean()) {
                sb.append(sanitizeSafeCsv(data.consumeAsciiString(8)));
            }
            sb.append(validSupplementaryPair(data));
        }
        sb.append(suffix);

        runValidCase(sb.toString());
    }

    private static void runValidCase(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);
            /*
             * Contract/oracle: CSV escaping only adds quoting/escaping when required by CSV syntax.
             * For strings we build from safe ASCII plus valid surrogate pairs, with no comma, quote,
             * CR, or LF, a correct implementation must return the input unchanged. A "fix" that merely
             * suppresses the crash or skips characters would violate this observable post-condition.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: safe CSV input must remain unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("validation") || name.contains("invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
