    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String n = cur.getClass().getName();
            if (n != null) {
                String lower = n.toLowerCase();
                if (lower.contains("invalid") || lower.contains("malformed") || lower.contains("format")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t, String input, boolean validByConstruction) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        if (!validByConstruction || input == null || !isCsvSafe(input) || !hasValidSurrogatePair(input)) {
