package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));
            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);
            exerciseAndCheck(s, start, end, true);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Exception e) {
            return;
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        TimeSeries s = new TimeSeries(nonEmptyName(data));

        int itemCount = data.consumeInt(2, 12);
        int baseSerial = data.consumeInt(730000, 740000);
        int gapIndex = data.consumeInt(0, itemCount - 2);

        int serial = baseSerial;
        Day gapStartBound = null;
        Day gapEndBound = null;

        try {
            for (int i = 0; i < itemCount; i++) {
                int stepMin = (i == gapIndex + 1) ? 3 : 1;
                int stepMax = (i == gapIndex + 1) ? 20 : 8;
                serial += data.consumeInt(stepMin, stepMax);
                Day d = dayFromSerial(serial);
                addOne(s, d, i + 1);

                if (i == gapIndex) {
                    gapStartBound = d;
                } else if (i == gapIndex + 1) {
                    gapEndBound = d;
                }
            }
        } catch (RuntimeException t) {
            return;
        } catch (Exception e) {
            return;
        }

        if (gapStartBound == null || gapEndBound == null) {
            return;
        }

        int left = gapStartBound.getSerialDate().toSerial();
        int right = gapEndBound.getSerialDate().toSerial();
        if (right - left < 3) {
            return;
        }

        int startSerial = data.consumeInt(left + 1, right - 1);
        int endSerial = data.consumeInt(startSerial, right - 1);

        Day start = dayFromSerial(startSerial);
        Day end = dayFromSerial(endSerial);

        try {
            exerciseAndCheck(s, start, end, true);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Exception e) {
            return;
        }

        if (data.consumeBoolean()) {
            Day exactStart = dayFromSerial(left);
            Day exactEnd = dayFromSerial(right);
            try {
                exerciseAndCheck(s, exactStart, exactEnd, true);
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
            } catch (Exception e) {
                return;
            }
        }

        if (data.consumeBoolean()) {
            int widenedStartSerial = Math.max(baseSerial - 5, left - data.consumeInt(0, 3));
            int widenedEndSerial = right + data.consumeInt(0, 3);
            Day widenedStart = dayFromSerial(widenedStartSerial);
            Day widenedEnd = dayFromSerial(widenedEndSerial);
            if (widenedStart.compareTo(widenedEnd) <= 0) {
                try {
                    exerciseAndCheck(s, widenedStart, widenedEnd, true);
                } catch (RuntimeException t) {
                    if (isRootCause(t)) {
                        throw t;
                    }
                } catch (Exception e) {
                    return;
                }
            }
        }
    }

    private static void exerciseAndCheck(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end, boolean validByConstruction)
            throws CloneNotSupportedException {
        int expected = manualInclusiveCount(s, start, end);

        try {
            TimeSeries copy = s.createCopy(start, end);

            int reportedCount = copy.getItemCount();
            int listCount = copy.getItems().size();
            if (reportedCount != listCount) {
                throw new RuntimeException("[oracle:itemcount-items] metamorphic violation: copy getItemCount disagrees with getItems().size() reported="
                        + reportedCount + " itemsSize=" + listCount);
            }

            if (reportedCount != expected) {
