        while (sb.length() < 3) {
            char fill = (char) ('a' + ((salt + sb.length()) % 26));
            sb.append(fill);
        }
        if (sb.length() > 3) {
            sb.setLength(3);
        }
        char ch0 = sb.charAt(0);
        if (ch0 == 'y' || ch0 == 'Y') {
            sb.setCharAt(0, 'o');
        }
        return sb.toString();
    }

    private static String randomizeCase(String base, FuzzedDataProvider data) {
