import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test first.
        exerciseTarget("off");

        // Additional literals from the same failing test / observed failures to keep the real path hot.
        exerciseTarget("oof");
        exerciseTarget("yep");
        exerciseTarget("tru");

        // EXPLORE: the patched line is in the length-3 switch arm, so fuzz many real 3-char strings.
        String three = buildThreeCharString(data);
        exerciseTarget(three);

        // Bias toward the fall-through region with many different first characters and payloads.
        char first;
        switch (data.consumeInt(0, 5)) {
            case 0:
                first = 't';
                break;
            case 1:
                first = 'T';
                break;
            case 2:
                first = 'o';
                break;
            case 3:
                first = 'x';
                break;
            case 4:
                first = 'y';
                break;
            default:
                first = 'Y';
                break;
        }
        String tail = data.consumeAsciiString(2);
        while (tail.length() < 2) {
            tail = tail + "a";
        }
        exerciseTarget(new String(new char[] { first, tail.charAt(0), tail.charAt(1) }));

        // More varied inputs through the same public API.
        exerciseTarget(data.consumeAsciiString(8));
        exerciseTarget(data.consumeString(8));
        if (data.consumeBoolean()) {
            exerciseTarget(null);
        }

        // ORACLE: the method is documented/tested to accept the recognized literals
        // "true"/"on"/"yes" as true and "false"/"off"/"no" as false, case-insensitively.
        // A patch that merely suppresses the crash by returning false from the whole 3-char arm
        // would break the observable contract for valid inputs such as "yes"/"YES".
        checkRecognizedLiteralOracle(data, true);
        checkRecognizedLiteralOracle(data, false);
    }

    private static void exerciseTarget(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkRecognizedLiteralOracle(FuzzedDataProvider data, boolean expected) {
        String base;
        if (expected) {
            switch (data.consumeInt(0, 2)) {
                case 0:
                    base = "true";
                    break;
                case 1:
                    base = "on";
                    break;
                default:
                    base = "yes";
                    break;
            }
        } else {
            switch (data.consumeInt(0, 2)) {
                case 0:
                    base = "false";
                    break;
                case 1:
                    base = "off";
                    break;
                default:
                    base = "no";
                    break;
            }
        }

        String variant = randomizeCase(base, data);
        String upper = variant == null ? null : variant.toUpperCase();

        boolean lhs;
        boolean rhs;
        try {
            lhs = BooleanUtils.toBoolean(variant);
            rhs = BooleanUtils.toBoolean(upper);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (lhs != expected) {
            throw new RuntimeException(
                "[oracle:recognized-literal] metamorphic violation: constructed recognized literal parsed to wrong value input="
                    + String.valueOf(variant) + " expected=" + expected + " actual=" + lhs);
        }
        if (rhs != expected) {
            throw new RuntimeException(
                "[oracle:recognized-literal] metamorphic violation: uppercase recognized literal parsed to wrong value input="
                    + String.valueOf(upper) + " expected=" + expected + " actual=" + rhs);
        }
        if (lhs != rhs) {
            throw new RuntimeException(
                "[oracle:recognized-literal] metamorphic violation: case-insensitive equivalents disagree input="
                    + String.valueOf(variant) + " upper=" + String.valueOf(upper) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static String buildThreeCharString(FuzzedDataProvider data) {
        String s = data.consumeAsciiString(3);
        if (s.length() >= 3) {
            return s.substring(0, 3);
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < 3) {
            int v = data.consumeInt(0, 25);
            sb.append((char) ('a' + v));
        }
        return sb.toString();
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        if (s == null) {
            return null;
        }
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
