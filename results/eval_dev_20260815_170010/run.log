import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    private static final int[] INDICES = {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    private static final double[] ANCHOR_COORDS = {
        1.000000d, -1.000000d, -1.000000d,
        1.000000d, -1.000000d,  1.000000d,
       -1.000000d, -1.000000d,  1.000000d,
       -1.000000d, -1.000000d, -1.000000d,
        1.000000d,  1.000000d, -1.000000d,
        0.999999d,  1.000000d,  1.000000d,
       -1.000000d,  1.000000d,  1.000000d,
       -1.000000d,  1.000000d, -1.000000d
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runScenario(ANCHOR_COORDS, true);

        int variants = data.consumeInt(1, 3);
        for (int i = 0; i < variants; i++) {
            double[] coords = mutateAnchor(data);
            runScenario(coords, false);
        }
    }

    private static void runScenario(double[] coords, boolean anchor) {
        if (!isPlausiblyValid(coords)) {
            return;
        }

        PolyhedronsSet forward;
        try {
            forward = buildPolyhedron(coords, false);
        } catch (Throwable t) {
            handleThrowable(t, false);
            return;
        }

        final double sizeForward;
        final Vector3D baryForward;
        try {
            sizeForward = forward.getSize();
            baryForward = (Vector3D) forward.getBarycenter();
        } catch (Throwable t) {
            handleThrowable(t, anchor);
            return;
        }

        PolyhedronsSet reversed;
        try {
            reversed = buildPolyhedron(coords, true);
        } catch (Throwable t) {
            handleThrowable(t, false);
            return;
        }

        final double sizeReversed;
        final Vector3D baryReversed;
        try {
            sizeReversed = reversed.getSize();
            baryReversed = (Vector3D) reversed.getBarycenter();
        } catch (Throwable t) {
            handleThrowable(t, anchor);
            return;
        }

        /*
         * Contract/oracle:
         * The same closed polyhedron boundary described by the same facets in a different
         * collection order is an equivalent input and must denote the same region.
         * Therefore getSize() and getBarycenter() must agree for forward vs reversed facet order.
         * A throw-deleting or branch-skipping patch could stop the known ClassCastException yet still
         * compute inconsistent geometry depending on traversal/build order; this oracle catches that.
         */
        if (!sameDouble(sizeForward, sizeReversed, 1.0e-9)) {
            throw new RuntimeException(
                "[oracle:facet-order-size] metamorphic violation: equivalent facet orders differ"
                    + " sizeForward=" + sizeForward
                    + " sizeReversed=" + sizeReversed);
        }

        if (!sameVector(baryForward, baryReversed, 1.0e-9)) {
            throw new RuntimeException(
                "[oracle:facet-order-bary] metamorphic violation: equivalent facet orders differ"
                    + " baryForward=" + baryForward
                    + " baryReversed=" + baryReversed);
        }
    }

    private static PolyhedronsSet buildPolyhedron(double[] coords, boolean reverseOrder) {
        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        if (!reverseOrder) {
            for (int i = 0; i < INDICES.length; i += 3) {
                facets.add(buildFacet(coords, INDICES[i], INDICES[i + 1], INDICES[i + 2]));
            }
        } else {
            for (int i = INDICES.length - 3; i >= 0; i -= 3) {
                facets.add(buildFacet(coords, INDICES[i], INDICES[i + 1], INDICES[i + 2]));
            }
        }
        return new PolyhedronsSet(facets);
    }

    private static SubHyperplane<Euclidean3D> buildFacet(double[] coords, int a, int b, int c) {
        Vector3D v1 = vertex(coords, a);
        Vector3D v2 = vertex(coords, b);
        Vector3D v3 = vertex(coords, c);

        Plane plane = new Plane(v1, v2, v3);
        Vector2D p1 = plane.toSubSpace(v1);
        Vector2D p2 = plane.toSubSpace(v2);
        Vector2D p3 = plane.toSubSpace(v3);

        PolygonsSet triangle = new PolygonsSet(p1, p2, p3);

        Vector2D[][] vertices = triangle.getVertices();
        if (vertices == null) {
            throw new RuntimeException("[oracle:triangle-vertices] metamorphic violation: null vertices");
        }

        return new SubPlane(plane, triangle);
    }

    private static Vector3D vertex(double[] coords, int index) {
        int base = index * 3;
        return new Vector3D(coords[base], coords[base + 1], coords[base + 2]);
    }

