package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runIdentityCase("\uD83D\uDE30");
        runIdentityCase("\uD800\uDC00");
        runIdentityCase("\uD834\uDD1E");
        runIdentityCase("\uDBFF\uDFFD");

        String explored = buildWellFormedNoCsvStringWithSupplementary(data);
        runIdentityCase(explored);

        if (data.consumeBoolean()) {
            String explored2 = buildConcatenatedWellFormedNoCsvStringWithSupplementary(data);
            runIdentityCase(explored2);
        }
    }

    private static void runIdentityCase(String input) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            /*
             * Contract/oracle: for inputs that contain no CSV-special characters
             * (comma, quote, CR, LF), CSV escaping must leave the string unchanged.
             * We construct such inputs by construction, including well-formed surrogate
             * pairs, so a correct implementation must return the original string.
             * A patch that merely suppresses the crash but skips/mangles translation
             * would violate this observable post-condition.
             */
            if (!input.equals(out)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && t.getMessage() != null
                    && t.getMessage().startsWith("[oracle:csv-identity]")) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t) && isValidByConstruction(input)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        if (containsCsvSpecial(s)) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                i++;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            }
        }
        return true;
    }

    private static boolean containsCsvSpecial(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static String buildWellFormedNoCsvStringWithSupplementary(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8))));
        int pairs = data.consumeInt(1, 4);
        for (int i = 0; i < pairs; i++) {
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 6))));
            }
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 6))));
            }
        }
        if (sb.length() == 0) {
            sb.append("A");
            sb.append(Character.toChars(0x1F630));
        }
        return sb.toString();
    }

    private static String buildConcatenatedWellFormedNoCsvStringWithSupplementary(FuzzedDataProvider data) {
        String left = buildWellFormedNoCsvStringWithSupplementary(data);
        String mid = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8)));
        String right = buildWellFormedNoCsvStringWithSupplementary(data);
        return left + mid + right;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
