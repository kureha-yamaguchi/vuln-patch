package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract/oracle used below:
         * - BooleanUtils.toBoolean(String) is a case-insensitive parser for the true tokens
         *   "true", "on", and "yes"; other strings return false (as exercised by the real test:
         *   "off", "oof", "yep", "trux", "false", "a" -> false; many case variants of "true" -> true).
         * - Therefore:
         *   1) The anchor input "off" must return false and must not throw.
         *   2) Any 3-char string whose first character is neither 'y'/'Y' nor a 4-char true token
         *      cannot match a true literal; it must therefore return false.
         *   3) Mixed-case variants of known true tokens must agree with their canonical form.
         * These checks catch both the ground-truth crash and throw-deleting / wrong-result patches.
         */

        Boolean anchor = parseOrSkip("off");
        if (anchor != null && anchor.booleanValue()) {
            throw new RuntimeException("[oracle:anchor-false] metamorphic violation: anchor input must parse as false input=off lhs=true rhs=false");
        }

        for (int i = 0; i < 4; i++) {
            String candidate = buildThreeCharNonYesPrefix(data, i);
            Boolean parsed = parseOrSkip(candidate);
            if (parsed != null && parsed.booleanValue()) {
                throw new RuntimeException(
                    "[oracle:nontrue-false] metamorphic violation: non-matching 3-char input must parse as false input="
                        + quote(candidate) + " lhs=true rhs=false");
            }
        }

        String canonical;
        switch (Math.floorMod(data.consumeInt(), 3)) {
            case 0:
                canonical = "true";
                break;
            case 1:
                canonical = "yes";
                break;
            default:
                canonical = "on";
                break;
        }

        String variant = randomCase(data, canonical);
        Boolean lhs = parseOrSkip(variant);
        Boolean rhs = parseOrSkip(canonical);
        if (lhs != null && rhs != null) {
            if (lhs.booleanValue() != rhs.booleanValue() || !lhs.booleanValue()) {
                throw new RuntimeException(
                    "[oracle:case-agree] metamorphic violation: case-insensitive true token disagreement input="
                        + quote(variant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        }
    }

    private static Boolean parseOrSkip(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return null;
            }
            return null;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildThreeCharNonYesPrefix(FuzzedDataProvider data, int mode) {
        String base;
        switch (mode) {
            case 0:
                base = data.consumeAsciiString(3);
                break;
            case 1:
                base = data.consumeString(8);
                break;
            case 2:
                base = new String(data.consumeBytes(3));
                break;
            default:
                base = data.consumeRemainingAsString();
                break;
        }

        char c0 = charAtOr(base, 0, fromByte(data.consumeByte()));
        char c1 = charAtOr(base, 1, fromByte(data.consumeByte()));
        char c2 = charAtOr(base, 2, fromByte(data.consumeByte()));

        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'x';
        }
        return new String(new char[] { c0, c1, c2 });
    }

    private static char charAtOr(String s, int idx, char dflt) {
        return s != null && s.length() > idx ? s.charAt(idx) : dflt;
        }

    private static char fromByte(byte b) {
        int v = b & 0xff;
        return (char) ('a' + (v % 26));
    }

    private static String randomCase(FuzzedDataProvider data, String s) {
        char[] out = s.toCharArray();
        for (int i = 0; i < out.length; i++) {
            out[i] = data.consumeBoolean() ? Character.toUpperCase(out[i]) : Character.toLowerCase(out[i]);
        }
        return new String(out);
    }

    private static String quote(String s) {
        return s == null ? "null" : ("\"" + s + "\"");
    }
}
