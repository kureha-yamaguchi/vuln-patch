package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int scenarios = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < scenarios; i++) {
            try {
                exploreGapBoundary(data);
            } catch (RuntimeException e) {
                throw e;
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
            }
        }
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), Integer.valueOf(1));
            s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        } catch (RuntimeException e) {
            return;
        }

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        exerciseScenario(s, start, end, true, "anchor");
    }

    private static void exploreGapBoundary(FuzzedDataProvider data) {
        String name = data.consumeAsciiString(16);
        if (name.length() == 0) {
            name = "S";
        }
        TimeSeries s = new TimeSeries(name, Day.class);

        int year = 1990 + data.consumeInt(0, 40);
        int month = data.consumeInt(1, 12);

        int left = data.consumeInt(1, 20);
        int gap = data.consumeInt(2, 7);
        int right = left + gap;
        if (right > 28) {
            right = 28;
        }
        if (right <= left + 1) {
            return;
        }

        try {
            int beforeCount = data.consumeInt(0, Math.min(3, left - 1));
            int cursor = Math.max(1, left - beforeCount);
            while (cursor < left) {
                s.add(new Day(cursor, month, year), Integer.valueOf(cursor));
                cursor++;
            }

            s.add(new Day(left, month, year), Integer.valueOf(left));
            s.add(new Day(right, month, year), Integer.valueOf(right));

            int afterCount = data.consumeInt(0, Math.min(3, 28 - right));
            cursor = right + 1;
            int added = 0;
            while (cursor <= 28 && added < afterCount) {
                s.add(new Day(cursor, month, year), Integer.valueOf(cursor));
                cursor++;
                added++;
            }
        } catch (RuntimeException e) {
            return;
        }

        int startDay = data.consumeInt(left + 1, right - 1);
        int endDay = data.consumeInt(startDay, right - 1);

        Day gapStart = new Day(startDay, month, year);
        Day gapEnd = new Day(endDay, month, year);
        exerciseScenario(s, gapStart, gapEnd, true, "gap");

        Day boundaryEnd = new Day(right, month, year);
        exerciseScenario(s, gapStart, boundaryEnd, false, "boundary-end");

        Day boundaryStart = new Day(left, month, year);
        exerciseScenario(s, boundaryStart, gapEnd, false, "boundary-start");
    }

    private static void exerciseScenario(TimeSeries series, RegularTimePeriod start,
                                         RegularTimePeriod end, boolean expectEmpty,
                                         String label) {
        if (start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int originalCount = series.getItemCount();
        int originalItemsSize = series.getItems().size();
        int startIndex = series.getIndex(start);
        int endIndex = series.getIndex(end);

        try {
            TimeSeries copy = series.createCopy(start, end);

            if (series.getItemCount() != originalCount || series.getItems().size() != originalItemsSize) {
                throw new RuntimeException("[oracle:source-stable] source series changed after createCopy label="
                        + label + " originalCount=" + originalCount + " nowCount=" + series.getItemCount()
                        + " originalItemsSize=" + originalItemsSize + " nowItemsSize=" + series.getItems().size());
            }

            // Contract relied on: createCopy(start,end) returns a series representing the requested subrange.
            // For a range lying strictly in a gap, the correct result is an empty subset; if a patch only deletes
            // the throw or returns the wrong slice, these subset/uniqueness relations will be violated.
            if (expectEmpty) {
                if (copy.getItemCount() != 0 || !copy.getItems().isEmpty()) {
                    throw new RuntimeException("[oracle:gap-empty] expected empty copy for label=" + label
                            + " startIndex=" + startIndex + " endIndex=" + endIndex
                            + " count=" + copy.getItemCount() + " itemsSize=" + copy.getItems().size());
                }
                java.util.Collection uniqueFromCopy = copy.getTimePeriodsUniqueToOther(series);
                java.util.Collection missingFromCopy = series.getTimePeriodsUniqueToOther(copy);
                if (!uniqueFromCopy.isEmpty() || missingFromCopy.size() != series.getItemCount()) {
                    throw new RuntimeException("[oracle:unique-gap] empty copy is not a true empty subset label="
                            + label + " uniqueFromCopy=" + uniqueFromCopy.size()
                            + " missingFromCopy=" + missingFromCopy.size()
                            + " originalCount=" + series.getItemCount());
                }
            } else {
                java.util.Collection uniqueFromCopy = copy.getTimePeriodsUniqueToOther(series);
                if (!uniqueFromCopy.isEmpty()) {
                    throw new RuntimeException("[oracle:subset] copy contains periods absent from source label="
                            + label + " uniqueFromCopy=" + uniqueFromCopy.size());
                }
                for (int i = 0; i < copy.getItemCount(); i++) {
                    RegularTimePeriod p = copy.getTimePeriod(i);
                    if (series.getIndex(p) < 0) {
                        throw new RuntimeException("[oracle:index-subset] copied period missing from source label="
                                + label + " period=" + p);
                    }
                }
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCauseFromCreateCopy(e) && isValidGapInput(series, start, end, expectEmpty)) {
                throw new RuntimeException("[oracle:valid-gap-rejected] valid ordered range rejected label="
                        + label + " start=" + start + " end=" + end
                        + " startIndex=" + startIndex + " endIndex=" + endIndex, e);
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (!isCleanRejection(e)) {
                throw e;
            }
        }
    }

    private static boolean isValidGapInput(TimeSeries series, RegularTimePeriod start,
                                           RegularTimePeriod end, boolean expectEmpty) {
        if (!expectEmpty) {
            return false;
        }
        if (start == null || end == null || start.compareTo(end) > 0) {
            return false;
        }
        int startIndex = series.getIndex(start);
        if (startIndex < 0) {
            startIndex = -(startIndex + 1);
            if (startIndex == series.getItemCount()) {
                return false;
            }
        }
        int endIndex = series.getIndex(end);
        if (endIndex < 0) {
            endIndex = -(endIndex + 1);
            endIndex = endIndex - 1;
        }
        return endIndex >= 0 && endIndex < startIndex;
    }

    private static boolean isRootCauseFromCreateCopy(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.jfree.data.time.TimeSeries".equals(ste.getClassName())
                    && ("createCopy".equals(ste.getMethodName())
                    || "getIndex".equals(ste.getMethodName())
                    || "clone".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException
                || t instanceof ClassCastException
                || t instanceof ArithmeticException;
    }
}
