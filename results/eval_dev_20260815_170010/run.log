                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input=" + s + " lhs=" + out + " rhs=" + s);
                }
            } catch (Throwable t) {
                boolean validation = t instanceof IllegalArgumentException || t instanceof NumberFormatException;
                if (validation) {
                    return;
                }
                boolean rootCause = t instanceof StringIndexOutOfBoundsException;
                if (rootCause) {
                    for (StackTraceElement ste : t.getStackTrace()) {
                        if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                                && "translate".equals(ste.getMethodName())) {
                            throw (RuntimeException) t;
                        }
                    }
                }
            }
