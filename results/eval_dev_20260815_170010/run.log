    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzz = buildValidSafeSupplementaryString(data);
        if (fuzz == null) {
            return;
        }
        exerciseAndAssert(fuzz);
    }

    private static void runAnchor(String s) {
        exerciseAndAssert(s);
    }

    private static void exerciseAndAssert(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);

            /* Contract asserted:
             * escapeCsv only quotes/escapes CSV-special input. For strings containing no comma,
             * quote, CR, or LF, a correct implementation must return the original text unchanged.
             * We construct inputs from safe ASCII plus valid surrogate pairs only, so any patch
             * that merely suppresses the crash but skips/corrupts translation breaks this.
             */
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV input must remain unchanged input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }

            // Idempotence on the real API: applying CSV escaping twice must equal once.
            try {
                String out2 = StringEscapeUtils.escapeCsv(out);
                if (!out.equals(out2)) {
                    throw new RuntimeException("[oracle:csv-idempotence] metamorphic violation: escapeCsv(escapeCsv(x)) == escapeCsv(x) input=" + printable(s) + " lhs=" + printable(out2) + " rhs=" + printable(out));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static String buildValidSafeSupplementaryString(FuzzedDataProvider data) {
        int pairCount = data.consumeInt(1, 8);
        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int extraMidSegments = data.consumeInt(0, 4);

        StringBuilder sb = new StringBuilder();
        appendSafeAscii(sb, data, prefixLen);

        boolean hasSupplementary = false;
        for (int i = 0; i < pairCount; i++) {
            int cp;
            if (data.consumeBoolean()) {
                cp = chooseAnchorCodePoint(data);
            } else {
                cp = randomValidSupplementaryCodePoint(data);
            }
            sb.append(Character.toChars(cp));
            hasSupplementary = true;

            if (extraMidSegments > 0 && data.consumeBoolean()) {
                appendSafeAscii(sb, data, data.consumeInt(0, 4));
                extraMidSegments--;
            }
        }

        appendSafeAscii(sb, data, suffixLen);

        String s = sb.toString();
        if (!hasSupplementary) {
            return null;
        }
        if (!containsOnlySafeCsvCharsAndValidPairs(s)) {
            return null;
        }
        return s;
    }

    private static int chooseAnchorCodePoint(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 3)) {
            case 0:
                return 0x1F630; // \uD83D\uDE30
            case 1:
                return 0x10000; // \uD800\uDC00
            case 2:
                return 0x1D11E; // \uD834\uDD1E
            default:
                return 0x10FFFD; // \uDBFF\uDFFD
        }
    }

    private static int randomValidSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp) && !Character.isSurrogate((char) cp)) {
                return cp;
            }
        }
    }

    private static void appendSafeAscii(StringBuilder sb, FuzzedDataProvider data, int len) {
        String ascii = data.consumeAsciiString(len);
        for (int i = 0; i < ascii.length(); i++) {
            char c = ascii.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7E) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
    }

    private static boolean containsOnlySafeCsvCharsAndValidPairs(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
            if (Character.isHighSurrogate(c)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                i++;
            } else if (Character.isLowSurrogate(c)) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7E) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
