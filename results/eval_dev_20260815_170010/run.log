package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract/oracle used below:
        // BooleanUtils.toBoolean(String) is a case-insensitive parser for the recognized true tokens
        // "true", "on", and "yes"; all other strings should return false rather than throwing.
        // Therefore:
        //  (1) the known valid input "off" must return false (anchor from the failing test), and
        //  (2) any length-3 string whose first char is neither 'y' nor 'Y' is not a recognized token
        //      and must return false, not crash,
        //  (3) any case-variant of "yes" must agree with canonical "yes" and evaluate to true.
        anchor();

        String raw = data.consumeString(32);
        tryBoolean(raw);

        String ascii = data.consumeAsciiString(32);
        tryBoolean(ascii);

        String invalidLen3 = makeInvalidThreeChar(data);
        checkReturnsFalse(invalidLen3, "invalid3");

        String fromWindow = makeInvalidWindowToken(data);
        checkReturnsFalse(fromWindow, "window3");

        String yesVariant = makeCaseVariant("yes", data);
        checkAgreesWithCanonicalYes(yesVariant);

        String onVariant = makeCaseVariant("on", data);
        checkAgreesWithCanonicalOn(onVariant);

        String trueVariant = makeCaseVariant("true", data);
        checkAgreesWithCanonicalTrue(trueVariant);
    }

    private static void anchor() {
        try {
            boolean result = BooleanUtils.toBoolean("off");
            if (result) {
                throw new RuntimeException("[oracle:anchor-off] metamorphic violation: expected false for input=off lhs=" + result + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void tryBoolean(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstructionForRootCause(s)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkReturnsFalse(String s, String oracleId) {
        try {
            boolean result = BooleanUtils.toBoolean(s);
            if (result) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: non-recognized length-3 token must be false input=" + printable(s) + " lhs=" + result + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstructionForRootCause(s)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkAgreesWithCanonicalYes(String variant) {
        try {
            boolean lhs = BooleanUtils.toBoolean(variant);
            boolean rhs = BooleanUtils.toBoolean("yes");
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:yes-case] metamorphic violation: case-insensitive parse for yes input=" + printable(variant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstructionForRootCause(variant)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkAgreesWithCanonicalOn(String variant) {
        try {
            boolean lhs = BooleanUtils.toBoolean(variant);
            boolean rhs = BooleanUtils.toBoolean("on");
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:on-case] metamorphic violation: case-insensitive parse for on input=" + printable(variant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstructionForRootCause(variant)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void checkAgreesWithCanonicalTrue(String variant) {
        try {
            boolean lhs = BooleanUtils.toBoolean(variant);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer("tr").append("ue").toString());
            if (lhs != rhs || !lhs) {
                throw new RuntimeException("[oracle:true-case] metamorphic violation: case-insensitive parse for true input=" + printable(variant) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstructionForRootCause(variant)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

