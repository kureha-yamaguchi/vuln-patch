        String rawPrefix = data.consumeAsciiString(16);
        String rawSuffix = data.consumeAsciiString(16);
        StringBuilder prefix = new StringBuilder(rawPrefix.length());
        StringBuilder suffix = new StringBuilder(rawSuffix.length());

        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c == ',' || c == '"' || c == '\n' || c == '\r') {
                c = 'A';
            }
            prefix.append(c);
        }
        for (int i = 0; i < rawSuffix.length(); i++) {
            char c = rawSuffix.charAt(i);
            if (c == ',' || c == '"' || c == '\n' || c == '\r') {
                c = 'B';
            }
            suffix.append(c);
        }

        int pairCount = data.consumeInt(1, 3);
        StringBuilder middle = new StringBuilder(pairCount * 2 + 8);
        for (int i = 0; i < pairCount; i++) {
            char high = (char) data.consumeInt(0xD800, 0xDBFF);
            char low = (char) data.consumeInt(0xDC00, 0xDFFF);
            if (data.consumeBoolean()) {
                middle.append((char) data.consumeInt('a', 'z'));
            }
            middle.append(high).append(low);
            if (data.consumeBoolean()) {
                middle.append((char) data.consumeInt('0', '9'));
            }
