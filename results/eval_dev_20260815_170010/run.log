package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String explored = buildValidDecimalLikeInput(data);
        exerciseCreateNumber(explored, true);

        int n = data.consumeInt(-1_000_000, 1_000_000);
        String intStr = Integer.toString(n);

        try {
            Number viaCreateNumber = NumberUtils.createNumber(intStr);
            Integer viaCreateInteger = NumberUtils.createInteger(intStr);
            if (viaCreateNumber == null || viaCreateInteger == null || viaCreateNumber.intValue() != viaCreateInteger.intValue()) {
                throw new RuntimeException("[oracle:int-eq] metamorphic violation: createNumber(int-string) must agree with createInteger input="
                        + intStr + " lhs=" + viaCreateNumber + " rhs=" + viaCreateInteger);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }

        long l = ((long) data.consumeInt(-1_000_000, 1_000_000) * 1000L) + data.consumeInt(0, 999);
        if (data.consumeBoolean()) {
            l = -l;
        }
        String longDigits = Long.toString(l);
        String longWithSuffix = longDigits + (data.consumeBoolean() ? "L" : "l");
        try {
            Number viaCreateNumber = NumberUtils.createNumber(longWithSuffix);
            Long viaCreateLong = NumberUtils.createLong(longDigits);
            if (viaCreateNumber == null || viaCreateLong == null || viaCreateNumber.longValue() != viaCreateLong.longValue()) {
                throw new RuntimeException("[oracle:long-suffix] metamorphic violation: createNumber(long-suffix) must agree with createLong input="
                        + longWithSuffix + " lhs=" + viaCreateNumber + " rhs=" + viaCreateLong);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }

        String decimal = buildCanonicalDecimal(data);
        try {
            Number lhs = NumberUtils.createNumber(decimal + "D");
            Double rhs = NumberUtils.createDouble(decimal);
            if (lhs != null && rhs != null && Double.doubleToLongBits(lhs.doubleValue()) != Double.doubleToLongBits(rhs.doubleValue())) {
                throw new RuntimeException("[oracle:double-suffix] metamorphic violation: createNumber(xD) must agree with createDouble(x) input="
                        + decimal + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (!isCleanRejection(t) && isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }

        try {
            Number lhs = NumberUtils.createNumber(decimal + "F");
            Float rhs = NumberUtils.createFloat(decimal);
            if (lhs != null && rhs != null && Float.floatToIntBits(lhs.floatValue()) != Float.floatToIntBits(rhs.floatValue())) {
                throw new RuntimeException("[oracle:float-suffix] metamorphic violation: createNumber(xF) must agree with createFloat(x) input="
                        + decimal + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (!isCleanRejection(t) && isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }

        String bigDigits = buildBigIntegerDigits(data);
        try {
            Number viaCreateNumber = NumberUtils.createNumber(bigDigits + "L");
            BigInteger viaCreateBigInteger = NumberUtils.createBigInteger(bigDigits);
            if (!(viaCreateNumber instanceof BigInteger) || !viaCreateBigInteger.equals(viaCreateNumber)) {
                throw new RuntimeException("[oracle:bigint-fallback] metamorphic violation: oversized long-suffixed integer must fall back to BigInteger input="
                        + bigDigits + "L lhs=" + viaCreateNumber + " rhs=" + viaCreateBigInteger);
            }
        } catch (RuntimeException t) {
            if (!isCleanRejection(t) && isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }

        try {
            BigDecimal bd = NumberUtils.createBigDecimal(decimal);
            if (bd != null && !bd.toPlainString().isEmpty()) {
                NumberUtils.createNumber(decimal);
            }
        } catch (RuntimeException t) {
            if (!isCleanRejection(t) && isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }
    }

    private static void exerciseCreateNumber(String input, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCauseInPatchedRegion(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseInPatchedRegion(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)
                    && ("createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method))) {
                return true;
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidDecimalLikeInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int intDigits = data.consumeInt(1, 6);
        appendDigits(sb, data, intDigits, true);
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracDigits = data.consumeInt(1, 6);
            appendDigits(sb, data, fracDigits, false);
        }
        if (data.consumeBoolean()) {
            char suffix;
            int choice = data.consumeInt(0, 3);
            if (choice == 0) {
                suffix = 'D';
            } else if (choice == 1) {
                suffix = 'd';
            } else if (choice == 2) {
                suffix = 'F';
            } else {
                suffix = 'f';
            }
            sb.append(suffix);
        }
        return sb.toString();
    }

    private static String buildCanonicalDecimal(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        appendDigits(sb, data, data.consumeInt(1, 6), true);
        sb.append('.');
        appendDigits(sb, data, data.consumeInt(1, 6), false);
        return sb.toString();
    }

    private static String buildBigIntegerDigits(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int len = data.consumeInt(20, 30);
        sb.append((char) ('1' + data.consumeInt(0, 8)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static void appendDigits(StringBuilder sb, FuzzedDataProvider data, int count, boolean firstNonZero) {
        for (int i = 0; i < count; i++) {
            int d;
            if (i == 0 && firstNonZero) {
                d = data.consumeInt(0, 9);
            } else {
                d = data.consumeInt(0, 9);
            }
            sb.append((char) ('0' + d));
        }
    }
}
