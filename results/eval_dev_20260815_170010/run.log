package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzz = buildValidCsvSafeString(data);
        if (fuzz == null || fuzz.length() == 0) {
            return;
        }

        try {
            String escaped = StringEscapeUtils.escapeCsv(fuzz);

            /* Contract/oracle:
             * escapeCsv "returns a String value for a CSV column enclosed in double quotes, if required".
             * For inputs built here, no character is ',', '"', '\r', or '\n', so quoting/escaping is not required.
             * Therefore a correct implementation must return the original string unchanged.
             * A throw-deleting or branch-skipping patch that silently drops/mangles supplementary characters would violate this.
             */
            if (!fuzz.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: csv-safe input must be unchanged input=" + printable(fuzz) + " lhs=" + printable(escaped) + " rhs=" + printable(fuzz));
            }

            String escapedTwice = StringEscapeUtils.escapeCsv(escaped);
            if (!escaped.equals(escapedTwice)) {
                throw new RuntimeException("[oracle:csv-stable-safe] metamorphic violation: escaping an already csv-safe result must stay unchanged input=" + printable(fuzz) + " lhs=" + printable(escapedTwice) + " rhs=" + printable(escaped));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(out)) {
                throw new RuntimeException("[oracle:anchor-eq] metamorphic violation: failing-test surrogate pair must round through escapeCsv unchanged input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static String buildValidCsvSafeString(FuzzedDataProvider data) {
        int count = data.consumeInt(1, 12);
        boolean forceSupplementary = data.consumeBoolean();
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < count; i++) {
            boolean useSupplementary = forceSupplementary ? (i == data.consumeInt(0, count - 1)) : data.consumeBoolean();
            int cp;
            if (useSupplementary) {
                cp = chooseSafeSupplementary(data);
                forceSupplementary = false;
            } else {
                cp = chooseSafeBmp(data);
            }
            sb.appendCodePoint(cp);
        }

        if (forceSupplementary) {
            sb.appendCodePoint(chooseSafeSupplementary(data));
        }

        return sb.toString();
    }

    private static int chooseSafeBmp(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x20, 0xFFFD);
            if (cp >= 0xD800 && cp <= 0xDFFF) {
                continue;
            }
            if (cp == ',' || cp == '"' || cp == '\r' || cp == '\n') {
                continue;
            }
            return cp;
        }
    }

    private static int chooseSafeSupplementary(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (cp == ',' || cp == '"' || cp == '\r' || cp == '\n') {
                continue;
            }
            return cp;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); ) {
            int cp = s.codePointAt(i);
            if (cp >= 0x20 && cp <= 0x7E && cp != '\\' && cp != '"') {
                sb.append((char) cp);
            } else {
                String hex = Integer.toHexString(cp).toUpperCase();
                sb.append("\\u{").append(hex).append('}');
            }
            i += Character.charCount(cp);
        }
        sb.append('"');
        return sb.toString();
    }
}
