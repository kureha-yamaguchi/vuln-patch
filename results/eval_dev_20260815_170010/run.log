                throw new RuntimeException("[oracle:copy-periods-size] count="
                        + copy.getItemCount() + " periods=" + periodsInCopy.size());
            }

            Iterator it = periodsInCopy.iterator();
            while (it.hasNext()) {
                RegularTimePeriod p = (RegularTimePeriod) it.next();
                if (p.compareTo(start) < 0 || p.compareTo(end) > 0) {
                    throw new RuntimeException("[oracle:copy-bounds-membership] period=" + p
                            + " start=" + start + " end=" + end);
                }
            }

            TimeSeries cloned = (TimeSeries) copy.clone();
            if (cloned.getItemCount() != copy.getItemCount()) {
                throw new RuntimeException("[oracle:clone-count] original=" + copy.getItemCount()
                        + " clone=" + cloned.getItemCount());
            }
            if (cloned.getTimePeriods().size() != copy.getTimePeriods().size()) {
                throw new RuntimeException("[oracle:clone-periods-size] original="
                        + copy.getTimePeriods().size() + " clone=" + cloned.getTimePeriods().size());
            }
            if (copy.getItems() == cloned.getItems()) {
                throw new RuntimeException("[oracle:clone-items-alias] clone shares item collection view");
            }
        } catch (IllegalArgumentException e) {
            if (hasRelevantFrame(e)) {
                throw new RuntimeException("[oracle:valid-gap-rejected] start=" + start
                        + " end=" + end + " expectedCount=" + expectedCount, e);
            }
        } catch (RuntimeException e) {
            if (hasRelevantFrame(e) || isOracleRuntime(e)) {
                throw e;
            }
        }
    }

    private static int countItemsInRange(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int manualIndex(TimeSeries s, RegularTimePeriod query) {
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            int cmp = p.compareTo(query);
            if (cmp == 0) {
                return i;
            }
            if (cmp > 0) {
                return -(i + 1);
            }
        }
        return -(s.getItemCount() + 1);
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleRuntime(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
}
