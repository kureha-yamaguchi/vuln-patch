package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runValidSafeCsv("\uD83D\uDE30");
        runValidSafeCsv("\uD800\uDC00");
        runValidSafeCsv("\uD834\uDD1E");
        runValidSafeCsv("\uDBFF\uDFFD");

        String fuzzed = buildValidSafeCsvString(data);
        runValidSafeCsv(fuzzed);
    }

    private static void runValidSafeCsv(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle: escapeCsv only adds CSV quoting/escaping when needed.
            // For inputs constructed here, we exclude ',', '"', '\r', and '\n' by construction,
            // so a correct implementation must return the input unchanged. A throw-deleting or
            // character-skipping patch would violate this observable result.
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: safe CSV input must be unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }

            try {
                String viaTranslator = StringEscapeUtils.ESCAPE_CSV.translate(input);
                if (!escaped.equals(viaTranslator)) {
                    throw new RuntimeException(
                        "[oracle:overload-agreement] metamorphic violation: StringEscapeUtils.escapeCsv and ESCAPE_CSV.translate disagree input="
                            + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(viaTranslator));
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    sneakyThrow(t);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static String buildValidSafeCsvString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int chunks = data.consumeInt(1, 8);
        boolean hasSupplementary = false;

        for (int i = 0; i < chunks; i++) {
            if (data.consumeBoolean()) {
                sb.append(randomSafeAscii(data));
            } else {
                sb.append(randomSupplementaryPair(data));
                hasSupplementary = true;
            }
        }

        int extraPrefix = data.consumeInt(0, 4);
        for (int i = 0; i < extraPrefix; i++) {
            sb.insert(0, randomSafeAscii(data));
        }

        int extraSuffix = data.consumeInt(0, 4);
        for (int i = 0; i < extraSuffix; i++) {
            sb.append(randomSafeAscii(data));
        }

        if (!hasSupplementary) {
            int pos = sb.length() == 0 ? 0 : data.consumeInt(0, sb.length());
            sb.insert(pos, randomSupplementaryPair(data));
        }

        return sb.toString();
    }

    private static char randomSafeAscii(FuzzedDataProvider data) {
        while (true) {
            char c = (char) data.consumeInt(0x20, 0x7e);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                return c;
            }
        }
    }

    private static String randomSupplementaryPair(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (Character.isValidCodePoint(cp) && Character.isSupplementaryCodePoint(cp)) {
                return new String(Character.toChars(cp));
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validation") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if (("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        out.append(String.format("\\u%04X", (int) c));
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
