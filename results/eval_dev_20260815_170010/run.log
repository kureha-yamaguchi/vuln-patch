package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerKnownBug();
        exploreLengthBoundary(data);
        oracleEquivalentFloatSuffixes(data);
        oracleEquivalentDoubleSuffixes(data);
    }

    private static void triggerKnownBug() {
        try {
            NumberUtils.createNumber("L");
        } catch (NumberFormatException expectedOnFixed) {
            return;
        }
    }

    private static void exploreLengthBoundary(FuzzedDataProvider data) {
        char suffix = data.consumeBoolean() ? 'L' : 'l';

        try {
            NumberUtils.createNumber(String.valueOf(suffix));
        } catch (NumberFormatException expectedOnFixed) {
        }

        String digits = buildDigits(data.consumeInt(1, 12), data.consumeBoolean());
        try {
            NumberUtils.createNumber(digits + suffix);
        } catch (NumberFormatException ignored) {
        }

        String junk = data.consumeAsciiString(12);
        try {
            NumberUtils.createNumber(junk + suffix);
        } catch (NumberFormatException ignored) {
        }
    }

    private static void oracleEquivalentFloatSuffixes(FuzzedDataProvider data) {
        String core = buildDecimal(data);
        try {
            Number upper = NumberUtils.createNumber(core + "F");
            Number lower = NumberUtils.createNumber(core + "f");
            Float direct = NumberUtils.createFloat(core);

            if (!(upper instanceof Float) || !(lower instanceof Float) || direct == null) {
                return;
            }

            int a = Float.floatToIntBits(((Float) upper).floatValue());
            int b = Float.floatToIntBits(((Float) lower).floatValue());
            int c = Float.floatToIntBits(direct.floatValue());

            if (a != b || a != c) {
                throw new RuntimeException(
                    "[oracle:float-suffix-case] metamorphic violation: input=" + core
                        + " upper=" + upper + " lower=" + lower + " direct=" + direct);
            }
        } catch (NumberFormatException ignored) {
        }
    }

    private static void oracleEquivalentDoubleSuffixes(FuzzedDataProvider data) {
        String core = buildDecimal(data);
        try {
            Number upper = NumberUtils.createNumber(core + "D");
            Number lower = NumberUtils.createNumber(core + "d");
            Double direct = NumberUtils.createDouble(core);

            if (!(upper instanceof Double) || !(lower instanceof Double) || direct == null) {
                return;
            }

            long a = Double.doubleToLongBits(((Double) upper).doubleValue());
            long b = Double.doubleToLongBits(((Double) lower).doubleValue());
            long c = Double.doubleToLongBits(direct.doubleValue());

            if (a != b || a != c) {
                throw new RuntimeException(
                    "[oracle:double-suffix-case] metamorphic violation: input=" + core
                        + " upper=" + upper + " lower=" + lower + " direct=" + direct);
            }
        } catch (NumberFormatException ignored) {
        }
    }

    private static String buildDecimal(FuzzedDataProvider data) {
        int whole = data.consumeInt(-1_000_000, 1_000_000);
        int frac = data.consumeInt(0, 999_999);
        return Integer.toString(whole) + "." + Integer.toString(frac);
    }

    private static String buildDigits(int len, boolean negative) {
        StringBuffer sb = new StringBuffer();
        if (negative) {
            sb.append('-');
        }
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + (i % 10)));
        }
        if (negative && len == 0) {
            sb.append('0');
        }
        return sb.toString();
    }
}
