            // a correct implementation must return the original string unchanged.
            if (validByConstruction && fuzz.length() > 0 && !fuzz.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must leave CSV-safe input unchanged input=" + printable(fuzz) + " lhs=" + printable(out) + " rhs=" + printable(fuzz));
            }
