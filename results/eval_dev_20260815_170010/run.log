package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeToBoolean("off", true);

        int exploreCount = 1 + (data.remainingBytes() > 0 ? data.consumeInt(1, 6) : 1);
        for (int i = 0; i < exploreCount; i++) {
            String candidate = buildThreeCharNonY(data, i);
            invokeToBoolean(candidate, true);
        }

        String maybeBad = data.consumeString(8);
        if (maybeBad != null && maybeBad.length() == 3) {
            char ch0 = maybeBad.charAt(0);
            if (ch0 != 'y' && ch0 != 'Y') {
                invokeToBoolean(maybeBad, true);
            } else {
                invokeToBoolean(maybeBad, false);
            }
        } else {
            invokeToBoolean(maybeBad, false);
        }

        String arbitrary = data.consumeRemainingAsString();
        invokeToBoolean(arbitrary, false);

        // Contract/oracle: BooleanUtils.toBoolean(String) is case-insensitive for the
        // recognized true literals; the implementation explicitly accepts upper/lower-case
        // variants for "true", "on", and "yes". Therefore a random-cased form of one of
        // those literals must produce the same result as the canonical lowercase literal.
        // A patch that merely suppresses the crash by making 3-char inputs return false
        // would violate this on "yes"/mixed-case equivalents.
        String base;
        switch (data.consumeInt(0, 2)) {
            case 0:
                base = "true";
                break;
            case 1:
                base = "on";
                break;
            default:
                base = "yes";
                break;
        }
        String varied = randomizeCase(base, data);
        try {
            boolean lhs = BooleanUtils.toBoolean(base);
            boolean rhs = BooleanUtils.toBoolean(varied);
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:case-eq] metamorphic violation: case-insensitive recognized true literal input="
                        + escape(varied) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs || !rhs) {
                throw new RuntimeException(
                    "[oracle:case-eq] metamorphic violation: recognized true literal parsed as false input="
                        + escape(varied) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static void invokeToBoolean(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String buildThreeCharNonY(FuzzedDataProvider data, int salt) {
        String s = data.consumeAsciiString(3);
        if (s == null) {
