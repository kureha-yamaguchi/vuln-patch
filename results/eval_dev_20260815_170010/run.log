    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        exploreGapRanges(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), new Integer(1));
            s.add(new Day(31, 1, 2006), new Integer(1));
        } catch (RuntimeException e) {
            return;
        }

        List originalPeriods = snapshotPeriods(s);
        List originalValues = snapshotValues(s);
        int originalCount = s.getItemCount();

        try {
            TimeSeries copy = s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
            assertOriginalUnchanged(s, originalPeriods, originalValues, originalCount, "anchor");
            assertEmptyCopyPreservesMetadata(s, copy, "anchor");
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void exploreGapRanges(FuzzedDataProvider data) {
        TimeSeries series = new TimeSeries(nonEmptyName(data), "domain", "range", Month.class);

        int baseYear = data.consumeInt(1900, 2100);
        int itemCount = data.consumeInt(2, 8);
        boolean forceWideGap = true;

        List monthKeys = new ArrayList();
        int cursor = baseYear * 12 + data.consumeInt(1, 12) - 1;
        for (int i = 0; i < itemCount; i++) {
            int step;
            if (i == 0) {
                step = 0;
            } else if (forceWideGap) {
                step = data.consumeInt(2, 8);
                forceWideGap = false;
            } else {
                step = data.consumeInt(1, 8);
            }
            cursor += step;
            monthKeys.add(new Integer(cursor));
        }

        for (int i = 0; i < monthKeys.size(); i++) {
            int key = ((Integer) monthKeys.get(i)).intValue();
            Month m = monthFromKey(key);
            if (m == null) {
                return;
            }
            try {
                series.add(m, new Integer(i + 1));
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int pairIndex = data.consumeInt(0, series.getItemCount() - 2);
        Month left = (Month) series.getTimePeriod(pairIndex);
        Month right = (Month) series.getTimePeriod(pairIndex + 1);

        int leftKey = monthKey(left);
        int rightKey = monthKey(right);
        if (rightKey - leftKey < 2) {
            return;
        }

        int startKey = data.consumeInt(leftKey + 1, rightKey - 1);
        int endKey = data.consumeInt(startKey, rightKey - 1);

        Month start = monthFromKey(startKey);
        Month end = monthFromKey(endKey);
        if (start == null || end == null) {
            return;
        }

        // Valid-by-construction: start and end are real Month instances with start <= end,
        // and both lie strictly between two adjacent stored months, so the requested copy
        // range contains no items. A correct implementation must accept this and return an
        // empty copy rather than throw.
        int rawStartIndex;
        int rawEndIndex;
        try {
            rawStartIndex = series.getIndex(start);
            rawEndIndex = series.getIndex(end);
        } catch (RuntimeException e) {
            return;
        }

        int computedStartIndex = rawStartIndex;
        if (computedStartIndex < 0) {
            computedStartIndex = -(computedStartIndex + 1);
        }
        int computedEndIndex = rawEndIndex;
        if (computedEndIndex < 0) {
            computedEndIndex = -(computedEndIndex + 1);
            computedEndIndex = computedEndIndex - 1;
        }

        if (!(computedEndIndex < computedStartIndex)) {
            return;
        }

        List originalPeriods = snapshotPeriods(series);
        List originalValues = snapshotValues(series);
        int originalCount = series.getItemCount();

        try {
            TimeSeries copy = series.createCopy(start, end);

            // Contract-based post-condition:
            // createCopy must not mutate the original series; a throw-deleting or wrong-branch
            // patch can still corrupt receiver state while making the exception disappear.
            assertOriginalUnchanged(series, originalPeriods, originalValues, originalCount, "orig-immut");

            // For a range lying strictly in a gap between adjacent items, the copy must be empty.
            // This boundary is exactly where the patched condition flips from "endIndex < 0" to
            // "endIndex < startIndex".
            assertEmptyCopyPreservesMetadata(series, copy, "gap-empty");

            // Independent oracle outside size/list-agreement: metadata and class must survive
            // cloning/copying unchanged for any correct implementation.
            if (copy.getTimePeriodClass() != series.getTimePeriodClass()) {
                throw new RuntimeException("[oracle:period-class] metamorphic violation: copied series changed timePeriodClass");
            }
            if (!safeEquals(copy.getDomainDescription(), series.getDomainDescription())
                    || !safeEquals(copy.getRangeDescription(), series.getRangeDescription())) {
                throw new RuntimeException("[oracle:descriptions] metamorphic violation: copied series changed descriptions");
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        mutateAndReprobe(data, series);
    }

    private static void mutateAndReprobe(FuzzedDataProvider data, TimeSeries series) {
        int mutations = data.consumeInt(1, 4);
        for (int i = 0; i < mutations; i++) {
            int key = data.consumeInt(1900 * 12, 2100 * 12 + 11);
            Month m = monthFromKey(key);
            if (m == null) {
                return;
            }
            try {
                if (data.consumeBoolean()) {
                    series.addOrUpdate(m, new Integer(data.consumeInt(-1000, 1000)));
                } else {
                    series.addOrUpdate(m, new Double(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                return;
            }

            if (series.getItemCount() < 2) {
                continue;
            }

            int idx = data.consumeInt(0, series.getItemCount() - 2);
            Month left = (Month) series.getTimePeriod(idx);
            Month right = (Month) series.getTimePeriod(idx + 1);
            int leftKey = monthKey(left);
            int rightKey = monthKey(right);
            if (rightKey - leftKey < 2) {
                continue;
            }

            Month start = monthFromKey(leftKey + 1);
            Month end = monthFromKey(rightKey - 1);
            if (start == null || end == null) {
                continue;
            }

            List originalPeriods = snapshotPeriods(series);
            List originalValues = snapshotValues(series);
            int originalCount = series.getItemCount();

            try {
                TimeSeries copy = series.createCopy(start, end);
                assertOriginalUnchanged(series, originalPeriods, originalValues, originalCount, "reprobe-orig");
                assertEmptyCopyPreservesMetadata(series, copy, "reprobe-gap");
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
            }
        }
    }

    private static void assertEmptyCopyPreservesMetadata(TimeSeries original, TimeSeries copy, String oracleId) {
        if (copy == null) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: copy is null");
        }
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: expected empty copy, got itemCount=" + copy.getItemCount());
        }
        if (copy.getTimePeriodClass() != original.getTimePeriodClass()) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: timePeriodClass changed");
        }
        if (!safeEquals(copy.getDomainDescription(), original.getDomainDescription())
                || !safeEquals(copy.getRangeDescription(), original.getRangeDescription())) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: descriptions changed");
        }
    }

    private static void assertOriginalUnchanged(TimeSeries series, List periods, List values, int count, String oracleId) {
        if (series.getItemCount() != count) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: original itemCount changed from " + count + " to " + series.getItemCount());
        }
        for (int i = 0; i < count; i++) {
            Object p = series.getTimePeriod(i);
            Object v = series.getValue(i);
            if (!safeEquals(p, periods.get(i)) || !safeEquals(v, values.get(i))) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: original series mutated at index " + i);
            }
        }
    }

    private static List snapshotPeriods(TimeSeries series) {
        List out = new ArrayList();
        for (int i = 0; i < series.getItemCount(); i++) {
            out.add(series.getTimePeriod(i));
        }
        return out;
    }

    private static List snapshotValues(TimeSeries series) {
        List out = new ArrayList();
        for (int i = 0; i < series.getItemCount(); i++) {
            out.add(series.getValue(i));
        }
        return out;
    }

    private static boolean isRootCause(RuntimeException e) {
        if (!(e instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = e.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String nonEmptyName(FuzzedDataProvider data) {
        String s = data.consumeAsciiString(16);
        if (s == null || s.length() == 0) {
            return "S";
        }
        return s;
    }

    private static int monthKey(Month m) {
        return m.getYearValue() * 12 + (m.getMonth() - 1);
    }

    private static Month monthFromKey(int key) {
        int year = key / 12;
        int month = (key % 12) + 1;
        if (month < 1 || month > 12) {
            return null;
        }
        return new Month(month, year);
    }

    private static boolean safeEquals(Object a, Object b) {
        return a == b || (a != null && a.equals(b));
    }
}
