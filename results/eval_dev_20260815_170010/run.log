package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Date;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            anchorSeed();
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }

        try {
            exploreGapCopies(data);
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable t) {
            return;
        }
    }

    private static void anchorSeed() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), new Integer(1));
        s.add(new Day(31, 1, 2006), new Integer(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int expected = countItemsInRange(s, start, end);
        if (expected != 0) {
            throw new RuntimeException("[oracle:anchor-setup] unexpected seeded range population=" + expected);
        }

        try {
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("[oracle:anchor-copy-null] createCopy returned null");
            }
            if (copy.getItemCount() != expected) {
                throw new RuntimeException("[oracle:anchor-copy-count] expected=" + expected
                        + " actual=" + copy.getItemCount());
            }
            if (copy.getItemCount() != copy.getTimePeriods().size()) {
                throw new RuntimeException("[oracle:anchor-period-list-size] count="
                        + copy.getItemCount() + " periods=" + copy.getTimePeriods().size());
            }
        } catch (IllegalArgumentException e) {
            if (hasRelevantFrame(e)) {
                throw new RuntimeException("[oracle:anchor-gap-accept] valid empty range rejected", e);
            }
        } catch (RuntimeException e) {
            if (hasRelevantFrame(e)) {
                throw e;
            }
        }
    }

    private static void exploreGapCopies(FuzzedDataProvider data) throws CloneNotSupportedException {
        String name = data.consumeAsciiString(16);
        if (name == null || name.length() == 0) {
            name = "S";
        }

        TimeSeries s = new TimeSeries(name);
        int itemCount = data.consumeInt(2, 8);

        long baseDay = data.consumeInt(-2000, 2000);
        long currentDay = baseDay;
        Day[] periods = new Day[itemCount];

        for (int i = 0; i < itemCount; i++) {
            if (i > 0) {
                currentDay += data.consumeInt(2, 20);
            }
            Day d = new Day(new Date(currentDay * 24L * 60L * 60L * 1000L));
            periods[i] = d;
            s.add(d, new Integer(data.consumeInt(-1000, 1000)));
        }

        if (s.getItemCount() != itemCount) {
            throw new RuntimeException("[oracle:source-item-count] expected=" + itemCount
                    + " actual=" + s.getItemCount());
        }

        int exactProbe = data.consumeInt(0, itemCount - 1);
        int exactIndex = s.getIndex(periods[exactProbe]);
        if (exactIndex != exactProbe) {
            throw new RuntimeException("[oracle:getIndex-exact] expected=" + exactProbe
                    + " actual=" + exactIndex);
        }

        int gap = data.consumeInt(0, itemCount - 2);
        Day left = periods[gap];
        Day right = periods[gap + 1];
        Day start = (Day) left.next();
        Day end = (Day) right.previous();

        if (start == null || end == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        int manualStartIndex = manualIndex(s, start);
        int manualEndIndex = manualIndex(s, end);
        int libStartIndex = s.getIndex(start);
        int libEndIndex = s.getIndex(end);

        if (manualStartIndex != libStartIndex) {
            throw new RuntimeException("[oracle:getIndex-start] manual=" + manualStartIndex
                    + " library=" + libStartIndex);
        }
        if (manualEndIndex != libEndIndex) {
            throw new RuntimeException("[oracle:getIndex-end] manual=" + manualEndIndex
                    + " library=" + libEndIndex);
        }

        int expectedCount = countItemsInRange(s, start, end);

        try {
            TimeSeries copy = s.createCopy(start, end);

            if (copy.getItemCount() != expectedCount) {
                throw new RuntimeException("[oracle:copy-range-count] expected=" + expectedCount
                        + " actual=" + copy.getItemCount());
            }

            List periodsInCopy = copy.getTimePeriods();
            if (periodsInCopy.size() != copy.getItemCount()) {
                throw new RuntimeException("[oracle:copy-periods-size] count="
                        + copy.getItemCount() + " periods=" + periodsInCopy.size());
            }

            for (int i = 0; i < periodsInCopy.size(); i++) {
                RegularTimePeriod p = (RegularTimePeriod) periodsInCopy.get(i);
                if (p.compareTo(start) < 0 || p.compareTo(end) > 0) {
                    throw new RuntimeException("[oracle:copy-bounds-membership] period=" + p
                            + " start=" + start + " end=" + end);
                }
            }

            TimeSeries cloned = (TimeSeries) copy.clone();
            if (cloned.getItemCount() != copy.getItemCount()) {
                throw new RuntimeException("[oracle:clone-count] original=" + copy.getItemCount()
                        + " clone=" + cloned.getItemCount());
            }
            if (cloned.getTimePeriods().size() != copy.getTimePeriods().size()) {
                throw new RuntimeException("[oracle:clone-periods-size] original="
                        + copy.getTimePeriods().size() + " clone=" + cloned.getTimePeriods().size());
            }
            if (copy.getTimePeriods() == cloned.getTimePeriods()) {
                throw new RuntimeException("[oracle:clone-list-alias] clone shares period list view");
            }
        } catch (IllegalArgumentException e) {
            if (hasRelevantFrame(e)) {
                throw new RuntimeException("[oracle:valid-gap-rejected] start=" + start
                        + " end=" + end + " expectedCount=" + expectedCount, e);
            }
        } catch (RuntimeException e) {
            if (hasRelevantFrame(e) || isOracleRuntime(e)) {
                throw e;
            }
        }
    }

    private static int countItemsInRange(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static int manualIndex(TimeSeries s, RegularTimePeriod query) {
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            int cmp = p.compareTo(query);
            if (cmp == 0) {
                return i;
            }
            if (cmp > 0) {
                return -(i + 1);
            }
        }
        return -(s.getItemCount() + 1);
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleRuntime(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
}
