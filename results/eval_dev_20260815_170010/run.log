package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        Day first = new Day(19, 8, 2005);
        Day second = new Day(31, 1, 2006);
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int beforeCount = s.getItemCount();
        try {
            s.add(first, Integer.valueOf(1));
            s.add(second, Integer.valueOf(1));
            beforeCount = s.getItemCount();
        } catch (RuntimeException e) {
            return;
        }

        try {
            TimeSeries copy = s.createCopy(start, end);
            checkSourceUnchanged("anchor-src", s, beforeCount, first, second);
            checkEmptyGapCopy("anchor-gap", copy, start, end);
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:anchor-gap-empty] valid empty gap rejected by createCopy");
            }
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        Scenario sc = buildScenario(data);
        if (sc == null) {
            return;
        }

        // Contract asserted here:
        // createCopy(start, end) with start <= end over a valid series must return a copy
        // of the data items in that period range. When start/end fall strictly inside a gap
        // between two existing periods, the correct range is empty, so the returned series
        // must have zero items and report absence consistently via its public readers.
        try {
            int beforeCount = sc.series.getItemCount();
            RegularTimePeriod beforeFirst = sc.series.getTimePeriod(0);
            RegularTimePeriod beforeLast = sc.series.getTimePeriod(beforeCount - 1);

            TimeSeries copy = sc.series.createCopy(sc.start, sc.end);

            checkSourceUnchanged("explore-src", sc.series, beforeCount, beforeFirst, beforeLast);
            checkEmptyGapCopy("explore-gap", copy, sc.start, sc.end);

            // Independent sibling/readback check outside simple count-only assertions:
            // absent periods in an empty copy must also read back as null values.
            Number sv = copy.getValue(sc.start);
            Number ev = copy.getValue(sc.end);
            if (sv != null || ev != null) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:empty-copy-values] empty copy reported non-null values");
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:flip-empty-gap] valid gap copy rejected near patched boundary");
            }
        }
    }

    private static void checkSourceUnchanged(String id, TimeSeries s, int expectedCount,
                                             RegularTimePeriod expectedFirst,
                                             RegularTimePeriod expectedLast) {
        if (s.getItemCount() != expectedCount) {
            throw new RuntimeException("[oracle:" + id + "] metamorphic violation: source item count changed");
        }
        if (s.getItems().size() != expectedCount) {
            throw new RuntimeException("[oracle:" + id + "-items] metamorphic violation: source list size changed");
        }
        if (expectedCount > 0) {
            if (!expectedFirst.equals(s.getTimePeriod(0))) {
                throw new RuntimeException("[oracle:" + id + "-first] metamorphic violation: source first period changed");
            }
            if (!expectedLast.equals(s.getTimePeriod(expectedCount - 1))) {
                throw new RuntimeException("[oracle:" + id + "-last] metamorphic violation: source last period changed");
            }
        }
    }

    private static void checkEmptyGapCopy(String id, TimeSeries copy,
                                          RegularTimePeriod start, RegularTimePeriod end) {
        if (copy == null) {
            throw new RuntimeException("[oracle:" + id + "-null] metamorphic violation: copy is null");
        }
        int count = copy.getItemCount();
        int items = copy.getItems().size();
        if (count != 0 || items != 0) {
            throw new RuntimeException(
                    "[oracle:" + id + "-count] metamorphic violation: valid empty gap copy not empty count="
                            + count + " items=" + items);
        }
        int startIndex = copy.getIndex(start);
        int endIndex = copy.getIndex(end);
        if (startIndex >= 0 || endIndex >= 0) {
            throw new RuntimeException(
                    "[oracle:" + id + "-index] metamorphic violation: empty copy contains queried gap periods startIndex="
                            + startIndex + " endIndex=" + endIndex);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(m) || "getIndex".equals(m) || "clone".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static Scenario buildScenario(FuzzedDataProvider data) {
        try {
            String name = data.consumeString(20);
            if (name == null || name.length() == 0) {
                name = "S";
            }
            TimeSeries series = new TimeSeries(name);

            java.util.GregorianCalendar cal =
                    new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
            cal.setLenient(true);
            cal.clear();

            int year = 1995 + data.consumeInt(0, 30);
            int month = data.consumeInt(0, 11);
            int day = data.consumeInt(1, 20);
            cal.set(year, month, day, 0, 0, 0);
            cal.set(java.util.Calendar.MILLISECOND, 0);

            int itemCount = data.consumeInt(2, 8);
            Day[] periods = new Day[itemCount];
            for (int i = 0; i < itemCount; i++) {
                if (i > 0) {
                    cal.add(java.util.Calendar.DAY_OF_MONTH, data.consumeInt(2, 12));
                }
                periods[i] = new Day(cal.getTime());
                Number value;
                if (data.consumeBoolean()) {
                    value = Integer.valueOf(data.consumeInt(-1000, 1000));
                } else {
                    value = Double.valueOf(data.consumeInt(-1000, 1000));
                }
                series.add(periods[i], value);
            }

            int gap = data.consumeInt(0, itemCount - 2);
            Day left = periods[gap];
            Day right = periods[gap + 1];

            java.util.GregorianCalendar startCal =
                    new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
            startCal.setTime(left.getStart());
            startCal.add(java.util.Calendar.DAY_OF_MONTH, 1);

            java.util.GregorianCalendar rightCal =
                    new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
            rightCal.setTime(right.getStart());

            long daysBetween = (rightCal.getTimeInMillis() - startCal.getTimeInMillis()) / 86400000L;
            if (daysBetween < 0) {
                return null;
            }

            int startOffset = 0;
            int endOffset = 0;
            if (daysBetween > 0) {
                startOffset = data.consumeInt(0, (int) daysBetween);
                endOffset = data.consumeInt(startOffset, (int) daysBetween);
            }

            startCal.add(java.util.Calendar.DAY_OF_MONTH, startOffset);
            Day start = new Day(startCal.getTime());

            java.util.GregorianCalendar endCal =
                    new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
            endCal.setTime(startCal.getTime());
            endCal.add(java.util.Calendar.DAY_OF_MONTH, endOffset - startOffset);
            Day end = new Day(endCal.getTime());

            if (start.compareTo(end) > 0) {
                return null;
            }
            if (series.getIndex(start) >= 0 || series.getIndex(end) >= 0) {
                return null;
            }

            Scenario sc = new Scenario();
            sc.series = series;
            sc.start = start;
            sc.end = end;
            return sc;
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static final class Scenario {
        TimeSeries series;
        Day start;
        Day end;
    }
}
