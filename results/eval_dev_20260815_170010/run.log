    private static boolean sameDouble(double a, double b, double relTol) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b) || Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= relTol * scale;
    }

    private static boolean sameVector(Vector3D a, Vector3D b, double relTol) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameDouble(a.getX(), b.getX(), relTol)
            && sameDouble(a.getY(), b.getY(), relTol)
            && sameDouble(a.getZ(), b.getZ(), relTol);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
