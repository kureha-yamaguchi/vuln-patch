package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (int i = 0; i < anchors.length; i++) {
            exerciseEscapeCsv(anchors[i], true);
        }

        int units = data.consumeInt(1, 16);
        StringBuilder sb = new StringBuilder();
        boolean hasSupplementary = false;

        for (int i = 0; i < units; i++) {
            if (data.consumeBoolean()) {
                int codePoint = data.consumeInt(0x10000, 0x10FFFF);
                if (!Character.isDefined(codePoint)) {
                    codePoint = 0x10000 + Math.floorMod(codePoint - 0x10000, 0x10FFFF - 0x10000 + 1);
                    while (!Character.isDefined(codePoint)) {
                        codePoint++;
                        if (codePoint > 0x10FFFF) {
                            codePoint = 0x10000;
                        }
                    }
                }
                sb.append(Character.toChars(codePoint));
                hasSupplementary = true;
            } else {
                char c;
                do {
                    c = (char) data.consumeInt(0x20, 0x7E);
                } while (c == ',' || c == '"' || c == '\r' || c == '\n');
                sb.append(c);
            }
        }

        if (!hasSupplementary) {
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isDefined(codePoint)) {
                codePoint = 0x1F600;
            }
            sb.insert(data.consumeInt(0, sb.length()), new String(Character.toChars(codePoint)));
        }

        String fuzzed = sb.toString();
        exerciseEscapeCsv(fuzzed, true);
    }

    private static void exerciseEscapeCsv(String input, boolean validByConstruction) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract/oracle: CSV escaping only adds quoting/escaping when the input contains
             * CSV special characters. For inputs built here, we exclude comma, quote, CR, and LF,
             * so a correct implementation must return the original string unchanged.
             * A "fix" that merely avoids the crash by skipping translation/bookkeeping would break
             * this observable result.
             */
            if (validByConstruction && !input.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }

            // Sibling-agreement on equivalent public overload path:
            // translate(CharSequence) delegates to translate(CharSequence, Writer).
            try {
                CharSequenceTranslator escaper = StringEscapeUtils.ESCAPE_CSV;
                String translated = escaper.translate(input);
                if (!out.equals(translated)) {
                    throw new RuntimeException("[oracle:overload-agree] metamorphic violation: public API and translator overload disagree input=" + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(translated));
                }
            } catch (Throwable t) {
                if (shouldPropagate(t, validByConstruction)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagate(t, validByConstruction)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean shouldPropagate(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (t instanceof RuntimeException && ((RuntimeException) t).getMessage() != null
                && ((RuntimeException) t).getMessage().startsWith("[oracle:")) {
            return true;
        }
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("translate".equals(m)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7E) {
                        String hex = Integer.toHexString(ch);
                        b.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(ch);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
