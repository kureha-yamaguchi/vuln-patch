                int n = s.getItemCount();
                for (int i = 0; i < n; i++) {
                    RegularTimePeriod current = s.getTimePeriod(i);
                    int cmp = current.compareTo(p);
                    if (cmp == 0) {
                        return i;
                    }
                    if (cmp > 0) {
