package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            s.add(new Day(19, 8, 2005), Integer.valueOf(1));
            s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        } catch (RuntimeException e) {
            return;
        }

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        exerciseScenario(s, start, end, true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        String name = data.consumeAsciiString(16);
        if (name.length() == 0) {
            name = "S";
        }

        TimeSeries series;
        if (data.consumeBoolean()) {
            series = new TimeSeries(name);
        } else {
            series = new TimeSeries(name, "D", "R", Day.class);
        }

        int itemCount = data.consumeInt(2, 8);
        int baseYear = 1998 + data.consumeInt(0, 20);
        int dayOffset = data.consumeInt(0, 20);
        int[] offsets = new int[itemCount];

        for (int i = 0; i < itemCount; i++) {
            dayOffset += data.consumeInt(2, 15);
            offsets[i] = dayOffset;
            try {
                series.add(makeDay(baseYear, dayOffset), Integer.valueOf(data.consumeInt(-1000, 1000)));
            } catch (RuntimeException e) {
                return;
            }
            if (series.getItemCount() != series.getItems().size()) {
                throw new RuntimeException("[oracle:ctor-data-size] metamorphic violation: item count disagrees with items size after add count="
                        + series.getItemCount() + " size=" + series.getItems().size());
            }
        }

        Day start;
        Day end;

        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            int gapIndex = data.consumeInt(0, itemCount - 2);
            int left = offsets[gapIndex];
            int right = offsets[gapIndex + 1];
            int gapStart = left + 1;
            int gapEnd = right - 1;
            int sOff = data.consumeInt(gapStart, gapEnd);
            int eOff = data.consumeInt(sOff, gapEnd);
            start = makeDay(baseYear, sOff);
            end = makeDay(baseYear, eOff);
        } else if (mode == 1) {
            int before = offsets[0] - 10;
            int sOff = data.consumeInt(before, offsets[0] - 1);
            int eOff = data.consumeInt(sOff, offsets[0] - 1);
            start = makeDay(baseYear, sOff);
            end = makeDay(baseYear, eOff);
        } else if (mode == 2) {
            int after = offsets[itemCount - 1] + 1;
            int sOff = data.consumeInt(after, after + 10);
            int eOff = data.consumeInt(sOff, after + 20);
            start = makeDay(baseYear, sOff);
            end = makeDay(baseYear, eOff);
        } else if (mode == 3) {
            int i = data.consumeInt(0, itemCount - 1);
            int j = data.consumeInt(i, itemCount - 1);
            start = makeDay(baseYear, offsets[i]);
            end = makeDay(baseYear, offsets[j]);
        } else {
            int gapIndex = data.consumeInt(0, itemCount - 2);
            int left = offsets[gapIndex];
            int right = offsets[gapIndex + 1];
            int sOff = data.consumeInt(Math.max(0, left - 2), left + 1);
            int eOff = data.consumeInt(Math.max(sOff, right - 1), right + 2);
            start = makeDay(baseYear, sOff);
            end = makeDay(baseYear, eOff);
        }

        exerciseScenario(series, start, end, true);
    }

    private static Day makeDay(int year, int offsetFromJan1) {
        java.util.GregorianCalendar cal = new java.util.GregorianCalendar(year, java.util.Calendar.JANUARY, 1);
        cal.setLenient(true);
        cal.add(java.util.Calendar.DAY_OF_YEAR, offsetFromJan1);
        return new Day(cal.getTime());
    }

    private static void exerciseScenario(TimeSeries series, Day start, Day end, boolean validByConstruction) {
        if (start.compareTo(end) > 0) {
            return;
        }

        java.util.ArrayList expectedPeriods = new java.util.ArrayList();
        java.util.ArrayList expectedValues = new java.util.ArrayList();
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                expectedPeriods.add(p);
                expectedValues.add(series.getValue(i));
            }
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (Throwable t) {
            if (validByConstruction && isValidationFamily(t) && passesThroughCreateCopy(t)) {
                throw new RuntimeException("[oracle:valid-slice] metamorphic violation: createCopy rejected valid ordered bounds start="
                        + start + " end=" + end + " expectedCount=" + expectedPeriods.size(), t);
            }
            return;
        }

        /* Contract asserted: createCopy(start, end) returns a copy of the subset
           of items whose periods lie within the requested bounds. A throw-deleting
           or band-aid patch could return a non-empty/wrong slice instead of the
           correct empty or filtered copy, so we compare the returned sequence
           against an independent manual filter over the original series. */
        int reportedCount = copy.getItemCount();
        int itemsSize = copy.getItems().size();
        int expectedCount = expectedPeriods.size();
        if (reportedCount != itemsSize) {
            throw new RuntimeException("[oracle:copy-count-items] metamorphic violation: copy item count disagrees with getItems().size count="
                    + reportedCount + " size=" + itemsSize);
        }
        if (reportedCount != expectedCount) {
            throw new RuntimeException("[oracle:copy-manual-seq] metamorphic violation: copy item count differs from manual filter start="
                    + start + " end=" + end + " reported=" + reportedCount + " expected=" + expectedCount);
        }
        if (expectedCount == 0) {
            if (!copy.getItems().isEmpty()) {
                throw new RuntimeException("[oracle:copy-empty-list] metamorphic violation: empty manual slice produced non-empty copy size="
                        + copy.getItems().size());
            }
            return;
        }

        for (int i = 0; i < expectedCount; i++) {
            RegularTimePeriod actualPeriod = copy.getTimePeriod(i);
            RegularTimePeriod expectedPeriod = (RegularTimePeriod) expectedPeriods.get(i);
            if (actualPeriod.compareTo(expectedPeriod) != 0 || expectedPeriod.compareTo(actualPeriod) != 0) {
                throw new RuntimeException("[oracle:copy-period-seq] metamorphic violation: copied period differs at index="
                        + i + " actual=" + actualPeriod + " expected=" + expectedPeriod);
            }
            Number actualValue = copy.getValue(i);
            Number expectedValue = (Number) expectedValues.get(i);
            boolean equalValues = (actualValue == null) ? (expectedValue == null) : actualValue.equals(expectedValue);
            if (!equalValues) {
                throw new RuntimeException("[oracle:copy-value-seq] metamorphic violation: copied value differs at index="
                        + i + " actual=" + actualValue + " expected=" + expectedValue);
            }
        }

        RegularTimePeriod first = copy.getTimePeriod(0);
        RegularTimePeriod last = copy.getTimePeriod(copy.getItemCount() - 1);
        if (first.compareTo(start) < 0 || last.compareTo(end) > 0) {
            throw new RuntimeException("[oracle:copy-bounds] metamorphic violation: returned copy escapes requested bounds first="
                    + first + " last=" + last + " start=" + start + " end=" + end);
        }
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException
                || t instanceof ClassCastException
                || t instanceof ArithmeticException;
    }

    private static boolean passesThroughCreateCopy(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.jfree.data.time.TimeSeries".equals(e.getClassName())
                    && ("createCopy".equals(e.getMethodName()) || "getIndex".equals(e.getMethodName()) || "clone".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
