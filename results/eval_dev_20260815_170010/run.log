package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runLeafAnchor(true);
        runLeafAnchor(false);

        double x1 = bounded(data.consumeInt());
        double y1 = bounded(data.consumeInt());
        double x2 = bounded(data.consumeInt());
        double y2 = bounded(data.consumeInt());

        if (x1 == x2 && y1 == y2) {
            x2 = x1 + 1.0;
        }

        boolean plusInside = data.consumeBoolean();
        boolean minusInside = data.consumeBoolean();

        exerciseHalfPlane(x1, y1, x2, y2, plusInside, minusInside);

        if (data.remainingBytes() > 0) {
            double dx = (data.consumeInt(-1000, 1000)) / 1000.0;
            double dy = (data.consumeInt(-1000, 1000)) / 1000.0;
            exerciseHalfPlane(x1 + dx, y1 + dy, x2 + dx, y2 + dy, plusInside, minusInside);
        }
    }

    private static void runLeafAnchor(boolean inside) {
        try {
            BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(Boolean.valueOf(inside));
            PolygonsSet region = new PolygonsSet(tree);

            Vector2D[][] vertices = region.getVertices();
            double size = region.getSize();
            Vector2D barycenter = region.getBarycenter();

            /* Contract from computeGeometricalProperties/getVertices:
             * if getVertices() is empty and the leaf attribute is true, the region covers whole space:
             *   size = +inf, barycenter = NaN
             * if getVertices() is empty and the leaf attribute is false, the region is empty:
             *   size = 0, barycenter = (0,0)
             * A throw-deleting or branch-skipping patch would break these observable postconditions.
             */
            if (vertices.length != 0) {
                throw new RuntimeException("[oracle:leaf-shape] metamorphic violation: leaf region must expose zero vertex loops inside=" + inside + " got=" + vertices.length);
            }

            if (inside) {
                if (!Double.isInfinite(size) || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                    throw new RuntimeException("[oracle:leaf-whole] metamorphic violation: whole-space leaf must report infinite size and NaN barycenter size=" + size + " bx=" + barycenter.getX() + " by=" + barycenter.getY());
                }
            } else {
                if (size != 0.0 || barycenter.getX() != 0.0 || barycenter.getY() != 0.0) {
                    throw new RuntimeException("[oracle:leaf-empty] metamorphic violation: empty leaf must report zero size and origin barycenter size=" + size + " bx=" + barycenter.getX() + " by=" + barycenter.getY());
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void exerciseHalfPlane(double x1, double y1, double x2, double y2,
                                          boolean plusInside, boolean minusInside) {
        try {
            Line line = new Line(new Vector2D(x1, y1), new Vector2D(x2, y2));
            BSPTree<Euclidean2D> tree =
                    new BSPTree<Euclidean2D>(line.wholeHyperplane(),
                            new BSPTree<Euclidean2D>(Boolean.valueOf(plusInside)),
                            new BSPTree<Euclidean2D>(Boolean.valueOf(minusInside)),
                            null);

            PolygonsSet region = new PolygonsSet(tree);

            Vector2D[][] vertices = region.getVertices();
            double size = region.getSize();
            Vector2D barycenter = region.getBarycenter();

            /* Independent consistency check from the code shown:
             * when getVertices() exposes at least one open loop (v[0][0] == null),
             * computeGeometricalProperties must report an infinite polygon:
             *   size = +inf, barycenter = NaN.
             * We derive the premise from the object's own output (getVertices) and then
             * check the summary values (getSize/getBarycenter), so this still fires if
             * a patch merely suppresses a crash but leaves bookkeeping wrong.
             */
            if (vertices.length > 0 && vertices[0] != null && vertices[0].length > 0 && vertices[0][0] == null) {
                if (!Double.isInfinite(size) || !Double.isNaN(barycenter.getX()) || !Double.isNaN(barycenter.getY())) {
                    throw new RuntimeException("[oracle:open-loop] metamorphic violation: open-loop polygon must report infinite size and NaN barycenter size=" + size + " bx=" + barycenter.getX() + " by=" + barycenter.getY() + " loops=" + vertices.length);
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("MathIllegal") || n.contains("Invalid") || n.contains("NoData");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static double bounded(int v) {
        return v % 1000;
    }
}
