package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Calendar;
import java.util.List;
import java.util.TimeZone;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), new Integer(1));
        s.add(new Day(31, 1, 2006), new Integer(1));
        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);
        exerciseScenario(s, start, end, new Day(15, 12, 2005), true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int year = data.consumeInt(1990, 2030);
        int month = data.consumeInt(1, 12);
        int dayOfMonth = data.consumeInt(1, 28);
        int gap = data.consumeInt(2, 40);

        Day left = dayFromOffset(year, month, dayOfMonth, 0);
        Day right = dayFromOffset(year, month, dayOfMonth, gap);

        TimeSeries s = new TimeSeries(nonEmptyName(data.consumeAsciiString(16)), Day.class);

        int beforeCount = data.consumeInt(0, 4);
        for (int i = beforeCount; i >= 1; i--) {
            s.add(dayFromOffset(year, month, dayOfMonth, -i), new Integer(-i));
        }

        s.add(left, new Integer(1));
        s.add(right, new Integer(2));

        int afterCount = data.consumeInt(0, 4);
        for (int i = 1; i <= afterCount; i++) {
            s.add(dayFromOffset(year, month, dayOfMonth, gap + i), new Integer(2 + i));
        }

        int startOffset = data.consumeInt(1, gap - 1);
        int endOffset = data.consumeInt(startOffset, gap - 1);
        Day start = dayFromOffset(year, month, dayOfMonth, startOffset);
        Day end = dayFromOffset(year, month, dayOfMonth, endOffset);

        exerciseScenario(s, start, end, start, true);
    }

    private static void exerciseScenario(TimeSeries original, Day start, Day end, Day mutationDay, boolean validByConstruction) {
        try {
            int manualBefore = manualCountInRange(original, start, end);
            int startIndexBefore = original.getIndex(start);

            TimeSeries copy = original.createCopy(start, end);

            int copySizeByList = copy.getItems().size();
            if (copySizeByList != manualBefore) {
                throw new RuntimeException("[oracle:range-list] metamorphic violation: createCopy range size disagrees with source scan start="
                        + start + " end=" + end + " expected=" + manualBefore + " actual=" + copySizeByList);
            }

            int copyCountBeforeMutation = copy.getItemCount();
            if (copyCountBeforeMutation != copySizeByList) {
                throw new RuntimeException("[oracle:copy-consistency] metamorphic violation: copy count disagrees with copy items size count="
                        + copyCountBeforeMutation + " size=" + copySizeByList);
            }

            if (startIndexBefore >= 0) {
                throw new RuntimeException("[oracle:gap-probe] metamorphic violation: chosen start should be absent before mutation but getIndex returned "
                        + startIndexBefore + " for " + start);
            }

            original.add(mutationDay, new Integer(999));

            int startIndexAfter = original.getIndex(start);
            if (startIndexAfter < 0) {
                throw new RuntimeException("[oracle:getindex-flip] metamorphic violation: after adding the missing period, getIndex should find it start="
                        + start + " before=" + startIndexBefore + " after=" + startIndexAfter);
            }

            /* Contract asserted: createCopy creates a copy, so later mutations to the original
               must not change the returned series. A throw-deleting or alias-returning patch
               would violate this even if it suppresses the known exception. */
            if (copy.getItemCount() != copyCountBeforeMutation || copy.getItems().size() != copySizeByList) {
                throw new RuntimeException("[oracle:copy-independent] metamorphic violation: copy changed after mutating original start="
                        + start + " end=" + end + " beforeCount=" + copyCountBeforeMutation
                        + " afterCount=" + copy.getItemCount()
                        + " beforeSize=" + copySizeByList
                        + " afterSize=" + copy.getItems().size());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (validByConstruction && isRootCause(e)) {
                throw e;
            }
        }
    }

    private static int manualCountInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        List items = series.getItems();
        for (int i = 0; i < items.size(); i++) {
            TimeSeriesDataItem item = (TimeSeriesDataItem) items.get(i);
            RegularTimePeriod p = item.getPeriod();
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static boolean isOracleFailure(RuntimeException e) {
        String m = e.getMessage();
        return m != null && m.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException) && !(t instanceof NumberFormatException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.jfree.data.time.TimeSeries".equals(ste.getClassName())) {
                String method = ste.getMethodName();
                if ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String nonEmptyName(String s) {
        if (s == null || s.length() == 0) {
            return "S";
        }
        return s;
    }

    private static Day dayFromOffset(int year, int month, int dayOfMonth, int offsetDays) {
        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        c.clear();
        c.setLenient(true);
        c.set(year, month - 1, dayOfMonth, 12, 0, 0);
        c.add(Calendar.DAY_OF_MONTH, offsetDays);
        return new Day(c.getTime());
    }
}
