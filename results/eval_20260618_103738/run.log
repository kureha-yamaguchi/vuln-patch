package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            try {
                NumberUtils.createNumber(anchors[i]);
            } catch (NumberFormatException expected) {
                // Clean rejection is the correct behavior for these invalid inputs.
            }
        }

        for (int i = 0; i < 8; i++) {
            String raw = data.consumeAsciiString(32);
            StringBuilder sanitized = new StringBuilder();
            StringBuilder digitsOnly = new StringBuilder();
            StringBuilder nonDigitsOnly = new StringBuilder();

            for (int j = 0; j < raw.length(); j++) {
                char c = raw.charAt(j);
                if (c == '.' || c == 'e' || c == 'E' || c == 'l' || c == 'L') {
                    continue;
                }
                sanitized.append(c);
                if (c >= '0' && c <= '9') {
                    digitsOnly.append(c);
                } else {
                    nonDigitsOnly.append(c);
                }
            }

            String base;
            switch (data.consumeInt(0, 6)) {
                case 0:
                    base = "";
                    break;
                case 1:
                    base = "-";
                    break;
                case 2:
                    base = sanitized.toString();
                    break;
                case 3:
                    base = "-" + sanitized.toString();
                    break;
                case 4:
                    base = digitsOnly.toString();
                    break;
                case 5:
                    base = nonDigitsOnly.toString();
                    break;
                default:
                    int repeat = data.consumeInt(0, 16);
                    StringBuilder manyDigits = new StringBuilder(repeat);
                    for (int j = 0; j < repeat; j++) {
                        manyDigits.append((char) ('0' + data.consumeInt(0, 9)));
                    }
                    base = manyDigits.toString();
                    break;
            }

            String candidate = base + (data.consumeBoolean() ? 'L' : 'l');
            try {
                NumberUtils.createNumber(candidate);
            } catch (NumberFormatException expected) {
                // Invalid numeric text should be rejected cleanly.
            }
        }

        int n = data.consumeInt();
        String plain = Integer.toString(n);
        String suffixed = plain + (data.consumeBoolean() ? 'L' : 'l');

        Number a = NumberUtils.createNumber(plain);
        Number b = NumberUtils.createNumber(suffixed);

        if (a.longValue() != b.longValue()) {
            throw new RuntimeException("metamorphic violation: canonical integer and same value with L/l suffix must parse to the same numeric value");
        }
    }
}
