package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Bug: org.apache.commons.lang.NumberUtils.createNumber - 'L' suffix with empty mantissa; minimal input: "L" (or "l") */
        // ANCHOR: exact failing input from the test
        NumberUtils.createNumber("L");

        // Additional exact neighbor that also exercises the same path
        if (data.consumeBoolean()) {
            NumberUtils.createNumber("l");
        }

        // EXPLORE: mutate around the same shape - numbers ending with 'L'/'l'
        // 1) Optional sign + digits + 'L'/'l'
        String digits1 = digitsOnly(data.consumeAsciiString(16));
        String s1 = (data.consumeBoolean() ? "-" : "") + digits1 + (data.consumeBoolean() ? 'L' : 'l');
        NumberUtils.createNumber(s1);

        // 2) Optional sign + digits + optional '.' + digits + optional exponent + 'L'/'l'
        String digits2 = digitsOnly(data.consumeAsciiString(8));
        String digits3 = digitsOnly(data.consumeAsciiString(8));
        boolean addDec = data.consumeBoolean();
        boolean addExp = data.consumeBoolean();
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) sb.append('-');
        sb.append(digits2);
        if (addDec) {
            sb.append('.');
            sb.append(digits3);
        }
        if (addExp) {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
            if (data.consumeBoolean()) sb.append('-');
            else if (data.consumeBoolean()) sb.append('+');
            sb.append(digitsOnly(data.consumeAsciiString(4)));
        }
        sb.append(data.consumeBoolean() ? 'L' : 'l');
        NumberUtils.createNumber(sb.toString());

        // 3) Arbitrary ASCII prefix + 'L'/'l' suffix (e.g., "bobL")
        String ascii = data.consumeAsciiString(12);
        NumberUtils.createNumber(ascii + (data.consumeBoolean() ? 'L' : 'l'));

        // 4) Other variants from the test for coverage
        if (data.consumeBoolean()) NumberUtils.createNumber("bobL");
        if (data.consumeBoolean()) NumberUtils.createNumber("junk");
        if (data.consumeBoolean()) NumberUtils.createNumber("F");
        if (data.consumeBoolean()) NumberUtils.createNumber("f");
    }

    private static String digitsOnly(String s) {
        if (s == null) return "";
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') out.append(c);
        }
        return out.toString();
    }
}
