        // that consumes the whole input at index 0 (to stress the consumed>0 path).
        WholeInputTranslator whole = new WholeInputTranslator();
        for (String s : anchors) {
            try {
                java.io.StringWriter w = new java.io.StringWriter();
                whole.translate(s, w);
            } catch (java.io.IOException e) {
                throw new RuntimeException(e);
            }
        }

        // EXPLORE: build similar inputs (supplementary code points, optional CSV specials)
        int n = data.consumeInt(1, 6);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            int cp = 0x10000 + Math.abs(data.consumeInt()) % (0x10FFFF - 0x10000 + 1);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                char special;
                switch (Math.abs(data.consumeInt()) % 3) {
                    case 0: special = ','; break;
                    case 1: special = '"'; break;
