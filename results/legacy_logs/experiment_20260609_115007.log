package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Bug class: CharSequenceTranslator.translate; Minimal input: a single UTF-16 surrogate pair (two chars: high surrogate + low surrogate), e.g., "\uD83D\uDE30". */

        // ANCHOR: exact failing inputs from the test
        String[] anchors = new String[] { "\uD83D\uDE30", "\uD800\uDC00", "\uD834\uDD1E", "\uDBFF\uDFFD" };
        for (String s : anchors) {
            // Route through StringEscapeUtils to hit CharSequenceTranslator.translate indirectly
            org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
            // Directly hit CharSequenceTranslator.translate with a translator that consumes a surrogate pair as 2
            try {
                new ConsumingPairTranslator().translate(s, new java.io.StringWriter());
            } catch (java.io.IOException e) {
                throw new RuntimeException(e);
            }
        }

        // EXPLORE: fuzz around the same shape (ensure there's at least one surrogate pair)
        String fuzzInput;
        if (data.consumeBoolean()) {
            char high = (char) data.consumeInt(0xD800, 0xDBFF);
            char low  = (char) data.consumeInt(0xDC00, 0xDFFF);
            fuzzInput = new String(new char[] { high, low });
        } else {
            String prefix = data.consumeAsciiString(2);
            String suffix = data.consumeAsciiString(2);
            char high = (char) data.consumeInt(0xD800, 0xDBFF);
            char low  = (char) data.consumeInt(0xDC00, 0xDFFF);
            fuzzInput = prefix + new String(new char[] { high, low }) + suffix;
        }

        // Exercise both paths with fuzzed input
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv(fuzzInput);
        try {
            new ConsumingPairTranslator().translate(fuzzInput, new java.io.StringWriter());
        } catch (java.io.IOException e) {
            throw new RuntimeException(e);
        }
    }

    static final class ConsumingPairTranslator extends CharSequenceTranslator {
        @Override
        public int translate(CharSequence input, int index, java.io.Writer out) throws java.io.IOException {
            if (input == null) {
                return 0;
            }
            int len = input.length();
            if (index + 1 < len) {
                char c1 = input.charAt(index);
                char c2 = input.charAt(index + 1);
                if (Character.isHighSurrogate(c1) && Character.isLowSurrogate(c2)) {
                    // Intentionally return 2 to trigger the pos-advancement loop over a surrogate pair
                    return 2;
                }
            }
            return 0;
        }
    }
}
