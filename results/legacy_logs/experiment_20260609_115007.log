    // Translator that consumes the entire input from index 0 and writes it unchanged.
    static final class WholeInputTranslator extends CharSequenceTranslator {
        @Override
        public int translate(CharSequence input, int index, java.io.Writer out) throws java.io.IOException {
            if (index != 0) {
