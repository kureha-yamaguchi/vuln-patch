package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Bug class: StrBuilder.indexOf(String, int) scans beyond current size into internal buffer (uses buffer.length instead of size), matching deleted content.
           Minimal input shape: Build with base = prefix + pattern, then deleteFirst(pattern), then indexOf(pattern) should return -1 but returns prefix.length() on buggy version.
           Anchor: base "onetwothree", pattern "three". */
        // Anchor: exact reproduction of the failing test
        {
            StrBuilder sb = new StrBuilder("onetwothree");
            sb.deleteFirst("three");
            int idx = sb.indexOf("three");
            if (idx != -1) {
                throw new RuntimeException("expected:<-1> but was:<" + idx + ">");
            }
        }

        // Explore: fuzz similar shapes
        // Generate a non-empty pattern
        String pattern = data.consumeAsciiString(32);
        if (pattern == null || pattern.length() == 0) {
            pattern = "a";
        }

        // Generate a prefix and ensure it doesn't contain the pattern
        String prefix = data.consumeAsciiString(128);
        // Remove all occurrences of pattern from prefix to ensure the only occurrence is at the end
        if (pattern.length() > 0) {
            int idx = prefix.indexOf(pattern);
            while (idx != -1) {
                prefix = prefix.substring(0, idx) + prefix.substring(idx + pattern.length());
                idx = prefix.indexOf(pattern);
            }
        }
        // Ensure prefix length >= pattern length so indexOf's fast-path doesn't early-return
        if (prefix.length() < pattern.length()) {
            StringBuilder pad = new StringBuilder(prefix);
            for (int i = prefix.length(); i < pattern.length(); i++) {
                pad.append('X');
            }
            prefix = pad.toString();
        }

        // Build base so the only occurrence of pattern is at the end
        String base = prefix + pattern;

        // Perform the operations: delete the only occurrence at the end, then indexOf should be -1
        StrBuilder sb2 = new StrBuilder(base);
        sb2.deleteFirst(pattern);
        int res1 = sb2.indexOf(pattern);
        if (res1 != -1) {
            throw new RuntimeException("indexOf returned " + res1 + " after deleteFirst on end-occurrence (pattern='" + pattern + "')");
        }

        // Also directly call the patched method with an explicit start index to exercise the same code path
        int startIndex = data.consumeInt(0, prefix.length());
        int res2 = sb2.indexOf(pattern, startIndex);
        if (res2 != -1) {
            throw new RuntimeException("indexOf(pattern, startIndex=" + startIndex + ") returned " + res2 + " after deletion");
        }
    }
}
