        org.apache.commons.lang.LocaleUtils.isAvailableLocale(new java.util.Locale("en"));
        org.apache.commons.lang.LocaleUtils.isAvailableLocale(new java.util.Locale("en", "US"));
        org.apache.commons.lang.LocaleUtils.isAvailableLocale(new java.util.Locale("en", "US", "ZZZZ"));

        // EXPLORE: vary locales and call order to exercise the patched code under diverse inputs.
        int iters = data.consumeInt(0, 30);
        for (int i = 0; i < iters; i++) {
            // Randomly initialize via availableLocaleSet or availableLocaleList to explore both paths.
            if (data.consumeBoolean()) {
                if (data.consumeBoolean()) {
                    org.apache.commons.lang.LocaleUtils.availableLocaleSet();
                } else {
                    org.apache.commons.lang.LocaleUtils.availableLocaleList();
                }
            }

            java.util.Locale loc;
            if (data.consumeBoolean()) {
                // Also exercise null input to isAvailableLocale
                loc = null;
            } else {
                String lang = data.consumeAsciiString(8);
                String country = data.consumeAsciiString(8);
