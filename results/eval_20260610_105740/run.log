        LocaleUtils.isAvailableLocale(new java.util.Locale("en", "US", "ZZZZ"));
        LocaleUtils.isAvailableLocale(new java.util.Locale("fr"));
        LocaleUtils.isAvailableLocale(new java.util.Locale("fr", "CA"));
        LocaleUtils.isAvailableLocale(new java.util.Locale("qq"));
        LocaleUtils.isAvailableLocale(new java.util.Locale("qq", "ZZ"));

        // EXPLORE: generate many locales and call through the real API
        int iterations = data.consumeInt(1, 40);
        for (int i = 0; i < iterations; i++) {
            java.util.Locale locale;
            if (data.consumeBoolean()) {
                // Occasionally pass null to exercise contains(null) path
                locale = null;
            } else {
                String lang = data.consumeAsciiString(8);
                String country = data.consumeAsciiString(8);
                String variant = data.consumeAsciiString(12);

                // Normalize case variations to explore different shapes
                if (data.consumeBoolean()) {
                    lang = lang.toLowerCase(java.util.Locale.ENGLISH);
                } else {
                    lang = lang.toUpperCase(java.util.Locale.ENGLISH);
                }
                if (data.consumeBoolean()) {
                    country = country.toUpperCase(java.util.Locale.ENGLISH);
                } else {
                    country = country.toLowerCase(java.util.Locale.ENGLISH);
                }

                int form = data.consumeInt(0, 2);
                if (form == 0) {
                    locale = new java.util.Locale(lang);
                } else if (form == 1) {
                    locale = new java.util.Locale(lang, country);
                } else {
                    locale = new java.util.Locale(lang, country, variant);
                }
            }

            // Drive the real entry point that hits the patched line
            LocaleUtils.isAvailableLocale(locale);

            // Exercise related APIs with derived data to increase coverage through real code paths
            String cc = locale == null ? data.consumeAsciiString(2) : locale.getCountry();
            String ll = locale == null ? data.consumeAsciiString(2) : locale.getLanguage();
            LocaleUtils.languagesByCountry(cc);
            LocaleUtils.countriesByLanguage(ll);

            // Optionally compare against available lists/sets through public API
            if (data.consumeBoolean()) {
                java.util.List list = LocaleUtils.availableLocaleList();
                list.contains(locale);
            }
            if (data.consumeBoolean()) {
                java.util.Set set = LocaleUtils.availableLocaleSet();
                set.contains(locale);
            }
        }
    }
}
