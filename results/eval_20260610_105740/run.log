        gps.getPaint(1.0);
        gps.getPaint(-0.5); // triggers IAE on buggy version
        gps.getPaint(1.5);  // triggers IAE on buggy version

        // EXPLORE: generate varied inputs that are outside the bounds to exercise the root cause
        int scenarios = 1 + Math.abs(data.consumeInt()) % 5;
        for (int i = 0; i < scenarios; i++) {
            int ai = data.consumeInt(-1_000_000, 1_000_000);
            int bi = data.consumeInt(-1_000_000, 1_000_000);
            double lower = ai / 1000.0;
            double upper = lower + Math.abs(bi) / 1000.0 + 1e-9; // ensure upper > lower
            GrayPaintScale scale = new GrayPaintScale(lower, upper);

            double margin1 = ((double) Math.abs(data.consumeInt())) / 1000.0 + 0.0001;
            double margin2 = ((double) Math.abs(data.consumeInt())) / 1000.0 + 0.0001;

            // Inside bounds
            scale.getPaint(lower);
            scale.getPaint(upper);

            // Outside bounds
            scale.getPaint(lower - margin1);
            scale.getPaint(upper + margin2);

            // Extremes
            if (data.consumeBoolean()) {
                scale.getPaint(Double.NEGATIVE_INFINITY);
            } else {
                scale.getPaint(Double.POSITIVE_INFINITY);
            }

            int calls = 1 + Math.abs(data.consumeInt()) % 4;
            for (int j = 0; j < calls; j++) {
                boolean outside = data.consumeBoolean();
                if (outside) {
                    if (data.consumeBoolean()) {
                        double m = ((double) Math.abs(data.consumeInt())) / 10.0 + 1e-6;
                        scale.getPaint(lower - m);
                    } else {
                        double m = ((double) Math.abs(data.consumeInt())) / 10.0 + 1e-6;
                        scale.getPaint(upper + m);
                    }
                } else {
                    int rnd = data.consumeInt();
                    long ul = ((long) rnd) & 0xFFFFFFFFL;
                    double t = ul / (double) 0xFFFFFFFFL; // in [0,1]
                    double val = lower + t * (upper - lower);
                    scale.getPaint(val);
                }
            }
        }

        // Additional exploration on default bounds [0,1] with diverse out-of-range values
