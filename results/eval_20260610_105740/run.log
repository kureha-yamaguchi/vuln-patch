package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact input from the failing test
        String anchorPattern = "it''s a {0,lower} 'test'!";
        try {
            new ExtendedMessageFormat(anchorPattern);
        } catch (OutOfMemoryError e) {
            throw e;
        } catch (RuntimeException e) {
            // Ignore non-OOM runtime exceptions to proceed with exploration
        }

        // Explore: generate varied inputs that contain at least one escaped quote (two single quotes)
        int iterations = 1;
        try {
            iterations = 1 + data.consumeInt(0, 8);
        } catch (RuntimeException e) {
            // keep default iterations
        }

        for (int i = 0; i < iterations; i++) {
            if (data.remainingBytes() == 0 && i > 0) {
                break;
            }

            String prefix = data.consumeAsciiString(50).replace('{','(').replace('}',')');
            String middle = data.consumeAsciiString(30).replace('{','(').replace('}',')');
            String suffix = data.consumeAsciiString(50).replace('{','(').replace('}',')');

            StringBuilder sb = new StringBuilder();

            if (data.consumeBoolean()) {
                sb.append(prefix);
            } else {
                if (prefix.length() > 0) {
                    sb.append(prefix.substring(0, Math.min(5, prefix.length())));
                }
            }

            // Ensure the key property: at least one escaped quote sequence
            sb.append("''");

            // Mix in varied content
            sb.append(middle);

            // Optionally add more escaped quotes and/or quoted sections
            int extras = data.consumeInt(0, 3);
            for (int j = 0; j < extras; j++) {
                if (data.consumeBoolean()) {
                    sb.append("''");
                }
                if (data.consumeBoolean()) {
                    String q = data.consumeAsciiString(20).replace('{','(').replace('}',')');
                    sb.append('\'').append(q).append('\'');
                }
                if (data.consumeBoolean()) {
                    sb.append(data.consumeAsciiString(10).replace('{','(').replace('}',')'));
                }
            }

            // Optionally include a simple, valid argument placeholder to exercise more paths
            if (data.consumeBoolean()) {
                int argIndex = data.consumeInt(0, 2);
                sb.append(" {").append(argIndex).append("} ");
            }

            sb.append(suffix);

            String pattern = sb.toString();

            try {
                ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern);
                if (pattern.indexOf("{0}") >= 0) {
                    try {
                        emf.format(new Object[] { data.consumeAsciiString(16) });
                    } catch (RuntimeException ignore) {
                        // Ignore non-OOM runtime exceptions during formatting
                    }
                }
            } catch (OutOfMemoryError e) {
                throw e;
            } catch (RuntimeException e) {
                // Ignore invalid patterns and continue fuzzing
            }
        }
    }
}
