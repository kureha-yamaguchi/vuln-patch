package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing test input to trigger the buggy behavior
        {
            TimeSeries s = new TimeSeries("S");
            s.add(new Day(19, 8, 2005), 1.0);
            s.add(new Day(31, 1, 2006), 1.0);
            try {
                s.createCopy(new Day(1, 12, 2005), new Day(18, 1, 2006));
            } catch (CloneNotSupportedException e) {
                throw new RuntimeException(e);
            }
        }

        // EXPLORE: generate varied inputs that put start and end between the same adjacent pair
        // of data items (start <= end), which previously caused endIndex < startIndex.
        TimeSeries s2 = new TimeSeries("F");
        int count = data.consumeInt(2, 8); // ensure at least two data items
        int year = 2000 + data.consumeInt(0, 40); // keep well within valid range
        int month = data.consumeInt(1, 12);
        int day = data.consumeInt(1, 28); // avoid invalid DOM for months

        Day curr = new Day(day, month, year);
        java.util.ArrayList<Day> items = new java.util.ArrayList<Day>();
        java.util.ArrayList<Integer> gaps = new java.util.ArrayList<Integer>();

        for (int i = 0; i < count; i++) {
            items.add(curr);
            s2.add(curr, (double) i);
            if (i < count - 1) {
                int inc = data.consumeInt(2, 15); // ensure there is at least 1 day strictly between items
                gaps.add(inc);
                RegularTimePeriod rp = curr;
                for (int k = 0; k < inc; k++) {
                    rp = rp.next();
                    if (rp == null) break;
                }
                if (rp == null || !(rp instanceof Day)) {
                    // out-of-range, stop building further items
                    break;
                }
                curr = (Day) rp;
            }
        }

        if (items.size() >= 2) {
            int pairs = items.size() - 1;
            int trials = 1 + data.consumeInt(0, 5);
            for (int t = 0; t < trials; t++) {
                int gi = data.consumeInt(0, pairs - 1);
                // gap size between items.get(gi) and items.get(gi + 1)
                int gapSize = gaps.get(gi);
                if (gapSize < 2) {
                    // shouldn't happen given inc >= 2, but be safe
                    continue;
                }
                int startOffset = data.consumeInt(1, gapSize - 1);
                int endOffset = data.consumeInt(startOffset, gapSize - 1); // ensure start <= end

                RegularTimePeriod rpStart = items.get(gi);
                for (int k = 0; k < startOffset; k++) {
                    rpStart = rpStart.next();
                    if (rpStart == null) break;
                }
                RegularTimePeriod rpEnd = items.get(gi);
                for (int k = 0; k < endOffset; k++) {
                    rpEnd = rpEnd.next();
                    if (rpEnd == null) break;
                }
                if (rpStart == null || rpEnd == null) {
                    continue;
                }

                try {
                    s2.createCopy(rpStart, rpEnd);
                } catch (CloneNotSupportedException e) {
                    throw new RuntimeException(e);
                }
            }
        }
    }
}
