    private static Boolean callTarget(String s, boolean validByConstruction) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String forceLength(String s, int len, char fill) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuffer sb = new StringBuffer(s);
        while (sb.length() < len) {
            sb.append(fill);
        }
        return sb.toString();
    }

    private static String randomCaseVariant(String s, FuzzedDataProvider data) {
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (data.consumeBoolean()) {
                if (c >= 'a' && c <= 'z') {
                    sb.append((char) (c - ('a' - 'A')));
                } else {
                    sb.append(c);
                }
            } else {
                if (c >= 'A' && c <= 'Z') {
                    sb.append((char) (c + ('a' - 'A')));
                } else {
                    sb.append(c);
                }
            }
        }
        return sb.toString();
    }

    private static boolean equalsIgnoreCaseAscii(String a, String b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char x = a.charAt(i);
            char y = b.charAt(i);
            if (x == y) {
                continue;
            }
            if (x >= 'A' && x <= 'Z') {
                x = (char) (x + ('a' - 'A'));
            }
            if (y >= 'A' && y <= 'Z') {
                y = (char) (y + ('a' - 'A'));
            }
            if (x != y) {
                return false;
            }
        }
        return true;
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
