            if (!p.equals(fromPeriods)) {
                throw new RuntimeException("[oracle:" + tag + "-period-list] metamorphic violation: getTimePeriods() view and getTimePeriod(i) disagree"
                        + " index=" + i
                        + " listPeriod=" + fromPeriods
                        + " timePeriod=" + p);
            }
        }
