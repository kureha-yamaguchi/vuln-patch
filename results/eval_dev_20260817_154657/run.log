package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1eE");

        String digits = onlyDigits(data.consumeAsciiString(8));
        if (digits.length() == 0) {
            digits = "1";
        }

        String tail = data.consumeAsciiString(8);
        boolean negative = data.consumeBoolean();

        String sign = negative ? "-" : "";
        String candidate;
        switch (data.consumeInt(0, 5)) {
            case 0:
                candidate = sign + digits + "eE";
                break;
            case 1:
                candidate = sign + digits + "Ee";
                break;
            case 2:
                candidate = sign + digits + "e" + tail + "E";
                break;
            case 3:
                candidate = sign + digits + "E" + tail + "e";
                break;
            case 4:
                candidate = sign + digits + tail + "eE";
                break;
            default:
                candidate = sign + digits + tail + "Ee";
                break;
        }

        if (candidate.indexOf('.') == -1 && candidate.indexOf('e') != -1 && candidate.indexOf('E') != -1) {
            NumberUtils.createNumber(candidate);
        }
    }

    private static String onlyDigits(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }
}
