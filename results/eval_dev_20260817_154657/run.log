package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        String digits = onlyDigits(data.consumeAsciiString(8));
        if (digits.length() == 0) {
            digits = "1";
        }
        String frac = onlyDigits(data.consumeAsciiString(6));
        if (frac.length() == 0) {
            frac = "0";
        }
        int exponent = data.consumeInt(-20, 20);
        boolean negative = data.consumeBoolean();

        String sign = negative ? "-" : "";
        String sciLower = sign + digits + "e" + exponent;
        String sciUpper = sign + digits + "E" + exponent;
        String sciWithDecimalUpper = sign + digits + ".0E" + exponent;
        String decimal = sign + digits + "." + frac;
        String decimalD = decimal + "D";
        String decimald = decimal + "d";
        String decimalF = decimal + "F";
        String decimalf = decimal + "f";
        String integerL = sign + digits + "L";
        String integerl = sign + digits + "l";
        String hex = (negative ? "-0x" : "0x") + toHex(onlyHex(data.consumeAsciiString(8)));
        if (hex.equals("0x") || hex.equals("-0x")) {
            hex = "0x1";
        }

        exerciseCreateNumber(sciLower, true);
        exerciseCreateNumber(sciUpper, true);
        exerciseCreateNumber(sciWithDecimalUpper, true);
        exerciseCreateNumber(decimal, true);
        exerciseCreateNumber(decimalD, true);
        exerciseCreateNumber(decimald, true);
        exerciseCreateNumber(decimalF, true);
        exerciseCreateNumber(decimalf, true);
        exerciseCreateNumber(integerL, true);
        exerciseCreateNumber(integerl, true);
        exerciseCreateNumber(hex, true);

        /* Contract/oracle:
         * These strings are different spellings of the same numeric quantity, and
         * createNumber is a numeric parser. A patch that merely suppresses the
         * throw or skips a branch can still return the wrong value; these
         * equivalence checks detect that.
         */
        checkEquivalentScientificExponentCase(sciLower, sciUpper);
        checkRedundantDecimalPointEquivalence(sciLower, sciWithDecimalUpper);
        checkSuffixCaseEquivalence(decimalD, decimald);
        checkSuffixCaseEquivalence(decimalF, decimalf);
        checkSuffixCaseEquivalence(integerL, integerl);
    }

    private static void exerciseAnchor() {
        try {
            NumberUtils.createNumber("1234.5");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRedundantDecimalPointEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: integer-mantissa scientific notation and the same notation with a redundant .0 before the exponent must denote the same quantity inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRootCause(t)) {
                return;
            }
        }
    }

    private static void checkSuffixCaseEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:type-suffix-case-equivalence] metamorphic violation: suffix case changed value inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRootCause(t)) {
                return;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String m = stack[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createInteger".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(m) || "charAt".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            return toBigDecimal(a).compareTo(toBigDecimal(b)) == 0;
        } catch (RuntimeException ex) {
            return false;
        }
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float || n instanceof Double) {
            return new BigDecimal(n.toString());
        }
        return new BigDecimal(n.toString());
    }

    private static String onlyDigits(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String onlyHex(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String toHex(String s) {
        if (s.length() == 0) {
            return "1";
        }
        return s;
    }
}
