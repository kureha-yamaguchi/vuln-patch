    private static String buildBoundaryProbe(FuzzedDataProvider data) {
        char suffix = data.consumeBoolean() ? 'l' : 'L';
        switch (data.consumeInt(0, 11)) {
            case 0:
                return String.valueOf(suffix);
            case 1:
                return "+" + suffix;
            case 2:
                return "-" + suffix;
            case 3:
                return "." + suffix;
            case 4:
                return "e" + suffix;
            case 5:
                return "E" + suffix;
            case 6:
                return "+" + buildDigits(data, 1, 4) + suffix;
            case 7:
