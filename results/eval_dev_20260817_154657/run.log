package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int year = data.consumeInt(1990, 2020);
            int month = data.consumeInt(1, 12);
            int leftDay = data.consumeInt(1, 20);
            int gapSize = data.consumeInt(1, 40);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);

            Day left;
            Day right;
            try {
                left = new Day(leftDay, month, year);
                right = addDays(left, gapSize + 1);
            } catch (RuntimeException e) {
                return;
            }

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(addDays(left, -i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(addDays(right, i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            try {
                checkSeriesViewConsistency(series, "source");
                checkIndexRoundTrip(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);

            Day start;
            Day end;
            try {
                start = addDays(left, startOffset);
                end = addDays(left, endOffset);
            } catch (RuntimeException e) {
                return;
            }

            if (start.compareTo(end) > 0) {
                return;
            }

            int manualCount = 0;
            int rawStartIndex;
            int rawEndIndex;
            try {
                for (int i = 0; i < series.getItemCount(); i++) {
                    RegularTimePeriod p = series.getTimePeriod(i);
                    if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                        manualCount++;
                    }
                }
                rawStartIndex = series.getIndex(start);
                rawEndIndex = series.getIndex(end);
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:index-on-valid-periods] metamorphic violation: getIndex should not fail on valid constructed periods", e);
                }
                return;
            }

            if (manualCount != 0) {
                throw new RuntimeException("[oracle:gap-shape] metamorphic violation: constructed range inside a real gap must contain no items"
                        + " manualCount=" + manualCount
                        + " start=" + start
                        + " end=" + end);
            }

            if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
                throw new RuntimeException("[oracle:gap-absent] metamorphic violation: both endpoints chosen inside the gap must be absent"
                        + " rawStartIndex=" + rawStartIndex
                        + " rawEndIndex=" + rawEndIndex
                        + " start=" + start
                        + " end=" + end);
            }

            int transformedStart = normalizeStartIndex(rawStartIndex);
            int transformedEnd = normalizeEndIndex(rawEndIndex);
            if (!(transformedEnd < transformedStart)) {
                return;
            }

            try {
                /*
                 * Contract asserted:
                 * createCopy(start, end) returns the inclusive subseries for ordered, non-null periods.
                 * For a valid range wholly inside a real gap, the correct result is an empty series.
                 * The patched branch reaches super.clone() and then resets copy.data to a new empty list,
                 * so a throw-deleting or guard-skipping patch can still return the wrong/non-empty view or
                 * a copy whose shared state readers disagree. We therefore check emptiness, internal view
                 * consistency, getIndex round-trips, overload agreement, and source/copy independence.
                 */
                TimeSeries copy = series.createCopy(start, end);
                checkSeriesViewConsistency(copy, "gapCopy");
                checkIndexRoundTrip(copy, "gapCopy");

                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty copy"
                            + " copyCount=" + copy.getItemCount()
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " transformedStart=" + transformedStart
                            + " transformedEnd=" + transformedEnd
                            + " start=" + start
                            + " end=" + end);
                }

                checkBoundaryStepRight(series, start, right);
                checkBoundaryStepLeft(series, left, end);

                Day probe = addDays(right, afterCount + 1);
                int copyCountBefore = copy.getItemCount();
                series.add(probe, Integer.valueOf(data.consumeInt(-1000, 1000)));
                checkSeriesViewConsistency(series, "sourceAfterMutation");
                checkIndexRoundTrip(series, "sourceAfterMutation");
                checkSeriesViewConsistency(copy, "gapCopyAfterSourceMutation");
                if (copy.getItemCount() != copyCountBefore || copy.getItems().size() != copyCountBefore
                        || copy.getTimePeriods().size() != copyCountBefore) {
                    throw new RuntimeException("[oracle:clone-independence] metamorphic violation: copy returned for empty gap must be independent of subsequent source mutations"
                            + " before=" + copyCountBefore
                            + " afterCount=" + copy.getItemCount()
                            + " afterItems=" + copy.getItems().size()
                            + " afterPeriods=" + copy.getTimePeriods().size()
                            + " probe=" + probe);
                }

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                checkSeriesViewConsistency(byPeriod, "byPeriod");
                checkSeriesViewConsistency(byIndex, "byIndex");
                checkIndexRoundTrip(byPeriod, "byPeriod");
                checkIndexRoundTrip(byIndex, "byIndex");
                assertEquivalentSingletonCopies(byPeriod, byIndex, chosen);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isValidationException(e)) {
                    if (isRootCause(e)) {
                        throw new RuntimeException("[oracle:valid-empty-gap] metamorphic violation: valid ordered non-null periods inside a real gap must not be rejected"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex
                                + " transformedStart=" + transformedStart
                                + " transformedEnd=" + transformedEnd, e);
                    }
                    return;
                }
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        checkSeriesViewConsistency(s, "anchorSource");
        checkIndexRoundTrip(s, "anchorSource");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int rawStartIndex = s.getIndex(start);
        int rawEndIndex = s.getIndex(end);
        int transformedStart = normalizeStartIndex(rawStartIndex);
        int transformedEnd = normalizeEndIndex(rawEndIndex);

        if (!(rawStartIndex < 0 && rawEndIndex < 0 && transformedEnd < transformedStart)) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor must construct the known empty-gap shape"
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex
                    + " transformedStart=" + transformedStart
                    + " transformedEnd=" + transformedEnd);
        }

        try {
            TimeSeries copy = s.createCopy(start, end);
            checkSeriesViewConsistency(copy, "anchorCopy");
            checkIndexRoundTrip(copy, "anchorCopy");

            if (copy.getItemCount() != 0) {
                throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor empty-gap copy must be empty"
                        + " copyCount=" + copy.getItemCount());
            }

            checkBoundaryStepRight(s, start, new Day(31, 1, 2006));
            checkBoundaryStepLeft(s, new Day(19, 8, 2005), end);

            s.add(new Day(1, 2, 2006), Integer.valueOf(2));
            checkSeriesViewConsistency(s, "anchorSourceAfterMutation");
            checkSeriesViewConsistency(copy, "anchorCopyAfterMutation");
            if (copy.getItemCount() != 0 || copy.getItems().size() != 0 || copy.getTimePeriods().size() != 0) {
                throw new RuntimeException("[oracle:anchor-clone-independence] metamorphic violation: anchor copy must stay empty after source mutation"
                        + " copyCount=" + copy.getItemCount()
                        + " itemSize=" + copy.getItems().size()
                        + " periodSize=" + copy.getTimePeriods().size());
            }
        } catch (RuntimeException e) {
            if (isValidationException(e) && isRootCause(e)) {
                throw new RuntimeException("[oracle:anchor-valid-gap] metamorphic violation: the exact regression-test gap is valid and must not be rejected", e);
            }
            throw e;
        }
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
        TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

        checkSeriesViewConsistency(byBoundary, "boundaryRightByBoundary");
        checkSeriesViewConsistency(byIndex, "boundaryRightByIndex");
        checkIndexRoundTrip(byBoundary, "boundaryRightByBoundary");
        checkIndexRoundTrip(byIndex, "boundaryRightByIndex");

        assertEquivalentSingletonCopies(byBoundary, byIndex, rightIndex);
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd)
            throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
            throw new RuntimeException("[oracle:left-boundary-present] metamorphic violation: left boundary period must exist"
                    + " left=" + exactLeft
                    + " leftIndex=" + leftIndex);
        }

        TimeSeries byBoundary = series.createCopy(exactLeft, absentEnd);
        TimeSeries byIndex = series.createCopy(leftIndex, leftIndex);

        checkSeriesViewConsistency(byBoundary, "boundaryLeftByBoundary");
        checkSeriesViewConsistency(byIndex, "boundaryLeftByIndex");
        checkIndexRoundTrip(byBoundary, "boundaryLeftByBoundary");
        checkIndexRoundTrip(byIndex, "boundaryLeftByIndex");

        assertEquivalentSingletonCopies(byBoundary, byIndex, leftIndex);
    }

    private static void assertEquivalentSingletonCopies(TimeSeries a, TimeSeries b, int chosen) {
        if (a.getItemCount() != 1 || b.getItemCount() != 1) {
            throw new RuntimeException("[oracle:singleton-size] metamorphic violation: equivalent singleton createCopy calls must both return size 1"
                    + " chosen=" + chosen
                    + " leftCount=" + a.getItemCount()
                    + " rightCount=" + b.getItemCount());
        }

        RegularTimePeriod pa = a.getTimePeriod(0);
        RegularTimePeriod pb = b.getTimePeriod(0);
        if (!pa.equals(pb)) {
            throw new RuntimeException("[oracle:singleton-period] metamorphic violation: equivalent singleton createCopy calls must copy the same period"
                    + " chosen=" + chosen
                    + " left=" + pa
                    + " right=" + pb);
        }

        Number va = a.getValue(0);
        Number vb = b.getValue(0);
        if (va == null ? vb != null : !va.equals(vb)) {
            throw new RuntimeException("[oracle:singleton-value] metamorphic violation: equivalent singleton createCopy calls must copy the same value"
                    + " chosen=" + chosen
                    + " left=" + va
                    + " right=" + vb);
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        java.util.List items = series.getItems();
        java.util.Collection periods = series.getTimePeriods();

        if (items.size() != count) {
            throw new RuntimeException("[oracle:view-items-size] metamorphic violation: getItems().size() must equal getItemCount()"
                    + " label=" + label
                    + " count=" + count
                    + " itemsSize=" + items.size());
        }
        if (periods.size() != count) {
            throw new RuntimeException("[oracle:view-periods-size] metamorphic violation: getTimePeriods().size() must equal getItemCount()"
                    + " label=" + label
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem byIndex = series.getDataItem(i);
            RegularTimePeriod tp = series.getTimePeriod(i);
            if (byIndex == null) {
                throw new RuntimeException("[oracle:view-null-item] metamorphic violation: getDataItem(i) must be non-null for every valid index"
                        + " label=" + label
                        + " index=" + i);
            }
            if (!tp.equals(byIndex.getPeriod())) {
                throw new RuntimeException("[oracle:view-period-match] metamorphic violation: getTimePeriod(i) must match getDataItem(i).getPeriod()"
                        + " label=" + label
                        + " index=" + i
                        + " timePeriod=" + tp
                        + " itemPeriod=" + byIndex.getPeriod());
            }
            Number fromItem = byIndex.getValue();
            Number fromSeries = series.getValue(i);
            if (fromItem == null ? fromSeries != null : !fromItem.equals(fromSeries)) {
                throw new RuntimeException("[oracle:view-value-match] metamorphic violation: getValue(i) must match getDataItem(i).getValue()"
                        + " label=" + label
                        + " index=" + i
                        + " itemValue=" + fromItem
                        + " seriesValue=" + fromSeries);
            }
        }
    }

    private static void checkIndexRoundTrip(TimeSeries series, String label) {
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            int roundTrip = series.getIndex(p);
            if (roundTrip != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + roundTrip
                        + " period=" + p);
            }
        }
    }

    private static int normalizeStartIndex(int rawStartIndex) {
        if (rawStartIndex < 0) {
            return -(rawStartIndex + 1);
        }
        return rawStartIndex;
    }

    private static int normalizeEndIndex(int rawEndIndex) {
        if (rawEndIndex < 0) {
            return -(rawEndIndex + 1) - 1;
        }
        return rawEndIndex;
    }

    private static Day addDays(Day base, int delta) {
        RegularTimePeriod p = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                p = p.next();
                if (p == null) {
                    throw new IllegalArgumentException("Day overflow while moving forward");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                p = p.previous();
                if (p == null) {
                    throw new IllegalArgumentException("Day overflow while moving backward");
                }
            }
        }
        return (Day) p;
    }

    private static boolean isValidationException(Throwable t) {
