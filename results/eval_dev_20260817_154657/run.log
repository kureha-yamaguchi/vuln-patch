package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String s : anchors) {
            try {
                String out = StringEscapeUtils.escapeCsv(s);
                /*
                 * Contract/oracle: escapeCsv only adds CSV quoting/escaping when required.
                 * For strings that contain none of CSV special characters (comma, quote, CR, LF),
                 * the correct observable result is the unchanged input. All anchor inputs are
                 * valid, well-formed surrogate pairs with no CSV special characters.
                 */
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:escapecsv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isOracleFailure(t)) {
                    throw t;
                }
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(8));
        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        if (!Character.isValidCodePoint(codePoint) || !Character.isSupplementaryCodePoint(codePoint)) {
            return;
        }

        String pair = new String(Character.toChars(codePoint));
        int shape = data.consumeInt(0, 3);
        String candidate;
        switch (shape) {
            case 0:
                candidate = pair;
                break;
            case 1:
                candidate = prefix + pair;
                break;
            case 2:
                candidate = pair + suffix;
                break;
            default:
                candidate = prefix + pair + suffix;
                break;
        }

        try {
            String out = StringEscapeUtils.escapeCsv(candidate);
            /*
             * Contract/oracle: this candidate is built to be valid by construction and CSV-safe:
             * prefix/suffix are ASCII with ',', '"', '\r', '\n' removed, and pair is a valid
             * supplementary code point encoded as a real surrogate pair. Therefore escapeCsv
             * should return the same string. A throw-deleting or branch-skipping patch that
             * silently drops or mangles surrogate handling violates this observable result.
             */
            if (!candidate.equals(out)) {
                throw new RuntimeException("[oracle:escapecsv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(candidate) + " lhs=" + printable(out) + " rhs=" + printable(candidate));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String maybeArbitrary = data.consumeRemainingAsString();
        try {
            StringEscapeUtils.escapeCsv(maybeArbitrary);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            /*
             * For arbitrary fuzz strings we cannot guarantee validity by construction, and
             * StringIndexOutOfBoundsException is a generic malformed-input signature. Swallow.
             */
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafe(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c).toUpperCase();
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
