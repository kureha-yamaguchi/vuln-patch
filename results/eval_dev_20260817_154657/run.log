package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        callToBoolean("off", true);

        callToBoolean("oof", true);
        callToBoolean("yep", true);
        callToBoolean("tru", true);

        String fuzz = data.consumeAsciiString(16);

        String len3 = buildLengthThreeCandidate(data, fuzz);
        callToBoolean(len3, true);

        String tPrefixed = forceFirstChar(buildLengthThreeCandidate(data, fuzz), data.consumeBoolean() ? 't' : 'T');
        callToBoolean(tPrefixed, true);

        String nonYLen3 = forceNonYFirstChar(buildLengthThreeCandidate(data, fuzz), data);
        callToBoolean(nonYLen3, true);

        /* Contract/oracle:
         * BooleanUtils.toBoolean(String) is a case-insensitive parser for the accepted
         * true tokens visible in the implementation/tests: "true", "on", and "yes".
         * Therefore, for any mixed-case spelling of one of those canonical tokens,
         * parsing it must agree with parsing its lowercase form; and the lowercase
         * canonical token must parse to true. A throw-deleting or branch-skipping patch
         * could avoid the crash but silently return a wrong result, which this detects.
         */
        String canonicalTrue = pickCanonicalTrueToken(data);
        String mixedCaseTrue = randomizeAsciiCase(canonicalTrue, data);
        Boolean lhs = tryToBooleanForOracle(mixedCaseTrue);
        Boolean rhs = tryToBooleanForOracle(toLowerAscii(mixedCaseTrue));
        if (lhs != null && rhs != null) {
            if (!lhs.equals(rhs)) {
                throw new RuntimeException(
                    "[oracle:case-eq] metamorphic violation: case-insensitive parse disagrees input="
                        + printable(mixedCaseTrue) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!rhs.booleanValue()) {
                throw new RuntimeException(
                    "[oracle:case-eq] metamorphic violation: canonical accepted true token parsed false input="
                        + printable(mixedCaseTrue) + " lhs=" + lhs + " rhs=" + rhs);
            }
        }
    }

    private static void callToBoolean(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static Boolean tryToBooleanForOracle(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildLengthThreeCandidate(FuzzedDataProvider data, String seed) {
        char[] out = new char[3];
        for (int i = 0; i < 3; i++) {
            char c;
            if (seed != null && seed.length() > i) {
                c = seed.charAt(i);
            } else {
                c = (char) ('a' + data.consumeInt(0, 25));
            }
            if (c == 0) {
                c = 'a';
            }
            out[i] = c;
        }
        return new String(out);
    }

    private static String forceFirstChar(String s, char ch) {
        char[] chars = new char[] { ch, 'a', 'a' };
        if (s != null && s.length() > 1) {
            chars[1] = s.charAt(1);
        }
        if (s != null && s.length() > 2) {
            chars[2] = s.charAt(2);
        }
        return new String(chars);
    }

    private static String forceNonYFirstChar(String s, FuzzedDataProvider data) {
        char[] chars = new char[] { 'o', 'f', 'f' };
        if (s != null && s.length() > 0) {
            char c = s.charAt(0);
            if (c != 'Y') {
                chars[0] = c == 0 ? 'o' : c;
            } else {
                chars[0] = data.consumeBoolean() ? 'o' : 't';
            }
        }
        if (s != null && s.length() > 1) {
            chars[1] = s.charAt(1) == 0 ? 'f' : s.charAt(1);
        }
        if (s != null && s.length() > 2) {
            chars[2] = s.charAt(2) == 0 ? 'f' : s.charAt(2);
        }
        if (chars[0] == 'Y') {
            chars[0] = 'o';
        }
        return new String(chars);
    }

    private static String pickCanonicalTrueToken(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 2)) {
            case 0:
                return "true";
            case 1:
                return "on";
            default:
                return "yes";
        }
    }

    private static String randomizeAsciiCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            char c = chars[i];
            if (c >= 'a' && c <= 'z') {
                chars[i] = data.consumeBoolean() ? (char) (c - ('a' - 'A')) : c;
            } else if (c >= 'A' && c <= 'Z') {
                chars[i] = data.consumeBoolean() ? c : (char) (c + ('a' - 'A'));
            }
        }
        return new String(chars);
    }

    private static String toLowerAscii(String s) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            char c = chars[i];
            if (c >= 'A' && c <= 'Z') {
                chars[i] = (char) (c + ('a' - 'A'));
            }
        }
        return new String(chars);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
