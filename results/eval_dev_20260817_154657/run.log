package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

/*
 * Oracle notes:
 * 1) A numeric type suffix ('F'/'f'/'D'/'d'/'L'/'l') requests a return type but must not change the
 *    represented numeric quantity for literals that are otherwise the same. The bundled tests shown
 *    for NumberUtils.createNumber exercise exactly that contract.
 * 2) For a non-negative integer significand with a non-negative decimal exponent, "N e K" denotes
 *    the same quantity as the plain decimal string formed by appending K zeros to N. Both sides are
 *    parsed via the real public API.
 */
public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        checkDecimalSuffixEquivalence("1234.5");
        checkIntegerLongSuffixEquivalence("12345");
        checkScientificExpansionEquivalence("12", 3);
        checkScientificExpansionEquivalence("7", 0);

        String fuzzedDecimal = buildValidDecimal(data);
        exerciseCreateNumber(fuzzedDecimal, true);
        checkDecimalSuffixEquivalence(fuzzedDecimal);

        String fuzzedInteger = buildValidInteger(data);
        exerciseCreateNumber(fuzzedInteger, true);
        checkIntegerLongSuffixEquivalence(fuzzedInteger);

        String significand = buildNonNegativeDigits(data.consumeInt(1, 6));
        int exponent = data.consumeInt(0, 5);
        String sciLower = significand + "e" + exponent;
        String sciUpper = significand + "E" + exponent;
        exerciseCreateNumber(sciLower, true);
        exerciseCreateNumber(sciUpper, true);
        checkScientificExpansionEquivalence(significand, exponent);

        String malformedProbe = buildExponentEdgeCase(data);
        exerciseCreateNumber(malformedProbe, false);
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkDecimalSuffixEquivalence(String base) {
        Number plain = parseOrNull(base);
        Number asFloatUpper = parseOrNull(base + "F");
        Number asFloatLower = parseOrNull(base + "f");
        Number asDoubleUpper = parseOrNull(base + "D");
        Number asDoubleLower = parseOrNull(base + "d");
        if (plain == null || asFloatUpper == null || asFloatLower == null || asDoubleUpper == null || asDoubleLower == null) {
            return;
        }
        if (!sameNumericValue(plain, asFloatUpper)) {
            throw new RuntimeException("[oracle:decimal-suffix-equivalence] metamorphic violation: plain decimal and F-suffixed decimal disagreed input="
                    + base + " lhs=" + plain + " rhs=" + asFloatUpper);
        }
        if (!sameNumericValue(plain, asFloatLower)) {
            throw new RuntimeException("[oracle:decimal-suffix-equivalence] metamorphic violation: plain decimal and f-suffixed decimal disagreed input="
                    + base + " lhs=" + plain + " rhs=" + asFloatLower);
        }
        if (!sameNumericValue(plain, asDoubleUpper)) {
            throw new RuntimeException("[oracle:decimal-suffix-equivalence] metamorphic violation: plain decimal and D-suffixed decimal disagreed input="
                    + base + " lhs=" + plain + " rhs=" + asDoubleUpper);
        }
        if (!sameNumericValue(plain, asDoubleLower)) {
            throw new RuntimeException("[oracle:decimal-suffix-equivalence] metamorphic violation: plain decimal and d-suffixed decimal disagreed input="
                    + base + " lhs=" + plain + " rhs=" + asDoubleLower);
        }
    }

    private static void checkIntegerLongSuffixEquivalence(String base) {
        Number plain = parseOrNull(base);
        Number upper = parseOrNull(base + "L");
        Number lower = parseOrNull(base + "l");
        if (plain == null || upper == null || lower == null) {
            return;
        }
        if (!sameNumericValue(plain, upper)) {
            throw new RuntimeException("[oracle:integer-long-suffix-equivalence] metamorphic violation: plain integer and L-suffixed integer disagreed input="
                    + base + " lhs=" + plain + " rhs=" + upper);
        }
        if (!sameNumericValue(plain, lower)) {
            throw new RuntimeException("[oracle:integer-long-suffix-equivalence] metamorphic violation: plain integer and l-suffixed integer disagreed input="
                    + base + " lhs=" + plain + " rhs=" + lower);
        }
    }

    private static void checkScientificExpansionEquivalence(String significand, int exponent) {
        String scientific = significand + "e" + exponent;
        String expanded = significand + repeat('0', exponent);
        Number lhs = parseOrNull(scientific);
        Number rhs = parseOrNull(expanded);
        if (lhs == null || rhs == null) {
            return;
        }
        if (!sameNumericValue(lhs, rhs)) {
            throw new RuntimeException("[oracle:scientific-expansion-equivalence] metamorphic violation: scientific notation disagreed with equivalent zero-appended integer input="
                    + scientific + " expanded=" + expanded + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static Number parseOrNull(String s) {
        try {
            return NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal aa = toBigDecimal(a);
        BigDecimal bb = toBigDecimal(b);
        if (aa == null || bb == null) {
            return false;
        }
        return aa.compareTo(bb) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n == null) {
            return null;
        }
        if (n instanceof BigDecimal) {
            return ((BigDecimal) n).stripTrailingZeros();
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float || n instanceof Double) {
            double d = n.doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
            return BigDecimal.valueOf(d).stripTrailingZeros();
        }
        return null;
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildValidDecimal(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        String left = buildNonNegativeDigits(data.consumeInt(1, 4));
        String right = buildNonNegativeDigits(data.consumeInt(1, 3));
        return (negative ? "-" : "") + left + "." + right;
    }

    private static String buildValidInteger(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        String digits = buildNonNegativeDigits(data.consumeInt(1, 6));
        return (negative ? "-" : "") + digits;
    }

    private static String buildExponentEdgeCase(FuzzedDataProvider data) {
        String digits = buildNonNegativeDigits(data.consumeInt(1, 6));
        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return digits + "e";
            case 1:
                return digits + "E";
            case 2:
                return "-" + digits + "e";
            case 3:
                return "-" + digits + "E";
            case 4:
                return digits + data.consumeAsciiString(2) + "e";
            default:
                return digits + data.consumeAsciiString(2) + "E";
        }
    }

    private static String buildNonNegativeDigits(int len) {
        StringBuilder sb = new StringBuilder(len);
        sb.append((char) ('1' + (len % 9)));
        for (int i = 1; i < len; i++) {
            sb.append((char) ('0' + ((i * 7 + len) % 10)));
        }
        return sb.toString();
    }

    private static String repeat(char c, int count) {
        StringBuilder sb = new StringBuilder(count);
        for (int i = 0; i < count; i++) {
            sb.append(c);
        }
        return sb.toString();
    }
}
