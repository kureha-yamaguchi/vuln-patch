package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    private static final int[] INDICES = new int[] {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    private static final float[] ANCHOR_COORDS = new float[] {
         1.000000f, -1.000000f, -1.000000f,
         1.000000f, -1.000000f,  1.000000f,
        -1.000000f, -1.000000f,  1.000000f,
        -1.000000f, -1.000000f, -1.000000f,
         1.000000f,  1.000000f, -1.000000f,
         0.999999f,  1.000000f,  1.000000f,
        -1.000000f,  1.000000f,  1.000000f,
        -1.000000f,  1.000000f, -1.000000f
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAndCheck(ANCHOR_COORDS);

        int cases = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < cases; i++) {
            float[] coords = makeVariant(data);
            exerciseAndCheck(coords);
        }

        float[] another = makeVariant(data);
        exerciseAndCheck(another);
    }

    private static void exerciseAndCheck(float[] coords) {
        try {
            runCase(coords, false);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            PolyhedronsSet a = buildPolyhedron(coords, false);
            PolyhedronsSet b = buildPolyhedron(coords, true);

            double sizeA = a.getSize();
            Vector3D baryA = a.getBarycenter();
            double sizeB = b.getSize();
            Vector3D baryB = b.getBarycenter();

            if (!sameDouble(sizeA, sizeB, 1e-9) || !sameVector(baryA, baryB, 1e-9)) {
                throw new RuntimeException(
                    "[oracle:facet-order] metamorphic violation: reordering equivalent boundary facets changed result"
                    + " sizeA=" + sizeA
                    + " sizeB=" + sizeB
                    + " baryA=" + baryToString(baryA)
                    + " baryB=" + baryToString(baryB));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void runCase(float[] coords, boolean reverseOrder) {
        PolyhedronsSet poly = buildPolyhedron(coords, reverseOrder);
        poly.getSize();
        poly.getBarycenter();
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords, boolean reverseOrder) {
        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        int start = reverseOrder ? INDICES.length - 3 : 0;
        int end = reverseOrder ? -3 : INDICES.length;
        int step = reverseOrder ? -3 : 3;

        for (int idx = start; idx != end; idx += step) {
            int idxA = INDICES[idx] * 3;
            int idxB = INDICES[idx + 1] * 3;
            int idxC = INDICES[idx + 2] * 3;

            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            Plane plane = new Plane(v1, v2, v3);

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            ArrayList<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
            edges.add(new SubLine(p1, p2));
            edges.add(new SubLine(p2, p3));
            edges.add(new SubLine(p3, p1));

            PolygonsSet facetRegion = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, facetRegion));
        }

        return new PolyhedronsSet(facets);
    }

    private static float[] makeVariant(FuzzedDataProvider data) {
        float[] coords = new float[] {
             1.0f, -1.0f, -1.0f,
             1.0f, -1.0f,  1.0f,
            -1.0f, -1.0f,  1.0f,
            -1.0f, -1.0f, -1.0f,
             1.0f,  1.0f, -1.0f,
             1.0f,  1.0f,  1.0f,
            -1.0f,  1.0f,  1.0f,
            -1.0f,  1.0f, -1.0f
        };

        int tweaks = 1 + data.consumeInt(0, 5);
        for (int i = 0; i < tweaks; i++) {
            int vertex = data.consumeInt(0, 7);
            int axis = data.consumeInt(0, 2);
            int raw = data.consumeInt(-1000, 1000);
            float delta = raw / 1000000.0f;
            int pos = vertex * 3 + axis;
            coords[pos] += delta;
        }

        if (data.consumeBoolean()) {
            coords[15] = 1.0f + data.consumeInt(-2, 2) / 1000000.0f;
        } else {
            coords[15] = 0.999999f;
        }

        return coords;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                        || "getVertices".equals(method)
                        || "getTree".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("MathIllegal")
            || name.contains("DimensionMismatch")
            || name.contains("OutOfRange")
            || name.contains("NumberIsToo")
            || name.contains("NoData")
