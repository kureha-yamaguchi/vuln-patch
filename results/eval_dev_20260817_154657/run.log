                    + " bary1=(" + bary1.getX() + "," + bary1.getY() + "," + bary1.getZ() + ")"
                    + " bary2=(" + bary2.getX() + "," + bary2.getY() + "," + bary2.getZ() + ")");
            }
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            if (validByConstruction && isRootCause(ex)) {
                throw ex;
            }
        }
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords) {
        int[] indices = new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        Vector3D[] vs = new Vector3D[8];
        for (int i = 0; i < 8; i++) {
            int j = i * 3;
            vs[i] = new Vector3D(coords[j], coords[j + 1], coords[j + 2]);
        }

        Collection<SubHyperplane<Euclidean3D>> boundary = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            Vector3D v1 = vs[indices[idx]];
            Vector3D v2 = vs[indices[idx + 1]];
            Vector3D v3 = vs[indices[idx + 2]];

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            PolygonsSet facet = triangleRegion(p1, p2, p3);
            boundary.add(new SubPlane(plane, facet));
        }

        return new PolyhedronsSet(boundary);
    }

    private static PolygonsSet triangleRegion(Vector2D a, Vector2D b, Vector2D c) {
        double area2 = (b.getX() - a.getX()) * (c.getY() - a.getY()) - (b.getY() - a.getY()) * (c.getX() - a.getX());
        Vector2D p1 = a;
        Vector2D p2 = b;
        Vector2D p3 = c;
        if (area2 < 0.0) {
            p2 = c;
            p3 = b;
        }

        Collection<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
        edges.add(edge(p1, p2));
        edges.add(edge(p2, p3));
        edges.add(edge(p3, p1));
        return new PolygonsSet(edges);
    }

    private static SubHyperplane<Euclidean2D> edge(Vector2D start, Vector2D end) {
        Line line = new Line(start, end);
        double s = line.toSubSpace(start).getX();
        double e = line.toSubSpace(end).getX();
        if (s <= e) {
            return new SubLine(line, new IntervalsSet(s, e));
        } else {
            return new SubLine(line, new IntervalsSet(e, s));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.startsWith("org.apache.commons.math3.exception.")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method) || "getVertices".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cls)
                    && ("getSize".equals(method) || "getBarycenter".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameVector(Vector3D a, Vector3D b, double absTol, double relTol) {
        return sameDouble(a.getX(), b.getX(), absTol, relTol)
            && sameDouble(a.getY(), b.getY(), absTol, relTol)
            && sameDouble(a.getZ(), b.getZ(), absTol, relTol);
    }

    private static boolean sameDouble(double a, double b, double absTol, double relTol) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return true;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(Math.abs(a), Math.abs(b));
        return diff <= absTol || diff <= relTol * Math.max(1.0, scale);
    }

    private static float[] makeBoxCoords(float hx, float hy, float hz) {
        return new float[] {
             hx, -hy, -hz,
             hx, -hy,  hz,
            -hx, -hy,  hz,
            -hx, -hy, -hz,
             hx,  hy, -hz,
             hx,  hy,  hz,
            -hx,  hy,  hz,
            -hx,  hy, -hz
        };
    }

    private static float boundedPositive(FuzzedDataProvider data) {
        int milli = data.consumeInt(1, 10000);
        return milli / 1000.0f;
    }

    private static float boundedEpsilon(FuzzedDataProvider data) {
        int sign = data.consumeBoolean() ? 1 : -1;
        int units = data.consumeInt(1, 2000);
        return sign * (units / 1000000.0f);
    }
