                || lower.longValue() != helper.longValue()) {
            throw new RuntimeException(
                    "[oracle:integral-long-suffix-case-consistency] metamorphic violation: lower/upper explicit long suffixes must agree on valid decimal integers input="
                            + numeric + " lower=" + lower + " upper=" + upper + " helper=" + helper);
