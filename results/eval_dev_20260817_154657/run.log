package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            boolean anchor = BooleanUtils.toBoolean("off");
            if (anchor) {
                throw new RuntimeException("[oracle:boolean-literals] metamorphic violation: documented false literal returned true input=off lhs=" + anchor + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String[] positiveBases = new String[] { "true", "yes", "on" };
        String base = positiveBases[data.consumeInt(0, positiveBases.length - 1)];
        StringBuilder mixed = new StringBuilder(base.length());
        for (int i = 0; i < base.length(); i++) {
            char ch = base.charAt(i);
            mixed.append(data.consumeBoolean() ? Character.toUpperCase(ch) : Character.toLowerCase(ch));
        }
        String positiveVariant = mixed.toString();

        try {
            boolean result = BooleanUtils.toBoolean(positiveVariant);
            /*
             * Contract asserted:
             * - The implementation explicitly accepts both upper- and lower-case characters
             *   for "on", "yes", and "true" via per-character comparisons.
             * - The supplied test also enumerates many mixed-case "true"/"yes"/"on" positives.
             * Therefore any case permutation of these literals must evaluate to true.
             * A patch that merely suppresses the crash by making the branch unreachable or
             * silently returning false would violate this observable result.
             */
            if (!result) {
                throw new RuntimeException("[oracle:boolean-literals] metamorphic violation: mixed-case positive literal must parse as true input=" + positiveVariant + " lhs=" + result + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        int mode = data.consumeInt(0, 2);
        String candidate;
        if (mode == 0) {
            String s = data.consumeAsciiString(3);
            while (s.length() < 3) {
                s += "x";
            }
            candidate = s.substring(0, 3);
        } else if (mode == 1) {
            String surrounding = data.consumeAsciiString(16);
            if (surrounding.length() < 3) {
                StringBuilder sb = new StringBuilder(surrounding);
                while (sb.length() < 3) {
                    sb.append((char) ('a' + data.consumeInt(0, 25)));
                }
                surrounding = sb.toString();
            }
            int start = data.consumeInt(0, surrounding.length() - 3);
            candidate = surrounding.substring(start, start + 3);
        } else {
            char c0 = (char) ('a' + data.consumeInt(0, 25));
            char c1 = (char) ('a' + data.consumeInt(0, 25));
            char c2 = (char) ('a' + data.consumeInt(0, 25));
            candidate = new String(new char[] { c0, c1, c2 });
        }

        if (candidate.charAt(0) == 'y' || candidate.charAt(0) == 'Y') {
            candidate = "o" + candidate.substring(1);
        }

        try {
            BooleanUtils.toBoolean(candidate);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String[] observed = new String[] {
            "oof", "yep", "tru", "yes?", "trux", "false", "a", "true",
            "truE", "trUe", "trUE", "tRue", "tRuE", "tRUe", "tRUE",
            "TRUE", "TRUe", "TRuE", "TRue", "TrUE", "TrUe", "TruE",
            "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs", "yES",
            "Yes", "YeS", "YEs", "YES"
        };
        String replay = observed[data.consumeInt(0, observed.length - 1)];
        try {
            BooleanUtils.toBoolean(replay);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
