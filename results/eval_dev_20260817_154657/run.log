    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        checkSeriesViewConsistency(s, "anchor-source");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int rawStartIndex = s.getIndex(start);
        int rawEndIndex = s.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0 && start.compareTo(end) <= 0)) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor must be a valid empty gap"
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex
                    + " start=" + start
                    + " end=" + end);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor empty-gap createCopy must return empty series"
                    + " count=" + copy.getItemCount());
        }

        checkBoundaryStepRight(s, start, new Day(31, 1, 2006));
        checkBoundaryStepLeft(s, new Day(19, 8, 2005), end);
    }

    private static Day addDays(Day base, int delta) {
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(base.getYear(), base.getMonth() - 1, base.getDayOfMonth(), 0, 0, 0);
        cal.add(Calendar.DATE, delta);
        return new Day(cal.getTime());
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        try {
            TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
            TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

            checkSeriesViewConsistency(byBoundary, "boundary-right-by-boundary");
            checkSeriesViewConsistency(byIndex, "boundary-right-by-index");
            assertEquivalentSeries(byBoundary, byIndex, "boundary-right");
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd)
            throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
            throw new RuntimeException("[oracle:left-boundary-present] metamorphic violation: left boundary period must exist"
                    + " left=" + exactLeft
                    + " leftIndex=" + leftIndex);
        }

        try {
            TimeSeries byBoundary = series.createCopy(exactLeft, absentEnd);
            TimeSeries byIndex = series.createCopy(leftIndex, leftIndex);

            checkSeriesViewConsistency(byBoundary, "boundary-left-by-boundary");
            checkSeriesViewConsistency(byIndex, "boundary-left-by-index");
            assertEquivalentSeries(byBoundary, byIndex, "boundary-left");
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String tag) {
        int count = series.getItemCount();
        List items = series.getItems();
        List periods = series.getTimePeriods();

        if (count != items.size() || count != periods.size()) {
            throw new RuntimeException("[oracle:view-size] metamorphic violation: public views over shared data must agree"
                    + " tag=" + tag
                    + " itemCount=" + count
                    + " itemsSize=" + items.size()
                    + " periodsSize=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            Object itemFromList = items.get(i);
            Object periodFromList = periods.get(i);
            RegularTimePeriod period = series.getTimePeriod(i);

            if (item != itemFromList) {
                throw new RuntimeException("[oracle:view-item] metamorphic violation: getDataItem and getItems must expose the same indexed item"
                        + " tag=" + tag
                        + " index=" + i
                        + " direct=" + item
                        + " listed=" + itemFromList);
            }
            if (!period.equals(periodFromList)) {
                throw new RuntimeException("[oracle:view-period] metamorphic violation: getTimePeriod and getTimePeriods must agree"
                        + " tag=" + tag
                        + " index=" + i
                        + " direct=" + period
                        + " listed=" + periodFromList);
            }
            if (!period.equals(item.getPeriod())) {
                throw new RuntimeException("[oracle:item-period] metamorphic violation: indexed item period must match indexed period"
                        + " tag=" + tag
                        + " index=" + i
                        + " itemPeriod=" + item.getPeriod()
                        + " period=" + period);
            }
            if (series.getIndex(period) != i) {
                throw new RuntimeException("[oracle:index-consistency] metamorphic violation: getIndex must invert getTimePeriod on present items"
                        + " tag=" + tag
                        + " index=" + i
                        + " period=" + period
                        + " roundTrip=" + series.getIndex(period));
            }
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String tag) {
        if (a.getItemCount() != b.getItemCount()
                || a.getItems().size() != b.getItems().size()
                || a.getTimePeriods().size() != b.getTimePeriods().size()) {
            throw new RuntimeException("[oracle:equiv-size] metamorphic violation: equivalent createCopy calls must have matching public sizes"
                    + " tag=" + tag
                    + " aCount=" + a.getItemCount()
                    + " bCount=" + b.getItemCount()
                    + " aItems=" + a.getItems().size()
                    + " bItems=" + b.getItems().size()
                    + " aPeriods=" + a.getTimePeriods().size()
                    + " bPeriods=" + b.getTimePeriods().size());
        }

        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException("[oracle:equiv-period] metamorphic violation: equivalent createCopy calls must copy the same periods"
                        + " tag=" + tag
                        + " index=" + i
                        + " a=" + pa
                        + " b=" + pb);
