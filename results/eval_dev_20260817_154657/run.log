                        throw new RuntimeException("[oracle:overload-period] metamorphic violation: createCopy overloads copied different periods"
                                + " chosen=" + chosen
                                + " byPeriod=" + byPeriod.getTimePeriod(0)
                                + " byIndex=" + byIndex.getTimePeriod(0));
