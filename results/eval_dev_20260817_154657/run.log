package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression inputs from the failing test.
        exercise("\uD83D\uDE30", true);
        exercise("\uD800\uDC00", true);
        exercise("\uD834\uDD1E", true);
        exercise("\uDBFF\uDFFD", true);

        // EXPLORE: build well-formed UTF-16 strings by construction, with at least one
        // supplementary code point placed among ordinary BMP characters. Also avoid CSV
        // special characters so the documented behavior of escapeCsv is that the input
        // is returned unchanged when no escaping is required.
        String fuzz = buildValidNonCsvStringWithSupplementary(data);
        if (fuzz != null) {
            exercise(fuzz, true);
        }
    }

    private static void exercise(String input, boolean validByConstruction) {
        final String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                rethrowUnchecked(t);
            }
            return;
        }

        // Post-condition: escapeCsv only adds CSV escaping when needed; for inputs that
        // contain no comma, quote, CR, or LF, the result must be exactly the original text.
        // Our explore inputs are constructed to satisfy that precondition.
        if (!containsCsvSpecial(input) && !input.equals(escaped)) {
            throw new RuntimeException(
                "[oracle:csv-identity] metamorphic violation: escapeCsv must leave strings " +
                "without CSV-special characters unchanged input=" + printable(input) +
                " lhs=" + printable(escaped) + " rhs=" + printable(input)
            );
        }

        // Metamorphic relation: unescapeCsv(escapeCsv(s)) == s for a complete CSV field.
        // Both sides are real library calls. If either call rejects, the check does not apply.
        try {
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException(
                    "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(s)) != s " +
                    "input=" + printable(input) +
                    " lhs=" + printable(roundTrip) +
                    " rhs=" + printable(input)
                );
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                rethrowUnchecked(t);
            }
        }
    }

    private static String buildValidNonCsvStringWithSupplementary(FuzzedDataProvider data) {
        int totalCodePoints = data.consumeInt(1, 12);
        int supplementaryIndex = data.consumeInt(0, totalCodePoints - 1);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < totalCodePoints; i++) {
            int codePoint;
            if (i == supplementaryIndex || (data.consumeBoolean() && data.remainingBytes() > 0)) {
                codePoint = data.consumeInt(0x10000, 0x10FFFF);
            } else {
                codePoint = nextSafeBmpCodePoint(data);
            }
            if (!Character.isValidCodePoint(codePoint)) {
                codePoint = 0x10000;
            }
            if (isCsvSpecial(codePoint)) {
                codePoint = 'A';
            }
            if (Character.isSurrogate((char) codePoint)) {
                codePoint = 'B';
            }
            sb.append(Character.toChars(codePoint));
        }

        if (sb.length() == 0) {
            sb.append("\uD83D\uDE30");
        }
        return sb.toString();
    }

    private static int nextSafeBmpCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x20, 0xFFFD);
            if (cp >= 0xD800 && cp <= 0xDFFF) {
                continue;
            }
            if (isCsvSpecial(cp)) {
                continue;
            }
            return cp;
        }
    }

    private static boolean containsCsvSpecial(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static boolean isCsvSpecial(int cp) {
        return cp == ',' || cp == '"' || cp == '\r' || cp == '\n';
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7E) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
