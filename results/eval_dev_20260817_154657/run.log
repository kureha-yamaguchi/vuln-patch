            RegularTimePeriod p = series.getTimePeriod(i);
            if (!di.getPeriod().equals(p)) {
                throw new RuntimeException("[oracle:" + tag + "-period-match] metamorphic violation: getDataItem(i).getPeriod() and getTimePeriod(i) disagree"
                        + " index=" + i
                        + " dataItemPeriod=" + di.getPeriod()
