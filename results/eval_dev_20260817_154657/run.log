package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static final String[] ANCHORS = new String[] {
        "\uD83D\uDE30",
        "\uD800\uDC00",
        "\uD834\uDD1E",
        "\uDBFF\uDFFD"
    };

    private static final char[] SAFE_BMP = "abcXYZ012_- ".toCharArray();
    private static final int[] SAFE_SUPPLEMENTARY = new int[] {
        0x10000, 0x10137, 0x1D11E, 0x1F30D, 0x1F4A9, 0x1F630, 0x10FFFD
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        for (String anchor : ANCHORS) {
            exerciseEscapeCsv(anchor, true, true);
        }

        int cases = 1 + data.consumeInt(0, 3);
        for (int i = 0; i < cases; i++) {
            String s = buildValidSafeCsvIdentityString(data);
            exerciseEscapeCsv(s, true, true);
        }

        if (data.remainingBytes() > 0) {
            String maybeInvalid = data.consumeRemainingAsString();
            exerciseEscapeCsv(maybeInvalid, false, false);
        }
    }

    private static void exerciseEscapeCsv(String input, boolean validByConstruction, boolean assertIdentity) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            // Contract/oracle:
            // escapeCsv must leave inputs unchanged when they contain no comma, quote, CR, or LF.
            // The provided failing test demonstrates this exact guarantee for surrogate-pair inputs.
            // A "fix" that merely avoids the exception by skipping/altering translation bookkeeping
            // could silently change the result; this post-condition catches that.
            if (assertIdentity && !input.equals(out)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for CSV-safe input input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static String buildValidSafeCsvIdentityString(FuzzedDataProvider data) {
        int codePoints = 1 + data.consumeInt(0, 7);
        int supplementaryIndex = data.consumeInt(0, codePoints - 1);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < codePoints; i++) {
            if (i == supplementaryIndex || (data.consumeBoolean() && i + 1 < codePoints && data.consumeBoolean())) {
                sb.appendCodePoint(SAFE_SUPPLEMENTARY[data.consumeInt(0, SAFE_SUPPLEMENTARY.length - 1)]);
            } else {
                sb.append(SAFE_BMP[data.consumeInt(0, SAFE_BMP.length - 1)]);
            }
        }

        if (!containsSupplementary(sb)) {
            sb.appendCodePoint(SAFE_SUPPLEMENTARY[data.consumeInt(0, SAFE_SUPPLEMENTARY.length - 1)]);
        }
        return sb.toString();
    }

    private static boolean containsSupplementary(CharSequence s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i)) && i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) ch));
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
