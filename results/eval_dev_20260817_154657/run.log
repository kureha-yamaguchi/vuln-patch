                        "[oracle:anchor-gap-empty] metamorphic violation: exact bug trigger range lies inside a real gap and must copy to empty"
                                + " copyCount=" + copy.getItemCount()
                                + " itemsSize=" + copy.getItems().size()
                                + " periodsSize=" + copy.getTimePeriods().size());
            }
        } catch (RuntimeException e) {
            if (isKnownRootCause(e)) {
                return;
            }
            throw e;
        }

        TimeSeries byBoundary = s.createCopy(start, right);
        TimeSeries byIndex = s.createCopy(1, 1);
        checkSeriesViewConsistency(byBoundary, "anchor-boundary-right");
        checkSeriesViewConsistency(byIndex, "anchor-boundary-index");
        assertEquivalentSeries(byBoundary, byIndex, "anchor-boundary-right");
