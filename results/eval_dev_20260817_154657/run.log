            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                throw new RuntimeException("[oracle:equiv-value] metamorphic violation: equivalent createCopy calls must copy the same values"
                        + " tag=" + tag
                        + " index=" + i
                        + " a=" + va
                        + " b=" + vb);
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        if (t == null) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.jfree.data.time.TimeSeries".equals(ste.getClassName())) {
                String method = ste.getMethodName();
                if ("createCopy".equals(method) || "getIndex".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }
