                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = (data.consumeBoolean() ? "+" : "-") + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "." + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "e" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 9:
                    probe = data.consumeAsciiString(3);
                    break;
                case 10:
                    probe = data.consumeRemainingAsString();
                    break;
                default:
                    probe = data.consumeAsciiString(4) + (data.consumeBoolean() ? "f" : "F");
                    break;
            }
            exerciseMalformed(probe);
        }

        /*
         * Contract asserted from NumberUtils.createNumber's real selection logic:
         * when a caller requests an explicit long type via L/l, the top-level selector
         * must agree with the dedicated helper createLong on the same valid decimal payload.
         * We independently obtain the same quantity via createLong and via createNumber
         * on both suffixed and unsuffixed forms. A patch that merely suppresses crashes,
         * skips the long-suffix branch, or silently rejects '+'-signed valid decimals
         * will violate this agreement.
         */
        {
            String digits = buildDigits(data, 1, 18);
            String numeric = "+" + digits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");

            Long helperLong;
            Number unsuffixed;
            try {
                helperLong = NumberUtils.createLong(numeric);
                unsuffixed = NumberUtils.createNumber(numeric);
            } catch (RuntimeException e) {
                if (isRootCause(e) && isValidPlusSignedDecimal(numeric)) {
                    throw e;
                }
                return;
            }

            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");

