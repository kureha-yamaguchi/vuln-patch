    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        java.util.List items = series.getItems();
        java.util.List periods = series.getTimePeriods();

        if (count != items.size() || count != periods.size()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "[oracle:view-consistency] consistency violation: series views disagree"
                            + " label=" + label
                            + " count=" + count
                            + " items=" + items.size()
                            + " periods=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            Object periodFromList = periods.get(i);
            if (item == null) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:dataitem-null] consistency violation: getDataItem returned null"
                                + " label=" + label
                                + " index=" + i);
            }
            if (!item.getPeriod().equals(series.getTimePeriod(i)) || !item.getPeriod().equals(periodFromList)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:period-consistency] consistency violation: period views disagree"
                                + " label=" + label
                                + " index=" + i
                                + " itemPeriod=" + item.getPeriod()
                                + " timePeriod=" + series.getTimePeriod(i)
                                + " listPeriod=" + periodFromList);
            }
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String label) {
        if (a.getItemCount() != b.getItemCount()
                || a.getItems().size() != b.getItems().size()
                || a.getTimePeriods().size() != b.getTimePeriods().size()) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "[oracle:" + label + "] metamorphic violation: series sizes disagree"
                            + " aCount=" + a.getItemCount()
                            + " bCount=" + b.getItemCount()
                            + " aItems=" + a.getItems().size()
                            + " bItems=" + b.getItems().size()
                            + " aPeriods=" + a.getTimePeriods().size()
                            + " bPeriods=" + b.getTimePeriods().size());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (!pa.equals(pb) || (va == null ? vb != null : !va.equals(vb))) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:" + label + "] metamorphic violation: series contents disagree"
                                + " index=" + i
                                + " aPeriod=" + pa
                                + " bPeriod=" + pb
                                + " aValue=" + va
                                + " bValue=" + vb);
            }
        }
    }

    private static Day addDays(Day base, int delta) {
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(java.util.Calendar.YEAR, base.getYear());
        cal.set(java.util.Calendar.MONTH, base.getMonth() - 1);
        cal.set(java.util.Calendar.DAY_OF_MONTH, base.getDayOfMonth());
        cal.add(java.util.Calendar.DAY_OF_MONTH, delta);
        return new Day(
                cal.get(java.util.Calendar.DAY_OF_MONTH),
                cal.get(java.util.Calendar.MONTH) + 1,
                cal.get(java.util.Calendar.YEAR));
    }

    private static int insertionPoint(int rawIndex) {
        return -(rawIndex + 1);
    }

    private static boolean isCleanValidation(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String n = cur.getClass().getName();
