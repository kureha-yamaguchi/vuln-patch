    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();

        if (count != itemsSize || count != periodsSize) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "[oracle:view-consistency] consistency violation: shared data-backed views disagree"
                            + " label=" + label
                            + " count=" + count
                            + " itemsSize=" + itemsSize
                            + " periodsSize=" + periodsSize);
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod itemPeriod = item.getPeriod();
            RegularTimePeriod indexedPeriod = series.getTimePeriod(i);
            Number itemValue = item.getValue();
            Number indexedValue = series.getValue(i);

            if (!(itemPeriod == null ? indexedPeriod == null : itemPeriod.equals(indexedPeriod))) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:dataitem-period] consistency violation: getDataItem/getTimePeriod disagree"
                                + " label=" + label
                                + " index=" + i
                                + " itemPeriod=" + itemPeriod
                                + " indexedPeriod=" + indexedPeriod);
            }
            if (!(itemValue == null ? indexedValue == null : itemValue.equals(indexedValue))) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:dataitem-value] consistency violation: getDataItem/getValue disagree"
                                + " label=" + label
                                + " index=" + i
                                + " itemValue=" + itemValue
                                + " indexedValue=" + indexedValue);
            }
        }
    }

    private static int insertionPoint(int binarySearchResult) {
        return -(binarySearchResult + 1);
    }

    private static Day addDays(Day base, int delta) {
        java.util.Calendar cal = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(base.getYear(), base.getMonth() - 1, base.getDayOfMonth(), 12, 0, 0);
        cal.add(java.util.Calendar.DATE, delta);
        return new Day(cal.getTime());
    }

    private static boolean isCleanValidationFromPatchedRegion(Throwable t) {
        return isValidationExceptionFamily(t) && passesPatchedRegion(t);
    }

    private static boolean isValidationExceptionFamily(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof org.jfree.data.general.SeriesException;
    }

    private static boolean passesPatchedRegion(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.jfree.data.time.TimeSeries".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("createCopy".equals(m) || "getIndex".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow;
    }
