    private static void checkSeriesViewConsistency(TimeSeries series, String tag) {
        int count = series.getItemCount();
        List items = series.getItems();
        Collection periods = series.getTimePeriods();

        if (items.size() != count) {
            throw new RuntimeException("[oracle:view-items-size] metamorphic violation: getItems().size() must equal getItemCount()"
                    + " tag=" + tag
                    + " count=" + count
                    + " itemsSize=" + items.size());
