                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e) || isOracleFailure(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        checkSeriesViewConsistency(s, "anchor-source");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int manualCount = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
        }
        if (manualCount != 0) {
            throw new RuntimeException("[oracle:anchor-gap-shape] metamorphic violation: anchor range must lie in a gap"
                    + " manualCount=" + manualCount
                    + " start=" + start
                    + " end=" + end);
        }

        int rawStartIndex = s.getIndex(start);
        int rawEndIndex = s.getIndex(end);
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            throw new RuntimeException("[oracle:anchor-gap-absent] metamorphic violation: anchor endpoints must be absent"
                    + " rawStartIndex=" + rawStartIndex
                    + " rawEndIndex=" + rawEndIndex);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("[oracle:anchor-gap-empty] metamorphic violation: anchor empty-gap createCopy must return empty series"
                    + " copyCount=" + copy.getItemCount()
                    + " start=" + start
                    + " end=" + end);
        }

        checkBoundaryStepRight(s, start, new Day(31, 1, 2006));
        checkBoundaryStepLeft(s, new Day(19, 8, 2005), end);
    }

    private static Day dayFromEpochDay(int epochDay) {
        long millis = ((long) epochDay) * 86400000L;
        return new Day(new java.util.Date(millis));
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        List items = series.getItems();
        Collection periods = series.getTimePeriods();

        if (count != items.size()) {
            throw new RuntimeException("[oracle:view-count-items] metamorphic violation: getItemCount must equal getItems().size()"
                    + " label=" + label
                    + " count=" + count
                    + " itemsSize=" + items.size());
        }
        if (count != periods.size()) {
            throw new RuntimeException("[oracle:view-count-periods] metamorphic violation: getItemCount must equal getTimePeriods().size()"
                    + " label=" + label
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }
        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod p = series.getTimePeriod(i);
            if (item == null) {
                throw new RuntimeException("[oracle:view-item-null] metamorphic violation: getDataItem returned null"
                        + " label=" + label
                        + " index=" + i);
            }
            if (!item.getPeriod().equals(p)) {
