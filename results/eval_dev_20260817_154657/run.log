    private static Day dayFromEpochDay(int epochDay) {
        java.util.GregorianCalendar cal = new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(1970, java.util.Calendar.JANUARY, 1);
        cal.add(java.util.Calendar.DAY_OF_MONTH, epochDay);
        return new Day(cal.get(java.util.Calendar.DAY_OF_MONTH),
                cal.get(java.util.Calendar.MONTH) + 1,
                cal.get(java.util.Calendar.YEAR));
    }

    private static int countItemsInRange(TimeSeries s, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static void checkSeriesViewConsistency(TimeSeries s, String label) {
        int itemCount = s.getItemCount();
        int itemsSize = s.getItems().size();
        int periodsSize = s.getTimePeriods().size();

        if (itemCount != itemsSize || itemCount != periodsSize) {
            throw new RuntimeException("[oracle:view-consistency] metamorphic violation: exposed series views disagree"
                    + " label=" + label
                    + " itemCount=" + itemCount
                    + " itemsSize=" + itemsSize
                    + " periodsSize=" + periodsSize);
        }

        for (int i = 0; i < itemCount; i++) {
            TimeSeriesDataItem item = s.getDataItem(i);
            RegularTimePeriod period = s.getTimePeriod(i);
            if (item == null || period == null) {
                throw new RuntimeException("[oracle:view-consistency] metamorphic violation: null element in non-null indexed view"
                        + " label=" + label
                        + " index=" + i
                        + " item=" + item
                        + " period=" + period);
            }
            if (!period.equals(item.getPeriod())) {
                throw new RuntimeException("[oracle:view-consistency] metamorphic violation: getDataItem/getTimePeriod disagree"
                        + " label=" + label
                        + " index=" + i
                        + " periodView=" + period
                        + " itemPeriod=" + item.getPeriod());
            }
            if (s.getIndex(period) != i) {
                throw new RuntimeException("[oracle:view-consistency] metamorphic violation: indexed period does not round-trip through getIndex"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + s.getIndex(period)
                        + " period=" + period);
            }
        }
    }

    private static boolean isValidConstructedRange(RegularTimePeriod start, RegularTimePeriod end) {
        return start != null && end != null && start.compareTo(end) <= 0;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof org.jfree.data.general.SeriesException;
    }

    private static boolean passesThroughCreateCopy(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.jfree.data.time.TimeSeries".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("createCopy".equals(m) || "getIndex".equals(m) || "clone".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof IllegalArgumentException && passesThroughCreateCopy(t);
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }
