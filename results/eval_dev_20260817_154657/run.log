            throw new RuntimeException("[oracle:view-periods-size] metamorphic violation: getTimePeriods().size() must equal getItemCount()"
                    + " tag=" + tag
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }
        for (int i = 0; i < count; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (!series.getDataItem(i).getPeriod().equals(p)) {
                throw new RuntimeException("[oracle:dataitem-period] metamorphic violation: getDataItem(i).period must equal getTimePeriod(i)"
                        + " tag=" + tag
                        + " index=" + i
