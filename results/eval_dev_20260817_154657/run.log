        double canonicalSize = canonicalFull.getSize();
        Vector2D canonicalBarycenter = (Vector2D) canonicalFull.getBarycenter();

        boolean sizeOk =
            (Double.isInfinite(candidateSize) && Double.isInfinite(canonicalSize)) ||
            Math.abs(candidateSize - canonicalSize) <= 1.0e-12;
        boolean xOk =
            (Double.isNaN(candidateBarycenter.getX()) && Double.isNaN(canonicalBarycenter.getX())) ||
