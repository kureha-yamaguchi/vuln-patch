package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact ground-truth trigger from the failing test.
        exerciseTarget("off", true, true);

        // EXPLORE: the bug is in handling non-null 3-character strings in toBoolean(String).
        // Generate many real String inputs of that shape and drive them through the public API.
        String threeChar = buildThreeCharInput(data);
        exerciseTarget(threeChar, false, true);

        // Also explore nearby accepted/rejected shapes through the same real entry point.
        String nearby = buildNearbyInput(data);
        exerciseTarget(nearby, false, isValidByConstruction(nearby));

        // Metamorphic oracle:
        // BooleanUtils.toBoolean(String) is documented/tested as case-insensitive for the
        // accepted true literals ("on", "yes", "true"). Therefore different case renderings
        // of the same canonical token must produce the same boolean result. A patch that merely
        // deletes the crashing operation or makes the branch unreachable could silently return
        // a wrong value for some case patterns without throwing; this relation catches that.
        checkCaseInsensitiveTrueTokens(data);
    }

    private static void exerciseTarget(String input, boolean isAnchor, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(input);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagate(t, validByConstruction)) {
                throw t;
            }
        }
    }

    private static boolean shouldPropagate(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isValidByConstruction(String s) {
        // For this API, null is explicitly accepted and returns false in the contract/tests,
        // and arbitrary non-null Strings are also expected to be handled without index errors.
        return true;
    }

    private static String buildThreeCharInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 5);
        if (mode == 0) {
            return data.consumeAsciiString(3);
        }
        if (mode == 1) {
            char a = pickInterestingChar(data);
            char b = pickInterestingChar(data);
            char c = pickInterestingChar(data);
            return new String(new char[] { a, b, c });
        }
        if (mode == 2) {
            String seed = pickSeed(data);
            if (seed.length() >= 3) {
                return seed.substring(0, 3);
            }
            while (seed.length() < 3) {
                seed = seed + "x";
            }
            return seed;
        }
        if (mode == 3) {
            String s = data.consumeRemainingAsString();
            if (s.length() == 3) {
                return s;
            }
            if (s.length() > 3) {
                return s.substring(0, 3);
            }
            StringBuilder sb = new StringBuilder(s);
            while (sb.length() < 3) {
                sb.append((char) ('a' + data.consumeInt(0, 25)));
            }
            return sb.toString();
        }
        if (mode == 4) {
            String[] literals = new String[] {
                "off", "oof", "yep", "yes", "Yes", "YES", "tru", "Tru", "tRU"
            };
            return literals[data.consumeInt(0, literals.length - 1)];
        }
        return new String(new char[] {
            data.consumeBoolean() ? 'o' : 'y',
            data.consumeBoolean() ? 'f' : 'e',
            data.consumeBoolean() ? 'f' : 'p'
        });
    }

    private static String buildNearbyInput(FuzzedDataProvider data) {
        int len = data.consumeInt(0, 6);
        int mode = data.consumeInt(0, 4);
        if (mode == 0) {
            return data.consumeAsciiString(len);
        }
        if (mode == 1) {
            String[] literals = new String[] {
                "", "a", "on", "oN", "On", "ON",
                "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES",
                "true", "truE", "trUe", "trUE", "tRue", "tRuE", "tRUe", "tRUE",
                "TRUE", "TRUe", "TRuE", "TRue", "TrUE", "TrUe", "TruE", "True",
                "false", "yes?", "trux"
            };
            return literals[data.consumeInt(0, literals.length - 1)];
        }
        if (mode == 2) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < len; i++) {
                sb.append(pickInterestingChar(data));
            }
            return sb.toString();
        }
        if (mode == 3) {
            String prefix = data.consumeAsciiString(3);
            String suffix = data.consumeAsciiString(3);
            String combined = prefix + suffix;
            if (combined.length() <= len) {
                return combined;
            }
            return combined.substring(0, len);
        }
        return data.consumeRemainingAsString();
    }

    private static char pickInterestingChar(FuzzedDataProvider data) {
        char[] chars = new char[] {
            'o', 'O', 'n', 'N',
            'y', 'Y', 'e', 'E', 's', 'S',
            't', 'T', 'r', 'R', 'u', 'U',
            'f', 'F', 'a', 'x', '?'
        };
        return chars[data.consumeInt(0, chars.length - 1)];
    }

    private static String pickSeed(FuzzedDataProvider data) {
        String[] seeds = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe",
            "trUE", "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE",
            "TRue", "TrUE", "TrUe", "TruE", "True", "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        return seeds[data.consumeInt(0, seeds.length - 1)];
    }

    private static void checkCaseInsensitiveTrueTokens(FuzzedDataProvider data) {
        String token;
        switch (data.consumeInt(0, 2)) {
            case 0:
                token = "on";
                break;
            case 1:
                token = "yes";
                break;
            default:
                token = "true";
                break;
        }

        String mixed = applyRandomCase(token, data);
        String lower = token.toLowerCase();
        String upper = token.toUpperCase();

        Boolean mixedResult = callSafely(mixed);
        Boolean lowerResult = callSafely(lower);
        Boolean upperResult = callSafely(upper);

        if (mixedResult == null || lowerResult == null || upperResult == null) {
            return;
        }

        if (!mixedResult.equals(lowerResult) || !lowerResult.equals(upperResult) || !mixedResult.booleanValue()) {
            throw new RuntimeException(
                "[oracle:case-insensitive-true] metamorphic violation: equivalent case variants differ input="
                    + mixed + " lower=" + lower + " upper=" + upper
                    + " lhs=" + mixedResult + " rhsLower=" + lowerResult + " rhsUpper=" + upperResult);
        }
    }

    private static String applyRandomCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(Character.toLowerCase(ch));
            }
        }
        return sb.toString();
    }

    private static Boolean callSafely(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (shouldPropagate(t, true)) {
                throw t;
            }
            return null;
        }
    }
}
