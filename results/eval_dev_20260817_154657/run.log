package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30", true);
        runCase("\uD800\uDC00", true);
        runCase("\uD834\uDD1E", true);
        runCase("\uDBFF\uDFFD", true);

        String exploratory = buildValidCsvInputWithSupplementary(data);
        runCase(exploratory, true);
    }

    private static void runCase(String input, boolean validByConstruction) {
        final String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                rethrowUnchecked(t);
            }
            return;
        }

        try {
            /*
             * Contract asserted: escapeCsv/unescapeCsv are complementary CSV string
             * translators in the public API, so for any valid input string built here,
             * unescapeCsv(escapeCsv(x)) must recover x. A patch that merely skips the
             * crashing bookkeeping or makes the branch unreachable can silently drop or
             * corrupt characters while no exception fires; this round-trip oracle catches that.
             */
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException(
                    "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) == x input="
                        + printable(input) + " lhs=" + printable(roundTrip) + " rhs=" + printable(input));
            }
        } catch (RuntimeException oracle) {
            if (isOracleFailure(oracle)) {
                throw oracle;
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static String buildValidCsvInputWithSupplementary(FuzzedDataProvider data) {
        int tokens = data.consumeInt(1, 8);
        int supplementaryIndex = data.consumeInt(0, tokens - 1);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < tokens; i++) {
            boolean useSupplementary = (i == supplementaryIndex) || data.consumeBoolean();
            if (useSupplementary) {
                int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
                sb.append(Character.toChars(cp));
            } else {
                sb.append(chooseBmpChar(data));
            }
        }

        if (sb.length() == 0) {
            sb.append('\uD83D').append('\uDE30');
        }
        return sb.toString();
    }

    private static char chooseBmpChar(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 10)) {
            case 0:
                return 'A';
            case 1:
                return 'z';
            case 2:
                return '0';
            case 3:
                return ' ';
            case 4:
                return ',';
            case 5:
                return '"';
            case 6:
                return '\n';
            case 7:
                return '\r';
            case 8:
                return '-';
            case 9:
                return '_';
            default:
                char c = (char) data.consumeInt(1, 0xD7FF);
                if (Character.isSurrogate(c)) {
                    return 'B';
                }
                return c;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Malformed")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                        || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || Character.isSurrogate(c)) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
                    break;
            }
        }
        sb.append('"');
        return sb.toString();
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
    }
}
