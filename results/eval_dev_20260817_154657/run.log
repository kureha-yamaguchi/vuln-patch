                series.add(new Day(leftDay, month, year), Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(new Day(rightDay, month, year), Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(new Day(rightDay + i, month, year), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:setup-valid] metamorphic violation: valid series construction should not hit patched-region failure", e);
