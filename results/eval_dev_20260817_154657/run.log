package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseSilently("1234.5");

        if (data.remainingBytes() == 0) {
            return;
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String mantissa = digitsOnly(data.consumeAsciiString(12));
        String exponentDigits = digitsOnly(data.consumeAsciiString(6));
        String exponentSign = data.consumeBoolean() ? "-" : "";
        char expMarker = data.consumeBoolean() ? 'e' : 'E';

        if ("0".equals(mantissa) && data.consumeBoolean()) {
            mantissa = "1";
        }

        String suffixes = "DdFf";
        char suffix = suffixes.charAt(data.consumeInt(0, suffixes.length() - 1));

        String scientificWithSuffix = sign + mantissa + expMarker + exponentSign + exponentDigits + suffix;
        String scientificWithOtherCase = sign + mantissa + (expMarker == 'e' ? 'E' : 'e') + exponentSign + exponentDigits + suffix;
        String scientificWithRedundantDecimal = sign + mantissa + ".0" + expMarker + exponentSign + exponentDigits + suffix;

        exerciseSilently(scientificWithSuffix);
        exerciseSilently(sign + mantissa + expMarker + exponentSign + exponentDigits);
        exerciseSilently(sign + mantissa + ".0");
        exerciseSilently(sign + mantissa);
        exerciseSilently("0x" + digitsOnly(data.consumeAsciiString(8)));

        /*
         * Contract/oracle:
         * 1) createNumber explicitly handles both 'e' and 'E' as exponent markers, so changing only
         *    the exponent marker's case must preserve the parsed numeric value for any valid input.
         * 2) Adding a redundant ".0" immediately before the exponent does not change the represented
         *    number, so both strings must denote the same quantity when accepted.
         *
         * A throw-deleting or branch-skipping patch could avoid the old crash yet still parse the
         * mantissa/exponent split incorrectly; these metamorphic checks catch that wrong output.
         */
        checkEquivalentScientificExponentCase(scientificWithSuffix, scientificWithOtherCase);
        checkRedundantDecimalPointEquivalence(scientificWithSuffix, scientificWithRedundantDecimal);

        String noSuffixLower = sign + mantissa + "e" + exponentSign + exponentDigits;
        String noSuffixUpper = sign + mantissa + "E" + exponentSign + exponentDigits;
        String noSuffixDecimal = sign + mantissa + ".0e" + exponentSign + exponentDigits;
        checkEquivalentScientificExponentCase(noSuffixLower, noSuffixUpper);
        checkRedundantDecimalPointEquivalence(noSuffixLower, noSuffixDecimal);
    }

    private static void exerciseSilently(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            // Swallow all parser rejections and already-known crash signatures.
        }
    }

    private static void checkEquivalentScientificExponentCase(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void checkRedundantDecimalPointEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: redundant .0 before exponent changed value inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String message = t.getMessage();
        return message != null && message.startsWith("[oracle:");
    }

    private static String digitsOnly(String s) {
        if (s == null || s.length() == 0) {
            return "1";
        }
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            return "1";
        }
        return out.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal left = toBigDecimal(a).stripTrailingZeros();
            BigDecimal right = toBigDecimal(b).stripTrailingZeros();
            return left.compareTo(right) == 0;
        } catch (RuntimeException ignored) {
            return false;
        }
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float || n instanceof Double) {
            double d = n.doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                throw new IllegalArgumentException("non-finite");
            }
            return BigDecimal.valueOf(d);
        }
        return new BigDecimal(String.valueOf(n));
    }
}
