        if (count != items.size() || count != periods.size()) {
            throw new RuntimeException("[oracle:view-count] metamorphic violation: series views disagree on size"
                    + " label=" + label
                    + " count=" + count
                    + " itemsSize=" + items.size()
                    + " periodsSize=" + periods.size());
        }

        Object[] periodArray = periods.toArray();
        if (periodArray.length != count) {
            throw new RuntimeException("[oracle:view-period-array] metamorphic violation: time period collection materialization changed size"
                    + " label=" + label
                    + " count=" + count
                    + " arrayLength=" + periodArray.length);
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod pFromItem = item.getPeriod();
            RegularTimePeriod pFromSeries = series.getTimePeriod(i);
            Object pFromCollection = periodArray[i];

            if (!pFromItem.equals(pFromSeries) || !pFromItem.equals(pFromCollection)) {
                throw new RuntimeException("[oracle:view-period] metamorphic violation: period readers disagree"
                        + " label=" + label
                        + " index=" + i
                        + " itemPeriod=" + pFromItem
                        + " seriesPeriod=" + pFromSeries
                        + " collectionPeriod=" + pFromCollection);
            }

            Number vFromItem = item.getValue();
            Number vFromSeries = series.getValue(i);
            if (vFromItem == null ? vFromSeries != null : !vFromItem.equals(vFromSeries)) {
                throw new RuntimeException("[oracle:view-value] metamorphic violation: value readers disagree"
                        + " label=" + label
                        + " index=" + i
                        + " itemValue=" + vFromItem
                        + " seriesValue=" + vFromSeries);
            }

            int roundTrip = series.getIndex(pFromSeries);
            if (roundTrip != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex/getTimePeriod disagree"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + roundTrip
                        + " period=" + pFromSeries);
            }
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.setTime(new Date(((long) epochDay) * 86400000L));
        return new Day(cal.getTime());
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String m = t.getMessage();
        return m != null && m.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!isValidationFamily(t)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cn)
                    && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                return true;
            }
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException;
    }
