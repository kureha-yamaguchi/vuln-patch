public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("12e3E4");

        String leftDigits = positiveDigits(data, 1, 6);
        String middleDigits = positiveDigits(data, 1, 4);
        String rightDigits = positiveDigits(data, 0, 3);

        if (leftDigits.length() > rightDigits.length()) {
            String crashCandidate = leftDigits + "e" + middleDigits + "E" + rightDigits;
            NumberUtils.createNumber(crashCandidate);
        } else {
            String crashCandidate = leftDigits + "E" + middleDigits + "e";
            NumberUtils.createNumber(crashCandidate);
        }

        String mantissa = positiveDigits(data, 1, 6);
        String exponent = positiveDigits(data, 1, 3);
        String sign = data.consumeBoolean() ? "-" : "";

        String lower = sign + mantissa + "e" + exponent;
        String upper = sign + mantissa + "E" + exponent;
        String redundantDecimal = sign + mantissa + ".0E" + exponent;

        Number nLower = NumberUtils.createNumber(lower);
        Number nUpper = NumberUtils.createNumber(upper);
        Number nRedundant = NumberUtils.createNumber(redundantDecimal);

        if (!sameNumericValue(nLower, nUpper)) {
            throw new RuntimeException("[oracle:exp-case-equivalence] metamorphic violation: exponent marker case must preserve numeric value inputA="
                    + lower + " inputB=" + upper + " lhs=" + nLower + " rhs=" + nUpper);
        }

        if (!sameNumericValue(nLower, nRedundant)) {
            throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: adding redundant .0 before exponent must preserve numeric value inputA="
                    + lower + " inputB=" + redundantDecimal + " lhs=" + nLower + " rhs=" + nRedundant);
        }
    }

    private static String positiveDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (sb.length() == 0) {
            return "";
        }
        boolean allZero = true;
        for (int i = 0; i < sb.length(); i++) {
            if (sb.charAt(i) != '0') {
                allZero = false;
                break;
            }
        }
        if (allZero) {
            sb.setCharAt(0, '1');
        }
        return sb.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal left = new BigDecimal(a.toString()).stripTrailingZeros();
        BigDecimal right = new BigDecimal(b.toString()).stripTrailingZeros();
        return left.compareTo(right) == 0;
    }
}
