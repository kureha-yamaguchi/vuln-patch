package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testValidSafeCsvIdentity("\uD83D\uDE30");
        testValidSafeCsvIdentity("\uD800\uDC00");
        testValidSafeCsvIdentity("\uD834\uDD1E");
        testValidSafeCsvIdentity("\uDBFF\uDFFD");

        String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
        String middle = sanitizeCsvSafe(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

        int pairCount = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder(prefix.length() + middle.length() + suffix.length() + pairCount * 2 + 8);
        sb.append(prefix);
        for (int i = 0; i < pairCount; i++) {
            sb.append(randomSupplementaryCodePoint(data));
            if (i == 0) {
                sb.append(middle);
            } else if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
            }
        }
        sb.append(suffix);

        String constructed = sb.toString();
        if (!containsSurrogatePair(constructed)) {
            constructed = constructed + "\uD83D\uDE30";
        }
        testValidSafeCsvIdentity(constructed);
    }

    private static void testValidSafeCsvIdentity(String s) {
        try {
