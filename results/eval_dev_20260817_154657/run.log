            throw new FuzzerSecurityIssueLow(
                    "[oracle:boundary-step-right] stepping end to the exact right boundary must yield its singleton"
                            + " byBoundaryCount=" + byBoundary.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount()
