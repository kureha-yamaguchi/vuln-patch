package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();
        exerciseExplore(data);
    }

    private static void exerciseAnchor() {
        tryReplaceEach(null, new String[]{"a"}, new String[]{"b"}, false);
        tryReplaceEach("aba", null, null, false);
        tryReplaceEach("aba", new String[0], null, false);
        tryReplaceEach("aba", null, new String[0], false);
        tryReplaceEach("aba", new String[]{"a"}, null, false);
        tryReplaceEach("aba", new String[]{null}, new String[]{"a"}, false);
        tryReplaceEach("aba", new String[]{"a"}, new String[]{null}, false);

        String[] search = new String[]{"a", "b"};
        String[] repl = new String[]{"c", null};

        String direct = tryReplaceEach("aba", search, repl, true);
        String filtered = tryReplaceEach("aba", new String[]{"a"}, new String[]{"c"}, false);
        if (direct != null && filtered != null && !direct.equals(filtered)) {
            throw new RuntimeException("[oracle:null-filter-anchor] metamorphic violation: replaceEach with null replacements must equal replaceEach after removing null-replacement pairs input=aba lhs=" + direct + " rhs=" + filtered);
        }
    }

    private static void exerciseExplore(FuzzedDataProvider data) {
        String text = data.consumeString(64);
        if (text == null) {
            text = "";
        }

        int len = data.consumeInt(1, 6);
        String[] search = new String[len];
        String[] replacement = new String[len];

        boolean hasNullReplacement = false;
        boolean hasUsableReplacement = false;

        for (int i = 0; i < len; i++) {
            String s;
            switch (data.consumeInt(0, 5)) {
                case 0:
                    s = null;
                    break;
                case 1:
                    s = "";
                    break;
                case 2:
                    s = "a";
                    break;
                case 3:
                    s = "b";
                    break;
                case 4:
                    s = "ab";
                    break;
                default:
                    s = data.consumeAsciiString(4);
                    break;
            }
            search[i] = s;

            if (data.consumeBoolean()) {
                replacement[i] = null;
                hasNullReplacement = true;
            } else {
                String r;
                switch (data.consumeInt(0, 5)) {
                    case 0:
                        r = "";
                        break;
                    case 1:
                        r = "c";
                        break;
                    case 2:
                        r = "x";
                        break;
                    case 3:
                        r = "zz";
                        break;
                    case 4:
                        r = data.consumeAsciiString(4);
                        break;
                    default:
                        r = data.consumeString(4);
                        break;
                }
                replacement[i] = r;
                hasUsableReplacement = true;
            }
        }

        if (!hasNullReplacement) {
            int idx = data.consumeInt(0, len - 1);
            replacement[idx] = null;
            hasNullReplacement = true;
        }
        if (!hasUsableReplacement) {
            int idx = data.consumeInt(0, len - 1);
            replacement[idx] = "c";
            hasUsableReplacement = true;
        }

        boolean ensuredMatch = false;
        for (int i = 0; i < len; i++) {
            if (replacement[i] != null && search[i] != null && search[i].length() > 0) {
                text = surround(text, search[i], data.consumeAsciiString(3), data.consumeAsciiString(3));
                ensuredMatch = true;
                break;
            }
        }
        if (!ensuredMatch) {
            search[0] = "a";
            replacement[0] = "c";
            text = surround(text, "a", data.consumeAsciiString(3), data.consumeAsciiString(3));
        }

        String[] filteredSearch = filterByNonNullReplacement(search, replacement, true);
        String[] filteredReplacement = filterByNonNullReplacement(search, replacement, false);

        String lhs = tryReplaceEach(text, search, replacement, true);
        String rhs = tryReplaceEach(text, filteredSearch, filteredReplacement, false);

        /*
         * Contract asserted by tests for the public API:
         * pairs whose replacement element is null are ignored
         * (e.g. replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
         * and replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc").
         * Therefore, calling replaceEach with null-replacement pairs present must produce
         * the same result as calling replaceEach after removing those pairs.
         * A patch that merely deletes the crashing code path or skips bookkeeping wrongly
         * could still return an incorrect result and violate this relation.
         */
        if (lhs != null && rhs != null && !lhs.equals(rhs)) {
            throw new RuntimeException("[oracle:null-filter] metamorphic violation: replaceEach with null replacements must equal replaceEach after removing null-replacement pairs input=" + quote(text) + " lhs=" + quote(lhs) + " rhs=" + quote(rhs));
        }

        String once = tryReplaceEach(text, search, replacement, true);
        String twice = null;
        if (once != null) {
            twice = tryReplaceEach(once, search, replacement, true);
        }
        if (once != null && twice != null && !once.equals(twice)) {
            throw new RuntimeException("[oracle:idempotence] metamorphic violation: replaceEach should be idempotent for repeat=false public API input=" + quote(text) + " once=" + quote(once) + " twice=" + quote(twice));
        }
    }

    private static String tryReplaceEach(String text, String[] search, String[] replacement, boolean validByConstruction) {
        try {
            return StringUtils.replaceEach(text, search, replacement);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw rethrow(t);
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            String lower = name.toLowerCase();
            if (lower.contains("invalid") || lower.contains("validation")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "replaceEach".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "length".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

    private static String[] filterByNonNullReplacement(String[] search, String[] replacement, boolean wantSearch) {
        int count = 0;
        for (int i = 0; i < replacement.length; i++) {
            if (replacement[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < replacement.length; i++) {
            if (replacement[i] != null) {
                out[j++] = wantSearch ? search[i] : replacement[i];
            }
        }
        return out;
    }

    private static String surround(String base, String needle, String prefix, String suffix) {
        if (base == null) {
            base = "";
        }
        if (prefix == null) {
            prefix = "";
        }
        if (suffix == null) {
            suffix = "";
        }
        return prefix + needle + base + suffix;
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
