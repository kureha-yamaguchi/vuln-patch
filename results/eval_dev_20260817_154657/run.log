package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            BooleanUtils.toBoolean("off");
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        String surrounding = data.consumeAsciiString(16);
        String candidate;
        if (surrounding.length() >= 3) {
            int start = data.consumeInt(0, surrounding.length() - 3);
            candidate = surrounding.substring(start, start + 3);
        } else {
            StringBuilder sb = new StringBuilder(surrounding);
            while (sb.length() < 3) {
                char c = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                sb.append(c);
            }
            candidate = sb.substring(0, 3);
        }

        char c0 = candidate.charAt(0);
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
            candidate = c0 + candidate.substring(1);
        }

        try {
            BooleanUtils.toBoolean(candidate);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        StringBuilder variant = new StringBuilder(3);
        variant.append(data.consumeBoolean() ? 'y' : 'Y');
        variant.append(data.consumeBoolean() ? 'e' : 'E');
        variant.append(data.consumeBoolean() ? 's' : 'S');
        String yesVariant = variant.toString();

        try {
            boolean parsed = BooleanUtils.toBoolean(yesVariant);
            if (!parsed) {
                throw new RuntimeException("[oracle:yes-true] metamorphic violation: constructed case-variant of 'yes' must parse as true input="
                        + yesVariant + " lhs=" + parsed + " rhs=true");
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        String upper = yesVariant.toUpperCase();
        try {
            boolean lhs = BooleanUtils.toBoolean(yesVariant);
            boolean rhs = BooleanUtils.toBoolean(upper);
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:case-equiv] metamorphic violation: case-insensitive equivalents must agree input="
                        + yesVariant + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
