package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5");

        int bounded = data.consumeInt(-1_000_000, 1_000_000);
        String digits = Integer.toString(Math.abs(bounded));
        if (digits.length() == 0) {
            digits = "0";
        }
        String sign = data.consumeBoolean() ? "-" : "";
        String filler = sanitizeNoDot(data.consumeAsciiString(8));
        String suffix = "";
        switch (data.consumeInt(0, 4)) {
            case 1:
                suffix = "L";
                break;
            case 2:
                suffix = "F";
                break;
            case 3:
                suffix = "D";
                break;
            default:
                suffix = "";
        }

        exerciseCreateNumber(sign + digits + "e" + filler + "E" + suffix);
        exerciseCreateNumber(sign + digits + "E" + filler + "e" + suffix);
        exerciseCreateNumber(sign + digits + "e");
        exerciseCreateNumber(sign + digits + "E");
        exerciseCreateNumber(sign + digits + filler + "E");
        exerciseCreateNumber(sign + digits + filler + "e");

        String extra = sanitizeNoDot(data.consumeRemainingAsString());
        if (extra.length() > 0) {
            exerciseCreateNumber(sign + digits + "e" + extra + "E");
            exerciseCreateNumber(sign + digits + "E" + extra + "e");
        }

        checkLongSuffixEquivalence(data.consumeInt(-1_000_000, 1_000_000));

        int whole = data.consumeInt(-1_000_000, 1_000_000);
        checkFloatSuffixEquivalence(whole);

        int sciWhole = data.consumeInt(-1_000_000, 1_000_000);
        int exp = data.consumeInt(-20, 20);
        checkScientificCaseEquivalence(sciWhole, exp);
    }

    private static void exerciseCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isKnownRootCause(t)) {
                return;
            }
        }
    }

    private static String sanitizeNoDot(String s) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length() && sb.length() < 8; i++) {
            char c = s.charAt(i);
            if (c == '.') {
                continue;
            }
            if (c == 'e' || c == 'E') {
                sb.append('7');
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('0');
        }
        return sb.toString();
    }

    private static void checkLongSuffixEquivalence(int value) {
        String plain = Integer.toString(value);
        String suffixed = plain + "L";
        try {
            Number a = NumberUtils.createNumber(plain);
            Number b = NumberUtils.createNumber(suffixed);
            if (a != null && b != null && !sameNumericValue(a, b)) {
                throw new RuntimeException("[oracle:long-suffix-equivalence] metamorphic violation: integer and explicit-long forms disagreed inputA="
                        + plain + " inputB=" + suffixed + " lhs=" + a + " rhs=" + b);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void checkFloatSuffixEquivalence(int whole) {
        String plain = whole + ".5";
        String suffixed = plain + "F";
        try {
            Number a = NumberUtils.createNumber(plain);
            Number b = NumberUtils.createNumber(suffixed);
            if (a != null && b != null && !sameNumericValue(a, b)) {
                throw new RuntimeException("[oracle:float-suffix-equivalence] metamorphic violation: unsuffixed decimal and explicit-float form disagreed inputA="
                        + plain + " inputB=" + suffixed + " lhs=" + a + " rhs=" + b);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void checkScientificCaseEquivalence(int whole, int exp) {
        String mantissa = whole + ".5";
        String exponent = Integer.toString(exp);
        String lower = mantissa + "e" + exponent;
        String upper = mantissa + "E" + exponent;
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal aa = new BigDecimal(a.toString());
            BigDecimal bb = new BigDecimal(b.toString());
            return aa.compareTo(bb) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (StackTraceElement ste : stack) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)
                        || "isDigits".equals(m)
                        || "isAllZeros".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }
}
