        }
        boolean sliceResult = callToBoolean(slice, true);
        if (sliceResult) {
            throw new RuntimeException("[oracle:false3] metamorphic violation: unrecognized 3-char string must map to false input=" + slice + " lhs=true rhs=false");
        }

        // Oracle 1: Equivalent-input relation for ASCII strings.
        // Documented/visible guarantee from the implementation and tests: parsing of the accepted
