package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: verified trigger from the failing test / ground truth crash.
        invokeToBoolean("off", true);

        // EXPLORE: root-cause property is any non-null 3-char string whose first
        // character is neither 'y' nor 'Y'. In the buggy version, case 3 falls
        // through into case 4 and may read charAt(3).
        for (int i = 0; i < 4; i++) {
            String raw = data.consumeString(6);
            String candidate = forceThreeCharsFirstNotY(raw, data);
            invokeToBoolean(candidate, true);

            // Contract/oracle: from the method body and tests, 3-char strings only
            // map to true for case-insensitive "yes". A 3-char string whose first
            // char is not 'y'/'Y' therefore must return false. A "fix" that merely
            // deletes the crash or rewires the branch to return true would violate this.
            try {
                boolean result = BooleanUtils.toBoolean(candidate);
                if (result) {
                    throw new RuntimeException(
                        "[oracle:not-yes-false] metamorphic violation: non-'yes' 3-char token must be false input="
                            + printable(candidate) + " lhs=" + result + " rhs=false");
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t) && true) {
                    throw t;
                }
                return;
            }
        }

        // Contract/oracle: visible in the code and test_toBoolean_String,
        // case-insensitive "yes" must return true for every casing.
        String yesVariant = randomCase("yes", data);
        try {
            boolean yesResult = BooleanUtils.toBoolean(yesVariant);
            if (!yesResult) {
                throw new RuntimeException(
                    "[oracle:yes-true] metamorphic violation: case-insensitive 'yes' must be true input="
                        + printable(yesVariant) + " lhs=" + yesResult + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // Additional real-entry exploration of adjacent public-API inputs.
        invokeToBoolean(randomCase("on", data), true);
        invokeToBoolean(randomCase("true", data), true);
        invokeToBoolean(data.consumeAsciiString(8), true);
    }

    private static void invokeToBoolean(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String forceThreeCharsFirstNotY(String raw, FuzzedDataProvider data) {
        char c0 = pickNonY(raw, 0, data);
        char c1 = pickAny(raw, 1, data);
        char c2 = pickAny(raw, 2, data);
        return new String(new char[] { c0, c1, c2 });
    }

    private static char pickNonY(String s, int idx, FuzzedDataProvider data) {
        char c = pickAny(s, idx, data);
        if (c == 'y' || c == 'Y') {
            c = (char) ('a' + data.consumeInt(0, 25));
            if (c == 'y' || c == 'Y') {
                c = 'o';
            }
        }
        return c;
    }

    private static char pickAny(String s, int idx, FuzzedDataProvider data) {
        if (s != null && idx < s.length()) {
            return s.charAt(idx);
        }
        return (char) (32 + data.consumeInt(0, 94));
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        char[] out = s.toCharArray();
        for (int i = 0; i < out.length; i++) {
            if (data.consumeBoolean()) {
                out[i] = Character.toUpperCase(out[i]);
            } else {
                out[i] = Character.toLowerCase(out[i]);
            }
        }
        return new String(out);
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
