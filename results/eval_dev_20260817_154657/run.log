public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        if (data.consumeBoolean()) {
            NumberUtils.createNumber("l");
        } else {
            NumberUtils.createNumber("L");
        }

        String digits = buildDigits(data, 1, 18);
        String numeric = data.consumeBoolean() ? digits : ("-" + digits);
        String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");

        Number parsed = NumberUtils.createNumber(suffixed);
        Long helper = NumberUtils.createLong(numeric);
        if (!(parsed instanceof Long) || helper == null || parsed.longValue() != helper.longValue()) {
            throw new RuntimeException(
                    "[oracle:integral-long-suffix-helper-consistency] metamorphic violation: createNumber(decimal+L) must agree with createLong(decimal) input="
                            + suffixed + " parsed=" + parsed + " helper=" + helper);
        }

        Number lower = NumberUtils.createNumber(numeric + "l");
        Number upper = NumberUtils.createNumber(numeric + "L");
        if (!(lower instanceof Long) || !(upper instanceof Long) || lower.longValue() != upper.longValue()
                || lower.longValue() != helper.longValue()) {
            throw new RuntimeException(
                    "[oracle:integral-long-suffix-case-consistency] metamorphic violation: lower/upper explicit long suffixes must agree on valid decimal integers input="
                            + numeric + " lower=" + lower + " upper=" + upper + " helper=" + helper);
        }

        String overflow = buildOverflowDigits(data);
        String overflowNumeric = data.consumeBoolean() ? overflow : ("-" + overflow);
        String overflowSuffixed = overflowNumeric + (data.consumeBoolean() ? "L" : "l");
        Number overflowParsed = NumberUtils.createNumber(overflowSuffixed);
        BigInteger overflowHelper = NumberUtils.createBigInteger(overflowNumeric);
        if (!(overflowParsed instanceof BigInteger) || overflowHelper == null || !overflowHelper.equals(overflowParsed)) {
            throw new RuntimeException(
                    "[oracle:integral-long-overflow-bigint-fallback] metamorphic violation: createNumber(overflow+L) must fall back to createBigInteger with the same value input="
                            + overflowSuffixed + " parsed=" + overflowParsed + " helper=" + overflowHelper);
        }
    }
