    private static void checkMustBeFalse(String s) {
        Boolean result = safeToBoolean(s);
        if (result != null && result.booleanValue()) {
            throw new RuntimeException("[oracle:false-literals] metamorphic violation: documented false literal mapped to true input=" + String.valueOf(s) + " lhs=" + result + " rhs=false");
        }
    }

    private static void checkMustBeTrue(String s) {
        Boolean result = safeToBoolean(s);
        if (result != null && !result.booleanValue()) {
            throw new RuntimeException("[oracle:true-literals] metamorphic violation: documented true literal mapped to false input=" + String.valueOf(s) + " lhs=" + result + " rhs=true");
        }
    }

    private static Boolean safeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

