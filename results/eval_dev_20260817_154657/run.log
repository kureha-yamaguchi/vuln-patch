package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testOne("\uD83D\uDE30", true);
        testOne("\uD800\uDC00", true);
        testOne("\uD834\uDD1E", true);
        testOne("\uDBFF\uDFFD", true);

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        int pairCount = data.consumeInt(1, 3);

        StringBuilder sb = new StringBuilder(prefix.length() + suffix.length() + pairCount * 2 + 8);
        sb.append(prefix);

        if (data.consumeBoolean()) {
            sb.append(csvSpecial(data.consumeInt(0, 3)));
        }

        for (int i = 0; i < pairCount; i++) {
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(codePoint));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(3)));
            }
        }

        if (data.consumeBoolean()) {
            sb.append(csvSpecial(data.consumeInt(0, 3)));
        }

        sb.append(suffix);

        testOne(sb.toString(), true);
    }

    private static void testOne(String input, boolean validByConstruction) {
        String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (shouldPropagate(t, validByConstruction)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException(
                    "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) must equal x input="
                        + repr(input) + " lhs=" + repr(roundTrip) + " rhs=" + repr(input));
            }

            // Contract used for this oracle: escapeCsv leaves Strings without commas, quotes,
            // CR, or LF unchanged. A "fix" that merely skips bookkeeping/work could avoid the
            // crash but silently drop or alter characters, which this direct post-condition catches.
            if (!containsCsvMeta(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv(x) must equal x when x contains no CSV metacharacters input="
                        + repr(input) + " lhs=" + repr(escaped) + " rhs=" + repr(input));
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && String.valueOf(t.getMessage()).startsWith("[oracle:")) {
                throw (RuntimeException) t;
            }
            if (shouldPropagate(t, validByConstruction)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean shouldPropagate(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (isCleanRejection(t)) {
            return false;
        }
        if (t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException) {
            for (StackTraceElement e : t.getStackTrace()) {
                if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                        && "translate".equals(e.getMethodName())) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t.getClass().getName().contains("Validation");
    }

    private static boolean containsCsvMeta(String s) {
        return s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\r') >= 0 || s.indexOf('\n') >= 0;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String csvSpecial(int which) {
        switch (which) {
            case 0:
                return ",";
            case 1:
                return "\"";
            case 2:
                return "\n";
            default:
                return "\r";
        }
    }

    private static String repr(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
