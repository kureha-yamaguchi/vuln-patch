package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();
        exploreNullElementRelation(data);
    }

    private static void runAnchorCases() {
        verifyExpected("aba", new String[]{null}, new String[]{"a"}, "aba", "anchor-null-search");
        verifyExpected("aba", new String[]{"a"}, new String[]{null}, "aba", "anchor-null-replacement");
        verifyExpected("aba", new String[]{"a", "b"}, new String[]{"c", null}, "cbc", "anchor-mixed-null-replacement");

        try {
            if (StringUtils.replaceEach(null, new String[]{"a"}, new String[]{"b"}) != null) {
                throw new RuntimeException("[oracle:anchor-null-text] metamorphic violation: replaceEach(null,...) must return null");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-null-text] metamorphic violation: replaceEach(null,...) should return null, but threw " + t, t);
            }
        }

        try {
            String a = StringUtils.replaceEach("aba", null, null);
            String b = "aba";
            if (!safeEquals(a, b)) {
                throw new RuntimeException("[oracle:anchor-null-arrays] metamorphic violation: expected identity for null arrays lhs=" + a + " rhs=" + b);
            }
            StringUtils.length(a);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:anchor-null-arrays] metamorphic violation: null arrays should be accepted", t);
            }
        }
    }

    private static void verifyExpected(String text, String[] searchList, String[] replacementList, String expected, String oracleId) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            StringUtils.length(actual);
            if (!safeEquals(actual, expected)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: expected=" + expected + " actual=" + actual);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: null array elements are documented-by-test to be ignored for valid inputs", t);
            }
        }
    }

    private static void exploreNullElementRelation(FuzzedDataProvider data) {
        int n = data.consumeInt(1, 4);
        String text = nonNullToken(data.consumeString(24));

        String[] baseSearch = new String[n];
        String[] baseReplacement = new String[n];
        for (int i = 0; i < n; i++) {
            baseSearch[i] = nonEmptyToken(data.consumeString(6), "s" + i);
            baseReplacement[i] = nonNullToken(data.consumeString(6));
            StringUtils.length(baseSearch[i]);
            StringUtils.length(baseReplacement[i]);
        }

        int nullIndex = data.consumeInt(0, n - 1);
        boolean nullInSearch = data.consumeBoolean();

        String[] withNullSearch = copy(baseSearch);
        String[] withNullReplacement = copy(baseReplacement);
        if (nullInSearch) {
            withNullSearch[nullIndex] = null;
        } else {
            withNullReplacement[nullIndex] = null;
        }

        String[] filteredSearch = new String[n - 1];
        String[] filteredReplacement = new String[n - 1];
        int out = 0;
        for (int i = 0; i < n; i++) {
            if (i == nullIndex) {
                continue;
            }
            filteredSearch[out] = baseSearch[i];
            filteredReplacement[out] = baseReplacement[i];
            out++;
        }

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, withNullSearch, withNullReplacement);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                    "[oracle:null-pair-ignored] metamorphic violation: inserting one null search/replacement pair into equal-length arrays should be ignored for valid inputs text="
                        + text + " nullIndex=" + nullIndex + " nullInSearch=" + nullInSearch,
                    t);
            }
            return;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (Throwable t) {
            return;
        }

        try {
            int lhsLen = StringUtils.length(lhs);
            int rhsLen = StringUtils.length(rhs);
            if (!safeEquals(lhs, rhs) || lhsLen != rhsLen) {
                throw new RuntimeException(
                    "[oracle:null-pair-ignored] metamorphic violation: adding an ignored null pair changed the result text="
                        + text + " lhs=" + lhs + " rhs=" + rhs + " lhsLen=" + lhsLen + " rhsLen=" + rhsLen);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                && ("replaceEach".equals(e.getMethodName()) || "length".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String[] copy(String[] in) {
        String[] out = new String[in.length];
        for (int i = 0; i < in.length; i++) {
            out[i] = in[i];
        }
        return out;
    }

    private static String nonNullToken(String s) {
        return s == null ? "" : s;
    }

    private static String nonEmptyToken(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
