            String numeric = "+" + digits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);
                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");

                /*
                 * Contract from NumberUtils.createNumber's real code:
                 * with an explicit L/l suffix and a valid decimal integral payload, it takes the long-typed
