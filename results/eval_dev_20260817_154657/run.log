                return;
            } catch (RuntimeException e) {
                if (isCleanRejection(e) && passesThroughCreateCopy(e) && isValidConstructedRange(start, end)) {
                    throw new RuntimeException("[oracle:valid-range-rejected] metamorphic violation: createCopy rejected a valid empty range"
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end, e);
                }
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        if (!isValidConstructedRange(start, end)) {
            return;
        }

        if (countItemsInRange(s, start, end) != 0) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor range must be an empty gap");
        }

        if (s.getIndex(start) >= 0 || s.getIndex(end) >= 0) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor endpoints must be absent");
        }

        try {
            TimeSeries copy = s.createCopy(start, end);

            /* Contract used: getItemCount() reports the number of items in the series,
               while getItems() and getTimePeriods() are views over the same backing data.
               A throw-deleting or bookkeeping-skipping patch can return a series whose
               exposed views disagree, so cross-check them independently. */
            checkSeriesViewConsistency(copy, "anchor-copy");

            if (copy.getItemCount() != 0) {
                throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor empty gap must copy to an empty series"
                        + " copyCount=" + copy.getItemCount());
            }

