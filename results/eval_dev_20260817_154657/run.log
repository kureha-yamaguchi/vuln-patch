package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact regression inputs from StringUtilsTest.testEscapeSurrogatePairs.
        runEscapeCsv("\uD83D\uDE30", true);
        runEscapeCsv("\uD800\uDC00", true);
        runEscapeCsv("\uD834\uDD1E", true);
        runEscapeCsv("\uDBFF\uDFFD", true);

        // Explore: build valid-by-construction CSV-safe strings that contain one or more
        // well-formed surrogate pairs at varying positions. For CSV escaping, strings that
        // contain no comma, quote, CR, or LF must be returned unchanged; therefore a patch
        // that merely suppresses the crash but drops/rewrites characters violates this oracle.
        String input = buildValidCsvSafeSupplementaryString(data);
        runEscapeCsv(input, true);
    }

    private static void runEscapeCsv(String input, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract used for this oracle:
            // StringEscapeUtils.escapeCsv returns the input unchanged when it contains none of
            // comma, double quote, CR, or LF. buildValidCsvSafeSupplementaryString constructs
            // exactly such non-degenerate inputs, so equality is required for every correct
            // implementation. A throw-deleting patch that skips or mangles surrogate pairs
            // breaks this observable post-condition.
            if (assertIdentity && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:escapeCsvIdentity] metamorphic violation: CSV-safe input must be unchanged"
                        + " input=" + printable(input)
                        + " lhs=" + printable(escaped)
                        + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (t instanceof RuntimeException && t.getMessage() != null
                    && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            // Swallow unrelated runtime failures to avoid false positives outside this patch.
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidCsvSafeSupplementaryString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int parts = data.consumeInt(1, 4);
        for (int i = 0; i < parts; i++) {
            sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(8)));
            sb.append(randomSupplementaryPair(data, i));
        }
        sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(8)));

        if (sb.length() == 0) {
            sb.append('A').append("\uD83D\uDE30").append('B');
        }

        return sb.toString();
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('X');
            } else if (c < 0x20 && c != '\t') {
                sb.append('Y');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String randomSupplementaryPair(FuzzedDataProvider data, int salt) {
        int[] anchors = new int[] { 0x1F630, 0x10000, 0x1D11E, 0x10FFFD };
        if (data.consumeBoolean()) {
            return new String(Character.toChars(anchors[Math.floorMod(salt + data.consumeInt(), anchors.length)]));
        }

        int high = data.consumeInt(0xD800, 0xDBFF);
        int low = data.consumeInt(0xDC00, 0xDFFF);
        char[] pair = new char[] { (char) high, (char) low };
        return new String(pair);
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
