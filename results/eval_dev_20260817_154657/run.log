package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String digitsA = nonEmptyDigits(data.consumeAsciiString(12));
        String digitsB = nonEmptyDigits(data.consumeAsciiString(8));
        String digitsC = nonEmptyDigits(data.consumeAsciiString(8));
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? "-" : "";
        String frac = data.consumeBoolean() ? ("." + nonEmptyDigits(data.consumeAsciiString(6))) : "";

        String validLower = sign + digitsA + frac + "e" + expSign + digitsB;
        String validUpper = sign + digitsA + frac + "E" + expSign + digitsB;
        checkEquivalentScientificExponentCase(validLower, validUpper);
        checkRoundTripConsistency(validLower);
        checkRoundTripConsistency(validUpper);

        String plain = sign + digitsA;
        checkRoundTripConsistency(plain);

        String suffix = consumeTypeSuffix(data);
        String validWithSuffixLower = validLower + suffix;
        String validWithSuffixUpper = validUpper + suffix;
        checkEquivalentScientificExponentCase(validWithSuffixLower, validWithSuffixUpper);
        checkRoundTripConsistency(validWithSuffixLower);
        checkRoundTripConsistency(validWithSuffixUpper);

        String dualExponent = sign + digitsA + "e" + digitsB + "E" + digitsC;
        exerciseCreateNumber(dualExponent, false);
        exerciseCreateNumber(dualExponent + suffix, false);

        String dualExponentWithTrailingDigits = sign + digitsA + "e" + digitsB + "E" + digitsC + nonEmptyDigits(data.consumeAsciiString(4));
        exerciseCreateNumber(dualExponentWithTrailingDigits, false);

        if (data.consumeBoolean()) {
            String noDotDual = sign + digitsA + "E" + digitsB + "e" + digitsC;
            exerciseCreateNumber(noDotDual, false);
            exerciseCreateNumber(noDotDual + suffix, false);
        }
    }

    private static String consumeTypeSuffix(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 4)) {
            case 0:
                return "";
            case 1:
                return "F";
            case 2:
                return "f";
            case 3:
                return "D";
            default:
                return "d";
        }
    }

    private static String nonEmptyDigits(String s) {
        if (s == null || s.length() == 0) {
            return "1";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + (c & 7)));
            }
        }
        if (sb.length() == 0) {
            sb.append('1');
        }
        return sb.toString();
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRoundTripConsistency(String s) {
        try {
            Number first = NumberUtils.createNumber(s);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number reparsed = NumberUtils.createNumber(canonical);
            if (reparsed != null && !sameNumericValue(first, reparsed)) {
                throw new RuntimeException("[oracle:roundtrip-canonical-number] metamorphic violation: createNumber(x).toString() reparsed to different quantity input="
                        + s + " canonical=" + canonical + " first=" + first + " reparsed=" + reparsed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = toBigDecimal(a);
            BigDecimal rhs = toBigDecimal(b);
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return ((BigDecimal) n).stripTrailingZeros();
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        return new BigDecimal(n.toString()).stripTrailingZeros();
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                return true;
            }
            if ("java.lang.String".equals(cls) && "substring".equals(method)) {
                for (int j = i + 1; j < stack.length; j++) {
                    StackTraceElement caller = stack[j];
                    if ("org.apache.commons.lang3.math.NumberUtils".equals(caller.getClassName())
                            && "createNumber".equals(caller.getMethodName())) {
                        return true;
                    }
                }
            }
        }
        return false;
    }
}
