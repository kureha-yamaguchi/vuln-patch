package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseSilently("1234.5");
        exerciseSilently("12345");
        exerciseSilently("1234.5D");
        exerciseSilently("1234.5F");
        exerciseSilently("12345L");
        exerciseSilently("-1234.5");
        exerciseSilently("0xFADE");
        exerciseSilently("1.1E20");
        exerciseSilently("2.");

        String digits = onlyDigits(data.consumeAsciiString(12));
        if (digits.length() == 0) {
            digits = "0";
        }

        boolean negative = data.consumeBoolean();
        String sign = negative ? "-" : "";

        int exponentValue = data.consumeInt(-6, 6);
        String exponent = Integer.toString(exponentValue);

        String[] suffixes = new String[] {"", "F", "f", "D", "d"};
        String suffix = suffixes[data.consumeInt(0, suffixes.length - 1)];

        String noDecimal = sign + digits + "E" + exponent + suffix;
        String withDecimal = sign + digits + ".0E" + exponent + suffix;

        exerciseSilently(noDecimal);
        exerciseSilently(withDecimal);

        checkRedundantDecimalPointEquivalence(noDecimal, withDecimal);

        String upper = sign + digits + "E" + exponent + suffix;
        String lower = sign + digits + "e" + exponent + suffix;
        exerciseSilently(lower);
        checkExponentCaseAndDecimalBoundary(lower, withDecimal);

        String zeroDigits = allZerosLike(digits);
        String zeroNoDecimal = sign + zeroDigits + "E0" + suffix;
        String zeroWithDecimal = sign + zeroDigits + ".0E0" + suffix;
        exerciseSilently(zeroNoDecimal);
        exerciseSilently(zeroWithDecimal);
        checkRedundantDecimalPointEquivalence(zeroNoDecimal, zeroWithDecimal);
    }

    private static void exerciseSilently(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanReject(t)) {
                return;
            }
            if (isKnownRootCauseInCreateNumber(t)) {
                return;
            }
        }
    }

    private static void checkRedundantDecimalPointEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: integer-mantissa scientific notation and the same notation with a redundant .0 before the exponent must denote the same quantity inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isKnownRootCauseInCreateNumber(t)) {
                return;
            }
        }
    }

    private static void checkExponentCaseAndDecimalBoundary(String lower, String withDecimalUpperE) {
        try {
            Number left = NumberUtils.createNumber(lower);
            Number right = NumberUtils.createNumber(withDecimalUpperE);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:exp-case-plus-decimal-boundary] metamorphic violation: changing exponent-marker case and inserting a redundant .0 before the exponent must preserve numeric value inputA="
                        + lower + " inputB=" + withDecimalUpperE + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isKnownRootCauseInCreateNumber(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal bdA = toBigDecimal(a);
        BigDecimal bdB = toBigDecimal(b);
        return bdA != null && bdB != null && bdA.compareTo(bdB) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        try {
            if (n instanceof BigDecimal) {
                return ((BigDecimal) n).stripTrailingZeros();
            }
            if (n instanceof BigInteger) {
                return new BigDecimal((BigInteger) n);
            }
            if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
                return BigDecimal.valueOf(n.longValue());
            }
            if (n instanceof Float || n instanceof Double) {
                double d = n.doubleValue();
                if (Double.isNaN(d) || Double.isInfinite(d)) {
                    return null;
                }
                return new BigDecimal(n.toString()).stripTrailingZeros();
            }
            return new BigDecimal(n.toString()).stripTrailingZeros();
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isKnownRootCauseInCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(frame.getClassName())
                    && "createNumber".equals(frame.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String onlyDigits(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String allZerosLike(String s) {
        int len = s.length();
        if (len == 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append('0');
        }
        return sb.toString();
    }
}
