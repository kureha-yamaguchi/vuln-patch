        {
            String overflowDigits = buildOverflowDigits(data);
            String numeric = "+" + overflowDigits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                BigInteger helper = NumberUtils.createBigInteger(numeric);
                Number explicit = NumberUtils.createNumber(suffixed);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * In the real l/L branch, if createLong overflows, createNumber falls back to createBigInteger
                 * on the same numeric payload. Therefore explicit-suffix and unsuffixed parses of the same valid
                 * decimal must preserve exactly the helper BigInteger value.
