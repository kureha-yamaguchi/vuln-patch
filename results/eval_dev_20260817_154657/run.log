package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test / ground truth.
        invokeToBoolean("off", true);

        // Additional fixed examples from the failing test to keep the real public API hot.
        invokeToBoolean("oof", true);
        invokeToBoolean("yep", true);
        invokeToBoolean("tru", true);

        // EXPLORE the root-cause shape with many real strings:
        // non-null strings, especially length-3 inputs, since the patched region is in case 3.
        String fuzz = data.consumeAsciiString(16);
        invokeToBoolean(fuzz, true);

        String len3 = makeLen3(data.consumeAsciiString(3), data);
        invokeToBoolean(len3, true);

        // Vary positions/surrounding content, but still drive real length-3 windows through the API.
        String surrounding = data.consumeAsciiString(12);
        invokeToBoolean(surrounding, true);
        for (int i = 0; i + 3 <= surrounding.length(); i++) {
            invokeToBoolean(surrounding.substring(i, i + 3), true);
        }

        // Build more length-3 candidates biased toward the observed literals / same shape.
        String[] seeds = new String[] { "off", "oof", "yep", "tru", "yes", "onx", "abz" };
        for (int i = 0; i < 4; i++) {
            String base = seeds[data.consumeInt(0, seeds.length - 1)];
            char[] chars = base.toCharArray();
            int idx = data.consumeInt(0, chars.length - 1);
            chars[idx] = randomAsciiLetter(data);
            invokeToBoolean(new String(chars), true);
        }

        // Metamorphic/post-condition:
        // The code for toBoolean(String) explicitly treats "yes" case-insensitively:
        // each character is compared against both upper and lower case.
        // Therefore every case-variant of "yes" must produce the same result as canonical "yes".
        // A "fix" that merely avoids the crash by skipping/bypassing the branch could return the wrong
        // value for mixed-case valid inputs; this oracle catches that silent semantic regression.
        String yesVariant = randomCase("yes", data);
        Boolean lhs = evalToBooleanSkippingRejections(yesVariant, true);
        Boolean rhs = evalToBooleanSkippingRejections("yes", true);
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:yes-case] metamorphic violation: case-insensitive variants of 'yes' must agree input="
                    + quote(yesVariant) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void invokeToBoolean(String s, boolean validByConstruction) {
        evalToBooleanSkippingRejections(s, validByConstruction);
    }

    private static Boolean evalToBooleanSkippingRejections(String s, boolean validByConstruction) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String makeLen3(String s, FuzzedDataProvider data) {
        if (s == null) {
            s = "";
        }
        if (s.length() == 3) {
            return s;
        }
        StringBuilder sb = new StringBuilder(3);
        for (int i = 0; i < s.length() && sb.length() < 3; i++) {
            sb.append(s.charAt(i));
        }
        while (sb.length() < 3) {
            sb.append(randomAsciiLetter(data));
        }
        if (sb.length() > 3) {
            return sb.substring(0, 3);
        }
        return sb.toString();
    }

    private static char randomAsciiLetter(FuzzedDataProvider data) {
        int v = data.consumeInt(0, 51);
        return (char) (v < 26 ? ('a' + v) : ('A' + (v - 26)));
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
