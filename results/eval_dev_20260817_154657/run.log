    /*
     * Contract asserted here comes directly from PolygonsSet.computeGeometricalProperties():
     * when getVertices().length == 0 and the tree is a leaf (cut == null), a full-space region
     * (attribute == Boolean.TRUE) must report infinite size and NaN barycenter, while an empty
     * region (attribute == Boolean.FALSE) must report size 0 and barycenter (0, 0).
     * A throw-deleting / branch-skipping patch would violate this observable post-condition.
     */
    private static void runLeafOracle(boolean full) {
        PolygonsSet set;
        try {
            set = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(full)));
        } catch (Throwable t) {
            return;
        }

        final double size1;
        final Vector2D bary1;
        try {
            size1 = set.getSize();
            bary1 = (Vector2D) set.getBarycenter();
        } catch (Throwable t) {
            return;
        }

        if (full) {
            if (!Double.isInfinite(size1) || size1 <= 0.0) {
                throw new RuntimeException("[oracle:leaf-full] metamorphic violation: full leaf must have infinite size got=" + size1);
            }
            if (!(Double.isNaN(bary1.getX()) && Double.isNaN(bary1.getY()))) {
                throw new RuntimeException("[oracle:leaf-full] metamorphic violation: full leaf must have NaN barycenter got=(" + bary1.getX() + "," + bary1.getY() + ")");
            }
        } else {
            if (Double.doubleToLongBits(size1) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("[oracle:leaf-empty] metamorphic violation: empty leaf must have size 0 got=" + size1);
            }
            if (Double.doubleToLongBits(bary1.getX()) != Double.doubleToLongBits(0.0d)
                    || Double.doubleToLongBits(bary1.getY()) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("[oracle:leaf-empty] metamorphic violation: empty leaf must have barycenter (0,0) got=(" + bary1.getX() + "," + bary1.getY() + ")");
            }
        }

        try {
            PolygonsSet twin = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(full)));
            double size2 = twin.getSize();
            Vector2D bary2 = (Vector2D) twin.getBarycenter();
            if (!sameDouble(size1, size2) || !sameDouble(bary1.getX(), bary2.getX()) || !sameDouble(bary1.getY(), bary2.getY())) {
                throw new RuntimeException("[oracle:leaf-repeat] metamorphic violation: identically constructed regions disagree lhs=("
                        + size1 + "," + bary1.getX() + "," + bary1.getY() + ") rhs=("
                        + size2 + "," + bary2.getX() + "," + bary2.getY() + ")");
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static void runAnchorCase() {
        float[] coords = new float[] {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int[] indices = baseIndices();

        PolyhedronsSet a = buildPolyhedron(coords, indices);
        a.getSize();
        a.getBarycenter();

        float[] translated = translate(coords, 7.5f, -2.0f, 3.25f);
        PolyhedronsSet b = buildPolyhedron(translated, indices);
        double sizeA = a.getSize();
        double sizeB = b.getSize();
        Vector3D barA = (Vector3D) a.getBarycenter();
        Vector3D barB = (Vector3D) b.getBarycenter();

        checkTranslationInvariant(sizeA, barA, sizeB, barB, 7.5, -2.0, 3.25, "anchor");
    }

    private static void runExploreCase(FuzzedDataProvider data) {
        int[] indices = baseIndices();

        float[] coords = new float[] {
            1.0f, -1.0f, -1.0f,
            1.0f, -1.0f,  1.0f,
           -1.0f, -1.0f,  1.0f,
           -1.0f, -1.0f, -1.0f,
            1.0f,  1.0f, -1.0f,
            1.0f,  1.0f,  1.0f,
           -1.0f,  1.0f,  1.0f,
           -1.0f,  1.0f, -1.0f
        };

        int choice = data.consumeInt(0, 5);
        float eps = data.consumeInt(-1000, 1000) / 1000000.0f;
        if (choice == 0) {
            coords[15] = 1.0f + eps;
        } else if (choice == 1) {
            coords[15] = 1.0f - Math.abs(eps);
        } else if (choice == 2) {
            coords[15] = 0.999999f;
        } else if (choice == 3) {
            coords[15] = 1.000001f;
        } else if (choice == 4) {
            coords[15] = 1.0f;
        } else {
            coords[15] = 1.0f + eps;
            coords[16] = 1.0f + (data.consumeInt(-1000, 1000) / 1000000.0f);
            coords[17] = 1.0f + (data.consumeInt(-1000, 1000) / 1000000.0f);
        }

        int vertex = data.consumeInt(0, 7);
        int axis = data.consumeInt(0, 2);
        float delta = data.consumeInt(-1000, 1000) / 1000000.0f;
        coords[vertex * 3 + axis] += delta;

        float dx = data.consumeInt(-50, 50) / 10.0f;
        float dy = data.consumeInt(-50, 50) / 10.0f;
        float dz = data.consumeInt(-50, 50) / 10.0f;

        PolyhedronsSet original = buildPolyhedron(coords, indices);
        double sizeOriginal = original.getSize();
        Vector3D baryOriginal = (Vector3D) original.getBarycenter();

        float[] translated = translate(coords, dx, dy, dz);
        PolyhedronsSet shifted = buildPolyhedron(translated, indices);
        double sizeShifted = shifted.getSize();
        Vector3D baryShifted = (Vector3D) shifted.getBarycenter();

        checkTranslationInvariant(sizeOriginal, baryOriginal, sizeShifted, baryShifted, dx, dy, dz, "explore");
    }

    private static PolyhedronsSet buildPolyhedron(float[] coords, int[] indices) {
        Collection<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int i = 0; i < indices.length; i += 3) {
            Vector3D v1 = vector(coords, indices[i]);
            Vector3D v2 = vector(coords, indices[i + 1]);
            Vector3D v3 = vector(coords, indices[i + 2]);

            Plane plane = new Plane(v1, v2, v3);

            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            Collection<SubHyperplane<Euclidean2D>> edges = new ArrayList<SubHyperplane<Euclidean2D>>();
            edges.add(new SubLine(p1, p2));
            edges.add(new SubLine(p2, p3));
            edges.add(new SubLine(p3, p1));

            PolygonsSet region = new PolygonsSet(edges);
            facets.add(new SubPlane(plane, region));
        }
        return new PolyhedronsSet(facets);
    }

    private static Vector3D vector(float[] coords, int vertexIndex) {
        int o = vertexIndex * 3;
        return new Vector3D(coords[o], coords[o + 1], coords[o + 2]);
    }

    private static float[] translate(float[] coords, float dx, float dy, float dz) {
        float[] out = coords.clone();
        for (int i = 0; i < out.length; i += 3) {
            out[i] += dx;
            out[i + 1] += dy;
            out[i + 2] += dz;
        }
        return out;
    }

    /*
     * Sound metamorphic relation for any correct geometry library:
     * translating a polyhedron preserves volume and translates barycenter by the same vector.
     * Both sides are computed by real library calls on two related real inputs.
     */
    private static void checkTranslationInvariant(double sizeA, Vector3D baryA,
                                                  double sizeB, Vector3D baryB,
                                                  double dx, double dy, double dz,
                                                  String label) {
        if (Double.isNaN(sizeA) || Double.isNaN(sizeB)) {
            return;
        }
        if (baryA == null || baryB == null) {
            return;
        }

        double sizeTol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(sizeA), Math.abs(sizeB)));
        if (Math.abs(sizeA - sizeB) > sizeTol) {
            throw new RuntimeException("[oracle:translate-size] metamorphic violation: translation changed size label="
                    + label + " lhs=" + sizeA + " rhs=" + sizeB + " shift=(" + dx + "," + dy + "," + dz + ")");
        }

        double bxTol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(baryA.getX() + dx), Math.abs(baryB.getX())));
        double byTol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(baryA.getY() + dy), Math.abs(baryB.getY())));
        double bzTol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(baryA.getZ() + dz), Math.abs(baryB.getZ())));
        if (Math.abs((baryA.getX() + dx) - baryB.getX()) > bxTol
                || Math.abs((baryA.getY() + dy) - baryB.getY()) > byTol
                || Math.abs((baryA.getZ() + dz) - baryB.getZ()) > bzTol) {
            throw new RuntimeException("[oracle:translate-bary] metamorphic violation: translation changed barycenter label="
                    + label + " lhs=(" + baryA.getX() + "," + baryA.getY() + "," + baryA.getZ() + ") rhs=("
                    + baryB.getX() + "," + baryB.getY() + "," + baryB.getZ() + ") shift=(" + dx + "," + dy + "," + dz + ")");
        }
    }

    private static int[] baseIndices() {
        return new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (t == null) {
            return;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (validByConstruction && isRootCause(t)) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            throw new RuntimeException(t);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method)
                    || "getVertices".equals(method)
                    || "getTree".equals(method)
                    || "getSize".equals(method)
                    || "setSize".equals(method)
                    || "setBarycenter".equals(method)
                    || "getBarycenter".equals(method)
                    || "<init>".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math3.exception.");
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return true;
        }
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }
}
