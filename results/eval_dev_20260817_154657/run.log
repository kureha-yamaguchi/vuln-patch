package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseToBoolean("off", true);

        String fuzz = data.consumeAsciiString(32);

        String candidate1 = makeThreeCharNonY(fuzz, data.consumeByte(), data.consumeByte(), data.consumeByte());
        exerciseToBoolean(candidate1, true);

        String candidate2 = makeThreeCharNonY(data.consumeAsciiString(8), data.consumeByte(), data.consumeByte(), data.consumeByte());
        exerciseToBoolean(candidate2, true);

        String longContext = data.consumeAsciiString(24);
        String candidate3 = deriveWindow(longContext, data);
        exerciseToBoolean(candidate3, true);

        String candidate4 = makeThreeCharNonY(data.consumeRemainingAsString(), data.consumeByte(), data.consumeByte(), data.consumeByte());
        exerciseToBoolean(candidate4, true);

        exerciseToBoolean(data.consumeAsciiString(6), true);

        /* Contract/oracle:
         * BooleanUtils.toBoolean is explicitly case-insensitive for the accepted literals
         * "on", "yes", and "true" (visible in the implementation and tests). Therefore any
         * mixed-case variant of one of these tokens must produce the same boolean result as
         * the canonical lowercase form. A patch that merely suppresses the crash by skipping
         * the branch or returning a wrong default would violate this observable relation.
         * If either call throws, we skip the oracle for hygiene.
         */
        String token;
        switch (data.consumeInt(0, 2)) {
            case 0:
                token = "on";
                break;
            case 1:
                token = "yes";
                break;
            default:
                token = "true";
                break;
        }
        String mixed = randomCase(token, data);
        checkCaseInsensitiveOracle(token, mixed);
    }

    private static void exerciseToBoolean(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String makeThreeCharNonY(String seed, byte b1, byte b2, byte b3) {
        char c0 = printableChar(seed, 0, b1);
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = printableChar(seed, 1, b2);
        char c2 = printableChar(seed, 2, b3);
        return new String(new char[] { c0, c1, c2 });
    }

    private static String deriveWindow(String source, FuzzedDataProvider data) {
        if (source == null) {
            source = "";
        }
        String padded = source + data.consumeAsciiString(4) + "XYZ";
        int start = 0;
        if (padded.length() > 3) {
            start = data.consumeInt(0, padded.length() - 3);
        }
        String window = padded.substring(start, start + 3);
        char c0 = window.charAt(0);
        if (c0 == 'y' || c0 == 'Y') {
            window = "o" + window.substring(1);
        }
        return window;
    }

    private static char printableChar(String seed, int idx, byte fallback) {
        if (seed != null && seed.length() > idx) {
            char c = seed.charAt(idx);
            if (c >= 32 && c <= 126) {
                return c;
            }
        }
        int v = fallback & 0x7F;
        return (char) (32 + (v % 95));
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static void checkCaseInsensitiveOracle(String canonical, String variant) {
        try {
            boolean lhs = BooleanUtils.toBoolean(canonical);
            boolean rhs = BooleanUtils.toBoolean(variant);
            if (lhs != rhs) {
                throw new RuntimeException(
                        "[oracle:case-insensitive] metamorphic violation: equivalent accepted literal casing changed result input="
                                + variant + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (t.getMessage() != null && t.getMessage().startsWith("[oracle:case-insensitive]")) {
                throw t;
            }
        }
    }
}
