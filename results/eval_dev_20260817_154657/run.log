package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Object anchorAttr = makeBoundaryAttribute();
        runCase(anchorAttr, true, false, "anchor-true");
        runCase(anchorAttr, false, true, "anchor-false");

        int cases = 1 + data.consumeInt(0, 7);
        for (int i = 0; i < cases; i++) {
            boolean expectedWhole = data.consumeBoolean();
            boolean minusValue = data.consumeBoolean();
            Object rootAttr;
            switch (data.consumeInt(0, 4)) {
                case 0:
                    rootAttr = makeBoundaryAttribute();
                    break;
                case 1:
                    rootAttr = data.consumeAsciiString(16);
                    break;
                case 2:
                    rootAttr = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    rootAttr = new ArrayList<Object>();
                    break;
                default:
                    rootAttr = new Object();
                    break;
            }
            runCase(rootAttr, expectedWhole, minusValue, "fuzz-" + i);
        }
    }

    private static void runCase(Object rootAttribute, boolean expectedWhole, boolean minusValue, String tag) {
        PolygonsSet testSet = buildSet(rootAttribute, expectedWhole, minusValue);
        PolygonsSet controlSet = buildSet(Boolean.valueOf(expectedWhole), expectedWhole, minusValue);
        exerciseAndCheck(testSet, controlSet, expectedWhole, tag);
    }

    private static PolygonsSet buildSet(Object rootAttribute, boolean plusValue, boolean minusValue) {
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusValue));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusValue));
        BSPTree<Euclidean2D> root = new BSPTree<Euclidean2D>(null, plus, minus, rootAttribute);
        return new PolygonsSet(root);
    }

    private static void exerciseAndCheck(PolygonsSet testSet, PolygonsSet controlSet, boolean expectedWhole, String tag) {
        try {
            Vector2D[][] before = testSet.getVertices();
            Vector2D[][] controlVertices = controlSet.getVertices();

            double testSize = testSet.getSize();
            Vector2D testBary = (Vector2D) testSet.getBarycenter();

            double controlSize = controlSet.getSize();
            Vector2D controlBary = (Vector2D) controlSet.getBarycenter();

            Vector2D[][] after = testSet.getVertices();

            if (before.length != 0 || after.length != 0 || controlVertices.length != 0) {
                return;
            }

            /* Contract asserted:
             * In computeGeometricalProperties(), when getVertices() is empty, the region is classified as
             * whole-space or empty-space and size/barycenter are set accordingly.
             * A patch that only suppresses the ClassCastException but fails to preserve that bookkeeping
             * will disagree with an equivalent control object whose root attribute is already the expected Boolean.
             */
            if (!sameSize(testSize, controlSize) || !samePoint(testBary, controlBary)) {
                throw new RuntimeException(
                    "[oracle:empty-tree-equiv] metamorphic violation: equivalent empty-vertex trees disagree"
                    + " tag=" + tag
                    + " expectedWhole=" + expectedWhole
                    + " testSize=" + testSize
                    + " controlSize=" + controlSize
                    + " testBary=(" + testBary.getX() + "," + testBary.getY() + ")"
                    + " controlBary=(" + controlBary.getX() + "," + controlBary.getY() + ")"
                );
            }

            if (expectedWhole) {
                if (!Double.isInfinite(testSize) || !Double.isNaN(testBary.getX()) || !Double.isNaN(testBary.getY())) {
                    throw new RuntimeException(
                        "[oracle:whole-space-post] metamorphic violation: whole-space bookkeeping not set"
                        + " tag=" + tag
                        + " size=" + testSize
                        + " bary=(" + testBary.getX() + "," + testBary.getY() + ")"
                    );
                }
            } else {
                if (Double.doubleToLongBits(testSize) != Double.doubleToLongBits(0.0d)
                        || Double.doubleToLongBits(testBary.getX()) != Double.doubleToLongBits(0.0d)
                        || Double.doubleToLongBits(testBary.getY()) != Double.doubleToLongBits(0.0d)) {
                    throw new RuntimeException(
                        "[oracle:empty-space-post] metamorphic violation: empty-space bookkeeping not set"
                        + " tag=" + tag
                        + " size=" + testSize
                        + " bary=(" + testBary.getX() + "," + testBary.getY() + ")"
                    );
                }
            }
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (isPatchedRegionClassCast(e)) {
                return;
            }
            return;
        } catch (Throwable t) {
            return;
        }
    }

    private static boolean isOracleFailure(RuntimeException e) {
        String m = e.getMessage();
        return m != null && m.startsWith("[oracle:");
    }

    private static boolean isPatchedRegionClassCast(RuntimeException e) {
        if (!(e instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : e.getStackTrace()) {
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(ste.getClassName())) {
                String method = ste.getMethodName();
                if ("computeGeometricalProperties".equals(method) || "getVertices".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean sameSize(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return Double.isInfinite(a) && Double.isInfinite(b) && ((a > 0) == (b > 0));
        }
        double scale = Math.max(1.0d, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-12d * scale;
    }

    private static boolean samePoint(Vector2D a, Vector2D b) {
        return sameCoord(a.getX(), b.getX()) && sameCoord(a.getY(), b.getY());
    }

    private static boolean sameCoord(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return Double.isNaN(a) && Double.isNaN(b);
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return Double.isInfinite(a) && Double.isInfinite(b) && ((a > 0) == (b > 0));
        }
        double scale = Math.max(1.0d, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-12d * scale;
    }

    private static Object makeBoundaryAttribute() {
        try {
            return new BoundaryAttribute<Euclidean2D>(null, null);
        } catch (Throwable ignored) {
            return new Object();
        }
    }
}
