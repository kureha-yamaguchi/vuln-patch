                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);

                checkSeriesViewConsistency(byPeriod, "byPeriod");
                checkSeriesViewConsistency(byIndex, "byIndex");

                if (byPeriod.getItemCount() != byIndex.getItemCount()
                        || byPeriod.getItems().size() != byIndex.getItems().size()) {
                    throw new RuntimeException("[oracle:overload-count] metamorphic violation: createCopy overloads disagree on singleton copy size"
                            + " chosen=" + chosen
                            + " byPeriodCount=" + byPeriod.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount());
                }

                if (byPeriod.getItemCount() == 1 && byIndex.getItemCount() == 1) {
                    if (!byPeriod.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
                        throw new RuntimeException("[oracle:overload-period] metamorphic violation: createCopy overloads copied different periods"
                                + " chosen=" + chosen
                                + " byPeriod=" + byPeriod.getTimePeriod(0)
                                + " byIndex=" + byIndex.getTimePeriod(0));
                    }
                    Number vp = byPeriod.getValue(0);
                    Number vi = byIndex.getValue(0);
                    if (vp == null ? vi != null : !vp.equals(vi)) {
                        throw new RuntimeException("[oracle:overload-value] metamorphic violation: createCopy overloads copied different values"
                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        checkSeriesViewConsistency(s, "anchor-source");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int startIndex = s.getIndex(start);
        int endIndex = s.getIndex(end);
        if (startIndex >= 0 || endIndex >= 0) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor range must fall strictly inside the gap"
                    + " startIndex=" + startIndex
                    + " endIndex=" + endIndex);
        }

        int manualCount = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
        }
        if (manualCount != 0) {
            throw new RuntimeException("[oracle:anchor-manual] metamorphic violation: anchor range must contain no items"
                    + " manualCount=" + manualCount);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0 || copy.getItems().size() != 0) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor empty-gap copy must be empty"
                    + " count=" + copy.getItemCount()
                    + " items=" + copy.getItems().size());
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        Calendar cal = new GregorianCalendar(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(1970, Calendar.JANUARY, 1);
        cal.add(Calendar.DAY_OF_MONTH, epochDay);
        return new Day(cal.getTime());
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String tag) {
        int count = series.getItemCount();
        List items = series.getItems();
        if (count != items.size()) {
            throw new RuntimeException("[oracle:view-count-" + tag + "] metamorphic violation: getItemCount disagrees with getItems().size()"
                    + " count=" + count
                    + " itemsSize=" + items.size());
        }
        for (int i = 0; i < count; i++) {
            Object listed = items.get(i);
            Object direct = series.getDataItem(i);
            if (listed == null || direct == null || !listed.equals(direct)) {
                throw new RuntimeException("[oracle:view-item-" + tag + "] metamorphic violation: getItems() and getDataItem(i) disagree"
                        + " index=" + i
                        + " listed=" + listed
                        + " direct=" + direct);
            }
            RegularTimePeriod p = series.getTimePeriod(i);
            if (series.getIndex(p) != i) {
                throw new RuntimeException("[oracle:view-index-" + tag + "] metamorphic violation: getIndex(getTimePeriod(i)) must round-trip"
                        + " index=" + i
                        + " roundTrip=" + series.getIndex(p)
                        + " period=" + p);
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
