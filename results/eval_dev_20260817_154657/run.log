    private static Day dayFromEpochDay(int epochDay) {
        java.time.LocalDate d = java.time.LocalDate.ofEpochDay(epochDay);
        return new Day(d.getDayOfMonth(), d.getMonthValue(), d.getYear());
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
