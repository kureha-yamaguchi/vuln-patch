package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /* Contract asserted below:
         * StringEscapeUtils.escapeCsv only needs to quote/escape CSV-special content
         * (comma, double quote, CR, LF). Therefore, for a valid input that contains
         * none of those characters, the escaped result must equal the original input.
         *
         * This directly detects throw-deleting / bookkeeping-breaking patches that stop
         * crashing but silently corrupt or skip output.
         */

        // ANCHOR: exact failing-test inputs first.
        runEscapeCsv("\uD83D\uDE30", true, true);
        runEscapeCsv("\uD800\uDC00", true, true);
        runEscapeCsv("\uD834\uDD1E", true, true);
        runEscapeCsv("\uDBFF\uDFFD", true, true);

        // EXPLORE: valid-by-construction strings containing at least one supplementary
        // code point (a surrogate pair), while excluding CSV-special characters so the
        // expected result is identity.
        String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
        String middle = sanitizeCsvSafe(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

        int cp1 = data.consumeInt(0x10000, 0x10FFFF);
        if (!Character.isValidCodePoint(cp1)) {
            return;
        }

        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        sb.append(Character.toChars(cp1));
        sb.append(middle);

        if (data.consumeBoolean()) {
            int cp2 = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp2)) {
                return;
            }
            sb.append(Character.toChars(cp2));
        }

        sb.append(suffix);

        String candidate = sb.toString();
        if (candidate.length() == 0) {
            return;
        }

        runEscapeCsv(candidate, true, true);

        // Additional real-call exploration: a larger, still-valid safe string with
        // the surrogate pair at varied positions.
        String extra = sanitizeCsvSafe(data.consumeRemainingAsString());
        String candidate2;
        if (data.consumeBoolean()) {
            candidate2 = extra + new String(Character.toChars(cp1));
        } else {
            candidate2 = new String(Character.toChars(cp1)) + extra;
        }
        if (candidate2.length() != 0) {
            runEscapeCsv(candidate2, true, true);
        }
    }

    private static void runEscapeCsv(String input, boolean validByConstruction, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);
            if (assertIdentity && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe valid input input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid") || name.contains("validation");
    }

    private static String sanitizeCsvSafe(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\n' || c == '\r') {
                out.append('A');
            } else {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    b.append("\\\\");
                    break;
                case '"':
                    b.append("\\\"");
                    break;
                case '\n':
                    b.append("\\n");
                    break;
                case '\r':
                    b.append("\\r");
                    break;
                case '\t':
                    b.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        b.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            b.append('0');
                        }
                        b.append(hex);
                    } else {
                        b.append(c);
                    }
            }
        }
        b.append('"');
        return b.toString();
    }
}
