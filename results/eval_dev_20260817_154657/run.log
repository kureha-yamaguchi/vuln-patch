    private static Day addDays(Day base, int delta) {
        RegularTimePeriod p = base;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                p = p.next();
                if (p == null) {
                    throw new IllegalArgumentException("Day overflow while advancing");
