    private static String[] stripNullReplacementRules(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < repl.length; i++) {
            if (repl[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < repl.length; i++) {
            if (repl[i] != null) {
                out[j++] = search[i];
            }
        }
        return out;
    }

    private static String[] stripNullReplacementValues(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < repl.length; i++) {
