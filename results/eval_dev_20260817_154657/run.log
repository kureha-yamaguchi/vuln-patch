package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class Util {
            boolean isRootCause(Throwable t) {
                if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
                    return false;
                }
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                            && "translate".equals(ste.getMethodName())) {
                        return true;
                    }
                }
                return false;
            }

            String repr(String s) {
                if (s == null) {
                    return "null";
                }
                StringBuilder sb = new StringBuilder();
                sb.append('"');
                for (int i = 0; i < s.length(); i++) {
                    char c = s.charAt(i);
                    switch (c) {
                        case '\\':
                            sb.append("\\\\");
                            break;
                        case '"':
                            sb.append("\\\"");
                            break;
                        case '\r':
                            sb.append("\\r");
                            break;
                        case '\n':
                            sb.append("\\n");
                            break;
                        case '\t':
                            sb.append("\\t");
                            break;
                        default:
                            if (c < 0x20 || c > 0x7e) {
                                sb.append(String.format("\\u%04X", (int) c));
                            } else {
                                sb.append(c);
                            }
                    }
                }
                sb.append('"');
                return sb.toString();
            }

            void exercise(String s, boolean validByConstruction) {
                final String escaped;
                try {
                    escaped = StringEscapeUtils.escapeCsv(s);
                } catch (Throwable t) {
                    if (t instanceof RuntimeException) {
                        String msg = t.getMessage();
                        if (msg != null && msg.startsWith("[oracle:")) {
                            throw (RuntimeException) t;
                        }
                    }
                    if (validByConstruction && isRootCause(t)) {
                        if (t instanceof RuntimeException) {
                            throw (RuntimeException) t;
                        }
                        if (t instanceof Error) {
                            throw (Error) t;
                        }
                    }
                    return;
                }

                /*
                 * Contract asserted: CSV unescaping is the inverse of CSV escaping on accepted input.
                 * Using only real library calls, unescapeCsv(escapeCsv(x)) must recover x for any correctly
                 * handled string. A "fix" that merely skips/short-circuits the consumed-codepoint bookkeeping
                 * could avoid the crash while silently producing wrong output, which this round-trip catches.
                 */
                try {
                    String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
                    if (!s.equals(roundTrip)) {
                        throw new RuntimeException(
                                "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) != x input="
                                        + repr(s) + " lhs=" + repr(roundTrip) + " rhs=" + repr(s));
                    }
                } catch (Throwable t) {
                    if (t instanceof RuntimeException) {
                        String msg = t.getMessage();
                        if (msg != null && msg.startsWith("[oracle:")) {
                            throw (RuntimeException) t;
                        }
                    }
                    return;
                }
            }
        }

        Util util = new Util();

        String[] anchors = new String[] {
                "\uD83D\uDE30",
                "\uD800\uDC00",
                "\uD834\uDD1E",
                "\uDBFF\uDFFD"
        };
        for (String anchor : anchors) {
            util.exercise(anchor, true);
        }

        String rawPrefix = data.consumeAsciiString(24);
        String rawSuffix = data.consumeAsciiString(24);

        StringBuilder prefix = new StringBuilder();
        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                prefix.append(c);
            }
        }

        StringBuilder suffix = new StringBuilder();
        for (int i = 0; i < rawSuffix.length(); i++) {
            char c = rawSuffix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                suffix.append(c);
            }
        }

        StringBuilder candidate = new StringBuilder();
        if (data.consumeBoolean()) {
            candidate.append(prefix);
        }

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            int codePoint = data.consumeInt(0x10000, 0x10FFFF);
            candidate.append(Character.toChars(codePoint));
            if (data.consumeBoolean()) {
                candidate.append('A');
            }
            if (data.consumeBoolean()) {
                candidate.append('z');
            }
        }

        if (data.consumeBoolean()) {
            candidate.append(suffix);
        }

        if (candidate.length() == 0) {
            candidate.append("\uD83D\uDE30");
        }

        util.exercise(candidate.toString(), true);
    }
}
