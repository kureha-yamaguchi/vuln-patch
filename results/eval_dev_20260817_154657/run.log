    private static Day addDays(Day day, int delta) {
        RegularTimePeriod current = day;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                current = current.next();
                if (current == null) {
                    throw new IllegalArgumentException("Day overflow while advancing");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                current = current.previous();
                if (current == null) {
                    throw new IllegalArgumentException("Day overflow while rewinding");
                }
            }
        }
        return (Day) current;
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method)
                    || "getIndex".equals(method)
                    || "clone".equals(method))) {
                return true;
            }
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }
