package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorChecks();
        exploreChecks(data);
    }

    private static void anchorChecks() {
        // Contract exercised by the upstream test: pairs with null search or null replacement
        // are ignored, so ["a","b"] -> ["c",null] on "aba" must behave like only ["a"] -> ["c"].
        String text = "aba";
        String[] search = new String[] { "a", "b" };
        String[] repl = new String[] { "c", null };

        String expected;
        try {
            expected = StringUtils.replaceEach(text, new String[] { "a" }, new String[] { "c" });
        } catch (RuntimeException e) {
            return;
        }

        try {
            String actual = StringUtils.replaceEach(text, search, repl);
            if (!safeEquals(actual, expected)) {
                throw new RuntimeException(
                        "[oracle:null-pair-anchor] metamorphic violation: ignoring null replacement pair changed result input="
                                + text + " lhs=" + actual + " rhs=" + expected);
            }
        } catch (RuntimeException e) {
            if (isRootCauseNpe(e)) {
                throw new RuntimeException(
                        "[oracle:null-pair-anchor] metamorphic violation: valid replaceEach input threw instead of ignoring null replacement pair input="
                                + text + " expected=" + expected, e);
            }
            if (isCleanRejection(e)) {
                return;
            }
        }
    }

    private static void exploreChecks(FuzzedDataProvider data) {
        String text = data.consumeString(32);
        int len = data.consumeInt(1, 6);

        String[] search = new String[len];
        String[] repl = new String[len];

        boolean insertedIgnoredPair = false;
        boolean keptUsablePair = false;

        for (int i = 0; i < len; i++) {
            int mode = data.consumeInt(0, 4);
            switch (mode) {
                case 0:
                    search[i] = null;
                    repl[i] = data.consumeBoolean() ? data.consumeString(8) : "";
                    insertedIgnoredPair = true;
                    break;
                case 1:
                    search[i] = "";
                    repl[i] = data.consumeBoolean() ? data.consumeString(8) : "";
                    insertedIgnoredPair = true;
                    break;
                case 2:
                    search[i] = chooseSearchToken(data, text);
                    repl[i] = null;
                    insertedIgnoredPair = true;
                    break;
                default:
                    search[i] = chooseSearchToken(data, text);
                    repl[i] = data.consumeString(8);
                    if (search[i] != null && search[i].length() > 0 && repl[i] != null) {
                        keptUsablePair = true;
                    }
                    break;
            }
        }

        if (!insertedIgnoredPair) {
            search[0] = chooseSearchToken(data, text);
            repl[0] = null;
            insertedIgnoredPair = true;
        }
        if (!keptUsablePair) {
            int idx = len == 1 ? 0 : len - 1;
            String token = choosePresentToken(data, text);
            search[idx] = token;
            repl[idx] = data.consumeAsciiString(8);
            if (repl[idx] == null) {
                repl[idx] = "";
            }
        }

        checkNullPairIgnored(text, search, repl);
    }

    private static void checkNullPairIgnored(String text, String[] search, String[] repl) {
        String[] filteredSearch = filterSearch(search, repl);
        String[] filteredRepl = filterReplacement(search, repl);

        String filteredResult;
        try {
            filteredResult = StringUtils.replaceEach(text, filteredSearch, filteredRepl);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            return;
        }

        try {
            String originalResult = StringUtils.replaceEach(text, search, repl);
            if (!safeEquals(originalResult, filteredResult)) {
                throw new RuntimeException(
                        "[oracle:null-pair-filter] metamorphic violation: removing ignored pairs changed result input="
                                + text + " lhs=" + originalResult + " rhs=" + filteredResult);
            }
        } catch (RuntimeException e) {
            if (isRootCauseNpe(e)) {
                throw new RuntimeException(
                        "[oracle:null-pair-filter] metamorphic violation: valid replaceEach input threw while filtered equivalent succeeded input="
                                + text + " rhs=" + filteredResult, e);
            }
            if (isCleanRejection(e)) {
                return;
            }
        }
    }

    private static String chooseSearchToken(FuzzedDataProvider data, String text) {
        int choice = data.consumeInt(0, 3);
        if (choice == 0) {
            return choosePresentToken(data, text);
        }
        if (choice == 1) {
            String s = data.consumeString(4);
            return s.length() == 0 ? "x" : s;
        }
        if (choice == 2) {
            return data.consumeAsciiString(3);
        }
        return choosePresentToken(data, text);
    }

    private static String choosePresentToken(FuzzedDataProvider data, String text) {
        if (text != null && text.length() > 0) {
            int start = data.consumeInt(0, text.length() - 1);
            int end = data.consumeInt(start + 1, text.length());
            String sub = text.substring(start, end);
            if (sub.length() > 0) {
                return sub;
            }
        }
        String fallback = data.consumeAsciiString(3);
        return fallback.length() == 0 ? "a" : fallback;
    }

    private static String[] filterSearch(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() > 0 && repl[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() > 0 && repl[i] != null) {
                out[j++] = search[i];
            }
        }
        return out;
    }

    private static String[] filterReplacement(String[] search, String[] repl) {
        int count = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() > 0 && repl[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < search.length; i++) {
            if (search[i] != null && search[i].length() > 0 && repl[i] != null) {
                out[j++] = repl[i];
            }
        }
        return out;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "length".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
