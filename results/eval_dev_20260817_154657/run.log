public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkUnsuffixedFiniteDecimalSelectsFloat("1234.5");

        String wholeDigits = toDigits(data.consumeAsciiString(12), false);
        String fracDigits = toDigits(data.consumeAsciiString(6), false);
        String expDigits = toDigits(data.consumeAsciiString(4), false);

