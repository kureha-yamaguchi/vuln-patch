        if (Boolean.TRUE.equals(anchor)) {
            throw new RuntimeException("[oracle:off-false] metamorphic violation: documented false token returned true input=off lhs=true rhs=false");
        }

        // EXPLORE: the root-cause property is any 3-character string whose first character is
        // not 'y' or 'Y'. In the buggy version, case 3 falls through into case 4 and reads
        // charAt(3), causing StringIndexOutOfBoundsException instead of cleanly returning false.
        for (int i = 0; i < 4; i++) {
            String probe = makeThreeCharNonYes(data);
            callToBoolean(probe, true);
        }

        // Additional nearby literals observed in the original test/failure area.
        callToBoolean("oof", true);
        callToBoolean("yep", true);
        callToBoolean("tru", true);

        // Mandatory oracle: case-insensitive parsing of the documented true tokens.
        // This guarantee is visible directly in the shown implementation and failing test:
        // mixed-case variants of "true" return true; the code likewise accepts "on" and "yes"
        // case-insensitively. A patch that merely suppresses the crash by making the 3-char
        // branch unreachable, or that returns false for all 3-char strings, would violate this.
        String base = pickTrueToken(data);
        String mixed = randomizeCase(base, data);
        String upper = base.toUpperCase();

        Boolean lhs = callToBoolean(mixed, true);
        Boolean rhs = callToBoolean(upper, true);
        if (lhs != null && rhs != null) {
            if (!lhs.booleanValue() || !rhs.booleanValue() || lhs.booleanValue() != rhs.booleanValue()) {
                throw new RuntimeException("[oracle:case-true] metamorphic violation: case-insensitive true token parsing input=" + mixed + " lhs=" + lhs + " rhs=" + rhs);
            }
        }
    }

    private static Boolean callToBoolean(String s, boolean validByConstruction) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
