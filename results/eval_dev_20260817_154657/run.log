package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testEscapeCsv("\uD83D\uDE30", true);
        testEscapeCsv("\uD800\uDC00", true);
        testEscapeCsv("\uD834\uDD1E", true);
        testEscapeCsv("\uDBFF\uDFFD", true);

        int iterations = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < iterations; i++) {
            String prefix = sanitizeCsvSafe(data.consumeAsciiString(16));
            String suffix = sanitizeCsvSafe(data.consumeAsciiString(16));

            int pairCount = 1 + data.consumeInt(0, 3);
            StringBuilder middle = new StringBuilder();
            for (int j = 0; j < pairCount; j++) {
                if (data.consumeBoolean()) {
                    middle.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
                }
                middle.append(validSupplementaryCodePoint(data.consumeInt()));
                if (data.consumeBoolean()) {
                    middle.append(sanitizeCsvSafe(data.consumeAsciiString(8)));
                }
            }

            String input = prefix + middle.toString() + suffix;
            testEscapeCsv(input, true);
        }
    }

    private static void testEscapeCsv(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted from StringEscapeUtils.escapeCsv:
             * if the value does not contain a comma, newline or double quote,
             * then the String value is returned unchanged.
             * We build inputs from CSV-safe ASCII plus valid UTF-16 surrogate pairs,
             * so a correct implementation must accept them and return them verbatim.
             * A "fix" that merely skips the crashing bookkeeping or drops characters
             * would violate this observable post-condition without throwing.
             */
            if (isCsvSafe(input) && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return unchanged safe input input=" + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String sanitizeCsvSafe(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (Character.isHighSurrogate(c) || Character.isLowSurrogate(c)) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            sb.append('Z');
        }
        return sb.toString();
    }

    private static String validSupplementaryCodePoint(int anyInt) {
        int range = 0x10FFFF - 0x10000 + 1;
        int cp = 0x10000 + Math.floorMod(anyInt, range);
        return new String(Character.toChars(cp));
    }

    private static boolean isCsvSafe(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int k = hex.length(); k < 4; k++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
