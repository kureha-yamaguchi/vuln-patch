    private static void exercise(String s, boolean checkOracle) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);

            /*
             * Contract asserted:
             * StringEscapeUtils.escapeCsv returns the input unchanged when the input contains
             * none of the CSV special characters (comma, double quote, CR, LF). We construct
             * such inputs by construction, and they are valid UTF-16 strings. A throw-deleting
             * or bookkeeping-skipping patch that silently drops or alters characters would
             * violate this observable identity post-condition.
             */
            if (checkOracle && !s.equals(out)) {
                throw new RuntimeException(
                    "[oracle:escapeCsvIdentity] metamorphic violation: escapeCsv must be identity for CSV-safe input input="
                        + repr(s) + " lhs=" + repr(out) + " rhs=" + repr(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(s)) {
                throw t;
            }
        }
