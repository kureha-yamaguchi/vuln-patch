    private static void checkSeriesViewConsistency(TimeSeries series, String where) {
        int count = series.getItemCount();
        java.util.List items = series.getItems();
        java.util.Collection periods = series.getTimePeriods();

        if (count != items.size()) {
            throw new RuntimeException("[oracle:view-count-items] metamorphic violation: getItemCount and getItems().size() must agree"
                    + " where=" + where
                    + " count=" + count
                    + " itemsSize=" + items.size());
        }
        if (count != periods.size()) {
            throw new RuntimeException("[oracle:view-count-periods] metamorphic violation: getItemCount and getTimePeriods().size() must agree"
                    + " where=" + where
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod period = series.getTimePeriod(i);
            Number value = series.getValue(i);

            if (item == null) {
                throw new RuntimeException("[oracle:view-null-item] metamorphic violation: getDataItem must return a backing item for each valid index"
                        + " where=" + where
                        + " index=" + i);
            }
            if (!period.equals(item.getPeriod())) {
                throw new RuntimeException("[oracle:view-period] metamorphic violation: getTimePeriod and getDataItem(index).getPeriod() must agree"
