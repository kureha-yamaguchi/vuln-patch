    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        List items = series.getItems();
        List periods = series.getTimePeriods();

        if (count != items.size()) {
            throw new RuntimeException("[oracle:view-count-items] metamorphic violation: item count must equal getItems().size()"
                    + " label=" + label
                    + " count=" + count
                    + " itemsSize=" + items.size());
        }
        if (count != periods.size()) {
            throw new RuntimeException("[oracle:view-count-periods] metamorphic violation: item count must equal getTimePeriods().size()"
                    + " label=" + label
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod period = series.getTimePeriod(i);
            Object periodFromList = periods.get(i);
            Object itemFromList = items.get(i);

            if (item != itemFromList) {
                throw new RuntimeException("[oracle:view-item-identity] metamorphic violation: getDataItem(i) must match getItems().get(i)"
                        + " label=" + label
                        + " index=" + i);
            }
            if (!period.equals(item.getPeriod())) {
                throw new RuntimeException("[oracle:view-period-match] metamorphic violation: getTimePeriod(i) must match getDataItem(i).getPeriod()"
                        + " label=" + label
                        + " index=" + i
                        + " period=" + period
                        + " itemPeriod=" + item.getPeriod());
            }
            if (!period.equals(periodFromList)) {
                throw new RuntimeException("[oracle:view-period-list] metamorphic violation: getTimePeriod(i) must match getTimePeriods().get(i)"
                        + " label=" + label
                        + " index=" + i
                        + " period=" + period
                        + " listPeriod=" + periodFromList);
            }

            Number viaSeries = series.getValue(i);
            Number viaItem = item.getValue();
            if (viaSeries == null ? viaItem != null : !viaSeries.equals(viaItem)) {
                throw new RuntimeException("[oracle:view-value-match] metamorphic violation: getValue(i) must match getDataItem(i).getValue()"
                        + " label=" + label
                        + " index=" + i
                        + " seriesValue=" + viaSeries
                        + " itemValue=" + viaItem);
            }

            int roundTrip = series.getIndex(period);
            if (roundTrip != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must equal i"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + roundTrip
                        + " period=" + period);
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
