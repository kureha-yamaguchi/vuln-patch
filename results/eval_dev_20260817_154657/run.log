package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("1eE");
        } catch (IllegalArgumentException ignored) {
        }

        String prefix = digits(data.consumeInt(1, 6), data);
        String middle = digits(data.consumeInt(0, 6), data);
        char firstExp = data.consumeBoolean() ? 'e' : 'E';
        char secondExp = firstExp == 'e' ? 'E' : 'e';
        String buggyOnlyTrigger = prefix + firstExp + middle + secondExp;

        try {
            NumberUtils.createNumber(buggyOnlyTrigger);
        } catch (IllegalArgumentException ignored) {
        }

        String sign = data.consumeBoolean() ? "-" : "";
        String mant = digits(data.consumeInt(1, 6), data);
        String exp = digits(data.consumeInt(1, 4), data);
        String expSign = data.consumeBoolean() ? (data.consumeBoolean() ? "-" : "+") : "";

        String lower = sign + mant + "e" + expSign + exp;
        String upper = sign + mant + "E" + expSign + exp;
        String lowerWithDecimal = sign + mant + ".0e" + expSign + exp;
        String upperWithDecimal = sign + mant + ".0E" + expSign + exp;

        checkEquivalent(lower, upper, "scientific-exp-case-equivalence");
        checkEquivalent(lower, lowerWithDecimal, "redundant-decimal-before-exponent");
        checkEquivalent(upper, upperWithDecimal, "redundant-decimal-before-exponent-upper");
        checkEquivalent(lower, upperWithDecimal, "exp-case-plus-decimal-boundary");
    }

    private static void checkEquivalent(String a, String b, String oracleId) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed differently inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException ignored) {
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal left = toBigDecimal(a);
        BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float || n instanceof Double) {
            double d = n.doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                return null;
            }
            return new BigDecimal(n.toString());
        }
        return new BigDecimal(n.toString());
    }

    private static String digits(int len, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (sb.length() == 0) {
            return "";
        }
        if (sb.charAt(0) == '0') {
            sb.setCharAt(0, (char) ('1' + data.consumeInt(0, 8)));
        }
        return sb.toString();
    }
}
