package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        triggerIfBuggy("1234.5", true);

        exerciseSilently("12345", true);
        exerciseSilently("12345L", true);
        exerciseSilently("0xFADE", true);
        exerciseSilently("-1234.5", true);
        exerciseSilently("1.1E20", true);

        String mantissaDigits = nonEmptyDigits(data, 1, 6);
        String exponentDigits = nonEmptyDigits(data, 1, 4);
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? (data.consumeBoolean() ? "-" : "+") : "";

        String lower = sign + mantissaDigits + "e" + expSign + exponentDigits;
        String upper = sign + mantissaDigits + "E" + expSign + exponentDigits;
        String lowerWithRedundantDecimal = sign + mantissaDigits + ".0e" + expSign + exponentDigits;
        String upperWithRedundantDecimal = sign + mantissaDigits + ".0E" + expSign + exponentDigits;

        triggerIfBuggy(lower, true);
        triggerIfBuggy(upper, true);
        triggerIfBuggy(lowerWithRedundantDecimal, true);
        triggerIfBuggy(upperWithRedundantDecimal, true);

        /* Contract/oracle: createNumber parses numeric strings into Numbers.
           For valid scientific notation, changing exponent-marker case (e/E) or inserting a redundant ".0"
           before the exponent does not change the represented numeric value. A throw-deleting or overfit patch
           could avoid the known crash yet silently parse one side differently. */
        checkEquivalentScientificExponentCase(lower, upper);
        checkEquivalentScientificExponentCase(lowerWithRedundantDecimal, upperWithRedundantDecimal);
        checkRedundantDecimalPointEquivalence(lower, lowerWithRedundantDecimal);
        checkRedundantDecimalPointEquivalence(upper, upperWithRedundantDecimal);
        checkExponentCaseAndDecimalBoundary(lower, upperWithRedundantDecimal);

        if (data.remainingBytes() > 0) {
            String extraMantissa = digitsOnlyOrFallback(data.consumeAsciiString(8), "7");
            String extraExponent = digitsOnlyOrFallback(data.consumeAsciiString(6), "3");
            String extraSign = data.consumeBoolean() ? "-" : "";
            String extraExpSign = data.consumeBoolean() ? "-" : "";
            if (extraMantissa.length() > 0 && extraExponent.length() > 0) {
                String a = extraSign + extraMantissa + "e" + extraExpSign + extraExponent;
                String b = extraSign + extraMantissa + ".0E" + extraExpSign + extraExponent;
                triggerIfBuggy(a, true);
                triggerIfBuggy(b, true);
                checkRedundantDecimalPointEquivalence(a, b);
                checkEquivalentScientificExponentCase(a, extraSign + extraMantissa + "E" + extraExpSign + extraExponent);
            }
        }
    }

    private static void exerciseSilently(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void triggerIfBuggy(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs == null || rhs == null) {
                return;
            }
            if (!sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRedundantDecimalPointEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: integer-mantissa scientific notation and the same notation with a redundant .0 before the exponent must denote the same quantity inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkExponentCaseAndDecimalBoundary(String lower, String withDecimalUpperE) {
        try {
            Number left = NumberUtils.createNumber(lower);
            Number right = NumberUtils.createNumber(withDecimalUpperE);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:exp-case-plus-decimal-boundary] metamorphic violation: changing exponent-marker case and inserting a redundant .0 before the exponent must preserve numeric value inputA="
                        + lower + " inputB=" + withDecimalUpperE + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean isOracleFailure(RuntimeException t) {
        return t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "isAllZeros".equals(method)
                        || "createInteger".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameNumericValue(Number a, Number b) {
        BigDecimal left = toBigDecimal(a);
        BigDecimal right = toBigDecimal(b);
        return left != null && right != null && left.compareTo(right) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float) {
            float v = ((Float) n).floatValue();
            if (Float.isInfinite(v) || Float.isNaN(v)) {
                return null;
            }
            return new BigDecimal(n.toString());
        }
        if (n instanceof Double) {
            double v = ((Double) n).doubleValue();
            if (Double.isInfinite(v) || Double.isNaN(v)) {
                return null;
            }
            return new BigDecimal(n.toString());
        }
        return new BigDecimal(n.toString());
    }

    private static String nonEmptyDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int d = data.consumeInt(0, 9);
            if (i == 0 && len > 1 && d == 0 && data.consumeBoolean()) {
                d = data.consumeInt(1, 9);
            }
            sb.append((char) ('0' + d));
        }
        return sb.toString();
    }

    private static String digitsOnlyOrFallback(String s, String fallback) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.length() == 0 ? fallback : sb.toString();
    }
}
