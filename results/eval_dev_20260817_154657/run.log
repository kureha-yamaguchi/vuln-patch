package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exercise("\uD83D\uDE30", true);
        exercise("\uD800\uDC00", true);
        exercise("\uD834\uDD1E", true);
        exercise("\uDBFF\uDFFD", true);

        String fuzzed = buildValidNonCsvUnicodeString(data);
        if (fuzzed.length() > 0) {
            exercise(fuzzed, true);
        }
    }

    private static void exercise(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: CSV escaping should leave inputs unchanged when they contain none of
             * the CSV-special characters that require quoting/escaping. We construct inputs from safe
             * BMP characters plus well-formed supplementary code points, excluding ',', '"', '\r', and '\n'.
             * Therefore a correct implementation must return the original string unchanged.
             * A "fix" that merely suppresses the buggy bookkeeping/throw could silently drop or corrupt
             * surrogate pairs, and this observable equality check would catch that wrong-output behavior.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:escapeCsv-identity] metamorphic violation: safe non-CSV input must be unchanged"
                        + " input=" + printable(input)
                        + " lhs=" + printable(escaped)
                        + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Validation")) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidNonCsvUnicodeString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int segments = data.consumeInt(1, 8);
        for (int i = 0; i < segments; i++) {
            if (data.consumeBoolean()) {
                sb.append(safeBmpChar(data));
            } else {
                int codePoint = data.consumeInt(0x10000, 0x10FFFF);
                sb.append(Character.toChars(codePoint));
            }
        }

        if (sb.length() == 0) {
            sb.append(Character.toChars(0x1F630));
        }
        return sb.toString();
    }

    private static char safeBmpChar(FuzzedDataProvider data) {
        final char[] safe = (
            "abcdefghijklmnopqrstuvwxyz" +
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
            "0123456789" +
            " .;:-_+/!?@#$%^&*()[]=<>~'|\\{}"
        ).toCharArray();
        return safe[data.consumeInt(0, safe.length - 1)];
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch >= 0x20 && ch <= 0x7e && ch != '\\' && ch != '"') {
                sb.append(ch);
            } else {
                sb.append("\\u");
                String hex = Integer.toHexString(ch).toUpperCase();
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
