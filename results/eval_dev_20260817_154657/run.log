    private static Day dayFromEpochDay(int epochDay) {
        long millis = ((long) epochDay) * 86400000L;
        return new Day(new java.util.Date(millis));
    }

    private static boolean isOracleFailure(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        String msg = t.getMessage();
        return msg != null && msg.indexOf("[oracle:") >= 0;
    }

    private static boolean isRootCause(Throwable t) {
        if (!isValidationFamily(t)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        while (t != null) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            t = t.getCause();
        }
        return false;
    }
