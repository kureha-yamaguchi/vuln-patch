        }

        String prefix = sanitizePlainCsvField(data.consumeAsciiString(8));
        String suffix = sanitizePlainCsvField(data.consumeAsciiString(8));

        int nonBmpCount = data.consumeInt(1, 3);
        StringBuilder mid = new StringBuilder();
        for (int i = 0; i < nonBmpCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (!Character.isValidCodePoint(cp) || Character.isSurrogate((char) cp)) {
                cp = 0x10000;
            }
            mid.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                mid.append(sanitizePlainCsvField(data.consumeAsciiString(3)));
            }
        }

        String fuzzed = prefix + mid.toString() + suffix;
        if (fuzzed.length() > 0) {
            exerciseEscapeCsvOnValidPlainField(fuzzed);
        }
    }

    private static void exerciseEscapeCsvOnValidPlainField(String input) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: escapeCsv returns a String for a CSV field, quoted only if required.
             * For inputs we construct here, there are no CSV-special characters (comma, quote, CR, LF),
             * so a correct implementation must leave the field unchanged. A patch that merely suppresses
             * the crash by skipping/altering bookkeeping could silently change output and violate this.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: plain CSV field without special characters must remain unchanged input="
                        + repr(input) + " lhs=" + repr(escaped) + " rhs=" + repr(input));
            }

            /*
             * Additional real-library relation: unescapeCsv(escapeCsv(x)) == x for accepted inputs.
             * If either call throws, the check does not apply and we return.
             */
            try {
                String roundTrip = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);
                if (!input.equals(roundTrip)) {
                    throw new RuntimeException(
                        "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) must equal x input="
                            + repr(input) + " lhs=" + repr(roundTrip) + " rhs=" + repr(input));
                }
            } catch (Throwable t) {
                if (isOracleRuntime(t)) {
                    throw (RuntimeException) t;
                }
                return;
            }
        } catch (Throwable t) {
            if (isOracleRuntime(t)) {
