package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true);
        }

        String safeAlphabet = " abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:/;()[]{}+=!?@#$%^&*~|\\'`éΩ中";

        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < prefixLen; i++) {
            sb.append(safeAlphabet.charAt(data.consumeInt(0, safeAlphabet.length() - 1)));
        }
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                sb.append(safeAlphabet.charAt(data.consumeInt(0, safeAlphabet.length() - 1)));
            }
        }
        for (int i = 0; i < suffixLen; i++) {
            sb.append(safeAlphabet.charAt(data.consumeInt(0, safeAlphabet.length() - 1)));
        }

        String fuzzed = sb.toString();
        exerciseEscapeCsv(fuzzed, true);

        if (data.consumeBoolean()) {
            String doubled = fuzzed + new String(Character.toChars(data.consumeInt(0x10000, 0x10FFFF)));
            exerciseEscapeCsv(doubled, true);
        }
    }

    private static void exerciseEscapeCsv(String input, boolean assertIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            /*
             * Contract asserted: StringEscapeUtils.escapeCsv returns the input unchanged when the input
             * contains none of the CSV-special characters (comma, quote, CR, LF). The failing test itself
             * demonstrates this for surrogate-pair strings. Therefore, for our valid-by-construction inputs
             * (well-formed UTF-16, non-empty, and excluding those special characters), a throw-deleting or
             * branch-skipping patch that silently drops/changes characters violates observable API behavior.
             */
            if (assertIdentity && input != null && input.length() > 0 && isWellFormedUtf16(input) && hasNoCsvSpecials(input)) {
                if (!input.equals(escaped)) {
                    throw new RuntimeException("[oracle:escapeCsv-identity] metamorphic violation: escapeCsv must preserve strings without CSV special characters input="
                            + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
                }
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && input != null && input.length() > 0 && isWellFormedUtf16(input)) {
                throw t;
            }
        } catch (Error e) {
            if (isRootCause(e) && input != null && input.length() > 0 && isWellFormedUtf16(input)) {
                throw e;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasNoCsvSpecials(String s) {
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
        }
        return true;
    }

    private static boolean isWellFormedUtf16(String s) {
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                i++;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            }
        }
        return true;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        out.append(String.format("\\u%04X", (int) ch));
                    } else {
                        out.append(ch);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }
}
