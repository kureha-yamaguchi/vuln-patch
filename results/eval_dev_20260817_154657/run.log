package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String fuzzDigits = digitsFromFuzz(data);
        String fuzzExpDigits = positiveDigitsFromFuzz(data, 3);
        String sign = data.consumeBoolean() ? "-" : "";
        String expSign = data.consumeBoolean() ? "+" : "";
        String lowerE = data.consumeBoolean() ? "e" : "E";

        String validScientific = sign + fuzzDigits + lowerE + expSign + fuzzExpDigits;
        String validScientificRedundantDecimal = sign + fuzzDigits + ".0" + (lowerE.equals("e") ? "E" : "e") + expSign + fuzzExpDigits;

        exerciseCreateNumber(validScientific, true);
        exerciseCreateNumber(validScientificRedundantDecimal, true);
        exerciseCreateNumber(validScientific + "D", true);
        exerciseCreateNumber(validScientific + "d", true);
        exerciseCreateNumber(validScientific + "F", true);
        exerciseCreateNumber(validScientific + "f", true);

        String exactMantissa = Integer.toString(data.consumeInt(1, 999));
        int exactExponent = data.consumeInt(0, 3);
        String exactSign = data.consumeBoolean() ? "-" : "";
        String exactLower = exactSign + exactMantissa + "e" + exactExponent;
        String exactUpper = exactSign + exactMantissa + "E" + exactExponent;
        String exactRedundant = exactSign + exactMantissa + ".0E" + exactExponent;

        exerciseCreateNumber(exactLower, true);
        exerciseCreateNumber(exactUpper, true);
        exerciseCreateNumber(exactRedundant, true);

        checkEquivalentScientificExponentCase(exactLower, exactUpper);
        checkRedundantDecimalPointEquivalence(exactLower, exactRedundant);
        checkExponentCaseAndDecimalBoundary(exactLower, exactRedundant);

        String remaining = data.consumeRemainingAsString();
        if (remaining != null && remaining.length() > 0) {
            exerciseCreateNumber(remaining, false);
        }
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isKnownRootCauseInCreateNumber(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs == null || rhs == null) {
                return;
            }
            if (!sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case must not change numeric value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isKnownRootCauseInCreateNumber(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void checkRedundantDecimalPointEquivalence(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:redundant-decimal-before-exponent] metamorphic violation: integer-mantissa scientific notation and the same notation with a redundant .0 before the exponent must denote the same quantity inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isKnownRootCauseInCreateNumber(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void checkExponentCaseAndDecimalBoundary(String lower, String withDecimalUpperE) {
        try {
            Number left = NumberUtils.createNumber(lower);
            Number right = NumberUtils.createNumber(withDecimalUpperE);
            if (left == null || right == null) {
                return;
            }
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:exp-case-plus-decimal-boundary] metamorphic violation: changing exponent-marker case and inserting a redundant .0 before the exponent must preserve numeric value inputA="
                        + lower + " inputB=" + withDecimalUpperE + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isKnownRootCauseInCreateNumber(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal left = new BigDecimal(a.toString()).stripTrailingZeros();
            BigDecimal right = new BigDecimal(b.toString()).stripTrailingZeros();
            return left.compareTo(right) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isKnownRootCauseInCreateNumber(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)
                    && ("isAllZeros".equals(method)
                    || "createInteger".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method))) {
                return true;
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanReject(RuntimeException t) {
        if (t instanceof IllegalArgumentException) {
            return true;
        }
        String cls = t.getClass().getName().toLowerCase();
        return cls.contains("invalid") || cls.contains("format");
    }

    private static String digitsFromFuzz(FuzzedDataProvider data) {
        String s = data.consumeAsciiString(6);
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length() && out.length() < 6; i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            out.append(data.consumeInt(1, 999999));
        }
        if (out.charAt(0) == '0') {
            out.setCharAt(0, '1');
        }
        return out.toString();
    }

    private static String positiveDigitsFromFuzz(FuzzedDataProvider data, int maxDigits) {
        int value = data.consumeInt(0, 999);
        String s = Integer.toString(value);
        if (s.length() > maxDigits) {
            s = s.substring(0, maxDigits);
        }
        return s;
    }
}
