package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            try {
                StringEscapeUtils.escapeCsv(s);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t) && isValidConstructedSafeCsvInput(s)) {
                    throwUnchecked(t);
                }
            }
            checkIdentityForSafeCsvInput(s);
        }

        String prefix = sanitizeSafeCsvText(data.consumeString(16));
        String suffix = sanitizeSafeCsvText(data.consumeString(16));

        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        String pair = new String(Character.toChars(codePoint));

        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append(sanitizeSafeCsvText(data.consumeString(8)));
        }
        sb.append(prefix);
        sb.append(pair);
        sb.append(suffix);
        int extraPairs = data.consumeInt(0, 3);
        for (int i = 0; i < extraPairs; i++) {
            sb.append(sanitizeSafeCsvText(data.consumeString(6)));
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
        }
        if (data.consumeBoolean()) {
            sb.append(sanitizeSafeCsvText(data.consumeRemainingAsString()));
        }
        String constructed = sb.toString();

        try {
            StringEscapeUtils.escapeCsv(constructed);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidConstructedSafeCsvInput(constructed)) {
                throwUnchecked(t);
            }
            return;
        }

        checkIdentityForSafeCsvInput(constructed);
    }

    private static void checkIdentityForSafeCsvInput(String s) {
        if (!isValidConstructedSafeCsvInput(s)) {
            return;
        }
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            /*
             * Contract exercised by StringUtilsTest.testEscapeSurrogatePairs:
             * for input that contains no CSV special characters (comma, quote, CR, LF),
             * escapeCsv must return the input unchanged. A throw-deleting or branch-skipping
             * patch in CharSequenceTranslator.translate could avoid the crash by silently
             * dropping or mangling surrogate-pair code points, which this post-condition catches.
             */
            if (!s.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe input input=" + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidConstructedSafeCsvInput(s)) {
                throw t;
            }
        } catch (Throwable t) {
            // Per hygiene rules: if the call throws, skip the oracle for this input.
        }
    }

    private static boolean isValidConstructedSafeCsvInput(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        boolean hasSupplementary = false;
        for (int i = 0; i < s.length();) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                hasSupplementary = true;
                i += 2;
                continue;
            }
            if (Character.isLowSurrogate(ch)) {
                return false;
            }
            i++;
        }
        return hasSupplementary;
    }

    private static String sanitizeSafeCsvText(String in) {
        if (in == null || in.length() == 0) {
            return "a";
        }
        StringBuilder out = new StringBuilder(in.length());
        for (int i = 0; i < in.length(); i++) {
            char ch = in.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                out.append('a');
            } else if (Character.isSurrogate(ch)) {
                out.append('b');
            } else {
                out.append(ch);
            }
        }
        if (out.length() == 0) {
            out.append('a');
        }
        return out.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
