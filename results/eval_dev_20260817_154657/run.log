package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    private static BigDecimal asBigDecimal(Number n) {
        return new BigDecimal(n.toString());
    }

    private static void assertSameNumericValue(String oracleId, String a, String b) {
        Number left = NumberUtils.createNumber(a);
        Number right = NumberUtils.createNumber(b);
        if (left == null || right == null) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: unexpected null result inputA=" + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
        }
        if (asBigDecimal(left).compareTo(asBigDecimal(right)) != 0) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: equivalent numeric strings parsed to different values inputA=" + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
        }
    }

    private static String digitsOnly(String s, int fallback) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        while (sb.length() < fallback) {
            sb.append('1');
        }
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NumberUtils.createNumber("1234.5");

        String sign = data.consumeBoolean() ? "-" : "";
        String intPart = digitsOnly(data.consumeAsciiString(6), 1);
        String fracPart = digitsOnly(data.consumeAsciiString(6), 1);
        String expPart = digitsOnly(data.consumeAsciiString(2), 1);

        if (intPart.length() == 0) {
            intPart = "1";
        }
        if (fracPart.length() == 0) {
            fracPart = "0";
        }
        if (expPart.length() == 0) {
            expPart = "1";
        }

        intPart = intPart.substring(0, Math.min(intPart.length(), 3));
        fracPart = fracPart.substring(0, Math.min(fracPart.length(), 3));
        expPart = expPart.substring(0, 1);

        String plainDecimal = sign + intPart + "." + fracPart;
        NumberUtils.createNumber(plainDecimal);

        String sciLower = sign + intPart + "e" + expPart;
        String sciUpper = sign + intPart + "E" + expPart;
        String sciWithRedundantDecimal = sign + intPart + ".0e" + expPart;

        NumberUtils.createNumber(sciLower);
        NumberUtils.createNumber(sciUpper);
        NumberUtils.createNumber(sciWithRedundantDecimal);

        /*
         * Contract checked: createNumber parses numeric strings, so changing only the
         * exponent-marker case, or inserting a redundant ".0" before the exponent,
         * must preserve the numeric value for valid scientific notation.
         */
        assertSameNumericValue("scientific-exp-case-equivalence", sciLower, sciUpper);
        assertSameNumericValue("redundant-decimal-before-exponent", sciLower, sciWithRedundantDecimal);
    }
}
