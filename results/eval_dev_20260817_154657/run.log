    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));
        checkSeriesViewConsistency(s, "anchor-source");

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        int manualCount = 0;
        for (int i = 0; i < s.getItemCount(); i++) {
            RegularTimePeriod p = s.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
        }
        if (manualCount != 0) {
            throw new RuntimeException("[oracle:anchor-gap-shape] metamorphic violation: anchor range must be empty"
                    + " manualCount=" + manualCount);
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0) {
            throw new RuntimeException("[oracle:anchor-gap-empty] metamorphic violation: anchor createCopy inside gap must be empty"
                    + " copyCount=" + copy.getItemCount());
        }
    }

    private static Day addDays(Day base, int delta) {
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(base.getYear(), base.getMonth() - 1, base.getDayOfMonth(), 12, 0, 0);
        cal.add(Calendar.DATE, delta);
        return new Day(cal.getTime(), TimeZone.getTimeZone("UTC"));
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
