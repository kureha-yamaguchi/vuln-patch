            if (roundTrip != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex(getTimePeriod(i)) must return i"
                        + " tag=" + tag
                        + " index=" + i
                        + " roundTrip=" + roundTrip
                        + " period=" + p);
            }
        }
