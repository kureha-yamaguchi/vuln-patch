                 * This cross-check computes the same quantity via the dedicated helper on a
                 * plus-signed decimal that is valid by construction and guaranteed to overflow long.
                 */
                if (!(parsed instanceof BigInteger) || helper == null || !helper.equals(parsed)) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-overflow-bigint-fallback] metamorphic violation: createNumber(+overflow-decimal+L) must agree with createBigInteger(+decimal) input="
                                    + suffixed + " lhs=" + parsed + " rhs=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCauseLeak(e)) {
                    return;
                }
            }
        }
    }
