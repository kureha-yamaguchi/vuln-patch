package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String candidate = buildValidCsvSafeString(data);
        if (candidate.length() == 0) {
            candidate = "\uD83D\uDE30";
        }

        try {
            String escaped = StringEscapeUtils.escapeCsv(candidate);

            /*
             * Contract asserted: CSV escaping leaves input unchanged when no CSV special characters
             * requiring escaping are present. We construct candidate by construction from only
             * ASCII letters/digits/spaces plus well-formed surrogate pairs, never ',', '"', '\r', '\n'.
             * Therefore any correct implementation must return the original string unchanged.
             * A throw-deleting or bookkeeping-skipping patch could avoid the crash by silently skipping
             * characters from a supplementary code point; this equality would detect that wrong output.
             */
            if (!candidate.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve csv-safe valid input input="
                        + printable(candidate) + " lhs=" + printable(escaped) + " rhs=" + printable(candidate));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t, candidate)) {
                throw t;
            }
        }
    }

    private static void runAnchor(String s) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-anchor-identity] metamorphic violation: escapeCsv must preserve surrogate-pair-only csv-safe input input="
                        + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t, s)) {
                throw t;
            }
        }
    }

    private static String buildValidCsvSafeString(FuzzedDataProvider data) {
        int parts = data.consumeInt(1, 12);
        StringBuilder sb = new StringBuilder();
        boolean hasSupplementary = false;

        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                int cp = consumeSupplementaryCodePoint(data);
                sb.append(Character.toChars(cp));
                hasSupplementary = true;
            } else {
                sb.append(consumeSafeBmpChar(data));
            }
        }

        if (!hasSupplementary) {
            int insertAt = data.consumeInt(0, sb.length());
            sb.insert(insertAt, Character.toChars(consumeSupplementaryCodePoint(data)));
        }

        return sb.toString();
    }

    private static int consumeSupplementaryCodePoint(FuzzedDataProvider data) {
        int cp;
        do {
            cp = data.consumeInt(0x10000, 0x10FFFF);
        } while (cp >= 0xD800 && cp <= 0xDFFF);
        return cp;
    }

    private static char consumeSafeBmpChar(FuzzedDataProvider data) {
        String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 _-.";
        return alphabet.charAt(data.consumeInt(0, alphabet.length() - 1));
    }

    private static boolean isRootCause(Throwable t, String input) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        if (!isValidByConstruction(input)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        boolean hasSupplementary = false;
        for (int i = 0; i < s.length();) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                hasSupplementary = true;
                i += 2;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            } else {
                i++;
            }
        }
        return hasSupplementary;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) ch));
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
