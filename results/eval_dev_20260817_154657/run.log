package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30", true);
        runCase("\uD800\uDC00", true);
        runCase("\uD834\uDD1E", true);
        runCase("\uDBFF\uDFFD", true);

        int prefixLen = data.consumeInt(0, 8);
        int suffixLen = data.consumeInt(0, 8);
        int extraPairs = data.consumeInt(0, 4);

        String prefix = makeCsvSafeAscii(data, prefixLen);
        String suffix = makeCsvSafeAscii(data, suffixLen);

        int cp = data.consumeInt(0x10000, 0x10FFFF);
        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        sb.append(Character.toChars(cp));

        for (int i = 0; i < extraPairs; i++) {
            if (data.consumeBoolean()) {
                sb.append(makeCsvSafeAscii(data, data.consumeInt(0, 4)));
            }
            int cp2 = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp2));
        }

        sb.append(suffix);
        String candidate = sb.toString();

        runCase(candidate, true);

        if (candidate.length() > 2) {
            int split = data.consumeInt(1, candidate.length() - 1);
            String left = candidate.substring(0, split);
            String right = candidate.substring(split);
            runCompositionCase(left, right);
        }
    }

    private static String makeCsvSafeAscii(FuzzedDataProvider data, int len) {
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int v = data.consumeInt(0, 51);
            char c = (char) (v < 26 ? ('a' + v) : ('A' + (v - 26)));
            sb.append(c);
        }
        return sb.toString();
    }

    private static void runCase(String s, boolean assertIdentity) {
        try {
            String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);

            /*
             * Contract used for the oracle:
             * CSV escaping only adds quotes/escapes when the field contains CSV special
             * characters such as comma, quote, CR, or LF. For the strings constructed here,
             * we include only ASCII letters plus valid supplementary Unicode code points, so
             * they are valid-by-construction and contain no CSV special characters. Therefore
             * a correct implementation must return the input unchanged. A "fix" that merely
             * skips the crashing bookkeeping or silently drops/mangles surrogate handling will
             * violate this observable identity property.
             */
            if (assertIdentity && !s.equals(out)) {
                throw new RuntimeException(
                        "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe valid strings input="
                                + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static void runCompositionCase(String left, String right) {
        String combined = left + right;
        String lhs;
        String rhsLeft;
        String rhsRight;
        try {
            lhs = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(combined);
            rhsLeft = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(left);
            rhsRight = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(right);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return;
        }

        /*
         * Contract used for the oracle:
         * On CSV-safe strings with no comma, quote, CR, or LF, escapeCsv is the identity.
         * Hence for such valid inputs, escapeCsv(left + right) == escapeCsv(left) + escapeCsv(right)
         * because both sides equal left + right. This catches silent corruption even if no
         * exception is thrown.
         */
        String rhs = rhsLeft + rhsRight;
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                    "[oracle:csv-compose] metamorphic violation: identity/composition on CSV-safe strings input="
                            + printable(combined) + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
