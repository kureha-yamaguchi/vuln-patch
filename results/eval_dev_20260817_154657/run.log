                        || !(lower instanceof Long)
                        || !(upper instanceof Long)
                        || helperLong == null
                        || unsuffixed == null
                        || explicit.longValue() != helperLong.longValue()
                        || lower.longValue() != helperLong.longValue()
                        || upper.longValue() != helperLong.longValue()
                        || unsuffixed.longValue() != helperLong.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-explicit-long-consistency] metamorphic violation: explicit L/l parsing of a helper-valid +decimal must agree with createLong and unsuffixed createNumber input="
                                    + suffixed + " explicit=" + explicit + " lower=" + lower + " upper=" + upper
                                    + " helper=" + helperLong + " unsuffixed=" + unsuffixed);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isRootCause(e) && isValidPlusSignedDecimal(numeric)) {
                    throw e;
                }
                if (helperLong != null && unsuffixed != null) {
                    throw new RuntimeException(
                            "[oracle:plus-explicit-long-consistency] metamorphic violation: explicit L/l parsing rejected a helper-valid +decimal input="
                                    + suffixed + " helper=" + helperLong + " unsuffixed=" + unsuffixed + " threw=" + e);
