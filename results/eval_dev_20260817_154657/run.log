package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String seedDigits = digitsOnly(data.consumeAsciiString(12));
        String sign = data.consumeBoolean() ? "-" : "";
        String base = sign + seedDigits;

        int expValue = data.consumeInt(-20, 20);
        String expDigits = Integer.toString(Math.abs(expValue));
        String expSign = expValue < 0 ? "-" : (data.consumeBoolean() ? "+" : "");
        String lowerSci = base + "e" + expSign + expDigits;
        String upperSci = base + "E" + expSign + expDigits;

        exerciseCreateNumber(base, true);
        exerciseCreateNumber(lowerSci, true);
        exerciseCreateNumber(upperSci, true);
        exerciseCreateNumber(base + ".0", true);
        exerciseCreateNumber(base + "F", true);
        exerciseCreateNumber(base + "D", true);
        exerciseCreateNumber(base + "L", true);

        exerciseCreateNumber(base + "e", false);
        exerciseCreateNumber(base + "E", false);
        exerciseCreateNumber(base + "e+", false);
        exerciseCreateNumber(base + "E-", false);
        exerciseCreateNumber(base + "e0", true);
        exerciseCreateNumber(base + "E0", true);
        exerciseCreateNumber(base + "e1", true);
        exerciseCreateNumber(base + "E1", true);
        exerciseCreateNumber(base + "e0F", true);
        exerciseCreateNumber(base + "E0D", true);

        String tail = data.consumeAsciiString(6);
        exerciseCreateNumber(base + "e" + tail, false);
        exerciseCreateNumber(base + "E" + tail, false);

        checkEquivalentScientificExponentCase(lowerSci, upperSci);
        checkExponentZeroEquivalence(base, base + "e0");
        checkExponentZeroEquivalence(base, base + "E0");
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static void checkExponentZeroEquivalence(String plain, String scientificZero) {
        try {
            Number lhs = NumberUtils.createNumber(plain);
            Number rhs = NumberUtils.createNumber(scientificZero);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:exp-zero-equivalence] metamorphic violation: appending exponent zero changed value inputPlain="
                        + plain + " inputScientific=" + scientificZero + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ex) {
            return a.toString().equals(b.toString());
        }
    }

    private static String digitsOnly(String raw) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            return "1";
        }
        return sb.toString();
    }
}
