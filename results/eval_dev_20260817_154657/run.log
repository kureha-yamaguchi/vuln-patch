package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String digits = digitString(data.consumeInt(1, 18), data.consumeAsciiString(32));
        boolean negative = data.consumeBoolean();
        String integerBase = (negative ? "-" : "") + normalizeIntegerDigits(digits);

        exerciseCreateNumber(integerBase, true);
        exerciseCreateNumber(integerBase + "L", true);
        exerciseCreateNumber(integerBase + "l", true);
        checkIntegerSuffixExactness(integerBase);

        String frac = digitString(data.consumeInt(1, 12), data.consumeAsciiString(24));
        String decimalBase = integerBase + "." + frac;

        exerciseCreateNumber(decimalBase, true);
        exerciseCreateNumber(decimalBase + "D", true);
        exerciseCreateNumber(decimalBase + "d", true);
        exerciseCreateNumber(decimalBase + "F", true);
        exerciseCreateNumber(decimalBase + "f", true);

        String expDigits = digitString(data.consumeInt(1, 4), data.consumeAsciiString(8));
        String validSciUpper = decimalBase + "E" + expDigits;
        String validSciLower = decimalBase + "e" + expDigits;
        exerciseCreateNumber(validSciUpper, true);
        exerciseCreateNumber(validSciLower, true);

        String extra = data.consumeAsciiString(8);
        exerciseCreateNumber(integerBase + "E", false);
        exerciseCreateNumber(integerBase + "e", false);
        exerciseCreateNumber(integerBase + "E+", false);
        exerciseCreateNumber(integerBase + "e-", false);
        exerciseCreateNumber(integerBase + "eE", false);
        exerciseCreateNumber(integerBase + "Ee", false);
        exerciseCreateNumber(integerBase + "e" + extra + "E", false);
        exerciseCreateNumber(integerBase + "E" + extra + "e", false);
        exerciseCreateNumber(decimalBase + "eE" + extra, false);
        exerciseCreateNumber(decimalBase + "Ee" + extra, false);

        if (data.consumeBoolean()) {
            String raw = data.consumeRemainingAsString();
            if (raw != null && raw.length() > 0) {
                exerciseCreateNumber(raw, false);
            }
        }
    }

    private static void checkIntegerSuffixExactness(String base) {
        try {
            Number plain = NumberUtils.createNumber(base);
            Number upper = NumberUtils.createNumber(base + "L");
            Number lower = NumberUtils.createNumber(base + "l");
            if (plain == null || upper == null || lower == null) {
                return;
            }

            BigInteger expected = NumberUtils.createBigInteger(base);
            BigInteger plainValue = asBigIntegerExact(plain);
            BigInteger upperValue = asBigIntegerExact(upper);
            BigInteger lowerValue = asBigIntegerExact(lower);

            /* Contract exercised from createNumber's code and tests:
             * an integer string denotes that exact integer; adding explicit 'L'/'l'
             * only requests the representation type, not a different numeric value.
             * A throw-deleting or overfitted patch could stop crashing yet still parse
             * one boundary form to the wrong quantity, so compare against an
             * independent exact quantity from the real library: createBigInteger(base).
             */
            if (!expected.equals(plainValue) || !expected.equals(upperValue) || !expected.equals(lowerValue)) {
                throw new RuntimeException(
                    "[oracle:integer-suffix-exactness] metamorphic violation: integer quantity changed across equivalent forms "
                        + "input=" + base
                        + " expected=" + expected
                        + " plain=" + plain
                        + " upperL=" + upper
                        + " lowerl=" + lower);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static BigInteger asBigIntegerExact(Number n) {
        if (n instanceof BigInteger) {
            return (BigInteger) n;
        }
        if (n instanceof Integer || n instanceof Long || n instanceof Short || n instanceof Byte) {
            return BigInteger.valueOf(n.longValue());
        }
        return new BigDecimal(n.toString()).toBigIntegerExact();
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang3.math.NumberUtils".equals(ste.getClassName())
                && "createNumber".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String digitString(int minLen, String ascii) {
        StringBuilder sb = new StringBuilder();
        if (ascii != null) {
            for (int i = 0; i < ascii.length(); i++) {
                char c = ascii.charAt(i);
                if (c >= '0' && c <= '9') {
                    sb.append(c);
                }
            }
        }
        while (sb.length() < minLen) {
            sb.append((char) ('0' + (sb.length() % 10)));
        }
        return sb.toString();
    }

    private static String normalizeIntegerDigits(String digits) {
        int i = 0;
        while (i < digits.length() - 1 && digits.charAt(i) == '0') {
            i++;
        }
        return digits.substring(i);
    }
}
