package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor from the regression test: call first, but swallow the already-known crash signature.
        exerciseCreateNumber("1234.5", true, false);

        // Additional literals from the test help cover nearby real paths without custom stand-ins.
        exerciseCreateNumber("12345", true, false);
        exerciseCreateNumber("1234.5D", true, false);
        exerciseCreateNumber("1234.5F", true, false);
        exerciseCreateNumber("-1234.5", true, false);
        exerciseCreateNumber("0xFADE", true, false);
        exerciseCreateNumber("1.1E20", true, false);
        exerciseCreateNumber("2.", true, false);

        String base = buildSignedDigits(data);
        int exponent = data.consumeInt(-8, 8);

        // Strategy (c): flip the patched boundary around expPos < str.length() - 1.
        // These inputs differ only by being exactly at the boundary (marker is last char) vs just past it.
        String trailingLower = base + "e";
        String trailingUpper = base + "E";
        String validLower = base + "e" + exponent;
        String validUpper = base + "E" + exponent;

        // Boundary exercisers: invalid but real inputs that reach the patched logic.
        exerciseCreateNumber(trailingLower, false, false);
        exerciseCreateNumber(trailingUpper, false, false);
        exerciseCreateNumber(base + "eF", false, false);
        exerciseCreateNumber(base + "ED", false, false);

        // Metamorphic oracle 1:
        // Contract justification: createNumber explicitly looks for both 'e' and 'E', so for valid scientific
        // notation, changing only the exponent-marker case must not change the numeric value.
        checkEquivalentScientificExponentCase(validLower, validUpper);

        // Metamorphic oracle 2:
        // Contract justification: createNumber returns a Number representing the parsed quantity; reparsing that
        // Number's canonical toString() must represent the same quantity for valid accepted inputs.
        checkRoundTripConsistency(validLower);
        checkRoundTripConsistency(validUpper);

        // Explore a nearby valid boundary with an explicit decimal and optional suffix.
        String decimal = buildDecimal(data);
        String decimalLower = decimal + "e" + exponent;
        String decimalUpper = decimal + "E" + exponent;
        checkEquivalentScientificExponentCase(decimalLower, decimalUpper);
        checkRoundTripConsistency(decimalLower);

        char suffix = data.consumeBoolean() ? 'F' : 'D';
        checkEquivalentScientificExponentCase(decimalLower + suffix, decimalUpper + suffix);
        checkRoundTripConsistency(decimalLower + suffix);
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction, boolean propagateRoot) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanReject(t)) {
                return;
            }
            if (propagateRoot && validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException(
                    "[oracle:scientific-exp-case] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRoundTripConsistency(String s) {
        try {
            Number first = NumberUtils.createNumber(s);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number reparsed = NumberUtils.createNumber(canonical);
            if (reparsed != null && !sameNumericValue(first, reparsed)) {
                throw new RuntimeException(
                    "[oracle:roundtrip-canonical] metamorphic violation: createNumber(x).toString() reparsed to different quantity input="
                        + s + " canonical=" + canonical + " first=" + first + " reparsed=" + reparsed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal bdA = new BigDecimal(a.toString());
            BigDecimal bdB = new BigDecimal(b.toString());
            return bdA.compareTo(bdB) == 0;
        } catch (RuntimeException ignored) {
            return Double.compare(a.doubleValue(), b.doubleValue()) == 0;
        }
    }

    private static String buildSignedDigits(FuzzedDataProvider data) {
        int value = data.consumeInt(-999999, 999999);
        if (value == 0) {
            value = 123;
        }
        return Integer.toString(value);
    }

    private static String buildDecimal(FuzzedDataProvider data) {
        int whole = data.consumeInt(-9999, 9999);
        int frac = data.consumeInt(0, 9999);
        if (whole == 0) {
            whole = 12;
        }
        String fracPart = Integer.toString(frac);
        while (fracPart.length() < 1) {
            fracPart = "0" + fracPart;
        }
        return Integer.toString(whole) + "." + fracPart;
    }

    private static boolean isCleanReject(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)
                && ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method))) {
                return true;
            }
            if ("java.lang.String".equals(cls)
                && ("substring".equals(method) || "charAt".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
