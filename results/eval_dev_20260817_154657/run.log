                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }

                checkBoundaryStepRight(series, start, right);
                checkBoundaryStepLeft(series, left, end);
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isOracleFailure(e) || isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        if (countItemsInRange(s, start, end) != 0) {
            throw new RuntimeException("[oracle:anchor-shape] metamorphic violation: anchor range must be empty");
        }

        TimeSeries copy = s.createCopy(start, end);
        checkSeriesViewConsistency(copy, "anchor-copy");
        if (copy.getItemCount() != 0 || copy.getItems().size() != 0 || copy.getTimePeriods().size() != 0) {
            throw new RuntimeException("[oracle:anchor-empty] metamorphic violation: anchor gap copy must be empty"
                    + " count=" + copy.getItemCount()
                    + " items=" + copy.getItems().size()
                    + " periods=" + copy.getTimePeriods().size());
        }

        TimeSeries rightBoundary = s.createCopy(start, new Day(31, 1, 2006));
        TimeSeries rightByIndex = s.createCopy(1, 1);
        checkSeriesViewConsistency(rightBoundary, "anchor-right-boundary");
        checkSeriesViewConsistency(rightByIndex, "anchor-right-index");
        assertSingletonSame(rightBoundary, rightByIndex, "anchor-right");

        TimeSeries leftBoundary = s.createCopy(new Day(19, 8, 2005), end);
        TimeSeries leftByIndex = s.createCopy(0, 0);
        checkSeriesViewConsistency(leftBoundary, "anchor-left-boundary");
        checkSeriesViewConsistency(leftByIndex, "anchor-left-index");
        assertSingletonSame(leftBoundary, leftByIndex, "anchor-left");
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
        TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

        checkSeriesViewConsistency(byBoundary, "boundary-right-byBoundary");
        checkSeriesViewConsistency(byIndex, "boundary-right-byIndex");
        assertSingletonSame(byBoundary, byIndex, "boundary-step-right");
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd)
            throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
            throw new RuntimeException("[oracle:left-boundary-present] metamorphic violation: left boundary period must exist"
                    + " left=" + exactLeft
                    + " leftIndex=" + leftIndex);
        }

        TimeSeries byBoundary = series.createCopy(exactLeft, absentEnd);
        TimeSeries byIndex = series.createCopy(leftIndex, leftIndex);

        checkSeriesViewConsistency(byBoundary, "boundary-left-byBoundary");
        checkSeriesViewConsistency(byIndex, "boundary-left-byIndex");
        assertSingletonSame(byBoundary, byIndex, "boundary-step-left");
    }

    private static void assertSingletonSame(TimeSeries a, TimeSeries b, String label) {
        if (a.getItemCount() != 1 || b.getItemCount() != 1) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: singleton size mismatch"
                    + " leftCount=" + a.getItemCount()
                    + " rightCount=" + b.getItemCount());
        }
        if (!a.getTimePeriod(0).equals(b.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: singleton period mismatch"
                    + " leftPeriod=" + a.getTimePeriod(0)
                    + " rightPeriod=" + b.getTimePeriod(0));
        }
        Number va = a.getValue(0);
        Number vb = b.getValue(0);
        if (va == null ? vb != null : !va.equals(vb)) {
            throw new RuntimeException("[oracle:" + label + "] metamorphic violation: singleton value mismatch"
                    + " leftValue=" + va
                    + " rightValue=" + vb);
        }
    }

    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int itemCount = series.getItemCount();
        int itemsSize = series.getItems().size();
        int periodsSize = series.getTimePeriods().size();

        if (itemCount != itemsSize || itemCount != periodsSize) {
            throw new RuntimeException("[oracle:view-consistency] metamorphic violation: series views disagree"
                    + " label=" + label
                    + " itemCount=" + itemCount
                    + " itemsSize=" + itemsSize
                    + " periodsSize=" + periodsSize);
        }

        for (int i = 0; i < itemCount; i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (!series.getDataItem(i).getPeriod().equals(p)) {
                throw new RuntimeException("[oracle:dataitem-period] metamorphic violation: getDataItem/getTimePeriod disagree"
                        + " label=" + label
                        + " index=" + i
                        + " dataItemPeriod=" + series.getDataItem(i).getPeriod()
                        + " timePeriod=" + p);
            }
            if (series.getIndex(p) != i) {
                throw new RuntimeException("[oracle:index-roundtrip] metamorphic violation: getIndex/getTimePeriod disagree"
                        + " label=" + label
                        + " index=" + i
                        + " roundTrip=" + series.getIndex(p)
                        + " period=" + p);
            }
        }
    }

    private static int countItemsInRange(TimeSeries series, RegularTimePeriod start, RegularTimePeriod end) {
        int count = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                count++;
            }
        }
        return count;
    }

    private static Day makeBaseDay(int offset) {
        return addDays(new Day(1, 1, 2000), offset);
    }

    private static Day addDays(Day day, int delta) {
        RegularTimePeriod p = day;
        if (delta >= 0) {
            for (int i = 0; i < delta; i++) {
                p = p.next();
                if (p == null) {
                    throw new RuntimeException("Unexpected null from Day.next()");
                }
            }
        } else {
            for (int i = 0; i < -delta; i++) {
                p = p.previous();
                if (p == null) {
                    throw new RuntimeException("Unexpected null from Day.previous()");
                }
            }
        }
        return (Day) p;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
