public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact trigger geometry from the regression test.
        exerciseCase(1.0, 1.0e-6, 0.0, 0.0, 0.0);

        // Explore the same root-cause property with valid-by-construction variants:
        // a cube-like closed polyhedron with one vertex slightly perturbed, plus
        // moderate scaling and translation. This preserves a real, bounded shape.
        double scale = boundedScale(data.consumeInt());
        double epsilon = boundedEpsilon(data.consumeInt());
        double tx = boundedShift(data.consumeInt());
        double ty = boundedShift(data.consumeInt());
        double tz = boundedShift(data.consumeInt());

        exerciseCase(scale, epsilon, tx, ty, tz);

        // Additional nearby boundary exploration around the patched condition.
        if (data.consumeBoolean()) {
            exerciseCase(scale, 0.0, tx, ty, tz);
        }
        if (data.consumeBoolean()) {
            exerciseCase(scale, Math.nextUp(0.0), tx, ty, tz);
        }
        if (data.consumeBoolean()) {
            exerciseCase(scale, 1.0e-12, tx, ty, tz);
        }
    }

    private static void exerciseCase(double scale, double epsilon, double tx, double ty, double tz) {
        ArrayList<SubHyperplane<Euclidean3D>> facets = buildCubeLikeBoundary(scale, epsilon, tx, ty, tz);

        PolyhedronsSet poly;
        try {
            poly = new PolyhedronsSet(facets);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        double reportedSize;
        Vector3D reportedBarycenter;
        try {
            reportedSize = poly.getSize();
            reportedBarycenter = (Vector3D) poly.getBarycenter();
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        // Contract/metamorphic check:
        // The same closed boundary represented by the same facets in a different order
        // denotes the same polyhedron, so size and barycenter must agree.
        // A patch that merely suppresses the crash or skips bookkeeping in
        // computeGeometricalProperties can violate this observable invariant.
        ArrayList<SubHyperplane<Euclidean3D>> reversed = new ArrayList<SubHyperplane<Euclidean3D>>(facets);
        Collections.reverse(reversed);

        try {
            PolyhedronsSet polyReordered = new PolyhedronsSet(reversed);
            double reorderedSize = polyReordered.getSize();
            Vector3D reorderedBarycenter = (Vector3D) polyReordered.getBarycenter();

            if (!closeEnough(reportedSize, reorderedSize, 1.0e-8, 1.0e-8)) {
                throw new RuntimeException(
                        "[oracle:facet-order-size] metamorphic violation: reordered boundary changed size"
                                + " scale=" + scale
                                + " epsilon=" + epsilon
                                + " t=(" + tx + "," + ty + "," + tz + ")"
                                + " lhs=" + reportedSize
                                + " rhs=" + reorderedSize);
            }
            if (!samePoint(reportedBarycenter, reorderedBarycenter, 1.0e-8, 1.0e-8)) {
                throw new RuntimeException(
                        "[oracle:facet-order-barycenter] metamorphic violation: reordered boundary changed barycenter"
                                + " scale=" + scale
                                + " epsilon=" + epsilon
                                + " t=(" + tx + "," + ty + "," + tz + ")"
                                + " lhs=" + format(reportedBarycenter)
                                + " rhs=" + format(reorderedBarycenter));
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static ArrayList<SubHyperplane<Euclidean3D>> buildCubeLikeBoundary(
            double scale, double epsilon, double tx, double ty, double tz) {
