            if (series.getIndex(series.getTimePeriod(i)) != i) {
                throw new RuntimeException(
                        "[oracle:view-consistency] metamorphic violation: getIndex/getTimePeriod disagree"
                                + " tag=" + tag
                                + " index=" + i
                                + " roundTrip=" + series.getIndex(series.getTimePeriod(i)));
            }
        }
    }

    private static void assertEquivalentSeries(TimeSeries a, TimeSeries b, String tag) {
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                    "[oracle:equivalent-series] metamorphic violation: item counts differ"
                            + " tag=" + tag
                            + " leftCount=" + a.getItemCount()
