        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException || t instanceof MathIllegalArgumentException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("Parse") || name.contains("Format");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(method) || "getVertices".equals(method))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cls)
                    && ("getSize".equals(method) || "getBarycenter".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean nearlyEqual(double a, double b, double rel, double abs) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double diff = Math.abs(a - b);
        double scale = Math.max(Math.abs(a), Math.abs(b));
        return diff <= abs + rel * scale;
    }

    private static boolean samePoint(Vector3D a, Vector3D b, double rel, double abs) {
        return nearlyEqual(a.getX(), b.getX(), rel, abs)
            && nearlyEqual(a.getY(), b.getY(), rel, abs)
            && nearlyEqual(a.getZ(), b.getZ(), rel, abs);
    }

    private static double consumeFiniteDouble(FuzzedDataProvider data, double min, double max) {
        int raw = data.consumeInt();
        double unit = (raw & 0x7fffffff) / (double) Integer.MAX_VALUE;
        double v = min + (max - min) * unit;
        if (Double.isNaN(v) || Double.isInfinite(v)) {
            return min;
        }
        return v;
    }

    private static float f(double d) {
        if (Double.isNaN(d)) {
            return 0.0f;
        }
        if (d > Float.MAX_VALUE) {
            return Float.MAX_VALUE;
        }
        if (d < -Float.MAX_VALUE) {
            return -Float.MAX_VALUE;
        }
        return (float) d;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
