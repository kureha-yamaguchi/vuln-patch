    private static String buildLen3StartingWithT(FuzzedDataProvider data) {
        char first = data.consumeBoolean() ? 't' : 'T';
        String tail = data.consumeAsciiString(2);
        tail = padToLength(tail, 2, 'x');
        if (tail.length() > 2) {
            tail = tail.substring(0, 2);
        }
        return new String(new char[] { first, tail.charAt(0), tail.charAt(1) });
    }

    private static String chooseToken(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 2)) {
            case 0:
                return "true";
            case 1:
                return "yes";
            default:
                return "on";
        }
    }

    private static String randomizeAsciiCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (isAsciiLetter(chars[i]) && data.consumeBoolean()) {
                chars[i] = flipAsciiLetter(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String mutateAwayFromToken(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        int idx = data.consumeInt(0, chars.length - 1);
        char replacement = (char) ('a' + data.consumeInt(0, 25));
        if (equalsIgnoreAsciiCase(chars[idx], replacement)) {
            replacement = chars[idx] == 'z' || chars[idx] == 'Z' ? 'a' : 'z';
        }
        chars[idx] = replacement;
        return new String(chars);
    }

    private static String flipAsciiCase(String s) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = flipAsciiLetter(chars[i]);
        }
        return new String(chars);
    }

    private static char flipAsciiLetter(char c) {
        if (c >= 'a' && c <= 'z') {
            return (char) (c - ('a' - 'A'));
        }
        if (c >= 'A' && c <= 'Z') {
            return (char) (c + ('a' - 'A'));
        }
        return c;
    }

    private static boolean isAsciiLetter(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }

    private static boolean equalsIgnoreAsciiCase(char a, char b) {
        return flipAsciiLetter(a) == flipAsciiLetter(b) || a == b;
    }

    private static String padToLength(String s, int len, char pad) {
        String out = s;
        while (out.length() < len) {
            out = out + pad;
        }
        return out;
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
