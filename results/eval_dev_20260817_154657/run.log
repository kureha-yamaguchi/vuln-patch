                    Number rhs = NumberUtils.createNumber(expZero);
                    if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                        throw new RuntimeException("[oracle:exp-zero-identity] metamorphic violation: exponent zero changed numeric value base="
                                + (base + suffix) + " expZero=" + expZero + " lhs=" + lhs + " rhs=" + rhs);
                    }
                } catch (RuntimeException t) {
                    if (isOracleFailure(t)) {
                        throw t;
                    }
                    return;
                }
            }

            /* Contract used below:
             * createNumber returns a Number whose toString() is a canonical textual form of that value.
             * Reparsing that canonical form must yield the same numeric quantity.
             */
            void checkRoundTripConsistency(String s) {
