private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "[oracle:right-boundary-present] consistency violation: right boundary period must exist"
                            + " right=" + exactRight
                            + " rightIndex=" + rightIndex);
        }

        try {
            TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
            TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

            checkSeriesViewConsistency(byBoundary, "boundary-right-by-boundary");
            checkSeriesViewConsistency(byIndex, "boundary-right-by-index");
            assertEquivalentSeries(byBoundary, byIndex, "boundary-right");
        } catch (RuntimeException e) {
            if (isCleanValidationFromPatchedRegion(e)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:boundary-step-right] metamorphic violation: stepping the end to an exact present right boundary must yield its singleton"
                                + " absentStart=" + absentStart
                                + " exactRight=" + exactRight
                                + " rightIndex=" + rightIndex,
                        e);
            }
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }
