public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            int baseEpochDay = data.consumeInt(12000, 22000);
            int beforeCount = data.consumeInt(0, 5);
            int afterCount = data.consumeInt(0, 5);
            int gapSize = data.consumeInt(1, 40);

            int leftEpochDay = baseEpochDay + beforeCount;
            int rightEpochDay = leftEpochDay + gapSize + 1;

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(dayFromEpochDay(leftEpochDay - i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(dayFromEpochDay(leftEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(dayFromEpochDay(rightEpochDay), Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(dayFromEpochDay(rightEpochDay + i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            try {
                checkSeriesViewConsistency(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);

            Day start = dayFromEpochDay(leftEpochDay + startOffset);
            Day end = dayFromEpochDay(leftEpochDay + endOffset);
            if (start.compareTo(end) > 0) {
                return;
            }

            int manualCount = 0;
            try {
                for (int i = 0; i < series.getItemCount(); i++) {
                    RegularTimePeriod p = series.getTimePeriod(i);
                    if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                        manualCount++;
                    }
                }
            } catch (RuntimeException e) {
                return;
            }

            if (manualCount != 0) {
                throw new RuntimeException("[oracle:constructed-gap] metamorphic violation: chosen range must lie strictly inside a real gap"
                        + " manualCount=" + manualCount
                        + " start=" + start
                        + " end=" + end);
            }

            int rawStartIndex;
            int rawEndIndex;
            try {
                rawStartIndex = series.getIndex(start);
                rawEndIndex = series.getIndex(end);
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:index-valid] metamorphic violation: getIndex on valid absent periods should not fail", e);
                }
                return;
            }

            if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
                throw new RuntimeException("[oracle:gap-absent] metamorphic violation: both gap endpoints must be absent"
                        + " rawStartIndex=" + rawStartIndex
                        + " rawEndIndex=" + rawEndIndex
                        + " start=" + start
                        + " end=" + end);
            }

            try {
                TimeSeries copy = series.createCopy(start, end);

                /*
                 * Contract asserted:
                 * - TimeSeries(Comparable,...) creates an empty series backed by data.
                 * - getItemCount(), getItems(), getTimePeriods(), and getDataItem() are coupled views of the same data.
                 * - createCopy(start,end) returns the inclusive subseries; for a valid range wholly inside a real gap,
                 *   the correct result is an empty series.
                 * A throw-deleting or guard-skipping patch can avoid the known exception yet still return a wrong/non-empty
                 * copy or inconsistent state, so we cross-check those observable views.
                 */
                checkSeriesViewConsistency(copy, "copy");

                if (copy.getItemCount() != 0) {
                    throw new RuntimeException("[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex
                            + " start=" + start
                            + " end=" + end);
                }

                Day innerStart = start;
                Day innerEnd = end;
                if (startOffset < endOffset) {
                    int innerStartOffset = data.consumeInt(startOffset, endOffset);
                    int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
                    innerStart = dayFromEpochDay(leftEpochDay + innerStartOffset);
                    innerEnd = dayFromEpochDay(leftEpochDay + innerEndOffset);
                }

                TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
                checkSeriesViewConsistency(innerCopy, "innerCopy");

                if (innerCopy.getItemCount() != copy.getItemCount()
                        || innerCopy.getItems().size() != copy.getItems().size()
                        || innerCopy.getTimePeriods().size() != copy.getTimePeriods().size()) {
                    throw new RuntimeException("[oracle:subgap-agree] metamorphic violation: two valid subranges within the same gap must both be empty"
                            + " outerCount=" + copy.getItemCount()
                            + " innerCount=" + innerCopy.getItemCount()
                            + " outerItems=" + copy.getItems().size()
                            + " innerItems=" + innerCopy.getItems().size()
                            + " outerPeriods=" + copy.getTimePeriods().size()
                            + " innerPeriods=" + innerCopy.getTimePeriods().size()
                            + " outer=[" + start + "," + end + "]"
                            + " inner=[" + innerStart + "," + innerEnd + "]");
                }

                Day exactRight = dayFromEpochDay(rightEpochDay);
                Day exactLeft = dayFromEpochDay(leftEpochDay);
                checkBoundaryStepRight(series, start, exactRight);
                checkBoundaryStepLeft(series, exactLeft, end);

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                checkSeriesViewConsistency(byPeriod, "byPeriod");
                checkSeriesViewConsistency(byIndex, "byIndex");

                if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                    throw new RuntimeException("[oracle:overload-count] metamorphic violation: createCopy overloads must agree on singleton size"
                            + " chosen=" + chosen
                            + " byPeriodCount=" + byPeriod.getItemCount()
                            + " byIndexCount=" + byIndex.getItemCount());
                }
                if (byPeriod.getItemCount() == 1 && byIndex.getItemCount() == 1) {
                    if (!byPeriod.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
                        throw new RuntimeException("[oracle:overload-period] metamorphic violation: createCopy overloads must copy the same period"
                                + " chosen=" + chosen
                                + " byPeriod=" + byPeriod.getTimePeriod(0)
                                + " byIndex=" + byIndex.getTimePeriod(0));
                    }
                    Number vp = byPeriod.getValue(0);
                    Number vi = byIndex.getValue(0);
                    if (vp == null ? vi != null : !vp.equals(vi)) {
                        throw new RuntimeException("[oracle:overload-value] metamorphic violation: createCopy overloads must copy the same value"
                                + " chosen=" + chosen
                                + " byPeriodValue=" + vp
                                + " byIndexValue=" + vi);
                    }
                }
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException("[oracle:valid-empty-gap] metamorphic violation: valid empty-gap createCopy must not reject ordered non-null periods"
                            + " start=" + start
                            + " end=" + end
                            + " rawStartIndex=" + rawStartIndex
                            + " rawEndIndex=" + rawEndIndex, e);
                }
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }
        }
    }
