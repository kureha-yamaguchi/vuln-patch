    private static void probe(String text, String[] searchList, String[] replacementList, boolean checkOracle) {
        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isValidation(t)) {
                return;
            }
            if (isPatchedRegionNpe(t)) {
                throw t;
            }
            return;
        }

        if (!checkOracle) {
            return;
        }

        int kept = 0;
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] != null && StringUtils.length(searchList[i]) != 0 && replacementList[i] != null) {
                kept++;
            }
        }

        String[] filteredSearch = new String[kept];
        String[] filteredReplacement = new String[kept];
        int out = 0;
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] != null && StringUtils.length(searchList[i]) != 0 && replacementList[i] != null) {
                filteredSearch[out] = searchList[i];
                filteredReplacement[out] = replacementList[i];
                out++;
            }
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException t) {
            return;
        }

        /* Contract exercised by the regression tests and visible in replaceEach:
           entries with null search strings, empty search strings, or null replacement strings are skipped.
           Therefore removing those inert pairs must not change the observable result.
           A throw-deleting or overfit patch that merely avoids the old NPE but mishandles such entries
           will violate this equivalence. */
        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "[oracle:null-pair-filter] metamorphic violation: replaceEach result changed after removing inert pairs"
                    + " text=" + String.valueOf(text)
                    + " lhs=" + String.valueOf(lhs)
                    + " rhs=" + String.valueOf(rhs));
        }
    }

    private static boolean isValidation(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isPatchedRegionNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "replaceEach".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
