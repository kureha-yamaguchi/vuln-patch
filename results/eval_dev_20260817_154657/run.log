package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseBugShape("12e3E4");

        String prefix = digitsOfLength(data, 2, 8);
        String middle = digitsOfLength(data, 1, 4);
        int suffixMax = Math.max(1, prefix.length() - 1);
        String suffix = digitsOfLength(data, 1, suffixMax);
        exerciseBugShape(prefix + "e" + middle + "E" + suffix);

        checkExponentCaseEquivalence(data);
    }

    private static void exerciseBugShape(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (IllegalArgumentException expectedCleanRejectOnFixed) {
            return;
        }
    }

    /*
     * Contract used for this oracle:
     * 'e' and 'E' are equivalent exponent markers for the same scientific-notation number.
     * A correct implementation must parse both forms to the same numeric value.
     * This catches wrong-output fixes that merely avoid the buggy substring path.
     */
    private static void checkExponentCaseEquivalence(FuzzedDataProvider data) {
        String sign = data.consumeBoolean() ? "-" : "";
        String intPart = digitsOfLength(data, 1, 6);
        String fracPart = digitsOfLength(data, 1, 3);
        String expSign = data.consumeBoolean() ? "-" : "";
        String expPart = digitsOfLength(data, 1, 2);

        String lower = sign + intPart + "." + fracPart + "e" + expSign + expPart;
        String upper = sign + intPart + "." + fracPart + "E" + expSign + expPart;

        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException ignored) {
            return;
        }
    }

    private static String digitsOfLength(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        String raw = data.consumeAsciiString(len);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < raw.length() && sb.length() < len; i++) {
            char c = raw.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            } else {
                sb.append((char) ('0' + (c & 0x7)));
            }
        }
        while (sb.length() < len) {
            sb.append('1');
        }
        return sb.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        return new BigDecimal(a.toString()).compareTo(new BigDecimal(b.toString())) == 0;
    }
}
