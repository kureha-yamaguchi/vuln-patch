        for (int i = 0; i < anchors.length; i++) {
            exerciseMalformed(anchors[i]);
        }

        for (int i = 0; i < 16; i++) {
            String probe;
            switch (data.consumeInt(0, 11)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = (data.consumeBoolean() ? "+" : "-") + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "." + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "e" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 9:
                    probe = "0x" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 10:
                    probe = data.consumeAsciiString(3);
                    break;
                default:
                    probe = data.consumeString(4);
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String digits = buildDigits(data, 1, 18, false);
            String numeric = "+" + digits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);
                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");

                /*
                 * Contract from createNumber's shown "requesting a specific type" long-suffix branch:
                 * for a valid signed decimal integer with L/l suffix, createNumber must parse the same
                 * numeric payload as createLong(numeric), and lowercase/uppercase suffixes must agree.
                 * A band-aid that merely avoids the singleton crash by skipping or over-restricting the
                 * l/L branch would reject or mis-handle these neighboring boundary inputs.
                 */
                if (!(explicit instanceof Long)
                        || !(lower instanceof Long)
                        || !(upper instanceof Long)
                        || helper == null
                        || unsuffixed == null
                        || explicit.longValue() != helper.longValue()
                        || lower.longValue() != helper.longValue()
                        || upper.longValue() != helper.longValue()
                        || unsuffixed.longValue() != helper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-long-agreement] metamorphic violation: createNumber(+digits+L/l) must agree with createLong(+digits) and unsuffixed createNumber input="
                                    + suffixed + " explicit=" + explicit + " lower=" + lower + " upper=" + upper
                                    + " helper=" + helper + " unsuffixed=" + unsuffixed);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
        }

        {
            String overflowDigits = buildOverflowDigits(data);
            String numeric = "+" + overflowDigits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                BigInteger helper = NumberUtils.createBigInteger(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * Contract from createNumber's shown l/L branch:
                 * if createLong(numeric) overflows, the branch falls back to createBigInteger(numeric).
                 * Therefore explicit-L parsing and unsuffixed parsing of the same valid integral decimal
                 * must both preserve the exact BigInteger value.
                 */
                if (!(explicit instanceof BigInteger)
                        || !(unsuffixed instanceof BigInteger)
                        || helper == null
                        || !helper.equals(explicit)
                        || !helper.equals(unsuffixed)) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-overflow-fallback] metamorphic violation: createNumber(+overflowDigits+L/l) and createNumber(+overflowDigits) must agree with createBigInteger input="
                                    + suffixed + " explicit=" + explicit + " unsuffixed=" + unsuffixed
                                    + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
        }

        {
            String core = buildDigits(data, 1, 6, false);
            String lowerInput = core + "l";
            String upperInput = core + "L";
            try {
                Number lower = NumberUtils.createNumber(lowerInput);
                Number upper = NumberUtils.createNumber(upperInput);

                /*
                 * Contract from the same switch branch: case 'l' and case 'L' execute the same logic.
                 * Therefore for identical valid decimal payloads, only changing suffix case must not
                 * change the numeric result or chosen type.
                 */
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || lower.longValue() != upper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:long-suffix-case-equivalence] metamorphic violation: decimal+l and decimal+L must agree inputLower="
                                    + lowerInput + " inputUpper=" + upperInput + " lower=" + lower + " upper=" + upper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
        }
    }
