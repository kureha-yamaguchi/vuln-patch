package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(true, false, 0.0, 0.0, true);
        runCase(false, true, 0.0, 0.0, true);

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            boolean plus = data.consumeBoolean();
            boolean minus = data.consumeBoolean();
            double x0 = data.consumeInt(-1000, 1000);
            double y0 = data.consumeInt(-1000, 1000);
            double x1 = data.consumeInt(-1000, 1000);
            double y1 = data.consumeInt(-1000, 1000);
            if (x0 == x1 && y0 == y1) {
                x1 = x0 + 1.0;
            }
            runCase(plus, minus, x0, y0, x1, y1, true);
        }
    }

    private static void runCase(boolean plusAttr, boolean minusAttr, double x0, double y0, boolean validByConstruction) {
        runCase(plusAttr, minusAttr, x0, y0, x0 + 1.0, y0, validByConstruction);
    }

    private static void runCase(boolean plusAttr, boolean minusAttr,
                                double x0, double y0, double x1, double y1,
                                boolean validByConstruction) {
        try {
            PolygonsSet first = buildPolygon(plusAttr, minusAttr, x0, y0, x1, y1);
            exerciseAndCheck(first, plusAttr);

            PolygonsSet second = buildPolygon(plusAttr, minusAttr, x0, y0, x1, y1);
            double s1 = first.getSize();
            double s2 = second.getSize();
            Vector2D b1 = first.getBarycenter();
            Vector2D b2 = second.getBarycenter();

            if (!(sameDouble(s1, s2) && sameVector(b1, b2))) {
                throw new RuntimeException("[oracle:stable-rebuild] metamorphic violation: identically constructed polygons disagree"
                        + " plus=" + plusAttr + " minus=" + minusAttr
                        + " line=(" + x0 + "," + y0 + ")->(" + x1 + "," + y1 + ")"
                        + " size1=" + s1 + " size2=" + s2
                        + " bary1=" + vectorToString(b1) + " bary2=" + vectorToString(b2));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && ((RuntimeException) t).getMessage() != null
                    && ((RuntimeException) t).getMessage().startsWith("[oracle:")) {
                throw (RuntimeException) t;
            }
            if (validByConstruction && isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static PolygonsSet buildPolygon(boolean plusAttr, boolean minusAttr,
                                            double x0, double y0, double x1, double y1) {
        Line line = new Line(new Vector2D(x0, y0), new Vector2D(x1, y1));
        SubHyperplane<Euclidean2D> cut = line.wholeHyperplane();
        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.valueOf(plusAttr));
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.valueOf(minusAttr));
        BoundaryAttribute<Euclidean2D> boundary = new BoundaryAttribute<Euclidean2D>(null, null, null);
        BSPTree<Euclidean2D> tree = new BSPTree<Euclidean2D>(cut, plus, minus, boundary);
        return new PolygonsSet(tree);
    }

    private static void exerciseAndCheck(PolygonsSet polygon, boolean expectedWholeSpace) {
        Vector2D[][] vertices = polygon.getVertices();
        if (vertices.length != 0) {
            return;
        }

        double size1 = polygon.getSize();
        Vector2D bary1 = polygon.getBarycenter();
        double size2 = polygon.getSize();
        Vector2D bary2 = polygon.getBarycenter();

        if (!(sameDouble(size1, size2) && sameVector(bary1, bary2))) {
            throw new RuntimeException("[oracle:idempotent-cache] metamorphic violation: repeated queries disagree"
                    + " size1=" + size1 + " size2=" + size2
                    + " bary1=" + vectorToString(bary1) + " bary2=" + vectorToString(bary2));
        }

        /*
         * Contract visible in computeGeometricalProperties():
         * when getVertices().length == 0, the method must set
         *   - whole space: size = +Inf, barycenter = NaN
         *   - empty region: size = 0, barycenter = (0,0)
         * A patch that only suppresses the ClassCastException or skips the bookkeeping
         * would violate these observable post-conditions.
         */
        if (expectedWholeSpace) {
            if (!Double.isInfinite(size1) || !Double.isNaN(bary1.getX()) || !Double.isNaN(bary1.getY())) {
                throw new RuntimeException("[oracle:empty-vertices-whole] metamorphic violation: wrong whole-space properties"
                        + " size=" + size1 + " bary=" + vectorToString(bary1));
            }
        } else {
            if (Double.doubleToLongBits(size1) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(bary1.getX()) != Double.doubleToLongBits(0.0)
                    || Double.doubleToLongBits(bary1.getY()) != Double.doubleToLongBits(0.0)) {
                throw new RuntimeException("[oracle:empty-vertices-empty] metamorphic violation: wrong empty-region properties"
                        + " size=" + size1 + " bary=" + vectorToString(bary1));
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException || t instanceof MathIllegalArgumentException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("Invalid") || n.contains("Parse") || n.contains("Format");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(e.getClassName())
                    && ("computeGeometricalProperties".equals(e.getMethodName())
                    || "getVertices".equals(e.getMethodName())
                    || "getSize".equals(e.getMethodName())
                    || "getBarycenter".equals(e.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b)
                || (Double.isNaN(a) && Double.isNaN(b));
    }

    private static String vectorToString(Vector2D v) {
        return "(" + v.getX() + "," + v.getY() + ")";
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
