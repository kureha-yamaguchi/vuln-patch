    private static String toDigits(String s, boolean allowEmpty) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0 && !allowEmpty) {
            return "1";
        }
        return sb.toString();
    }

    private static String maybePadLeadingZeros(String digits, int zeros) {
        StringBuilder sb = new StringBuilder(zeros + digits.length());
