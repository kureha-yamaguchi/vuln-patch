public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryExercise(0.999999d, false, 0);
        tryExercise(0.999999d, true, 1);

        int variants = 1 + data.consumeInt(1, 8);
        for (int i = 0; i < variants; i++) {
            double tweak;
            if (data.consumeBoolean()) {
                int scaled = data.consumeInt(-1000, 1000);
                tweak = 1.0d + (scaled / 1000000.0d);
            } else {
                int scaled = data.consumeInt(-100000, 100000);
                tweak = scaled / 100000.0d;
            }
            boolean reverse = data.consumeBoolean();
            int rotation = data.consumeInt(0, 2);
            tryExercise(tweak, reverse, rotation);
        }
    }

    private static void tryExercise(double tweak, boolean reverseFacetOrder, int triangleRotation) {
        try {
            exercise(tweak, reverseFacetOrder, triangleRotation);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static void exercise(double tweak, boolean reverseFacetOrder, int triangleRotation) {
        PolyhedronsSet a = buildPolyhedron(tweak, reverseFacetOrder, triangleRotation);
        double sizeA = a.getSize();
        Vector3D baryA = asVector3D(a.getBarycenter());

        PolyhedronsSet b = buildPolyhedron(tweak, !reverseFacetOrder, (triangleRotation + 1) % 3);
        double sizeB = b.getSize();
        Vector3D baryB = asVector3D(b.getBarycenter());

        if (Double.isFinite(sizeA) && Double.isFinite(sizeB)) {
            double tol = 1.0e-7 * Math.max(1.0d, Math.max(Math.abs(sizeA), Math.abs(sizeB)));
            if (Math.abs(sizeA - sizeB) > tol) {
                throw new RuntimeException("[oracle:perm-inv] metamorphic violation: equivalent facet decompositions changed volume input="
                        + tweak + "," + reverseFacetOrder + "," + triangleRotation + " lhs=" + sizeA + " rhs=" + sizeB);
            }
        }

        if (isFinite(baryA) && isFinite(baryB)) {
            double dist = baryA.distance(baryB);
            if (dist > 1.0e-6) {
                throw new RuntimeException("[oracle:bary-inv] metamorphic violation: equivalent facet decompositions changed barycenter input="
                        + tweak + "," + reverseFacetOrder + "," + triangleRotation + " lhs=" + baryA + " rhs=" + baryB);
            }
        }
    }

    private static PolyhedronsSet buildPolyhedron(double tweak, boolean reverseFacetOrder, int triangleRotation) {
        Vector3D[] v = new Vector3D[] {
            new Vector3D(1.0d, -1.0d, -1.0d),
            new Vector3D(1.0d, -1.0d,  1.0d),
            new Vector3D(-1.0d, -1.0d, 1.0d),
            new Vector3D(-1.0d, -1.0d, -1.0d),
            new Vector3D(1.0d,  1.0d, -1.0d),
            new Vector3D(tweak, 1.0d,  1.0d),
            new Vector3D(-1.0d, 1.0d,  1.0d),
            new Vector3D(-1.0d, 1.0d, -1.0d)
        };

        int[] indices = new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        if (reverseFacetOrder) {
            for (int i = indices.length - 3; i >= 0; i -= 3) {
                facets.add(buildFacet(v, indices[i], indices[i + 1], indices[i + 2], triangleRotation));
            }
        } else {
            for (int i = 0; i < indices.length; i += 3) {
                facets.add(buildFacet(v, indices[i], indices[i + 1], indices[i + 2], triangleRotation));
            }
        }
        return new PolyhedronsSet((Collection<SubHyperplane<Euclidean3D>>) facets);
    }

    private static SubHyperplane<Euclidean3D> buildFacet(Vector3D[] vertices, int ia, int ib, int ic, int rotation) {
        Vector3D a = vertices[ia];
        Vector3D b = vertices[ib];
        Vector3D c = vertices[ic];

        if (rotation == 1) {
            Vector3D t = a;
            a = b;
            b = c;
            c = t;
        } else if (rotation == 2) {
            Vector3D t = a;
            a = c;
            c = b;
            b = t;
        }

        Plane plane = new Plane(a, b, c);
        Vector2D[] p = new Vector2D[] {
            plane.toSubSpace(a),
            plane.toSubSpace(b),
            plane.toSubSpace(c)
        };
        return new SubPlane(plane, new PolygonsSet(1.0e-10, p));
    }

