import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exerciseEscapeCsv(s, true, true);
        }

        String fuzz = buildValidCsvSafeStringWithSurrogatePair(data);
        if (fuzz != null) {
            exerciseEscapeCsv(fuzz, true, true);
        }

        String maybeAny = data.consumeString(32);
        if (maybeAny != null && maybeAny.length() > 0) {
            exerciseEscapeCsv(maybeAny, false, false);
        }
    }

    private static void exerciseEscapeCsv(String input, boolean validByConstruction, boolean checkOracle) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            if (checkOracle) {
                /*
                 * Contract asserted:
                 * StringEscapeUtils.escapeCsv "Returns a String value for a CSV column enclosed in double quotes, if required."
                 * Therefore, for inputs containing none of comma, double-quote, CR, or LF, escaping is not required and
                 * the output must equal the input. Our generated/anchor strings are built to satisfy that precondition
                 * and are non-empty; a throw-deleting or branch-skipping patch that silently drops characters would violate it.
                 */
                if (!input.equals(escaped)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for CSV-safe non-empty input input="
                            + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
                }

                /*
                 * Additional metamorphic relation:
                 * For any correctly escaped CSV string, unescapeCsv(escapeCsv(x)) == x.
                 * Both sides use real library calls. If either side throws, the check is skipped by the surrounding catch.
                 */
                String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
                if (!input.equals(roundTrip)) {
                    throw new RuntimeException("[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) must equal x input="
                            + printable(input) + " lhs=" + printable(roundTrip) + " rhs=" + printable(input));
                }
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (t.getClass().getName().contains("Invalid") || t.getClass().getName().contains("Validation")) {
