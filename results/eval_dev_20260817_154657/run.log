package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String activeSearch = nonEmptyAscii(data.consumeAsciiString(8), "a");
        String activeReplacement = data.consumeAsciiString(8);

        String prefix = data.consumeString(12);
        String middle = data.consumeString(12);
        String suffix = data.consumeString(12);
        String text = prefix + activeSearch + middle + activeSearch + suffix;

        int size = data.consumeInt(2, 5);
        String[] searchList = new String[size];
        String[] replacementList = new String[size];

        int activeIndex = data.consumeInt(0, size - 1);
        int invalidIndex = data.consumeInt(0, size - 1);
        if (invalidIndex == activeIndex) {
            invalidIndex = (invalidIndex + 1) % size;
        }

        searchList[activeIndex] = activeSearch;
        replacementList[activeIndex] = activeReplacement;

        for (int i = 0; i < size; i++) {
            if (i == activeIndex || i == invalidIndex) {
                continue;
            }
            int kind = data.consumeInt(0, 4);
            if (kind == 0) {
                searchList[i] = null;
                replacementList[i] = data.consumeBoolean() ? data.consumeAsciiString(6) : null;
            } else if (kind == 1) {
                searchList[i] = "";
                replacementList[i] = data.consumeBoolean() ? data.consumeAsciiString(6) : null;
            } else if (kind == 2) {
                searchList[i] = nonEmptyAscii(data.consumeAsciiString(6), "b");
                replacementList[i] = null;
            } else {
                searchList[i] = nonEmptyAscii(data.consumeAsciiString(6), "b");
                replacementList[i] = data.consumeAsciiString(6);
            }
        }

        int invalidKind = data.consumeInt(0, 2);
        if (invalidKind == 0) {
            searchList[invalidIndex] = null;
            replacementList[invalidIndex] = data.consumeAsciiString(6);
        } else if (invalidKind == 1) {
            searchList[invalidIndex] = "";
            replacementList[invalidIndex] = data.consumeAsciiString(6);
        } else {
            searchList[invalidIndex] = nonEmptyAscii(data.consumeAsciiString(6), "z");
            replacementList[invalidIndex] = null;
        }

        exerciseAndCheck(text, searchList, replacementList);
    }

    private static void runAnchorCases() {
        exerciseAndCheck("aba", new String[] { "a" }, new String[] { null });
        exerciseAndCheck("aba", new String[] { "a", "b" }, new String[] { "c", null });
        exerciseAndCheck("aba", new String[] { null }, new String[] { "a" });
        exerciseAndCheck(null, new String[] { "a" }, new String[] { "b" });
        exerciseAndCheck("aba", new String[] { "a" }, null);
    }

    private static void exerciseAndCheck(String text, String[] searchList, String[] replacementList) {
        boolean validByConstruction = isValidByConstruction(text, searchList, replacementList);

        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (shouldPropagate(t, validByConstruction)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        String[] filteredSearch;
        String[] filteredReplacement;
        try {
            filteredSearch = filterSearch(searchList, replacementList);
            filteredReplacement = filterReplacement(searchList, replacementList);
        } catch (RuntimeException t) {
            return;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException t) {
            return;
        }

        /* Contract/oracle:
         * The shown code and tests treat pairs with null search, empty search, or null replacement as ignored.
         * Therefore removing all ignored pairs before calling the public API must not change the result for any
         * correct implementation. A throw-deleting or branch-skipping patch can violate this even if no NPE occurs.
         */
        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:filter-ignore] metamorphic violation: replaceEach should ignore null/empty search pairs and null replacements"
                    + " text=" + String.valueOf(text)
                    + " lhs=" + String.valueOf(lhs)
                    + " rhs=" + String.valueOf(rhs)
                    + " search=" + ArrayUtils.toString(searchList)
                    + " replacement=" + ArrayUtils.toString(replacementList)
                    + " filteredSearch=" + ArrayUtils.toString(filteredSearch)
                    + " filteredReplacement=" + ArrayUtils.toString(filteredReplacement));
        }

        /* Independent consistency check:
         * StringUtils.length(str) is specified as str == null ? 0 : str.length().
         * Recomputing that quantity directly must agree with the library helper.
         */
        int reportedLen = StringUtils.length(lhs);
        int independentLen = lhs == null ? 0 : lhs.length();
        if (reportedLen != independentLen) {
            throw new RuntimeException(
                "[oracle:length-consistency] consistency violation: reportedLen=" + reportedLen
                    + " independentLen=" + independentLen
                    + " result=" + String.valueOf(lhs));
        }
    }

    private static boolean isValidByConstruction(String text, String[] searchList, String[] replacementList) {
        if (text == null) {
            return true;
        }
        if (searchList == null || replacementList == null) {
            return true;
        }
        if (searchList.length != replacementList.length) {
            return false;
        }
        boolean hasTriggeringIgnoredPair = false;
        boolean hasMatchableValidPair = false;
        for (int i = 0; i < searchList.length; i++) {
            String s = searchList[i];
            String r = replacementList[i];
            if (s == null || s.length() == 0 || r == null) {
                hasTriggeringIgnoredPair = true;
            } else if (text.indexOf(s) >= 0) {
                hasMatchableValidPair = true;
            }
        }
        return hasTriggeringIgnoredPair && hasMatchableValidPair;
    }

    private static boolean shouldPropagate(RuntimeException t, boolean validByConstruction) {
        return validByConstruction && (t instanceof NullPointerException) && inReplaceEachStack(t);
    }

    private static boolean inReplaceEachStack(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "replaceEach".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(e.getClassName())
                    && "length".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String[] filterSearch(String[] searchList, String[] replacementList) {
        if (searchList == null || replacementList == null || searchList.length != replacementList.length) {
            return searchList;
        }
        List<String> out = new ArrayList<String>();
        for (int i = 0; i < searchList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                out.add(searchList[i]);
            }
        }
        return out.toArray(new String[out.size()]);
    }

    private static String[] filterReplacement(String[] searchList, String[] replacementList) {
        if (searchList == null || replacementList == null || searchList.length != replacementList.length) {
            return replacementList;
        }
        List<String> out = new ArrayList<String>();
        for (int i = 0; i < replacementList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                out.add(replacementList[i]);
            }
        }
        return out.toArray(new String[out.size()]);
    }

    private static String nonEmptyAscii(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
