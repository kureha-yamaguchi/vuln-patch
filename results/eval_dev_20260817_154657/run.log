package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            Line anchorLine = new Line(new Vector2D(0.0, 0.0), new Vector2D(1.0, 0.0));
            BSPTree<Euclidean2D> anchorTree =
                new BSPTree<Euclidean2D>(
                    anchorLine.wholeHyperplane(),
                    new BSPTree<Euclidean2D>(Boolean.TRUE),
                    new BSPTree<Euclidean2D>(Boolean.FALSE),
                    new BoundaryAttribute<Euclidean2D>(null, null));
            PolygonsSet anchor = new PolygonsSet(anchorTree);
            anchor.getVertices();
            anchor.getSize();
            anchor.getBarycenter();
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                String m = t.getMessage();
                if (m != null && m.startsWith("[oracle:")) {
                    throw (RuntimeException) t;
                }
            }
        }

        double ax = data.consumeInt(-1000, 1000) / 10.0;
        double ay = data.consumeInt(-1000, 1000) / 10.0;
        double dx = data.consumeInt(-1000, 1000) / 10.0;
        double dy = data.consumeInt(-1000, 1000) / 10.0;
        if (dx == 0.0 && dy == 0.0) {
            dx = 1.0;
        }

        try {
            Line line = new Line(new Vector2D(ax, ay), new Vector2D(ax + dx, ay + dy));

            PolygonsSet canonicalFull = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            PolygonsSet canonicalEmpty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));

            BSPTree<Euclidean2D> fullLikeTree =
                new BSPTree<Euclidean2D>(
                    line.wholeHyperplane(),
                    new BSPTree<Euclidean2D>(Boolean.TRUE),
                    new BSPTree<Euclidean2D>(Boolean.FALSE),
                    Boolean.FALSE);

            BSPTree<Euclidean2D> emptyLikeTree =
                new BSPTree<Euclidean2D>(
                    line.wholeHyperplane(),
                    new BSPTree<Euclidean2D>(Boolean.FALSE),
                    new BSPTree<Euclidean2D>(Boolean.FALSE),
                    Boolean.TRUE);

            PolygonsSet fullLike = new PolygonsSet(fullLikeTree);
            PolygonsSet emptyLike = new PolygonsSet(emptyLikeTree);

            Vector2D[][] fullLikeVertices = fullLike.getVertices();
            Vector2D[][] emptyLikeVertices = emptyLike.getVertices();
            if (fullLikeVertices.length != 0 || emptyLikeVertices.length != 0) {
                return;
            }

            /*
             * Contract visible in PolygonsSet.computeGeometricalProperties():
             * when getVertices().length == 0, the result is determined by the region
             * classification, yielding either whole space (size = +INF, barycenter = NaN)
             * or empty space (size = 0, barycenter = (0,0)).
             *
             * We compare the "no-vertex internal tree" cases against independently
             * constructed canonical leaf regions representing full and empty space.
             * A throw-deleting or overfit patch that reads the wrong attribute will
             * silently return the empty-space answer for a full-space case, or vice versa.
             */
            double fullLikeSize = fullLike.getSize();
            Vector2D fullLikeBary = (Vector2D) fullLike.getBarycenter();
            double canonicalFullSize = canonicalFull.getSize();
            Vector2D canonicalFullBary = (Vector2D) canonicalFull.getBarycenter();

            boolean fullSizesAgree =
                (Double.isInfinite(fullLikeSize) && Double.isInfinite(canonicalFullSize)) ||
                Math.abs(fullLikeSize - canonicalFullSize) <= 1.0e-12;
            boolean fullBxAgree =
                (Double.isNaN(fullLikeBary.getX()) && Double.isNaN(canonicalFullBary.getX())) ||
                Math.abs(fullLikeBary.getX() - canonicalFullBary.getX()) <= 1.0e-12;
            boolean fullByAgree =
                (Double.isNaN(fullLikeBary.getY()) && Double.isNaN(canonicalFullBary.getY())) ||
                Math.abs(fullLikeBary.getY() - canonicalFullBary.getY()) <= 1.0e-12;

            if (!(fullSizesAgree && fullBxAgree && fullByAgree)) {
                throw new RuntimeException(
                    "[oracle:full-like] metamorphic violation: no-vertex internal tree with plus=true " +
                    "must match canonical full-space region input=(" + ax + "," + ay + ")->(" +
