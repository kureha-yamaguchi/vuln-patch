package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryBoolean("off", true);

        String fuzz1 = data.consumeAsciiString(8);
        String fuzz2 = buildExactLengthAscii(data, 3);
        String fuzz3 = buildExactLengthAscii(data, 4);

        String[] literals = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue", "TrUE",
            "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes", "yeS", "yEs",
            "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        String fuzz4 = literals[Math.abs(data.consumeInt()) % literals.length];
        String fuzz5 = mutateCase(fuzz4, data.consumeInt());
        String fuzz6 = data.consumeRemainingAsString();

        tryBoolean(fuzz1, false);
        tryBoolean(fuzz2, false);
        tryBoolean(fuzz3, false);
        tryBoolean(fuzz4, false);
        tryBoolean(fuzz5, false);
        tryBoolean(fuzz6, false);

        /* Contract/oracle:
         * The implementation shown explicitly accepts "on", "yes", and "true" in a case-insensitive
         * manner by comparing each character against both upper- and lower-case forms. Therefore any
         * case-variant of these canonical true tokens must evaluate to the same boolean value as the
         * canonical token itself. A patch that merely suppresses the crash by skipping/fencing a branch
         * but returns the wrong value for valid inputs would violate this observable API behavior.
         * Per the hygiene rule, if either side throws, we skip the check.
         */
        String canonical;
        switch (Math.abs(data.consumeInt()) % 3) {
            case 0:
                canonical = "on";
                break;
            case 1:
                canonical = "yes";
                break;
            default:
                canonical = "true";
                break;
        }
        String variant = mutateCase(canonical, data.consumeInt());
        Boolean lhs = safeToBoolean(variant);
        Boolean rhs = safeToBoolean(canonical);
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "[oracle:case-true] metamorphic violation: case-insensitive true-token parsing input="
                    + printable(variant) + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void tryBoolean(String s, boolean anchor) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && (anchor || isValidByConstruction(s))) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t) && (anchor || isValidByConstruction(s))) {
                throw t;
            }
        }
    }

    private static Boolean safeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t) && isValidByConstruction(s)) {
                throwAsUnchecked(t);
            }
            return null;
        }
    }

    private static boolean isValidByConstruction(String s) {
        return s != null;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildExactLengthAscii(FuzzedDataProvider data, int len) {
        String s = data.consumeAsciiString(len);
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < len) {
            int v = data.consumeInt(32, 126);
            sb.append((char) v);
        }
        if (sb.length() > len) {
            sb.setLength(len);
        }
        return sb.toString();
    }

    private static String mutateCase(String s, int mask) {
        if (s == null) {
            return null;
        }
        StringBuilder sb = new StringBuilder(s.length());
        int bits = mask;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            boolean upper = (bits & 1) != 0;
            bits >>>= 1;
            if (upper) {
                sb.append(Character.toUpperCase(c));
            } else {
                sb.append(Character.toLowerCase(c));
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAsUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
