package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchorCases();

        String text = buildTextWithGuaranteedMatch(data);
        String[] originalSearch = buildSearchList(data, text);
        String[] originalReplacement = buildReplacementList(data, originalSearch.length);

        // Explicitly exercise the reachable helper mentioned for this campaign.
        StringUtils.length(text);
        for (int i = 0; i < originalSearch.length; i++) {
            StringUtils.length(originalSearch[i]);
            StringUtils.length(originalReplacement[i]);
        }

        // Contract visible in StringUtils.replaceEach implementation:
        // entries with null search, empty search, or null replacement are skipped by:
        //   if (... || searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) continue;
        // Therefore, replacing with the original arrays must equal replacing after filtering out exactly those inert pairs.
        String[] filteredSearch = new String[originalSearch.length];
        String[] filteredReplacement = new String[originalReplacement.length];
        int kept = 0;
        for (int i = 0; i < originalSearch.length; i++) {
            String s = originalSearch[i];
            String r = originalReplacement[i];
            if (s != null && s.length() != 0 && r != null) {
                filteredSearch[kept] = s;
                filteredReplacement[kept] = r;
                kept++;
            }
        }
        String[] compactSearch = new String[kept];
        String[] compactReplacement = new String[kept];
        for (int i = 0; i < kept; i++) {
            compactSearch[i] = filteredSearch[i];
            compactReplacement[i] = filteredReplacement[i];
        }

        String lhs;
        try {
            lhs = callReplaceEachValid(text, originalSearch, originalReplacement);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        String rhs;
        try {
            rhs = callReplaceEachValid(text, compactSearch, compactReplacement);
        } catch (RuntimeException e) {
            return;
        }

        if (!StringUtils.equals(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:filter-inert] metamorphic violation: replaceEach should ignore null/empty-search or null-replacement pairs"
                    + " text=" + ArrayUtils.toString(text)
                    + " originalSearch=" + ArrayUtils.toString(originalSearch)
                    + " originalReplacement=" + ArrayUtils.toString(originalReplacement)
                    + " filteredSearch=" + ArrayUtils.toString(compactSearch)
                    + " filteredReplacement=" + ArrayUtils.toString(compactReplacement)
                    + " lhs=" + ArrayUtils.toString(lhs)
                    + " rhs=" + ArrayUtils.toString(rhs));
        }

        // Strategy (c): flip the patched condition by varying whether the null replacement sits on
        // the earliest matching entry or only on a later/unused entry. Both cases are valid and must
        // behave as if the inert null-replacement pair were absent.
        String tokenA = guaranteedToken(data, "A");
        String tokenB = guaranteedDifferentToken(data, tokenA, "B");
        String surround = data.consumeAsciiString(8);
        String boundaryText = surround + tokenA + text + tokenB + surround;

        String[] s1 = new String[] { tokenA, tokenB };
        String[] r1 = new String[] { data.consumeAsciiString(4), null };
        String[] s1Filtered = new String[] { tokenA };
        String[] r1Filtered = new String[] { r1[0] };

        compareAgainstFiltered(boundaryText, s1, r1, s1Filtered, r1Filtered);

        String[] s2 = new String[] { tokenA, tokenB };
        String[] r2 = new String[] { null, data.consumeAsciiString(4) };
        String[] s2Filtered = new String[] { tokenB };
        String[] r2Filtered = new String[] { r2[1] };

        compareAgainstFiltered(boundaryText, s2, r2, s2Filtered, r2Filtered);
    }

    private static void runAnchorCases() {
        verifyExpected(null, new String[] { "a" }, new String[] { "b" }, null);
        verifyExpected("aba", null, null, "aba");
        verifyExpected("aba", new String[0], null, "aba");
        verifyExpected("aba", null, new String[0], "aba");
        verifyExpected("aba", new String[] { "a" }, null, "aba");
        verifyExpected("aba", new String[] { null }, new String[] { "a" }, "aba");
        verifyExpected("aba", new String[] { "a" }, new String[] { null }, "aba");
        verifyExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc");
    }

    private static void verifyExpected(String text, String[] search, String[] replacement, String expected) {
        try {
            String actual = StringUtils.replaceEach(text, search, replacement);
            if (!StringUtils.equals(expected, actual)) {
                throw new RuntimeException(
                    "[oracle:anchor] metamorphic violation: unexpected replaceEach result"
                        + " text=" + ArrayUtils.toString(text)
                        + " search=" + ArrayUtils.toString(search)
                        + " replacement=" + ArrayUtils.toString(replacement)
                        + " expected=" + ArrayUtils.toString(expected)
                        + " actual=" + ArrayUtils.toString(actual));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static void compareAgainstFiltered(
        String text,
        String[] originalSearch,
        String[] originalReplacement,
        String[] filteredSearch,
        String[] filteredReplacement) {
        String lhs;
        try {
            lhs = callReplaceEachValid(text, originalSearch, originalReplacement);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException e) {
            return;
        }

        if (!StringUtils.equals(lhs, rhs)) {
            throw new RuntimeException(
                "[oracle:flip-boundary] metamorphic violation: inert null-replacement pair changed result"
                    + " text=" + ArrayUtils.toString(text)
                    + " originalSearch=" + ArrayUtils.toString(originalSearch)
                    + " originalReplacement=" + ArrayUtils.toString(originalReplacement)
                    + " filteredSearch=" + ArrayUtils.toString(filteredSearch)
                    + " filteredReplacement=" + ArrayUtils.toString(filteredReplacement)
                    + " lhs=" + ArrayUtils.toString(lhs)
                    + " rhs=" + ArrayUtils.toString(rhs));
        }
    }

    private static String callReplaceEachValid(String text, String[] search, String[] replacement) {
        try {
            return StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                throw e;
            }
            if (isRootCause(e)) {
                throw e;
            }
            throw e;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }

    private static String buildTextWithGuaranteedMatch(FuzzedDataProvider data) {
        String prefix = data.consumeAsciiString(8);
        String token = guaranteedToken(data, "seed");
        String middle = data.consumeAsciiString(8);
        String suffix = data.consumeRemainingAsString();
        return prefix + token + middle + suffix;
    }

    private static String[] buildSearchList(FuzzedDataProvider data, String text) {
        int n = data.consumeInt(2, 5);
        String[] search = new String[n];

        String guaranteed = substringToken(text);
        search[0] = guaranteed;

        boolean placedEmpty = false;
        boolean placedNull = false;
        for (int i = 1; i < n; i++) {
            int kind = data.consumeInt(0, 4);
            if (kind == 0 && !placedNull) {
                search[i] = null;
                placedNull = true;
            } else if (kind == 1 && !placedEmpty) {
                search[i] = "";
                placedEmpty = true;
            } else if (kind == 2) {
                search[i] = guaranteedDifferentToken(data, guaranteed, "x" + i);
            } else if (kind == 3) {
                search[i] = guaranteed;
            } else {
                search[i] = data.consumeAsciiString(4);
            }
        }
        return search;
    }

    private static String[] buildReplacementList(FuzzedDataProvider data, int n) {
        String[] replacement = new String[n];
        replacement[0] = data.consumeAsciiString(6);

        boolean insertedNull = false;
        for (int i = 1; i < n; i++) {
            if (!insertedNull && data.consumeBoolean()) {
                replacement[i] = null;
                insertedNull = true;
            } else {
                replacement[i] = data.consumeAsciiString(6);
            }
        }
        if (!insertedNull && n > 1) {
            replacement[n - 1] = null;
        }
        return replacement;
    }

    private static String substringToken(String text) {
        if (text == null || text.length() == 0) {
            return "a";
        }
        int len = Math.min(3, text.length());
        String sub = text.substring(0, len);
        if (sub.length() == 0) {
            return "a";
        }
        return sub;
    }

    private static String guaranteedToken(FuzzedDataProvider data, String fallback) {
        String s = data.consumeAsciiString(4);
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static String guaranteedDifferentToken(FuzzedDataProvider data, String other, String fallback) {
        String s = guaranteedToken(data, fallback);
        if (StringUtils.equals(s, other)) {
            s = s + "_";
        }
        if (StringUtils.equals(s, other)) {
            s = fallback + "_";
        }
        return s;
    }
}
