package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runDocumentedNullHandlingOracle();

        String text = data.consumeString(40);
        int n = data.consumeInt(1, 6);

        String[] search = new String[n];
        String[] replacement = new String[n];

        int activeIndex = data.consumeInt(0, n - 1);
        int ignoredIndex = data.consumeInt(0, n - 1);
        if (ignoredIndex == activeIndex) {
            ignoredIndex = (ignoredIndex + 1) % n;
        }

        String activeNeedle = data.consumeAsciiString(6);
        if (activeNeedle.length() == 0) {
            activeNeedle = "A";
        }
        String activeReplacement = data.consumeString(8);

        if (text.length() == 0) {
            text = activeNeedle + data.consumeString(8);
        } else if (text.indexOf(activeNeedle) < 0) {
            int pos = data.consumeInt(0, text.length());
            text = text.substring(0, pos) + activeNeedle + text.substring(pos);
        }

        for (int i = 0; i < n; i++) {
            if (i == activeIndex) {
                search[i] = activeNeedle;
                replacement[i] = activeReplacement;
                continue;
            }
            if (i == ignoredIndex) {
                switch (data.consumeInt(0, 2)) {
                    case 0:
                        search[i] = data.consumeBoolean() ? null : data.consumeAsciiString(4);
                        replacement[i] = null;
                        break;
                    case 1:
                        search[i] = null;
                        replacement[i] = data.consumeString(6);
                        break;
                    default:
                        search[i] = "";
                        replacement[i] = data.consumeString(6);
                        break;
                }
                continue;
            }

            switch (data.consumeInt(0, 4)) {
                case 0:
                    search[i] = null;
                    replacement[i] = data.consumeString(6);
                    break;
                case 1:
                    search[i] = "";
                    replacement[i] = data.consumeString(6);
                    break;
                case 2:
                    search[i] = data.consumeAsciiString(4);
                    replacement[i] = null;
                    break;
                default:
                    search[i] = data.consumeAsciiString(4);
                    replacement[i] = data.consumeString(6);
                    break;
            }
        }

        exerciseFilteredEquivalence(text, search, replacement);
    }

    private static void runDocumentedNullHandlingOracle() {
        checkExpected(null, new String[] { "a" }, new String[] { "b" }, null, "null text returns null");
        checkExpected("aba", null, null, "aba", "null arrays leave text unchanged");
        checkExpected("aba", new String[0], null, "aba", "empty search array leaves text unchanged");
        checkExpected("aba", null, new String[0], "aba", "empty replacement array leaves text unchanged");
        checkExpected("aba", new String[] { "a" }, null, "aba", "null replacement array leaves text unchanged");
        checkExpected("aba", new String[] { null }, new String[] { "a" }, "aba", "null search element is ignored");
        checkExpected("aba", new String[] { "a" }, new String[] { null }, "aba", "null replacement element is ignored");
        checkExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc",
                "documented mixed null replacement handling");
    }

    private static void checkExpected(String text, String[] search, String[] replacement, String expected, String label) {
        try {
            String actual = StringUtils.replaceEach(text, search, replacement);
            checkLengthConsistency(actual, label);
            if (expected == null) {
                if (actual != null) {
                    throw new RuntimeException("[oracle:doc-null-handling] " + label + " expected=null actual=" + actual);
                }
            } else if (!expected.equals(actual)) {
                throw new RuntimeException("[oracle:doc-null-handling] " + label + " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isReplaceEachRootCause(e)) {
                throw new RuntimeException("[oracle:doc-null-handling] valid documented input caused exception for " + label, e);
            }
        }
    }

    private static void exerciseFilteredEquivalence(String text, String[] search, String[] replacement) {
        String[] filteredSearch = filterSearch(search, replacement);
        String[] filteredReplacement = filterReplacement(search, replacement);

        try {
            String lhs = StringUtils.replaceEach(text, search, replacement);
            String rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);

            checkLengthConsistency(lhs, "lhs");
            checkLengthConsistency(rhs, "rhs");

            /*
             * Contract exercised by StringUtils.replaceEach as shown in the library tests and method body:
             * entries with null replacement, null search, or empty search are ignored.
             * Therefore adding or removing only such ignored pairs must not change the observable result.
             * A throw-deleting or bookkeeping-skipping patch could avoid the NPE yet still compute a different result.
             */
            if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
                throw new RuntimeException(
                        "[oracle:filtered-equivalence] ignored entries changed result text=" + text
                                + " lhs=" + lhs + " rhs=" + rhs
                                + " search=" + ArrayUtils.toString(search)
                                + " replacement=" + ArrayUtils.toString(replacement)
                                + " filteredSearch=" + ArrayUtils.toString(filteredSearch)
                                + " filteredReplacement=" + ArrayUtils.toString(filteredReplacement));
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (e.getMessage() != null && e.getMessage().startsWith("[oracle:")) {
                throw e;
            }
            if (isReplaceEachRootCause(e)) {
                return;
            }
        }
    }

    private static void checkLengthConsistency(String s, String label) {
        int reported = StringUtils.length(s);
        int independent = (s == null) ? 0 : s.length();
        if (reported != independent) {
            throw new RuntimeException("[oracle:length-consistency] " + label + " reported=" + reported + " independent=" + independent);
        }
    }

    private static String[] filterSearch(String[] search, String[] replacement) {
        if (search == null || replacement == null) {
            return new String[0];
        }
        int count = 0;
        int len = Math.min(search.length, replacement.length);
        for (int i = 0; i < len; i++) {
            if (search[i] != null && search[i].length() != 0 && replacement[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < len; i++) {
            if (search[i] != null && search[i].length() != 0 && replacement[i] != null) {
                out[j++] = search[i];
            }
        }
        return out;
    }

    private static String[] filterReplacement(String[] search, String[] replacement) {
        if (search == null || replacement == null) {
            return new String[0];
        }
        int count = 0;
        int len = Math.min(search.length, replacement.length);
        for (int i = 0; i < len; i++) {
            if (search[i] != null && search[i].length() != 0 && replacement[i] != null) {
                count++;
            }
        }
        String[] out = new String[count];
        int j = 0;
        for (int i = 0; i < len; i++) {
            if (search[i] != null && search[i].length() != 0 && replacement[i] != null) {
                out[j++] = replacement[i];
            }
        }
        return out;
    }

    private static boolean isReplaceEachRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "replaceEach".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }
}
