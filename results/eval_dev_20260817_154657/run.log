package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30", true, true);
        runCase("\uD800\uDC00", true, true);
        runCase("\uD834\uDD1E", true, true);
        runCase("\uDBFF\uDFFD", true, true);

        String prefix = sanitizeNoCsvMeta(data.consumeAsciiString(16));
        String middle = sanitizeNoCsvMeta(data.consumeAsciiString(16));
        String suffix = sanitizeNoCsvMeta(data.consumeAsciiString(16));

        char high1 = (char) data.consumeInt(0xD800, 0xDBFF);
        char low1 = (char) data.consumeInt(0xDC00, 0xDFFF);
        String pair1 = new String(new char[] { high1, low1 });

        int layout = data.consumeInt(0, 5);
        String validNoMeta;
        switch (layout) {
            case 0:
                validNoMeta = pair1;
                break;
            case 1:
                validNoMeta = prefix + pair1;
                break;
            case 2:
                validNoMeta = pair1 + suffix;
                break;
            case 3:
                validNoMeta = prefix + pair1 + suffix;
                break;
            case 4:
                char high2 = (char) data.consumeInt(0xD800, 0xDBFF);
                char low2 = (char) data.consumeInt(0xDC00, 0xDFFF);
                String pair2 = new String(new char[] { high2, low2 });
                validNoMeta = prefix + pair1 + middle + pair2 + suffix;
                break;
            default:
                validNoMeta = prefix + middle + pair1 + suffix;
                break;
        }

        runCase(validNoMeta, true, true);

        String validWithCsvMeta;
        if (data.consumeBoolean()) {
            validWithCsvMeta = prefix + "," + pair1 + suffix;
        } else if (data.consumeBoolean()) {
            validWithCsvMeta = prefix + "\"" + pair1 + suffix;
        } else if (data.consumeBoolean()) {
            validWithCsvMeta = prefix + "\n" + pair1 + suffix;
        } else {
            validWithCsvMeta = prefix + "\r" + pair1 + suffix;
        }
        runCase(validWithCsvMeta, false, true);

        String extra = data.consumeRemainingAsString();
        if (extra != null && extra.length() > 0) {
            String maybeValid = prefix + pair1 + extra;
            runCase(maybeValid, false, false);
        }
    }

    private static void runCase(String input, boolean assertIdentityForNoCsvMeta, boolean validByConstruction) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);

            /* Contract asserted:
             * CSV escaping leaves strings unchanged when they contain none of the CSV meta characters
             * comma, quote, CR, or LF. We construct such inputs by construction and include at least one
             * valid surrogate pair, so a "fix" that merely skips/breaks surrogate handling will change
             * output and violate this observable post-condition.
             */
            if (assertIdentityForNoCsvMeta && !input.equals(out)) {
                throw new RuntimeException("[oracle:escapecsv-identity] metamorphic violation: escapeCsv must be identity for inputs without CSV meta characters input=" + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        boolean classMatch = t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException;
        if (!classMatch) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeNoCsvMeta(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || Character.isSurrogate(c)) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAsUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
