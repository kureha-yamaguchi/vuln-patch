package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String validScientific = buildValidScientific(data);
        checkEquivalentScientificExponentCase(validScientific, validScientific.replace('e', 'E'));
        checkRoundTripConsistency(validScientific);

        String pathological = buildDualExponentMarkerInput(data);
        exerciseCreateNumber(pathological, false);

        if (data.consumeBoolean()) {
            String noDecimalPathological = buildNoDecimalDualExponentMarkerInput(data);
            exerciseCreateNumber(noDecimalPathological, false);
        }
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkRoundTripConsistency(String s) {
        try {
            Number first = NumberUtils.createNumber(s);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number reparsed = NumberUtils.createNumber(canonical);
            if (reparsed != null && !sameNumericValue(first, reparsed)) {
                throw new RuntimeException("[oracle:roundtrip-canonical-number] metamorphic violation: createNumber(x).toString() reparsed to different quantity input="
                        + s + " canonical=" + canonical + " first=" + first + " reparsed=" + reparsed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ex) {
            return a.toString().equals(b.toString());
        }
    }

    private static String buildValidScientific(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(nonEmptyDigits(data, 1, 6));
        if (data.consumeBoolean()) {
            sb.append('.');
            sb.append(nonEmptyDigits(data, 1, 4));
        }
        sb.append('e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '+' : '-');
        }
        sb.append(nonEmptyDigits(data, 1, 3));
        return sb.toString();
    }

    private static String buildDualExponentMarkerInput(FuzzedDataProvider data) {
        String prefix = nonEmptyDigits(data, 1, 5);
        String middle = data.consumeAsciiString(3).replace(".", "");
        String suffix = nonEmptyDigits(data, 1, 4);
        if (middle.length() == 0) {
            middle = "0";
        }
        return prefix + 'e' + middle + 'E' + suffix;
    }

    private static String buildNoDecimalDualExponentMarkerInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(nonEmptyDigits(data, 1, 6));
        if (data.consumeBoolean()) {
            sb.append('e');
            String bridge = data.consumeAsciiString(2).replace(".", "");
            if (bridge.length() == 0) {
                bridge = "0";
            }
            sb.append(bridge);
            sb.append('E');
        } else {
            sb.append('E');
            String bridge = data.consumeAsciiString(2).replace(".", "");
            if (bridge.length() == 0) {
                bridge = "0";
            }
            sb.append(bridge);
            sb.append('e');
        }
        sb.append(nonEmptyDigits(data, 1, 3));
        return sb.toString();
    }

    private static String nonEmptyDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }
}
