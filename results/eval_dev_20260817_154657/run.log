    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            BigDecimal lhs = new BigDecimal(a.toString());
            BigDecimal rhs = new BigDecimal(b.toString());
            return lhs.compareTo(rhs) == 0;
        } catch (RuntimeException ignored) {
