package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String malformed = buildTrailingExponentCandidate(data);
        exerciseCreateNumber(malformed, false);

        String validScientific = buildValidScientificInteger(data);
        String expandedInteger = expandScientificInteger(validScientific);
        if (expandedInteger != null) {
            checkScientificIntegerExpansion(validScientific, expandedInteger);
        }

        String integral = buildModerateIntegralLiteral(data);
        checkIntegralLongSuffixAgreement(integral);
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkScientificIntegerExpansion(String scientific, String expanded) {
        try {
            Number lhs = NumberUtils.createNumber(scientific);
            Number rhs = NumberUtils.createNumber(expanded);
            if (lhs == null || rhs == null) {
                return;
            }
            if (!sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-integer-expansion] metamorphic violation: integral scientific notation must equal decimal expansion input="
                        + scientific + " expanded=" + expanded + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkIntegralLongSuffixAgreement(String integral) {
        try {
            Number plain = NumberUtils.createNumber(integral);
            Number suffixed = NumberUtils.createNumber(integral + "L");
            if (plain == null || suffixed == null) {
                return;
            }
            if (!sameNumericValue(plain, suffixed)) {
                throw new RuntimeException("[oracle:integral-long-suffix-agreement] metamorphic violation: explicit long suffix changed integral value input="
                        + integral + " plain=" + plain + " suffixed=" + suffixed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        try {
            return new BigDecimal(a.toString()).compareTo(new BigDecimal(b.toString())) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static String buildTrailingExponentCandidate(FuzzedDataProvider data) {
        String digits = onlyDigits(data.consumeAsciiString(12));
        if (digits.length() == 0) {
            digits = Integer.toString(Math.abs(data.consumeInt(0, 999999)));
        }
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(digits);
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
        } else {
            sb.append(data.consumeBoolean() ? 'e' : 'E');
            if (data.consumeBoolean()) {
                sb.append(data.consumeBoolean() ? '+' : '-');
            }
        }
        return sb.toString();
    }

    private static String buildValidScientificInteger(FuzzedDataProvider data) {
        String digits = onlyDigits(data.consumeAsciiString(6));
        if (digits.length() == 0) {
            digits = Integer.toString(data.consumeInt(0, 999999));
        }
        digits = stripLeadingZerosKeepOne(digits);
        int exponent = data.consumeInt(0, 6);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean() && !digits.equals("0")) {
            sb.append('-');
        }
        sb.append(digits);
        sb.append(data.consumeBoolean() ? 'e' : 'E');
        sb.append(exponent);
        return sb.toString();
    }

    private static String expandScientificInteger(String scientific) {
        int ePos = Math.max(scientific.indexOf('e'), scientific.indexOf('E'));
        if (ePos <= 0 || ePos >= scientific.length() - 1) {
            return null;
        }
        String mantissa = scientific.substring(0, ePos);
        String exponentPart = scientific.substring(ePos + 1);
        int exponent;
        try {
            exponent = Integer.parseInt(exponentPart);
        } catch (RuntimeException e) {
            return null;
        }
        if (exponent < 0 || exponent > 6) {
            return null;
        }
        boolean negative = mantissa.startsWith("-");
        String digits = negative ? mantissa.substring(1) : mantissa;
        if (digits.length() == 0 || !NumberUtils.isDigits(digits)) {
            return null;
        }
        StringBuilder expanded = new StringBuilder();
        if (negative) {
            expanded.append('-');
        }
        expanded.append(digits);
        for (int i = 0; i < exponent; i++) {
            expanded.append('0');
        }
        return expanded.toString();
    }

    private static String buildModerateIntegralLiteral(FuzzedDataProvider data) {
        String digits = onlyDigits(data.consumeAsciiString(10));
        if (digits.length() == 0) {
            digits = Integer.toString(data.consumeInt(0, 1000000));
        }
        digits = stripLeadingZerosKeepOne(digits);
        if (data.consumeBoolean() && !digits.equals("0")) {
            return "-" + digits;
        }
        return digits;
    }

    private static String onlyDigits(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String stripLeadingZerosKeepOne(String s) {
        int i = 0;
        while (i < s.length() - 1 && s.charAt(i) == '0') {
            i++;
        }
        return s.substring(i);
    }

    private static boolean isCleanReject(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(frame.getClassName())) {
                String m = frame.getMethodName();
                if ("createNumber".equals(m)
                        || "createInteger".equals(m)
                        || "isAllZeros".equals(m)
                        || "isDigits".equals(m)
                        || "createLong".equals(m)
                        || "createBigInteger".equals(m)
                        || "createFloat".equals(m)
                        || "createDouble".equals(m)
                        || "createBigDecimal".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }
}
