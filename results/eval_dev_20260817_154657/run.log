package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorSeed();

        String text = data.consumeString(32);
        String firstSearch = data.consumeString(8);
        if (firstSearch.length() == 0) {
            firstSearch = "a";
        }
        String firstReplacement = data.consumeString(8);
        if (firstReplacement == null) {
            firstReplacement = "";
        }

        boolean ensureMatch = data.consumeBoolean();
        if (ensureMatch) {
            String prefix = data.consumeString(8);
            String suffix = data.consumeRemainingAsString();
            text = prefix + firstSearch + suffix;
        }

        int extraPairs = data.consumeInt(0, 3);
        String[] searchList = new String[2 + extraPairs];
        String[] replacementList = new String[2 + extraPairs];

        searchList[0] = firstSearch;
        replacementList[0] = firstReplacement;

        if (data.consumeBoolean()) {
            searchList[1] = null;
            replacementList[1] = data.consumeBoolean() ? data.consumeString(8) : "";
        } else if (data.consumeBoolean()) {
            searchList[1] = "";
            replacementList[1] = data.consumeBoolean() ? data.consumeString(8) : "";
        } else {
            searchList[1] = data.consumeString(6);
            if (searchList[1].length() == 0) {
                searchList[1] = "b";
            }
            replacementList[1] = null;
        }

        for (int i = 2; i < searchList.length; i++) {
            int kind = data.consumeInt(0, 4);
            if (kind == 0) {
                searchList[i] = null;
                replacementList[i] = data.consumeString(6);
            } else if (kind == 1) {
                searchList[i] = "";
                replacementList[i] = data.consumeString(6);
            } else if (kind == 2) {
                searchList[i] = data.consumeString(6);
                if (searchList[i].length() == 0) {
                    searchList[i] = "x";
                }
                replacementList[i] = null;
            } else {
                searchList[i] = data.consumeString(6);
                if (searchList[i].length() == 0) {
                    searchList[i] = "y";
                }
                replacementList[i] = data.consumeString(6);
            }
        }

        exerciseAndCheck(text, searchList, replacementList);
    }

    private static void anchorSeed() {
        String text = "aba";
        String[] search = new String[] { "a", "b" };
        String[] repl = new String[] { "c", null };
        exerciseAndCheck(text, search, repl);
    }

    private static void exerciseAndCheck(String text, String[] searchList, String[] replacementList) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);

            // Contract exercised by the tests and visible in replaceEach:
            // entries with null search, empty search, or null replacement are skipped.
            // Therefore replacing with the original arrays must equal replacing with only
            // the valid pairs retained.
            String[] compactSearch = compactSearch(searchList, replacementList);
            String[] compactRepl = compactReplacements(searchList, replacementList);

            String expected;
            try {
                expected = StringUtils.replaceEach(text, compactSearch, compactRepl);
            } catch (RuntimeException e) {
                if (isCleanRejection(e) || !isRelevant(e)) {
                    return;
                }
                throw e;
            }

            if (!safeEquals(actual, expected)) {
                throw new RuntimeException(
                    "[oracle:skip-equiv] metamorphic violation: replaceEach with skipped invalid entries "
                        + "must equal replaceEach on only the valid pairs"
                        + " text=" + String.valueOf(text)
                        + " actual=" + String.valueOf(actual)
                        + " expected=" + String.valueOf(expected)
                );
            }

            // Independent consistency check for uncovered reachable helper:
            // StringUtils.length(str) is specified by code as 0 for null else str.length().
            int reported = StringUtils.length(actual);
            int recomputed = (actual == null) ? 0 : actual.length();
            if (reported != recomputed) {
                throw new RuntimeException(
                    "[oracle:length-consistency] metamorphic violation: reported length disagrees with String.length()"
                        + " value=" + String.valueOf(actual)
                        + " reported=" + reported
                        + " recomputed=" + recomputed
                );
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseNpe(e)) {
                throw e;
            }
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static String[] compactSearch(String[] searchList, String[] replacementList) {
        int count = 0;
        if (searchList != null && replacementList != null) {
            int len = Math.min(searchList.length, replacementList.length);
            for (int i = 0; i < len; i++) {
                if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                    count++;
                }
            }
            String[] result = new String[count];
            int j = 0;
            for (int i = 0; i < len; i++) {
                if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                    result[j++] = searchList[i];
                }
            }
            return result;
        }
        return new String[0];
    }

    private static String[] compactReplacements(String[] searchList, String[] replacementList) {
        int count = 0;
        if (searchList != null && replacementList != null) {
            int len = Math.min(searchList.length, replacementList.length);
            for (int i = 0; i < len; i++) {
                if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                    count++;
                }
            }
            String[] result = new String[count];
            int j = 0;
            for (int i = 0; i < len; i++) {
                if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                    result[j++] = replacementList[i];
                }
            }
            return result;
        }
        return new String[0];
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseNpe(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        return isRelevant(t);
    }

    private static boolean isRelevant(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())) {
                if ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName())) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
