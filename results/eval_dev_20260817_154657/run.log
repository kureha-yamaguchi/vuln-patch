package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        String prefix = data.consumeAsciiString(8);
        String core = data.consumeAsciiString(4);
        if (core.length() == 0) {
            core = "a";
        }
        String suffix = data.consumeRemainingAsString();
        String text = prefix + core + suffix;
        if (StringUtils.length(text) == 0) {
            text = "a";
            core = "a";
        }

        int size = data.consumeInt(1, 5);
        String[] searchList = new String[size];
        String[] replacementList = new String[size];

        int activeIndex = data.consumeInt(0, size - 1);
        for (int i = 0; i < size; i++) {
            if (i == activeIndex) {
                searchList[i] = core;
                replacementList[i] = data.consumeAsciiString(6);
                continue;
            }

            int kind = data.consumeInt(0, 4);
            switch (kind) {
                case 0:
                    searchList[i] = null;
                    replacementList[i] = data.consumeBoolean() ? data.consumeAsciiString(6) : null;
                    break;
                case 1:
                    searchList[i] = "";
                    replacementList[i] = data.consumeBoolean() ? data.consumeAsciiString(6) : null;
                    break;
                case 2:
                    searchList[i] = data.consumeAsciiString(5) + "#";
                    if (searchList[i].length() == 0) {
                        searchList[i] = "#";
                    }
                    replacementList[i] = data.consumeAsciiString(6);
                    break;
                case 3:
                    searchList[i] = data.consumeAsciiString(4);
                    if (searchList[i].length() == 0 || text.indexOf(searchList[i]) != -1) {
                        searchList[i] = "~" + i + "~";
                    }
                    replacementList[i] = null;
                    break;
                default:
                    searchList[i] = data.consumeAsciiString(4);
                    if (searchList[i].length() == 0 || text.indexOf(searchList[i]) != -1) {
                        searchList[i] = "%" + i + "%";
                    }
                    replacementList[i] = data.consumeAsciiString(6);
                    break;
            }

            StringUtils.length(searchList[i]);
            StringUtils.length(replacementList[i]);
        }

        exerciseFilteredMetamorphic(text, searchList, replacementList);
    }

    /*
     * Contract asserted:
     * The documented tests for StringUtils.replaceEach show that null search entries,
     * null replacement entries, and mixed arrays with one null replacement must be
     * accepted and produce the stated output. A patch that merely suppresses the old
     * NullPointerException but skips or corrupts replacement logic would violate these
     * exact, public API examples.
     */
    private static void runAnchorCases() {
        checkExpected("aba", new String[] { null }, new String[] { "a" }, "aba", "doc-null-search");
        checkExpected("aba", new String[] { "a" }, new String[] { null }, "aba", "doc-null-repl");
        checkExpected("aba", new String[] { "a", "b" }, new String[] { "c", null }, "cbc", "doc-mixed-null-repl");
        checkExpected("aba", new String[] { "a" }, new String[] { "" }, "b", "doc-empty-replacement");
    }

    private static void checkExpected(String text, String[] searchList, String[] replacementList, String expected, String oracleId) {
        StringUtils.length(text);
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (expected == null) {
                if (actual != null) {
                    throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: expected null input=" + text + " actual=" + actual);
                }
            } else if (!expected.equals(actual)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: input=" + text + " expected=" + expected + " actual=" + actual);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isFromReplaceEach(e)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: documented replaceEach example threw " + e.getClass().getName(), e);
            }
        }
    }

    /*
     * Contract asserted:
     * Entries that are ignored by replaceEach's own matching logic
     * (null search, empty search, null replacement, or search strings absent from text)
     * cannot change the replacement result. Therefore removing those ignored entries
     * must preserve output for every correct implementation.
     */
    private static void exerciseFilteredMetamorphic(String text, String[] searchList, String[] replacementList) {
        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        List<String> filteredSearch = new ArrayList<String>();
        List<String> filteredReplacement = new ArrayList<String>();
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            String s = searchList[i];
            String r = replacementList[i];
            StringUtils.length(s);
            StringUtils.length(r);
            if (s == null || s.length() == 0 || r == null) {
                continue;
            }
            if (text.indexOf(s) == -1) {
                continue;
            }
            filteredSearch.add(s);
            filteredReplacement.add(r);
        }

        String[] rhsSearch = filteredSearch.toArray(new String[filteredSearch.size()]);
        String[] rhsReplacement = filteredReplacement.toArray(new String[filteredReplacement.size()]);

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, rhsSearch, rhsReplacement);
        } catch (IllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            return;
        }

        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException(
                "[oracle:filter-null] metamorphic violation: filtering ignored entries changed result input=" + text
                    + " lhs=" + lhs
                    + " rhs=" + rhs
                    + " searchSize=" + searchList.length
                    + " filteredSize=" + rhsSearch.length);
        }
    }

    private static boolean isFromReplaceEach(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "replaceEach".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
