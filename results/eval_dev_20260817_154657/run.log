        Boolean rhs = safeToBoolean(canonical);
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException("[oracle:case-fold] metamorphic violation: equivalent inputs must agree input=" + cased + " lhs=" + lhs + " rhs=" + rhs);
        }

