                        + " text=" + text
                        + " lhs=" + twice
                        + " rhs=" + twiceSanitized
                        + " search=" + ArrayUtils.toString(search)
                        + " replacement=" + ArrayUtils.toString(replacement));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) && isValidByConstruction(text, search, replacement)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isValidByConstruction(String text, String[] search, String[] replacement) {
        if (text == null || search == null || replacement == null) {
            return false;
        }
        if (search.length != replacement.length) {
            return false;
        }
        boolean hasUsablePair = false;
        boolean hasIgnoredPair = false;
        for (int i = 0; i < search.length; i++) {
            if (search[i] == null || search[i].length() == 0 || replacement[i] == null) {
                hasIgnoredPair = true;
            } else {
                hasUsablePair = true;
            }
        }
        return hasUsablePair && hasIgnoredPair;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
