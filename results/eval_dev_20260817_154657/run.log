    private static void verifyExpected(String expected, String text, String[] searchList, String[] replacementList,
                                       boolean validByConstruction, String oracleId) {
        try {
            String actual = StringUtils.replaceEach(text, searchList, replacementList);
            if (StringUtils.length(actual) != (actual == null ? 0 : actual.length())) {
                throw new RuntimeException("[oracle:" + oracleId + "] consistency violation: reportedLength="
                        + StringUtils.length(actual) + " actualLength=" + (actual == null ? 0 : actual.length()));
            }
            if (expected == null ? actual != null : !expected.equals(actual)) {
                throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: expected=" + expected
                        + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkIgnoredEntryMetamorphic(String text, String[] searchList, String[] replacementList,
                                                     boolean validByConstruction, String oracleId) {
        String[] filteredSearch = new String[searchList == null ? 0 : searchList.length];
        String[] filteredReplacement = new String[replacementList == null ? 0 : replacementList.length];
        int kept = 0;
        if (searchList != null && replacementList != null) {
            int len = Math.min(searchList.length, replacementList.length);
            for (int i = 0; i < len; i++) {
                if (searchList[i] == null || searchList[i].length() == 0 || replacementList[i] == null) {
                    continue;
                }
                filteredSearch[kept] = searchList[i];
                filteredReplacement[kept] = replacementList[i];
                kept++;
            }
        }

        String[] compactSearch = new String[kept];
        String[] compactReplacement = new String[kept];
        for (int i = 0; i < kept; i++) {
            compactSearch[i] = filteredSearch[i];
            compactReplacement[i] = filteredReplacement[i];
        }

        String fullResult;
        try {
            fullResult = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
            return;
        }

        String filteredResult;
        try {
            filteredResult = StringUtils.replaceEach(text, compactSearch, compactReplacement);
        } catch (RuntimeException t) {
            return;
        }

        if (StringUtils.length(fullResult) != (fullResult == null ? 0 : fullResult.length())) {
            throw new RuntimeException("[oracle:" + oracleId + "-len] consistency violation: reportedLength="
                    + StringUtils.length(fullResult) + " actualLength=" + (fullResult == null ? 0 : fullResult.length()));
        }

        if (fullResult == null ? filteredResult != null : !fullResult.equals(filteredResult)) {
            throw new RuntimeException("[oracle:" + oracleId + "] metamorphic violation: "
                    + "replaceEach should ignore null/empty search entries and null replacement entries. "
                    + "text=" + text
                    + " lhs=" + fullResult
                    + " rhs=" + filteredResult
                    + " searchSize=" + (searchList == null ? -1 : searchList.length)
                    + " replSize=" + (replacementList == null ? -1 : replacementList.length));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validation") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
