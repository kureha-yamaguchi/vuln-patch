        runTarget("oof", true);
        runTarget("yep", true);
        runTarget("trux", true);
        runTarget("false", true);
        runTarget("a", true);
        runTarget("true", true);
        runTarget(new StringBuffer("tr").append("ue").toString(), true);
        runTarget("truE", true);
        runTarget("trUe", true);
        runTarget("trUE", true);
        runTarget("tRue", true);
        runTarget("tRuE", true);
        runTarget("tRUe", true);
        runTarget("tRUE", true);
        runTarget("TRUE", true);
        runTarget("TRUe", true);
        runTarget("TRuE", true);
        runTarget("TRue", true);
        runTarget("TrUE", true);
        runTarget("TrUe", true);
        runTarget("TruE", true);
        runTarget("True", true);
        runTarget("on", true);
        runTarget("oN", true);
        runTarget("On", true);
        runTarget("ON", true);
        runTarget("yes", true);
        runTarget("yeS", true);
        runTarget("yEs", true);
        runTarget("yES", true);
        runTarget("Yes", true);
        runTarget("YeS", true);
        runTarget("YEs", true);
        runTarget("YES", true);
        runTarget("yes?", true);
        runTarget("tru", true);

        String fuzz = data.consumeString(32);
        runTarget(fuzz, true);

        String crashShape = makeThreeCharStartsWithT(data);
        boolean expectedFalse = !equalsIgnoreCaseAscii(crashShape, "yes");

        try {
            boolean actual = BooleanUtils.toBoolean(crashShape);

            /*
             * Contract visible in BooleanUtils.toBoolean(String):
             * - length 3 returns true only for case-insensitive "yes"
             * - length 2 returns true only for case-insensitive "on"
             * - length 4 returns true only for case-insensitive "true"
             * Therefore any three-character string starting with 't' or 'T'
             * is not a recognized true token and must return false.
             * A patch that merely suppresses the crash but returns true/garbage
             * for these inputs violates this observable result contract.
             */
            if (expectedFalse && actual) {
                throw new RuntimeException(
                    "[oracle:t3-false] metamorphic violation: unrecognized 3-char T/t string must be false input="
                        + quote(crashShape) + " lhs=" + actual + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String lower = toAsciiLower(fuzz);
        try {
            boolean lhs = BooleanUtils.toBoolean(fuzz);
            boolean rhs = BooleanUtils.toBoolean(lower);

            /*
             * Equivalent-input relation from the implementation contract:
             * recognized literals are matched case-insensitively ("on", "yes", "true"),
             * and every other string maps to false. So lowercasing ASCII letters
             * cannot change the boolean result of a correct implementation.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "[oracle:ascii-lower] metamorphic violation: toBoolean(s) must equal toBoolean(toLowerCaseAscii(s)) input="
                        + quote(fuzz) + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runTarget(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String makeThreeCharStartsWithT(FuzzedDataProvider data) {
        char first = data.consumeBoolean() ? 't' : 'T';
        char second = safeAsciiChar(data.consumeByte());
        char third = safeAsciiChar(data.consumeByte());
        return new String(new char[] { first, second, third });
    }

    private static char safeAsciiChar(byte b) {
        int v = b & 0x7f;
        if (v < 32) {
            v += 32;
        }
        return (char) v;
    }

    private static String toAsciiLower(String s) {
        if (s == null) {
            return null;
        }
        char[] c = s.toCharArray();
        for (int i = 0; i < c.length; i++) {
            if (c[i] >= 'A' && c[i] <= 'Z') {
                c[i] = (char) (c[i] + ('a' - 'A'));
            }
        }
        return new String(c);
    }

    private static boolean equalsIgnoreCaseAscii(String a, String b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length() != b.length()) {
            return false;
        }
        for (int i = 0; i < a.length(); i++) {
            char x = a.charAt(i);
            char y = b.charAt(i);
            if (x == y) {
                continue;
            }
            if (x >= 'A' && x <= 'Z') {
                x = (char) (x + ('a' - 'A'));
            }
            if (y >= 'A' && y <= 'Z') {
                y = (char) (y + ('a' - 'A'));
            }
            if (x != y) {
                return false;
            }
        }
        return true;
    }

    private static String quote(String s) {
        return s == null ? "null" : ("\"" + s + "\"");
    }
}
