    private static void checkSeriesViewConsistency(TimeSeries series, String label) {
        int count = series.getItemCount();
        java.util.List items = series.getItems();
        java.util.Collection periods = series.getTimePeriods();

        if (items.size() != count) {
            throw new FuzzerSecurityIssueLow(
                    "[oracle:view-items-size] getItems().size() must equal getItemCount()"
                            + " label=" + label
                            + " count=" + count
                            + " itemsSize=" + items.size());
        }
        if (periods.size() != count) {
            throw new FuzzerSecurityIssueLow(
                    "[oracle:view-periods-size] getTimePeriods().size() must equal getItemCount()"
                            + " label=" + label
                            + " count=" + count
                            + " periodsSize=" + periods.size());
        }

        for (int i = 0; i < count; i++) {
            TimeSeriesDataItem item = series.getDataItem(i);
            RegularTimePeriod p = series.getTimePeriod(i);
            if (!item.getPeriod().equals(p)) {
                throw new FuzzerSecurityIssueLow(
                        "[oracle:view-period-roundtrip] getDataItem(i).getPeriod() must equal getTimePeriod(i)"
                                + " label=" + label
                                + " index=" + i
                                + " itemPeriod=" + item.getPeriod()
                                + " period=" + p);
            }

            Number vi = item.getValue();
            Number vv = series.getValue(i);
            if (vi == null ? vv != null : !vi.equals(vv)) {
                throw new FuzzerSecurityIssueLow(
                        "[oracle:view-value-roundtrip] getDataItem(i).getValue() must equal getValue(i)"
                                + " label=" + label
                                + " index=" + i
                                + " itemValue=" + vi
                                + " value=" + vv);
            }

            int roundTripIndex = series.getIndex(p);
            if (roundTripIndex != i) {
                throw new FuzzerSecurityIssueLow(
                        "[oracle:index-roundtrip] getIndex(getTimePeriod(i)) must equal i"
                                + " label=" + label
                                + " index=" + i
                                + " roundTripIndex=" + roundTripIndex
                                + " period=" + p);
            }
        }
    }

    private static Day dayFromEpochDay(int epochDay) {
        java.util.GregorianCalendar cal =
                new java.util.GregorianCalendar(java.util.TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.setLenient(true);
        cal.set(1970, java.util.Calendar.JANUARY, 1, 12, 0, 0);
        cal.add(java.util.Calendar.DATE, epochDay);
        return new Day(cal.getTime());
    }

    private static boolean isOracleFailure(Throwable t) {
        if (t instanceof FuzzerSecurityIssueLow) {
            return true;
        }
        if (t instanceof RuntimeException) {
            String m = t.getMessage();
            return m != null && m.startsWith("[oracle:");
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!isValidationFamily(t)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method) || "clone".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isValidationFamily(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof ClassCastException
                || t instanceof NullPointerException
                || t instanceof ArithmeticException;
    }
