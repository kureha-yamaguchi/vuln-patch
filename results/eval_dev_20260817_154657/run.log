public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            exerciseMalformed(anchors[i]);
        }

        for (int i = 0; i < 12; i++) {
            String probe;
            switch (data.consumeInt(0, 9)) {
                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = (data.consumeBoolean() ? "+" : "-") + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = "e" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = "." + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = (data.consumeBoolean() ? "+" : "-") + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeString(4);
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String digits = buildDigits(data, 1, 12);
            String numeric = "+" + digits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * Contract asserted from the real create* family:
                 * a valid signed decimal integer string is accepted by createLong, and createNumber
                 * on the same numeric payload with an explicit long suffix is "requesting a specific type".
                 * Therefore createNumber("+"+digits+"L") must agree with both createLong("+"+digits)
                 * and createNumber("+"+digits) on the numeric value, with the explicit-suffix result being a Long.
                 * A band-aid that only suppresses the old singleton crash or overfits to '-' but mishandles '+'
                 * will violate this relation without needing the old exception to appear.
                 */
                if (!(explicit instanceof Long)
                        || helper == null
                        || unsuffixed == null
                        || explicit.longValue() != helper.longValue()
                        || explicit.longValue() != unsuffixed.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-explicit-long-agreement] metamorphic violation: createNumber('+'+digits+L) must agree with createLong('+'+digits) and createNumber('+'+digits) input="
                                    + suffixed + " explicit=" + explicit + " helper=" + helper + " unsuffixed=" + unsuffixed);
                }

                Number lower = NumberUtils.createNumber(numeric + "l");
                Number upper = NumberUtils.createNumber(numeric + "L");
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || lower.longValue() != upper.longValue()
                        || lower.longValue() != helper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-long-suffix-case] metamorphic violation: lower/upper long suffix variants of a valid '+'-signed decimal must agree input="
                                    + numeric + " lower=" + lower + " upper=" + upper + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCause(e) && isValidPlusSignedDecimalLong(suffixed)) {
                    throw e;
                }
                return;
            }
        }

        {
            String overflowDigits = buildOverflowDigits(data);
            String numeric = "+" + overflowDigits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                BigInteger helper = NumberUtils.createBigInteger(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * Contract asserted from createNumber's real selection logic:
                 * for a valid integral decimal too large for long, the explicit L/l branch falls back to
                 * createBigInteger while preserving value. The unsuffixed parse of the same valid decimal
                 * is also an integral parse of the same quantity, so both exposed results must equal the
                 * dedicated helper createBigInteger on the identical payload.
                 */
                if (!(explicit instanceof BigInteger)
                        || helper == null
                        || !(unsuffixed instanceof BigInteger)
                        || !helper.equals(explicit)
                        || !helper.equals(unsuffixed)) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-overflow-bigint-agreement] metamorphic violation: createNumber('+'+overflowDigits+L) and createNumber('+'+overflowDigits) must agree with createBigInteger input="
                                    + suffixed + " explicit=" + explicit + " helper=" + helper + " unsuffixed=" + unsuffixed);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCause(e) && isValidPlusSignedDecimalLong(suffixed)) {
                    throw e;
                }
            }
        }
    }
