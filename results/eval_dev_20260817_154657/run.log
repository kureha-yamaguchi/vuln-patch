package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            runEscapeCsv(s, true, s, true);
        }

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        String middle = sanitizeCsvSafeAscii(data.consumeAsciiString(8));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(8));

        if (prefix.length() == 0) {
            prefix = "A";
        }
        if (middle.length() == 0) {
            middle = "B";
        }
        if (suffix.length() == 0) {
            suffix = "C";
        }

        int pairCount = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append(prefix);
        }

        boolean placedPairBeforeTrailingCodePoint = false;
        for (int i = 0; i < pairCount; i++) {
            sb.append(randomSupplementary(data));
            if (!placedPairBeforeTrailingCodePoint) {
                sb.append(middle);
                placedPairBeforeTrailingCodePoint = true;
            } else if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(4)));
            }
        }

        if (sb.length() == 0) {
            sb.append(randomSupplementary(data));
        }
        if (!placedPairBeforeTrailingCodePoint) {
            sb.append("X");
        }
        sb.append(suffix);

        String constructed = sb.toString();

        /*
         * Contract asserted: StringEscapeUtils.escapeCsv returns the input unchanged when the
         * input contains none of the CSV-special characters comma, quote, CR, or LF.
         * We build inputs that are valid UTF-16 by construction and exclude those characters,
         * so a correct implementation must return the exact same string. A "fix" that merely
         * skips the crashing bookkeeping or silently drops/mangles characters would violate this.
         */
        runEscapeCsv(constructed, true, constructed, true);

        String extra = sanitizeCsvSafeAscii(data.consumeRemainingAsString());
        if (extra.length() > 0) {
            String combined = constructed + extra;
            runEscapeCsv(combined, true, combined, true);
        }
    }

    private static void runEscapeCsv(String input, boolean validByConstruction, String expected, boolean checkExpected) {
        try {
            String out = StringEscapeUtils.escapeCsv(input);
            if (checkExpected && !expected.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve CSV-safe valid input input="
                        + printable(input) + " lhs=" + printable(out) + " rhs=" + printable(expected));
            }
        } catch (RuntimeException t) {
            if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("malformed") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method) && (
                    "org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch != ',' && ch != '"' && ch != '\r' && ch != '\n') {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String randomSupplementary(FuzzedDataProvider data) {
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        return new String(Character.toChars(cp));
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
