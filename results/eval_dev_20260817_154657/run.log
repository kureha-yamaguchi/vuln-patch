                    break;
                case 3:
                    probe = "e" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = "E" + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 9:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 10:
                    probe = data.consumeAsciiString(1) + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                default:
                    probe = data.consumeString(4);
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String digits = buildDigits(data, 1, 18);
            String numeric = "+" + digits;
            String lowerInput = numeric + "l";
            String upperInput = numeric + "L";
            try {
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);
                Number lower = NumberUtils.createNumber(lowerInput);
                Number upper = NumberUtils.createNumber(upperInput);

                /*
                 * Contract visible in createNumber's real code:
                 * case 'l' and case 'L' use the same branch, and that branch returns createLong(numeric)
                 * for a valid decimal payload. The unsuffixed integral parse of the same valid text must
