package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Ground-truth anchor from the failing test/crash report. On the known-buggy version this must
        // be allowed to propagate so Jazzer can report the finding.
        NumberUtils.createNumber("1234.5");

        String sign = data.consumeBoolean() ? "-" : "";
        String mantissa = digitsOnly(data.consumeAsciiString(12));
        String exponent = digitsOnly(data.consumeAsciiString(6));
        String exponentSign = data.consumeBoolean() ? "-" : "";
        char marker = data.consumeBoolean() ? 'e' : 'E';
        char suffix = data.consumeBoolean() ? 'F' : 'D';

        String scientific = sign + mantissa + marker + exponentSign + exponent + suffix;
        String equivalent = sign + mantissa + ".0" + (marker == 'e' ? 'E' : 'e') + exponentSign + exponent + suffix;

        checkEquivalentScientificNotation(scientific, equivalent);

        String plainScientific = sign + mantissa + marker + exponentSign + exponent;
        String plainEquivalent = sign + mantissa + ".0" + (marker == 'e' ? 'E' : 'e') + exponentSign + exponent;
        checkEquivalentScientificNotation(plainScientific, plainEquivalent);
    }

    private static void checkEquivalentScientificNotation(String a, String b) {
        try {
            Number left = NumberUtils.createNumber(a);
            Number right = NumberUtils.createNumber(b);
            if (left == null || right == null) {
                return;
            }
            /*
             * Contract used for this oracle:
             * both strings denote the same numeric quantity because they differ only by exponent-marker
             * case and by inserting a redundant ".0" before the exponent. A correct numeric parser must
             * assign the same value to both accepted inputs. A patch that merely suppresses the throw but
             * computes the mantissa/exponent split incorrectly will violate this relation.
             */
            if (!sameNumericValue(left, right)) {
                throw new RuntimeException("[oracle:scientific-equivalence] metamorphic violation: equivalent scientific notations parsed to different values inputA="
                        + a + " inputB=" + b + " lhs=" + left + " rhs=" + right);
            }
        } catch (RuntimeException ignored) {
            // Rejections of fuzz-generated inputs do not imply a bug and are skipped.
        }
    }

    private static String digitsOnly(String s) {
        if (s == null || s.length() == 0) {
            return "1";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.length() == 0 ? "1" : sb.toString();
    }

    private static boolean sameNumericValue(Number a, Number b) {
        return toBigDecimal(a).compareTo(toBigDecimal(b)) == 0;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return ((BigDecimal) n).stripTrailingZeros();
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n).stripTrailingZeros();
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue()).stripTrailingZeros();
        }
        if (n instanceof Float || n instanceof Double) {
            double d = n.doubleValue();
            if (Double.isNaN(d) || Double.isInfinite(d)) {
                throw new IllegalArgumentException("non-finite");
            }
            return BigDecimal.valueOf(d).stripTrailingZeros();
        }
        return new BigDecimal(String.valueOf(n)).stripTrailingZeros();
    }
}
