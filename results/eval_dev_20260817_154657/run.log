package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorInputs();

        String prefix = data.consumeString(16);
        String needle = data.consumeString(8);
        String suffix = data.consumeString(16);
        String replacement = data.consumeString(12);
        String ignoredSearch = data.consumeString(8);

        if (needle == null || needle.length() == 0) {
            needle = "a";
        }
        if (ignoredSearch == null || ignoredSearch.length() == 0) {
            ignoredSearch = "b";
        }

        String text = prefix + needle + suffix;
        String[] baseSearch = new String[] { needle };
        String[] baseRepl = new String[] { replacement };
        String[] augmentedSearch = new String[] { needle, ignoredSearch };
        String[] augmentedRepl = new String[] { replacement, null };

        try {
            String lhs = StringUtils.replaceEach(text, baseSearch, baseRepl);
            String rhs = StringUtils.replaceEach(text, augmentedSearch, augmentedRepl);

            // Contract exercised by the library's own tests:
            // - StringUtils.replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
            // - StringUtils.replaceEach("aba", new String[]{"a","b"}, new String[]{"c",null}) == "cbc"
            // Therefore, a rule whose replacement is null is ignored. Adding such a rule must not
            // change the result of the otherwise identical call.
            if (!safeEquals(lhs, rhs)) {
                throw new RuntimeException(
                    "[oracle:null-rule-equiv] metamorphic violation: adding a null-replacement rule changed output"
                        + " input=" + printable(text)
                        + " lhs=" + printable(lhs)
                        + " rhs=" + printable(rhs)
                        + " needle=" + printable(needle)
                        + " ignoredSearch=" + printable(ignoredSearch)
                        + " replacement=" + printable(replacement));
            }

            // Sound helper cross-check for uncovered reachable function length:
            // StringUtils.length(str) is defined as str == null ? 0 : str.length().
            int reportedLhsLen = StringUtils.length(lhs);
            int independentLhsLen = lhs == null ? 0 : lhs.length();
            if (reportedLhsLen != independentLhsLen) {
                throw new RuntimeException(
                    "[oracle:length-lhs] consistency violation: reported=" + reportedLhsLen
                        + " independent=" + independentLhsLen
                        + " value=" + printable(lhs));
            }

            int reportedRhsLen = StringUtils.length(rhs);
            int independentRhsLen = rhs == null ? 0 : rhs.length();
            if (reportedRhsLen != independentRhsLen) {
                throw new RuntimeException(
                    "[oracle:length-rhs] consistency violation: reported=" + reportedRhsLen
                        + " independent=" + independentRhsLen
                        + " value=" + printable(rhs));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpe(t)) {
                throw t;
            }
            throwIfOracle(t);
        }

        // Additional varied real inputs satisfying the same property:
        // at least one real replacement rule matches the text, and at least one array element in
        // replacementList is null. A correct implementation accepts these and ignores the null rule.
        int extraRules = data.consumeInt(0, 3);
        String core = data.consumeString(6);
        if (core == null || core.length() == 0) {
            core = "x";
        }
        String text2 = data.consumeString(12) + core + data.consumeString(12);

        String[] search = new String[extraRules + 2];
