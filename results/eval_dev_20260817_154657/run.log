package org.apache.commons.lang3.math;

import java.math.BigDecimal;
import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        String sign = data.consumeBoolean() ? "-" : "";
        String intPart = digitsOnly(data.consumeAsciiString(16), String.valueOf(data.consumeInt(0, 999999)));
        String fracPart = digitsOnly(data.consumeAsciiString(16), String.valueOf(data.consumeInt(0, 999999)));
        String expDigits = digitsOnly(data.consumeAsciiString(8), String.valueOf(data.consumeInt(0, 9999)));
        String expSign = data.consumeBoolean() ? "-" : "";
        String suffix = pickSuffix(data.consumeInt(0, 5));

        String plainInt = sign + intPart;
        String decimal = sign + intPart + "." + fracPart;
        String decimalTrailingDot = sign + intPart + ".";
        String sciNoDotLower = sign + intPart + "e" + expSign + expDigits;
        String sciNoDotUpper = sign + intPart + "E" + expSign + expDigits;
        String sciWithDotLower = sign + intPart + "." + fracPart + "e" + expSign + expDigits;
        String sciWithDotUpper = sign + intPart + "." + fracPart + "E" + expSign + expDigits;

        exerciseCreateNumber(plainInt, true);
        exerciseCreateNumber(decimal, true);
        exerciseCreateNumber(decimalTrailingDot, true);
        exerciseCreateNumber(sciNoDotLower, true);
        exerciseCreateNumber(sciNoDotUpper, true);
        exerciseCreateNumber(sciWithDotLower, true);
        exerciseCreateNumber(sciWithDotUpper, true);
        exerciseCreateNumber(decimal + suffix, true);
        exerciseCreateNumber(plainInt + "L", true);
        exerciseCreateNumber(plainInt + "l", true);

        /* Contract used for these metamorphic checks:
         * createNumber parses Java-like numeric strings, and changing only the exponent
         * marker case ('e' vs 'E') or long-suffix case ('l' vs 'L') must not change the
         * numeric value. Likewise, appending exponent zero to an integer string denotes the
         * same quantity. A throw-deleting or value-corrupting patch can evade crash-only
         * detection but still violate these observable equivalences.
         */
        checkEquivalentNumbers("[oracle:scientific-exp-case]", sciNoDotLower, sciNoDotUpper, true);
        checkEquivalentNumbers("[oracle:scientific-exp-case]", sciWithDotLower, sciWithDotUpper, true);
        checkEquivalentNumbers("[oracle:exp-zero-equivalence]", plainInt, sign + intPart + "e0", true);
        checkEquivalentNumbers("[oracle:exp-zero-equivalence]", plainInt, sign + intPart + "E0", true);
        checkEquivalentNumbers("[oracle:long-suffix-case]", plainInt + "l", plainInt + "L", true);
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentNumbers(String oracleId, String a, String b, boolean validByConstruction) {
        try {
            Number lhs = NumberUtils.createNumber(a);
            Number rhs = NumberUtils.createNumber(b);
            if (lhs == null || rhs == null) {
                return;
            }
            if (!sameNumericValue(lhs, rhs)) {
                throw new RuntimeException(oracleId + " metamorphic violation: inputA=" + a + " inputB=" + b + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        if (a instanceof Float && (((Float) a).isNaN() || ((Float) a).isInfinite())) {
            return false;
        }
        if (a instanceof Double && (((Double) a).isNaN() || ((Double) a).isInfinite())) {
            return false;
        }
        if (b instanceof Float && (((Float) b).isNaN() || ((Float) b).isInfinite())) {
            return false;
        }
        if (b instanceof Double && (((Double) b).isNaN() || ((Double) b).isInfinite())) {
            return false;
        }
        try {
            BigDecimal da = new BigDecimal(a.toString());
            BigDecimal db = new BigDecimal(b.toString());
            return da.compareTo(db) == 0;
        } catch (RuntimeException ignored) {
            return a.toString().equals(b.toString());
        }
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.math.NumberUtils".equals(ste.getClassName())
                    && "createNumber".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanReject(Throwable t) {
        if (t instanceof IllegalArgumentException) {
            return true;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            if (cls != null && cls.startsWith("org.apache.commons.lang3")) {
                if (t instanceof RuntimeException && !(t instanceof StringIndexOutOfBoundsException)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String digitsOnly(String s, String fallback) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            out.append(fallback);
        }
        int start = 0;
        while (start < out.length() - 1 && out.charAt(start) == '0') {
            start++;
        }
        return out.substring(start);
    }

    private static String pickSuffix(int selector) {
        switch (selector) {
            case 0:
                return "d";
            case 1:
                return "D";
            case 2:
                return "f";
            case 3:
                return "F";
            case 4:
                return "l";
            default:
                return "L";
        }
    }
}
