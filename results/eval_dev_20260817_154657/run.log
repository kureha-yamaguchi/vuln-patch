package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;

/*
 * Oracle asserted below:
 * Scientific notation is case-insensitive with respect to the exponent marker:
 * createNumber("123e4") and createNumber("123E4") must denote the same numeric value.
 * Also, adding a redundant ".0" to an integer mantissa preserves value:
 * createNumber("123e4") and createNumber("123.0e4") must denote the same numeric value.
 * A throw-deleting or seed-only patch can avoid the original crash yet still mis-parse
 * one of these equivalent forms, so the metamorphic checks remain meaningful.
 */
public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        exerciseCreateNumber("12345", true);
        exerciseCreateNumber("1234.5D", true);
        exerciseCreateNumber("1234.5d", true);
        exerciseCreateNumber("1234.5F", true);
        exerciseCreateNumber("1234.5f", true);
        exerciseCreateNumber("-1234.5", true);
        exerciseCreateNumber("-12345", true);
        exerciseCreateNumber("0xFADE", true);
        exerciseCreateNumber("-0xFADE", true);
        exerciseCreateNumber("1.1E20", true);
        exerciseCreateNumber("2.", true);

        String digits = onlyDigits(data.consumeAsciiString(12));
        if (digits.length() == 0) {
            digits = Integer.toString(data.consumeInt(0, 999999));
        }
        digits = trimLeadingZerosKeepOne(digits);

        String sign = data.consumeBoolean() ? "-" : "";
        String expDigits = onlyDigits(data.consumeAsciiString(6));
        if (expDigits.length() == 0) {
            expDigits = Integer.toString(data.consumeInt(0, 200));
        }
        expDigits = trimLeadingZerosKeepOne(expDigits);
        String expSign = data.consumeBoolean() ? (data.consumeBoolean() ? "+" : "-") : "";

        String lower = sign + digits + "e" + expSign + expDigits;
        String upper = sign + digits + "E" + expSign + expDigits;
        String lowerWithDotZero = sign + digits + ".0e" + expSign + expDigits;
        String upperWithDotZero = sign + digits + ".0E" + expSign + expDigits;

        exerciseCreateNumber(lower, true);
        exerciseCreateNumber(upper, true);
        exerciseCreateNumber(lowerWithDotZero, true);
        exerciseCreateNumber(upperWithDotZero, true);

        checkEquivalentScientificExponentCase(lower, upper, true);
        checkEquivalentScientificExponentCase(lowerWithDotZero, upperWithDotZero, true);
        checkEquivalentIntegerMantissaVsDotZero(lower, lowerWithDotZero, true);
        checkEquivalentIntegerMantissaVsDotZero(upper, upperWithDotZero, true);

        String suffix = "";
        int suffixChoice = data.consumeInt(0, 4);
        if (suffixChoice == 1) {
            suffix = "f";
        } else if (suffixChoice == 2) {
            suffix = "F";
        } else if (suffixChoice == 3) {
            suffix = "d";
        } else if (suffixChoice == 4) {
            suffix = "D";
        }
        String suffixedLower = lower + suffix;
        String suffixedUpper = upper + suffix;
        if (suffix.length() != 0) {
            exerciseCreateNumber(suffixedLower, true);
            exerciseCreateNumber(suffixedUpper, true);
            checkEquivalentScientificExponentCase(suffixedLower, suffixedUpper, true);
        }

        String maybeInvalid = data.consumeRemainingAsString();
        if (maybeInvalid.length() != 0) {
            exerciseCreateNumber(maybeInvalid, false);
        }
