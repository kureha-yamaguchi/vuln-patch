package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            exercise(s, true, true);
        }

        int codePoint = data.consumeInt(0x10000, 0x10FFFF);
        String pair = new String(Character.toChars(codePoint));

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(16));

        String input;
        switch (data.consumeInt(0, 5)) {
            case 0:
                input = pair;
                break;
            case 1:
                input = prefix + pair;
                break;
            case 2:
                input = pair + suffix;
                break;
            case 3:
                input = prefix + pair + suffix;
                break;
            case 4:
                input = prefix + pair + sanitizeCsvSafeAscii(data.consumeAsciiString(8)) + pair + suffix;
                break;
            default:
                input = sanitizeCsvSafeAscii(data.consumeAsciiString(8)) + pair + sanitizeCsvSafeAscii(data.consumeAsciiString(8));
                break;
        }

        if (input.length() == 0) {
            input = pair;
        }

        exercise(input, true, true);

        String maybeInvalid = data.consumeString(32);
        if (maybeInvalid != null && maybeInvalid.length() > 0) {
            exercise(maybeInvalid, false, false);
        }
    }

    private static void exercise(String input, boolean validByConstruction, boolean checkOracle) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            if (checkOracle) {
                /*
                 * Contract asserted: StringEscapeUtils.escapeCsv returns the input unchanged
                 * when the input contains none of the CSV special characters that require escaping
                 * (comma, double quote, CR, LF). The explored inputs are built from safe ASCII plus
                 * valid supplementary Unicode code points, so a correct implementation must preserve
                 * them exactly. A "fix" that merely skips the crashing bookkeeping or drops characters
                 * would violate this observable post-condition without throwing.
                 */
                if (isCsvSafe(input) && !input.equals(escaped)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: safe CSV input must be unchanged input="
                            + repr(input) + " lhs=" + repr(escaped) + " rhs=" + repr(input));
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (validByConstruction && isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(e.getClassName())
                    && "translate".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String sanitizeCsvSafeAscii(String s) {
        if (s == null || s.length() == 0) {
            return "A";
        }
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                b.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                b.append('B');
            } else {
                b.append(c);
            }
        }
        return b.toString();
    }

    private static boolean isCsvSafe(String s) {
        if (s == null) {
            return false;
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return false;
            }
        }
        return true;
    }

    private static String repr(String s) {
        return s == null ? "null" : s.replace("\\", "\\\\").replace("\r", "\\r").replace("\n", "\\n");
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
