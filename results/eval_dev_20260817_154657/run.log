public class FuzzHarness {
    private static String digits(String s, int minLen) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        while (sb.length() < minLen) {
            sb.append('1');
        }
        return sb.toString();
    }

    private static void assertEquivalentScientificForms(String a, String b) {
        Number na = NumberUtils.createNumber(a);
        Number nb = NumberUtils.createNumber(b);
        BigDecimal da = new BigDecimal(na.toString());
        BigDecimal db = new BigDecimal(nb.toString());
        if (da.compareTo(db) != 0) {
            throw new RuntimeException("[oracle:scientific-equivalence] metamorphic violation: equivalent scientific forms changed value inputA=" + a + " inputB=" + b + " lhs=" + na + " rhs=" + nb);
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String validMant = digits(data.consumeAsciiString(4), 1);
        String validExp = digits(data.consumeAsciiString(2), 1);
