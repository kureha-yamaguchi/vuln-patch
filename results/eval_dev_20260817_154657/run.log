    private static void exerciseMalformed(String input) {
        try {
            NumberUtils.createNumber(input);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                return;
            }
        }
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if (!"org.apache.commons.lang.NumberUtils".equals(ste.getClassName())) {
                continue;
            }
            String method = ste.getMethodName();
            if ("createNumber".equals(method)
                    || "createInteger".equals(method)
                    || "isAllZeros".equals(method)
                    || "isDigits".equals(method)
                    || "createLong".equals(method)
                    || "createBigInteger".equals(method)
                    || "createFloat".equals(method)
                    || "createDouble".equals(method)
                    || "createBigDecimal".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String buildDigits(FuzzedDataProvider data, int minLen, int maxLen, boolean allowLeadingZero) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            char c;
            if (i == 0 && !allowLeadingZero) {
                c = (char) ('1' + data.consumeInt(0, 8));
            } else {
                c = (char) ('0' + data.consumeInt(0, 9));
            }
            sb.append(c);
        }
        return sb.toString();
    }

    private static String buildOverflowDigits(FuzzedDataProvider data) {
        int extra = data.consumeInt(0, 8);
        StringBuilder sb = new StringBuilder(19 + extra);
        sb.append('9');
        for (int i = 0; i < 18 + extra; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static boolean isValidSignedDecimalLong(String suffixed) {
        if (suffixed == null || suffixed.length() < 2) {
            return false;
        }
        char last = suffixed.charAt(suffixed.length() - 1);
        if (last != 'l' && last != 'L') {
            return false;
        }
        String numeric = suffixed.substring(0, suffixed.length() - 1);
        if (numeric.length() == 0) {
            return false;
        }
        int start = 0;
        char first = numeric.charAt(0);
        if (first == '+' || first == '-') {
            if (numeric.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < numeric.length(); i++) {
            if (!Character.isDigit(numeric.charAt(i))) {
                return false;
            }
        }
        return true;
    }
}
