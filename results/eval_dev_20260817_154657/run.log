package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String s : anchors) {
            try {
                String out = StringEscapeUtils.escapeCsv(s);
                /*
                 * Contract asserted: CSV escaping only adds quoting/escaping when the input
                 * contains CSV metacharacters (comma, quote, CR, LF). These anchor inputs are
                 * valid surrogate pairs and contain none of those characters, so a correct
                 * implementation must return them unchanged. A "fix" that merely suppresses the
                 * crash or skips surrogate handling would violate this observable result.
                 */
                if (!s.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must preserve strings without CSV metacharacters input="
                            + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
                }
            } catch (Throwable t) {
                if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                    return;
                }
                boolean rootCause = t instanceof StringIndexOutOfBoundsException;
                if (rootCause) {
                    for (StackTraceElement ste : t.getStackTrace()) {
                        String cls = ste.getClassName();
                        String m = ste.getMethodName();
                        if (("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls) && "translate".equals(m))
                                || ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls) && "translate".equals(m))
                                || ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls) && "translate".equals(m))
                                || ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls) && "translate".equals(m))) {
                            throw (RuntimeException) t;
                        }
                    }
                }
                return;
            }
        }

        String rawPrefix = data.consumeAsciiString(24);
        String rawSuffix = data.consumeAsciiString(24);

        StringBuilder prefixBuilder = new StringBuilder();
        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                prefixBuilder.append(c);
            }
