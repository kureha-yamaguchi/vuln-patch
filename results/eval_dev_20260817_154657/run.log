            throw new RuntimeException("[oracle:" + tag + "-periods] metamorphic violation: getItemCount and getTimePeriods().size() disagree"
                    + " count=" + count
                    + " periodsSize=" + periods.size());
        }

        Object[] periodArray = periods.toArray();
        if (periodArray.length != count) {
            throw new RuntimeException("[oracle:" + tag + "-period-array] metamorphic violation: getTimePeriods().toArray().length and getItemCount() disagree"
                    + " count=" + count
                    + " arrayLength=" + periodArray.length);
        }

        for (int i = 0; i < count; i++) {
