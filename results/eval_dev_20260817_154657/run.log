        if (!(a instanceof Vector2D) || !(b instanceof Vector2D)) {
            return String.valueOf(a).equals(String.valueOf(b));
        }
        Vector2D va = (Vector2D) a;
        Vector2D vb = (Vector2D) b;
        return sameDouble(va.getX(), vb.getX()) && sameDouble(va.getY(), vb.getY());
