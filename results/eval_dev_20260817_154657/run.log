                case 0:
                    probe = data.consumeBoolean() ? "l" : "L";
                    break;
                case 1:
                    probe = (data.consumeBoolean() ? "+" : "-") + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 2:
                    probe = data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 3:
                    probe = data.consumeAsciiString(2) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 4:
                    probe = data.consumeAsciiString(3) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 5:
                    probe = "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 6:
                    probe = data.consumeAsciiString(1) + "." + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 7:
                    probe = data.consumeAsciiString(1) + "e" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 8:
                    probe = data.consumeAsciiString(1) + "E" + data.consumeAsciiString(1) + (data.consumeBoolean() ? "l" : "L");
                    break;
                case 9:
                    probe = data.consumeBoolean() ? "0xL" : "-0xL";
                    break;
                case 10:
                    probe = data.consumeBoolean() ? "1L" : "-1L";
                    break;
                default:
                    probe = data.consumeString(4);
                    break;
            }
            exerciseMalformed(probe);
        }

        {
            String digits = buildDigits(data, 1, 18, false);
            String numeric = (data.consumeBoolean() ? "+" : "") + digits;
            String lowerInput = numeric + "l";
            String upperInput = numeric + "L";
            try {
                Number lower = NumberUtils.createNumber(lowerInput);
                Number upper = NumberUtils.createNumber(upperInput);
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * Contract from NumberUtils.createNumber's explicit long-suffix branch:
                 * for a valid decimal integral string, adding L/l is "requesting a specific type"
                 * and must agree with createLong on the same numeric payload. The unsuffixed form
                 * of the same valid decimal must denote the same numeric value as well.
                 * This directly probes the boundary flipped by the patch: val.length()==1 must reject,
