package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkAnchor("\uD83D\uDE30");
        checkAnchor("\uD800\uDC00");
        checkAnchor("\uD834\uDD1E");
        checkAnchor("\uDBFF\uDFFD");

        String explored = buildSafeSupplementaryString(data);
        if (explored.length() == 0) {
            return;
        }
        checkIdentityOnSafeCsvInput(explored);
    }

    private static void checkAnchor(String s) {
        checkIdentityOnSafeCsvInput(s);
    }

    private static void checkIdentityOnSafeCsvInput(String s) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(s);
            /*
             * Contract/oracle:
             * CSV escaping must leave inputs unchanged when they contain none of:
             * comma, double quote, CR, or LF. The failing test itself asserts
             * identity on surrogate-pair-only inputs. Our constructed inputs contain
             * only safe ASCII plus valid supplementary code points, so a correct
             * implementation must return the original string unchanged.
             * A patch that merely suppresses the crash but drops/duplicates/skips
             * characters would violate this observable post-condition.
             */
            if (!s.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must be identity on CSV-safe input input=" + printable(s) + " lhs=" + printable(escaped) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseOnReachablePath(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseOnReachablePath(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("translate".equals(method)
                    && ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    || "org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls))) {
                return true;
            }
        }
        return false;
    }

    private static String buildSafeSupplementaryString(FuzzedDataProvider data) {
        int parts = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                sb.append(safeAsciiChunk(data));
            } else {
                sb.append(validSupplementaryCodePoint(data));
            }
        }
        if (sb.length() == 0) {
            sb.append(validSupplementaryCodePoint(data));
        }
        return sb.toString();
    }

    private static String safeAsciiChunk(FuzzedDataProvider data) {
        int len = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            int which = data.consumeInt(0, 61);
            char c;
            if (which < 26) {
                c = (char) ('a' + which);
            } else if (which < 52) {
                c = (char) ('A' + (which - 26));
            } else {
                c = (char) ('0' + (which - 52));
            }
            sb.append(c);
        }
        return sb.toString();
    }

    private static String validSupplementaryCodePoint(FuzzedDataProvider data) {
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        return new String(Character.toChars(cp));
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch >= 32 && ch <= 126 && ch != '\\' && ch != '"') {
                sb.append(ch);
            } else {
                String hex = Integer.toHexString(ch).toUpperCase();
                sb.append("\\u");
                for (int p = hex.length(); p < 4; p++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
