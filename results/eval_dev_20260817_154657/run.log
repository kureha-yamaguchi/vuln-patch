package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        runAnchors();

        String base = data.consumeAsciiString(24);
        String activeSearch = data.consumeAsciiString(4);
        if (activeSearch.length() == 0) {
            activeSearch = "a";
        }
        String activeReplacement = data.consumeAsciiString(6);

        String prefix = data.consumeAsciiString(8);
        String suffix = data.consumeRemainingAsString();
        String text = prefix + activeSearch + base + suffix;
        if (text.length() == 0) {
            text = activeSearch;
        }

        int pairs = data.consumeInt(2, 6);
        String[] search = new String[pairs];
        String[] replacement = new String[pairs];

        int activeIndex = data.consumeInt(0, pairs - 1);
        search[activeIndex] = activeSearch;
        replacement[activeIndex] = activeReplacement;

        int inertIndex = data.consumeInt(0, pairs - 1);
        if (inertIndex == activeIndex) {
            inertIndex = (inertIndex + 1) % pairs;
        }

        boolean useNullReplacement = data.consumeBoolean();
        if (useNullReplacement) {
            search[inertIndex] = data.consumeBoolean() ? data.consumeAsciiString(4) : activeSearch + data.consumeAsciiString(2);
            if (search[inertIndex] != null && search[inertIndex].length() == 0) {
                search[inertIndex] = "z";
            }
            replacement[inertIndex] = null;
        } else {
            search[inertIndex] = null;
            replacement[inertIndex] = data.consumeAsciiString(6);
        }

        for (int i = 0; i < pairs; i++) {
            if (i == activeIndex || i == inertIndex) {
                continue;
            }
            int kind = data.consumeInt(0, 4);
            switch (kind) {
                case 0:
                    search[i] = data.consumeAsciiString(4);
                    if (search[i].length() == 0) {
                        search[i] = "x";
                    }
                    replacement[i] = data.consumeAsciiString(6);
                    break;
                case 1:
                    search[i] = null;
                    replacement[i] = data.consumeAsciiString(6);
                    break;
                case 2:
                    search[i] = data.consumeAsciiString(4);
                    replacement[i] = null;
                    break;
                case 3:
                    search[i] = "";
                    replacement[i] = data.consumeAsciiString(6);
                    break;
                default:
                    search[i] = data.consumeAsciiString(4);
                    if (search[i].length() == 0) {
                        search[i] = "y";
                    }
                    replacement[i] = data.consumeAsciiString(6);
                    break;
            }
        }

        exerciseMetamorphic(text, search, replacement);
    }

    private static void runAnchors() {
        attemptValidCase("aba", new String[]{"a"}, new String[]{null});
        attemptValidCase("aba", new String[]{null}, new String[]{"a"});
        attemptValidCase("aba", new String[]{"a", "b"}, new String[]{"c", null});
        attemptValidCase(null, new String[]{"a"}, new String[]{"b"});
        attemptValidCase("aba", null, null);
        attemptValidCase("aba", new String[0], null);
        attemptValidCase("aba", null, new String[0]);
        attemptValidCase("aba", new String[]{"a"}, null);
    }

    private static void exerciseMetamorphic(String text, String[] search, String[] replacement) {
        try {
            String lhs = StringUtils.replaceEach(text, search, replacement);

            String[] filteredSearch = new String[search.length];
            String[] filteredReplacement = new String[replacement.length];
            int kept = 0;
            for (int i = 0; i < search.length; i++) {
                String s = search[i];
                String r = replacement[i];
                if (s == null || s.length() == 0 || r == null) {
                    continue;
                }
                filteredSearch[kept] = s;
                filteredReplacement[kept] = r;
                kept++;
            }

            String[] compactSearch = new String[kept];
            String[] compactReplacement = new String[kept];
            for (int i = 0; i < kept; i++) {
                compactSearch[i] = filteredSearch[i];
                compactReplacement[i] = filteredReplacement[i];
            }

            String rhs = StringUtils.replaceEach(text, compactSearch, compactReplacement);

            int lhsLen = StringUtils.length(lhs);
            int rhsLen = StringUtils.length(rhs);

            if ((lhs == null && rhs != null) || (lhs != null && !lhs.equals(rhs)) || lhsLen != rhsLen) {
                throw new RuntimeException(
                    "[oracle:ignore-inert] metamorphic violation: removing pairs with null search, empty search, or null replacement changed result"
                        + " text=" + String.valueOf(text)
                        + " lhs=" + String.valueOf(lhs)
                        + " rhs=" + String.valueOf(rhs)
                        + " lhsLen=" + lhsLen
                        + " rhsLen=" + rhsLen
                );
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(e)) {
                throw e;
            }
            if (isOracleViolation(e)) {
                throw e;
            }
        }
    }

    private static void attemptValidCase(String text, String[] search, String[] replacement) {
        try {
            StringUtils.replaceEach(text, search, replacement);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCauseNpeFromPatchedRegion(e) && isValidByConstruction(text, search, replacement)) {
                throw e;
            }
        }
    }

    private static boolean isValidByConstruction(String text, String[] search, String[] replacement) {
        if (text == null || search == null || replacement == null) {
            return false;
        }
        if (search.length != replacement.length) {
            return false;
        }
        boolean hasReachableMatch = false;
        boolean hasIgnoredElement = false;
        for (int i = 0; i < search.length; i++) {
            String s = search[i];
            String r = replacement[i];
            if (s == null || s.length() == 0 || r == null) {
                hasIgnoredElement = true;
            } else if (text.indexOf(s) >= 0) {
                hasReachableMatch = true;
            }
        }
        return hasReachableMatch && hasIgnoredElement;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleViolation(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isRootCauseNpeFromPatchedRegion(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
