public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (CloneNotSupportedException e) {
            return;
        } catch (com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow e) {
            throw e;
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            return;
        }

        int rounds = data.consumeInt(1, 6);
        for (int r = 0; r < rounds; r++) {
            TimeSeries series = new TimeSeries(
                    "Fuzz-" + r + "-" + data.consumeAsciiString(8),
                    "domain",
                    "range",
                    Day.class);

            Day left;
            Day right;
            int gapSize = data.consumeInt(1, 28);
            int beforeCount = data.consumeInt(0, 4);
            int afterCount = data.consumeInt(0, 4);
            try {
                left = new Day(
                        data.consumeInt(1, 20),
                        data.consumeInt(1, 12),
                        data.consumeInt(1995, 2015));
                right = addDays(left, gapSize + 1);
            } catch (RuntimeException e) {
                return;
            }

            try {
                for (int i = beforeCount; i > 0; i--) {
                    series.add(addDays(left, -i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
                series.add(left, Integer.valueOf(data.consumeInt(-1000, 1000)));
                series.add(right, Integer.valueOf(data.consumeInt(-1000, 1000)));
                for (int i = 1; i <= afterCount; i++) {
                    series.add(addDays(right, i), Integer.valueOf(data.consumeInt(-1000, 1000)));
                }
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            try {
                checkSeriesViewConsistency(series, "source");
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            Day start;
            Day end;
            int startOffset = data.consumeInt(1, gapSize);
            int endOffset = data.consumeInt(startOffset, gapSize);
            try {
                start = addDays(left, startOffset);
                end = addDays(left, endOffset);
            } catch (RuntimeException e) {
                return;
            }

            if (start.compareTo(end) > 0) {
                return;
            }

            int rawStartIndex;
            int rawEndIndex;
            int manualCount = 0;
            try {
                for (int i = 0; i < series.getItemCount(); i++) {
                    RegularTimePeriod p = series.getTimePeriod(i);
                    if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                        manualCount++;
                    }
                    if (series.getIndex(p) != i) {
                        throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                                "[oracle:index-roundtrip] consistency violation: getIndex/getTimePeriod disagree"
                                        + " index=" + i
                                        + " period=" + p
                                        + " roundTrip=" + series.getIndex(p));
                    }
                }
                rawStartIndex = series.getIndex(start);
                rawEndIndex = series.getIndex(end);
            } catch (RuntimeException e) {
                if (isOracleFailure(e)) {
                    throw e;
                }
                return;
            }

            if (manualCount != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:constructed-gap] metamorphic violation: chosen range must lie strictly inside a real gap"
                                + " manualCount=" + manualCount
                                + " start=" + start
                                + " end=" + end);
            }
            if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:gap-absent] metamorphic violation: both endpoints inside the gap must be absent"
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex
                                + " start=" + start
                                + " end=" + end);
            }

            int computedStartIndex = insertionPoint(rawStartIndex);
            int computedEndIndex = insertionPoint(rawEndIndex) - 1;
            if (!(computedEndIndex < computedStartIndex)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:flipped-condition] metamorphic violation: constructed empty-gap input must flip the patched condition"
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex
                                + " computedStartIndex=" + computedStartIndex
                                + " computedEndIndex=" + computedEndIndex
                                + " start=" + start
                                + " end=" + end);
            }

            try {
                /*
                 * Contract asserted:
                 * createCopy(start,end) returns the inclusive subseries for ordered, non-null periods.
                 * For a valid range wholly inside a real gap, the result must be an empty series.
                 * A throw-deleting or guard-skipping patch can avoid the historical exception yet still
                 * return a wrong/non-empty copy or inconsistent shared-state views, so we cross-check:
                 * getItemCount(), getItems(), getTimePeriods(), and getDataItem() must all agree.
                 */
                TimeSeries copy = series.createCopy(start, end);
                checkSeriesViewConsistency(copy, "empty-gap-copy");
                if (copy.getItemCount() != 0) {
                    throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                            "[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                                    + " copyCount=" + copy.getItemCount()
                                    + " rawStartIndex=" + rawStartIndex
                                    + " rawEndIndex=" + rawEndIndex
                                    + " start=" + start
                                    + " end=" + end);
                }

                Day innerStart = start;
                Day innerEnd = end;
                if (startOffset < endOffset) {
                    int innerStartOffset = data.consumeInt(startOffset, endOffset);
                    int innerEndOffset = data.consumeInt(innerStartOffset, endOffset);
                    innerStart = addDays(left, innerStartOffset);
                    innerEnd = addDays(left, innerEndOffset);
                }
                TimeSeries innerCopy = series.createCopy(innerStart, innerEnd);
                checkSeriesViewConsistency(innerCopy, "inner-gap-copy");
                if (innerCopy.getItemCount() != 0
                        || innerCopy.getItems().size() != 0
                        || innerCopy.getTimePeriods().size() != 0) {
                    throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                            "[oracle:subgap-empty] metamorphic violation: any ordered subrange within the same real gap must also be empty"
                                    + " outer=[" + start + "," + end + "]"
                                    + " inner=[" + innerStart + "," + innerEnd + "]"
                                    + " innerCount=" + innerCopy.getItemCount()
                                    + " innerItems=" + innerCopy.getItems().size()
                                    + " innerPeriods=" + innerCopy.getTimePeriods().size());
                }

                checkBoundaryStepRight(series, start, right);
                checkBoundaryStepLeft(series, left, end);

                int chosen = data.consumeInt(0, series.getItemCount() - 1);
                RegularTimePeriod exact = series.getTimePeriod(chosen);
                TimeSeries byPeriod = series.createCopy(exact, exact);
                TimeSeries byIndex = series.createCopy(chosen, chosen);
                checkSeriesViewConsistency(byPeriod, "singleton-by-period");
                checkSeriesViewConsistency(byIndex, "singleton-by-index");
                assertEquivalentSeries(byPeriod, byIndex, "overload-singleton");
            } catch (CloneNotSupportedException e) {
                return;
            } catch (RuntimeException e) {
                if (isCleanValidationFromPatchedRegion(e)) {
                    throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                            "[oracle:valid-empty-gap] metamorphic violation: valid ordered non-null periods inside a real gap must not be rejected"
                                    + " start=" + start
                                    + " end=" + end
