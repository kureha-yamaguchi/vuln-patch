private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            throw new RuntimeException("[oracle:right-boundary-present] metamorphic violation: right boundary period must exist"
                    + " right=" + exactRight
                    + " rightIndex=" + rightIndex);
        }

        TimeSeries byBoundary = series.createCopy(absentStart, exactRight);
        TimeSeries byIndex = series.createCopy(rightIndex, rightIndex);

        checkSeriesViewConsistency(byBoundary, "boundary-right-byBoundary");
        checkSeriesViewConsistency(byIndex, "boundary-right-byIndex");

        if (byBoundary.getItemCount() != 1 || byIndex.getItemCount() != 1) {
            throw new RuntimeException("[oracle:boundary-step-right] metamorphic violation: stepping end to the exact right boundary must yield its singleton"
                    + " byBoundaryCount=" + byBoundary.getItemCount()
                    + " byIndexCount=" + byIndex.getItemCount()
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight
                    + " rightIndex=" + rightIndex);
        }
        if (!byBoundary.getTimePeriod(0).equals(byIndex.getTimePeriod(0))) {
            throw new RuntimeException("[oracle:boundary-right-period] metamorphic violation: right-boundary singleton period mismatch"
                    + " byBoundaryPeriod=" + byBoundary.getTimePeriod(0)
                    + " byIndexPeriod=" + byIndex.getTimePeriod(0)
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
        Number vb = byBoundary.getValue(0);
        Number vi = byIndex.getValue(0);
        if (vb == null ? vi != null : !vb.equals(vi)) {
            throw new RuntimeException("[oracle:boundary-right-value] metamorphic violation: right-boundary singleton value mismatch"
                    + " byBoundaryValue=" + vb
                    + " byIndexValue=" + vi
                    + " absentStart=" + absentStart
                    + " exactRight=" + exactRight);
        }
    }
