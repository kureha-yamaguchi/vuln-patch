package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (int i = 0; i < anchors.length; i++) {
            exercise(anchors[i], true, true);
        }

        int pairs = data.consumeInt(1, 4);
        StringBuilder sb = new StringBuilder();

        String prefix = sanitizeAscii(data.consumeAsciiString(12), data.consumeBoolean());
        sb.append(prefix);

        for (int i = 0; i < pairs; i++) {
            int codePoint;
            if (data.consumeBoolean()) {
                int[] interesting = new int[] {0x10000, 0x1D11E, 0x1F630, 0x10FFFD};
                codePoint = interesting[data.consumeInt(0, interesting.length - 1)];
            } else {
                codePoint = data.consumeInt(0x10000, 0x10FFFD);
            }
            sb.append(Character.toChars(codePoint));

            if (i + 1 < pairs) {
                sb.append(sanitizeAscii(data.consumeAsciiString(8), data.consumeBoolean()));
            }
        }

        sb.append(sanitizeAscii(data.consumeRemainingAsString(), data.consumeBoolean()));
        String fuzzed = sb.toString();

        exercise(fuzzed, true, false);

        StringBuilder noCsvSpecials = new StringBuilder();
        noCsvSpecials.append(stripCsvSpecials(data.consumeAsciiString(10)));
        noCsvSpecials.append(Character.toChars(data.consumeInt(0x10000, 0x10FFFD)));
        noCsvSpecials.append(stripCsvSpecials(data.consumeAsciiString(10)));
        exercise(noCsvSpecials.toString(), false, false);
    }

    private static void exercise(String input, boolean checkRoundTrip, boolean anchorMustBeIdentity) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);

            if (anchorMustBeIdentity && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-anchor] metamorphic violation: escapeCsv must leave CSV-safe surrogate-pair input unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }

            if (!containsCsvSpecial(input) && !input.equals(escaped)) {
                throw new RuntimeException("[oracle:csv-safe-identity] metamorphic violation: CSV-safe input must remain unchanged input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }

            if (checkRoundTrip) {
                /* Contract asserted: unescapeCsv is the inverse of escapeCsv for valid CSV text,
                   so for any non-null, valid-by-construction Java string x, unescapeCsv(escapeCsv(x)) == x.
                   A patch that merely skips bookkeeping or silently drops/corrupts characters can avoid the crash
                   yet violate this observable round-trip relation. */
                try {
                    String unescaped = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);
                    if (!input.equals(unescaped)) {
                        throw new RuntimeException("[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) must equal x input="
                                + printable(input) + " lhs=" + printable(unescaped) + " rhs=" + printable(input));
                    }
                } catch (Throwable t) {
                    if (t instanceof RuntimeException && isOracleFailure(t)) {
                        throw (RuntimeException) t;
                    }
                    if (isCleanRejection(t)) {
                        return;
                    }
                    if (isRootCause(t)) {
                        throwAsRuntime(t);
                    }
                    return;
                }
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && isOracleFailure(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsRuntime(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static void throwAsRuntime(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }

    private static boolean containsCsvSpecial(String s) {
        return s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0 || s.indexOf('\r') >= 0;
    }

    private static String sanitizeAscii(String s, boolean allowCsvSpecials) {
        if (allowCsvSpecials) {
            return s;
        }
        return stripCsvSpecials(s);
    }

    private static String stripCsvSpecials(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\n' && c != '\r') {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String printable(String s) {
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    out.append("\\\\");
                    break;
                case '"':
                    out.append("\\\"");
                    break;
                case '\n':
                    out.append("\\n");
                    break;
                case '\r':
                    out.append("\\r");
                    break;
                case '\t':
                    out.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        out.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            out.append('0');
                        }
                        out.append(hex);
                    } else {
                        out.append(c);
                    }
            }
        }
        out.append('"');
        return out.toString();
    }
}
