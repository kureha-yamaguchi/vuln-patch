    private static Day addDays(Day base, int delta) {
        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        cal.clear();
        cal.set(base.getYear(), base.getMonth() - 1, base.getDayOfMonth(), 0, 0, 0);
        cal.add(Calendar.DATE, delta);
        return new Day(cal.getTime());
    }

