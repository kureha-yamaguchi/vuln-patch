        BSPTree<Euclidean2D> plus = new BSPTree<Euclidean2D>(Boolean.TRUE);
        BSPTree<Euclidean2D> minus = new BSPTree<Euclidean2D>(Boolean.FALSE);
        BoundaryAttribute<Euclidean2D> attr = new BoundaryAttribute<Euclidean2D>(null, null);
