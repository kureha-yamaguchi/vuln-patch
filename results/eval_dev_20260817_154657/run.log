package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCreateNumber("1234.5", true);

        // Contract asserted below:
        // For any successfully parsed number n, parsing n.toString() must recover the same numeric value.
        // This is a sound round-trip/metamorphic relation using only real library calls.
        checkRoundTripConsistency("1234.5");

        String constructed = buildValidNumericString(data);
        exerciseCreateNumber(constructed, true);
        checkRoundTripConsistency(constructed);

        String[] sciPair = buildEquivalentScientificCasePair(data);
        if (sciPair != null) {
            checkEquivalentScientificExponentCase(sciPair[0], sciPair[1]);
            exerciseCreateNumber(sciPair[0], true);
            exerciseCreateNumber(sciPair[1], true);
            checkRoundTripConsistency(sciPair[0]);
            checkRoundTripConsistency(sciPair[1]);
        }

        String[] decimalPair = buildEquivalentDecimalPair(data);
        if (decimalPair != null) {
            checkEquivalentDecimals(decimalPair[0], decimalPair[1]);
            exerciseCreateNumber(decimalPair[0], true);
            exerciseCreateNumber(decimalPair[1], true);
            checkRoundTripConsistency(decimalPair[0]);
            checkRoundTripConsistency(decimalPair[1]);
        }

        String boundary = buildBoundaryAroundExponentPosition(data);
        if (boundary != null) {
            exerciseCreateNumber(boundary, true);
            checkRoundTripConsistency(boundary);
        }
    }

    private static void exerciseCreateNumber(String s, boolean validByConstruction) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (validByConstruction && isRelevantRootCause(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (isRelevantRootCause(t) && validByConstruction) {
                throw t;
            }
        }
    }

    private static void checkRoundTripConsistency(String s) {
        try {
            Number first = NumberUtils.createNumber(s);
            if (first == null) {
                return;
            }
            String canonical = first.toString();
            Number reparsed = NumberUtils.createNumber(canonical);
            if (reparsed != null && !sameNumericValue(first, reparsed)) {
                throw new RuntimeException("[oracle:roundtrip-canonical-number] metamorphic violation: createNumber(x).toString() reparsed to different quantity input="
                        + s + " canonical=" + canonical + " first=" + first + " reparsed=" + reparsed);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentScientificExponentCase(String lower, String upper) {
        try {
            Number lhs = NumberUtils.createNumber(lower);
            Number rhs = NumberUtils.createNumber(upper);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:scientific-exp-case-equivalence] metamorphic violation: exponent marker case changed value inputLower="
                        + lower + " inputUpper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static void checkEquivalentDecimals(String a, String b) {
        try {
            Number lhs = NumberUtils.createNumber(a);
            Number rhs = NumberUtils.createNumber(b);
            if (lhs != null && rhs != null && !sameNumericValue(lhs, rhs)) {
                throw new RuntimeException("[oracle:decimal-trailing-zero-equivalence] metamorphic violation: equivalent decimals disagreed inputA="
                        + a + " inputB=" + b + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isCleanReject(t) || isRelevantRootCause(t)) {
                return;
            }
        }
    }

    private static boolean sameNumericValue(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        if (isFloatingLike(a) || isFloatingLike(b)) {
            double da = a.doubleValue();
            double db = b.doubleValue();
            if (Double.isNaN(da) || Double.isNaN(db)) {
                return Double.isNaN(da) && Double.isNaN(db);
            }
            if (Double.isInfinite(da) || Double.isInfinite(db)) {
                return da == db;
            }
        }
        try {
            BigDecimal left = toBigDecimal(a);
            BigDecimal right = toBigDecimal(b);
            return left.compareTo(right) == 0;
        } catch (RuntimeException ignored) {
            return String.valueOf(a).equals(String.valueOf(b));
        }
    }

    private static boolean isFloatingLike(Number n) {
        return n instanceof Float || n instanceof Double;
    }

    private static BigDecimal toBigDecimal(Number n) {
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        }
        if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        }
        if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        }
        if (n instanceof Float || n instanceof Double) {
            return new BigDecimal(n.toString());
        }
        return new BigDecimal(String.valueOf(n));
    }

    private static boolean isCleanReject(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof IndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang3.math.NumberUtils".equals(e.getClassName())
                    && "createNumber".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidNumericString(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int intDigits = data.consumeInt(1, 6);
        String intPart = digits(data, intDigits, true);

        int style = data.consumeInt(0, 4);
        String s;
        if (style == 0) {
            s = intPart;
        } else if (style == 1) {
            int fracDigits = data.consumeInt(1, 6);
            s = intPart + "." + digits(data, fracDigits, false);
        } else if (style == 2) {
            int fracDigits = data.consumeInt(1, 6);
            int expVal = data.consumeInt(-30, 30);
            s = intPart + "." + digits(data, fracDigits, false) + (data.consumeBoolean() ? "e" : "E") + expVal;
        } else if (style == 3) {
            long val = data.consumeInt(0, 1000000);
            s = Long.toString(val) + (data.consumeBoolean() ? "L" : "l");
            if (negative && val != 0) {
                s = "-" + s;
            }
            return s;
        } else {
            int fracDigits = data.consumeInt(1, 6);
            char suffix;
            int pick = data.consumeInt(0, 3);
            if (pick == 0) {
                suffix = 'F';
            } else if (pick == 1) {
                suffix = 'f';
            } else if (pick == 2) {
                suffix = 'D';
            } else {
                suffix = 'd';
            }
            s = intPart + "." + digits(data, fracDigits, false) + suffix;
        }

        if (negative && !isZeroNumericString(s)) {
            s = "-" + s;
        }
        return s;
    }

    private static String[] buildEquivalentScientificCasePair(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        String mantissa;
        if (data.consumeBoolean()) {
            mantissa = digits(data, data.consumeInt(1, 6), true) + "." + digits(data, data.consumeInt(1, 6), false);
        } else {
            mantissa = digits(data, data.consumeInt(1, 6), true);
        }
        int expVal = data.consumeInt(-30, 30);
        String expText = Integer.toString(expVal);
        if (negative && !isZeroNumericString(mantissa)) {
            mantissa = "-" + mantissa;
        }
        return new String[] { mantissa + "e" + expText, mantissa + "E" + expText };
    }

    private static String[] buildEquivalentDecimalPair(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        String intPart = digits(data, data.consumeInt(1, 6), true);
        String fracCore = digits(data, data.consumeInt(1, 4), false);
        int zeros = data.consumeInt(1, 4);
        StringBuilder padded = new StringBuilder(fracCore);
        for (int i = 0; i < zeros; i++) {
            padded.append('0');
        }
        String a = intPart + "." + fracCore;
        String b = intPart + "." + padded.toString();
        if (negative && !isZeroNumericString(a)) {
            a = "-" + a;
            b = "-" + b;
        }
        return new String[] { a, b };
    }

    private static String buildBoundaryAroundExponentPosition(FuzzedDataProvider data) {
        // Valid-by-construction inputs around exponent-marker placement.
        // These exercise the same parsing logic as the patched expPos boundary.
        int variant = data.consumeInt(0, 3);
        String base = digits(data, data.consumeInt(1, 6), true);
        boolean negative = data.consumeBoolean();
        String s;
        if (variant == 0) {
            s = base + "." + digits(data, data.consumeInt(1, 6), false);
        } else if (variant == 1) {
            s = base + "e" + data.consumeInt(-20, 20);
        } else if (variant == 2) {
            s = base + "." + digits(data, data.consumeInt(1, 6), false) + "E" + data.consumeInt(-20, 20);
        } else {
            s = base + (data.consumeBoolean() ? "F" : "D");
        }
        if (negative && !isZeroNumericString(s)) {
            s = "-" + s;
        }
        return s;
    }

    private static String digits(FuzzedDataProvider data, int count, boolean firstNonZero) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < count; i++) {
            int d;
            if (i == 0 && firstNonZero) {
                d = data.consumeInt(1, 9);
            } else {
                d = data.consumeInt(0, 9);
            }
            sb.append((char) ('0' + d));
        }
        return sb.toString();
    }

    private static boolean isZeroNumericString(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '1' && c <= '9') {
                return false;
            }
        }
        return true;
    }
}
