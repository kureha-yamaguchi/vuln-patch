    private static void runAnchor() {
        TimeSeries s = new TimeSeries("S");
        try {
            Day left = new Day(19, 8, 2005);
            Day right = new Day(31, 1, 2006);
            Day start = new Day(1, 12, 2005);
            Day end = new Day(18, 1, 2006);
            s.add(left, Integer.valueOf(1));
            s.add(right, Integer.valueOf(1));
            exerciseGapCase(s, left, right, start, end);
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void exerciseGapCase(TimeSeries series, Day exactLeft, Day exactRight, Day start, Day end)
            throws CloneNotSupportedException {
        if (series == null || start == null || end == null || exactLeft == null || exactRight == null) {
            return;
        }
        if (start.compareTo(end) > 0) {
            return;
        }

        checkSeriesViewConsistency(series, "source");

        int manualCount = 0;
        for (int i = 0; i < series.getItemCount(); i++) {
            RegularTimePeriod p = series.getTimePeriod(i);
            if (p.compareTo(start) >= 0 && p.compareTo(end) <= 0) {
                manualCount++;
            }
            if (series.getIndex(p) != i) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:index-roundtrip] consistency violation: getIndex/getTimePeriod disagree"
                                + " label=source"
                                + " index=" + i
                                + " roundTrip=" + series.getIndex(p)
                                + " period=" + p);
            }
        }

        int rawStartIndex = series.getIndex(start);
        int rawEndIndex = series.getIndex(end);
        if (manualCount != 0) {
            return;
        }
        if (!(rawStartIndex < 0 && rawEndIndex < 0)) {
            return;
        }

        int startIndex = insertionPoint(rawStartIndex);
        int endIndex = insertionPoint(rawEndIndex) - 1;
        if (!(endIndex < startIndex)) {
            return;
        }

        TimeSeries copy;
        try {
            copy = series.createCopy(start, end);
        } catch (RuntimeException e) {
            if (isCleanValidation(e) && passesPatchedRegion(e)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:valid-gap-reject] metamorphic violation: valid ordered non-null periods inside a real gap must not be rejected"
                                + " start=" + start
                                + " end=" + end
                                + " rawStartIndex=" + rawStartIndex
                                + " rawEndIndex=" + rawEndIndex,
                        e);
            }
            throw e;
        }

        checkSeriesViewConsistency(copy, "gap-copy");

        /*
         * Contract asserted: createCopy(start, end) returns the inclusive subseries.
         * For a valid ordered range wholly inside a real gap, that subseries is empty.
         * A throw-deleting patch that returns this or another wrong view violates this.
         */
        if (copy.getItemCount() != 0 || copy.getItems().size() != 0 || copy.getTimePeriods().size() != 0) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "[oracle:gap-empty] metamorphic violation: createCopy for a valid empty gap must return an empty series"
                            + " copyCount=" + copy.getItemCount()
                            + " copyItems=" + copy.getItems().size()
                            + " copyPeriods=" + copy.getTimePeriods().size()
                            + " startIndex=" + startIndex
                            + " endIndex=" + endIndex
                            + " start=" + start
                            + " end=" + end);
        }

        checkBoundaryStepRight(series, start, exactRight);
        checkBoundaryStepLeft(series, exactLeft, end);

        if (startIndex == 1) {
            TimeSeries emptyByGap = series.createCopy(start, end);
            TimeSeries rightSingleton = series.createCopy(series.getIndex(exactRight), series.getIndex(exactRight));
            TimeSeries leftSingleton = series.createCopy(series.getIndex(exactLeft), series.getIndex(exactLeft));
            TimeSeries rightBoundary = series.createCopy(start, exactRight);
            TimeSeries leftBoundary = series.createCopy(exactLeft, end);

            checkSeriesViewConsistency(emptyByGap, "startIndex1-empty");
            checkSeriesViewConsistency(rightSingleton, "startIndex1-right-singleton");
            checkSeriesViewConsistency(leftSingleton, "startIndex1-left-singleton");
            checkSeriesViewConsistency(rightBoundary, "startIndex1-right-boundary");
            checkSeriesViewConsistency(leftBoundary, "startIndex1-left-boundary");

            if (emptyByGap.getItemCount() != 0) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:flip-empty] metamorphic violation: boundary case startIndex==1 still must produce an empty copy"
                                + " count=" + emptyByGap.getItemCount()
                                + " start=" + start
                                + " end=" + end);
            }

            /*
             * Contract asserted: moving one boundary from an absent period inside the gap
             * to the exact present endpoint must yield that endpoint's singleton subseries.
             * This flips the patched condition at startIndex == 1 without relying on the old throw.
             */
            assertEquivalentSeries(rightBoundary, rightSingleton, "flip-right-boundary");
            assertEquivalentSeries(leftBoundary, leftSingleton, "flip-left-boundary");
        }
    }

    private static void checkBoundaryStepRight(TimeSeries series, Day absentStart, Day exactRight)
            throws CloneNotSupportedException {
        int rightIndex = series.getIndex(exactRight);
        if (rightIndex < 0) {
            return;
        }

        TimeSeries byBoundary;
        TimeSeries byIndex;
        try {
            byBoundary = series.createCopy(absentStart, exactRight);
            byIndex = series.createCopy(rightIndex, rightIndex);
        } catch (RuntimeException e) {
            if (isCleanValidation(e) && passesPatchedRegion(e)) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "[oracle:boundary-step-right] metamorphic violation: stepping the end to an exact present right boundary must yield its singleton"
                                + " absentStart=" + absentStart
                                + " exactRight=" + exactRight
                                + " rightIndex=" + rightIndex,
                        e);
            }
            throw e;
        }

        checkSeriesViewConsistency(byBoundary, "boundary-right-by-boundary");
        checkSeriesViewConsistency(byIndex, "boundary-right-by-index");
        assertEquivalentSeries(byBoundary, byIndex, "boundary-right");
    }

    private static void checkBoundaryStepLeft(TimeSeries series, Day exactLeft, Day absentEnd)
            throws CloneNotSupportedException {
        int leftIndex = series.getIndex(exactLeft);
        if (leftIndex < 0) {
