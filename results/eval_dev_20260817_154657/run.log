        int v = b & 0x7F;
        if (v < 32) {
            v += 32;
        }
        if (v > 126) {
            v = 126;
        }
        return (char) v;
    }

    private static String asciiToUpper(String s) {
        char[] out = s.toCharArray();
        for (int i = 0; i < out.length; i++) {
            char c = out[i];
            if (c >= 'a' && c <= 'z') {
