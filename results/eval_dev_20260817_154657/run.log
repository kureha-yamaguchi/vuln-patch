package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCases();

        int pairs = data.consumeInt(1, 8);
        String text = data.consumeString(64);
        if (text == null) {
            text = "";
        }

        String[] search = new String[pairs];
        String[] repl = new String[pairs];

        boolean forceInteresting = data.consumeBoolean();
        int interestingIndex = data.consumeInt(0, pairs - 1);

        for (int i = 0; i < pairs; i++) {
            int kind = data.consumeInt(0, 5);
            String s;
            switch (kind) {
                case 0:
                    s = null;
                    break;
                case 1:
                    s = "";
                    break;
                case 2:
                    s = data.consumeAsciiString(3);
                    break;
                case 3:
                    s = data.consumeString(3);
                    break;
                case 4:
                    s = String.valueOf((char) ('a' + data.consumeInt(0, 5)));
                    break;
                default:
                    s = "a";
                    break;
            }
            search[i] = s;

            kind = data.consumeInt(0, 4);
            String r;
            switch (kind) {
                case 0:
                    r = null;
                    break;
                case 1:
                    r = "";
                    break;
                case 2:
                    r = data.consumeAsciiString(4);
                    break;
                case 3:
                    r = data.consumeString(4);
                    break;
                default:
                    r = "X";
                    break;
            }
            repl[i] = r;
        }

        if (forceInteresting) {
            if (data.consumeBoolean()) {
                search[interestingIndex] = data.consumeBoolean() ? null : "";
                repl[interestingIndex] = data.consumeBoolean() ? null : data.consumeString(4);
            } else {
                search[interestingIndex] = pickPresentNeedle(text, data);
                repl[interestingIndex] = null;
            }
        }

        if (allEntriesSkipped(search, repl)) {
            int idx = interestingIndex;
            search[idx] = pickPresentNeedle(text, data);
            if (search[idx] == null || search[idx].length() == 0) {
                search[idx] = "a";
                text = text + "a";
            }
            repl[idx] = null;
        }

        tryReplaceAndOracle(text, search, repl);
    }

    private static void runAnchorCases() {
        try {
            String r = StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" });
            if (r != null) {
                throw new RuntimeException("[oracle:anchor-null-text] metamorphic violation: expected null result input=null lhs=" + r);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", null, null), "anchor-null-arrays");
        assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", new String[0], null), "anchor-empty-search");
        assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", null, new String[0]), "anchor-empty-repl");
        assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", new String[] { "a" }, null), "anchor-null-repl-array");

        try {
            assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" }), "anchor-null-search-elt");
            assertEqualsOrThrow("aba", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { null }), "anchor-null-repl-elt");
            assertEqualsOrThrow("cbc", StringUtils.replaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null }), "anchor-mixed-null-repl");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void tryReplaceAndOracle(String text, String[] search, String[] repl) {
        try {
            String actual = StringUtils.replaceEach(text, search, repl);

            String[] filteredSearch = filterActiveSearch(search, repl);
            String[] filteredRepl = filterActiveRepl(search, repl);
            String expected;
            try {
                expected = StringUtils.replaceEach(text, filteredSearch, filteredRepl);
            } catch (RuntimeException ignored) {
                return;
            }

            /* Contract exercised by the patch and tests: entries with null replacement, null search,
               or empty search are ignored. Therefore calling replaceEach with such inert pairs present
               must behave the same as removing those pairs entirely. A throw-deleting or overfitted patch
               could return a wrong string while suppressing the original NPE; this catches that. */
            if (!equalsNullable(actual, expected)) {
                throw new RuntimeException(
                    "[oracle:ignore-null-pairs] metamorphic violation: inert entries should not affect output input="
                        + safe(text)
                        + " lhs="
                        + safe(actual)
                        + " rhs="
                        + safe(expected)
                );
            }

            try {
                String second = StringUtils.replaceEach(actual, search, repl);
                if (!equalsNullable(actual, second)) {
                    throw new RuntimeException(
                        "[oracle:idempotent-null-pairs] metamorphic violation: once inert entries are ignored, reapplying same replacement set should stay stable input="
                            + safe(text)
                            + " lhs="
                            + safe(actual)
                            + " rhs="
                            + safe(second)
                    );
                }
            } catch (RuntimeException ignored) {
                // Per hygiene rule: if either side throws, skip this check.
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(text, search, repl)) {
                throw t;
            }
        }
    }

    private static boolean isValidByConstruction(String text, String[] search, String[] repl) {
        return text != null && search != null && repl != null && search.length == repl.length;
    }

    private static boolean allEntriesSkipped(String[] search, String[] repl) {
        for (int i = 0; i < search.length && i < repl.length; i++) {
            if (search[i] != null && search[i].length() != 0 && repl[i] != null) {
                return false;
            }
        }
        return true;
    }

    private static String pickPresentNeedle(String text, FuzzedDataProvider data) {
        if (text != null && text.length() > 0 && data.consumeBoolean()) {
            int start = data.consumeInt(0, text.length() - 1);
            int maxLen = Math.min(3, text.length() - start);
