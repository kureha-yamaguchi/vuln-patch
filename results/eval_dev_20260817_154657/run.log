                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
        }

        {
            String overflowDigits = buildOverflowDigits(data);
            String numeric = "+" + overflowDigits;
            String suffixed = numeric + (data.consumeBoolean() ? "L" : "l");
            try {
                Number explicit = NumberUtils.createNumber(suffixed);
                BigInteger helper = NumberUtils.createBigInteger(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);

                /*
                 * Contract from createNumber's shown l/L branch:
                 * if createLong(numeric) overflows, the branch falls back to createBigInteger(numeric).
                 * Therefore explicit-L parsing and unsuffixed parsing of the same valid integral decimal
                 * must both preserve the exact BigInteger value.
                 */
                if (!(explicit instanceof BigInteger)
                        || !(unsuffixed instanceof BigInteger)
                        || helper == null
                        || !helper.equals(explicit)
                        || !helper.equals(unsuffixed)) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-overflow-fallback] metamorphic violation: createNumber(+overflowDigits+L/l) and createNumber(+overflowDigits) must agree with createBigInteger input="
                                    + suffixed + " explicit=" + explicit + " unsuffixed=" + unsuffixed
                                    + " helper=" + helper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
        }

        {
            String core = buildDigits(data, 1, 6, false);
            String lowerInput = core + "l";
            String upperInput = core + "L";
            try {
                Number lower = NumberUtils.createNumber(lowerInput);
                Number upper = NumberUtils.createNumber(upperInput);

                /*
                 * Contract from the same switch branch: case 'l' and case 'L' execute the same logic.
                 * Therefore for identical valid decimal payloads, only changing suffix case must not
                 * change the numeric result or chosen type.
                 */
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || lower.longValue() != upper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:long-suffix-case-equivalence] metamorphic violation: decimal+l and decimal+L must agree inputLower="
                                    + lowerInput + " inputUpper=" + upperInput + " lower=" + lower + " upper=" + upper);
                }
            } catch (RuntimeException e) {
                if (isOracle(e)) {
                    throw e;
                }
                if (isCleanRejection(e) || isRootCauseLeak(e)) {
                    return;
                }
            }
