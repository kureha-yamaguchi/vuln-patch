    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.isEmpty()) {
            return false;
        }
        boolean hasSupplementary = false;
        for (int i = 0; i < s.length(); ) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                return false;
            }
            int cp = Character.codePointAt(s, i);
            int count = Character.charCount(cp);
            if (count == 2) {
                hasSupplementary = true;
            }
            i += count;
        }
        return hasSupplementary;
    }

    private static String buildValidSafeCsvString(FuzzedDataProvider data) {
        int pieces = data.consumeInt(1, 8);
        int supplementaryIndex = data.consumeInt(0, pieces - 1);
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < pieces; i++) {
            boolean useSupplementary = (i == supplementaryIndex) || data.consumeBoolean();
            if (useSupplementary) {
                int cp = data.consumeInt(0x10000, 0x10FFFF);
                sb.appendCodePoint(cp);
            } else {
                sb.append(safeAsciiChar(data.consumeInt(0, 63)));
            }
        }

        if (!containsSupplementary(sb)) {
            sb.appendCodePoint(0x1F600);
        }
        return sb.toString();
    }

    private static boolean containsSupplementary(CharSequence s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i))) {
                return true;
            }
        }
        return false;
    }

    private static char safeAsciiChar(int v) {
        final char[] alphabet = (
            "abcdefghijklmnopqrstuvwxyz" +
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
            "0123456789 _-;:/"
        ).toCharArray();
        return alphabet[v % alphabet.length];
    }

    private static String repr(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
