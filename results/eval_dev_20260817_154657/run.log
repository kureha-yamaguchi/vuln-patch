package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Boolean anchor = invokeToBoolean("off");
        if (anchor != null && anchor.booleanValue()) {
            throw new RuntimeException("[oracle:anchor-off] metamorphic violation: documented false token returned true input=off lhs=" + anchor + " rhs=false");
        }

        String direct = data.consumeAsciiString(3);
        direct = ensureLength3(direct, data);
        direct = forceFirstCharNotY(direct, data);
        invokeToBoolean(direct);

        String container = data.consumeAsciiString(12);
        if (container.length() < 3) {
            while (container.length() < 3) {
                container = container + "x";
            }
        }
        int start = data.consumeInt(0, container.length() - 3);
        String sliced = container.substring(start, start + 3);
        sliced = forceFirstCharNotY(sliced, data);
        invokeToBoolean(sliced);

        String arbitrary = data.consumeAsciiString(8);
        if (arbitrary.length() == 0) {
            arbitrary = "a";
        }
        String toggled = toggleAsciiCase(arbitrary);
        Boolean lhs = invokeToBoolean(arbitrary);
        Boolean rhs = invokeToBoolean(toggled);
        /*
         * Contract/oracle: BooleanUtils.toBoolean(String) performs an ASCII case-insensitive
         * parse for the accepted literals ("true", "on", "yes") and returns false otherwise.
         * Therefore toggling ASCII letter case cannot change the result for any correct
         * implementation. A patch that makes a branch unreachable or silently changes parsing
         * semantics would violate this without needing to throw.
         */
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException("[oracle:case-invariant] metamorphic violation: toBoolean(s) must equal toBoolean(toggleAsciiCase(s)) input=" + arbitrary + " lhs=" + lhs + " rhs=" + rhs);
        }

        String trueVariant = randomCase("true", data);
        Boolean trueResult = invokeToBoolean(trueVariant);
        /*
         * Contract/oracle: the implementation explicitly accepts all case variants of "true".
         * Building a non-empty input from the known canonical literal makes it valid by construction,
         * so a correct implementation must return true rather than silently false.
         */
        if (trueResult != null && !trueResult.booleanValue()) {
            throw new RuntimeException("[oracle:true-literal] metamorphic violation: case-variant of true must parse as true input=" + trueVariant + " lhs=" + trueResult + " rhs=true");
        }

        String yesVariant = randomCase("yes", data);
        Boolean yesResult = invokeToBoolean(yesVariant);
        if (yesResult != null && !yesResult.booleanValue()) {
            throw new RuntimeException("[oracle:yes-literal] metamorphic violation: case-variant of yes must parse as true input=" + yesVariant + " lhs=" + yesResult + " rhs=true");
        }

        String onVariant = randomCase("on", data);
        Boolean onResult = invokeToBoolean(onVariant);
        if (onResult != null && !onResult.booleanValue()) {
            throw new RuntimeException("[oracle:on-literal] metamorphic violation: case-variant of on must parse as true input=" + onVariant + " lhs=" + onResult + " rhs=true");
        }
    }

    private static Boolean invokeToBoolean(String s) {
        try {
            return Boolean.valueOf(BooleanUtils.toBoolean(s));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return null;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement ste = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String ensureLength3(String s, FuzzedDataProvider data) {
        if (s.length() == 3) {
            return s;
        }
        if (s.length() > 3) {
            int start = data.consumeInt(0, s.length() - 3);
            return s.substring(start, start + 3);
        }
        StringBuilder sb = new StringBuilder(s);
        while (sb.length() < 3) {
            char c = (char) ('a' + data.consumeInt(0, 25));
            sb.append(c);
        }
        return sb.substring(0, 3);
    }

    private static String forceFirstCharNotY(String s, FuzzedDataProvider data) {
        if (s.length() != 3) {
            s = ensureLength3(s, data);
        }
        char first = s.charAt(0);
        if (first == 'y' || first == 'Y') {
            char replacement = data.consumeBoolean() ? 'o' : 'x';
            return replacement + s.substring(1);
        }
        return s;
    }

    private static String toggleAsciiCase(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch >= 'a' && ch <= 'z') {
                sb.append((char) (ch - ('a' - 'A')));
            } else if (ch >= 'A' && ch <= 'Z') {
                sb.append((char) (ch + ('a' - 'A')));
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean() && ch >= 'a' && ch <= 'z') {
                sb.append((char) (ch - ('a' - 'A')));
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }
}
