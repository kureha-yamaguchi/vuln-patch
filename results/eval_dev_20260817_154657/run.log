            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException || t instanceof MathIllegalArgumentException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("Invalid") || n.contains("Argument") || n.contains("Format");
    }

    private static Vector3D asVector3D(Vector<Euclidean3D> v) {
        if (v instanceof Vector3D) {
            return (Vector3D) v;
        }
        return null;
    }

    private static boolean isFinite(Vector3D v) {
        return v != null
                && Double.isFinite(v.getX())
                && Double.isFinite(v.getY())
                && Double.isFinite(v.getZ());
    }
}
