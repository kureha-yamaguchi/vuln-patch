                    // Fixed code should reject these malformed suffix requests cleanly.
                    // The buggy code may instead leak the known StringIndexOutOfBoundsException.
                } else {
                    return;
                }
            }
        }

        for (int i = 0; i < 12; i++) {
            String probe = buildBoundaryProbe(data);
            try {
                NumberUtils.createNumber(probe);
            } catch (RuntimeException e) {
                if (isCleanRejection(e) || isKnownRootCause(e)) {
                    // Around the patched boundary, malformed probes are allowed to be rejected.
                } else {
                    return;
                }
            }
        }

        {
            String digits = buildDigits(data, 1, 18);
            String numeric = "+" + digits;
            String lowerInput = numeric + "l";
            String upperInput = numeric + "L";
            try {
                Long helper = NumberUtils.createLong(numeric);
                Number unsuffixed = NumberUtils.createNumber(numeric);
                Number lower = NumberUtils.createNumber(lowerInput);
                Number upper = NumberUtils.createNumber(upperInput);

                /*
                 * Contract visible in NumberUtils.createNumber:
                 * for the explicit l/L branch with an integral decimal payload (dec == null && exp == null),
                 * the method requests that specific long type from the same numeric text via createLong(numeric).
                 * The unsuffixed integral path on the same payload must denote the same value, and 'l'/'L'
                 * share the same logic. A patch that merely suppresses the old exception or skips this branch
                 * would violate this relation even if no crash is thrown.
                 */
                if (!(lower instanceof Long)
                        || !(upper instanceof Long)
                        || helper == null
                        || unsuffixed == null
                        || lower.longValue() != helper.longValue()
                        || upper.longValue() != helper.longValue()
                        || unsuffixed.longValue() != helper.longValue()
                        || lower.longValue() != upper.longValue()) {
                    throw new RuntimeException(
                            "[oracle:plus-signed-long-consistency] metamorphic violation: explicit l/L parsing of a helper-valid '+' decimal must agree with createLong and unsuffixed createNumber input="
                                    + numeric + " lower=" + lower + " upper=" + upper + " helper=" + helper
