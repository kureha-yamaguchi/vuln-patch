package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        class H {
            boolean isOracleFailure(Throwable t) {
                return t instanceof RuntimeException
                        && t.getMessage() != null
                        && t.getMessage().startsWith("[oracle:");
            }

            boolean isCleanReject(Throwable t) {
                for (Throwable c = t; c != null; c = c.getCause()) {
                    if (c instanceof IllegalArgumentException) {
                        return true;
                    }
                }
                return false;
            }

            String digitsOnly(String s) {
                if (s == null || s.length() == 0) {
                    return "0";
                }
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < s.length(); i++) {
                    char ch = s.charAt(i);
                    if (ch >= '0' && ch <= '9') {
                        sb.append(ch);
                    }
                }
                return sb.length() == 0 ? "0" : sb.toString();
            }

            java.math.BigDecimal toBigDecimal(Number n) {
                if (n == null) {
                    return null;
                }
                if (n instanceof java.math.BigDecimal) {
                    return ((java.math.BigDecimal) n).stripTrailingZeros();
                }
                if (n instanceof java.math.BigInteger) {
                    return new java.math.BigDecimal((java.math.BigInteger) n).stripTrailingZeros();
                }
                if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
                    return java.math.BigDecimal.valueOf(n.longValue()).stripTrailingZeros();
                }
                if (n instanceof Float) {
                    float f = ((Float) n).floatValue();
                    if (Float.isNaN(f) || Float.isInfinite(f)) {
                        return null;
                    }
                    return new java.math.BigDecimal(n.toString()).stripTrailingZeros();
                }
                if (n instanceof Double) {
                    double d = ((Double) n).doubleValue();
                    if (Double.isNaN(d) || Double.isInfinite(d)) {
                        return null;
                    }
                    return new java.math.BigDecimal(n.toString()).stripTrailingZeros();
                }
                return new java.math.BigDecimal(n.toString()).stripTrailingZeros();
            }

            boolean sameNumericValue(Number a, Number b) {
                java.math.BigDecimal aa = toBigDecimal(a);
                java.math.BigDecimal bb = toBigDecimal(b);
                return aa != null && bb != null && aa.compareTo(bb) == 0;
            }

            void exercise(String s) {
                try {
                    NumberUtils.createNumber(s);
                } catch (RuntimeException t) {
                    if (isOracleFailure(t)) {
                        throw t;
