package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeRealEntryPoint("off", true);

        invokeRealEntryPoint("oof", true);
        invokeRealEntryPoint("yep", true);

        String exploredLen3 = buildExplorationCandidate(data);
        invokeRealEntryPoint(exploredLen3, true);

        String anotherLen3 = data.consumeAsciiString(3);
        if (anotherLen3.length() < 3) {
            anotherLen3 = padToLen3(anotherLen3, data);
        } else if (anotherLen3.length() > 3) {
            anotherLen3 = anotherLen3.substring(0, 3);
        }
        if (anotherLen3.charAt(0) == 'y' || anotherLen3.charAt(0) == 'Y') {
            anotherLen3 = "o" + anotherLen3.substring(1);
        }
        invokeRealEntryPoint(anotherLen3, true);

        String truthy = buildTruthyToken(data);

        /*
         * Contract/oracle: BooleanUtils.toBoolean(String) is a content-based parser
         * and the tests for this method show that "on", "yes", and "true" are accepted
         * case-insensitively as true. A throw-deleting or branch-skipping "fix" could stop
         * crashing but incorrectly return false for valid mixed-case truthy tokens.
         * We therefore assert:
         *   1) a valid mixed-case truthy token parses to true, and
         *   2) parsing depends on String contents, not object identity, so an equal-but-
         *      different String instance must yield the same result.
         */
        checkTruthyOracle(truthy);
    }

    private static String buildExplorationCandidate(FuzzedDataProvider data) {
        char first = pickNonYAscii(data);
        String tail = data.consumeAsciiString(2);
        if (tail.length() < 2) {
            tail = padToLen(tail, 2, data);
        } else if (tail.length() > 2) {
            tail = tail.substring(0, 2);
        }
        return new String(new char[] { first, tail.charAt(0), tail.charAt(1) });
    }

    private static char pickNonYAscii(FuzzedDataProvider data) {
        int v = data.consumeInt(32, 126);
        char c = (char) v;
        if (c == 'y' || c == 'Y') {
            return 'o';
        }
        return c;
    }

    private static String padToLen3(String s, FuzzedDataProvider data) {
        return padToLen(s, 3, data);
    }

    private static String padToLen(String s, int len, FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder(s == null ? "" : s);
        while (sb.length() < len) {
            sb.append((char) data.consumeInt(32, 126));
        }
        if (sb.length() > len) {
            return sb.substring(0, len);
        }
        return sb.toString();
    }

    private static String buildTruthyToken(FuzzedDataProvider data) {
        int which = data.consumeInt(0, 2);
        String base;
        if (which == 0) {
            base = "on";
        } else if (which == 1) {
            base = "yes";
        } else {
            base = "true";
        }
        StringBuilder sb = new StringBuilder(base.length());
        for (int i = 0; i < base.length(); i++) {
            char ch = base.charAt(i);
            sb.append(data.consumeBoolean() ? Character.toUpperCase(ch) : Character.toLowerCase(ch));
        }
        return sb.toString();
    }

    private static void checkTruthyOracle(String s) {
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(new StringBuffer(s).toString());
            if (lhs != rhs) {
                throw new RuntimeException("[oracle:content-eq] metamorphic violation: equal-content strings must parse identically input=" + quote(s) + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (!lhs) {
                throw new RuntimeException("[oracle:truthy-case] metamorphic violation: mixed-case accepted truthy token must parse as true input=" + quote(s) + " lhs=" + lhs);
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t, true)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleSignal(t)) {
                throw t;
            }
        }
    }

    private static void invokeRealEntryPoint(String s, boolean validByConstruction) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (shouldPropagate(t, validByConstruction)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean shouldPropagate(Throwable t, boolean validByConstruction) {
        return validByConstruction && isRootCause(t);
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isOracleSignal(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static String quote(String s) {
        return s == null ? "null" : ("\"" + s + "\"");
    }
