package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };

        for (String anchor : anchors) {
            try {
                String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(anchor);
                if (!anchor.equals(out)) {
                    throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return the original string when it contains no comma, quote, CR, or LF input=" + anchor + " lhs=" + out + " rhs=" + anchor);
                }
            } catch (RuntimeException t) {
                boolean rootCause = t instanceof StringIndexOutOfBoundsException;
                if (rootCause) {
                    boolean throughPatchedCode = false;
                    for (StackTraceElement ste : t.getStackTrace()) {
                        if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                                && "translate".equals(ste.getMethodName())) {
                            throughPatchedCode = true;
                            break;
                        }
                    }
                    if (throughPatchedCode) {
                        throw t;
                    }
                }
            }
        }

        int prefixLen = data.consumeInt(0, 16);
        int suffixLen = data.consumeInt(0, 16);
        String rawPrefix = data.consumeAsciiString(prefixLen);
        String rawSuffix = data.consumeAsciiString(suffixLen);

        StringBuilder prefix = new StringBuilder();
        for (int i = 0; i < rawPrefix.length(); i++) {
            char c = rawPrefix.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n' || c < 0x20 || c > 0x7e) {
                c = (char) ('a' + (i % 26));
            }
            prefix.append(c);
        }

        StringBuilder suffix = new StringBuilder();
        for (int i = 0; i < rawSuffix.length(); i++) {
            char c = rawSuffix.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n' || c < 0x20 || c > 0x7e) {
                c = (char) ('A' + (i % 26));
            }
            suffix.append(c);
        }

        int pairCount = data.consumeInt(1, 3);
        StringBuilder middle = new StringBuilder();
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            middle.append(new String(Character.toChars(cp)));

            int sepLen = data.consumeInt(0, 4);
            String rawSep = data.consumeAsciiString(sepLen);
            for (int j = 0; j < rawSep.length(); j++) {
                char c = rawSep.charAt(j);
                if (c == ',' || c == '"' || c == '\r' || c == '\n' || c < 0x20 || c > 0x7e) {
                    c = (char) ('m' + (j % 10));
                }
                middle.append(c);
            }
        }

        String candidate = prefix.toString() + middle.toString() + suffix.toString();

        try {
            String out = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(candidate);

            /*
             * Contract asserted: escapeCsv only applies CSV escaping when the input contains
             * comma, double quote, CR, or LF. This candidate is constructed to contain none
             * of those characters, so every correct implementation must return it unchanged.
             * A "fix" that merely skips/short-circuits the crashing bookkeeping can silently
             * drop or duplicate surrogate-pair content and will violate this observable result.
             */
            if (!candidate.equals(out)) {
                throw new RuntimeException("[oracle:csv-identity] metamorphic violation: escapeCsv must return the original string when it contains no comma, quote, CR, or LF input=" + candidate + " lhs=" + out + " rhs=" + candidate);
            }
        } catch (RuntimeException t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }

            boolean rootCause = t instanceof StringIndexOutOfBoundsException;
            if (rootCause) {
                boolean throughPatchedCode = false;
                for (StackTraceElement ste : t.getStackTrace()) {
                    if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                            && "translate".equals(ste.getMethodName())) {
                        throughPatchedCode = true;
                        break;
                    }
                }
                if (throughPatchedCode) {
                    throw t;
                }
            }

            if (t.getClass() == RuntimeException.class && t.getMessage() != null
                    && t.getMessage().startsWith("[oracle:")) {
                throw t;
            }
        }
    }
}
