package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runSeedAndContractCases();
            runNullReplacementBoundaryOracle(data);
        } catch (RuntimeException e) {
            if (isRootCauseNpeFromReplaceEach(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            if (isOracleFailure(e)) {
                throw e;
            }
        }
    }

    private static void runSeedAndContractCases() {
        checkEquals(null, StringUtils.replaceEach(null, new String[] { "a" }, new String[] { "b" }), "anchor-null-text");
        checkEquals("aba", StringUtils.replaceEach("aba", null, null), "anchor-null-arrays");
        checkEquals("aba", StringUtils.replaceEach("aba", new String[0], null), "anchor-empty-search");
        checkEquals("aba", StringUtils.replaceEach("aba", null, new String[0]), "anchor-empty-repl");
        checkEquals("aba", StringUtils.replaceEach("aba", new String[] { "a" }, null), "anchor-null-repl-array");
        checkEquals("aba", StringUtils.replaceEach("aba", new String[] { null }, new String[] { "a" }), "anchor-null-search-element");
        checkEquals("aba", StringUtils.replaceEach("aba", new String[] { "a" }, new String[] { null }), "anchor-null-repl-element");
        checkEquals("cbc", StringUtils.replaceEach("aba", new String[] { "a", "b" }, new String[] { "c", null }), "anchor-mixed-null-repl");
    }

    private static void runNullReplacementBoundaryOracle(FuzzedDataProvider data) {
        String left = data.consumeAsciiString(8);
        String middle = data.consumeAsciiString(8);
        String right = data.consumeAsciiString(8);

        String activeSearch = nonEmptyAscii(data.consumeAsciiString(4), "A");
        String activeReplacement = data.consumeAsciiString(6);
        String ignoredSearch = nonEmptyAscii(data.consumeAsciiString(4), "B");

        if (activeSearch.equals(ignoredSearch)) {
            ignoredSearch = ignoredSearch + "Q";
        }
        if (left.contains("\u0000") || middle.contains("\u0000") || right.contains("\u0000")) {
            return;
        }

        int layout = data.consumeInt(0, 2);
        String text;
        if (layout == 0) {
            text = left + ignoredSearch + middle + activeSearch + right;
        } else if (layout == 1) {
            text = left + activeSearch + middle + ignoredSearch + right;
        } else {
            text = left + ignoredSearch + middle + activeSearch + middle + ignoredSearch + right;
        }

        String secondSearch = nonEmptyAscii(data.consumeAsciiString(3), "C");
        while (secondSearch.equals(activeSearch) || secondSearch.equals(ignoredSearch)) {
            secondSearch = secondSearch + "R";
        }
        String secondReplacement = data.consumeAsciiString(4);

        String[] baseSearch;
        String[] baseReplacement;
        if (data.consumeBoolean()) {
            baseSearch = new String[] { activeSearch };
            baseReplacement = new String[] { activeReplacement };
        } else {
            baseSearch = new String[] { activeSearch, secondSearch };
            baseReplacement = new String[] { activeReplacement, secondReplacement };
        }

        String[] mutatedSearch;
        String[] mutatedReplacement;
        if (data.consumeBoolean()) {
            mutatedSearch = new String[baseSearch.length + 1];
            mutatedReplacement = new String[baseReplacement.length + 1];
            mutatedSearch[0] = ignoredSearch;
            mutatedReplacement[0] = null;
            for (int i = 0; i < baseSearch.length; i++) {
                mutatedSearch[i + 1] = baseSearch[i];
                mutatedReplacement[i + 1] = baseReplacement[i];
            }
        } else {
            mutatedSearch = new String[baseSearch.length + 1];
            mutatedReplacement = new String[baseReplacement.length + 1];
            for (int i = 0; i < baseSearch.length; i++) {
                mutatedSearch[i] = baseSearch[i];
                mutatedReplacement[i] = baseReplacement[i];
            }
            mutatedSearch[baseSearch.length] = ignoredSearch;
            mutatedReplacement[baseReplacement.length] = null;
        }

        String baseResult;
        try {
            baseResult = StringUtils.replaceEach(text, baseSearch, baseReplacement);
        } catch (RuntimeException e) {
            if (isOracleFailure(e)) {
                throw e;
            }
            if (isRootCauseNpeFromReplaceEach(e)) {
                throw e;
            }
            return;
        }

        String mutatedResult;
        try {
            mutatedResult = StringUtils.replaceEach(text, mutatedSearch, mutatedReplacement);
        } catch (RuntimeException e) {
            if (isRootCauseNpeFromReplaceEach(e)) {
                throw e;
            }
            return;
        }

        int baseLen = StringUtils.length(baseResult);
        int mutatedLen = StringUtils.length(mutatedResult);

        /*
         * Contract/oracle:
         * In StringUtils.replaceEach, entries with replacementList[i] == null are skipped by the
         * real matching logic, and the provided tests explicitly require that null replacement
         * elements are ignored. Therefore adding a search->null pair must not change the output,
         * even when that search token occurs in the text. A patch that only suppresses the old
         * crash but mishandles the skipped entry would violate this equality.
         */
        if (baseLen != mutatedLen || !safeEquals(baseResult, mutatedResult)) {
            throw new RuntimeException(
                "[oracle:null-ignore] metamorphic violation: adding ignored null-replacement pair changed result"
                    + " text=" + text
                    + " baseLen=" + baseLen
                    + " mutatedLen=" + mutatedLen
                    + " lhs=" + baseResult
                    + " rhs=" + mutatedResult);
        }
    }

    private static void checkEquals(String expected, String actual, String tag) {
        int expectedLen = StringUtils.length(expected);
        int actualLen = StringUtils.length(actual);
        if (expectedLen != actualLen || !safeEquals(expected, actual)) {
            throw new RuntimeException(
                "[oracle:" + tag + "] metamorphic violation: expected=" + expected + " actual=" + actual);
        }
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static String nonEmptyAscii(String s, String fallback) {
        return (s == null || s.length() == 0) ? fallback : s;
    }

    private static boolean isRootCauseNpeFromReplaceEach(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(frame.getClassName())
                    && "replaceEach".equals(frame.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(frame.getClassName())
                    && "length".equals(frame.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }
}
