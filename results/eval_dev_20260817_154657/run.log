package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        compareIgnoringSkippedEntries(
                "aba",
                new String[] { "a", "b" },
                new String[] { "c", null }
        );

        compareIgnoringSkippedEntries(
                "aba",
                new String[] { null },
                new String[] { "a" }
        );

        compareIgnoringSkippedEntries(
                "aba",
                new String[] { "a" },
                new String[] { null }
        );

        String needle = nonEmpty(data.consumeAsciiString(4), "a");
        String replacement = data.consumeAsciiString(4);
        String filler = data.consumeAsciiString(8);
        String suffix = data.consumeRemainingAsString();
        String text = needle + filler + suffix;

        String ignoredSearch = data.consumeBoolean() ? null : "";
        String ignoredReplacement = data.consumeAsciiString(4);
        compareIgnoringSkippedEntries(
                text,
                new String[] { needle, ignoredSearch },
                new String[] { replacement, ignoredReplacement }
        );

        String deadNeedle = nonEmpty(data.consumeAsciiString(4), "z");
        compareIgnoringSkippedEntries(
                text,
                new String[] { needle, deadNeedle },
                new String[] { replacement, null }
        );

        String ignoredSearch2 = data.consumeBoolean() ? null : "";
        compareIgnoringSkippedEntries(
                text,
                new String[] { ignoredSearch2, needle, deadNeedle },
                new String[] { data.consumeAsciiString(3), replacement, null }
        );
    }

    private static void compareIgnoringSkippedEntries(String text, String[] searchList, String[] replacementList) {
        String lhs;
        try {
            lhs = StringUtils.replaceEach(text, searchList, replacementList);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        int kept = 0;
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                kept++;
            }
        }

        String[] filteredSearch = new String[kept];
        String[] filteredReplacement = new String[kept];
        int pos = 0;
        for (int i = 0; i < searchList.length && i < replacementList.length; i++) {
            if (searchList[i] != null && searchList[i].length() != 0 && replacementList[i] != null) {
                filteredSearch[pos] = searchList[i];
                filteredReplacement[pos] = replacementList[i];
                pos++;
            }
        }

        String rhs;
        try {
            rhs = StringUtils.replaceEach(text, filteredSearch, filteredReplacement);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (lhs == null) {
            if (StringUtils.length(lhs) != 0) {
                throw new RuntimeException("[oracle:length-null] metamorphic violation: null result must have length 0");
            }
        } else if (StringUtils.length(lhs) != lhs.length()) {
            throw new RuntimeException(
                    "[oracle:length-self] metamorphic violation: StringUtils.length disagrees with String.length input="
                            + lhs + " lhs=" + StringUtils.length(lhs) + " rhs=" + lhs.length());
        }

        if (rhs == null) {
            if (StringUtils.length(rhs) != 0) {
                throw new RuntimeException("[oracle:length-null-rhs] metamorphic violation: null result must have length 0");
            }
        } else if (StringUtils.length(rhs) != rhs.length()) {
            throw new RuntimeException(
                    "[oracle:length-self-rhs] metamorphic violation: StringUtils.length disagrees with String.length input="
                            + rhs + " lhs=" + StringUtils.length(rhs) + " rhs=" + rhs.length());
        }

        /*
         * Contract used for this oracle:
         * replaceEach skips entries whose search string is null/empty or whose replacement is null.
         * The upstream tests explicitly require:
         *   replaceEach("aba", new String[]{null}, new String[]{"a"}) == "aba"
         *   replaceEach("aba", new String[]{"a"}, new String[]{null}) == "aba"
         * Therefore removing those skipped entries before the call must not change the result.
         * A throw-deleting / seed-special-casing patch can avoid the crash yet still violate this equivalence.
         */
        if (!StringUtils.equals(lhs, rhs)) {
            throw new RuntimeException(
                    "[oracle:skip-null-entry] metamorphic violation: removing ignored entries changed result text="
                            + text
                            + " lhs=" + lhs
                            + " rhs=" + rhs
                            + " kept=" + kept);
        }

        if (StringUtils.length(lhs) != StringUtils.length(rhs)) {
            throw new RuntimeException(
                    "[oracle:length-eq] metamorphic violation: equal-by-contract results have different lengths text="
                            + text
                            + " lhs=" + lhs
                            + " rhs=" + rhs
                            + " lLen=" + StringUtils.length(lhs)
                            + " rLen=" + StringUtils.length(rhs));
        }
    }

    private static String nonEmpty(String s, String fallback) {
        return (s == null || s.length() == 0) ? fallback : s;
    }

    private static boolean isCleanRejection(Throwable t) {
        while (t != null) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            t = t.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && ("replaceEach".equals(ste.getMethodName()) || "length".equals(ste.getMethodName()))) {
                return true;
            }
        }
        return false;
    }
}
