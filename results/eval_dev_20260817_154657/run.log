package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("\uD83D\uDE30");
        runCase("\uD800\uDC00");
        runCase("\uD834\uDD1E");
        runCase("\uDBFF\uDFFD");

        String prefix = sanitizeSafeAscii(data.consumeAsciiString(16));
        String suffix = sanitizeSafeAscii(data.consumeAsciiString(16));
        int pairCount = data.consumeInt(1, 8);

        StringBuilder sb = new StringBuilder(prefix.length() + suffix.length() + pairCount * 2 + 16);
        sb.append(prefix);
        for (int i = 0; i < pairCount; i++) {
            sb.appendCodePoint(randomSupplementaryCodePoint(data));
            if (data.consumeBoolean()) {
                sb.append(sanitizeSafeAscii(data.consumeAsciiString(8)));
            }
        }
        sb.append(suffix);

        runCase(sb.toString());

        if (data.consumeBoolean()) {
            String surroundingA = sanitizeSafeAscii(data.consumeAsciiString(12));
            String surroundingB = sanitizeSafeAscii(data.consumeAsciiString(12));
            StringBuilder sb2 = new StringBuilder(surroundingA.length() + surroundingB.length() + 4);
            sb2.append(surroundingA);
            sb2.append('\uD83D').append('\uDE30');
            sb2.append(surroundingB);
            runCase(sb2.toString());
        }
    }

    private static void runCase(String input) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract asserted: CSV escaping returns the input unchanged when no CSV quoting
            // is needed. These inputs are built to contain no comma, quote, CR, or LF, so a
            // correct implementation must preserve them exactly. A "fix" that suppresses the
            // crash by skipping/altering translation would violate this observable result.
            if (containsNoCsvMeta(input) && !input.equals(escaped)) {
                throw new RuntimeException(
                    "[oracle:csv-identity] metamorphic violation: escapeCsv must be identity for strings without CSV meta characters input="
                        + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) && isValidByConstruction(input)) {
                throw t;
            }
        }
    }

    private static boolean isValidByConstruction(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        if (!containsNoCsvMeta(s)) {
            return false;
        }
        boolean hasSupplementary = false;
        for (int i = 0; i < s.length();) {
            char ch = s.charAt(i);
            if (Character.isHighSurrogate(ch)) {
                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
                    return false;
                }
                hasSupplementary = true;
                i += 2;
            } else if (Character.isLowSurrogate(ch)) {
                return false;
            } else {
                i++;
            }
        }
        return hasSupplementary;
    }

    private static boolean containsNoCsvMeta(String s) {
        return s.indexOf(',') < 0 && s.indexOf('"') < 0 && s.indexOf('\r') < 0 && s.indexOf('\n') < 0;
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                out.append('a');
            } else {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static int randomSupplementaryCodePoint(FuzzedDataProvider data) {
        while (true) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            if (cp < 0xD800 || cp > 0xDFFF) {
                return cp;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int j = hex.length(); j < 4; j++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
