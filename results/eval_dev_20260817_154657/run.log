package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;

public class FuzzHarness {
    private static final int[] INDICES = {
        0, 1, 2, 0, 2, 3,
        4, 7, 6, 4, 6, 5,
        0, 4, 5, 0, 5, 1,
        1, 5, 6, 1, 6, 2,
        2, 6, 7, 2, 7, 3,
        4, 0, 3, 4, 3, 7
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger shape from the regression test.
        tryExercise(anchorCoords(), null, false);

        // EXPLORE: same root-cause property as the test, but varied around the patched condition:
        // a closed box-like mesh where one top vertex is nudged around the seed's 0.999999 value.
        float scale = boundedFloat(data.consumeInt(), 0.5f, 4.0f);
        float epsilon = boundedFloat(data.consumeInt(), -0.02f, 0.02f);
        float tx = boundedFloat(data.consumeInt(), -10.0f, 10.0f);
        float ty = boundedFloat(data.consumeInt(), -10.0f, 10.0f);
        float tz = boundedFloat(data.consumeInt(), -10.0f, 10.0f);

        float[] coords = makeCoords(scale, epsilon, tx, ty, tz);
        tryExercise(coords, null, true);

        // MANDATORY metamorphic/oracle:
        // Translation of a polyhedron must preserve volume and shift barycenter by exactly the same vector.
        // This is sound for every correct implementation because it compares the same object built from real
        // library calls under a rigid translation.
        float dx = boundedFloat(data.consumeInt(), -3.0f, 3.0f);
        float dy = boundedFloat(data.consumeInt(), -3.0f, 3.0f);
        float dz = boundedFloat(data.consumeInt(), -3.0f, 3.0f);
        float[] translated = translate(coords, dx, dy, dz);
        tryExercise(coords, translated, true);
    }

    private static void tryExercise(float[] coords, float[] translatedCoords, boolean swallowNonRootCause) {
        if (translatedCoords == null) {
            try {
                buildAndTouch(coords);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                if (!swallowNonRootCause) {
                    throwUnchecked(t);
                }
            }
            return;
        }

        PolyhedronsSet a;
        PolyhedronsSet b;
        try {
            a = build(coords);
            b = build(translatedCoords);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        double sizeA;
        double sizeB;
        Vector3D baryA;
        Vector3D baryB;
        try {
            sizeA = a.getSize();
            baryA = (Vector3D) a.getBarycenter();
            sizeB = b.getSize();
            baryB = (Vector3D) b.getBarycenter();
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        double dx = translatedCoords[0] - coords[0];
        double dy = translatedCoords[1] - coords[1];
        double dz = translatedCoords[2] - coords[2];

        if (Double.isFinite(sizeA) && Double.isFinite(sizeB)) {
            double tol = 1e-6 * Math.max(1.0, Math.max(Math.abs(sizeA), Math.abs(sizeB)));
            if (Math.abs(sizeA - sizeB) > tol) {
                throw new RuntimeException(
                    "[oracle:translation-size] metamorphic violation: translated polyhedron changed size "
                    + "sizeA=" + sizeA + " sizeB=" + sizeB
                );
            }
        }

        if (baryA != null && baryB != null &&
            Double.isFinite(baryA.getX()) && Double.isFinite(baryA.getY()) && Double.isFinite(baryA.getZ()) &&
            Double.isFinite(baryB.getX()) && Double.isFinite(baryB.getY()) && Double.isFinite(baryB.getZ())) {
            double tol = 1e-6;
            double ex = baryA.getX() + dx;
            double ey = baryA.getY() + dy;
            double ez = baryA.getZ() + dz;
            if (Math.abs(ex - baryB.getX()) > tol ||
                Math.abs(ey - baryB.getY()) > tol ||
                Math.abs(ez - baryB.getZ()) > tol) {
                throw new RuntimeException(
                    "[oracle:translation-barycenter] metamorphic violation: translated polyhedron barycenter did not translate "
                    + "a=(" + baryA.getX() + "," + baryA.getY() + "," + baryA.getZ() + ") "
                    + "shift=(" + dx + "," + dy + "," + dz + ") "
                    + "b=(" + baryB.getX() + "," + baryB.getY() + "," + baryB.getZ() + ")"
                );
            }
        }
    }

    private static void buildAndTouch(float[] coords) {
        PolyhedronsSet poly = build(coords);
        poly.getSize();
        poly.getBarycenter();
    }

    private static PolyhedronsSet build(float[] coords) {
        Vector3D[] vertices = new Vector3D[8];
        for (int i = 0; i < 8; i++) {
            int j = i * 3;
            vertices[i] = new Vector3D(coords[j], coords[j + 1], coords[j + 2]);
        }

        Collection<SubHyperplane<Euclidean3D>> subHyperplaneList = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < INDICES.length; idx += 3) {
            Vector3D v1 = vertices[INDICES[idx]];
            Vector3D v2 = vertices[INDICES[idx + 1]];
            Vector3D v3 = vertices[INDICES[idx + 2]];

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            // Real library path: 3D facet -> 2D polygon region on the facet plane -> 3D sub-hyperplane -> polyhedron.
            PolygonsSet polygon = new PolygonsSet(p1, p2, p3);
            // Touch reachable helpers directly as well.
            polygon.getVertices();
            polygon.getSize();
            polygon.getBarycenter();

            subHyperplaneList.add(new SubPlane(plane, polygon));
        }
        return new PolyhedronsSet(subHyperplaneList);
    }

    private static float[] anchorCoords() {
        return new float[] {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
    }

    private static float[] makeCoords(float scale, float epsilon, float tx, float ty, float tz) {
        float s = Math.max(0.5f, Math.min(4.0f, scale));
        float e = Math.max(-0.02f * s, Math.min(0.02f * s, epsilon));
        return new float[] {
             s + tx, -s + ty, -s + tz,
             s + tx, -s + ty,  s + tz,
            -s + tx, -s + ty,  s + tz,
            -s + tx, -s + ty, -s + tz,
             s + tx,  s + ty, -s + tz,
             s + e + tx,  s + ty,  s + tz,
            -s + tx,  s + ty,  s + tz,
            -s + tx,  s + ty, -s + tz
        };
    }

    private static float[] translate(float[] coords, float dx, float dy, float dz) {
        float[] out = coords.clone();
        for (int i = 0; i < out.length; i += 3) {
            out[i] += dx;
            out[i + 1] += dy;
            out[i + 2] += dz;
        }
        return out;
    }

    private static float boundedFloat(int raw, float min, float max) {
        long unsigned = raw & 0xffffffffL;
        double unit = unsigned / (double) 0xffffffffL;
        return (float) (min + (max - min) * unit);
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls) &&
                ("computeGeometricalProperties".equals(method) ||
                 "getVertices".equals(method) ||
                 "getTree".equals(method) ||
                 "getSize".equals(method) ||
                 "setSize".equals(method) ||
                 "setBarycenter".equals(method) ||
                 "getBarycenter".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
