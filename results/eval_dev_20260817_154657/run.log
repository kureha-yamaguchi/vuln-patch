package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testValidCsvEscapeInput("\uD83D\uDE30");
        testValidCsvEscapeInput("\uD800\uDC00");
        testValidCsvEscapeInput("\uD834\uDD1E");
        testValidCsvEscapeInput("\uDBFF\uDFFD");

        String fuzzed = buildWellFormedSafeString(data);
        testValidCsvEscapeInput(fuzzed);
    }

    private static void testValidCsvEscapeInput(String input) {
        final String escaped;
        try {
            escaped = StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
            return;
        }

        /*
         * Contract asserted:
         * StringEscapeUtils.escapeCsv "Returns a String value for a CSV column enclosed in double quotes, if required."
         * For inputs constructed without CSV meta-characters (comma, quote, CR, LF), quoting is not required,
         * so a correct implementation must return the original string unchanged. A patch that merely avoids the
         * crash by skipping or mangling code points would violate this observable result.
         */
        if (input.length() > 0 && !escaped.equals(input)) {
            throw new RuntimeException(
                "[oracle:csv-identity] metamorphic violation: escapeCsv must preserve safe input unchanged input="
                    + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
        }

        /*
         * Additional relation using only real library calls:
         * unescapeCsv(escapeCsv(x)) == x for any string x because escapeCsv produces a valid escaped CSV field.
         * If either side throws, the relation does not apply and we skip it.
         */
        try {
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!input.equals(roundTrip)) {
                throw new RuntimeException(
                    "[oracle:csv-roundtrip] metamorphic violation: unescapeCsv(escapeCsv(x)) == x input="
                        + printable(input) + " lhs=" + printable(roundTrip) + " rhs=" + printable(input));
            }
        } catch (Throwable t) {
            if (isOracle(t)) {
                throw rethrow(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static String buildWellFormedSafeString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        sb.append(sanitizeSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8))));

        int pairCount = data.consumeInt(1, 4);
        for (int i = 0; i < pairCount; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            sb.append(sanitizeSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8))));
        }

        if (sb.length() == 0) {
            sb.append('A').append(Character.toChars(0x10000)).append('B');
        }
        return sb.toString();
    }

    private static String sanitizeSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracle(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("[oracle:");
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
