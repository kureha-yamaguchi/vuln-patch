package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.ConvergenceException;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalNumberException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int MAX_ULPS = 10;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                sneakyThrow(t);
            }
        }

        try {
            runExploration(data);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void runAnchor() {
        double[] objective = new double[] { 10.0, -57.0, -9.0, -24.0 };
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { -0.5, 5.5, 2.5, -9.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { -0.5, 1.5, 0.5, -1.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { -1.0, 0.0, 0.0, 0.0 }, Relationship.GEQ, -1.0));
        solveAndCrossCheck(objective, constraints, GoalType.MAXIMIZE, true);
    }

    private static void runExploration(FuzzedDataProvider data) {
        int vars = 4;
        double[] baseObjective = new double[] { 10.0, -57.0, -9.0, -24.0 };
        double[] objective = new double[vars];
        for (int i = 0; i < vars; i++) {
            objective[i] = baseObjective[i] + data.consumeInt(-3, 3);
        }

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[][] seed = new double[][] {
            { -0.5, 5.5, 2.5, -9.0 },
            { -0.5, 1.5, 0.5, -1.0 },
            { -1.0, 0.0, 0.0, 0.0 }
        };
        double[] rhs = new double[] { 0.0, 0.0, -1.0 };

        int extra = data.consumeInt(0, 3);
        int total = seed.length + extra;

        for (int r = 0; r < total; r++) {
            double[] coeff = new double[vars];
            if (r < seed.length) {
                for (int c = 0; c < vars; c++) {
                    coeff[c] = seed[r][c] + data.consumeInt(-2, 2);
                }
                double v = rhs[r] + data.consumeInt(-1, 1);
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, v));
            } else {
                for (int c = 0; c < vars; c++) {
                    coeff[c] = data.consumeInt(-12, 12);
                }
                if (allZero(coeff)) {
                    coeff[data.consumeInt(0, vars - 1)] = 1.0;
                }
                Relationship rel;
                int choice = data.consumeInt(0, 2);
                if (choice == 0) {
                    rel = Relationship.GEQ;
                } else if (choice == 1) {
                    rel = Relationship.EQ;
                } else {
                    rel = Relationship.LEQ;
                }
                double v = data.consumeInt(-8, 8);
                constraints.add(new LinearConstraint(coeff, rel, v));
            }
        }

        if (!hasArtificialVariableConstraint(constraints)) {
            double[] coeff = new double[] { -1.0, 0.0, 0.0, 0.0 };
            constraints.add(new LinearConstraint(coeff, Relationship.GEQ, -1.0));
        }

        solveAndCrossCheck(objective, constraints, GoalType.MAXIMIZE, true);
    }

    private static void solveAndCrossCheck(double[] objectiveCoefficients,
                                           List<LinearConstraint> constraints,
                                           GoalType goalType,
                                           boolean nonNegative) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoefficients, 0.0);
        SimplexSolver solver1 = new SimplexSolver(EPS, MAX_ULPS);
        SimplexSolver solver2 = new SimplexSolver(EPS, MAX_ULPS);

        PointValuePair p1;
        PointValuePair p2;
        try {
            p1 = solver1.optimize(f, constraints, goalType, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagate(t)) {
                sneakyThrow(t);
            }
            return;
        }

        try {
            p2 = solver2.optimize(f, constraints, goalType, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (shouldPropagate(t)) {
                sneakyThrow(t);
            }
            return;
        }

        if (p1 == null || p2 == null || p1.getPoint() == null || p2.getPoint() == null) {
            throw new RuntimeException("[oracle:null-result] metamorphic violation: optimizer returned null result");
        }

        if (!validSolution(p1, constraints, EPS)) {
            throw new RuntimeException("[oracle:valid-solution] metamorphic violation: returned point violates constraints");
        }
        if (!validSolution(p2, constraints, EPS)) {
            throw new RuntimeException("[oracle:valid-solution-2] metamorphic violation: repeated solve returned point violating constraints");
        }

        double reported1 = p1.getValue();
        double recomputed1 = recomputeObjective(p1.getPoint(), objectiveCoefficients, 0.0);
        if (!approximatelyEqual(reported1, recomputed1, 1.0e-6, 1.0e-6)) {
            throw new RuntimeException(
                "[oracle:objective-consistency] metamorphic violation: reported=" + reported1 + " recomputed=" + recomputed1);
        }

        double reported2 = p2.getValue();
        double recomputed2 = recomputeObjective(p2.getPoint(), objectiveCoefficients, 0.0);
        if (!approximatelyEqual(reported2, recomputed2, 1.0e-6, 1.0e-6)) {
            throw new RuntimeException(
                "[oracle:objective-consistency-2] metamorphic violation: reported=" + reported2 + " recomputed=" + recomputed2);
        }

        double[] point1 = p1.getPoint();
        double[] point2 = p2.getPoint();
        if (point1.length != point2.length) {
            throw new RuntimeException(
                "[oracle:repeatability] metamorphic violation: different point dimensions " + point1.length + " vs " + point2.length);
        }
        for (int i = 0; i < point1.length; i++) {
            if (!approximatelyEqual(point1[i], point2[i], 1.0e-5, 1.0e-6)) {
                throw new RuntimeException(
                    "[oracle:repeatability] metamorphic violation: coordinate " + i + " differs lhs=" + point1[i] + " rhs=" + point2[i]);
            }
        }
        if (!approximatelyEqual(reported1, reported2, 1.0e-5, 1.0e-6)) {
            throw new RuntimeException(
                "[oracle:repeatability-value] metamorphic violation: objective differs lhs=" + reported1 + " rhs=" + reported2);
        }
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static double recomputeObjective(double[] point, double[] coeffs, double constant) {
        double sum = constant;
        int len = Math.min(point.length, coeffs.length);
        for (int i = 0; i < len; i++) {
            sum += point[i] * coeffs[i];
        }
        return sum;
    }

    private static boolean approximatelyEqual(double a, double b, double relTol, double absTol) {
        double diff = Math.abs(a - b);
        if (diff <= absTol) {
            return true;
        }
        double scale = Math.max(Math.abs(a), Math.abs(b));
        return diff <= relTol * Math.max(1.0, scale);
    }

    private static boolean hasArtificialVariableConstraint(List<LinearConstraint> constraints) {
        for (LinearConstraint c : constraints) {
            if (c.getRelationship() == Relationship.GEQ || c.getRelationship() == Relationship.EQ) {
                return true;
            }
        }
        return false;
    }

    private static boolean allZero(double[] values) {
        for (double v : values) {
            if (v != 0.0) {
                return false;
            }
        }
        return true;
    }

    private static boolean isCleanRejection(Throwable t) {
        return (t instanceof IllegalArgumentException)
            || (t instanceof NumberFormatException)
            || (t instanceof MathIllegalArgumentException)
            || (t instanceof MathIllegalNumberException)
            || (t instanceof ConvergenceException);
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("[oracle:")) {
                return true;
            }
        }
        if (!(t instanceof MaxCountExceededException) && !(t instanceof MathIllegalStateException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        boolean hasRelevantFrame = false;
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if (("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls) && "getPivotRow".equals(m))
                || ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)
                    && ("getNumObjectiveFunctions".equals(m)
                        || "getHeight".equals(m)
                        || "getWidth".equals(m)
                        || "getEntry".equals(m)
                        || "getNumArtificialVariables".equals(m)
                        || "getArtificialVariableOffset".equals(m)
                        || "getBasicRow".equals(m)))
                || ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(m) || "equals".equals(m)))
                || ("org.apache.commons.math3.optimization.linear.AbstractLinearOptimizer".equals(cls)
                    && "incrementIterationsCounter".equals(m))) {
                hasRelevantFrame = true;
                break;
            }
        }
        return hasRelevantFrame;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
