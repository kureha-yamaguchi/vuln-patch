                rel = data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ;
            } else {
                rhs = data.consumeInt(-5, 10);
                rel = data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ;
            }
            constraints.add(new LinearConstraint(extra, rel, rhs));
