            geq[i] = data.consumeInt(-2, 2);
            leq[i] = data.consumeInt(-2, 2);
        }

        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(geq, Relationship.GEQ, geqCoeff * tieRatio));
        constraints.add(new LinearConstraint(leq, Relationship.LEQ, leqCoeff * tieRatio));

        int extras = data.consumeInt(0, 3);
