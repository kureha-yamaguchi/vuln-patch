package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int MAX_ULPS = 10;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1.0, 1.0, false);

        double rhs = data.consumeInt(1, 5);
        boolean addRedundant = data.consumeBoolean();
        runCase(rhs, rhs, addRedundant);
    }

    private static void runCase(double geqRhs, double leqRhs, boolean addRedundant) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0 }, 0.0);
        Collection<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, geqRhs));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, leqRhs));
        if (addRedundant) {
            constraints.add(new LinearConstraint(new double[] { 2.0 }, Relationship.GEQ, 2.0 * geqRhs));
            constraints.add(new LinearConstraint(new double[] { 2.0 }, Relationship.LEQ, 2.0 * leqRhs));
        }

        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, EPS, MAX_ULPS);
        SimplexSolver solver = new SimplexSolver(EPS, MAX_ULPS);

        int pivotCol = expectedPivotColumn(tableau);
        if (pivotCol < 0) {
            return;
        }

        Integer expectedRow = expectedPivotRowWithoutArtificialPreference(tableau, pivotCol);
        if (expectedRow == null) {
            return;
        }

        int tiedRows = countMinRatioRows(tableau, pivotCol);
        if (tiedRows < 2) {
            return;
        }
        if (tableau.getNumArtificialVariables() <= 0) {
            return;
        }

        boolean someTiedRowHasBasicArtificial = false;
        List<Integer> minRows = getMinRatioRows(tableau, pivotCol);
        for (Integer row : minRows) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                double entry = tableau.getEntry(row, column);
                Integer basic = tableau.getBasicRow(column);
                if (Precision.equals(entry, 1d, MAX_ULPS) && row.equals(basic)) {
                    someTiedRowHasBasicArtificial = true;
                }
            }
        }
        if (!someTiedRowHasBasicArtificial) {
            return;
        }

        solver.doIteration(tableau);

        Integer actualRow = tableau.getBasicRow(pivotCol);

        // Contract for this oracle:
        // when the minimum-ratio test ties, the code in the patched method falls through to Bland's
        // rule ("take the row for which the corresponding basic variable has the smallest index").
        // We compute that same choice independently from the tableau and require the performed pivot
        // to match it. A buggy build returns earlier from the removed branch and pivots a different row.
        if (!expectedRow.equals(actualRow)) {
            throw new RuntimeException(
                "[oracle:bland-row] metamorphic violation: pivot row differs from Bland tie-break; expectedRow="
                    + expectedRow + " actualRow=" + actualRow + " pivotCol=" + pivotCol
                    + " numArtificial=" + tableau.getNumArtificialVariables()
                    + " artOffset=" + tableau.getArtificialVariableOffset()
                    + " height=" + tableau.getHeight()
                    + " width=" + tableau.getWidth());
        }
    }

    private static int expectedPivotColumn(SimplexTableau tableau) {
        double minValue = 0.0;
        Integer minPos = null;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (entry < minValue) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos == null ? -1 : minPos.intValue();
    }

    private static Integer expectedPivotRowWithoutArtificialPreference(SimplexTableau tableau, int col) {
        List<Integer> minRatioPositions = getMinRatioRows(tableau, col);
        if (minRatioPositions.isEmpty()) {
            return null;
        }
        if (minRatioPositions.size() == 1) {
            return minRatioPositions.get(0);
        }

        Integer minRow = null;
        int minIndex = tableau.getWidth();
        for (Integer row : minRatioPositions) {
            int i = tableau.getNumObjectiveFunctions();
            for (; i < tableau.getWidth() - 1 && minRow != row; i++) {
                if (row.equals(tableau.getBasicRow(i))) {
                    if (i < minIndex) {
                        minIndex = i;
                        minRow = row;
                    }
                }
            }
        }
        return minRow;
    }

    private static int countMinRatioRows(SimplexTableau tableau, int col) {
        return getMinRatioRows(tableau, col).size();
    }

    private static List<Integer> getMinRatioRows(SimplexTableau tableau, int col) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, MAX_ULPS) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(i);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(i);
                }
            }
        }
        return minRatioPositions;
    }
}
