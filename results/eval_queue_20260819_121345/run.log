package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int MAX_ULPS = 10;
    private static boolean searchedAnchors = false;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        if (!searchedAnchors) {
            searchedAnchors = true;
            runDeterministicSearch();
        }

        int px = data.consumeInt(1, 3);
        int py = data.consumeInt(1, 3);

        double[][] seeds = new double[][] {
            {1, 0}, {0, 1}, {1, 1}, {2, 1}, {1, 2}, {2, 2}, {3, 1}, {1, 3}
        };

        int ia = data.consumeInt(0, seeds.length - 1);
        int ib = data.consumeInt(0, seeds.length - 1);
        int ic = data.consumeInt(0, seeds.length - 1);
        int id = data.consumeInt(0, seeds.length - 1);

        List<LinearConstraint> constraints = buildCandidate(
            px,
            py,
            seeds[ia],
            seeds[ib],
            seeds[ic],
            seeds[id],
            data.consumeBoolean(),
            data.consumeBoolean()
        );

        if (reachesPatchedBranch(constraints)) {
            solve(constraints);
        }
    }

    private static void runDeterministicSearch() {
        double[][] seeds = new double[][] {
            {1, 0}, {0, 1}, {1, 1}, {2, 1}, {1, 2}, {2, 2}, {3, 1}, {1, 3}
        };

        for (int px = 1; px <= 3; px++) {
            for (int py = 1; py <= 3; py++) {
                for (int ia = 0; ia < seeds.length; ia++) {
                    for (int ib = 0; ib < seeds.length; ib++) {
                        for (int ic = 0; ic < seeds.length; ic++) {
                            for (int id = 0; id < seeds.length; id++) {
                                List<LinearConstraint> c1 = buildCandidate(px, py, seeds[ia], seeds[ib], seeds[ic], seeds[id], false, false);
                                if (reachesPatchedBranch(c1)) {
                                    solve(c1);
                                }

                                List<LinearConstraint> c2 = buildCandidate(px, py, seeds[ia], seeds[ib], seeds[ic], seeds[id], true, false);
                                if (reachesPatchedBranch(c2)) {
                                    solve(c2);
                                }

                                List<LinearConstraint> c3 = buildCandidate(px, py, seeds[ia], seeds[ib], seeds[ic], seeds[id], false, true);
                                if (reachesPatchedBranch(c3)) {
                                    solve(c3);
                                }

                                List<LinearConstraint> c4 = buildCandidate(px, py, seeds[ia], seeds[ib], seeds[ic], seeds[id], true, true);
                                if (reachesPatchedBranch(c4)) {
                                    solve(c4);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    private static List<LinearConstraint> buildCandidate(
            int px,
            int py,
            double[] geq1,
            double[] leq1,
            double[] geq2,
            double[] eq1,
            boolean duplicateGeq,
            boolean includeEq) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double rhsGeq1 = dot(geq1, px, py);
        double rhsLeq1 = dot(leq1, px, py);
        double rhsGeq2 = dot(geq2, px, py);
        double rhsEq1 = dot(eq1, px, py);

        constraints.add(new LinearConstraint(copy2(geq1), Relationship.GEQ, rhsGeq1));
        constraints.add(new LinearConstraint(copy2(leq1), Relationship.LEQ, rhsLeq1));
        constraints.add(new LinearConstraint(copy2(geq2), Relationship.GEQ, rhsGeq2));

        if (duplicateGeq) {
            constraints.add(new LinearConstraint(copy2(geq1), Relationship.GEQ, rhsGeq1));
        }
        if (includeEq) {
            constraints.add(new LinearConstraint(copy2(eq1), Relationship.EQ, rhsEq1));
        }

        constraints.add(new LinearConstraint(new double[] {1, 0}, Relationship.LEQ, px + 1));
        constraints.add(new LinearConstraint(new double[] {0, 1}, Relationship.LEQ, py + 1));

        return constraints;
    }

    private static boolean reachesPatchedBranch(List<LinearConstraint> constraints) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] {1.0, 0.0}, 0.0);
        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, EPS);

        if (tableau.getNumArtificialVariables() <= 0) {
            return false;
        }

        int pivotCol = findPivotColumn(tableau);
        if (pivotCol < 0) {
            return false;
        }

        ArrayList<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;

        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            final double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            final double entry = tableau.getEntry(i, pivotCol);

            if (Precision.compareTo(entry, 0d, MAX_ULPS) > 0) {
                final double ratio = rhs / entry;
                final int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(i);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions.clear();
                    minRatioPositions.add(i);
                }
            }
        }

        if (minRatioPositions.size() <= 1) {
            return false;
        }

        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                final double entry = tableau.getEntry(row, column);
                Integer basicRow = tableau.getBasicRow(column);
                if (Precision.equals(entry, 1d, MAX_ULPS) && row.equals(basicRow)) {
                    return true;
                }
            }
        }

        return false;
    }

    private static int findPivotColumn(SimplexTableau tableau) {
        double minValue = 0;
        int minPos = -1;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (entry < minValue) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos;
    }

    private static void solve(List<LinearConstraint> constraints) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] {1.0, 0.0}, 0.0);
        SimplexSolver solver = new SimplexSolver(EPS, MAX_ULPS);
        solver.optimize(f, constraints, GoalType.MINIMIZE, true);
    }

    private static double[] copy2(double[] a) {
        return new double[] {a[0], a[1]};
    }

    private static double dot(double[] a, int x, int y) {
        return a[0] * x + a[1] * y;
    }
}
