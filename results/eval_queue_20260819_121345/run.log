        Vector2D wholeBc = (Vector2D) wholeLeaf.getBarycenter();
        if (sameDouble(boundarySize, wholeSize) && sameVector(boundaryBc, wholeBc)) {
            throw new RuntimeException("[oracle:boundaryattr-not-whole] metamorphic violation: BoundaryAttribute leaf collapsed to whole-space summary input="
                    + label + " boundarySize=" + boundarySize + " wholeSize=" + wholeSize
                    + " boundaryBc=" + pointToString(boundaryBc) + " wholeBc=" + pointToString(wholeBc));
        }
