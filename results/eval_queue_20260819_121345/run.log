            long seed = ((long) data.consumeInt() << 32) ^ (data.consumeInt() & 0xffffffffL) ^ (0x9E3779B97F4A7C15L * i);
            int vars = 8 + Math.floorMod(data.consumeInt(), 24);
            int geq = 2 + Math.floorMod(data.consumeInt(), 4);
            int total = geq + 3 + Math.floorMod(data.consumeInt(), 6);
            runAnchorLikeCase(seed, vars, geq, total);
        }
    }

    private static void runAnchorLikeCase(long seed, int variables, int geqCount, int totalConstraints) {
        LinearObjectiveFunction objective = new LinearObjectiveFunction(buildObjective(variables), 0.0d);
        List<LinearConstraint> constraints = buildCyclingLikeConstraints(seed, variables, geqCount, totalConstraints);

        SimplexSolver solver = new SimplexSolver(1.0e-6, 10);
        solver.setMaxIterations(100);
        solver.optimize(objective, constraints, GoalType.MINIMIZE, true);
    }

    private static double[] buildObjective(int variables) {
        double[] objective = new double[variables];
        objective[0] = 1.0d;
        return objective;
    }

    private static List<LinearConstraint> buildCyclingLikeConstraints(long seed, int variables, int geqCount, int totalConstraints) {
        Random rnd = new Random(seed);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        if (variables < 4) {
            variables = 4;
        }
        if (geqCount < 2) {
            geqCount = 2;
        }
        if (totalConstraints < geqCount + 1) {
            totalConstraints = geqCount + 1;
        }

        double[][] basis = new double[geqCount][variables];
        double[] rhs = new double[geqCount];

        for (int i = 0; i < geqCount; i++) {
            double[] row = new double[variables];
            row[0] = 0.0d;
            for (int j = 1; j < variables; j++) {
                row[j] = 1 + rnd.nextInt(99);
            }
            double r = 1 + rnd.nextInt(99);
            basis[i] = row.clone();
            rhs[i] = r;
            constraints.add(new LinearConstraint(row, Relationship.GEQ, r));
        }

        if (geqCount >= 2) {
            constraints.add(new LinearConstraint(basis[0].clone(), Relationship.GEQ, rhs[0]));
        }

        for (int i = constraints.size(); i < totalConstraints; i++) {
            double[] row = new double[variables];
            row[0] = 1 + rnd.nextInt(99);
            for (int j = 1; j < variables; j++) {
                int mag = 1 + rnd.nextInt(99);
                row[j] = -mag;
            }

            int blendA = rnd.nextInt(geqCount);
            int blendB = rnd.nextInt(geqCount);
            if (blendA == blendB) {
                blendB = (blendB + 1) % geqCount;
            }

            for (int j = 1; j < variables; j++) {
                if ((j + i) % 5 == 0) {
                    row[j] = -(basis[blendA][j] + basis[blendB][j]) / 2.0d;
                } else if ((j + i) % 7 == 0) {
                    row[j] = -basis[blendA][j];
                }
            }

            double value;
            switch (i % 4) {
                case 0:
                    value = -(1 + rnd.nextInt(99));
                    break;
                case 1:
                    value = rhs[blendA] - rhs[blendB];
                    break;
                case 2:
                    value = -(rhs[blendA] + 1 + rnd.nextInt(20));
                    break;
                default:
                    value = -rnd.nextInt(10);
                    break;
            }

            constraints.add(new LinearConstraint(row, Relationship.LEQ, value));
        }

        return constraints;
    }
}
