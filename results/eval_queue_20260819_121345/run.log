package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static boolean anchorDone = false;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        if (!anchorDone) {
            anchorDone = true;
            runAnchorCases();
        }

        int rhs = data.consumeInt(0, 200);
        int duplicateCount = data.consumeInt(0, 3);
        int scaledCopies = data.consumeInt(0, 2);
        int tweak = data.consumeInt(0, 5);

        List<LinearConstraint> base = buildConstraintFamily(rhs, duplicateCount, scaledCopies, tweak, false);
        List<LinearConstraint> withRedundantDuplicate = buildConstraintFamily(rhs, duplicateCount + 1, scaledCopies, tweak, true);

        PointValuePair p1 = solve(base);
        PointValuePair p2 = solve(withRedundantDuplicate);

        double v1 = p1.getValue();
        double v2 = p2.getValue();
        if (Math.abs(v1 - v2) > 1.0e-7) {
            throw new RuntimeException("[oracle:duplicate-objective] redundant duplicate constraint changed optimum value lhs=" + v1 + " rhs=" + v2 + " rhsSeed=" + rhs);
        }
    }

    private static void runAnchorCases() {
        int[] rhsValues = new int[] {0, 1, 10, 50, 91, 100, 150};
        for (int rhs : rhsValues) {
            List<LinearConstraint> constraints = buildConstraintFamily(rhs, 2, 1, 0, false);
            solve(constraints);
        }
    }

    private static PointValuePair solve(List<LinearConstraint> constraints) {
        double[] objective = new double[31];
        objective[0] = 1.0;
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        SimplexSolver solver = new SimplexSolver(EPS, 10);
        return solver.optimize(f, constraints, GoalType.MINIMIZE, true);
    }

    private static List<LinearConstraint> buildConstraintFamily(int rhs4, int duplicateCount, int scaledCopies, int tweak, boolean addTrailingDuplicate) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] c1 = new double[] {
            0.0, 16.0, 14.0, 69.0, 1.0, 85.0, 52.0, 43.0, 64.0, 97.0,
            14.0, 74.0, 89.0, 28.0, 94.0, 58.0, 13.0, 22.0, 21.0, 17.0,
            30.0, 25.0, 1.0, 59.0, 91.0, 78.0, 12.0, 74.0, 56.0, 3.0, 88.0
        };
        double[] c2 = new double[] {
            0.0, 60.0, 40.0, 81.0, 71.0, 72.0, 46.0, 45.0, 38.0, 48.0,
            40.0, 17.0, 33.0, 85.0, 64.0, 32.0, 84.0, 3.0, 54.0, 44.0,
            71.0, 67.0, 90.0, 95.0, 54.0, 99.0, 99.0, 29.0, 52.0, 98.0, 9.0
        };
        double[] c3 = new double[] {
            0.0, 41.0, 12.0, 86.0, 90.0, 61.0, 31.0, 41.0, 23.0, 89.0,
            17.0, 74.0, 44.0, 27.0, 16.0, 47.0, 80.0, 32.0, 11.0, 56.0,
            68.0, 82.0, 11.0, 62.0, 62.0, 53.0, 39.0, 16.0, 48.0, 1.0, 63.0
        };
        double[] c4 = new double[] {
            83.0, -76.0, -94.0, -19.0, -15.0, -70.0, -72.0, -57.0, -63.0, -65.0,
            -22.0, -94.0, -22.0, -88.0, -86.0, -89.0, -72.0, -16.0, -80.0, -49.0,
            -70.0, -93.0, -95.0, -17.0, -83.0, -97.0, -31.0, -47.0, -31.0, -13.0, -23.0
        };

        constraints.add(new LinearConstraint(c1, Relationship.GEQ, 91.0));
        constraints.add(new LinearConstraint(c2, Relationship.GEQ, 54.0));
        constraints.add(new LinearConstraint(c3, Relationship.GEQ, 62.0));
        constraints.add(new LinearConstraint(c4, Relationship.LEQ, rhs4));

        for (int i = 0; i < duplicateCount; i++) {
            constraints.add(new LinearConstraint(c1.clone(), Relationship.GEQ, 91.0));
        }

        for (int i = 0; i < scaledCopies; i++) {
            double factor = 2.0 + i;
            constraints.add(new LinearConstraint(scale(c2, factor), Relationship.GEQ, 54.0 * factor));
        }

        if (tweak > 0) {
            double[] extra = c3.clone();
            extra[(tweak % 30) + 1] += tweak;
            constraints.add(new LinearConstraint(extra, Relationship.GEQ, 62.0));
        }

        if (addTrailingDuplicate) {
            constraints.add(new LinearConstraint(c3.clone(), Relationship.GEQ, 62.0));
        }

        return constraints;
    }

    private static double[] scale(double[] in, double factor) {
        double[] out = new double[in.length];
        for (int i = 0; i < in.length; i++) {
            out[i] = in[i] * factor;
        }
        return out;
