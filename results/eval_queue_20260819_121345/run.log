    private static void runCase(double[] objectiveCoeffs, List<LinearConstraint> constraints,
                                boolean restrictToNonNegative, double epsilon, int maxUlps) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0d);

        try {
            SimplexTableau tableauA =
                    new SimplexTableau(f, constraints, GoalType.MINIMIZE, restrictToNonNegative, epsilon, maxUlps);
            SimplexTableau tableauB =
                    new SimplexTableau(f, constraints, GoalType.MINIMIZE, restrictToNonNegative, epsilon, maxUlps);

