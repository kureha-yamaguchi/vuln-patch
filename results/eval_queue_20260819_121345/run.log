        PointValuePair first;
        try {
            first = solver.optimize(f, constraints, GoalType.MINIMIZE, restrictToNonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
                return;
            }
            return;
        }

