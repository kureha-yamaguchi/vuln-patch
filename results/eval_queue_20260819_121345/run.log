package org.apache.commons.math3.optimization.linear;

import java.util.ArrayList;
import java.util.Collection;
import java.util.Collections;
import java.util.List;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int numVars = data.consumeInt(3, 8);
        int dupIdx = data.consumeInt(1, numVars - 1);
        int dupCoeff = data.consumeInt(1, 10);
        int rhs = data.consumeInt(1, 20);
        int extraConstraints = data.consumeInt(0, 4);
        double epsilon = 1.0e-6;
        int maxUlps = data.consumeInt(1, 8);

        LinearObjectiveFunction f = new LinearObjectiveFunction(buildObjective(numVars), 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] geq1 = new double[numVars];
        geq1[dupIdx] = dupCoeff;
        if (numVars > 2) {
            geq1[(dupIdx + 1) % numVars] = data.consumeInt(0, 2);
        }
        constraints.add(new LinearConstraint(geq1, Relationship.GEQ, rhs));

        double[] geq2 = geq1.clone();
        constraints.add(new LinearConstraint(geq2, Relationship.GEQ, rhs));

        for (int i = 0; i < numVars; i++) {
            double[] ub = new double[numVars];
            ub[i] = 1.0;
            int bound = data.consumeInt(Math.max(2, rhs), Math.max(3, rhs + 25));
            constraints.add(new LinearConstraint(ub, Relationship.LEQ, bound));
        }

        double[] sum = new double[numVars];
        for (int i = 0; i < numVars; i++) {
            sum[i] = data.consumeBoolean() ? 1.0 : 0.0;
        }
        sum[dupIdx] = Math.max(sum[dupIdx], 1.0);
        constraints.add(new LinearConstraint(sum, Relationship.LEQ, rhs + data.consumeInt(1, 20)));

        for (int k = 0; k < extraConstraints; k++) {
            double[] row = new double[numVars];
            int nz = data.consumeInt(1, Math.min(3, numVars));
            for (int j = 0; j < nz; j++) {
                row[data.consumeInt(0, numVars - 1)] = data.consumeInt(0, 5);
            }
            if (allZero(row)) {
                row[dupIdx] = 1.0;
            }
            Relationship rel = data.consumeBoolean() ? Relationship.LEQ : Relationship.GEQ;
            double value = data.consumeInt(0, rhs + 20);
            constraints.add(new LinearConstraint(row, rel, value));
        }

        runCase(f, constraints, epsilon, maxUlps);
    }

    private static void runAnchor() {
        double epsilon = 1.0e-6;
        int maxUlps = 10;
        int numVars = 4;
        LinearObjectiveFunction f = new LinearObjectiveFunction(buildObjective(numVars), 0.0);
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 0.0, 0.0}, Relationship.GEQ, 5.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 0.0, 0.0}, Relationship.GEQ, 5.0));
        constraints.add(new LinearConstraint(new double[] {1.0, 0.0, 0.0, 0.0}, Relationship.LEQ, 10.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 0.0, 0.0}, Relationship.LEQ, 10.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 0.0, 1.0, 0.0}, Relationship.LEQ, 10.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 0.0, 0.0, 1.0}, Relationship.LEQ, 10.0));
        constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 1.0, 1.0}, Relationship.LEQ, 12.0));

        runCase(f, constraints, epsilon, maxUlps);
    }

    private static void runCase(LinearObjectiveFunction f, List<LinearConstraint> constraints, double epsilon, int maxUlps) {
        try {
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, epsilon, maxUlps);
            crossCheckTableau(tableau, f, constraints);
        } catch (Throwable t) {
            if (!isCleanRejection(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
            return;
        }

        try {
            PointValuePair original = solve(f, constraints, epsilon, maxUlps);

            List<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
            if (permuted.size() > 2) {
                Collections.swap(permuted, 0, 1);
                Collections.rotate(permuted.subList(0, Math.min(permuted.size(), 4)), 1);
            } else if (permuted.size() == 2) {
                Collections.swap(permuted, 0, 1);
            }

            PointValuePair reordered = solve(f, permuted, epsilon, maxUlps);

            if (original != null && reordered != null) {
                double lhs = original.getValue();
                double rhs = reordered.getValue();
                if (!Precision.equals(lhs, rhs, 1.0e-7)) {
                    throw new RuntimeException("[oracle:constraint-order] metamorphic violation: equivalent constraint order changed optimum inputSize="
                            + constraints.size() + " lhs=" + lhs + " rhs=" + rhs);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException && isOracleFailure((RuntimeException) t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static PointValuePair solve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, double epsilon, int maxUlps) {
        SimplexSolver solver = new SimplexSolver(epsilon, maxUlps);
        try {
            return solver.optimize(f, constraints, GoalType.MINIMIZE, true);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            return null;
        }
    }

    private static void crossCheckTableau(SimplexTableau tableau, LinearObjectiveFunction f, Collection<LinearConstraint> constraints) {
        double[][] raw = tableau.getData();
        int reportedHeight = tableau.getHeight();
        int reportedWidth = tableau.getWidth();

        if (raw.length != reportedHeight) {
            throw new RuntimeException("[oracle:tableau-height] metamorphic violation: getHeight disagrees with backing data raw="
                    + raw.length + " reported=" + reportedHeight);
        }
        int rawWidth = raw.length == 0 ? 0 : raw[0].length;
        if (rawWidth != reportedWidth) {
            throw new RuntimeException("[oracle:tableau-width] metamorphic violation: getWidth disagrees with backing data raw="
                    + rawWidth + " reported=" + reportedWidth);
        }

        for (int r = 0; r < reportedHeight; r++) {
            if (raw[r].length != reportedWidth) {
                throw new RuntimeException("[oracle:tableau-row-width] metamorphic violation: ragged backing data row=" + r
                        + " raw=" + raw[r].length + " reported=" + reportedWidth);
            }
            for (int c = 0; c < reportedWidth; c++) {
                double viaGetter = tableau.getEntry(r, c);
                double viaRaw = raw[r][c];
                if (Double.doubleToLongBits(viaGetter) != Double.doubleToLongBits(viaRaw)) {
                    throw new RuntimeException("[oracle:tableau-entry] metamorphic violation: getEntry disagrees with backing data row="
                            + r + " col=" + c + " getter=" + viaGetter + " raw=" + viaRaw);
                }
            }
        }

        int independentArtificial = 0;
        int independentSlack = 0;
        for (LinearConstraint c : constraints) {
            if (c.getRelationship() != Relationship.EQ) {
                independentSlack++;
            }
            if (c.getRelationship() == Relationship.GEQ || c.getRelationship() == Relationship.EQ) {
                independentArtificial++;
            }
        }

        int reportedArtificial = tableau.getNumArtificialVariables();
        if (reportedArtificial != independentArtificial) {
            throw new RuntimeException("[oracle:artificial-count] metamorphic violation: reported artificial count disagrees with constraints reported="
                    + reportedArtificial + " independent=" + independentArtificial);
        }

        int reportedObjectives = tableau.getNumObjectiveFunctions();
        int independentObjectives = reportedArtificial > 0 ? 2 : 1;
        if (reportedObjectives != independentObjectives) {
            throw new RuntimeException("[oracle:objective-count] metamorphic violation: objective function count inconsistent with artificial count reported="
                    + reportedObjectives + " independent=" + independentObjectives);
        }

        int decisionVariables = f.getCoefficients().getDimension();
        int independentOffset = independentObjectives + decisionVariables + independentSlack;
        int reportedOffset = tableau.getArtificialVariableOffset();
        if (reportedOffset != independentOffset) {
            throw new RuntimeException("[oracle:artificial-offset] metamorphic violation: artificial offset inconsistent with tableau structure reported="
                    + reportedOffset + " independent=" + independentOffset);
        }

        for (int col = 0; col < reportedWidth - 1; col++) {
            Integer basicRow = tableau.getBasicRow(col);
            if (basicRow != null) {
                if (basicRow.intValue() < 0 || basicRow.intValue() >= reportedHeight) {
                    throw new RuntimeException("[oracle:basic-row-range] metamorphic violation: basic row out of range col="
                            + col + " row=" + basicRow + " height=" + reportedHeight);
                }
                double pivot = tableau.getEntry(basicRow.intValue(), col);
                if (!Precision.equals(pivot, 1.0, 1.0e-12)) {
                    throw new RuntimeException("[oracle:basic-row-pivot] metamorphic violation: reported basic row is not unit pivot col="
                            + col + " row=" + basicRow + " entry=" + pivot);
                }
                for (int r = 0; r < reportedHeight; r++) {
                    if (r == basicRow.intValue()) {
                        continue;
                    }
                    double v = tableau.getEntry(r, col);
                    if (!Precision.equals(v, 0.0, 1.0e-12)) {
                        throw new RuntimeException("[oracle:basic-row-column] metamorphic violation: reported basic row column is not basic col="
                                + col + " row=" + basicRow + " conflictingRow=" + r + " value=" + v);
                    }
                }
            }
        }
    }

    private static double[] buildObjective(int numVars) {
        double[] objective = new double[numVars];
        objective[0] = 1.0;
        return objective;
    }

    private static boolean allZero(double[] row) {
        for (double v : row) {
            if (v != 0.0) {
                return false;
            }
        }
        return true;
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException || cur instanceof MathIllegalArgumentException) {
                return true;
            }
            String n = cur.getClass().getName();
            if (n.contains("Illegal") || n.contains("Invalid") || n.contains("OutOfRange") || n.contains("NoFeasible")
                    || n.contains("UnboundedSolution") || n.contains("DimensionMismatch") || n.contains("TooMany")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }
