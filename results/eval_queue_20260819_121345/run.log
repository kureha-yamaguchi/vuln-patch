private static void exerciseLeafBoundaryAttribute(PolygonsSet source, String label) {
        Object attr = extractBoundaryAttribute(source.getTree(false));
        if (!(attr instanceof org.apache.commons.math3.geometry.partitioning.BoundaryAttribute)) {
            return;
        }

        PolygonsSet leaf = new PolygonsSet(new org.apache.commons.math3.geometry.partitioning.BSPTree<Euclidean2D>(attr));

        try {
            leaf.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = leaf.getVertices();
            if (vertices == null || vertices.length != 0) {
                return;
            }

            /*
             * Contract asserted from computeGeometricalProperties() itself:
             * when getVertices().length == 0 and the tree does not represent whole-space,
             * the method must set size to 0 and barycenter to new Vector2D(0, 0).
             * A throw-deleting or bookkeeping-skipping patch would violate this observable state.
             */
            assertEmptyGeometry(leaf, label + "-leaf-boundary-attr");

            double size1 = leaf.getSize();
            Vector2D bc1 = asVector(leaf.getBarycenter());

            try {
                leaf.computeGeometricalProperties();
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }

            double size2 = leaf.getSize();
            Vector2D bc2 = asVector(leaf.getBarycenter());
            if (!sameDouble(size1, size2) || !sameVector(bc1, bc2)) {
                throw new RuntimeException("[oracle:idempotence] metamorphic violation: computeGeometricalProperties must be idempotent on the same leaf-boundary-attribute region input="
                        + label + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                        + " rhs=size=" + size2 + ",bc=" + pointToString(bc2));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }
