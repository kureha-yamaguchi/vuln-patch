package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D;
import org.apache.commons.math3.geometry.euclidean.threed.Plane;
import org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet;
import org.apache.commons.math3.geometry.euclidean.threed.SubPlane;
import org.apache.commons.math3.geometry.euclidean.threed.Vector3D;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;
import org.apache.commons.math3.geometry.partitioning.SubHyperplane;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            PolyhedronsSet anchor = buildIssue780Polyhedron();
            anchor.getSize();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet anchorSource = new PolygonsSet(-1.0, 1.0, -1.0, 1.0);
            exerciseBoundaryAttributeLeaf(anchorSource, "anchor-rect");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            whole.computeGeometricalProperties();
            empty.computeGeometricalProperties();

            /*
             * Contract from computeGeometricalProperties shown in the patch:
             * with getVertices().length == 0, a Boolean.TRUE leaf denotes whole-space,
             * while a Boolean.FALSE leaf denotes empty-space. These two valid-by-construction
             * regions must therefore remain observably distinct after computation.
             * A patch that merely flips/skips the whole-space branch collapses them.
             */
            if (sameDouble(whole.getSize(), empty.getSize())) {
                throw new RuntimeException("[oracle:whole-empty-distinct] metamorphic violation: whole-space and empty-space leaf regions became indistinguishable by size lhs="
                        + whole.getSize() + " rhs=" + empty.getSize());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());

            if (x1 == x2) {
                x2 = x1 + 1.0;
            }
            if (y1 == y2) {
                y2 = y1 + 1.0;
            }

            double minX = Math.min(x1, x2);
            double maxX = Math.max(x1, x2);
            double minY = Math.min(y1, y2);
            double maxY = Math.max(y1, y2);

            try {
                PolygonsSet source = new PolygonsSet(minX, maxX, minY, maxY);
                exerciseBoundaryAttributeLeaf(source, "rect-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }
    }

    private static void exerciseBoundaryAttributeLeaf(PolygonsSet source, String label) {
        Object attr = extractBoundaryAttribute(source.getTree(false));
        if (!(attr instanceof BoundaryAttribute)) {
            return;
        }

        PolygonsSet boundaryLeaf = new PolygonsSet(new BSPTree<Euclidean2D>(attr));
        try {
            boundaryLeaf.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        PolygonsSet emptyLeaf = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
        PolygonsSet wholeLeaf = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));

        try {
            emptyLeaf.computeGeometricalProperties();
            wholeLeaf.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] boundaryVertices = boundaryLeaf.getVertices();
            Vector2D[][] emptyVertices = emptyLeaf.getVertices();

            /*
             * Cross-check from the real code path:
             * getVertices() returns an empty vertex array whenever the tree has no cut.
             * For a leaf carrying a BoundaryAttribute instead of a Boolean, the region is
             * not whole-space, so successful computeGeometricalProperties() must summarize
             * it the same way as an explicit Boolean.FALSE empty leaf. This uses a second,
             * independently constructed library object as oracle.
             */
            if (boundaryVertices == null || emptyVertices == null) {
                return;
            }
            if (boundaryVertices.length != 0 || emptyVertices.length != 0) {
                return;
            }

            if (!sameDouble(boundaryLeaf.getSize(), emptyLeaf.getSize())
                    || !sameVector(asVector(boundaryLeaf.getBarycenter()), asVector(emptyLeaf.getBarycenter()))) {
                throw new RuntimeException("[oracle:boundaryattr-equals-empty] metamorphic violation: successful leaf BoundaryAttribute region must summarize like explicit empty leaf input="
                        + label + " lhs=size=" + boundaryLeaf.getSize() + ",bc=" + pointToString(asVector(boundaryLeaf.getBarycenter()))
                        + " rhs=size=" + emptyLeaf.getSize() + ",bc=" + pointToString(asVector(emptyLeaf.getBarycenter())));
            }

            /*
             * Flip-the-condition oracle:
             * whole-space and non-whole-space empty summaries must stay distinguishable.
             * If a patch suppresses the bad cast by disabling the whole-space branch,
             * wholeLeaf collapses to the same summary as boundaryLeaf/emptyLeaf.
             */
            if (sameDouble(wholeLeaf.getSize(), boundaryLeaf.getSize())
                    && sameVector(asVector(wholeLeaf.getBarycenter()), asVector(boundaryLeaf.getBarycenter()))) {
                throw new RuntimeException("[oracle:whole-distinct-from-boundaryattr] metamorphic violation: whole-space leaf collapsed onto non-whole BoundaryAttribute leaf input="
                        + label + " whole=size=" + wholeLeaf.getSize() + ",bc=" + pointToString(asVector(wholeLeaf.getBarycenter()))
                        + " boundary=size=" + boundaryLeaf.getSize() + ",bc=" + pointToString(asVector(boundaryLeaf.getBarycenter())));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static PolyhedronsSet buildIssue780Polyhedron() {
        float[] coords = {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f, 1.000000f,
            -1.000000f, -1.000000f, 1.000000f,
            -1.000000f, -1.000000f, -1.000000f,
            1.000000f, 1.000000f, -1.000000f,
            0.999999f, 1.000000f, 1.000000f,
            -1.000000f, 1.000000f, 1.000000f,
            -1.000000f, 1.000000f, -1.000000f
        };
        int[] indices = {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };

        ArrayList<SubHyperplane<Euclidean3D>> facets = new ArrayList<SubHyperplane<Euclidean3D>>();
        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;

            Vector3D v1 = new Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            Vector3D v2 = new Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            Vector3D v3 = new Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            Plane plane = new Plane(v1, v2, v3);
            Vector2D p1 = plane.toSubSpace(v1);
            Vector2D p2 = plane.toSubSpace(v2);
            Vector2D p3 = plane.toSubSpace(v3);

            PolygonsSet facetRegion = new PolygonsSet(1.0e-10, p1, p2, p3);
            facets.add(new SubPlane(plane, facetRegion));
        }

        return new PolyhedronsSet(facets);
    }

    private static Object extractBoundaryAttribute(BSPTree<Euclidean2D> tree) {
        if (tree == null) {
            return null;
        }
        Object attr = tree.getAttribute();
        if (attr instanceof BoundaryAttribute) {
            return attr;
        }
        Object fromPlus = extractBoundaryAttribute(tree.getPlus());
        if (fromPlus != null) {
            return fromPlus;
        }
        return extractBoundaryAttribute(tree.getMinus());
    }

    private static double finiteCoord(int raw) {
        return (raw % 20001) - 10000;
    }

    private static Vector2D asVector(Object o) {
        return (Vector2D) o;
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == null || b == null) {
            return a == b;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.isNaN(a) && Double.isNaN(b)) {
            return true;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }

    private static String pointToString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return "(" + p.getX() + "," + p.getY() + ")";
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof IllegalArgumentException || c instanceof NumberFormatException) {
                return true;
            }
            String name = c.getClass().getName();
            if (name.startsWith("org.apache.commons.math3.exception.")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

