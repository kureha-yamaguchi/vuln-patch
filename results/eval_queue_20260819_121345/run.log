package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int MAX_ULPS = 10;
    private static boolean anchorTried = false;

    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        if (!anchorTried) {
            anchorTried = true;
            try {
                runAnchor();
            } catch (RuntimeException t) {
                if (isOracleFailure(t)) {
                    throw t;
                }
            }
        }

        try {
            runExplore(data);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isOracleFailure(t)) {
                throw t;
            }
            if (isRootCauseCrashFromPatchedRegion(t)) {
                throw t;
            }
        }
    }

    private static void runAnchor() {
        int n = 6;
        double[] objective = new double[] {1, 0, 0, 0, 0, 0};

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        double[] dup = new double[] {2, 3, 5, 7, 11, 13};
        constraints.add(new LinearConstraint(dup, Relationship.GEQ, 29));
        constraints.add(new LinearConstraint(dup.clone(), Relationship.GEQ, 29));
        constraints.add(new LinearConstraint(new double[] {1, 4, 0, 2, 0, 1}, Relationship.GEQ, 9));
        constraints.add(new LinearConstraint(new double[] {0, 1, 3, 0, 2, 1}, Relationship.GEQ, 8));
        constraints.add(new LinearConstraint(new double[] {1, 0, 0, 0, 0, 0}, Relationship.GEQ, 0));
        constraints.add(new LinearConstraint(new double[] {0, 1, 0, 0, 0, 0}, Relationship.GEQ, 0));

        runCase(objective, constraints, GoalType.MINIMIZE, true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int n = data.consumeInt(2, 7);
        int extra = data.consumeInt(0, 5);

        double[] objective = new double[n];
        for (int i = 0; i < n; i++) {
            objective[i] = data.consumeInt(0, 20);
        }
        if (allZero(objective)) {
            objective[0] = 1.0;
        }

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] base = new double[n];
        for (int i = 0; i < n; i++) {
            base[i] = data.consumeInt(1, 15);
        }
        double rhs = data.consumeInt(1, 40);

        constraints.add(new LinearConstraint(base.clone(), Relationship.GEQ, rhs));
        constraints.add(new LinearConstraint(base.clone(), Relationship.GEQ, rhs));

        int scale = data.consumeInt(1, 4);
        double[] scaled = new double[n];
        for (int i = 0; i < n; i++) {
            scaled[i] = base[i] * scale;
        }
        constraints.add(new LinearConstraint(scaled, Relationship.GEQ, rhs * scale));

        for (int c = 0; c < extra; c++) {
            double[] coeffs = new double[n];
            for (int i = 0; i < n; i++) {
                coeffs[i] = data.consumeInt(0, 15);
            }
            if (allZero(coeffs)) {
                coeffs[data.consumeInt(0, n - 1)] = 1.0;
            }
            double crhs = data.consumeInt(0, 50);
            Relationship rel;
            int pick = data.consumeInt(0, 2);
            if (pick == 0) {
                rel = Relationship.GEQ;
            } else if (pick == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }
            constraints.add(new LinearConstraint(coeffs, rel, crhs));
        }

        for (int i = 0; i < n; i++) {
            double[] unit = new double[n];
            unit[i] = 1.0;
            constraints.add(new LinearConstraint(unit, Relationship.GEQ, 0.0));
        }

        runCase(objective, constraints, GoalType.MINIMIZE, true);
    }

    private static void runCase(double[] objectiveCoeffs, List<LinearConstraint> constraints, GoalType goal, boolean nonNegative) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0);

        checkTableauReadersAgreeWithConstruction(f, constraints, goal, nonNegative);

        PointValuePair original;
        try {
            original = solve(f, constraints, goal, nonNegative);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseCrashFromPatchedRegion(t)) {
                throw t;
            }
            return;
        }

        if (original == null || original.getPoint() == null) {
            return;
        }

        if (!validSolution(original, constraints, EPS)) {
            throw new RuntimeException("[oracle:perm-valid] original solver output violates its own constraints");
        }

        int n = objectiveCoeffs.length;
        if (n < 2) {
            return;
        }

        int[] permutation = new int[n];
        int shift = 1 % n;
        for (int i = 0; i < n; i++) {
            permutation[i] = (i + shift) % n;
        }

        LinearObjectiveFunction permutedObjective = permuteObjective(f, permutation);
        List<LinearConstraint> permutedConstraints = permuteConstraints(constraints, permutation);

        PointValuePair permuted;
        try {
            permuted = solve(permutedObjective, permutedConstraints, goal, nonNegative);
        } catch (RuntimeException t) {
            return;
        }

        if (permuted == null || permuted.getPoint() == null) {
            return;
        }

        double[] restoredPoint = inversePermute(permuted.getPoint(), permutation);
        double originalValue = evaluate(f, original.getPoint());
        double restoredValue = evaluate(f, restoredPoint);

        if (!validSolution(permuted, permutedConstraints, EPS)) {
            throw new RuntimeException("[oracle:perm-valid] permuted solver output violates permuted constraints");
        }

        if (!validSolution(new PointValuePair(restoredPoint, restoredValue), constraints, EPS)) {
            throw new RuntimeException("[oracle:perm-feasible] inverse-permuted solution is not feasible for the original problem");
        }

        double tol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(originalValue), Math.abs(restoredValue)));
        if (Math.abs(originalValue - restoredValue) > tol) {
            throw new RuntimeException(
                "[oracle:perm-value] metamorphic violation: variable permutation changed optimum value lhs="
                    + originalValue + " rhs=" + restoredValue);
        }
    }

    private static void checkTableauReadersAgreeWithConstruction(
            LinearObjectiveFunction f,
            Collection<LinearConstraint> constraints,
            GoalType goal,
            boolean nonNegative) {
        SimplexTableau tableau = new SimplexTableau(f, constraints, goal, nonNegative, EPS);

        int artificialCount = countArtificial(constraints);
        int expectedObjectives = artificialCount > 0 ? 2 : 1;
        if (tableau.getNumObjectiveFunctions() != expectedObjectives) {
            throw new RuntimeException(
                "[oracle:objfun-count] consistency violation: expectedNumObjectiveFunctions="
                    + expectedObjectives + " actual=" + tableau.getNumObjectiveFunctions());
        }

        int expectedHeight = constraints.size() + expectedObjectives;
        if (tableau.getHeight() != expectedHeight) {
            throw new RuntimeException(
                "[oracle:tableau-height] consistency violation: expectedHeight="
                    + expectedHeight + " actual=" + tableau.getHeight());
        }

        if (tableau.getNumArtificialVariables() != artificialCount) {
            throw new RuntimeException(
                "[oracle:artificial-count2] consistency violation: expectedArtificial="
                    + artificialCount + " actual=" + tableau.getNumArtificialVariables());
        }

        if (tableau.getWidth() <= 1) {
            throw new RuntimeException(
                "[oracle:tableau-width] consistency violation: non-degenerate tableau must have width > 1 but was "
                    + tableau.getWidth());
        }

        double rhs00 = tableau.getEntry(expectedObjectives - 1, tableau.getWidth() - 1);
        if (Double.isNaN(rhs00) || Double.isInfinite(rhs00)) {
            throw new RuntimeException("[oracle:tableau-entry] consistency violation: tableau RHS entry is non-finite");
        }
    }

    private static PointValuePair solve(
            LinearObjectiveFunction f,
            Collection<LinearConstraint> constraints,
            GoalType goal,
            boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver(EPS, MAX_ULPS);
        return solver.optimize(f, constraints, goal, nonNegative);
    }

    private static int countArtificial(Collection<LinearConstraint> constraints) {
        int count = 0;
        for (LinearConstraint c : constraints) {
            Relationship r = c.getRelationship();
            if (r == Relationship.GEQ || r == Relationship.EQ) {
                count++;
            }
        }
        return count;
    }

    private static LinearObjectiveFunction permuteObjective(LinearObjectiveFunction f, int[] permutation) {
        double[] src = f.getCoefficients().toArray();
        double[] dst = new double[src.length];
        for (int i = 0; i < src.length; i++) {
            dst[permutation[i]] = src[i];
        }
        return new LinearObjectiveFunction(dst, f.getConstantTerm());
    }

    private static List<LinearConstraint> permuteConstraints(List<LinearConstraint> constraints, int[] permutation) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(constraints.size());
        for (LinearConstraint c : constraints) {
            double[] src = c.getCoefficients().toArray();
            double[] dst = new double[src.length];
            for (int i = 0; i < src.length; i++) {
                dst[permutation[i]] = src[i];
            }
            out.add(new LinearConstraint(dst, c.getRelationship(), c.getValue()));
        }
        return out;
    }

    private static double[] inversePermute(double[] point, int[] permutation) {
        double[] restored = new double[point.length];
        for (int i = 0; i < point.length; i++) {
            restored[i] = point[permutation[i]];
        }
        return restored;
    }

    private static double evaluate(LinearObjectiveFunction f, double[] point) {
        double[] coeffs = f.getCoefficients().toArray();
        double result = f.getConstantTerm();
        for (int i = 0; i < coeffs.length && i < point.length; i++) {
            result += coeffs[i] * point[i];
        }
        return result;
    }

    private static boolean allZero(double[] a) {
        for (double v : a) {
            if (v != 0.0) {
                return false;
            }
        }
        return true;
    }

    private static boolean isOracleFailure(RuntimeException t) {
        String m = t.getMessage();
        return m != null && m.startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException || t instanceof MathIllegalArgumentException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid") || name.contains("NoFeasibleSolution") || name.contains("UnboundedSolution");
    }

    private static boolean isRootCauseCrashFromPatchedRegion(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)) {
                if ("getNumObjectiveFunctions".equals(method)
                        || "getHeight".equals(method)
                        || "getWidth".equals(method)
                        || "getEntry".equals(method)
                        || "getNumArtificialVariables".equals(method)
                        || "getArtificialVariableOffset".equals(method)
                        || "getBasicRow".equals(method)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)) {
                if ("compareTo".equals(method) || "equals".equals(method)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.linear.RealMatrix".equals(cls)) {
                if ("getRowDimension".equals(method)
                        || "getColumnDimension".equals(method)
                        || "getEntry".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }
}
