        double tieRatio = data.consumeInt(1, 7);
        double geqCoeff = data.consumeInt(1, 7);
        double leqCoeff = data.consumeInt(1, 7);

        double[] objective = new double[vars];
        objective[0] = 1.0;
        for (int i = 1; i < vars; i++) {
