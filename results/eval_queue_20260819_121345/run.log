package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            exerciseIssue780Anchor();
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            exerciseBoxOracle(0.0, 0.0, 0.0, 1.0, 1.0, 1.0, "anchor-box");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 6);
        for (int i = 0; i < cases; i++) {
            double cx = bounded(data.consumeInt());
            double cy = bounded(data.consumeInt());
            double cz = bounded(data.consumeInt());
            double dx = positiveSpan(data.consumeInt());
            double dy = positiveSpan(data.consumeInt());
            double dz = positiveSpan(data.consumeInt());

            try {
                exerciseBoxOracle(cx, cy, cz, dx, dy, dz, "box-" + i);
            } catch (RuntimeException t) {
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }

            double epsilon = smallPerturbation(data.consumeInt());
            boolean perturbPositive = data.consumeBoolean();
            try {
                exercisePerturbedBox(cx, cy, cz, dx, dy, dz, perturbPositive ? epsilon : -epsilon);
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
            }
        }
    }

    private static void exerciseIssue780Anchor() {
        float[] coords = new float[] {
            1.000000f, -1.000000f, -1.000000f,
            1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f,  1.000000f,
           -1.000000f, -1.000000f, -1.000000f,
            1.000000f,  1.000000f, -1.000000f,
            0.999999f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f,  1.000000f,
           -1.000000f,  1.000000f, -1.000000f
        };
        int[] indices = boxIndices();

        org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet poly = buildPolyhedron(coords, indices);
        if (poly == null) {
            return;
        }

        poly.getSize();
        poly.getBarycenter();
    }

    private static void exercisePerturbedBox(double cx, double cy, double cz,
                                             double dx, double dy, double dz,
                                             double epsilonX) {
        float[] coords = boxCoords((float) cx, (float) cy, (float) cz, (float) dx, (float) dy, (float) dz);
        coords[15] += (float) epsilonX;
        org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet poly = buildPolyhedron(coords, boxIndices());
        if (poly == null) {
            return;
        }

        poly.getSize();
        poly.getBarycenter();
    }

    private static void exerciseBoxOracle(double cx, double cy, double cz,
                                          double dx, double dy, double dz,
                                          String label) {
        float[] coords = boxCoords((float) cx, (float) cy, (float) cz, (float) dx, (float) dy, (float) dz);
        org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet poly1 = buildPolyhedron(coords, boxIndices());
        org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet poly2 = buildPolyhedron(coords, boxIndices());
        if (poly1 == null || poly2 == null) {
            return;
        }

        double expectedSize = 8.0 * dx * dy * dz;
        org.apache.commons.math3.geometry.euclidean.threed.Vector3D expectedBarycenter =
                new org.apache.commons.math3.geometry.euclidean.threed.Vector3D(cx, cy, cz);

        double size1;
        org.apache.commons.math3.geometry.euclidean.threed.Vector3D bc1;
        double size2;
        org.apache.commons.math3.geometry.euclidean.threed.Vector3D bc2;
        try {
            size1 = poly1.getSize();
            bc1 = asVector3(poly1.getBarycenter());
            size2 = poly2.getSize();
            bc2 = asVector3(poly2.getBarycenter());
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /*
         * Sound oracle from the public API and the way the input is constructed:
         * both polyhedra are built from the same axis-aligned box triangles, so every
         * correct implementation must report the same volume/barycenter for both fresh
         * objects, and that reported geometry must match the box encoded in the input.
         * A throw-deleting or bookkeeping-skipping patch can silence the known CCE yet
         * still leave size/barycenter wrong; this catches that.
         */
        if (!close(size1, expectedSize) || !close(size2, expectedSize)) {
            throw new RuntimeException("[oracle:box-volume] metamorphic violation: reported size disagrees with box encoded by input label="
                    + label + " expected=" + expectedSize + " size1=" + size1 + " size2=" + size2);
        }
        if (!sameVector3(bc1, expectedBarycenter) || !sameVector3(bc2, expectedBarycenter)) {
            throw new RuntimeException("[oracle:box-barycenter] metamorphic violation: reported barycenter disagrees with box encoded by input label="
                    + label + " expected=" + point3(expectedBarycenter) + " bc1=" + point3(bc1) + " bc2=" + point3(bc2));
        }
        if (!close(size1, size2) || !sameVector3(bc1, bc2)) {
            throw new RuntimeException("[oracle:fresh-rebuild] metamorphic violation: two identically-constructed objects disagree label="
                    + label + " lhs=size=" + size1 + ",bc=" + point3(bc1)
                    + " rhs=size=" + size2 + ",bc=" + point3(bc2));
        }
    }

    private static org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet buildPolyhedron(float[] coords, int[] indices) {
        java.util.ArrayList<org.apache.commons.math3.geometry.partitioning.SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>> facets =
                new java.util.ArrayList<org.apache.commons.math3.geometry.partitioning.SubHyperplane<org.apache.commons.math3.geometry.euclidean.threed.Euclidean3D>>();

        for (int idx = 0; idx < indices.length; idx += 3) {
            int idxA = indices[idx] * 3;
            int idxB = indices[idx + 1] * 3;
            int idxC = indices[idx + 2] * 3;

            org.apache.commons.math3.geometry.euclidean.threed.Vector3D v1 =
                    new org.apache.commons.math3.geometry.euclidean.threed.Vector3D(coords[idxA], coords[idxA + 1], coords[idxA + 2]);
            org.apache.commons.math3.geometry.euclidean.threed.Vector3D v2 =
                    new org.apache.commons.math3.geometry.euclidean.threed.Vector3D(coords[idxB], coords[idxB + 1], coords[idxB + 2]);
            org.apache.commons.math3.geometry.euclidean.threed.Vector3D v3 =
                    new org.apache.commons.math3.geometry.euclidean.threed.Vector3D(coords[idxC], coords[idxC + 1], coords[idxC + 2]);

            if (v1.equals(v2) || v2.equals(v3) || v1.equals(v3)) {
                return null;
            }

            try {
                org.apache.commons.math3.geometry.euclidean.threed.Plane plane =
                        new org.apache.commons.math3.geometry.euclidean.threed.Plane(v1, v2, v3);

                Vector2D p1 = plane.toSubSpace(v1);
                Vector2D p2 = plane.toSubSpace(v2);
                Vector2D p3 = plane.toSubSpace(v3);

                java.util.ArrayList<org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D>> edges =
                        new java.util.ArrayList<org.apache.commons.math3.geometry.partitioning.SubHyperplane<Euclidean2D>>();
                edges.add(new SubLine(p1, p2));
                edges.add(new SubLine(p2, p3));
                edges.add(new SubLine(p3, p1));

                PolygonsSet polygon = new PolygonsSet(edges);
                facets.add(new org.apache.commons.math3.geometry.euclidean.threed.SubPlane(plane, polygon));
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    return null;
                }
                throw t;
            }
        }

        try {
            return new org.apache.commons.math3.geometry.euclidean.threed.PolyhedronsSet(facets);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return null;
            }
            throw t;
        }
    }

    private static int[] boxIndices() {
        return new int[] {
            0, 1, 2, 0, 2, 3,
            4, 7, 6, 4, 6, 5,
            0, 4, 5, 0, 5, 1,
            1, 5, 6, 1, 6, 2,
            2, 6, 7, 2, 7, 3,
            4, 0, 3, 4, 3, 7
        };
    }

