package org.apache.commons.math3.geometry.euclidean.twod;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math3.geometry.Point;
import org.apache.commons.math3.geometry.partitioning.BSPTree;
import org.apache.commons.math3.geometry.partitioning.BoundaryAttribute;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            PolygonsSet whole = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            whole.computeGeometricalProperties();
            assertWholeGeometry(whole, "anchor-whole-boolean-leaf");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            empty.computeGeometricalProperties();
            assertEmptyGeometry(empty, "anchor-empty-boolean-leaf");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet anchorSource = new PolygonsSet(-1.0, 1.0, -1.0, 1.0);
            exerciseLeafBoundaryAttribute(anchorSource, "anchor-rect");
        } catch (RuntimeException t) {
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }

        int cases = 1 + data.consumeInt(0, 8);
        for (int i = 0; i < cases; i++) {
            double x1 = finiteCoord(data.consumeInt());
            double x2 = finiteCoord(data.consumeInt());
            double y1 = finiteCoord(data.consumeInt());
            double y2 = finiteCoord(data.consumeInt());

            if (x1 == x2) {
                x2 = x1 + 1.0;
            }
            if (y1 == y2) {
                y2 = y1 + 1.0;
            }

            double minX = Math.min(x1, x2);
            double maxX = Math.max(x1, x2);
            double minY = Math.min(y1, y2);
            double maxY = Math.max(y1, y2);

            try {
                PolygonsSet source = new PolygonsSet(minX, maxX, minY, maxY);
                exerciseLeafBoundaryAttribute(source, "rect-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }

            try {
                double cx = finiteCoord(data.consumeInt());
                double cy = finiteCoord(data.consumeInt());
                double w = positiveSpan(data.consumeInt());
                double h = positiveSpan(data.consumeInt());
                PolygonsSet shifted = new PolygonsSet(cx - w, cx + w, cy - h, cy + h);
                exerciseLeafBoundaryAttribute(shifted, "shifted-" + i);
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }

            try {
                boolean wholeFlag = data.consumeBoolean();
                PolygonsSet p = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.valueOf(wholeFlag)));
                p.computeGeometricalProperties();
                if (wholeFlag) {
                    assertWholeGeometry(p, "fuzz-boolean-whole-" + i);
                } else {
                    assertEmptyGeometry(p, "fuzz-boolean-empty-" + i);
                }

                double size1 = p.getSize();
                Vector2D bc1 = asVector(p.getBarycenter());
                p.computeGeometricalProperties();
                double size2 = p.getSize();
                Vector2D bc2 = asVector(p.getBarycenter());
                if (!sameDouble(size1, size2) || !sameVector(bc1, bc2)) {
                    throw new RuntimeException("[oracle:idempotence-boolean] metamorphic violation: repeated computeGeometricalProperties changed boolean-leaf geometry input="
                            + wholeFlag + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                            + " rhs=size=" + size2 + ",bc=" + pointToString(bc2));
                }
            } catch (RuntimeException t) {
                if (isCleanRejection(t)) {
                    continue;
                }
                if (isRootCause(t) || isOracleFailure(t)) {
                    throw t;
                }
            }
        }
    }

    private static void exerciseLeafBoundaryAttribute(PolygonsSet source, String label) {
        Object attr = extractBoundaryAttribute(source.getTree(false));
        if (!(attr instanceof BoundaryAttribute)) {
            return;
        }

        PolygonsSet leaf = new PolygonsSet(new BSPTree<Euclidean2D>(attr));

        try {
            leaf.computeGeometricalProperties();
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            Vector2D[][] vertices = leaf.getVertices();
            if (vertices == null || vertices.length != 0) {
                return;
            }

            /*
             * Contract from computeGeometricalProperties():
             * when getVertices().length == 0 and the tree does not represent whole space,
             * the method must set size to 0 and barycenter to (0,0). A throw-deleting or
             * branch-skipping patch would violate this observable state.
             */
            assertEmptyGeometry(leaf, label + "-boundary-attr-leaf");

            double size1 = leaf.getSize();
            Vector2D bc1 = asVector(leaf.getBarycenter());

            leaf.computeGeometricalProperties();

            double size2 = leaf.getSize();
            Vector2D bc2 = asVector(leaf.getBarycenter());
            if (!sameDouble(size1, size2) || !sameVector(bc1, bc2)) {
                throw new RuntimeException("[oracle:idempotence-boundary] metamorphic violation: computeGeometricalProperties must be idempotent on the same leaf-boundary-attribute region input="
                        + label + " lhs=size=" + size1 + ",bc=" + pointToString(bc1)
                        + " rhs=size=" + size2 + ",bc=" + pointToString(bc2));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t) || isOracleFailure(t)) {
                throw t;
            }
        }
    }

    private static Object extractBoundaryAttribute(BSPTree<Euclidean2D> tree) {
        if (tree == null) {
            return null;
        }
        Object attr = tree.getAttribute();
        if (attr instanceof BoundaryAttribute) {
            return attr;
        }
        Object left = extractBoundaryAttribute(tree.getMinus());
        if (left != null) {
            return left;
        }
        return extractBoundaryAttribute(tree.getPlus());
    }

    private static void assertWholeGeometry(PolygonsSet poly, String label) {
        Vector2D[][] vertices = poly.getVertices();
        if (vertices == null || vertices.length != 0) {
            throw new RuntimeException("[oracle:whole-vertices] metamorphic violation: whole-space leaf must have zero vertex loops input="
                    + label + " vertices=" + verticesSummary(vertices));
        }
        double size = poly.getSize();
        if (!Double.isInfinite(size) || size < 0.0) {
            throw new RuntimeException("[oracle:whole-size] metamorphic violation: whole-space leaf must have infinite size input="
                    + label + " size=" + size);
        }
        Vector2D bc = asVector(poly.getBarycenter());
        if (bc == null || !Double.isNaN(bc.getX()) || !Double.isNaN(bc.getY())) {
            throw new RuntimeException("[oracle:whole-barycenter] metamorphic violation: whole-space leaf must have NaN barycenter input="
                    + label + " barycenter=" + pointToString(bc));
        }
    }

    private static void assertEmptyGeometry(PolygonsSet poly, String label) {
        Vector2D[][] vertices = poly.getVertices();
        if (vertices == null || vertices.length != 0) {
            throw new RuntimeException("[oracle:empty-vertices] metamorphic violation: empty leaf must have zero vertex loops input="
                    + label + " vertices=" + verticesSummary(vertices));
        }
        double size = poly.getSize();
        if (!sameDouble(size, 0.0)) {
            throw new RuntimeException("[oracle:empty-size] metamorphic violation: empty leaf must have zero size input="
                    + label + " size=" + size);
        }
        Vector2D bc = asVector(poly.getBarycenter());
        if (bc == null || !sameDouble(bc.getX(), 0.0) || !sameDouble(bc.getY(), 0.0)) {
            throw new RuntimeException("[oracle:empty-barycenter] metamorphic violation: empty leaf must have barycenter (0,0) input="
                    + label + " barycenter=" + pointToString(bc));
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (isOracleFailure(t)) {
            return true;
        }
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (StackTraceElement e : st) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls)
                    && ("computeGeometricalProperties".equals(m)
                    || "getVertices".equals(m)
                    || "followLoop".equals(m)
                    || "getTree".equals(m)
                    || "getCut".equals(m)
                    || "visit".equals(m)
                    || "getLine".equals(m)
                    || "getStart".equals(m)
                    || "toSpace".equals(m)
                    || "toSubSpace".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOracleFailure(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("[oracle:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.startsWith("org.apache.commons.math3.exception.")) {
            return true;
        }
        if (name.contains("Illegal") || name.contains("Invalid") || name.contains("Format")) {
            return true;
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isCleanRejection(cause);
    }

    private static double finiteCoord(int raw) {
        return raw % 1000000;
    }

    private static double positiveSpan(int raw) {
        double v = Math.abs((double) (raw % 1000000));
        return v + 1.0;
    }

    private static Vector2D asVector(Point<Euclidean2D> p) {
        if (p == null) {
            return null;
        }
        if (p instanceof Vector2D) {
            return (Vector2D) p;
        }
        return null;
    }

    private static boolean sameVector(Vector2D a, Vector2D b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        return sameDouble(a.getX(), b.getX()) && sameDouble(a.getY(), b.getY());
    }

    private static boolean sameDouble(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        return Double.isNaN(a) && Double.isNaN(b);
    }

    private static String pointToString(Vector2D p) {
        if (p == null) {
            return "null";
        }
        return "(" + p.getX() + "," + p.getY() + ")";
    }

    private static String verticesSummary(Vector2D[][] vertices) {
        if (vertices == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append("loops=").append(vertices.length).append('[');
        for (int i = 0; i < vertices.length; i++) {
            if (i > 0) {
                sb.append(';');
            }
            Vector2D[] loop = vertices[i];
            if (loop == null) {
                sb.append("null");
                continue;
            }
            sb.append(loop.length).append(':');
            int limit = Math.min(loop.length, 4);
            for (int j = 0; j < limit; j++) {
                if (j > 0) {
                    sb.append(',');
                }
                sb.append(pointToString(loop[j]));
            }
            if (loop.length > limit) {
                sb.append("...");
            }
        }
        sb.append(']');
        return sb.toString();
    }
}
