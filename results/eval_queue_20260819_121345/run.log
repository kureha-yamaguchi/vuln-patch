package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int n = clamp(data.consumeInt(3, 8), 3, 8);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        int duplicatedGeq = clamp(data.consumeInt(2, 5), 2, 5);
        int pivotVar = clamp(data.consumeInt(1, n - 1), 1, n - 1);
        double sharedCoeff = positiveSmall(data.consumeInt(1, 5));
        double sharedRhs = positiveSmall(data.consumeInt(1, 5));

        for (int i = 0; i < duplicatedGeq; i++) {
            double[] c = new double[n];
            c[0] = 0.0d;
            c[pivotVar] = sharedCoeff;
            int extra = clamp(data.consumeInt(0, n - 2), 0, n - 2);
            for (int j = 0; j < extra; j++) {
                int idx = 1 + Math.abs(data.consumeInt()) % (n - 1);
                c[idx] += smallSigned(data.consumeInt());
            }
            c[pivotVar] = sharedCoeff;
            constraints.add(new LinearConstraint(c, Relationship.GEQ, sharedRhs));
        }

        int extraConstraints = clamp(data.consumeInt(1, 4), 1, 4);
        for (int i = 0; i < extraConstraints; i++) {
            double[] c = new double[n];
            for (int j = 0; j < n; j++) {
                c[j] = smallSigned(data.consumeInt());
            }
            c[0] = data.consumeBoolean() ? 0.0d : smallSigned(data.consumeInt());
            Relationship rel;
            int sel = Math.abs(data.consumeInt()) % 3;
            if (sel == 0) {
                rel = Relationship.LEQ;
            } else if (sel == 1) {
                rel = Relationship.GEQ;
            } else {
                rel = Relationship.EQ;
            }
            constraints.add(new LinearConstraint(c, rel, smallSigned(data.consumeInt())));
        }

        double[] objective = new double[n];
        objective[0] = 1.0d;
        for (int i = 1; i < n; i++) {
            objective[i] = data.consumeBoolean() ? 0.0d : smallSigned(data.consumeInt());
        }

        runCase(objective, constraints, true, 1.0e-6, clamp(Math.abs(data.consumeInt()), 1, 8));
        runCase(objective, constraints, false, 1.0e-6, clamp(Math.abs(data.consumeInt()), 1, 8));
    }

    private static void runAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] {0.0d, 1.0d, 0.0d, 0.0d}, Relationship.GEQ, 1.0d));
        constraints.add(new LinearConstraint(new double[] {0.0d, 1.0d, 0.0d, 0.0d}, Relationship.GEQ, 1.0d));
        constraints.add(new LinearConstraint(new double[] {0.0d, 0.0d, 1.0d, 0.0d}, Relationship.GEQ, 1.0d));
        constraints.add(new LinearConstraint(new double[] {0.0d, 1.0d, 1.0d, 0.0d}, Relationship.GEQ, 2.0d));
        constraints.add(new LinearConstraint(new double[] {1.0d, -1.0d, 0.0d, 0.0d}, Relationship.LEQ, 0.0d));
        constraints.add(new LinearConstraint(new double[] {1.0d, 0.0d, -1.0d, 0.0d}, Relationship.LEQ, 0.0d));
        runCase(new double[] {1.0d, 0.0d, 0.0d, 0.0d}, constraints, true, 1.0e-6, 10);
    }

    private static void runCase(double[] objectiveCoeffs, List<LinearConstraint> constraints,
                                boolean restrictToNonNegative, double epsilon, int maxUlps) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0d);

        try {
            SimplexTableau tableauA =
                    new SimplexTableau(f, constraints, GoalType.MINIMIZE, restrictToNonNegative, epsilon, maxUlps);
            SimplexTableau tableauB =
                    new SimplexTableau(f, constraints, GoalType.MINIMIZE, restrictToNonNegative, epsilon, maxUlps);

            oracleObjectiveRowCount(tableauA);
            oracleBasicRowConsistency(tableauA, maxUlps);
            oracleTableauCloneConsistency(tableauA, tableauB, maxUlps);
        } catch (RuntimeException ex) {
            if (isCleanRejection(ex)) {
                return;
            }
            throw ex;
        }

        SimplexSolver solver = new SimplexSolver(epsilon, maxUlps);
        PointValuePair first;
        try {
            first = solver.optimize(f, constraints, GoalType.MINIMIZE, restrictToNonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
                return;
            }
            return;
        }

        /* Contract used for this metamorphic check:
           optimize on a freshly constructed solver is a pure computation over the same LP inputs.
           Therefore two independent solver instances given the same objective/constraints/options
           must return the same objective value and point dimension when both calls succeed.
           A band-aid patch that merely suppresses the cycling symptom can still return a different
           solution on repeated fresh solves; this check catches that without relying on exceptions. */
        try {
            SimplexSolver solver2 = new SimplexSolver(epsilon, maxUlps);
            PointValuePair second = solver2.optimize(f, constraints, GoalType.MINIMIZE, restrictToNonNegative);
            if (first != null && second != null) {
                double v1 = first.getValue();
                double v2 = second.getValue();
                double[] p1 = first.getPoint();
                double[] p2 = second.getPoint();
                if (p1.length != p2.length || !Precision.equals(v1, v2, 4)) {
                    throw new RuntimeException("[oracle:fresh-solver-determinism] metamorphic violation: repeated fresh solves disagree value1=" + v1 + " value2=" + v2 + " dim1=" + p1.length + " dim2=" + p2.length);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
                return;
            }
        }
    }

    private static void oracleObjectiveRowCount(SimplexTableau tableau) {
        int reported = tableau.getNumObjectiveFunctions();
        int independent = tableau.getNumArtificialVariables() > 0 ? 2 : 1;
        if (reported != independent) {
            throw new RuntimeException("[oracle:objective-row-count] consistency violation: reported=" + reported + " independent=" + independent);
        }
        if (tableau.getHeight() < reported || tableau.getWidth() <= 0) {
            throw new RuntimeException("[oracle:tableau-shape] consistency violation: height=" + tableau.getHeight() + " width=" + tableau.getWidth() + " objectiveRows=" + reported);
        }
    }

    private static void oracleBasicRowConsistency(SimplexTableau tableau, int maxUlps) {
        int startRow = tableau.getNumObjectiveFunctions();
        int width = tableau.getWidth();
        int height = tableau.getHeight();

        for (int col = 0; col < width - 1; col++) {
            Integer reported = tableau.getBasicRow(col);
            Integer empirical = empiricalBasicRow(tableau, col, startRow, height, maxUlps);
            if (reported == null ? empirical != null : !reported.equals(empirical)) {
                throw new RuntimeException("[oracle:basic-row-consistency] consistency violation: column=" + col + " reported=" + reported + " empirical=" + empirical + " width=" + width + " height=" + height);
            }
        }
    }

    private static void oracleTableauCloneConsistency(SimplexTableau a, SimplexTableau b, int maxUlps) {
        if (a.getWidth() != b.getWidth() || a.getHeight() != b.getHeight()) {
            throw new RuntimeException("[oracle:clone-shape] consistency violation: a=" + a.getHeight() + "x" + a.getWidth() + " b=" + b.getHeight() + "x" + b.getWidth());
