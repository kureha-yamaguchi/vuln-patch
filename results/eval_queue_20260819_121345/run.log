package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int maxUlps = Math.abs(data.consumeInt());
        if (maxUlps > 32) {
            maxUlps %= 33;
        }
        double epsilon = 1e-6;

        int vars = data.consumeInt(1, 5);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, 1.0));

        if (vars > 1) {
            double[] extraEq = new double[vars];
            extraEq[1] = 1.0;
            constraints.add(new LinearConstraint(extraEq, Relationship.GEQ, 0.0));
        }

        int extra = data.consumeInt(0, 5);
        for (int i = 0; i < extra; i++) {
            double[] coeffs = new double[vars];
            coeffs[0] = 1.0;
            if (vars > 1) {
                coeffs[1] = data.consumeInt(-3, 3);
            }
            for (int j = 2; j < vars; j++) {
                coeffs[j] = data.consumeInt(-2, 2);
            }
            double rhs = 1.0;
            Relationship rel;
            int relPick = data.consumeInt(0, 2);
            if (relPick == 0) {
                rel = Relationship.GEQ;
            } else if (relPick == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }
            constraints.add(new LinearConstraint(coeffs, rel, rhs));
        }

        LinearObjectiveFunction f = new LinearObjectiveFunction(buildObjective(vars, data), 0.0);

        runPermutationOracle(f, constraints, epsilon, maxUlps);
        runScalingOracle(f, constraints, epsilon, maxUlps, data);
        runBoundaryUlpsProbe(f, constraints, epsilon, maxUlps);
    }

    private static double[] buildObjective(int vars, FuzzedDataProvider data) {
        double[] c = new double[vars];
        c[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            c[i] = data.consumeInt(-2, 2);
        }
        return c;
    }

    private static void runAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, 1.0));
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0 }, 0.0);

        PointValuePair p = trySolve(f, constraints, 1e-6, 10, 100);
        if (p != null) {
            double[] point = p.getPoint();
            if (point == null || point.length != 1 || !Precision.equals(point[0], 1.0, 1e-6)) {
                throw new RuntimeException("[oracle:anchor-x0] metamorphic violation: bounded singleton problem must solve to x0=1 input=anchor lhs=" + formatPoint(point) + " rhs=[1.0]");
            }
            if (!validSolution(p, constraints, 1e-6)) {
                throw new RuntimeException("[oracle:anchor-valid] metamorphic violation: returned anchor solution violates its own constraints input=anchor point=" + formatPoint(point) + " value=" + p.getValue());
            }
        }
    }

    private static void runPermutationOracle(LinearObjectiveFunction f, List<LinearConstraint> constraints, double epsilon, int maxUlps) {
        PointValuePair original = trySolve(f, constraints, epsilon, maxUlps, 100);
        if (original == null) {
            return;
        }

        ArrayList<LinearConstraint> reversed = new ArrayList<LinearConstraint>(constraints);
        Collections.reverse(reversed);

        PointValuePair permuted = trySolve(f, reversed, epsilon, maxUlps, 100);
        if (permuted == null) {
            return;
        }

        if (!validSolution(original, constraints, epsilon) || !validSolution(permuted, reversed, epsilon)) {
            return;
        }

        double v1 = original.getValue();
        double v2 = permuted.getValue();
        if (!close(v1, v2, 1e-7, 1e-7)) {
            throw new RuntimeException("[oracle:perm-value] metamorphic violation: reordering constraints must preserve optimum value input=" + constraints.size() + " lhs=" + v1 + " rhs=" + v2);
        }
    }

    private static void runScalingOracle(LinearObjectiveFunction f, List<LinearConstraint> constraints, double epsilon, int maxUlps, FuzzedDataProvider data) {
        PointValuePair original = trySolve(f, constraints, epsilon, maxUlps, 100);
        if (original == null || !validSolution(original, constraints, epsilon)) {
            return;
        }

        ArrayList<LinearConstraint> scaled = new ArrayList<LinearConstraint>();
        for (int i = 0; i < constraints.size(); i++) {
            LinearConstraint c = constraints.get(i);
            double factor = 1.0 + data.consumeInt(0, 3);
            double[] coeffs = c.getCoefficients().toArray();
            for (int j = 0; j < coeffs.length; j++) {
                coeffs[j] *= factor;
            }
            scaled.add(new LinearConstraint(coeffs, c.getRelationship(), c.getValue() * factor));
        }

        PointValuePair transformed = trySolve(f, scaled, epsilon, maxUlps, 100);
        if (transformed == null || !validSolution(transformed, scaled, epsilon)) {
            return;
        }

        double v1 = original.getValue();
        double v2 = transformed.getValue();
        if (!close(v1, v2, 1e-7, 1e-7)) {
            throw new RuntimeException("[oracle:scale-value] metamorphic violation: positive row scaling preserves feasible region and optimum value lhs=" + v1 + " rhs=" + v2);
        }
    }

    private static void runBoundaryUlpsProbe(LinearObjectiveFunction f, List<LinearConstraint> constraints, double epsilon, int maxUlps) {
        int near = maxUlps;
        int alt = near == 0 ? 1 : near - 1;

        PointValuePair a = trySolve(f, constraints, epsilon, near, 100);
        PointValuePair b = trySolve(f, constraints, epsilon, alt, 100);
        if (a == null || b == null) {
            return;
        }
        if (!validSolution(a, constraints, epsilon) || !validSolution(b, constraints, epsilon)) {
            return;
        }

        double va = a.getValue();
        double vb = b.getValue();
        if (!close(va, vb, 1e-7, 1e-7)) {
            throw new RuntimeException("[oracle:ulps-boundary] metamorphic violation: neighboring maxUlps settings on exact small coefficients should not change optimum value lhs=" + va + " rhs=" + vb + " ulpsA=" + near + " ulpsB=" + alt);
        }
    }

    private static PointValuePair trySolve(LinearObjectiveFunction f, List<LinearConstraint> constraints, double epsilon, int maxUlps, int maxIterations) {
        try {
            SimplexSolver solver = new SimplexSolver(epsilon, maxUlps);
            solver.setMaxIterations(maxIterations);
            PointValuePair before = null;
            PointValuePair after = solver.optimize(f, constraints, GoalType.MINIMIZE, true);

            if (before != null && after != null && !close(before.getValue(), after.getValue(), 0.0, 0.0)) {
                throw new RuntimeException("[oracle:solver-hidden-state] metamorphic violation: fresh solver read should not drift across identical construction lhs=" + before.getValue() + " rhs=" + after.getValue());
            }
            return after;
        } catch (Throwable t) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return null;
            }
            String name = t.getClass().getName();
            if (name.startsWith("org.apache.commons.math3.exception.")) {
                if (t instanceof MaxCountExceededException && isReachableRegion(t)) {
                    return null;
                }
                return null;
            }
            return null;
        }
    }

    private static boolean isReachableRegion(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls) && "getPivotRow".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math3.optimization.linear.SimplexTableau".equals(cls)) {
                if ("getNumObjectiveFunctions".equals(m) ||
                    "getHeight".equals(m) ||
                    "getWidth".equals(m) ||
                    "getEntry".equals(m) ||
                    "getNumArtificialVariables".equals(m) ||
                    "getArtificialVariableOffset".equals(m) ||
                    "getBasicRow".equals(m)) {
                    return true;
                }
            }
            if ("org.apache.commons.math3.util.Precision".equals(cls) &&
                ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls) ||
                "org.apache.commons.math3.linear.AbstractRealMatrix".equals(cls)) {
                if ("getRowDimension".equals(m) || "getColumnDimension".equals(m) || "getEntry".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean validSolution(PointValuePair solution, List<LinearConstraint> constraints, double epsilon) {
        double[] vals = solution.getPoint();
        for (LinearConstraint c : constraints) {
            double[] coeffs = c.getCoefficients().toArray();
            double result = 0.0d;
            for (int i = 0; i < vals.length && i < coeffs.length; i++) {
                result += vals[i] * coeffs[i];
            }

            switch (c.getRelationship()) {
                case EQ:
                    if (!Precision.equals(result, c.getValue(), epsilon)) {
                        return false;
                    }
                    break;
                case GEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) < 0) {
                        return false;
                    }
                    break;
                case LEQ:
                    if (Precision.compareTo(result, c.getValue(), epsilon) > 0) {
                        return false;
                    }
                    break;
                default:
                    return false;
            }
        }
        return true;
    }

    private static boolean close(double a, double b, double abs, double rel) {
        double diff = Math.abs(a - b);
        if (diff <= abs) {
            return true;
        }
        double scale = Math.max(Math.abs(a), Math.abs(b));
        return diff <= rel * Math.max(1.0, scale);
    }

    private static String formatPoint(double[] point) {
        if (point == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < point.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(point[i]);
        }
        sb.append(']');
        return sb.toString();
    }
}
