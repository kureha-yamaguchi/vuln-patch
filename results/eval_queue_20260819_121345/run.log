package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1, 10, false);
        runCase(Math.max(1, data.consumeInt(1, 7)), Math.max(0, data.consumeInt(0, 16)), false);
        runCase(Math.max(1, data.consumeInt(1, 7)), Math.max(0, data.consumeInt(0, 16)), true);
    }

    private static void runCase(int scale, int maxUlps, boolean extraZeroVariable) {
        double[] objective = extraZeroVariable ? new double[] { 1.0, 0.0 } : new double[] { 1.0 };
        double[] geq = extraZeroVariable ? new double[] { scale, 0.0 } : new double[] { scale };
        double[] leq = extraZeroVariable ? new double[] { scale, 0.0 } : new double[] { scale };

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(geq, Relationship.GEQ, scale));
        constraints.add(new LinearConstraint(leq, Relationship.LEQ, scale));

        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        SimplexTableau tableau =
                new SimplexTableau(f, constraints, GoalType.MINIMIZE, true, 1.0e-6, maxUlps);

        int pivotCol = getPivotColumn(tableau, maxUlps);
        if (pivotCol < 0) {
            return;
        }

        List<Integer> minRatioPositions = getMinRatioPositions(tableau, pivotCol, maxUlps);
        if (minRatioPositions.size() <= 1) {
            return;
        }

        Integer artificialRow = null;
        Integer artificialColumn = null;
        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                double entry = tableau.getEntry(row.intValue(), column);
                Integer basicRow = tableau.getBasicRow(column);
                if (Precision.equals(entry, 1d, maxUlps) && row.equals(basicRow)) {
                    artificialRow = row;
                    artificialColumn = Integer.valueOf(column);
                    break;
                }
            }
            if (artificialRow != null) {
                break;
            }
        }

        Integer blandRow = getBlandRow(tableau, minRatioPositions);

        if (artificialRow == null || blandRow == null || artificialRow.equals(blandRow)) {
            return;
        }

        SimplexSolver solver = new SimplexSolver(1.0e-6, maxUlps);
        solver.doIteration(tableau);

        Integer actualPivotRow = tableau.getBasicRow(pivotCol);

        if (!blandRow.equals(actualPivotRow)) {
            throw new RuntimeException(
                    "[oracle:pivot-row] metamorphic violation: tied minimum-ratio pivot must follow Bland tie-break here, not force the artificial row"
                            + " scale=" + scale
                            + " maxUlps=" + maxUlps
                            + " extraZeroVariable=" + extraZeroVariable
                            + " pivotCol=" + pivotCol
                            + " minRatioRows=" + minRatioPositions
                            + " artificialRow=" + artificialRow
                            + " artificialColumn=" + artificialColumn
                            + " expectedBlandRow=" + blandRow
                            + " actualPivotRow=" + actualPivotRow);
        }

        if (artificialColumn != null) {
            Integer postArtificialBasicRow = tableau.getBasicRow(artificialColumn.intValue());
            if (!artificialRow.equals(postArtificialBasicRow)) {
                throw new RuntimeException(
                        "[oracle:artificial-basis] metamorphic violation: when Bland selects a different tied row, the artificial variable row must remain basic after this single iteration"
                                + " scale=" + scale
                                + " maxUlps=" + maxUlps
                                + " extraZeroVariable=" + extraZeroVariable
                                + " artificialRow=" + artificialRow
                                + " artificialColumn=" + artificialColumn
                                + " postArtificialBasicRow=" + postArtificialBasicRow);
            }
        }
    }

    private static int getPivotColumn(SimplexTableau tableau, int maxUlps) {
        double minValue = 0.0;
        int minPos = -1;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1; i++) {
            double entry = tableau.getEntry(0, i);
            if (Precision.compareTo(entry, minValue, maxUlps) < 0) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos;
    }

    private static List<Integer> getMinRatioPositions(SimplexTableau tableau, int col, int maxUlps) {
        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, maxUlps) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(Integer.valueOf(i));
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions.clear();
                    minRatioPositions.add(Integer.valueOf(i));
                }
            }
        }
        return minRatioPositions;
    }

    private static Integer getBlandRow(SimplexTableau tableau, List<Integer> minRatioPositions) {
        Integer minRow = null;
        int minIndex = tableau.getWidth();
        for (Integer row : minRatioPositions) {
            for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1 && !row.equals(minRow); i++) {
                if (row.equals(tableau.getBasicRow(i))) {
                    if (i < minIndex) {
                        minIndex = i;
                        minRow = row;
                    }
                }
            }
        }
        return minRow;
    }
}
