    private static void runAnchor() {
        double[] objective = new double[] { 1.0 };
        List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 1.0 }, Relationship.LEQ, 1.0));

        oracleArtificialRowMustLeaveBasis(objective, constraints, 10);
        metamorphicRedundantConstraint(objective, constraints, 10, 2);
    }

    private static void oracleArtificialRowMustLeaveBasis(double[] objectiveCoeffs,
                                                          List<LinearConstraint> constraints,
                                                          int maxUlps) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0);
        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, maxUlps);
        SimplexSolver solver = new SimplexSolver(1.0e-6, maxUlps);

        int decisionCol = tableau.getNumObjectiveFunctions();
        int rhsCol = tableau.getWidth() - 1;

        List<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;
        for (int row = tableau.getNumObjectiveFunctions(); row < tableau.getHeight(); row++) {
            double rhs = tableau.getEntry(row, rhsCol);
            double entry = tableau.getEntry(row, decisionCol);
            if (Precision.compareTo(entry, 0d, maxUlps) > 0) {
                double ratio = rhs / entry;
                int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(row);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions.clear();
                    minRatioPositions.add(row);
                }
            }
        }

        if (minRatioPositions.size() <= 1) {
            return;
        }

        Integer forcedRow = null;
        int forcedArtificialCol = -1;
        for (Integer row : minRatioPositions) {
            for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                int column = i + tableau.getArtificialVariableOffset();
                double entry = tableau.getEntry(row.intValue(), column);
                Integer basicRow = tableau.getBasicRow(column);
                if (Precision.equals(entry, 1d, maxUlps) && row.equals(basicRow)) {
                    if (forcedRow != null) {
                        return;
                    }
                    forcedRow = row;
                    forcedArtificialCol = column;
                }
            }
        }

        if (forcedRow == null) {
            return;
        }

        int artificialBasicsBefore = countBasicArtificials(tableau);
        try {
            solver.doIteration(tableau);
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            return;
        }

        Integer basicAfter = tableau.getBasicRow(forcedArtificialCol);
        int artificialBasicsAfter = countBasicArtificials(tableau);

        if (basicAfter != null && basicAfter.intValue() == forcedRow.intValue()) {
            throw new RuntimeException(
                "[oracle:force-artificial] metamorphic violation: tied minimum-ratio row with a basic artificial variable was not forced out of the basis"
                    + " row=" + forcedRow
                    + " artificialCol=" + forcedArtificialCol
                    + " artificialBasicsBefore=" + artificialBasicsBefore
                    + " artificialBasicsAfter=" + artificialBasicsAfter);
        }

        if (artificialBasicsAfter >= artificialBasicsBefore) {
            throw new RuntimeException(
                "[oracle:force-artificial-count] metamorphic violation: a pivot that should eject a uniquely eligible artificial basic variable did not reduce the number of basic artificial variables"
                    + " forcedRow=" + forcedRow
                    + " artificialCol=" + forcedArtificialCol
                    + " artificialBasicsBefore=" + artificialBasicsBefore
                    + " artificialBasicsAfter=" + artificialBasicsAfter);
        }
    }

    private static int countBasicArtificials(SimplexTableau tableau) {
        int count = 0;
        for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
            int col = i + tableau.getArtificialVariableOffset();
            if (tableau.getBasicRow(col) != null) {
                count++;
            }
        }
        return count;
    }

    private static void metamorphicRedundantConstraint(double[] objectiveCoeffs,
                                                       List<LinearConstraint> constraints,
                                                       int maxUlps,
                                                       int scale) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objectiveCoeffs, 0.0);

        PointValuePair original;
        try {
            original = new SimplexSolver(1.0e-6, maxUlps)
                .optimize(f, constraints, GoalType.MAXIMIZE, true);
        } catch (Throwable t) {
            return;
        }

        List<LinearConstraint> augmented = new ArrayList<LinearConstraint>(constraints);
        LinearConstraint chosen = constraints.get(1);
        double[] scaled = chosen.getCoefficients().toArray();
        for (int i = 0; i < scaled.length; i++) {
            scaled[i] *= scale;
        }
        augmented.add(new LinearConstraint(scaled, chosen.getRelationship(), chosen.getValue() * scale));
        Collections.reverse(augmented);

        PointValuePair withRedundant;
        try {
            withRedundant = new SimplexSolver(1.0e-6, maxUlps)
                .optimize(f, augmented, GoalType.MAXIMIZE, true);
        } catch (Throwable t) {
            return;
        }

        double v1 = original.getValue();
        double v2 = withRedundant.getValue();
        if (Math.abs(v1 - v2) > 1.0e-6) {
            throw new RuntimeException(
                "[oracle:redundant-constraint] metamorphic violation: adding a positive scalar multiple of an existing constraint changed the optimum value"
                    + " original=" + v1
                    + " redundant=" + v2
                    + " scale=" + scale
                    + " constraints=" + constraints.size());
        }

        double[] p1 = original.getPoint();
        double[] p2 = withRedundant.getPoint();
        if (p1 != null && p2 != null && p1.length == p2.length) {
            double maxDiff = 0.0;
            for (int i = 0; i < p1.length; i++) {
                maxDiff = Math.max(maxDiff, Math.abs(p1[i] - p2[i]));
            }
            if (maxDiff > 1.0e-6) {
                throw new RuntimeException(
                    "[oracle:redundant-point] metamorphic violation: equivalent constraint systems produced different solution points"
                        + " maxDiff=" + maxDiff
                        + " dims=" + p1.length
                        + " scale=" + scale);
            }
        }
    }
}
