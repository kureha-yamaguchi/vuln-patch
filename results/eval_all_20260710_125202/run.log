package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted:
         * Commons Lang tests document that NumberUtils.createNumber accepts valid integral
         * decimal strings with either 'l' or 'L' suffix (e.g. "12345L", "12345l",
         * "-1l", "01l") and returns the same numeric value for both suffixes.
         * A patch that merely guards away the crashing branch or silently changes its
         * behavior could stop the exception while still rejecting or misparsing valid
         * long-suffixed numbers. We therefore assert lower/upper-case suffix equivalence
         * on valid-by-construction inputs in addition to exploring the original invalid seeds.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryCreateNumber(anchors[i]);
        }

        String candidate;
        switch (data.consumeInt(0, 9)) {
            case 0:
                candidate = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 2:
                candidate = data.consumeBoolean() ? "d" : "D";
                break;
            case 3:
                candidate = oneCharOrDefault(data.consumeAsciiString(1), data.consumeBoolean() ? "l" : "L");
                break;
            case 4:
                candidate = oneCharOrDefault(data.consumeString(1), data.consumeBoolean() ? "l" : "L");
                break;
            case 5:
                candidate = data.consumeAsciiString(20) + (data.consumeBoolean() ? "l" : "L");
                break;
            case 6:
                candidate = data.consumeAsciiString(20) + (data.consumeBoolean() ? "f" : "F");
                break;
            case 7:
                candidate = data.consumeAsciiString(20) + (data.consumeBoolean() ? "d" : "D");
                break;
            case 8:
                candidate = "0x" + hexOnly(data.consumeAsciiString(16));
                break;
            default:
                candidate = "-0x" + hexOnly(data.consumeAsciiString(16));
                break;
        }
        tryCreateNumber(candidate);

        String raw = data.consumeAsciiString(32);
        String digits = decimalDigitsOnly(raw, false);
        String signedDigits = decimalDigitsOnly(raw, true);
        String exp = decimalDigitsOnly(data.consumeAsciiString(8), true);

        if (digits.length() == 0) {
            digits = "0";
        }
        if (!isSignedDecimalDigits(signedDigits)) {
            signedDigits = Integer.toString(data.consumeInt());
        }
        if (!isSignedDecimalDigits(exp)) {
            exp = "0";
        }

        String hugeDigits = repeatDigits(nonZeroDigits(digits), data.consumeInt(2, 6));
        if (hugeDigits.length() < 20) {
            hugeDigits = hugeDigits + "12345678901234567890";
        }

        String[] explore = new String[] {
                raw,
                signedDigits + (data.consumeBoolean() ? "l" : "L"),
                hugeDigits + (data.consumeBoolean() ? "l" : "L"),
                signedDigits + "." + nonZeroDigits(digits) + (data.consumeBoolean() ? "f" : "F"),
                signedDigits + "." + nonZeroDigits(digits) + (data.consumeBoolean() ? "d" : "D"),
                signedDigits + "." + nonZeroDigits(digits) + "E" + exp + (data.consumeBoolean() ? "f" : "F"),
                signedDigits + "." + nonZeroDigits(digits) + "E" + exp + (data.consumeBoolean() ? "d" : "D"),
                "0x" + hexOnly(data.consumeAsciiString(16)),
                "-0x" + hexOnly(data.consumeAsciiString(16)),
                data.consumeRemainingAsString()
        };
        for (int i = 0; i < explore.length; i++) {
            tryCreateNumber(explore[i]);
        }

        int n = data.consumeInt();
        String canonical = Integer.toString(n);
        assertCanonicalLongParses(canonical, "l", n);
        assertCanonicalLongParses(canonical, "L", n);

        try {
            Number lower = NumberUtils.createNumber(canonical + "l");
            Number upper = NumberUtils.createNumber(canonical + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + canonical
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }

        String zeroPadded = zeroPadCanonical(canonical, data.consumeInt(1, 6));
        tryLongSuffixEquivalence(zeroPadded);
        tryLongSuffixEquivalence("-1");
        tryLongSuffixEquivalence("01");
        tryLongSuffixEquivalence(hugeDigits);

        String decimalBase = canonical + "." + nonZeroDigits(digits);
        tryFloatSuffixEquivalence(decimalBase);
        tryDoubleSuffixEquivalence(decimalBase);
        tryFloatSuffixEquivalence(decimalBase + "E" + exp);
        tryDoubleSuffixEquivalence(decimalBase + "E" + exp);

        tryCreateNumber("0x" + hexOnly(data.consumeAsciiString(32)));
        tryCreateNumber("-0x" + hexOnly(data.consumeAsciiString(32)));
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static void assertCanonicalLongParses(String canonical, String suffix, int expected) {
        try {
            Number n = NumberUtils.createNumber(canonical + suffix);
            if (!(n instanceof Long) || n.longValue() != (long) expected) {
                throw new RuntimeException(
                        "metamorphic violation: canonical decimal with long suffix parsed incorrectly input="
                                + canonical + suffix + " result=" + describe(n) + " expected=" + expected);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static void tryLongSuffixEquivalence(String base) {
        try {
            Number lower = NumberUtils.createNumber(base + "l");
            Number upper = NumberUtils.createNumber(base + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static void tryFloatSuffixEquivalence(String base) {
        try {
            Number lower = NumberUtils.createNumber(base + "f");
            Number upper = NumberUtils.createNumber(base + "F");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'f') != createNumber(x+'F') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static void tryDoubleSuffixEquivalence(String base) {
        try {
            Number lower = NumberUtils.createNumber(base + "d");
            Number upper = NumberUtils.createNumber(base + "D");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'d') != createNumber(x+'D') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        return a.getClass().equals(b.getClass()) && String.valueOf(a).equals(String.valueOf(b));
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + String.valueOf(n);
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof StringIndexOutOfBoundsException || cur instanceof IndexOutOfBoundsException) {
                StackTraceElement[] trace = cur.getStackTrace();
                for (int i = 0; i < trace.length; i++) {
                    String cls = trace[i].getClassName();
                    String method = trace[i].getMethodName();
                    if ("org.apache.commons.lang.NumberUtils".equals(cls) && "createNumber".equals(method)) {
                        return true;
                    }
                    if ("org.apache.commons.lang.NumberUtils".equals(cls)
                            && ("createInteger".equals(method) || "isAllZeros".equals(method))) {
                        return true;
                    }
                    if ("java.lang.String".equals(cls)
                            && ("charAt".equals(method) || "substring".equals(method))) {
                        return true;
                    }
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static String oneCharOrDefault(String s, String dflt) {
        if (s == null || s.length() == 0) {
            return dflt;
        }
        return s.substring(0, 1);
    }

    private static String decimalDigitsOnly(String s, boolean allowSign) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            } else if (allowSign && out.length() == 0 && (c == '-' || c == '+')) {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static boolean isSignedDecimalDigits(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = 0;
        char first = s.charAt(0);
        if (first == '-' || first == '+') {
            if (s.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }

    private static String hexOnly(String s) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            return "0";
        }
        return out.toString();
    }

    private static String nonZeroDigits(String s) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        boolean anyDigit = false;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                anyDigit = true;
                break;
            }
        }
        return anyDigit ? s : "0";
    }

    private static String repeatDigits(String s, int times) {
        if (s == null || s.length() == 0 || times <= 0) {
            return "";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < times; i++) {
            out.append(s);
        }
        return out.toString();
    }

    private static String zeroPadCanonical(String canonical, int zeros) {
        if (canonical == null || canonical.length() == 0) {
            return "0";
        }
        StringBuffer out = new StringBuffer();
        int start = 0;
        if (canonical.charAt(0) == '-') {
            out.append('-');
            start = 1;
        } else if (canonical.charAt(0) == '+') {
            out.append('+');
            start = 1;
        }
        for (int i = 0; i < zeros; i++) {
            out.append('0');
        }
        out.append(canonical.substring(start));
        return out.toString();
    }
}
