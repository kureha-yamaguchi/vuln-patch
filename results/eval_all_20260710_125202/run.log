package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkAnchor("\uD83D\uDE30");
        checkAnchor("\uD800\uDC00");
        checkAnchor("\uD834\uDD1E");
        checkAnchor("\uDBFF\uDFFD");

        String built = buildValidCsvSafeStringWithSupplementaryCodePoints(data);
        checkIdentityOrRootCause(built);

        if (data.consumeBoolean()) {
            String extra = buildValidCsvSafeStringWithSupplementaryCodePoints(data);
            checkIdentityOrRootCause(extra);
        }
    }

    private static void checkAnchor(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            if (!s.equals(out)) {
                throw new RuntimeException("metamorphic violation: escapeCsv identity on CSV-safe surrogate input input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void checkIdentityOrRootCause(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);
            /*
             * Contract asserted:
             * escapeCsv only needs to quote/escape strings containing CSV metacharacters
             * (comma, double quote, CR, LF). For inputs built here, we exclude all of
             * those characters by construction, so a correct implementation must return
             * the input unchanged. A "fix" that merely avoids the crash by skipping
             * bookkeeping or dropping part of a surrogate pair would violate this
             * observable identity property.
             */
            if (!s.equals(out)) {
                throw new RuntimeException("metamorphic violation: escapeCsv identity on CSV-safe surrogate input input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static String buildValidCsvSafeStringWithSupplementaryCodePoints(FuzzedDataProvider data) {
        String prefix = sanitizeCsvSpecials(data.consumeAsciiString(data.consumeInt(0, 16)));
        String suffix = sanitizeCsvSpecials(data.consumeAsciiString(data.consumeInt(0, 16)));
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append(prefix);
        }

        for (int i = 0; i < pairCount; i++) {
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSpecials(data.consumeAsciiString(data.consumeInt(0, 8))));
            }
            int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
            sb.append(Character.toChars(cp));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSpecials(data.consumeAsciiString(data.consumeInt(0, 8))));
            }
        }

        if (data.consumeBoolean()) {
            sb.append(suffix);
        }

        if (sb.length() == 0) {
            sb.append('\uD83D').append('\uDE30');
        }
        return sb.toString();
    }

    private static String sanitizeCsvSpecials(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        return s == null ? "null" : s.replace("\r", "\\r").replace("\n", "\\n");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
