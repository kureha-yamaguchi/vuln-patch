package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int width = data.consumeInt(1, 32);
        String prefix = data.consumeString(32);
        String obj = data.consumeString(64);
        char padChar = (char) (data.consumeByte() & 0xff);

        if (obj == null) {
            obj = "";
        }
        if (obj.length() <= width) {
            String extra = data.consumeRemainingAsString();
            if (extra == null) {
                extra = "";
            }
            StringBuilder sb = new StringBuilder(obj);
            sb.append(extra);
            while (sb.length() <= width) {
                sb.append('X');
            }
            obj = sb.toString();
        }

        int exactCapacity = prefix.length() + width;
        if (exactCapacity < 0) {
            return;
        }

        StrBuilder sb = new StrBuilder(exactCapacity);
        try {
            sb.append(prefix);
        } catch (RuntimeException t) {
            if (isHarnessViolation(t)) {
                throw t;
            }
            return;
        }

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        try {
            assertFixedWidthPadRightContract(sb, prefix, obj, width, padChar);
        } catch (RuntimeException t) {
            throw t;
        }
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        // Contract asserted: when the source string is longer than width, appendFixedWidthPadRight
        // appends exactly the leftmost width characters and increases the visible content by width.
        // The regression test in the project expects "f" for ("foo", 1, '-'); a throw-deleting or
        // branch-skipping patch would violate this observable result.
        String out = sb.toString();
        if (!"f".equals(out)) {
            throw new RuntimeException("metamorphic violation: anchor expected=f actual=" + out);
        }
        if (sb.length() != 1) {
            throw new RuntimeException("metamorphic violation: anchor length expected=1 actual=" + sb.length());
        }
    }

    private static void assertFixedWidthPadRightContract(StrBuilder sb, String prefix, String obj, int width, char padChar) {
        // Contract asserted from the method body:
        // - size is increased by exactly width when width > 0
        // - if strLen >= width, the appended segment is the first width chars of str
        // - otherwise the appended segment is str followed by right-padding
        // A patch that merely suppresses the exception or skips copying would leave wrong content/length.
        String actual = sb.toString();
        String expectedSuffix;
        if (obj.length() >= width) {
            expectedSuffix = obj.substring(0, width);
        } else {
            StringBuilder tmp = new StringBuilder(width);
            tmp.append(obj);
            while (tmp.length() < width) {
                tmp.append(padChar);
            }
            expectedSuffix = tmp.toString();
        }
        String expected = prefix + expectedSuffix;

        if (sb.length() != prefix.length() + width) {
            throw new RuntimeException(
                "metamorphic violation: length after appendFixedWidthPadRight prefixLen=" + prefix.length()
                    + " width=" + width + " actualLen=" + sb.length() + " actual=" + actual);
        }
        if (!expected.equals(actual)) {
            throw new RuntimeException(
                "metamorphic violation: fixed-width-right content prefix=" + quote(prefix)
                    + " obj=" + quote(obj) + " width=" + width + " pad=" + (int) padChar
                    + " expected=" + quote(expected) + " actual=" + quote(actual));
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                String m = e.getMethodName();
                if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t != null && t.getClass() == RuntimeException.class
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static String quote(String s) {
        return s == null ? "null" : "\"" + s + "\"";
    }
}
