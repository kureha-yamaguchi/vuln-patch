                sbNull.appendFixedWidthPadRight(null, width, padChar);
                nullOk = true;
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            }

            if (!objOk || !nullOk) {
                return;
            }

            /*
             * Contract asserted: appendFixedWidthPadRight appends exactly one fixed-width field.
             * For any positive width and non-null source string, the builder must grow by exactly
             * width and append either the whole source plus right padding, or the leftmost width
             * characters if the source is longer. A throw-deleting or branch-skipping patch would
             * violate this observable post-condition.
             */
            if (width > 0) {
                String expectedSuffix;
                if (source.length() >= width) {
                    expectedSuffix = source.substring(0, width);
                } else {
                    StrBuilder tmp = new StrBuilder(source.length() + width);
                    tmp.append(source);
                    for (int i = source.length(); i < width; i++) {
                        tmp.append(padChar);
