        }

        GoalType goal = useMinimizeEquivalent ? GoalType.MINIMIZE : GoalType.MAXIMIZE;

        PointValuePair p1 = solve(f, constraints, goal);

        ArrayList<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
        Collections.rotate(permuted, 1);
        PointValuePair p2 = solve(f, permuted, goal);

        /* Contract used for the mandatory check:
