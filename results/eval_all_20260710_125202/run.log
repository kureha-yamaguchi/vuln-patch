                    + " inputXs=" + Arrays.toString(xs)
                    + " inputYs=" + Arrays.toString(ys)
                    + " lhs=" + Arrays.toString(lhs)
                    + " rhs=" + Arrays.toString(rhs));
        }
    }

    private static boolean approximatelyEqual(double[] a, double[] b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            double x = a[i];
            double y = b[i];
            if (Double.isNaN(x) || Double.isNaN(y)) {
                if (!(Double.isNaN(x) && Double.isNaN(y))) {
                    return false;
                }
                continue;
            }
            if (Double.isInfinite(x) || Double.isInfinite(y)) {
                if (x != y) {
                    return false;
                }
                continue;
            }
            double diff = Math.abs(x - y);
            double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
            if (diff > 1e-9 * scale) {
                return false;
            }
        }
        return true;
    }

    private static boolean isRootCause(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (!(t instanceof NotStrictlyPositiveException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if (("org.apache.commons.math.analysis.function.Gaussian$Parametric".equals(cls)
                    && "validateParameters".equals(method))
                || ("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls)
                    && "fit".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
