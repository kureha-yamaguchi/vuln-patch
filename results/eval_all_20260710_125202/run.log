        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (RuntimeException e) {\n            if (isHarnessViolation(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        if (data.remainingBytes() <= 0) {\n            return;\n        }\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int firstMax = maxOrd - (count + 4);\n        if (firstMax < 0) {\n            return;\n        }\n        int first = data.consumeInt(0, firstMax);\n        int gapMax = Math.min(64, maxOrd - first - (count - 1));\n        if (gapMax < 2) {\n            return;\n        }\n\n        ords[0] = first;\n        ords[1] = first + data.consumeInt(2, gapMax);\n\n        int current = ords[1];\n        for (int i = 2; i < count; i++) {\n            int remaining = count - i;\n            int maxStep = maxOrd - current - remaining;\n            if (maxStep < 1) {\n                return;\n            }\n            current += data.consumeInt(1, Math.min(64, maxStep));\n            ords[i] = current;\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < count; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), Integer.valueOf(data.consumeInt()));\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int gapIndex = findGap(ords);\n        if (gapIndex < 0) {\n            return;\n        }\n\n        int left = ords[gapIndex];\n        int right = ords[gapIndex + 1];\n        if (right - left < 2) {\n            return;\n        }\n\n        int startOrd = data.consumeInt(left + 1, right - 1);\n        int endOrd = data.consumeInt(startOrd, right - 1);\n\n        Day start = dayFromOrdinal(startOrd);\n        Day end = dayFromOrdinal(endOrd);\n\n        try {\n            series.getIndex(start);\n            series.getIndex(end);\n\n            TimeSeries copy = series.createCopy(start, end);\n            if (copy == null) {\n                throw new RuntimeException(\"metamorphic violation: null copy for valid same-gap range startOrd=\" + startOrd + \" endOrd=\" + endOrd);\n            }\n\n            /*\n             * Contract checked: createCopy(start, end) returns the items whose periods lie in\n             * the inclusive range [start, end]. When start/end are valid ordered periods that\n             * lie wholly inside a gap between existing items, there are no source items in that\n             * range, so the copy must be empty. A throw-deleting/bookkeeping-only patch can\n             * silently return the wrong slice; this observable itemCount check catches that.\n             */\n            if (copy.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: copy wholly inside gap must be empty startOrd=\"\n                        + startOrd + \" endOrd=\" + endOrd + \" itemCount=\" + copy.getItemCount());\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (RuntimeException e) {\n            if (isHarnessViolation(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        if (right - left >= 3) {\n            int startOrd2 = data.consumeInt(left + 1, right - 1);\n            int endOrd2 = data.consumeInt(startOrd2, right - 1);\n\n            Day start2 = dayFromOrdinal(startOrd2);\n            Day end2 = dayFromOrdinal(endOrd2);\n\n            try {\n                TimeSeries copyA = series.createCopy(start, end);\n                TimeSeries copyB = series.createCopy(start2, end2);\n\n                /*\n                 * Equivalent-inputs relation: any two valid ranges chosen wholly inside the same\n                 * empty gap select exactly the same set of source items: none. Therefore both\n                 * copies must be equivalent.\n                 */\n                assertEquivalentCopies(copyA, copyB,\n                    \"same-gap ranges range1=\" + startOrd + \"..\" + endOrd\n                        + \" range2=\" + startOrd2 + \"..\" + endOrd2);\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (RuntimeException e) {\n                if (isHarnessViolation(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        int beforeFirstOrd = ords[0] - 1;\n        if (beforeFirstOrd >= 0) {\n            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);\n            try {\n                series.getIndex(beforeFirst);\n                TimeSeries empty = series.createCopy(beforeFirst, beforeFirst);\n\n                /*\n                 * Contract checked: a valid ordered range entirely before the first series item\n                 * contains no source items, so createCopy must succeed and return an empty series.\n                 */\n                if (empty == null) {\n                    throw new RuntimeException(\"metamorphic violation: null copy for before-first range ord=\" + beforeFirstOrd);\n                }\n                if (empty.getItemCount() != 0) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: before-first range must copy to empty series ord=\"\n                            + beforeFirstOrd + \" itemCount=\" + empty.getItemCount());\n                }\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (RuntimeException e) {\n                if (isHarnessViolation(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            /*\n             * Equivalent-inputs relation: when the bounds are existing periods taken directly\n             * from indices i..j, createCopy(startPeriod, endPeriod) and createCopy(i, j)\n             * describe the same inclusive slice and must therefore produce equivalent copies.\n             */\n            assertEquivalentCopies(byPeriod, byIndex,\n                \"existing-period copy equals index copy i=\" + i + \" j=\" + j);\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        } catch (RuntimeException e) {\n            if (isHarnessViolation(e)) {\n                throw e;\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
        "private static void runAnchor() throws CloneNotSupportedException {\n        TimeSeries s = new TimeSeries(\"S\");\n        s.add(new Day(19, 8, 2005), Integer.valueOf(1));\n        s.add(new Day(31, 1, 2006), Integer.valueOf(1));\n\n        Day start = new Day(1, 12, 2005);\n        Day end = new Day(18, 1, 2006);\n\n        try {\n            s.getIndex(start);\n            s.getIndex(end);\n            TimeSeries copy = s.createCopy(start, end);\n            if (copy == null) {\n                throw new RuntimeException(\"metamorphic violation: anchor copy is null\");\n            }\n            if (copy.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor same-gap copy must be empty itemCount=\" + copy.getItemCount());\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        }\n\n        Day beforeFirst = new Day(18, 8, 2005);\n        try {\n            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);\n            if (empty == null) {\n                throw new RuntimeException(\"metamorphic violation: anchor before-first copy is null\");\n            }\n            if (empty.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor before-first copy must be empty itemCount=\" + empty.getItemCount());\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        }\n\n        TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));\n        TimeSeries byIndex = s.createCopy(0, 1);\n        assertEquivalentCopies(byPeriod, byIndex, \"anchor existing-period copy vs index copy\");\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        final int MAX_ORD = 28 * 12 * 40 - 1;\n\n        TimeSeries anchor = new TimeSeries(\"S\");\n        try {\n            anchor.add(new Day(19, 8, 2005), 1);\n            anchor.add(new Day(31, 1, 2006), 1);\n        } catch (RuntimeException e) {\n            return;\n        }\n\n        Day anchorStart = new Day(1, 12, 2005);\n        Day anchorEnd = new Day(18, 1, 2006);\n        try {\n            anchor.getIndex(anchorStart);\n            anchor.getIndex(anchorEnd);\n            TimeSeries copy = anchor.createCopy(anchorStart, anchorEnd);\n            if (copy == null) {\n                throw new RuntimeException(\"metamorphic violation: anchor same-gap copy returned null\");\n            }\n            /*\n             * Contract asserted: createCopy(start, end) returns the items whose periods lie in\n             * the inclusive range [start, end]. When both bounds lie strictly inside the same\n             * gap between consecutive items, there are no matching items, so the copy must be\n             * empty. A throw-deleting or bookkeeping-breaking patch can silently return the\n             * wrong slice; this observable itemCount check catches that.\n             */\n            if (copy.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor same-gap copy must be empty itemCount=\"\n                        + copy.getItemCount());\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        } catch (IllegalArgumentException e) {\n            boolean root = false;\n            for (StackTraceElement ste : e.getStackTrace()) {\n                String cn = ste.getClassName();\n                String mn = ste.getMethodName();\n                if (\"org.jfree.data.time.TimeSeries\".equals(cn)\n                        && (\"createCopy\".equals(mn) || \"getIndex\".equals(mn) || \"clone\".equals(mn))) {\n                    root = true;\n                    break;\n                }\n            }\n            if (root) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor valid same-gap range was rejected\", e);\n            }\n            return;\n        } catch (RuntimeException e) {\n            throw e;\n        }\n\n        Day anchorBefore = new Day(18, 8, 2005);\n        try {\n            anchor.getIndex(anchorBefore);\n            TimeSeries empty = anchor.createCopy(anchorBefore, anchorBefore);\n            if (empty == null) {\n                throw new RuntimeException(\"metamorphic violation: anchor before-first copy returned null\");\n            }\n            if (empty.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor before-first copy must be empty itemCount=\"\n                        + empty.getItemCount());\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        } catch (IllegalArgumentException e) {\n            boolean root = false;\n            for (StackTraceElement ste : e.getStackTrace()) {\n                String cn = ste.getClassName();\n                String mn = ste.getMethodName();\n                if (\"org.jfree.data.time.TimeSeries\".equals(cn)\n                        && (\"createCopy\".equals(mn) || \"getIndex\".equals(mn) || \"clone\".equals(mn))) {\n                    root = true;\n                    break;\n                }\n            }\n            if (root) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor valid before-first range was rejected\", e);\n            }\n            return;\n        }\n\n        try {\n            TimeSeries byPeriod = anchor.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));\n            TimeSeries byIndex = anchor.createCopy(0, 1);\n            if (byPeriod == null || byIndex == null) {\n                throw new RuntimeException(\"metamorphic violation: anchor copy comparison returned null\");\n            }\n            /*\n             * Contract asserted: for existing boundaries taken directly from the series,\n             * createCopy(startPeriod, endPeriod) and createCopy(startIndex, endIndex) describe\n             * the same contiguous subsequence and must therefore be observably equivalent.\n             */\n            if (byPeriod.getItemCount() != byIndex.getItemCount()) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor existing-period copy != index copy itemCount lhs=\"\n                        + byPeriod.getItemCount() + \" rhs=\" + byIndex.getItemCount());\n            }\n            for (int i = 0; i < byPeriod.getItemCount(); i++) {\n                if (!byPeriod.getTimePeriod(i).equals(byIndex.getTimePeriod(i))) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: anchor existing-period copy != index copy at index \" + i);\n                }\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        } catch (IllegalArgumentException e) {\n            boolean root = false;\n            for (StackTraceElement ste : e.getStackTrace()) {\n                String cn = ste.getClassName();\n                String mn = ste.getMethodName();\n                if (\"org.jfree.data.time.TimeSeries\".equals(cn)\n                        && (\"createCopy\".equals(mn) || \"getIndex\".equals(mn) || \"clone\".equals(mn))) {\n                    root = true;\n                    break;\n                }\n            }\n            if (root) {\n                throw new RuntimeException(\n                    \"metamorphic violation: anchor existing-period copy was rejected\", e);\n            }\n            return;\n        }\n\n        int count = data.cons