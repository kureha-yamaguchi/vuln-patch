package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression input from the failing test.
        runOneCase(new SinFunction(), 3.0, 3.2, 3.1, Math.PI);

        // EXPLORE: valid-by-construction intervals around known roots k*pi of sin(x).
        // Property exercised: calling the 4-argument public API with a real non-null
        // function and a valid bracketing interval. On the buggy version, any such call
        // can hit the dropped-function bug and NPE inside BisectionSolver.solve.
        int cases = 1 + data.consumeInt(0, 4);
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-1000, 1000);
            double knownRoot = k * Math.PI;

            // Choose small positive offsets so [min, max] strictly brackets exactly one
            // root of sin(x): k*pi. Keeping each side < pi/2 preserves opposite signs.
            int leftMilli = 1 + data.consumeInt(0, 1500);
            int rightMilli = 1 + data.consumeInt(0, 1500);
            double left = leftMilli / 1000.0;
            double right = rightMilli / 1000.0;

            double min = knownRoot - left;
            double max = knownRoot + right;

            // Any initial value inside [min, max] is valid.
            int posMilli = data.consumeInt(0, leftMilli + rightMilli);
            double initial = min + (posMilli / 1000.0);

            runOneCase(new SinFunction(), min, max, initial, knownRoot);
        }
    }

    private static void runOneCase(SinFunction f, double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double withInitial = solver.solve(f, min, max, initial);

            // Post-condition / oracle from construction:
            // We constructed [min, max] to contain exactly one root of SinFunction,
            // namely expectedRoot = k*pi. A correct solver must return that root within
            // its documented accuracy. A "fix" that merely suppresses the crash or skips
            // the real solve path can return a wrong value without throwing; this check
            // catches that.
            double tol = Math.max(solver.getAbsoluteAccuracy() * 4.0, 1.0e-8);
            if (!(withInitial >= min && withInitial <= max) ||
                Math.abs(withInitial - expectedRoot) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: known-root oracle input=[" + min + "," + max + "] initial=" + initial +
                    " result=" + withInitial + " expectedRoot=" + expectedRoot + " tol=" + tol);
            }

            // Metamorphic relation:
            // For this uniquely-bracketed root, solve(f,min,max,initial) and solve(f,min,max)
            // must compute the same root. If either call throws, the relation does not apply.
            try {
                BisectionSolver solver2 = new BisectionSolver();
                double withoutInitial = solver2.solve(f, min, max);
                double tol2 = Math.max(Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()) * 4.0, 1.0e-8);
                if (Math.abs(withInitial - withoutInitial) > tol2) {
                    throw new RuntimeException(
                        "metamorphic violation: solve-with-initial vs solve-without-initial input=[" + min + "," + max +
                        "] initial=" + initial + " lhs=" + withInitial + " rhs=" + withoutInitial + " tol=" + tol2);
                }
            } catch (Throwable t) {
                if (isOwnMetamorphicViolation(t)) {
                    throw (RuntimeException) t;
                }
                if (isRootCause(t)) {
                    throw (RuntimeException) t;
                }
                // Any other exception means the relation does not apply for this input.
                return;
            }
        } catch (Throwable t) {
            if (isOwnMetamorphicViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            // Swallow out-of-scope failures to avoid false positives on correct patches.
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isOwnMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("ConvergenceException")
                || name.contains("FunctionEvaluationException")
                || name.contains("MaxIterationsExceededException")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }
}
