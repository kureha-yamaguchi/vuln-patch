            case 1:
                return left + lower + "'" + middle + right;
            case 2:
                return left + "'" + middle + "'" + right + lower;
            default:
                return lower + left + "'" + middle + right;
        }
    }

    private static String buildPattern(String left, String middle, String right, int variant) {
        switch (variant) {
            case 0:
                return left + "''" + middle + "{0,lower}" + right;
            case 1:
                return left + "{0,lower}''" + middle + right;
            case 2:
                return left + "''" + middle + "''" + right + "{0,lower}";
            default:
                return "{0,lower}" + left + "''" + middle + right;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        new ExtendedMessageFormat("it''s a {0,lower} 'test'!", REGISTRY).format(new Object[] { "DUMMY" });

