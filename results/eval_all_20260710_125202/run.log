                formatter,
                new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York")),
                "2 29",
                0,
                new MutableDateTime(2004, 2, 29, 0, 0, 0, 0, DateTimeZone.forID("America/New_York")),
                4
            );
        } catch (RuntimeException t) {
            if (shouldConvertToBug(t)) {
                throw new RuntimeException("metamorphic violation: valid leap-day parse rejected or misparsed for anchor input=2 29 zone=America/New_York", t);
            }
        }

        // ANCHOR 2: exact sibling failing test input.
        try {
            runValidCase(
                formatter,
                new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo")),
                "2 29",
                0,
                new MutableDateTime(2004, 2, 29, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo")),
                4
            );
        } catch (RuntimeException t) {
            if (shouldConvertToBug(t)) {
                throw new RuntimeException("metamorphic violation: valid leap-day parse rejected or misparsed for anchor input=2 29 zone=Asia/Tokyo", t);
            }
        }

        int[] leapYears = new int[] {2000, 2004, 2008, 2012, 2016, 2020, 2024, 2028};
        int leapYear = leapYears[data.consumeInt(0, leapYears.length - 1)];

        boolean startOfYear = data.consumeBoolean();
        DateTimeZone zone;
        MutableDateTime base;
        MutableDateTime expected;

        if (startOfYear) {
            int offsetHours = data.consumeInt(-12, -1);
            zone = DateTimeZone.forOffsetHours(offsetHours);
            int hour = data.consumeInt(0, 2) == 0 ? 0 : data.consumeInt(0, 23);
            int minute = data.consumeInt(0, 59);
            int second = data.consumeInt(0, 59);
            int millis = data.consumeInt(0, 999);
            base = new MutableDateTime(leapYear, 1, 1, hour, minute, second, millis, zone);
            expected = new MutableDateTime(leapYear, 2, 29, hour, minute, second, millis, zone);
        } else {
            int offsetHours = data.consumeInt(1, 14);
            zone = DateTimeZone.forOffsetHours(offsetHours);
            int hour = data.consumeInt(0, 2) == 0 ? 23 : data.consumeInt(0, 23);
            int minute = data.consumeInt(0, 59);
            int second = data.consumeInt(0, 59);
            int millis = data.consumeInt(0, 999);
            base = new MutableDateTime(leapYear, 12, 31, hour, minute, second, millis, zone);
            expected = new MutableDateTime(leapYear, 2, 29, hour, minute, second, millis, zone);
        }

        String core = data.consumeBoolean() ? "2 29" : "02 29";
        String prefix = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);
        String text = prefix + core + suffix;
        int position = prefix.length();

        try {
            runValidCase(formatter, base, text, position, expected, position + core.length());
        } catch (RuntimeException t) {
            if (shouldConvertToBug(t)) {
                throw new RuntimeException(
                    "metamorphic violation: valid leap-day parse rejected or misparsed input=" + quote(text)
                        + " position=" + position
                        + " zone=" + zone.getID()
                        + " base=" + base
                        + " expected=" + expected,
                    t
                );
            }
            return;
        }

        // Metamorphic relation:
        // Starting parse at the core token inside surrounding text must produce the same instant
        // as parsing the bare token from position 0, because parseInto reads from the given
        // position and the same parsed fields are applied to the same starting instant.
        // If either side throws, the relation is skipped per fuzzing hygiene.
        try {
            MutableDateTime lhs = new MutableDateTime(base.getMillis(), base.getChronology());
            MutableDateTime rhs = new MutableDateTime(base.getMillis(), base.getChronology());
            int lhsPos = formatter.parseInto(lhs, text, position);
            int rhsPos = formatter.parseInto(rhs, core, 0);
            if (lhsPos != position + core.length() || rhsPos != core.length() || !lhs.equals(rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: offset parse differs from bare parse input=" + quote(text)
                        + " core=" + quote(core)
                        + " position=" + position
                        + " lhsPos=" + lhsPos
                        + " rhsPos=" + rhsPos
                        + " lhs=" + lhs
                        + " rhs=" + rhs
                );
            }
        } catch (RuntimeException ignored) {
        }
    }

    private static void runValidCase(DateTimeFormatter formatter, MutableDateTime base, String text, int position,
                                     MutableDateTime expected, int expectedPos) {
        MutableDateTime result = new MutableDateTime(base.getMillis(), base.getChronology());
        int actualPos = formatter.parseInto(result, text, position);
        if (actualPos != expectedPos) {
            throw new RuntimeException(
                "metamorphic violation: wrong parse position input=" + quote(text)
                    + " position=" + position
                    + " actualPos=" + actualPos
                    + " expectedPos=" + expectedPos
            );
        }
        if (!result.equals(expected)) {
            throw new RuntimeException(
                "metamorphic violation: wrong parsed instant input=" + quote(text)
                    + " position=" + position
                    + " result=" + result
                    + " expected=" + expected
            );
        }
    }

    private static boolean shouldConvertToBug(Throwable t) {
        if (!isReachableRoot(t)) {
            return false;
        }
        return isValidationFamily(t) || t instanceof RuntimeException;
    }

    private static boolean isValidationFamily(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("IllegalFieldValueException")
            || name.contains("Invalid")
            || name.contains("Parse");
    }

    private static boolean isReachableRoot(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.joda.time.format.DateTimeFormatter".equals(c)
                    && ("parseInto".equals(m) || "selectChronology".equals(m) || "requireParser".equals(m))) {
                return true;
            }
            if ("org.joda.time.format.DateTimeParserBucket".equals(c) && "getOffset".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return "\"" + s + "\"";
    }
}
