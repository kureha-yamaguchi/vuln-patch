<xref>
public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (RuntimeException e) {
            if (isOwnMetamorphicViolation(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];

        int first = data.consumeInt(0, maxOrd - (count + 4));
        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first - (count - 2)));
        int second = first + initialGap;
        ords[0] = first;
        ords[1] = second;

        int current = second;
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - current - remaining;
            if (maxStep < 1) {
                return;
            }
            int step = data.consumeInt(1, Math.min(64, maxStep));
            current += step;
            ords[i] = current;
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < count; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), Integer.valueOf(data.consumeInt()));
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int gapIndex = findGap(ords);
        if (gapIndex < 0) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);

        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            series.getIndex(start);
            series.getIndex(end);

            TimeSeries copy = series.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: null copy for gap range");
            }

            /*
             * Contract exercised by the patch:
             * when start/end define a valid ordered range that lies wholly inside a gap
             * between two existing time periods, there are no source items in that range,
             * so the copy must be empty. A throw-deleting or wrong-bookkeeping patch can
             * silently return a non-empty copy (for example, by delegating to the index-based
             * overload with endIndex < startIndex), which this observable check catches.
             */
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: copy wholly inside a gap must be empty startOrd="
                    + startOrd + " endOrd=" + endOrd + " itemCount=" + copy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (RuntimeException e) {
            if (isOwnMetamorphicViolation(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        if (right - left >= 3) {
            int startOrd2 = data.consumeInt(left + 1, right - 1);
            int endOrd2 = data.consumeInt(startOrd2, right - 1);

            Day start2 = dayFromOrdinal(startOrd2);
            Day end2 = dayFromOrdinal(endOrd2);

            try {
                TimeSeries copyA = series.createCopy(start, end);
                TimeSeries copyB = series.createCopy(start2, end2);

                /*
                 * Equivalent-inputs relation:
                 * any two valid ranges chosen wholly inside the same empty gap denote the
                 * same empty subset of the source series, so both copies must be equivalent.
                 */
                assertEquivalentCopies(copyA, copyB,
                    "same-gap ranges start1=" + startOrd + ".." + endOrd
                    + " start2=" + startOrd2 + ".." + endOrd2);
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (RuntimeException e) {
                if (isOwnMetamorphicViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);

            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);

            /*
             * Equivalent-inputs relation:
             * for existing boundaries taken directly from the series, the period-based
             * overload and the index-based overload describe the same contiguous subsequence.
             */
            assertEquivalentCopies(byPeriod, byIndex, "existing-period copy equals index copy i=" + i + " j=" + j);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (RuntimeException e) {
            if (isOwnMetamorphicViolation(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }
