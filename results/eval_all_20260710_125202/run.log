private static void assertCleanInvalidRejection(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw new RuntimeException(
                        "invalid input was not rejected cleanly: input=" + s + " throwable=" + t.getClass().getName(),
                        t);
