package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        exerciseRegressionAnchors();

        requireUppercaseHexConsistency("0Xfade");
        requireUppercaseHexConsistency("-0Xfade");

        tryCreateNumber(data.consumeString(64));

        String upperHex = buildUppercaseHexLiteral(data);
        requireUppercaseHexConsistency(upperHex);

        String lowerHex = upperHex.startsWith("-0X")
                ? "-0x" + upperHex.substring(3)
                : "0x" + upperHex.substring(2);
        metamorphicEquivalentHexPrefixes(upperHex, lowerHex);

        String canonicalInt = Integer.toString(data.consumeInt());
        metamorphicCanonicalDecimal(canonicalInt);

        tryCreateNumber(buildLongLiteral(data));
        tryCreateNumber(buildScientificLiteral(data));
        tryCreateNumber(buildFixedPointLiteral(data));
        tryCreateNumber(buildBigIntegerLiteral(data));
        tryCreateNumber(data.consumeRemainingAsString());
    }

    private static void exerciseRegressionAnchors() {
        String[] literals = new String[] {
            "12345",
            "1234.5D",
            "1234.5d",
            "1234.5F",
            "1234.5f",
            "12345L",
            "12345l",
            "-1234.5",
            "-12345",
            "0xFADE",
            "-0xFADE",
            "0Xfade",
            "-0Xfade",
            "1.1E200",
            "1.1E20",
            "-1.1E200",
            "1.1E-200",
            "12345678901234567890L",
            "1.1E-700F",
            "2.",
            "-1l",
            "01l",
            "1l",
            "1eE"
        };
        for (int i = 0; i < literals.length; i++) {
            tryCreateNumber(literals[i]);
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void requireUppercaseHexConsistency(String s) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(s);
        } catch (RuntimeException ignored) {
            tryCreateNumber(s);
            return;
        }

        try {
            Number actual = NumberUtils.createNumber(s);
            if (actual == null) {
                throw new RuntimeException("metamorphic violation: valid uppercase hex returned null input=" + s);
            }
            if (actual.intValue() != expected.intValue()) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber disagrees with createInteger for uppercase hex input="
                                + s + " lhs=" + actual + " rhs=" + expected);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void metamorphicEquivalentHexPrefixes(String upper, String lower) {
        Integer upperOracle;
        Integer lowerOracle;
        try {
            upperOracle = NumberUtils.createInteger(upper);
            lowerOracle = NumberUtils.createInteger(lower);
        } catch (RuntimeException ignored) {
            tryCreateNumber(upper);
            tryCreateNumber(lower);
            return;
        }

        if (!upperOracle.equals(lowerOracle)) {
            throw new RuntimeException(
                    "metamorphic violation: createInteger oracle mismatch input=" + upper + " lhs=" + upperOracle
                            + " rhs=" + lowerOracle);
        }

        try {
            Number upperNumber = NumberUtils.createNumber(upper);
            Number lowerNumber = NumberUtils.createNumber(lower);
            if (upperNumber == null || lowerNumber == null) {
                throw new RuntimeException(
                        "metamorphic violation: equivalent 0X/0x hex inputs returned null input=" + upper + " other="
                                + lower + " lhs=" + upperNumber + " rhs=" + lowerNumber);
            }
            if (!upperNumber.equals(lowerNumber)) {
                throw new RuntimeException(
                        "metamorphic violation: 0X and 0x forms must be equivalent input=" + upper + " other=" + lower
                                + " lhs=" + upperNumber + " rhs=" + lowerNumber);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void metamorphicCanonicalDecimal(String canonicalInt) {
        try {
            Integer viaInteger = NumberUtils.createInteger(canonicalInt);
            Number viaNumber = NumberUtils.createNumber(canonicalInt);
            if (viaInteger != null && viaNumber != null && viaInteger.intValue() != viaNumber.intValue()) {
                throw new RuntimeException(
                        "metamorphic violation: canonical decimal int parse disagrees input=" + canonicalInt
                                + " lhs=" + viaNumber + " rhs=" + viaInteger);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NumberFormatException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String buildUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int digitsLen = data.consumeInt(1, 24);
        String seed = data.consumeAsciiString(digitsLen);
        String hexAlphabet = "0123456789abcdefABCDEF";
        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < digitsLen; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + (i % 10));
            digits.append(hexAlphabet.charAt((c & 0x7fffffff) % hexAlphabet.length()));
        }
        int leadingZeros = data.consumeInt(0, 8);
        StringBuilder fullDigits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            fullDigits.append('0');
        }
        fullDigits.append(digits);
        return (negative ? "-0X" : "0X") + fullDigits.toString();
    }

    private static String buildLongLiteral(FuzzedDataProvider data) {
        long value = (((long) data.consumeInt()) << 32) ^ (data.consumeInt() & 0xffffffffL);
        return Long.toString(value) + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sci = new StringBuilder();
        if (data.consumeBoolean()) {
            sci.append('-');
        }
        sci.append(nonEmptyDigits(data.consumeAsciiString(data.consumeInt(1, 12)), '1'));
        if (data.consumeBoolean()) {
            sci.append('.');
            sci.append(digitsOnly(data.consumeAsciiString(data.consumeInt(0, 12)), '0'));
        }
        sci.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sci.append(data.consumeBoolean() ? '+' : '-');
        }
        sci.append(nonEmptyDigits(data.consumeAsciiString(data.consumeInt(1, 4)), '2'));
        if (data.consumeBoolean()) {
            sci.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            sci.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return sci.toString();
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        StringBuilder fixed = new StringBuilder();
        if (data.consumeBoolean()) {
            fixed.append('-');
        }
        fixed.append(nonEmptyDigits(data.consumeAsciiString(data.consumeInt(1, 12)), '3'));
        if (data.consumeBoolean()) {
            fixed.append('.');
            fixed.append(digitsOnly(data.consumeAsciiString(data.consumeInt(0, 12)), '0'));
        } else {
            fixed.append('.');
        }
        if (data.consumeBoolean()) {
            fixed.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            fixed.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return fixed.toString();
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        StringBuilder big = new StringBuilder();
        if (data.consumeBoolean()) {
            big.append('-');
        }
        big.append(nonEmptyDigits(data.consumeAsciiString(data.consumeInt(1, 40)), '7'));
        if (data.consumeBoolean()) {
            big.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return big.toString();
    }

    private static String digitsOnly(String s, char replacement) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            out.append(Character.isDigit(c) ? c : replacement);
        }
        return out.toString();
    }

    private static String nonEmptyDigits(String s, char replacement) {
        String d = digitsOnly(s, replacement);
        return d.length() == 0 ? String.valueOf(replacement) : d;
    }
}
