package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(0.9772498680518209d, true);

        int mode = data.consumeInt(0, 5);
        double p;
        switch (mode) {
            case 0:
                p = buildAroundTwoSigma(data);
                break;
            case 1:
                p = buildFromMeanAndSigma(data);
                break;
            case 2:
                p = buildNearEdges(data, true);
                break;
            case 3:
                p = buildNearEdges(data, false);
                break;
            case 4:
                p = buildRoundedValidProbability(data);
                break;
            default:
                p = buildArbitraryValidProbability(data);
                break;
        }

        runCase(p, false);
    }

    private static void runCase(double p, boolean anchor) {
        if (!(p >= 0.0d && p <= 1.0d) || Double.isNaN(p)) {
            return;
        }

        NormalDistribution normal = new NormalDistributionImpl(0.0d, 1.0d);

        try {
            double x = normal.inverseCumulativeProbability(p);

            if (anchor) {
                if (Math.abs(x - 2.0d) > 1.0e-12d) {
                    throw new RuntimeException("metamorphic violation: anchor inverseCumulativeProbability(0.9772498680518209) input=" + p + " result=" + x + " expected=2.0");
                }
            }

            /* Contract asserted:
             * For a continuous distribution, inverseCumulativeProbability is the inverse of cumulativeProbability
             * on valid probabilities. Therefore, for any successful call x = inverseCumulativeProbability(p),
             * a correct implementation must satisfy cumulativeProbability(x) ~= p.
             * A patch that simply suppresses the throw or returns an arbitrary/wrong x would violate this.
             * Per hygiene rules, if either library call throws, we skip the check for that input.
             */
            try {
                double back = normal.cumulativeProbability(x);
                if (Double.isNaN(back) || Math.abs(back - p) > 1.0e-9d) {
                    throw new RuntimeException("metamorphic violation: cumulativeProbability(inverseCumulativeProbability(p))~=p input=" + p + " x=" + x + " back=" + back);
                }
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static double buildAroundTwoSigma(FuzzedDataProvider data) {
        long steps = (long) data.consumeInt(-1000000, 1000000);
        double delta = steps * 1.0e-16d;
        double p = 0.9772498680518209d + delta;
        if (p < 0.0d) {
            p = 0.0d;
        } else if (p > 1.0d) {
            p = 1.0d;
        }
        return p;
    }

    private static double buildFromMeanAndSigma(FuzzedDataProvider data) {
        double z = data.consumeInt(-8, 8);
        if (data.consumeBoolean()) {
            z += data.consumeInt(-1000000, 1000000) * 1.0e-12d;
        }
        NormalDistribution normal = new NormalDistributionImpl(0.0d, 1.0d);
        try {
            double p = normal.cumulativeProbability(z);
            if (p < 0.0d) {
                return 0.0d;
            }
            if (p > 1.0d) {
                return 1.0d;
            }
            return p;
        } catch (Throwable t) {
            return 0.5d;
        }
    }

    private static double buildNearEdges(FuzzedDataProvider data, boolean upper) {
        int exp = data.consumeInt(1, 300);
        double eps = Math.pow(10.0d, -exp);
        double p = upper ? (1.0d - eps) : eps;
        if (p < 0.0d) {
            p = 0.0d;
        } else if (p > 1.0d) {
            p = 1.0d;
        }
        return p;
    }

    private static double buildRoundedValidProbability(FuzzedDataProvider data) {
        int numerator = data.consumeInt(0, 1000000);
        return numerator / 1000000.0d;
    }

    private static double buildArbitraryValidProbability(FuzzedDataProvider data) {
        int hi = data.consumeInt(0, Integer.MAX_VALUE);
        int lo = data.consumeInt(0, Integer.MAX_VALUE);
        double p = (((double) hi) / ((double) Integer.MAX_VALUE)) * 0.5d
                + (((double) lo) / ((double) Integer.MAX_VALUE)) * 0.5d;
        if (p < 0.0d) {
            return 0.0d;
        }
        if (p > 1.0d) {
            return 1.0d;
        }
        return p;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal") || name.contains("Invalid") || name.contains("OutOfRange")
                    || name.contains("NotPositive") || name.contains("NotFinite")
                    || name.contains("NullArgument")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String m = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls) && "bracket".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls) && "createIllegalArgumentException".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls) && "buildMessage".equals(m)) {
                return true;
            }
        }
        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
