package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted:
         * - NumberUtils.createNumber is the public parser entry point.
         * - Invalid one-character suffix-only inputs such as "l", "L", "f", "F" must be rejected cleanly, not crash
         *   with an internal StringIndexOutOfBoundsException from the suffix-handling branch.
         * - Documented tests in Commons Lang accept both lower- and upper-case numeric suffixes for valid numbers
         *   (e.g. "12345l"/"12345L", "1234.5f"/"1234.5F", "1234.5d"/"1234.5D"). Therefore, for valid-by-construction
         *   numeric cores, lower/upper suffix variants must yield equivalent results.
         * A patch that merely skips or deletes the buggy branch can avoid the crash on "l" while still mishandling
         * valid suffix parsing, so the metamorphic checks below are the actual finding-producing assertions.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            exerciseInvalid(anchors[i]);
        }

        String probe;
        switch (data.consumeInt(0, 7)) {
            case 0:
                probe = data.consumeBoolean() ? "l" : "L";
                break;
            case 1:
                probe = data.consumeBoolean() ? "f" : "F";
                break;
            case 2:
                probe = data.consumeBoolean() ? "d" : "D";
                break;
            case 3:
                probe = oneCharOrFallback(data.consumeAsciiString(1), data.consumeBoolean() ? "l" : "L");
                break;
            case 4:
                probe = oneCharOrFallback(data.consumeString(1), data.consumeBoolean() ? "f" : "F");
                break;
            case 5:
                probe = tailCharOrFallback(data.consumeRemainingAsString(), data.consumeBoolean() ? "d" : "D");
                break;
            case 6:
                probe = sanitizeSignedDigits(data.consumeAsciiString(24), true) + (data.consumeBoolean() ? "l" : "L");
                break;
            default:
                probe = buildExplorationCandidate(data);
                break;
        }
        tryCreateNumber(probe);

        String intCore = buildIntegralCore(data);
        assertLongSuffixEquivalence(intCore, safeParseLong(intCore));

        String giantCore = buildHugeIntegralCore(data);
        assertLongSuffixEquivalence(giantCore, null);

        String decimalCore = buildDecimalCore(data);
        assertFloatSuffixEquivalence(decimalCore);

        String exponentCore = buildExponentCore(data);
        assertDoubleSuffixEquivalence(exponentCore);

        tryCreateNumber("0x" + nonEmptyHex(data.consumeAsciiString(16)));
        tryCreateNumber("-0x" + nonEmptyHex(data.consumeAsciiString(16)));
        tryCreateNumber(decimalCore);
        tryCreateNumber(exponentCore);
        tryCreateNumber(intCore + (data.consumeBoolean() ? "l" : "L"));
        tryCreateNumber(giantCore + (data.consumeBoolean() ? "l" : "L"));
    }

    private static void exerciseInvalid(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            return;
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static void assertLongSuffixEquivalence(String core, Long expectedLong) {
        try {
            Number lower = NumberUtils.createNumber(core + "l");
            Number upper = NumberUtils.createNumber(core + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
            if (expectedLong != null) {
                if (lower == null || lower.longValue() != expectedLong.longValue()) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(canonical+'l') lost numeric value input=" + core
                                    + " expected=" + expectedLong + " actual=" + describe(lower));
                }
                if (upper == null || upper.longValue() != expectedLong.longValue()) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(canonical+'L') lost numeric value input=" + core
                                    + " expected=" + expectedLong + " actual=" + describe(upper));
                }
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static void assertFloatSuffixEquivalence(String core) {
        try {
            Number lower = NumberUtils.createNumber(core + "f");
            Number upper = NumberUtils.createNumber(core + "F");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'f') != createNumber(x+'F') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static void assertDoubleSuffixEquivalence(String core) {
        try {
            Number lower = NumberUtils.createNumber(core + "d");
            Number upper = NumberUtils.createNumber(core + "D");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'d') != createNumber(x+'D') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (!a.getClass().equals(b.getClass())) {
            return false;
        }
        return a.toString().equals(b.toString());
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + String.valueOf(n);
    }

    private static String oneCharOrFallback(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s.substring(0, 1);
    }

    private static String tailCharOrFallback(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s.substring(s.length() - 1);
    }

    private static String sanitizeSignedDigits(String s, boolean allowMinus) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        StringBuffer out = new StringBuffer();
        int i = 0;
        if (allowMinus && s.length() > 0 && s.charAt(0) == '-') {
            out.append('-');
            i = 1;
        }
        for (; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0 || "-".equals(out.toString())) {
            return "0";
        }
        return out.toString();
    }

    private static String nonEmptyDigits(String s) {
        String digits = sanitizeSignedDigits(s, false);
        if (digits.length() == 0) {
            return "0";
        }
        return digits;
    }

    private static String nonEmptyHex(String s) {
        if (s == null || s.length() == 0) {
            return "1";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                out.append(c);
            }
        }
        if (out.length() == 0) {
            return "1";
        }
        return out.toString();
    }

    private static String buildIntegralCore(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 4)) {
            case 0:
                return Integer.toString(data.consumeInt());
            case 1:
                return data.consumeBoolean() ? "1" : "-1";
            case 2:
                return data.consumeBoolean() ? "01" : "-01";
            case 3:
                return sanitizeSignedDigits(data.consumeAsciiString(20), true);
            default:
                String d = sanitizeSignedDigits(data.consumeString(20), true);
                if ("0".equals(d) && data.consumeBoolean()) {
                    return Integer.toString(data.consumeInt());
                }
                return d;
        }
    }

    private static String buildHugeIntegralCore(FuzzedDataProvider data) {
        String seed = sanitizeSignedDigits(data.consumeAsciiString(32), true);
        boolean negative = seed.startsWith("-");
        String digits = negative ? seed.substring(1) : seed;
        if (digits.length() == 0) {
            digits = "12345678901234567890";
        }
        while (digits.length() < 20) {
            digits = digits + digits;
        }
        digits = digits.substring(0, 20 + data.consumeInt(0, 12));
        if (allZeros(digits)) {
            digits = "12345678901234567890";
        }
        return negative ? "-" + digits : digits;
    }

    private static String buildDecimalCore(FuzzedDataProvider data) {
        String left = sanitizeSignedDigits(data.consumeAsciiString(16), true);
        String right = nonEmptyDigits(data.consumeAsciiString(16));
        if ("0".equals(left) && data.consumeBoolean()) {
            left = Integer.toString(data.consumeInt());
        }
        return left + "." + right;
    }

    private static String buildExponentCore(FuzzedDataProvider data) {
        String left = sanitizeSignedDigits(data.consumeAsciiString(12), true);
        String right = nonEmptyDigits(data.consumeAsciiString(12));
        String exp = sanitizeSignedDigits(data.consumeAsciiString(8), true);
        if ("0".equals(left) && data.consumeBoolean()) {
            left = Integer.toString(data.consumeInt());
        }
        if ("0".equals(exp) && data.consumeBoolean()) {
            exp = Integer.toString(data.consumeInt(-30, 30));
        }
        return left + "." + right + (data.consumeBoolean() ? "E" : "e") + exp;
    }

    private static String buildExplorationCandidate(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 6)) {
            case 0:
                return buildIntegralCore(data) + (data.consumeBoolean() ? "l" : "L");
            case 1:
                return buildHugeIntegralCore(data) + (data.consumeBoolean() ? "l" : "L");
            case 2:
                return buildDecimalCore(data) + (data.consumeBoolean() ? "f" : "F");
            case 3:
                return buildExponentCore(data) + (data.consumeBoolean() ? "d" : "D");
            case 4:
                return "0x" + nonEmptyHex(data.consumeAsciiString(16));
            case 5:
                return "-0x" + nonEmptyHex(data.consumeAsciiString(16));
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static Long safeParseLong(String s) {
        try {
            return Long.valueOf(s);
        } catch (RuntimeException e) {
            return null;
        }
    }

    private static boolean allZeros(String s) {
        if (s == null || s.length() == 0) {
            return true;
        }
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) != '0') {
                return false;
            }
        }
        return true;
    }
}
