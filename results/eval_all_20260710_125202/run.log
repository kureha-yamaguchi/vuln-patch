public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkAnchorContracts();

        Object[] array = buildArray(data);

        Class<?>[] classes;
        try {
            classes = ClassUtils.toClass(array);
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid Object[] with null elements must be accepted and preserve null positions input="
                                + Arrays.deepToString(array),
                        t);
            }
            return;
        }

        /* Contract asserted from ClassUtilsTest.testToClass_object:
         * ClassUtils.toClass(new Object[] { "Test", null, 99d }) returns
         * new Class[] { String.class, null, Double.class }.
         * Therefore, for any Object[] input, a correct implementation must:
         *   - return an array of the same length,
         *   - map each non-null element to element.getClass(),
         *   - preserve null elements as null in the output.
         * A throw-deleting or branch-skipping patch could silently return wrong
         * classes or collapse null positions; this post-condition catches that.
         */
        if (classes == null || classes.length != array.length) {
            throw new RuntimeException(
                    "metamorphic violation: toClass shape mismatch input="
                            + Arrays.deepToString(array)
                            + " output="
                            + Arrays.toString(classes));
        }
        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (classes[i] != expected) {
                throw new RuntimeException(
                        "metamorphic violation: null/class preservation input="
                                + Arrays.deepToString(array)
                                + " index="
                                + i
                                + " expected="
                                + expected
                                + " actual="
                                + classes[i]);
            }
        }

        Object[] clone = ArrayUtils.clone(array);
        try {
            Class<?>[] clonedClasses = ClassUtils.toClass(clone);
            if (!Arrays.equals(classes, clonedClasses)) {
                throw new RuntimeException(
                        "metamorphic violation: toClass(array) != toClass(clone(array)) input="
                                + Arrays.deepToString(array)
                                + " lhs="
                                + Arrays.toString(classes)
                                + " rhs="
                                + Arrays.toString(clonedClasses));
            }
        } catch (Throwable t) {
            if (isValidation(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: clone-equivalent inputs must produce equal toClass outputs input="
                                + Arrays.deepToString(array),
                        t);
            }
            return;
        }

        exerciseGetClass(data, classes);
    }
