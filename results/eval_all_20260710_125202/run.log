            if (cur instanceof RuntimeException && hasRelevantFrame(cur)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (int i = 0; i < frames.length; i++) {
            StackTraceElement f = frames[i];
            String cls = f.getClassName();
            String m = f.getMethodName();
            if ("com.google.javascript.jscomp.NameAnalyzer".equals(cls)) {
                if ("visit".equals(m)
                        || "createNameInformation".equals(m)
                        || "recordSet".equals(m)
                        || "recordPrototypeSet".equals(m)
