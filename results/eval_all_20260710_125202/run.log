package org.jfree.chart.renderer;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Color;
import java.awt.Paint;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        GrayPaintScale gps = new GrayPaintScale();

        // ANCHOR: exact inputs from the failing test. These are valid-by-construction
        // because GrayPaintScale is documented/tested to clamp out-of-range values.
        runAndAssertClamped(gps, -0.5, Color.black);
        runAndAssertClamped(gps, 1.5, Color.white);

        // Also keep the in-range checks from the same public API contract exercised by the test.
        runAndAssertClamped(gps, 0.0, Color.black);
        runAndAssertClamped(gps, 1.0, Color.white);

        // EXPLORE:
        // Root-cause property: any value outside [lowerBound, upperBound] must be clamped
        // before converting to a gray level. For the default constructor, bounds are [0.0, 1.0].
        // Generate many real out-of-range values of different magnitudes and signs.
        int cases = 1 + Math.abs(data.consumeInt(0, 8));
        for (int i = 0; i < cases; i++) {
            boolean below = data.consumeBoolean();
            int n = data.consumeInt();
            int d = data.consumeInt(1, Integer.MAX_VALUE);

            double magnitude = ((double) Math.abs(n)) / ((double) d);

            double value;
            Color expected;
            if (below) {
                value = -magnitude;
                if (!(value < 0.0)) {
                    value = -0.5;
                }
                expected = Color.black;
            } else {
                value = 1.0 + magnitude;
                if (!(value > 1.0)) {
                    value = 1.5;
                }
                expected = Color.white;
            }

            runAndAssertClamped(gps, value, expected);

            // Mandatory metamorphic check:
            // Contract visible from the failing test: "lookup values that are outside the bounds"
            // should equal the boundary colors. Therefore, for any x < 0, getPaint(x) == getPaint(0.0),
            // and for any x > 1, getPaint(x) == getPaint(1.0). A throw-deleting or wrong-clamping
            // patch would violate this even if it never throws.
            try {
                Paint lhs = gps.getPaint(value);
                Paint rhs = gps.getPaint(below ? 0.0 : 1.0);
                if (lhs instanceof Color && rhs instanceof Color) {
                    Color lc = (Color) lhs;
                    Color rc = (Color) rhs;
                    if (!lc.equals(rc)) {
                        throw new RuntimeException(
                            "metamorphic violation: clamped out-of-range value must equal boundary color input="
                                + value + " lhs=" + lc + " rhs=" + rc);
                    }
                }
            } catch (RuntimeException t) {
                if (isRootCause(t)) {
                    throw t;
                }
                return;
            }
        }
    }

    private static void runAndAssertClamped(GrayPaintScale gps, double value, Color expected) {
        try {
            Paint p = gps.getPaint(value);
            if (p instanceof Color) {
                Color c = (Color) p;
                if (!c.equals(expected)) {
                    throw new RuntimeException(
                        "metamorphic violation: clamped color mismatch input="
                            + value + " got=" + c + " expected=" + expected);
                }
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.jfree.chart.renderer.GrayPaintScale".equals(e.getClassName())
                    && "getPaint".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
