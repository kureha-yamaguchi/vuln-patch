package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runExactStandardNormalCase(0.9772498680518209d);

        double mean = finiteInRange(data.consumeInt(), -1000.0d, 1000.0d);
        double sd = positiveFiniteFromInt(data.consumeInt());
        int k = data.consumeInt(-8, 8);

        NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, sd);
        } catch (Throwable t) {
            if (!isCleanRejection(t) && isRootCause(t)) {
                throw asUncheckedRootCause(t);
            }
            return;
        }

        double x = mean + (sd * (double) k);

        double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (Throwable t) {
            if (!isCleanRejection(t) && isRootCause(t)) {
                throw asUncheckedRootCause(t);
            }
            return;
        }

        if (!(p > 0.0d && p < 1.0d) || Double.isNaN(p)) {
            return;
        }

        double inv;
        try {
            inv = dist.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw asUncheckedRootCause(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        double roundTrip;
        try {
            roundTrip = dist.cumulativeProbability(inv);
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted: inverseCumulativeProbability is the inverse of cumulativeProbability
         * on probabilities produced by the same distribution. Here p is valid by construction:
         * p = CDF(x) for a real x and strictly 0 < p < 1. A correct implementation must therefore
         * return a quantile inv whose CDF is p again, and for this oracle-built input it should
         * recover x as well. A patch that merely deletes the buggy throw or otherwise returns the
         * wrong endpoint/value without preserving inverse behavior will violate this relation.
         */
        double tolP = Math.max(1.0e-12d, Math.abs(p) * 1.0e-12d);
        if (Double.isNaN(roundTrip) || Math.abs(roundTrip - p) > tolP) {
            throw new RuntimeException(
                "metamorphic violation: CDF(ICDF(p)) == p input="
                    + "mean=" + mean
                    + " sd=" + sd
                    + " k=" + k
                    + " p=" + p
                    + " inv=" + inv
                    + " roundTrip=" + roundTrip);
        }

        double tolX = Math.max(1.0e-9d, Math.abs(x) * 1.0e-12d + sd * 1.0e-12d);
        if (Double.isNaN(inv) || Math.abs(inv - x) > tolX) {
            throw new RuntimeException(
                "metamorphic violation: ICDF(CDF(x)) == x input="
                    + "mean=" + mean
                    + " sd=" + sd
                    + " k=" + k
                    + " x=" + x
                    + " p=" + p
                    + " inv=" + inv);
        }
    }

    private static void runExactStandardNormalCase(double p) {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0d, 1.0d);
            double result = normal.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor ICDF(CDF(2)) == 2 input=p=" + p + " result=" + result);
            }
            double roundTrip = normal.cumulativeProbability(result);
            if (Math.abs(roundTrip - p) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor CDF(ICDF(p)) == p input=p=" + p + " roundTrip=" + roundTrip);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw asUncheckedRootCause(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                if (name.contains("IllegalArgument")
                    || name.contains("NumberFormat")
                    || name.contains("Invalid")
                    || name.contains("Validation")) {
                    return true;
                }
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException && hasRelevantFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                && "bracket".equals(m)) {
                return true;
            }
            if ("createIllegalArgumentException".equals(m)
                || "value".equals(m)
                || "buildMessage".equals(m)
                || "<init>".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException asUncheckedRootCause(Throwable t) {
        RuntimeException r = new RuntimeException("root cause reached", t);
        Throwable src = t;
        while (src.getCause() != null && !hasRelevantFrame(src)) {
            src = src.getCause();
        }
        if (hasRelevantFrame(src)) {
            r.setStackTrace(src.getStackTrace());
        } else {
            r.setStackTrace(t.getStackTrace());
        }
        return r;
    }

    private static double positiveFiniteFromInt(int v) {
        int n = v == Integer.MIN_VALUE ? 0 : Math.abs(v);
        return 1.0e-6d + (n % 1000000) / 1000.0d;
    }

    private static double finiteInRange(int v, double min, double max) {
        double span = max - min;
        long u = v & 0xffffffffL;
        return min + (u / (double) 0xffffffffL) * span;
    }
}
