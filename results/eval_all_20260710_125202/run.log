        String middle = sanitizeLiteral(data.consumeAsciiString(32));
        String quoted = sanitizeLiteral(data.consumeAsciiString(32));
        String suffix = sanitizeLiteral(data.consumeAsciiString(32));
        String arg = data.consumeString(32);

        if (data.consumeBoolean()) {
            quoted = "";
        }
        if (data.consumeBoolean()) {
            middle = middle + sanitizeLiteral(data.consumeAsciiString(8));
        }
        if (data.consumeBoolean()) {
            suffix = suffix + " " + sanitizeLiteral(data.consumeAsciiString(8));
        }

        String pattern = prefix + "''" + middle + " {0} '" + quoted + "' " + suffix;

        try {
            new ExtendedMessageFormat(pattern, Locale.US, EMPTY_REGISTRY).format(new Object[] { arg });
        } catch (Throwable t) {
            handleThrowable(t);
        }

        // Contract asserted:
        // ExtendedMessageFormat is a MessageFormat-compatible parser/formatter; with an empty registry
        // and no custom format elements, formatting the same valid pattern must match MessageFormat.
        // A patch that "fixes" the crash by skipping/mis-parsing quoted text would break this equality.
        String lhs;
        String rhs;
        try {
            lhs = new ExtendedMessageFormat(pattern, Locale.US, EMPTY_REGISTRY).format(new Object[] { arg });
        } catch (Throwable t) {
            return;
        }
        try {
            rhs = new MessageFormat(pattern, Locale.US).format(new Object[] { arg });
        } catch (Throwable t) {
            return;
        }
        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException(
                "metamorphic violation: ExtendedMessageFormat(empty-registry) != MessageFormat " +
                "input=" + pattern + " arg=" + String.valueOf(arg) +
                " lhs=" + String.valueOf(lhs) + " rhs=" + String.valueOf(rhs));
        }
    }

    private static String sanitizeLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer out = new StringBuffer(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\'' || c == '{' || c == '}') {
                out.append('x');
            } else {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static void handleThrowable(Throwable t) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            sneakyThrow(t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase(Locale.ROOT);
                if (lower.contains("validate") || lower.contains("invalid")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(e.getClassName())
                    && "appendQuotedString".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
