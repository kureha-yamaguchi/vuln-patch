public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        checkLeafPostConditions();
        runExplore(data);
    }

    private static void runAnchor() {
        Object attr = new BoundaryAttribute<Euclidean2D>(null, null, null);
        exerciseNoCutTree(attr, 0, true);
    }

    private static void runExplore(FuzzedDataProvider data) {
        int cases = 1 + data.consumeInt(0, 6);
        for (int i = 0; i < cases; i++) {
            int kind = data.consumeInt(0, 4);
            Object attr;
            switch (kind) {
                case 0:
                    attr = new BoundaryAttribute<Euclidean2D>(null, null, null);
                    break;
                case 1:
                    attr = data.consumeAsciiString(32);
                    break;
                case 2:
                    attr = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    attr = data.consumeBoolean() ? Double.valueOf(data.consumeInt()) : new Object();
                    break;
                default:
                    attr = data.consumeBoolean() ? Boolean.TRUE : Boolean.FALSE;
                    break;
            }
            exerciseNoCutTree(attr, data.consumeInt(0, 2), false);
        }
    }

    private static void exerciseNoCutTree(Object attr, int order, boolean isAnchor) {
        PolygonsSet set = new PolygonsSet(new BSPTree<Euclidean2D>(attr));
        try {
            if (order == 0) {
                double size = set.getSize();
                Point<Euclidean2D> bary = set.getBarycenter();
                Vector2D[][] vertices = set.getVertices();
                checkNoCutPostCondition(attr, size, bary, vertices, isAnchor);
            } else if (order == 1) {
                Vector2D[][] vertices = set.getVertices();
                double size = set.getSize();
                Point<Euclidean2D> bary = set.getBarycenter();
                checkNoCutPostCondition(attr, size, bary, vertices, isAnchor);
            } else {
                Point<Euclidean2D> bary = set.getBarycenter();
                Vector2D[][] vertices = set.getVertices();
                double size = set.getSize();
                checkNoCutPostCondition(attr, size, bary, vertices, isAnchor);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkLeafPostConditions() {
        /*
         * Contract visible in PolygonsSet.computeGeometricalProperties():
         * - if getVertices().length == 0 and tree attribute is Boolean.TRUE, the region covers the whole space:
         *   size must be +INF and barycenter must be Vector2D.NaN.
         * - if getVertices().length == 0 and tree attribute is Boolean.FALSE, the region is empty:
         *   size must be 0 and barycenter must be (0, 0).
         * A throw-deleting or bookkeeping-skipping patch breaks these observable results.
         */
        try {
            PolygonsSet empty = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.FALSE));
            Vector2D[][] emptyVertices = empty.getVertices();
            double emptySize = empty.getSize();
            Point<Euclidean2D> emptyBary = empty.getBarycenter();
            if (emptyVertices.length != 0) {
                throw new RuntimeException("metamorphic violation: empty leaf must have no vertices input=false vertices=" + emptyVertices.length);
            }
            if (Double.doubleToLongBits(emptySize) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("metamorphic violation: empty leaf size input=false size=" + emptySize);
            }
            if (!(emptyBary instanceof Vector2D)) {
                throw new RuntimeException("metamorphic violation: empty leaf barycenter type input=false bary=" + emptyBary);
            }
            Vector2D eb = (Vector2D) emptyBary;
            if (Double.doubleToLongBits(eb.getX()) != Double.doubleToLongBits(0.0d) ||
                Double.doubleToLongBits(eb.getY()) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("metamorphic violation: empty leaf barycenter input=false x=" + eb.getX() + " y=" + eb.getY());
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isMetamorphicViolation(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            PolygonsSet full = new PolygonsSet(new BSPTree<Euclidean2D>(Boolean.TRUE));
            Vector2D[][] fullVertices = full.getVertices();
            double fullSize = full.getSize();
            Point<Euclidean2D> fullBary = full.getBarycenter();
            if (fullVertices.length != 0) {
                throw new RuntimeException("metamorphic violation: full-space leaf must have no vertices input=true vertices=" + fullVertices.length);
            }
            if (!Double.isInfinite(fullSize) || fullSize < 0.0d) {
                throw new RuntimeException("metamorphic violation: full-space leaf size input=true size=" + fullSize);
            }
            if (!(fullBary instanceof Vector2D)) {
                throw new RuntimeException("metamorphic violation: full-space leaf barycenter type input=true bary=" + fullBary);
            }
            Vector2D fb = (Vector2D) fullBary;
            if (!Double.isNaN(fb.getX()) || !Double.isNaN(fb.getY())) {
                throw new RuntimeException("metamorphic violation: full-space leaf barycenter input=true x=" + fb.getX() + " y=" + fb.getY());
            }
        } catch (RuntimeException t) {
            if (isRootCause(t) || isMetamorphicViolation(t)) {
                throw t;
            }
        } catch (Error t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkNoCutPostCondition(Object attr, double size, Point<Euclidean2D> bary, Vector2D[][] vertices, boolean isAnchor) {
        if (vertices == null) {
            return;
        }
        if (vertices.length != 0) {
            throw new RuntimeException("metamorphic violation: no-cut tree must expose zero vertex loops input=" + describe(attr) + " vertices=" + vertices.length);
        }
        if (!(bary instanceof Vector2D)) {
            return;
        }
        Vector2D v = (Vector2D) bary;
        if (Boolean.TRUE.equals(attr)) {
            if (!Double.isInfinite(size) || size < 0.0d || !Double.isNaN(v.getX()) || !Double.isNaN(v.getY())) {
                throw new RuntimeException("metamorphic violation: whole-space no-cut leaf input=" + describe(attr) + " size=" + size + " x=" + v.getX() + " y=" + v.getY());
            }
        } else {
            if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0d) ||
                Double.doubleToLongBits(v.getX()) != Double.doubleToLongBits(0.0d) ||
                Double.doubleToLongBits(v.getY()) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("metamorphic violation: empty no-cut leaf input=" + describe(attr) + " size=" + size + " x=" + v.getX() + " y=" + v.getY() + " anchor=" + isAnchor);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cn = e.getClassName();
            String mn = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cn) &&
                ("computeGeometricalProperties".equals(mn) || "getVertices".equals(mn))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cn) &&
                ("getSize".equals(mn) || "getBarycenter".equals(mn))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.BSPTree".equals(cn) &&
                "visit".equals(mn)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isMetamorphicViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("metamorphic violation:");
    }

    private static String describe(Object attr) {
        if (attr == null) {
            return "null";
        }
        return attr.getClass().getName() + ":" + String.valueOf(attr);
    }
}
