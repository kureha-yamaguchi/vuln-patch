                                    + " prefix=" + prefix
                                    + " source=" + source
                                    + " width=" + width
                                    + " pad=" + (int) padChar
                                    + " objResult=" + actualObj
                                    + " nullResult=" + actualNull
                                    + " objLen=" + sbObj.length()
                                    + " nullLen=" + sbNull.length());
                }
            }
        } catch (RuntimeException t) {
            if (isOurAssertion(t) || isRootCause(t)) {
