                    throw new RuntimeException(
                        "metamorphic violation: duplicate constraint changed optimum"
                        + " baseValue=" + base.getValue()
                        + " dupValue=" + dup.getValue()
                        + " basePoint=" + pointToString(base.getPoint())
                        + " dupPoint=" + pointToString(dup.getPoint()));
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
