package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        double mean = data.consumeInt(-1000, 1000);
        int sdInt = data.consumeInt(1, 50);
        double sd = sdInt;
        int offset = data.consumeInt(-20, 20);
        if (offset == 0) {
            offset = 2;
        }

        if (data.consumeBoolean()) {
            mean += data.consumeByte() / 16.0;
        }
        if (data.consumeBoolean()) {
            sd += (Math.abs(data.consumeByte()) % 8) / 8.0;
        }

        explore(mean, sd, offset);

        int extraCases = data.consumeInt(0, 4);
        for (int i = 0; i < extraCases; i++) {
            double m = mean + data.consumeByte() / 4.0;
            double s = sd + (Math.abs(data.consumeByte()) % 5) / 10.0;
            if (!(s > 0.0) || Double.isInfinite(s) || Double.isNaN(s)) {
                continue;
            }
            int off = offset + data.consumeInt(-3, 3);
            if (off == 0) {
                off = data.consumeBoolean() ? 1 : -1;
            }
            explore(m, s, off);
        }
    }

    private static void anchor() {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);
        double p = 0.9772498680518209d;
        try {
            double x = normal.inverseCumulativeProbability(p);
            checkRoundTrip(normal, p, x, 2.0d);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw sneaky(t);
            }
        }
    }

    private static void explore(double mean, double sd, int offset) {
        NormalDistribution normal = new NormalDistributionImpl(mean, sd);
        double target = mean + offset;

        final double p;
        try {
            p = normal.cumulativeProbability(target);
        } catch (Throwable t) {
            return;
        }

        if (!(p > 0.0 && p < 1.0) || Double.isNaN(p)) {
            return;
        }

        final double x;
        try {
            x = normal.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw sneaky(t);
            }
            return;
        }

        try {
            checkRoundTrip(normal, p, x, target);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            throw sneaky(t);
        }
    }

    private static void checkRoundTrip(NormalDistribution normal, double p, double x, double target) throws MathException {
        /*
         * Contract asserted: inverseCumulativeProbability is the inverse of cumulativeProbability
         * on valid probabilities. Since p is constructed by the real library as
         * p = cumulativeProbability(target), a correct implementation must recover target (up to
         * numerical tolerance), and cumulativeProbability(inverseCumulativeProbability(p)) must
         * return p. A patch that merely deletes the ConvergenceException path or returns an
         * arbitrary bracket endpoint would violate this observable inverse relation without throwing.
         */
        double p2 = normal.cumulativeProbability(x);
        if (Double.isNaN(p2) || Math.abs(p2 - p) > 1.0e-12) {
            throw new RuntimeException(
                "metamorphic violation: cdf(inv(p))~=p input=p=" + p + " x=" + x + " mean=" +
                normal.getMean() + " sd=" + normal.getStandardDeviation() + " lhs=" + p2 + " rhs=" + p);
        }

        double tol = 1.0e-9 * Math.max(1.0, Math.abs(target));
        if (Double.isNaN(x) || Math.abs(x - target) > tol) {
            throw new RuntimeException(
                "metamorphic violation: inv(cdf(target))~=target input=target=" + target + " p=" + p +
                " mean=" + normal.getMean() + " sd=" + normal.getStandardDeviation() +
                " lhs=" + x + " rhs=" + target);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof IllegalArgumentException || c instanceof NumberFormatException) {
                return true;
            }
            if (c.getClass().getName().startsWith("org.apache.commons.math")) {
                for (StackTraceElement ste : c.getStackTrace()) {
                    if ("createIllegalArgumentException".equals(ste.getMethodName())) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable c = t; c != null; c = c.getCause()) {
            if (c instanceof MathException && hasRelevantFrame(c)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("createIllegalArgumentException".equals(method)
                    || "value".equals(method)
                    || "buildMessage".equals(method)
                    || "<init>".equals(method)) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> RuntimeException sneaky(Throwable t) throws T {
        throw (T) t;
    }
}
