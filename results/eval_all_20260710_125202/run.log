            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor copy is null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException("metamorphic violation: anchor gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (RuntimeException e) {
            if (isValidationFamily(e) && isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: anchor valid gap range was rejected", e);
            }
            if (!isValidationFamily(e)) {
                throw e;
            }
