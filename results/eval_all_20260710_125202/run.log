        String anchorResult = StringUtils.join(anchor, '/', 0, 1);

        /* Contract asserted:
         * join(Object[], char, int, int) and join(Object[], String, int, int) perform the same join
         * for equivalent one-character separators over the same slice. A patch that only suppresses
         * the crash but skips or changes the element text would violate this observable relation.
         */
        String anchorResultStringSep = StringUtils.join(anchor, "/", 0, 1);
        if (!anchorResult.equals(anchorResultStringSep)) {
            throw new RuntimeException(
                "metamorphic violation: anchor char-vs-string separator lhs=" + anchorResult + " rhs=" + anchorResultStringSep);
        }
        if (StringUtils.length(anchorResult) != 4) {
            throw new RuntimeException(
                "metamorphic violation: anchor null-toString element must render as \"null\" result=" + anchorResult);
        }

        int len = data.consumeInt(1, 8);
        int startIndex = data.consumeInt(0, len - 1);
