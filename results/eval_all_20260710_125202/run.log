private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), new Integer(1));
        s.add(new Day(31, 1, 2006), new Integer(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor copy is null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException("metamorphic violation: anchor gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (RuntimeException e) {
            if (isValidationFamily(e) && isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: anchor valid gap range was rejected", e);
            }
            if (!isValidationFamily(e)) {
                throw e;
            }
        }

        Day before = new Day(18, 8, 2005);
        try {
            s.getIndex(before);
            TimeSeries empty = s.createCopy(before, before);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor clone-path copy is null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
            }
        } catch (RuntimeException e) {
            if (isValidationFamily(e) && isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: anchor before-first valid range was rejected", e);
            }
            if (!isValidationFamily(e)) {
                throw e;
            }
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalent(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (RuntimeException e) {
            if (isValidationFamily(e) && isRootCause(e)) {
                throw new RuntimeException("metamorphic violation: anchor existing-period copy was rejected", e);
            }
            if (!isValidationFamily(e)) {
                throw e;
            }
        }
    }
