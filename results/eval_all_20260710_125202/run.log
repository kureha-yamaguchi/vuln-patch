            }
            if (sawCompilerRunCallable && sawReachableRegion) {
                return true;
            }
        }
        return false;
    }

    private static String ident(String raw, String fallbackPrefix) {
        if (raw == null || raw.length() == 0) {
            return fallbackPrefix;
        }
        StringBuilder sb = new StringBuilder();
        char first = raw.charAt(0);
        if (isIdentStart(first)) {
