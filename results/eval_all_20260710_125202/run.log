        Graphics2D g2 = image.createGraphics();
        try {
            anchor(g2);
            explore(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void anchor(Graphics2D g2) {
        RectangleConstraint widthOnly = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer fromTest = new BlockContainer(new BorderArrangement());
        try {
            fromTest.add(new EmptyBlock(5.0, 6.0));
            fromTest.arrange(g2, widthOnly);
        } catch (Throwable t) {
            if (isCleanRejection(t) || !isInPatchedRegion(t)) {
                return;
            }
        }

        fromTest.clear();
        try {
            fromTest.add(new EmptyBlock(15.0, 16.0));
            fromTest.arrange(g2, widthOnly);
        } catch (Throwable t) {
            if (isCleanRejection(t) || !isInPatchedRegion(t)) {
                return;
            }
        }

        fromTest.clear();
        try {
            fromTest.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
            fromTest.arrange(g2, widthOnly);
        } catch (Throwable t) {
            if (isCleanRejection(t) || !isInPatchedRegion(t)) {
                return;
            }
        }

        RectangleConstraint fixedFixed = new RectangleConstraint(10.0, 10.0);
        BlockContainer crashShape = new BlockContainer(new BorderArrangement());
        crashShape.add(new EmptyBlock(12.3, 12.3), RectangleEdge.TOP);
        crashShape.add(new EmptyBlock(1.0, 1.0), RectangleEdge.BOTTOM);
        crashShape.add(new EmptyBlock(2.0, 2.0), RectangleEdge.LEFT);

        try {
            crashShape.arrange(g2, fixedFixed);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                return;
            }
            if (isCleanRejection(t) || !isInPatchedRegion(t)) {
                return;
            }
        }

        // Contract asserted below in explore():
        // In arrangeFF(), if leftBlock != null then leftBlock.setBounds(...) must run.
        // Adding a zero-height top block must not change the left block's bounds,
        // because h[0] remains 0. A patch that merely deletes/changes bookkeeping
        // (like nulling leftBlock) breaks this observable post-condition.
    }

    private static void explore(FuzzedDataProvider data, Graphics2D g2) {
        int iterations = 1 + Math.max(0, Math.min(8, data.remainingBytes()));
        for (int i = 0; i < iterations; i++) {
            double containerWidth = positive(data.consumeInt(1, 50));
            double containerHeight = positive(data.consumeInt(1, 50));

            double leftW = positive(data.consumeInt(1, 50));
            double leftH = positive(data.consumeInt(1, 50));

            double centerW = positive(data.consumeInt(1, 50));
            double centerH = positive(data.consumeInt(1, 50));

            boolean addRight = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();

            double rightW = positive(data.consumeInt(1, 50));
            double rightH = positive(data.consumeInt(1, 50));
            double bottomW = positive(data.consumeInt(1, 50));
            double bottomH = positive(data.consumeInt(1, 50));

            EmptyBlock leftA = new EmptyBlock(leftW, leftH);
            EmptyBlock centerA = new EmptyBlock(centerW, centerH);
            EmptyBlock rightA = addRight ? new EmptyBlock(rightW, rightH) : null;
            EmptyBlock bottomA = addBottom ? new EmptyBlock(bottomW, bottomH) : null;

            BlockContainer base = new BlockContainer(new BorderArrangement());
            base.add(centerA);
            base.add(leftA, RectangleEdge.LEFT);
            if (rightA != null) {
                base.add(rightA, RectangleEdge.RIGHT);
            }
            if (bottomA != null) {
                base.add(bottomA, RectangleEdge.BOTTOM);
            }

            EmptyBlock leftB = new EmptyBlock(leftW, leftH);
            EmptyBlock centerB = new EmptyBlock(centerW, centerH);
            EmptyBlock rightB = addRight ? new EmptyBlock(rightW, rightH) : null;
            EmptyBlock bottomB = addBottom ? new EmptyBlock(bottomW, bottomH) : null;
            EmptyBlock zeroTop = new EmptyBlock(positive(data.consumeInt(1, 50)), 0.0);

            BlockContainer withZeroTop = new BlockContainer(new BorderArrangement());
            withZeroTop.add(centerB);
            withZeroTop.add(leftB, RectangleEdge.LEFT);
            if (rightB != null) {
                withZeroTop.add(rightB, RectangleEdge.RIGHT);
            }
            if (bottomB != null) {
                withZeroTop.add(bottomB, RectangleEdge.BOTTOM);
            }
            withZeroTop.add(zeroTop, RectangleEdge.TOP);

            // Exercise getBlocks() and getWidth() through real objects.
            List blocksA = base.getBlocks();
            List blocksB = withZeroTop.getBlocks();
            if (blocksA == null || blocksB == null) {
                continue;
            }
            double observedLeftWidth = leftA.getWidth() + leftB.getWidth();
            if (observedLeftWidth < 0.0) {
                continue;
            }

            RectangleConstraint fixedFixed = new RectangleConstraint(containerWidth, containerHeight);

            Size2D sizeA;
            Size2D sizeB;
            try {
                sizeA = base.arrange(g2, fixedFixed);
                sizeB = withZeroTop.arrange(g2, fixedFixed);
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    return;
                }
                return;
            }

            Rectangle2D leftBoundsA;
            Rectangle2D leftBoundsB;
            Rectangle2D centerBoundsA;
            Rectangle2D centerBoundsB;
            try {
                leftBoundsA = leftA.getBounds();
                leftBoundsB = leftB.getBounds();
                centerBoundsA = centerA.getBounds();
                centerBoundsB = centerB.getBounds();
            } catch (Throwable t) {
                return;
            }

            if (leftBoundsA == null || leftBoundsB == null || centerBoundsA == null || centerBoundsB == null) {
                return;
            }

            if (!sameRect(leftBoundsA, leftBoundsB) || !sameRect(centerBoundsA, centerBoundsB) || !sameSize(sizeA, sizeB)) {
                throw new RuntimeException(
                        "metamorphic violation: adding a zero-height top block changed fixed/fixed layout"
                                + " width=" + containerWidth
                                + " height=" + containerHeight
                                + " baseLeft=" + rectToString(leftBoundsA)
                                + " zeroTopLeft=" + rectToString(leftBoundsB)
                                + " baseCenter=" + rectToString(centerBoundsA)
                                + " zeroTopCenter=" + rectToString(centerBoundsB)
                                + " baseSize=" + sizeToString(sizeA)
                                + " zeroTopSize=" + sizeToString(sizeB)
                                + " baseBlocks=" + blocksA.size()
                                + " zeroTopBlocks=" + blocksB.size());
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        return (t instanceof IllegalArgumentException) && isInPatchedRegion(t);
    }

    private static boolean isInPatchedRegion(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.jfree.chart.block.BorderArrangement".equals(cls)) {
                if ("arrangeFF".equals(method) || "arrangeFN".equals(method) || "arrange".equals(method)) {
                    return true;
                }
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "arrange".equals(method)) {
                return true;
            }
            if ("org.jfree.data.Range".equals(cls) && "<init>".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.block.AbstractBlock".equals(cls)
                    && ("getWidth".equals(method) || "setBounds".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException;
    }

    private static double positive(int v) {
        return (double) Math.max(1, v);
    }

    private static boolean sameSize(Size2D a, Size2D b) {
        return close(a.getWidth(), b.getWidth()) && close(a.getHeight(), b.getHeight());
    }

    private static boolean sameRect(Rectangle2D a, Rectangle2D b) {
        return close(a.getX(), b.getX())
                && close(a.getY(), b.getY())
                && close(a.getWidth(), b.getWidth())
                && close(a.getHeight(), b.getHeight());
    }

    private static boolean close(double a, double b) {
        return Math.abs(a - b) <= 0.0000001;
    }

    private static String rectToString(Rectangle2D r) {
        return "[" + r.getX() + "," + r.getY() + "," + r.getWidth() + "," + r.getHeight() + "]";
    }

    private static String sizeToString(Size2D s) {
        return "[" + s.getWidth() + "," + s.getHeight() + "]";
    }
}
