        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        Number anchor = NumberUtils.createNumber(\"1234.5\");\n        if (anchor == null || anchor.doubleValue() != 1234.5d) {\n            throw new RuntimeException(\"anchor parse failed\");\n        }\n\n        requireValidUppercaseHex(\"0Xfade\");\n        requireValidUppercaseHex(\"-0Xfade\");\n\n        String[] regressionLiterals = new String[] {\n            \"12345\",\n            \"1234.5D\",\n            \"1234.5d\",\n            \"1234.5F\",\n            \"1234.5f\",\n            \"12345L\",\n            \"12345l\",\n            \"-1234.5\",\n            \"-12345\",\n            \"0xFADE\",\n            \"-0xFADE\",\n            \"1.1E200\",\n            \"1.1E20\",\n            \"-1.1E200\",\n            \"1.1E-200\",\n            \"12345678901234567890L\",\n            \"1.1E-700F\",\n            \"2.\",\n            \"-1l\",\n            \"01l\",\n            \"1l\",\n            \"1eE\"\n        };\n        for (int i = 0; i < regressionLiterals.length; i++) {\n            try {\n                NumberUtils.createNumber(regressionLiterals[i]);\n            } catch (NumberFormatException ignored) {\n            }\n        }\n\n        try {\n            NumberUtils.createNumber(data.consumeString(64));\n        } catch (NumberFormatException ignored) {\n        }\n\n        String upperHex = buildUppercaseHexLiteral(data);\n        String lowerHex = upperHex.startsWith(\"-0X\")\n                ? \"-0x\" + upperHex.substring(3)\n                : \"0x\" + upperHex.substring(2);\n\n        Integer expectedUpper;\n        Integer expectedLower;\n        try {\n            expectedUpper = NumberUtils.createInteger(upperHex);\n            expectedLower = NumberUtils.createInteger(lowerHex);\n        } catch (NumberFormatException ignored) {\n            try {\n                NumberUtils.createNumber(upperHex);\n            } catch (NumberFormatException ignoredToo) {\n            }\n            try {\n                NumberUtils.createNumber(lowerHex);\n            } catch (NumberFormatException ignoredToo) {\n            }\n            try {\n                NumberUtils.createNumber(data.consumeRemainingAsString());\n            } catch (NumberFormatException ignoredToo) {\n            }\n            return;\n        }\n\n        if (!expectedUpper.equals(expectedLower)) {\n            throw new RuntimeException(\"metamorphic violation: createInteger x/X equivalence\");\n        }\n\n        Number actualUpper;\n        try {\n            actualUpper = NumberUtils.createNumber(upperHex);\n        } catch (NumberFormatException e) {\n            throw new RuntimeException(\"createNumber rejected valid uppercase hex input: \" + upperHex, e);\n        }\n\n        if (actualUpper == null || actualUpper.intValue() != expectedUpper.intValue()) {\n            throw new RuntimeException(\"createNumber disagrees with createInteger for uppercase hex: \" + upperHex);\n        }\n\n        Number actualLower;\n        try {\n            actualLower = NumberUtils.createNumber(lowerHex);\n        } catch (NumberFormatException ignored) {\n            actualLower = null;\n        }\n\n        if (actualLower != null && !actualUpper.equals(actualLower)) {\n            throw new RuntimeException(\"metamorphic violation: 0X and 0x forms must be equivalent\");\n        }\n\n        String decimalLiteral = Integer.toString(data.consumeInt());\n        try {\n            NumberUtils.createNumber(decimalLiteral);\n        } catch (NumberFormatException ignored) {\n        }\n\n        long longValue = (((long) data.consumeInt()) << 32) ^ (data.consumeInt() & 0xffffffffL);\n        String longLiteral = Long.toString(longValue) + (data.consumeBoolean() ? \"L\" : \"l\");\n        try {\n            NumberUtils.createNumber(longLiteral);\n        } catch (NumberFormatException ignored) {\n        }\n\n        String scientificLiteral = buildScientificLiteral(data);\n        try {\n            NumberUtils.createNumber(scientificLiteral);\n        } catch (NumberFormatException ignored) {\n        }\n\n        String fixedPointLiteral = buildFixedPointLiteral(data);\n        try {\n            NumberUtils.createNumber(fixedPointLiteral);\n        } catch (NumberFormatException ignored) {\n        }\n\n        try {\n            NumberUtils.createNumber(data.consumeRemainingAsString());\n        } catch (NumberFormatException ignored) {\n        }\n    }",
