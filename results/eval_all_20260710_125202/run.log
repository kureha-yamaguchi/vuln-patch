        // bracketing intervals for SinFunction so a correct implementation is obliged
        // to solve them instead of rejecting them.
        int cases = 1 + Math.abs(data.consumeInt(0, 8));
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-1000, 1000);
            double root = k * Math.PI;

            int widthMillis = data.consumeInt(1, 1000);
            double width = widthMillis / 1000.0; // (0, 1], safely below pi/2

            double left = root - width;
            double right = root + width;
            if (left > right) {
                double t = left;
                left = right;
                right = t;
            }

            double initial;
            if (data.consumeBoolean()) {
                initial = root;
            } else {
                int pos = data.consumeInt(0, 1000);
                initial = left + (right - left) * (pos / 1000.0);
            }

            runValidCase(sin, left, right, initial);
