package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final class LowerFormat extends java.text.Format {
        public StringBuffer format(Object obj, StringBuffer toAppendTo, java.text.FieldPosition pos) {
            if (obj != null) {
                toAppendTo.append(obj.toString().toLowerCase(java.util.Locale.ROOT));
            }
            return toAppendTo;
        }

        public Object parseObject(String source, java.text.ParsePosition pos) {
            pos.setIndex(source == null ? 0 : source.length());
            return source;
        }
    }

    private static final class LowerFactory implements FormatFactory {
        public java.text.Format getFormat(String name, String arguments, java.util.Locale locale) {
            return new LowerFormat();
        }
    }

    private static final java.util.Map REGISTRY = new java.util.HashMap();

    static {
        REGISTRY.put("lower", new LowerFactory());
    }

    private static String sanitizeLiteral(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != '{' && c != '}') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String escapeQuotesOnly(String s) {
        StringBuilder sb = new StringBuilder(s.length() * 2 + 2);
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '\'') {
                sb.append("''");
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchorPattern = "it''s a {0,lower} 'test'!";
        ExtendedMessageFormat anchor = new ExtendedMessageFormat(anchorPattern, REGISTRY);
        String anchorOut = anchor.format(new Object[] { "DUMMY" });
        if (!"it's a dummy test!".equals(anchorOut)) {
            throw new RuntimeException("metamorphic violation: anchor output pattern=" + anchorPattern + " out=" + anchorOut);
        }

        String prefix = sanitizeLiteral(data.consumeAsciiString(32));
        String middle = sanitizeLiteral(data.consumeAsciiString(32));
        String suffix = sanitizeLiteral(data.consumeAsciiString(32));
        String arg = data.consumeString(32);

        if (data.consumeBoolean()) {
            prefix = prefix + "'";
        } else {
            prefix = prefix + "''";
        }
        if (data.consumeBoolean()) {
            middle = "'" + middle;
        } else {
            middle = "''" + middle;
        }
        if (data.consumeBoolean()) {
            suffix = suffix + "'";
        } else {
            suffix = suffix + "''";
        }

        String pattern = escapeQuotesOnly(prefix) + "{0}" + escapeQuotesOnly(middle) + "{0}" + escapeQuotesOnly(suffix);
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern);
        String out = emf.format(new Object[] { arg });

        String expected = prefix + String.valueOf(arg) + middle + String.valueOf(arg) + suffix;
        /*
         * Contract asserted: in MessageFormat patterns, doubled single quotes represent a literal single quote.
         * We build the pattern from literal text with quotes escaped only by doubling, plus two {0} insertions.
         * A correct implementation must therefore reproduce the original literal text around the two inserted arguments.
         */
        if (!expected.equals(out)) {
            throw new RuntimeException("metamorphic violation: doubled-quote literal preservation pattern=" + pattern + " expected=" + expected + " actual=" + out);
        }
    }
}
