package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String s : anchors) {
            tryEscapeCsv(s);
        }

        String fuzzed = buildSafeCsvUnchangedInput(data);
        tryEscapeCsv(fuzzed);

        // Contract asserted: CSV escaping only quotes/wraps values containing CSV special characters
        // (comma, quote, CR, LF). Therefore, for inputs we construct to contain none of those characters,
        // escapeCsv(input) must return the original input unchanged. A "fix" that merely suppresses the
        // crashing bookkeeping or skips characters would violate this observable post-condition.
        try {
            String out = StringEscapeUtils.escapeCsv(fuzzed);
            if (!fuzzed.equals(out)) {
                throw new RuntimeException(
                    "metamorphic violation: escapeCsv should be identity on CSV-safe input input="
                        + printable(fuzzed) + " lhs=" + printable(out) + " rhs=" + printable(fuzzed));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String left = buildSafeCsvUnchangedInput(data);
        String right = buildSafeCsvUnchangedInput(data);
        String concat = left + right;

        // Contract asserted: on inputs with no CSV special characters, escapeCsv is the identity function.
        // Hence composition must hold: escapeCsv(a + b) == escapeCsv(a) + escapeCsv(b) == a + b.
        // If either side throws, the relation does not apply and we skip it.
        try {
            String whole = StringEscapeUtils.escapeCsv(concat);
            String parts = StringEscapeUtils.escapeCsv(left) + StringEscapeUtils.escapeCsv(right);
            if (!whole.equals(parts)) {
                throw new RuntimeException(
                    "metamorphic violation: composition on CSV-safe inputs input="
                        + printable(concat) + " lhs=" + printable(whole) + " rhs=" + printable(parts));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void tryEscapeCsv(String s) {
        try {
            StringEscapeUtils.escapeCsv(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName().toLowerCase();
            if (name.contains("invalid") || name.contains("validation")) {
                return true;
            }
        }
        return false;
    }

    private static String buildSafeCsvUnchangedInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 4);
        switch (mode) {
            case 0:
                return "";
            case 1:
                return sanitizeCsvSafe(data.consumeString(32), data.consumeBoolean());
            case 2:
                return sanitizeCsvSafe(data.consumeAsciiString(32), data.consumeBoolean());
            case 3:
                return sanitizeCsvSafe(data.consumeRemainingAsString(), data.consumeBoolean());
            default:
                StringBuilder sb = new StringBuilder();
                int pieces = data.consumeInt(1, 8);
                for (int i = 0; i < pieces; i++) {
                    if (data.consumeBoolean()) {
                        sb.append(surrogatePairFrom(data.consumeInt(0, 0x3FF), data.consumeInt(0, 0x3FF)));
                    } else {
                        sb.append(sanitizeChar(data.consumeInt()));
                    }
                }
                return sb.toString();
        }
    }

    private static String sanitizeCsvSafe(String in, boolean forceSurrogatePair) {
        StringBuilder sb = new StringBuilder();
        if (in != null) {
            for (int i = 0; i < in.length(); i++) {
                char c = in.charAt(i);
                if (Character.isHighSurrogate(c) || Character.isLowSurrogate(c)) {
                    continue;
                }
                sb.append(sanitizeChar(c));
            }
        }
        if (forceSurrogatePair || sb.length() == 0) {
            int hi = (sb.length() * 37) & 0x3FF;
            int lo = (sb.length() * 53) & 0x3FF;
            int insert = sb.length() == 0 ? 0 : Math.min(sb.length(), Math.abs(sb.length() / 2));
            sb.insert(insert, surrogatePairFrom(hi, lo));
        }
        return sb.toString();
    }

    private static char sanitizeChar(int value) {
        char c = (char) value;
        if (c == ',' || c == '"' || c == '\r' || c == '\n') {
            return 'A';
        }
        if (Character.isHighSurrogate(c) || Character.isLowSurrogate(c)) {
            return 'B';
        }
        return c;
    }

    private static String surrogatePairFrom(int hiBits, int loBits) {
        char hi = (char) (0xD800 + (hiBits & 0x3FF));
        char lo = (char) (0xDC00 + (loBits & 0x3FF));
        return new String(new char[] { hi, lo });
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        String hex = Integer.toHexString(c);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
