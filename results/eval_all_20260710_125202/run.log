public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];

        int first = data.consumeInt(0, Math.max(0, maxOrd - (count + 3)));
        int initialGapMax = Math.min(64, maxOrd - first - (count - 2));
        if (initialGapMax < 2) {
            return;
        }
        int initialGap = data.consumeInt(2, initialGapMax);
        ords[0] = first;
        ords[1] = first + initialGap;

        int current = ords[1];
        for (int i = 2; i < count; i++) {
            int remainingAfter = count - 1 - i;
            int maxStep = maxOrd - current - remainingAfter;
            if (maxStep < 1) {
                return;
            }
            int step = data.consumeInt(1, Math.min(64, maxStep));
            current += step;
            ords[i] = current;
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < ords.length; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), data.consumeInt());
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int gapIndex = findGap(ords);
        if (gapIndex == -1) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);
        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            series.getIndex(start);
            series.getIndex(end);
            TimeSeries gapCopy = series.createCopy(start, end);

            if (gapCopy == null) {
                throw new RuntimeException("metamorphic violation: null copy for gap range startOrd=" + startOrd + " endOrd=" + endOrd);
            }

            /*
             * Contract/invariant used: createCopy(start, end) should return a series
             * containing the items in the source series whose periods lie in [start, end].
             * For a range wholly inside a gap between consecutive items, there are no such
             * items, so the result must be empty. A patch that merely suppresses the throw
             * but returns the wrong slice violates this observable post-condition.
             */
            if (gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: copy wholly inside a gap must be empty"
                    + " leftOrd=" + left
                    + " rightOrd=" + right
                    + " startOrd=" + startOrd
                    + " endOrd=" + endOrd
                    + " itemCount=" + gapCopy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            throw e;
        }

        if (right - left >= 3) {
            int startOrd2 = data.consumeInt(left + 1, right - 1);
            int endOrd2 = data.consumeInt(startOrd2, right - 1);
            Day start2 = dayFromOrdinal(startOrd2);
            Day end2 = dayFromOrdinal(endOrd2);

            try {
                TimeSeries copyA = series.createCopy(start, end);
                TimeSeries copyB = series.createCopy(start2, end2);

                /*
                 * Contract/invariant used: any two ranges wholly contained in the same empty
                 * gap select exactly the same set of source items: none. Therefore both copies
                 * must be observably equivalent (in particular, both empty).
                 */
                if (copyA.getItemCount() != copyB.getItemCount()) {
                    throw new RuntimeException(
                        "metamorphic violation: same-gap ranges disagree on itemCount"
                        + " range1=[" + startOrd + "," + endOrd + "]"
                        + " range2=[" + startOrd2 + "," + endOrd2 + "]"
                        + " count1=" + copyA.getItemCount()
                        + " count2=" + copyB.getItemCount());
                }
                if (copyA.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: same-gap ranges should both be empty"
                        + " range1=[" + startOrd + "," + endOrd + "]"
                        + " range2=[" + startOrd2 + "," + endOrd2 + "]"
                        + " count=" + copyA.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        int beforeFirstOrd = ords[0] - 1;
        if (beforeFirstOrd >= 0) {
            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);
            try {
                series.getIndex(beforeFirst);
                TimeSeries emptyBeforeFirst = series.createCopy(beforeFirst, beforeFirst);
                if (emptyBeforeFirst == null) {
                    throw new RuntimeException("metamorphic violation: null copy before first item");
                }
                if (emptyBeforeFirst.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: copy before first item must be empty"
                        + " beforeFirstOrd=" + beforeFirstOrd
                        + " itemCount=" + emptyBeforeFirst.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);

            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);

            /*
             * Contract/invariant used: when start and end are existing periods from indices
             * i..j, createCopy(startPeriod, endPeriod) should select exactly the same items
             * as createCopy(i, j). This checks that a "fix" did not break normal copies.
             */
            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                throw new RuntimeException(
                    "metamorphic violation: existing-period copy != index copy itemCount"
                    + " i=" + i
                    + " j=" + j
                    + " byPeriod=" + byPeriod.getItemCount()
                    + " byIndex=" + byIndex.getItemCount());
            }
            for (int k = 0; k < byPeriod.getItemCount(); k++) {
                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {
                    throw new RuntimeException(
                        "metamorphic violation: existing-period copy != index copy periods"
                        + " i=" + i
                        + " j=" + j
                        + " k=" + k
                        + " lhs=" + byPeriod.getTimePeriod(k)
                        + " rhs=" + byIndex.getTimePeriod(k));
                }
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }
