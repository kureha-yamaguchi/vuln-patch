    /*
     * Additional real-code coverage of getVertices -> getX/getY path on valid inputs.
     * Oracle from the input itself: a rectangle constructor defines a closed finite polygon,
     * so area must be width*height and barycenter must be the midpoint.
     * If either call throws, this check does not apply and we skip it.
     */
    private static void runClosedPolygonCheck(FuzzedDataProvider data) {
        double x1 = boundedDouble(data.consumeInt(), 1000.0);
        double x2 = boundedDouble(data.consumeInt(), 1000.0);
        double y1 = boundedDouble(data.consumeInt(), 1000.0);
        double y2 = boundedDouble(data.consumeInt(), 1000.0);

        double minX = Math.min(x1, x2);
        double maxX = Math.max(x1, x2);
        double minY = Math.min(y1, y2);
        double maxY = Math.max(y1, y2);

        if (minX == maxX) {
            maxX = minX + 1.0;
        }
        if (minY == maxY) {
            maxY = minY + 1.0;
        }

        PolygonsSet rect = new PolygonsSet(minX, maxX, minY, maxY);
        try {
            double area = rect.getSize();
            Vector2D barycenter = (Vector2D) rect.getBarycenter();
            double expectedArea = (maxX - minX) * (maxY - minY);
            double expectedX = 0.5 * (minX + maxX);
            double expectedY = 0.5 * (minY + maxY);

            if (!approximatelyEqual(area, expectedArea) ||
                !approximatelyEqual(barycenter.getX(), expectedX) ||
                !approximatelyEqual(barycenter.getY(), expectedY)) {
                throw new RuntimeException(
                    "metamorphic violation: rectangle geometry mismatch " +
                    "bounds=[" + minX + "," + maxX + "," + minY + "," + maxY + "]" +
                    " area=" + area +
                    " expectedArea=" + expectedArea +
                    " barycenter=(" + barycenter.getX() + "," + barycenter.getY() + ")" +
                    " expected=(" + expectedX + "," + expectedY + ")"
                );
            }
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
        }
    }

    private static Object makeNonBooleanAttribute(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                return new BoundaryAttribute<Euclidean2D>(null, null);
            case 1:
                return Integer.valueOf(data.consumeInt());
            case 2:
                return data.consumeAsciiString(32);
            case 3:
                return new Vector2D(boundedDouble(data.consumeInt(), 1000.0), boundedDouble(data.consumeInt(), 1000.0));
            case 4:
                return Double.valueOf(boundedDouble(data.consumeInt(), 1000.0));
            default:
                return new Object();
        }
    }

    private static boolean isRootCauseClassCast(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cls) &&
                ("computeGeometricalProperties".equals(method) ||
                 "getVertices".equals(method) ||
                 "getTree".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.startsWith("org.apache.commons.math3.exception.")) {
                return true;
            }
        }
        return false;
    }

    private static double boundedDouble(int v, double scale) {
        return v / scale;
    }

    private static boolean approximatelyEqual(double a, double b) {
        double diff = Math.abs(a - b);
        double tol = 1e-9 * Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= tol;
    }
}
