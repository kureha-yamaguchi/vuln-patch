import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1, "", "foo", 1, '-');

        int capacity = data.consumeInt(0, 64);
        String prefix = data.consumeString(32);
        String obj = data.consumeString(64);
        int width = data.consumeInt(1, 64);
        char pad = (char) (data.consumeByte() & 0xff);

        runCase(capacity, prefix, obj, width, pad);

        String obj2 = data.consumeAsciiString(128);
        int width2 = data.consumeInt(1, 128);
        int prefixLen = data.consumeInt(0, 32);
        char fill = data.consumeBoolean() ? 'A' : ' ';
        String prefix2 = repeat(fill, prefixLen);

        int minCapacityToAppendPrefix = prefix2.length();
        int maxInterestingCapacity = Math.max(minCapacityToAppendPrefix, prefix2.length() + width2);
        int capacity2 = minCapacityToAppendPrefix;
        if (maxInterestingCapacity >= minCapacityToAppendPrefix) {
            capacity2 = data.consumeInt(minCapacityToAppendPrefix, maxInterestingCapacity);
        }

        runCase(capacity2, prefix2, obj2, width2, pad);

        String obj3 = data.consumeRemainingAsString();
        int width3 = 1 + Math.abs(data.consumeInt() % 64);
        int prefixLen3 = Math.abs(data.consumeInt() % 16);
        String prefix3 = repeat('x', prefixLen3);
        int capacity3 = prefix3.length() + Math.max(0, width3 - 1);
        runCase(capacity3, prefix3, obj3, width3, pad);
    }

    private static void runCase(int capacity, String prefix, String obj, int width, char padChar) {
        if (width <= 0) {
            return;
        }
        if (capacity < 0) {
            capacity = 0;
        }
        if (prefix == null || obj == null) {
            return;
        }

        StrBuilder sb;
        try {
            sb = new StrBuilder(capacity);
            sb.append(prefix);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        String before = sb.toString();
        int beforeLen = sb.length();

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (IllegalArgumentException t) {
            return;
        } catch (NumberFormatException t) {
            return;
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        /* Contract asserted: appendFixedWidthPadRight appends exactly width characters:
           either the leftmost width chars of the string, or the whole string followed by pad chars.
           A "fix" that merely avoids the crashing copy, skips the append, or appends the wrong span
           would violate this observable result even when no exception is thrown. */
        String expectedAppended = expectedFixedWidthPadRight(obj, width, padChar);
        String actual = sb.toString();
        String expected = before + expectedAppended;
        if (!expected.equals(actual) || sb.length() != beforeLen + width) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight contract"
                    + " capacity=" + capacity
                    + " prefix=" + printable(prefix)
                    + " obj=" + printable(obj)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " expected=" + printable(expected)
                    + " actual=" + printable(actual)
                    + " expectedLen=" + (beforeLen + width)
                    + " actualLen=" + sb.length()
            );
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())
                    && "appendFixedWidthPadRight".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String expectedFixedWidthPadRight(String obj, int width, char padChar) {
        if (obj.length() >= width) {
            return obj.substring(0, width);
        }
        return obj + repeat(padChar, width - obj.length());
    }

    private static String repeat(char c, int count) {
        if (count <= 0) {
            return "";
        }
        StringBuilder b = new StringBuilder(count);
        for (int i = 0; i < count; i++) {
            b.append(c);
        }
        return b.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r");
    }
