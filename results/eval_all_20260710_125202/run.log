package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        exerciseValidCase(f, 3.0, 3.2, 3.1);

        int cases = 1 + Math.min(8, Math.max(0, data.remainingBytes()));
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-1000, 1000);
            double root = k * Math.PI;

            double left = scaledPositive(data.consumeInt(1, 1_000_000));
            double right = scaledPositive(data.consumeInt(1, 1_000_000));

            double min = root - left;
            double max = root + right;

            if (data.consumeBoolean()) {
                min = root;
            }
            if (data.consumeBoolean()) {
                max = root;
            }
            if (min > max) {
                double tmp = min;
                min = max;
                max = tmp;
            }

            double initial;
            if (data.consumeBoolean()) {
                initial = min;
            } else if (data.consumeBoolean()) {
                initial = max;
            } else {
                int parts = data.consumeInt(0, 1_000_000);
                initial = min + (max - min) * (parts / 1_000_000.0);
            }

            exerciseValidCase(f, min, max, initial);
        }
    }

    private static double scaledPositive(int n) {
        return n / 1_000_000.0;
    }

    private static void exerciseValidCase(UnivariateRealFunction f, double min, double max, double initial) {
        try {
            BisectionSolver lhsSolver = new BisectionSolver();
            double lhs = lhsSolver.solve(f, min, max, initial);

            double rhs;
            try {
                BisectionSolver rhsSolver = new BisectionSolver();
                rhs = rhsSolver.solve(f, min, max);
            } catch (Throwable t) {
                return;
            }

            /*
             * Contract/assertion:
             * For BisectionSolver, the 4-argument overload solve(f, min, max, initial)
             * should solve the same bracketed root problem as solve(f, min, max); the
             * provided initial guess does not change the mathematical problem and the
             * fixed patch delegates directly to the 3-argument overload.
             * Therefore, on any valid bracket we construct around a known sin root,
             * both real library calls must agree up to solver accuracy. A patch that
             * merely suppresses the crash or skips the real solve path would violate this.
             */
            double tol = Math.max(lhsSolver.getAbsoluteAccuracy(), new BisectionSolver().getAbsoluteAccuracy()) * 2.0;
            if (Double.isNaN(lhs) != Double.isNaN(rhs) || Math.abs(lhs - rhs) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input=min=" + min +
                    " max=" + max +
                    " initial=" + initial +
                    " lhs=" + lhs +
                    " rhs=" + rhs
                );
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                    && "solve".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
