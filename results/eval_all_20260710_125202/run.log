package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseInvalidMean(-1.0d);

        exerciseInvalidMean(0.0d);

        int raw = data.consumeInt();
        exerciseInvalidMean(raw <= 0 ? (double) raw : (double) (-raw));

        int numerator = data.consumeInt();
        int denomBase = data.consumeInt(1, 1024);
        double fractional = -((double) Math.abs(numerator)) / (double) denomBase;
        if (fractional > 0.0d) {
            fractional = -fractional;
        }
        exerciseInvalidMean(fractional);

        byte b = data.consumeByte();
        exerciseInvalidMean((double) (b <= 0 ? b : -b));

        int positive = data.consumeInt(1, Integer.MAX_VALUE);
        exerciseValidMean((double) positive);
    }

    private static void exerciseInvalidMean(double mean) {
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(mean);

            /*
             * Contract asserted: the Poisson mean must be strictly positive.
             * The failing test shows negative means must be rejected. Therefore,
             * any successful construction for mean <= 0 is an observable bug.
             * A patch that merely deletes the throw would violate this.
             */
            throw new RuntimeException(
                "metamorphic violation: non-positive mean accepted input=" + mean +
                " observedMean=" + dist.getMean()
            );
        } catch (RuntimeException t) {
            if (isHarnessViolation(t)) {
                throw t;
            }
            if (isGroundTruthRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }
    }

    private static void exerciseValidMean(double mean) {
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(mean);

            /*
             * Contract asserted from the public API and failing test:
             * after constructing with a valid positive mean p, getMean()
             * returns that same mean.
             */
            double observed = dist.getMean();
            if (Double.compare(observed, mean) != 0) {
                throw new RuntimeException(
                    "metamorphic violation: getMean mismatch input=" + mean +
                    " observed=" + observed
                );
            }
        } catch (RuntimeException t) {
            if (isHarnessViolation(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isHarnessViolation(Throwable t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("metamorphic violation:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String cn = t.getClass().getName();
        return cn.startsWith("org.apache.commons.math.exception.")
            || cn.contains("MathIllegal")
            || cn.contains("NotStrictlyPositive");
    }

    private static boolean isGroundTruthRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        String cn = t.getClass().getName();
        if (!cn.startsWith("org.apache.commons.math.MathRuntimeException$")) {
            return false;
        }
        boolean sawFactory = false;
        boolean sawPatchedCtor = false;
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.MathRuntimeException".equals(ste.getClassName())
                && "createIllegalArgumentException".equals(ste.getMethodName())) {
                sawFactory = true;
            }
            if ("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(ste.getClassName())
                && "<init>".equals(ste.getMethodName())) {
                sawPatchedCtor = true;
            }
        }
        return sawFactory && sawPatchedCtor;
    }
}
