package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted:
         * - NumberUtils.createNumber is the public parser API.
         * - Commons Lang tests document that integral decimal strings with 'l' or 'L'
         *   are valid and produce equivalent numeric results (e.g. "12345L", "12345l",
         *   "-1l", "01l").
         * - Likewise, decimal strings with 'f'/'F' and 'd'/'D' suffixes are accepted
         *   and case should not change the parsed numeric meaning.
         *
         * Why this catches bad fixes:
         * A patch that merely guards away the original crash or skips suffix handling
         * could stop throwing StringIndexOutOfBoundsException on "l"/"L" while still
         * rejecting or misparsing valid suffixed numbers. The checks below assert
         * acceptance and equivalence on valid-by-construction inputs.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryInvalidInput(anchors[i]);
        }

        String exploredInvalid = buildLikelyInvalid(data);
        tryInvalidInput(exploredInvalid);

        String oneChar = suffixOnly(data.consumeInt(0, 5));
        tryInvalidInput(oneChar);

        int n = data.consumeInt();
        String canonical = Integer.toString(n);
        assertCanonicalLongParses(canonical, "l", n);
        assertCanonicalLongParses(canonical, "L", n);
        checkLongSuffixEquivalence(canonical, (long) n);

        String integralCore = buildIntegralCore(data);
        if (isSignedDecimalDigits(integralCore)) {
            checkLongSuffixEquivalenceSkipOnException(integralCore);
        }

        String hugeCore = repeatDigits(nonEmptySignedDigits(integralCore), data.consumeInt(2, 6));
        if (isSignedDecimalDigits(hugeCore)) {
            checkLongSuffixEquivalenceSkipOnException(hugeCore);
        }

        String decimalBase = buildDecimalBase(data);
        checkFloatSuffixEquivalence(decimalBase);
        checkDoubleSuffixEquivalence(decimalBase);
    }

    private static void tryInvalidInput(String s) {
        try {
            Number n = NumberUtils.createNumber(s);
            throw new RuntimeException(
                    "metamorphic violation: invalid input accepted input=" + s + " result=" + describe(n));
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            return;
        }
    }

    private static void assertCanonicalLongParses(String canonical, String suffix, int expected) {
        try {
            Number parsed = NumberUtils.createNumber(canonical + suffix);
            if (!(parsed instanceof Long) || parsed.longValue() != (long) expected) {
                throw new RuntimeException(
                        "metamorphic violation: canonical integral long suffix parse changed input="
                                + canonical + suffix + " result=" + describe(parsed) + " expected=" + expected);
            }
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid canonical long-suffix input rejected input="
                                + canonical + suffix,
                        t);
            }
        }
    }

    private static void checkLongSuffixEquivalence(String core, long expected) {
        try {
            Number lower = NumberUtils.createNumber(core + "l");
            Number upper = NumberUtils.createNumber(core + "L");
            if (!(lower instanceof Long) || !(upper instanceof Long)
                    || lower.longValue() != expected
                    || upper.longValue() != expected
                    || !sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper) + " expected=" + expected);
            }
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
            if (isCleanRejection(t) || isRootCauseFromCreateNumber(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid integral long-suffix input rejected input=" + core,
                        t);
            }
        }
    }

    private static void checkLongSuffixEquivalenceSkipOnException(String core) {
        try {
            Number lower = NumberUtils.createNumber(core + "l");
            Number upper = NumberUtils.createNumber(core + "L");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + core
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkFloatSuffixEquivalence(String base) {
        try {
            Number lower = NumberUtils.createNumber(base + "f");
            Number upper = NumberUtils.createNumber(base + "F");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'f') != createNumber(x+'F') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
        }
    }

    private static void checkDoubleSuffixEquivalence(String base) {
        try {
            Number lower = NumberUtils.createNumber(base + "d");
            Number upper = NumberUtils.createNumber(base + "D");
            if (!sameNumber(lower, upper)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'d') != createNumber(x+'D') input=" + base
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isOwnViolation(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isOwnViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getClass() == RuntimeException.class
                && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.NumberUtils".equals(e.getClassName())
                    && "createNumber".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == null || b == null) {
            return a == b;
        }
        return a.getClass().equals(b.getClass()) && String.valueOf(a).equals(String.valueOf(b));
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + String.valueOf(n);
    }

    private static String suffixOnly(int which) {
        switch (which) {
            case 0:
                return "l";
            case 1:
                return "L";
            case 2:
                return "f";
            case 3:
                return "F";
            case 4:
                return "d";
            default:
                return "D";
        }
    }

    private static String buildLikelyInvalid(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 7)) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return data.consumeBoolean() ? "f" : "F";
            case 2:
                return data.consumeBoolean() ? "d" : "D";
            case 3: {
                String s = data.consumeAsciiString(1);
                return s.length() == 0 ? "l" : s.substring(0, 1);
            }
            case 4: {
                String s = data.consumeString(1);
                return s.length() == 0 ? "L" : s.substring(0, 1);
            }
            case 5:
                return data.consumeAsciiString(8) + (data.consumeBoolean() ? "l" : "L");
            case 6:
                return data.consumeAsciiString(8) + (data.consumeBoolean() ? "f" : "F");
            default: {
                String rem = data.consumeRemainingAsString();
                if (rem.length() == 0) {
                    return "bobL";
                }
                if (rem.length() == 1) {
                    return rem;
                }
                return rem.substring(rem.length() - 1);
            }
        }
    }

    private static String buildIntegralCore(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                return Integer.toString(data.consumeInt());
            case 1:
                return sanitizeSignedDecimal(data.consumeAsciiString(24), true);
            case 2:
                return sanitizeSignedDecimal(data.consumeString(24), true);
            case 3:
                return repeatDigits(Integer.toString(data.consumeInt()), data.consumeInt(1, 4));
            case 4:
                return (data.consumeBoolean() ? "-" : "") + digitsOnly(data.consumeAsciiString(16));
            default:
                return nonEmptySignedDigits(data.consumeRemainingAsString());
        }
    }

    private static String buildDecimalBase(FuzzedDataProvider data) {
        String left = digitsOnly(data.consumeAsciiString(12));
        String right = digitsOnly(data.consumeString(12));
        if (left.length() == 0) {
            left = Integer.toString(Math.abs(data.consumeInt()));
        }
        if (right.length() == 0) {
            right = Integer.toString(Math.abs(data.consumeInt()));
        }
        String sign = data.consumeBoolean() ? "-" : "";
        if (data.consumeBoolean()) {
            String expDigits = digitsOnly(data.consumeAsciiString(3));
            if (expDigits.length() == 0) {
                expDigits = "0";
            }
            String expSign = data.consumeBoolean() ? "-" : "";
            return sign + left + "." + right + "E" + expSign + expDigits;
        }
        return sign + left + "." + right;
    }

    private static String sanitizeSignedDecimal(String s, boolean allowMinus) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        if (allowMinus && s.length() > 0 && s.charAt(0) == '-') {
            sb.append('-');
            i = 1;
        }
        for (; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        if (sb.length() == 0 || "-".equals(sb.toString())) {
            return "0";
        }
        return sb.toString();
    }

    private static String digitsOnly(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String repeatDigits(String s, int times) {
        String core = nonEmptySignedDigits(s);
        boolean neg = core.startsWith("-");
        String body = neg ? core.substring(1) : core;
        if (body.length() == 0) {
            body = "0";
        }
        StringBuilder sb = new StringBuilder();
        if (neg) {
            sb.append('-');
        }
        for (int i = 0; i < times; i++) {
            sb.append(body);
        }
        return sb.toString();
    }

    private static String nonEmptySignedDigits(String s) {
        String cleaned = sanitizeSignedDecimal(s, true);
        if (cleaned.length() == 0 || "-".equals(cleaned)) {
            return "0";
        }
        return cleaned;
    }

    private static boolean isSignedDecimalDigits(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = 0;
        if (s.charAt(0) == '-') {
            if (s.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }
}
