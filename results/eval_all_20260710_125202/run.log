package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // 1) The Poisson mean must be strictly positive; the failing test expects negative mean
        //    construction to be rejected. If a nonpositive mean is accepted, that is an observable
        //    contract violation and would catch a "deleted throw" style patch.
        // 2) For a valid positive mean, getMean() must return the constructor's mean unchanged,
        //    as exercised by the regression test with 10.0.

        // ANCHOR: exact regression-test trigger first.
        exerciseNonPositiveMean(-1.0d);

        // EXPLORE: more real inputs with the same root-cause property: mean <= 0.
        int cases = 1 + (data.remainingBytes() > 0 ? data.consumeInt(1, 4) : 1);
        for (int i = 0; i < cases; i++) {
            double mean = generateNonPositiveMean(data);
            exerciseNonPositiveMean(mean);
        }

        // Post-condition on valid-by-construction input:
        // A correct implementation stores the supplied positive mean; getMean() must return it.
        double positiveMean = generatePositiveMean(data);
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(positiveMean);
            double observed = dist.getMean();
            if (Double.compare(observed, positiveMean) != 0) {
                throw new RuntimeException(
                    "metamorphic violation: getMean must equal constructor mean input=" +
                    positiveMean + " lhs=" + observed + " rhs=" + positiveMean);
            }
        } catch (Throwable t) {
            // Hygiene rule: if the call preceding the post-condition read throws, skip the check.
            // But still surface the known buggy root-cause if it somehow happens here.
            if (isOwnViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
            return;
        }
    }

    private static void exerciseNonPositiveMean(double mean) {
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(mean);
            // If construction succeeds for mean <= 0, the argument-validation contract was lost.
            throw new RuntimeException(
                "metamorphic violation: nonpositive mean accepted input=" +
                mean + " lhs=constructed rhs=rejected");
        } catch (Throwable t) {
            if (isOwnViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            // Swallow unrelated throwables to avoid false positives outside this patch's scope.
        }
    }

    private static boolean isOwnViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getClass() == RuntimeException.class
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math.exception.")
            || name.contains("MathIllegal")
            || name.contains("NotStrictlyPositive")
            || name.contains("Invalid");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        boolean sawFactory = false;
        boolean sawCtor = false;
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.math.MathRuntimeException".equals(e.getClassName())
                && "createIllegalArgumentException".equals(e.getMethodName())) {
                sawFactory = true;
            }
            if ("org.apache.commons.math.distribution.PoissonDistributionImpl".equals(e.getClassName())
                && "<init>".equals(e.getMethodName())) {
                sawCtor = true;
            }
        }
        return sawFactory && sawCtor;
    }

    private static double generateNonPositiveMean(FuzzedDataProvider data) {
        int choice = data.consumeInt(0, 5);
        switch (choice) {
            case 0:
                return 0.0d;
            case 1: {
                int v = data.consumeInt();
                if (v == Integer.MIN_VALUE) {
                    return -2147483648.0d;
                }
                v = Math.abs(v);
                if (v == 0) {
                    v = 1;
                }
                return -((double) v);
            }
            case 2: {
                int num = data.consumeInt();
                if (num == Integer.MIN_VALUE) {
                    num = Integer.MAX_VALUE;
                }
                num = Math.abs(num);
                int den = data.consumeInt(1, Integer.MAX_VALUE);
                double d = -(((double) num) / ((double) den));
                return d == 0.0d ? -0.5d : d;
            }
            case 3:
                return -Math.abs((double) data.consumeByte()) - 1.0d;
            case 4:
                return -0.0d;
            default:
                return -1.0d * (data.consumeBoolean() ? 1.0d : 10.0d);
        }
    }

    private static double generatePositiveMean(FuzzedDataProvider data) {
        int whole = data.consumeInt(1, Integer.MAX_VALUE);
        int frac = data.consumeInt(0, 999999);
        return whole + (frac / 1000000.0d);
    }
}
