            Class<?> b = ClassUtils.getClass("java.lang.String", false);
            if (a != b) {
                throw new RuntimeException("metamorphic violation: equivalent getClass overloads disagree");
            }
        } catch (ClassNotFoundException e) {
            return;
        } catch (LinkageError e) {
            return;
        } catch (SecurityException e) {
            return;
