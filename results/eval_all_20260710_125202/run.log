package org.jfree.chart.renderer;

import java.awt.Color;
import java.awt.Paint;
import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(FuzzedDataProvider data) {
        GrayPaintScale gps = new GrayPaintScale();

        // ANCHOR: exact trigger from the regression test. These are valid-by-construction:
        // the documented behavior in GrayPaintScaleTests is that out-of-range values are
        // clamped to the nearest bound and must return black/white rather than throwing.
        exerciseClampingContract(gps, -0.5d, 0.0d, true);
        exerciseClampingContract(gps, 1.5d, 1.0d, true);

        // Also keep the in-range endpoints from the public regression test as observable
        // contract checks for correct output.
        checkExactColor(gps, 0.0d, Color.black);
        checkExactColor(gps, 1.0d, Color.white);

        int rounds = 1 + Math.min(4, data.remainingBytes() / 2);
        for (int i = 0; i < rounds; i++) {
            boolean below = data.consumeBoolean();

            int whole = data.consumeInt(1, 1_000_000);
            int frac = data.consumeInt(0, 999_999);
            double delta = whole + (frac / 1_000_000.0);

            double value = below ? -delta : 1.0d + delta;
            double clamped = below ? 0.0d : 1.0d;

            exerciseClampingContract(gps, value, clamped, true);
        }

        // Additional exploration near the bounds with varied decimal structure.
        if (data.remainingBytes() > 0) {
            String s = data.consumeAsciiString(32);
            int hash = s.hashCode();
            double tiny = ((hash & 0x7fffffff) % 1_000_000) / 1_000_000.0;
            double below = -(tiny == 0.0d ? 0.000001d : tiny);
            double above = 1.0d + (tiny == 0.0d ? 0.000001d : tiny);
            exerciseClampingContract(gps, below, 0.0d, true);
            exerciseClampingContract(gps, above, 1.0d, true);
        }
    }

    private static void checkExactColor(GrayPaintScale gps, double value, Color expected) {
        try {
            Paint p = gps.getPaint(value);
            if (!(p instanceof Color)) {
                throw new RuntimeException("metamorphic violation: endpoint color type input=" + value
                        + " got=" + String.valueOf(p));
            }
            Color actual = (Color) p;
            if (!expected.equals(actual)) {
                throw new RuntimeException("metamorphic violation: endpoint color input=" + value
                        + " expected=" + colorString(expected) + " actual=" + colorString(actual));
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            // Any other exception is outside this patch's scope.
        }
