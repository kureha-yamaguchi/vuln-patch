        boolean expected = idx < 3;
        try {
            boolean actual = BooleanUtils.toBoolean(token);
            if (actual != expected) {
                throw new RuntimeException(
                    "metamorphic violation: canonical token oracle input=" + token +
                    " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        // Equivalent-input relation for accepted tokens: a correct case-insensitive parser
        // must give the same result for two different case variants of the same token.
        String v1 = randomizeCase(canonical[idx], data);
        String v2 = randomizeCase(canonical[idx], data);
        Boolean lhs = safeToBoolean(v1);
        Boolean rhs = safeToBoolean(v2);
        if (lhs != null && rhs != null && lhs.booleanValue() != rhs.booleanValue()) {
            throw new RuntimeException(
                "metamorphic violation: case-equivalence input1=" + v1 +
                " lhs=" + lhs + " input2=" + v2 + " rhs=" + rhs);
        }
    }

