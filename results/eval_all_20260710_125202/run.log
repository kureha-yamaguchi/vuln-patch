package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        int prefixLen = data.consumeInt(0, 16);
        int width = data.consumeInt(1, 16);
        int extraSourceLen = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xff);
        boolean useNullObject = data.consumeBoolean();

        String prefix = data.consumeString(prefixLen);
        String sourceTail = data.consumeString(extraSourceLen);
        String source = makeLongerThanWidth(sourceTail, width);
        int initialCapacity = prefix.length() + width;

        if (useNullObject) {
            StrBuilder sb = new StrBuilder(initialCapacity);
            try {
                sb.append(prefix);
            } catch (RuntimeException ignored) {
                return;
            }
            try {
                sb.setNullText(source);
            } catch (RuntimeException ignored) {
                return;
            }
            applyAndCheck(sb, null, width, padChar, source);
        } else {
            StrBuilder sb = new StrBuilder(initialCapacity);
            try {
                sb.append(prefix);
            } catch (RuntimeException ignored) {
                return;
            }
            applyAndCheck(sb, source, width, padChar, null);
        }

        int loops = Math.min(4, Math.max(0, data.remainingBytes()));
        for (int i = 0; i < loops; i++) {
            int localWidth = data.consumeInt(1, 16);
            String localPrefix = data.consumeString(data.consumeInt(0, 8));
            String localTail = data.consumeString(data.consumeInt(1, 24));
            String localSource = makeLongerThanWidth(localTail, localWidth);
            char localPad = (char) (data.consumeByte() & 0xff);
            boolean localNull = data.consumeBoolean();

            StrBuilder sb = new StrBuilder(localPrefix.length() + localWidth);
            try {
                sb.append(localPrefix);
            } catch (RuntimeException ignored) {
                continue;
            }

            if (localNull) {
                try {
                    sb.setNullText(localSource);
                } catch (RuntimeException ignored) {
                    continue;
                }
                applyAndCheck(sb, null, localWidth, localPad, localSource);
            } else {
                applyAndCheck(sb, localSource, localWidth, localPad, null);
            }
        }
    }

    private static void anchor() {
        StrBuilder sb = new StrBuilder(1);
        applyAndCheck(sb, "foo", 1, '-', null);
    }

    private static void applyAndCheck(StrBuilder sb, Object obj, int width, char padChar, String configuredNullText) {
        String before;
        int beforeLen;
        try {
            before = sb.toString();
            beforeLen = sb.length();
        } catch (RuntimeException ignored) {
            return;
        }

        String source = (obj == null) ? configuredNullText : obj.toString();
        if (width <= 0 || source == null) {
            return;
        }

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (RuntimeException t) {
            if (isValidationException(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid appendFixedWidthPadRight input must append a fixed-width field without throwing"
                                + " before=" + before
                                + " source=" + source
                                + " width=" + width
                                + " pad=" + (int) padChar,
                        t);
            }
            return;
        }

        String actual;
        int actualLen;
        try {
            actual = sb.toString();
            actualLen = sb.length();
        } catch (RuntimeException ignored) {
            return;
        }

        /*
         * Contract asserted from appendFixedWidthPadRight's implementation and API:
         * for width > 0 it appends exactly width characters; if the source is longer
         * than width, it appends the leftmost width characters, otherwise it appends
         * the whole source followed by right padding. A throw-deleting or branch-
         * skipping patch would violate either the final length or appended content.
         */
        String expected = before + expectedFixedWidth(source, width, padChar);
        if (actualLen != beforeLen + width || !expected.equals(actual)) {
            throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight must append exactly fixed-width content"
                            + " before=" + before
                            + " source=" + source
                            + " width=" + width
                            + " pad=" + (int) padChar
                            + " expected=" + expected
                            + " actual=" + actual
                            + " beforeLen=" + beforeLen
                            + " afterLen=" + actualLen);
        }
    }

    private static String expectedFixedWidth(String source, int width, char padChar) {
        if (source.length() >= width) {
            return source.substring(0, width);
        }
        StringBuilder sb = new StringBuilder(width);
        sb.append(source);
        for (int i = source.length(); i < width; i++) {
            sb.append(padChar);
        }
        return sb.toString();
    }

    private static String makeLongerThanWidth(String tail, int width) {
        String s = tail == null ? "" : tail;
        while (s.length() <= width) {
            s = s + "X";
        }
        return s;
    }

    private static boolean isValidationException(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)
                    && ("appendFixedWidthPadRight".equals(method)
                    || "ensureCapacity".equals(method)
                    || "getNullText".equals(method))) {
                return true;
            }
        }
        return false;
    }
}
