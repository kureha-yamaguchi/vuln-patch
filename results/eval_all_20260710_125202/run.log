package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression test input. On the buggy version, the 4-arg overload
        // ignores f and reaches a NullPointerException inside BisectionSolver.solve.
        try {
            BisectionSolver solver = new BisectionSolver();
            solver.solve(f, 3.0, 3.2, 3.1);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        int mode = data.consumeInt(0, 2);
        if (mode == 0) {
            exploreAroundKnownRoot(data, f);
        } else if (mode == 1) {
            exploreAroundRandomMultipleOfPi(data, f);
        } else {
            exploreEquivalentOverloads(data, f);
        }
    }

    private static void exploreAroundKnownRoot(FuzzedDataProvider data, UnivariateRealFunction f) {
        double root = Math.PI;
        double left = positiveWidth(data);
        double right = positiveWidth(data);
        double min = root - left;
        double max = root + right;
        double initial = midpoint(min, max);

        // Small valid perturbation of initial while keeping it inside [min, max].
        if (data.consumeBoolean()) {
            double delta = (max - min) * 0.25;
            initial = clamp(initial + (data.consumeBoolean() ? delta : -delta), min, max);
        }

        runChecks(f, min, max, initial);
    }

    private static void exploreAroundRandomMultipleOfPi(FuzzedDataProvider data, UnivariateRealFunction f) {
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        // Keep the interval straddling exactly one known root and well below half-period.
        double left = positiveWidth(data);
        double right = positiveWidth(data);
        double min = root - left;
        double max = root + right;

        double initial;
        switch (data.consumeInt(0, 3)) {
            case 0:
                initial = root;
                break;
            case 1:
                initial = min;
                break;
            case 2:
                initial = max;
                break;
            default:
                initial = clamp(root + signedFraction(data) * Math.min(left, right), min, max);
                break;
        }

        runChecks(f, min, max, initial);
    }

    private static void exploreEquivalentOverloads(FuzzedDataProvider data, UnivariateRealFunction f) {
        int k = data.consumeInt(-256, 256);
        double root = k * Math.PI;
        double width = positiveWidth(data);
        double min = root - width;
        double max = root + width;
        double initial = clamp(root + signedFraction(data) * width, min, max);

        runChecks(f, min, max, initial);
    }

    private static void runChecks(UnivariateRealFunction f, double min, double max, double initial) {
        BisectionSolver solverA = new BisectionSolver();

        try {
            double fourArg = solverA.solve(f, min, max, initial);

            // Contract/metamorphic check:
            // The patched method body shows that solve(f, min, max, initial) delegates to solve(f, min, max).
            // Therefore for any valid input a correct implementation must produce the same result as the
            // 3-argument overload on the same function and interval; deleting the real call or silently
