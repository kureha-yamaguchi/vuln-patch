        if (sb.length() != beforeLen + width || !expected.equals(actual)) {
            throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight must append exactly fixed-width content"
                            + " before=" + before
                            + " source=" + source
                            + " width=" + width
                            + " pad=" + (int) padChar
                            + " expected=" + expected
                            + " actual=" + actual
                            + " beforeLen=" + beforeLen
                            + " afterLen=" + sb.length());
        }
    }

    private static String expectedFixedWidth(String source, int width, char padChar) {
        if (width <= 0) {
            return "";
        }
        if (source == null) {
            return null;
        }
        if (source.length() >= width) {
            return source.substring(0, width);
        }
        StringBuilder out = new StringBuilder(width);
        out.append(source);
        while (out.length() < width) {
            out.append(padChar);
        }
        return out.toString();
    }

