            }
            if ("org.apache.commons.math3.util.Precision".equals(cls)
                    && ("compareTo".equals(m) || "equals".equals(m))) {
                return true;
            }
            if ("org.apache.commons.math3.linear.Array2DRowRealMatrix".equals(cls)
                    && ("getEntry".equals(m) || "getRowDimension".equals(m) || "getColumnDimension".equals(m))) {
                return true;
            }
        }
        return false;
    }

    private static String deepToString(double[][] a) {
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < a.length; i++) {
            if (i != 0) {
                sb.append(", ");
            }
            sb.append(Arrays.toString(a[i]));
        }
        sb.append(']');
        return sb.toString();
    }

