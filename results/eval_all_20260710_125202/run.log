                "metamorphic violation: appendFixedWidthPadRight post-condition"
                    + " before=" + safe(before)
                    + " source=" + safe(source)
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " expected=" + safe(expected)
                    + " actual=" + safe(after));
