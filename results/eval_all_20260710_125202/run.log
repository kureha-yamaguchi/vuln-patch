        String actual = sb.toString();
        String expected = before + expectedFixedWidth(source, width, padChar);

        /*
         * Contract asserted: appendFixedWidthPadRight appends a fixed-width field.
         * A correct implementation must increase length by exactly width and append
         * either the whole string plus right padding, or the leftmost width chars if
         * the string is longer. A throw-deleting or branch-skipping patch would
         * violate this observable post-condition.
