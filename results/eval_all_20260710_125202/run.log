        }
    }

    private static void checkMeanPreserved(double mean, double epsilon, int maxIterations) {
        double lhs;
        double rhs;
        try {
            lhs = new PoissonDistributionImpl(mean).getMean();
            rhs = new PoissonDistributionImpl(mean, epsilon, maxIterations).getMean();
        } catch (Throwable t) {
            // If either side throws, the relation does not apply to this input.
            return;
        }

        if (Double.compare(lhs, mean) != 0) {
            throw new RuntimeException("metamorphic violation: getMean() must return constructor mean"
                    + " input=" + mean + " lhs=" + lhs + " rhs=" + rhs);
        }
        if (Double.compare(rhs, mean) != 0) {
            throw new RuntimeException("metamorphic violation: 3-arg constructor must preserve mean"
                    + " input=" + mean + " lhs=" + lhs + " rhs=" + rhs
                    + " epsilon=" + epsilon + " maxIterations=" + maxIterations);
        }
        if (Double.compare(lhs, rhs) != 0) {
            throw new RuntimeException("metamorphic violation: equivalent constructors disagree on mean"
                    + " input=" + mean + " lhs=" + lhs + " rhs=" + rhs
                    + " epsilon=" + epsilon + " maxIterations=" + maxIterations);
        }
    }

    private static double buildPositiveMean(FuzzedDataProvider data) {
        int numerator = data.consumeInt(1, 1000000);
        int denominator = data.consumeInt(1, 1000000);
        double mean = ((double) numerator) / ((double) denominator);
        if (mean <= 0.0d) {
            mean = 1.0d;
        }
        return mean;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        boolean sawFactory = false;
        boolean sawPoissonCtor = false;
        for (StackTraceElement ste : t.getStackTrace()) {
