public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted:
         * 1) The public parser API NumberUtils.createNumber must reject malformed inputs such as "l", "L", "junk",
         *    and "bobL" cleanly as invalid input, not leak an internal StringIndexOutOfBoundsException from the
         *    long-suffix parsing branch.
         * 2) Documented tests show that valid integral decimal strings with either 'l' or 'L' suffix are accepted
         *    and denote the same numeric value ("12345L" and "12345l", also "-1l", "01l", "1l"). Therefore,
         *    for any valid-by-construction integral core, createNumber(core + "l") and createNumber(core + "L")
         *    must produce equivalent results. A patch that merely skips the buggy branch or changes its behavior
         *    incorrectly can violate this relation without throwing.
         * 3) Likewise, suffix case pairs 'f'/'F' and 'd'/'D' should be equivalent for valid decimal inputs.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            assertCleanInvalidRejection(anchors[i]);
        }

        String singleChar;
        switch (data.consumeInt(0, 7)) {
            case 0:
                singleChar = "l";
                break;
            case 1:
                singleChar = "L";
                break;
            case 2:
                singleChar = "f";
                break;
            case 3:
                singleChar = "F";
                break;
            case 4:
                singleChar = "d";
                break;
            case 5:
                singleChar = "D";
                break;
            case 6:
                String a = data.consumeAsciiString(1);
                singleChar = a.length() == 0 ? "l" : a.substring(0, 1);
                break;
            default:
                String b = data.consumeString(1);
                singleChar = b.length() == 0 ? "L" : b.substring(0, 1);
                break;
        }
        tryCreateNumber(singleChar);

        String raw = data.consumeAsciiString(32);
        String digits = decimalDigitsOnly(raw, false);
        String signedDigits = decimalDigitsOnly(raw, true);
        String exp = decimalDigitsOnly(data.consumeAsciiString(8), true);
        String hex = hexDigitsOnly(data.consumeAsciiString(16));

        if (digits.length() == 0) {
            digits = "0";
        }
        if (!isSignedDecimalDigits(signedDigits)) {
