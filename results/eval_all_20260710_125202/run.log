package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.UnivariateRealFunction;
import org.apache.commons.math.analysis.SinFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact trigger from the regression test.
        exerciseAndCheck(f, 3.0, 3.2, 3.1, 3.05);

        // EXPLORE:
        // Root-cause property: any call to the 4-arg public API on BisectionSolver with a real function
        // and an otherwise acceptable interval reaches the patched method. To avoid false positives from
        // legitimate argument rejection, construct valid-by-construction bracketing intervals for sin(x)
        // around known roots k*pi.
        int k = data.consumeInt(-1000, 1000);
        double center = k * Math.PI;

        double leftWidth = positiveWidth(data.consumeInt(1, 1_000_000));
        double rightWidth = positiveWidth(data.consumeInt(1, 1_000_000));
        double min = center - leftWidth;
        double max = center + rightWidth;

        if (!(min < max) || !Double.isFinite(min) || !Double.isFinite(max)) {
            return;
        }

        double initial;
        int mode = data.consumeInt(0, 4);
        switch (mode) {
            case 0:
                initial = center;
                break;
            case 1:
                initial = min;
                break;
            case 2:
                initial = max;
                break;
            case 3:
                initial = midpoint(min, max);
                break;
            default:
                double ratio = data.consumeInt(0, 1_000_000) / 1_000_000.0;
                initial = min + (max - min) * ratio;
                break;
        }

        double altInitial;
        int altMode = data.consumeInt(0, 4);
        switch (altMode) {
            case 0:
                altInitial = center;
                break;
            case 1:
                altInitial = min;
                break;
            case 2:
                altInitial = max;
                break;
            case 3:
                altInitial = midpoint(min, max);
                break;
            default:
                double ratio2 = data.consumeInt(0, 1_000_000) / 1_000_000.0;
                altInitial = min + (max - min) * ratio2;
                break;
        }

        exerciseAndCheck(f, min, max, initial, altInitial);
    }

    private static double positiveWidth(int raw) {
        return raw / 1_000_000.0;
    }

    private static double midpoint(double a, double b) {
        return a + (b - a) / 2.0;
    }

    private static void exerciseAndCheck(UnivariateRealFunction f, double min, double max, double initial, double altInitial) {
        callTarget(f, min, max, initial);

        // Contract / metamorphic check:
        // BisectionSolver's 4-arg solve overload should behave like the 3-arg solve for the same function
        // and interval, because bisection does not use an initial guess. Therefore changing the initial
        // guess must not change the computed root. A patch that merely suppresses the crash or skips the
        // real solve path would violate this equivalence.
        Double rThreeArg = null;
        Double rFourArg = null;
        Double rFourArgAlt = null;

        try {
            BisectionSolver s1 = new BisectionSolver();
            rThreeArg = s1.solve(f, min, max);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            BisectionSolver s2 = new BisectionSolver();
            rFourArg = s2.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            BisectionSolver s3 = new BisectionSolver();
            rFourArgAlt = s3.solve(f, min, max, altInitial);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (rThreeArg != null && rFourArg != null) {
            double tol = 1e-9;
            if (Math.abs(rThreeArg.doubleValue() - rFourArg.doubleValue()) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: solve(f,min,max,initial) must agree with solve(f,min,max)"
                        + " input=[min=" + min + ", max=" + max + ", initial=" + initial + "]"
                        + " lhs=" + rFourArg + " rhs=" + rThreeArg);
            }
        }

        if (rFourArg != null && rFourArgAlt != null) {
            double tol = 1e-9;
            if (Math.abs(rFourArg.doubleValue() - rFourArgAlt.doubleValue()) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: bisection result must be independent of initial guess"
                        + " input=[min=" + min + ", max=" + max + ", initial1=" + initial + ", initial2=" + altInitial + "]"
                        + " lhs=" + rFourArg + " rhs=" + rFourArgAlt);
            }
        }
    }

    private static void callTarget(UnivariateRealFunction f, double min, double max, double initial) {
        try {
            BisectionSolver solver = new BisectionSolver();
            solver.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean shouldPropagate(Throwable t) {
        if (t == null) {
            return false;
        }

        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return false;
        }

        if (t instanceof NullPointerException) {
            for (StackTraceElement ste : t.getStackTrace()) {
                if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                        && "solve".equals(ste.getMethodName())) {
                    return true;
                }
            }
        }

        if (t instanceof RuntimeException && t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
            return true;
        }

        if (t instanceof FunctionEvaluationException || t instanceof MaxIterationsExceededException) {
            return false;
        }

        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
