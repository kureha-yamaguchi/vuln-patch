package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    private static final UnivariateRealFunction SIN = new SinFunction();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression-test input.
        exerciseCase(3.0, 3.2, 3.1, Math.PI);

        // EXPLORE: valid-by-construction intervals around exact zeros of sin(x), with varied
        // positions and widths, and varied initial guesses. This exercises the same public API
        // while ensuring a correct implementation is obligated to handle the input.
        int cases = 1 + (data.remainingBytes() > 0 ? data.consumeInt(0, 3) : 0);
        for (int i = 0; i < cases; i++) {
            int k = data.consumeInt(-1000, 1000);
            double root = k * Math.PI;

            // Keep both sides strictly positive and comfortably below pi so the interval contains
            // exactly one zero of sin(x): x = k*pi.
            double left = 0.001 + (data.consumeInt(1, 1500) / 1000.0);
            double right = 0.001 + (data.consumeInt(1, 1500) / 1000.0);

            double min = root - left;
            double max = root + right;

            double initial;
            if (data.consumeBoolean()) {
                initial = root;
            } else {
                double frac = data.consumeInt(0, 1000000) / 1000000.0;
                initial = min + frac * (max - min);
            }

            exerciseCase(min, max, initial, root);
        }
    }

    private static void exerciseCase(double min, double max, double initial, double expectedRoot) {
        BisectionSolver solver = new BisectionSolver();
        double withInitial;

        try {
            withInitial = solver.solve(SIN, min, max, initial);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
            return;
        }

        // Contract/oracle:
        // A solver invocation on sin(x) over an interval we constructed to contain exactly one zero,
        // x = k*pi, must return that zero (up to the solver's accuracy). A "fix" that merely avoids
        // the crash but returns a dummy/stale value would violate this observable post-condition.
        double tol = Math.max(1e-12, solver.getAbsoluteAccuracy() * 4.0);
        if (Double.isNaN(withInitial) || Double.isInfinite(withInitial)
                || Math.abs(withInitial - expectedRoot) > tol) {
            throw new RuntimeException(
                "metamorphic violation: unique-root oracle input="
                    + "[min=" + min + ", max=" + max + ", initial=" + initial + ", expectedRoot=" + expectedRoot + "]"
                    + " lhs=" + withInitial + " rhs=" + expectedRoot);
        }

        // Equivalent-input relation:
        // For BisectionSolver, the 4-arg overload should behave like the 3-arg solve on the same
        // function and interval; the initial guess is not semantically relevant for bisection.
        // If either side throws, the relation does not apply to that input.
        BisectionSolver solverNoInitial = new BisectionSolver();
        double withoutInitial;
        try {
            withoutInitial = solverNoInitial.solve(SIN, min, max);
        } catch (Throwable t) {
            return;
        }

        double relTol = Math.max(1e-12,
                Math.max(solver.getAbsoluteAccuracy(), solverNoInitial.getAbsoluteAccuracy()) * 4.0);
        if (Double.isNaN(withoutInitial) || Double.isInfinite(withoutInitial)
                || Math.abs(withInitial - withoutInitial) > relTol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initial) == solve(f,min,max) input="
                    + "[min=" + min + ", max=" + max + ", initial=" + initial + "]"
                    + " lhs=" + withInitial + " rhs=" + withoutInitial);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
