package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryToBoolean("off");

        String[] observed = new String[] {
            "oof", "yep", "trux", "false", "a", "true", "truE", "trUe", "trUE",
            "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE", "TRue",
            "TrUE", "TrUe", "TruE", "True", "on", "oN", "On", "ON", "yes",
            "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };
        if (data.consumeBoolean()) {
            tryToBoolean(observed[data.consumeInt(0, observed.length - 1)]);
        }

        String base3 = data.consumeAsciiString(3);
        String candidate3 = fitToLength(base3, 3, 'a');
        if (candidate3.length() == 3) {
            char forced0;
            if (data.consumeBoolean()) {
                forced0 = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                if (forced0 == 'y' || forced0 == 'Y') {
                    forced0 = 'o';
                }
            } else {
                forced0 = data.consumeBoolean() ? 'y' : 'Y';
            }
            candidate3 = forced0 + candidate3.substring(1);
            tryToBoolean(candidate3);
        }

        String seed = data.consumeAsciiString(8);
        if (seed.length() > 0) {
            int mode = data.consumeInt(0, 4);
            String mutated;
            if (mode == 0) {
                mutated = fitToLength(seed, 3, 'x');
            } else if (mode == 1) {
                mutated = fitToLength("off", 3, 'f');
            } else if (mode == 2) {
                mutated = fitToLength("yes", 3, 's');
            } else if (mode == 3) {
                mutated = fitToLength("tru", 3, 'u');
            } else {
                mutated = fitToLength(seed + "?", 4, '?');
            }
            tryToBoolean(mutated);
        }

        String remaining = data.consumeRemainingAsString();
        if (remaining.length() > 0) {
            tryToBoolean(remaining);
            if (remaining.length() >= 3) {
                tryToBoolean(remaining.substring(0, 3));
            }
        }

        String[] trueTokens = new String[] { "true", "on", "yes" };
        String token = trueTokens[data.consumeInt(0, trueTokens.length - 1)];
        String variant = randomCase(token, data);
        try {
            boolean lhs = BooleanUtils.toBoolean(token);
            boolean rhs = BooleanUtils.toBoolean(variant);
            /* Contract asserted: BooleanUtils.toBoolean is case-insensitive for the true tokens
               visible in the code/tests ("true", "on", "yes"). A patch that merely blocks the
               crashing path by making the relevant branch unreachable, or that deletes behavior in
               the Y/y handling, can silently turn a valid mixed-case token into false. */
            if (!lhs || !rhs || lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: case-insensitive true token input=" + variant +
                    " lhs=" + lhs + " rhs=" + rhs
                );
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        String yesVariant = randomCase("yes", data);
        try {
            boolean lhs = BooleanUtils.toBoolean("yes");
            boolean rhs = BooleanUtils.toBoolean(yesVariant);
            if (lhs != rhs || !rhs) {
                throw new RuntimeException(
                    "metamorphic violation: yes case-variant input=" + yesVariant +
                    " lhs=" + lhs + " rhs=" + rhs
                );
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void tryToBoolean(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String fitToLength(String s, int len, char pad) {
        if (s == null) {
            s = "";
        }
        if (s.length() == len) {
            return s;
        }
        if (s.length() > len) {
            return s.substring(0, len);
        }
        StringBuilder b = new StringBuilder(s);
        while (b.length() < len) {
            b.append(pad);
        }
        return b.toString();
    }

    private static String randomCase(String s, FuzzedDataProvider data) {
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (data.consumeBoolean()) {
                b.append(Character.toUpperCase(c));
            } else {
                b.append(Character.toLowerCase(c));
            }
        }
        return b.toString();
    }
}
