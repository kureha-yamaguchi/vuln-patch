package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.MessageFormat;
import java.text.ParsePosition;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = new HashMap();

    static {
        REGISTRY.put("lower", new LowerFormatFactory());
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract checked below:
        // ExtendedMessageFormat is a MessageFormat extension, so quoted text must be preserved
        // with MessageFormat semantics, including "''" representing one literal quote.
        // For a pattern containing exactly one custom "{0,lower}" element, formatting with
        // ExtendedMessageFormat(pattern, registry) on argument X must match formatting with a
        // plain MessageFormat on the equivalent pattern "{0}" when given lower(X). A patch that
        // merely makes the crashing branch unreachable or skips the quote bookkeeping breaks this.
        exercise(
                "it''s a {0,lower} 'test'!",
                "DUMMY",
                true,
                true
        );

        String prefix = sanitizeLiteral(data.consumeAsciiString(24));
        String middle = sanitizeLiteral(data.consumeAsciiString(24));
        String quoted = sanitizeLiteral(data.consumeAsciiString(24));
        String suffix = sanitizeLiteral(data.consumeAsciiString(24));
        String arg = data.consumeString(32);

        int layout = data.consumeInt(0, 5);
        String pattern;
        switch (layout) {
            case 0:
                pattern = prefix + "''" + middle + "{0,lower}'" + quoted + "'" + suffix;
                break;
            case 1:
                pattern = prefix + "{0,lower}" + middle + "''" + suffix;
                break;
            case 2:
                pattern = "''" + prefix + "{0,lower}" + middle + "'" + quoted + "'" + suffix;
                break;
            case 3:
                pattern = prefix + "'" + quoted + "'" + middle + "''" + suffix + "{0,lower}";
                break;
            case 4:
                pattern = prefix + "{0,lower}" + middle + "'" + quoted + "'" + suffix + "''";
                break;
            default:
                pattern = prefix + "''" + middle + "{0,lower}" + suffix;
                break;
        }

        exercise(pattern, arg, true, false);
    }

    private static void exercise(String pattern, String arg, boolean runMetamorphic, boolean anchor) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.ENGLISH, REGISTRY);
            String actual = emf.format(new Object[] { arg });

            if (anchor) {
                if (!"it's a dummy test!".equals(actual)) {
                    throw new RuntimeException("metamorphic violation: anchor output input=" + pattern + " lhs=" + actual + " rhs=it's a dummy test!");
                }
            }

            if (runMetamorphic) {
                String equivalentPattern = replaceOnce(pattern, "{0,lower}", "{0}");
                try {
                    MessageFormat mf = new MessageFormat(equivalentPattern, Locale.ENGLISH);
                    String expected = mf.format(new Object[] { toLower(arg) });
                    if (!actual.equals(expected)) {
                        throw new RuntimeException(
                                "metamorphic violation: lower-format equivalence input=" + pattern +
                                " lhs=" + actual + " rhs=" + expected
                        );
                    }
                } catch (Throwable t) {
                    if (isRootCause(t)) {
                        throw t;
                    }
                    return;
                }
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(e.getClassName())
