package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorSeedCase();

        int meanTenths = data.consumeInt(-50, 50);
        int sdTenths = data.consumeInt(1, 50);
        int k = data.consumeInt(-6, 6);

        double mean = meanTenths / 10.0;
        double sd = sdTenths / 10.0;
        exploreConstructedRoundTrip(mean, sd, k);

        int k2 = data.consumeInt(-8, 8);
        exploreConstructedRoundTrip(0.0, 1.0, k2);
    }

    private static void anchorSeedCase() {
        NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);
        double p = 0.9772498680518209d;
        double result;
        try {
            result = normal.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (t instanceof MathException && hasBracketFrame(t)) {
                throw new RuntimeException("anchor root-cause via bracket p=" + p, t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (!closeEnough(result, 2.0d)) {
            throw new RuntimeException("metamorphic violation: anchor inverseCumulativeProbability expected 2.0 input=" + p + " actual=" + result);
        }

        try {
            double roundTrip = normal.cumulativeProbability(result);
            if (!closeEnough(roundTrip, p)) {
                throw new RuntimeException("metamorphic violation: CDF(ICDF(p)) ~= p input=" + p + " result=" + result + " roundTrip=" + roundTrip);
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static void exploreConstructedRoundTrip(double mean, double sd, int k) {
        if (!(sd > 0.0) || Double.isNaN(mean) || Double.isNaN(sd) || Double.isInfinite(mean) || Double.isInfinite(sd)) {
            return;
        }

        NormalDistributionImpl normal;
        try {
            normal = new NormalDistributionImpl(mean, sd);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        double x = mean + (k * sd);
        double p;
        try {
            p = normal.cumulativeProbability(x);
        } catch (Throwable t) {
            return;
        }

        if (!(p > 0.0d && p < 1.0d) || Double.isNaN(p)) {
            return;
        }

        double recovered;
        try {
            recovered = normal.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (t instanceof MathException && hasBracketFrame(t)) {
                throw new RuntimeException("round-trip root-cause via bracket mean=" + mean + " sd=" + sd + " x=" + x + " p=" + p, t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        /*
         * Contract asserted: inverseCumulativeProbability is the inverse of cumulativeProbability
         * on probabilities strictly between 0 and 1. Here p is constructed from the real library as
         * p = cumulativeProbability(x), so a correct implementation must recover x (up to solver
         * tolerance). A patch that merely deletes the throw or corrupts bracketing could silently
         * return a wrong quantile, which this round-trip catches.
         */
        if (!closeEnough(recovered, x)) {
            throw new RuntimeException(
                "metamorphic violation: ICDF(CDF(x)) ~= x mean=" + mean +
                " sd=" + sd +
                " x=" + x +
                " p=" + p +
                " recovered=" + recovered
            );
        }

        try {
            double p2 = normal.cumulativeProbability(recovered);
            if (!closeEnough(p2, p)) {
                throw new RuntimeException(
                    "metamorphic violation: CDF(ICDF(p)) ~= p mean=" + mean +
                    " sd=" + sd +
                    " x=" + x +
                    " p=" + p +
                    " recovered=" + recovered +
                    " roundTrip=" + p2
                );
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static boolean hasBracketFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(ste.getClassName())
                    && "bracket".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(ste.getClassName())
                    && "inverseCumulativeProbability".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("Invalid")
                || name.contains("Illegal")
                || name.contains("Format")
                || name.contains("Argument");
    }

    private static boolean closeEnough(double a, double b) {
        if (Double.doubleToLongBits(a) == Double.doubleToLongBits(b)) {
            return true;
        }
        if (Double.isNaN(a) || Double.isNaN(b) || Double.isInfinite(a) || Double.isInfinite(b)) {
            return false;
        }
        double scale = Math.max(1.0d, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-12d * scale;
    }
}
