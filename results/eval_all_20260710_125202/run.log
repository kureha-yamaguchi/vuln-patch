    private static PointValuePair optimize(double[] objective, List<LinearConstraint> constraints, boolean nonNegative) {
        SimplexSolver solver = new SimplexSolver();
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, nonNegative);
    }

    private static boolean sameResult(PointValuePair a, PointValuePair b) {
        if (a == null || b == null) {
            return false;
        }
        if (!close(a.getValue(), b.getValue())) {
            return false;
        }
        double[] ap = a.getPoint();
        double[] bp = b.getPoint();
        if (ap == null || bp == null || ap.length != bp.length) {
            return false;
        }
        for (int i = 0; i < ap.length; i++) {
            if (!close(ap[i], bp[i])) {
                return false;
            }
        }
        return true;
    }

    private static boolean close(double x, double y) {
        double diff = Math.abs(x - y);
        double scale = Math.max(1.0, Math.max(Math.abs(x), Math.abs(y)));
        return diff <= 1.0e-7 * scale;
    }

    private static String pointToString(double[] p) {
        if (p == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('[');
        for (int i = 0; i < p.length; i++) {
            if (i != 0) {
                sb.append(',');
            }
            sb.append(p[i]);
        }
        sb.append(']');
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t == null) {
            return false;
        }
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
