package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression test input from BisectionSolverTest.testMath369.
        try {
            double anchored = new BisectionSolver().solve(f, 3.0, 3.2, 3.1);
            // Contract/oracle-from-input:
            // For sin(x) on [3.0, 3.2], the unique root in the interval is pi.
            // A correct implementation of solve(...) must return that root.
            double acc = new BisectionSolver().getAbsoluteAccuracy();
            if (Double.isFinite(anchored) && Math.abs(anchored - Math.PI) > acc * 4.0 + 1e-8) {
                throw new RuntimeException(
                    "metamorphic violation: anchored solve should recover pi input=[3.0,3.2,3.1] result=" + anchored
                );
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // EXPLORE:
        // Root cause property: any call to BisectionSolver.solve(f, min, max, initial)
        // with a real non-null function reaches the patched delegation.
        // We generate valid-by-construction intervals around a known root k*pi of sin(x),
        // so a correct implementation is obliged to handle them.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftMilli = data.consumeInt(1, 400);
        int rightMilli = data.consumeInt(1, 400);
        double left = leftMilli / 1000.0;
        double right = rightMilli / 1000.0;

        double min = root - left;
        double max = root + right;

        double initialA;
        double initialB;
        if (data.consumeBoolean()) {
            initialA = root;
        } else {
            int aMilli = data.consumeInt(0, leftMilli + rightMilli);
            initialA = min + (aMilli / 1000.0);
        }

        if (data.consumeBoolean()) {
            initialB = min + (max - min) * 0.25;
        } else {
            int bMilli = data.consumeInt(0, leftMilli + rightMilli);
            initialB = min + (bMilli / 1000.0);
        }

        runValidConstructedCase(f, root, min, max, initialA, initialB);
    }

    private static void runValidConstructedCase(
            UnivariateRealFunction f,
            double expectedRoot,
            double min,
            double max,
            double initialA,
            double initialB) {
        double rA;
        double rB;
        double r3;

        try {
            rA = new BisectionSolver().solve(f, min, max, initialA);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            rB = new BisectionSolver().solve(f, min, max, initialB);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        try {
            r3 = new BisectionSolver().solve(f, min, max);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        // Metamorphic/post-condition:
        // We constructed [min,max] to straddle exactly one known root of sin(x), namely k*pi,
        // with width < 0.8 < pi, so the solver should recover that same root.
        // Also, for bisection the extra "initial" argument must not change the solved root:
        // solve(f,min,max,initialA), solve(f,min,max,initialB), and solve(f,min,max) must agree.
        double tol = Math.max(new BisectionSolver().getAbsoluteAccuracy() * 8.0, 1e-8);

        if (!(Double.isFinite(rA) && Double.isFinite(rB) && Double.isFinite(r3))) {
            throw new RuntimeException(
                "metamorphic violation: expected finite results input=[" + min + "," + max + "," + initialA + "," + initialB +
                "] lhs=" + rA + " rhs=" + rB + " base=" + r3
            );
        }

        if (Math.abs(rA - expectedRoot) > tol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initialA) should recover constructed root input=[" + min + "," + max + "," +
                initialA + "] result=" + rA + " expected=" + expectedRoot
            );
        }

        if (Math.abs(rB - expectedRoot) > tol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max,initialB) should recover constructed root input=[" + min + "," + max + "," +
                initialB + "] result=" + rB + " expected=" + expectedRoot
            );
        }

        if (Math.abs(r3 - expectedRoot) > tol) {
            throw new RuntimeException(
                "metamorphic violation: solve(f,min,max) should recover constructed root input=[" + min + "," + max +
                "] result=" + r3 + " expected=" + expectedRoot
            );
        }

        if (Math.abs(rA - rB) > tol || Math.abs(rA - r3) > tol) {
            throw new RuntimeException(
                "metamorphic violation: initial guess must not change bisection root input=[" + min + "," + max + "," +
                initialA + "," + initialB + "] lhs=" + rA + " rhs=" + rB + " base=" + r3
