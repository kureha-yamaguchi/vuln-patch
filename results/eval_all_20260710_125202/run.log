            } catch (NumberFormatException ignoredToo) {
            }
            expectedUpper = null;
        }

        if (expectedUpper != null) {
            Number actualUpper = NumberUtils.createNumber(upperHex);
            if (actualUpper == null || actualUpper.intValue() != expectedUpper.intValue()) {
                throw new IllegalStateException("createNumber disagrees with createInteger for uppercase hex");
            }

            Integer expectedLower = NumberUtils.createInteger(lowerHex);
            if (!expectedUpper.equals(expectedLower)) {
                throw new IllegalStateException("createInteger disagrees across x/X prefixes");
            }

            Number lowerNumber;
            try {
                lowerNumber = NumberUtils.createNumber(lowerHex);
            } catch (NumberFormatException ignored) {
                lowerNumber = null;
            }

            if (lowerNumber != null && !actualUpper.equals(lowerNumber)) {
                throw new IllegalStateException("metamorphic violation: 0X and 0x forms must be equivalent");
            }
        }

        try {
            NumberUtils.createNumber(buildLongLiteral(data));
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(buildScientificLiteral(data));
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(buildBigIntegerLiteral(data));
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(buildFixedPointLiteral(data));
        } catch (NumberFormatException ignored) {
        }

        String canonicalInt = Integer.toString(data.consumeInt());
        try {
            Integer viaInteger = NumberUtils.createInteger(canonicalInt);
            Number viaNumber = NumberUtils.createNumber(canonicalInt);
            if (viaInteger != null && viaNumber != null && viaInteger.intValue() != viaNumber.intValue()) {
                throw new IllegalStateException("oracle violation: canonical decimal int parse disagrees");
            }
        } catch (NumberFormatException ignored) {
        }

        try {
            NumberUtils.createNumber(data.consumeRemainingAsString());
        } catch (NumberFormatException ignored) {
        }
    }
