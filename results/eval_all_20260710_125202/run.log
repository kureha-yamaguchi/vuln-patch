package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();
        explore(data);
    }

    private static void anchor() {
        UnivariateRealFunction f = new SinFunction();
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, 3.0, 3.2, 3.1);

            /*
             * Contract/metamorphic check:
             * For BisectionSolver, the 4-argument solve(f, min, max, initial) is supposed to behave
             * like the normal bisection solve on the same function and interval; the patch itself
             * changes the implementation to delegate to solve(f, min, max). A "fix" that merely
             * suppresses the crash or skips real solving would violate this observable equivalence.
             */
            BisectionSolver solver2 = new BisectionSolver();
            double expected = solver2.solve(f, 3.0, 3.2);
            double tol = Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()) + 1e-12;
            if (Double.isNaN(result) || Double.isInfinite(result) || Math.abs(result - expected) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: 4-arg solve must agree with 3-arg solve input=[3.0,3.2,3.1] lhs="
                        + result + " rhs=" + expected);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isMetamorphicViolation(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static void explore(FuzzedDataProvider data) {
        int cases = 1 + Math.abs(data.consumeInt(0, 4));
        for (int i = 0; i < cases; i++) {
            runOneExplorationCase(data);
        }
    }

    private static void runOneExplorationCase(FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int denom = data.consumeInt(16, 1 << 20);
        double width = Math.PI / denom;

        double leftPad = width * (1.0 + data.consumeInt(0, 32));
        double rightPad = width * (1.0 + data.consumeInt(0, 32));

        double min = root - leftPad;
        double max = root + rightPad;
        if (!(min < max)) {
            return;
        }

        double initial;
        if (data.consumeBoolean()) {
            initial = min + (max - min) * (data.consumeInt(0, 1000) / 1000.0);
        } else {
            initial = root;
        }

        BisectionSolver solver4 = new BisectionSolver();
        try {
            double lhs = solver4.solve(f, min, max, initial);

            /*
             * Contract/metamorphic check:
             * On the same function and bracketing interval, BisectionSolver's public 4-argument API
             * must produce the same solution as its public 3-argument API; the initial guess should
             * not change the bisection result. Both sides are real library calls. If either side throws,
             * this check does not apply and we skip it.
             */
            double rhs;
            try {
                BisectionSolver solver3 = new BisectionSolver();
                rhs = solver3.solve(f, min, max);
                double tol = Math.max(solver4.getAbsoluteAccuracy(), solver3.getAbsoluteAccuracy()) + 1e-12;
                if (Double.isNaN(lhs) || Double.isInfinite(lhs) || Double.isNaN(rhs) || Double.isInfinite(rhs)
                        || Math.abs(lhs - rhs) > tol) {
                    throw new RuntimeException(
                        "metamorphic violation: 4-arg solve must agree with 3-arg solve input=["
                            + min + "," + max + "," + initial + "] lhs=" + lhs + " rhs=" + rhs);
                }
            } catch (Throwable t) {
                if (isMetamorphicViolation(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isMetamorphicViolation(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(ste.getClassName())
                    && "solve".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
