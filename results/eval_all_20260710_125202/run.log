package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.lang.annotation.Annotation;
import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Method;
import java.lang.reflect.Proxy;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            StringUtils.join((Object[]) null, ',');
            Object[] anchor = new Object[] { makeToStringObject(true, "seed") };
            callAndMaybePropagateChar(anchor, '/', 0, 1);
            callAndMaybePropagateString(anchor, "/", 0, 1);
        } catch (IllegalArgumentException e) {
            return;
        }

        int len = data.consumeInt(1, 6);
        Object[] array = new Object[len];
        boolean triggerNullToString = data.consumeBoolean();

        if (triggerNullToString) {
            array[0] = makeToStringObject(true, data.consumeAsciiString(16));
        } else {
            array[0] = makeToStringObject(false, data.consumeString(16));
        }

        for (int i = 1; i < len; i++) {
            if (data.consumeBoolean()) {
                array[i] = null;
            } else {
                array[i] = data.consumeString(16);
            }
        }

        int start = 0;
        int end = data.consumeInt(1, len);
        char sep = (char) (data.consumeByte() & 0xff);
        String sepStr = String.valueOf(sep);

        callAndMaybePropagateChar(array, sep, start, end);
        callAndMaybePropagateString(array, sepStr, start, end);

        Object[] safeArray = new Object[len];
        safeArray[0] = makeToStringObject(false, data.consumeString(16));
        for (int i = 1; i < len; i++) {
            safeArray[i] = data.consumeBoolean() ? null : data.consumeString(16);
        }

        String lhs;
        String rhs;
        try {
            lhs = StringUtils.join(safeArray, sep, 0, len);
            rhs = StringUtils.join(safeArray, sepStr, 0, len);
        } catch (RuntimeException t) {
            return;
        }

        /* Contract asserted: the char-separator and one-character String-separator overloads
           implement the same join semantics for the same array/start/end slice, so for any
           valid input they must produce identical output. A patch that merely suppresses the
           failing code path or silently changes one overload's handling of the first element
           would violate this observable equivalence. */
        if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
            throw new RuntimeException("metamorphic violation: char-vs-string separator inputLen="
                    + len + " sep=" + (int) sep + " lhs=" + lhs + " rhs=" + rhs);
        }

        try {
            String e1 = StringUtils.join(safeArray, sep, len, 0);
            String e2 = StringUtils.join(safeArray, sepStr, len, 0);
            if (!"".equals(e1) || !"".equals(e2)) {
                throw new RuntimeException("metamorphic violation: empty-slice result inputLen="
                        + len + " e1=" + e1 + " e2=" + e2);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void callAndMaybePropagateChar(Object[] array, char sep, int start, int end) {
        try {
            StringUtils.join(array, sep, start, end);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void callAndMaybePropagateString(Object[] array, String sep, int start, int end) {
        try {
            StringUtils.join(array, sep, start, end);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "join".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static Object makeToStringObject(final boolean returnNull, final String payload) {
        InvocationHandler handler = new InvocationHandler() {
            public Object invoke(Object proxy, Method method, Object[] args) {
                String name = method.getName();
                if ("toString".equals(name) && method.getParameterTypes().length == 0) {
                    if (returnNull) {
                        return BooleanUtils.toString((Boolean) null, "true", "false", null);
                    }
                    return ArrayUtils.toString(new Object[] { payload }, "");
                }
                if ("annotationType".equals(name)) {
                    return Deprecated.class;
                }
                if ("hashCode".equals(name)) {
                    return Integer.valueOf(System.identityHashCode(proxy));
                }
                if ("equals".equals(name)) {
                    return Boolean.valueOf(proxy == (args == null ? null : args[0]));
                }
                return null;
            }
        };
        return Proxy.newProxyInstance(
                FuzzHarness.class.getClassLoader(),
                new Class<?>[] { Annotation.class },
                handler);
    }
}
