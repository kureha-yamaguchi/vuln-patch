        int which = data.consumeInt(0, constraints.size() - 1);
        double factor = data.consumeInt(1, 8);
        ArrayList<LinearConstraint> scaled = new ArrayList<LinearConstraint>(constraints);
        scaled.set(which, scale(constraints.get(which), factor));
        checkEquivalentOptimum(objective, constraints, scaled, nonNegative);
    }

    private static void runCase(double[] objective, Collection<LinearConstraint> constraints, boolean nonNegative) {
        try {
            optimize(objective, constraints, nonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static PointValuePair optimize(double[] objective, Collection<LinearConstraint> constraints, boolean nonNegative) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, GoalType.MINIMIZE, nonNegative);
    }

    private static void checkEquivalentOptimum(double[] objective,
                                               Collection<LinearConstraint> original,
                                               Collection<LinearConstraint> scaled,
                                               boolean nonNegative) {
        PointValuePair lhs;
        PointValuePair rhs;
        try {
            lhs = optimize(objective, original, nonNegative);
        } catch (Throwable t) {
            return;
        }
        try {
            rhs = optimize(objective, scaled, nonNegative);
        } catch (Throwable t) {
            return;
        }
        if (lhs == null || rhs == null) {
            return;
        }
        double lv = lhs.getValue();
        double rv = rhs.getValue();
        if (Double.isNaN(lv) || Double.isNaN(rv) || Double.isInfinite(lv) || Double.isInfinite(rv)) {
            return;
        }
        if (Math.abs(lv - rv) > 1.0e-7 * Math.max(1.0, Math.max(Math.abs(lv), Math.abs(rv)))) {
            throw new RuntimeException(
                "metamorphic violation: positive scaling of one constraint changed optimum"
                    + " lhs=" + lv + " rhs=" + rv
                    + " nonNegative=" + nonNegative
                    + " vars=" + objective.length
                    + " constraints=" + original.size());
        }
    }

    private static LinearConstraint scale(LinearConstraint c, double factor) {
        double[] a = c.getCoefficients().toArray();
        for (int i = 0; i < a.length; i++) {
            a[i] *= factor;
        }
        return new LinearConstraint(a, c.getRelationship(), c.getValue() * factor);
    }

    private static boolean reachesPatchedShape(double[] objective,
                                               Collection<LinearConstraint> constraints,
                                               boolean nonNegative) {
        try {
            LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MINIMIZE, nonNegative, 1.0e-6);
            if (tableau.getNumArtificialVariables() <= 0) {
                return false;
            }
            int startRow = tableau.getNumObjectiveFunctions();
            int height = tableau.getHeight();
            int width = tableau.getWidth();
            if (height - startRow < 2 || width < 2) {
                return false;
            }

            for (int col = 0; col < width - 1; col++) {
                List<Integer> minRows = new ArrayList<Integer>();
                double minRatio = Double.MAX_VALUE;
                for (int row = startRow; row < height; row++) {
                    double rhs = tableau.getEntry(row, width - 1);
                    double entry = tableau.getEntry(row, col);
                    if (org.apache.commons.math3.util.Precision.compareTo(entry, 0d, 10) > 0) {
                        double ratio = rhs / entry;
                        int cmp = Double.compare(ratio, minRatio);
                        if (cmp == 0) {
                            minRows.add(Integer.valueOf(row));
                        } else if (cmp < 0) {
                            minRatio = ratio;
                            minRows.clear();
                            minRows.add(Integer.valueOf(row));
                        }
                    }
                }

                if (minRows.size() > 1) {
                    for (Integer row : minRows) {
                        for (int i = 0; i < tableau.getNumArtificialVariables(); i++) {
                            int artificialCol = i + tableau.getArtificialVariableOffset();
                            double entry = tableau.getEntry(row.intValue(), artificialCol);
                            Integer basic = tableau.getBasicRow(artificialCol);
