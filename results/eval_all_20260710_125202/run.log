package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testOne("\uD83D\uDE30", true);
        testOne("\uD800\uDC00", true);
        testOne("\uD834\uDD1E", true);
        testOne("\uDBFF\uDFFD", true);

        String fuzzed = buildSafeSupplementaryInput(data);
        testOne(fuzzed, true);
    }

    private static void testOne(String input, boolean assertIdentityContract) {
        String escaped = escapeCsvSwallowingNonRootCause(input);
        if (escaped == null) {
            return;
        }

        if (assertIdentityContract) {
            /*
             * Contract asserted: for CSV escaping, an input containing none of the CSV-special
             * characters comma, quote, CR, or LF does not need escaping and is returned unchanged.
             * The failing regression test demonstrates this for surrogate-pair inputs. A patch that
             * merely suppresses the crash or skips bookkeeping can silently drop/duplicate characters,
             * violating this observable identity guarantee.
             */
            if (!input.equals(escaped)) {
                throw new RuntimeException(
                    "metamorphic violation: escapeCsv identity on CSV-safe input input=" + printable(input)
                        + " lhs=" + printable(escaped) + " rhs=" + printable(input));
            }
        }
    }

    private static String escapeCsvSwallowingNonRootCause(String input) {
        try {
            return org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
        } catch (Throwable t) {
            if (isValidationThrowable(t)) {
                return null;
            }
            if (isRootCause(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
            return null;
        }
    }

    private static boolean isValidationThrowable(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Validation")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildSafeSupplementaryInput(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        int codePointCount = data.consumeInt(1, 4);
        int asciiSegments = codePointCount + data.consumeInt(0, 3);

        for (int i = 0; i < asciiSegments; i++) {
            sb.append(sanitizeAscii(data.consumeAsciiString(12)));
            if (i < codePointCount) {
                int cp = data.consumeInt(0x10000, 0x10FFFF);
                sb.append(Character.toChars(cp));
            }
        }

        if (sb.length() == 0) {
            sb.append("A").append(Character.toChars(0x1F630)).append("B");
        }

        return sb.toString();
    }

    private static String sanitizeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                sb.append('A');
            } else {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (Character.isISOControl(ch) || Character.isSurrogate(ch)) {
                        sb.append(String.format("\\u%04X", (int) ch));
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
