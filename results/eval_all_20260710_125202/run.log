                        "metamorphic violation: same-gap ranges disagree on itemCount"
                        + " range1=[" + startOrd + "," + endOrd + "]"
                        + " range2=[" + startOrd2 + "," + endOrd2 + "]"
                        + " count1=" + copyA.getItemCount()
                        + " count2=" + copyB.getItemCount());
                }
                if (copyA.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: same-gap ranges should both be empty"
                        + " range1=[" + startOrd + "," + endOrd + "]"
                        + " range2=[" + startOrd2 + "," + endOrd2 + "]"
                        + " count=" + copyA.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
