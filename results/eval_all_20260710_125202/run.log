        try {
            double anchorX = normal.inverseCumulativeProbability(anchorP);
            try {
                double roundTripP = normal.cumulativeProbability(anchorX);
                if (Double.isFinite(anchorX) && Double.isFinite(roundTripP)
                        && Math.abs(roundTripP - anchorP) > 1.0e-12) {
