package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryTarget("off");

        String seed = data.consumeString(32);
        tryTarget(seed);

        String ascii = data.consumeAsciiString(32);
        tryTarget(ascii);

        String remaining = data.consumeRemainingAsString();
        tryTarget(remaining);

        // Explore the root-cause shape: short strings, especially length 3/4, should be handled
        // cleanly by BooleanUtils.toBoolean without indexing past the string bounds.
        int len = data.consumeInt(0, 8);
        String shaped = buildShapedInput(data, len);
        tryTarget(shaped);

        // Also exercise nearby literals and surrounding-content variants to avoid overfitting.
        tryTarget(mutateAroundTrigger(data, "off"));
        tryTarget(mutateAroundTrigger(data, "oof"));
        tryTarget(mutateAroundTrigger(data, "yep"));
        tryTarget(mutateAroundTrigger(data, "tru"));
        tryTarget(mutateAroundTrigger(data, "yes?"));

        // Metamorphic/post-condition:
        // The implementation shown is explicitly case-insensitive for the accepted true tokens:
        // "on", "yes", and "true" all return true for any mixture of letter case.
        // A patch that merely suppresses the crash or disables a branch could silently return the
        // wrong boolean for some case variants. For any token we construct from a known true token,
        // all case variants must still map to the same result via the real API.
        checkCaseInsensitiveTrueToken(data);
    }

    private static void tryTarget(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildShapedInput(FuzzedDataProvider data, int len) {
        if (len <= 0) {
            return "";
        }
        String alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!?_- ";
        StringBuilder sb = new StringBuilder(len);

        int mode = data.consumeInt(0, 5);
        if (mode == 0 && len >= 1) {
            sb.append('o');
        } else if (mode == 1 && len >= 1) {
            sb.append('y');
        } else if (mode == 2 && len >= 1) {
            sb.append('Y');
        } else if (mode == 3 && len >= 1) {
            sb.append('t');
        } else if (mode == 4 && len >= 1) {
            sb.append('T');
        } else if (len >= 1) {
            sb.append((char) ('a' + Math.abs(data.consumeByte()) % 26));
        }

        while (sb.length() < len) {
            int idx = data.consumeInt(0, alphabet.length() - 1);
            sb.append(alphabet.charAt(idx));
        }
        return sb.toString();
    }

    private static String mutateAroundTrigger(FuzzedDataProvider data, String base) {
        int mode = data.consumeInt(0, 5);
        if (mode == 0) {
            return base;
        }
        if (mode == 1) {
            return data.consumeAsciiString(3) + base;
        }
        if (mode == 2) {
            return base + data.consumeAsciiString(3);
        }
        if (mode == 3) {
            if (base.length() == 0) {
                return base;
            }
            int pos = data.consumeInt(0, base.length() - 1);
            char c = (char) ('a' + Math.abs(data.consumeByte()) % 26);
            return base.substring(0, pos) + c + base.substring(pos + 1);
        }
        if (mode == 4) {
            return data.consumeAsciiString(1) + base + data.consumeAsciiString(1);
        }
        return data.consumeAsciiString(8);
    }

    private static void checkCaseInsensitiveTrueToken(FuzzedDataProvider data) {
        String canonical;
        int pick = data.consumeInt(0, 2);
        if (pick == 0) {
            canonical = "true";
        } else if (pick == 1) {
            canonical = "yes";
        } else {
            canonical = "on";
        }

        String variant = randomCase(data, canonical);
        String upper = canonical.toUpperCase();
        String lower = canonical.toLowerCase();

        Boolean lhs;
        Boolean rhs;
        Boolean rhs2;
        try {
            lhs = Boolean.valueOf(BooleanUtils.toBoolean(variant));
            rhs = Boolean.valueOf(BooleanUtils.toBoolean(upper));
            rhs2 = Boolean.valueOf(BooleanUtils.toBoolean(lower));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        if (!lhs.equals(rhs) || !lhs.equals(rhs2) || !lhs.booleanValue()) {
            throw new RuntimeException(
                    "metamorphic violation: case-insensitive true token input="
                            + variant + " upper=" + upper + " lower=" + lower
                            + " lhs=" + lhs + " rhsUpper=" + rhs + " rhsLower=" + rhs2);
        }
    }

    private static String randomCase(FuzzedDataProvider data, String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(Character.toLowerCase(ch));
            }
        }
        return sb.toString();
    }
}
