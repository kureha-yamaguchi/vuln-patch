            source = prefix + source;
        }
        if (data.consumeBoolean() && source.length() > 1) {
            source = source + prefix;
        }

        int width;
        if (source.length() > 0) {
            width = data.consumeInt(1, source.length());
        } else {
            width = data.consumeInt(-4, 4);
        }

        if (source.length() > 1 && data.consumeBoolean()) {
            width = data.consumeInt(1, source.length() - 1);
        }

        try {
