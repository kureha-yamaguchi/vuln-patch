public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Graphics2D g2 = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB).createGraphics();
        try {
            anchor(g2);
            explore(g2, data);
        } finally {
            g2.dispose();
        }
    }

    private static void anchor(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.LEFT);
        container.add(new EmptyBlock(8.0, 20.0), RectangleEdge.RIGHT);

        try {
            container.arrange(g2, constraint);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void explore(Graphics2D g2, FuzzedDataProvider data) {
        double fixedWidth = positive(data.consumeInt(1, 30));
        double tall = positive(data.consumeInt(1, 60));
        double shortH = positive(data.consumeInt(1, 60));
        double oversize = fixedWidth + positive(data.consumeInt(1, 30));
        double otherWidth = positive(data.consumeInt(1, 30));
        boolean addCenter = data.consumeBoolean();
        boolean addTop = data.consumeBoolean();
        boolean addBottom = data.consumeBoolean();

        RectangleConstraint constraint = new RectangleConstraint(
                fixedWidth, new Range(fixedWidth, fixedWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        // Crash exploration: valid-by-construction inputs with LEFT wider than the fixed width
        // and a RIGHT block present drive arrangeFN -> arrangeFF through the real public API.
        BlockContainer crashContainer = new BlockContainer(new BorderArrangement());
        crashContainer.add(new EmptyBlock(oversize, tall), RectangleEdge.LEFT);
        crashContainer.add(new EmptyBlock(otherWidth, shortH), RectangleEdge.RIGHT);
        if (addCenter) {
            crashContainer.add(new EmptyBlock(positive(data.consumeInt(1, 30)), positive(data.consumeInt(1, 60))));
        }
        if (addTop) {
            crashContainer.add(new EmptyBlock(positive(data.consumeInt(1, 30)), positive(data.consumeInt(1, 20))), RectangleEdge.TOP);
        }
        if (addBottom) {
            crashContainer.add(new EmptyBlock(positive(data.consumeInt(1, 30)), positive(data.consumeInt(1, 20))), RectangleEdge.BOTTOM);
        }
        try {
            crashContainer.arrange(g2, constraint);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // Metamorphic check:
        // BorderArrangement treats LEFT and RIGHT symmetrically in arrangeFF: both branches
        // arrange the side block under the same height and a width range, then setBounds().
        // Therefore, for containers differing only by placing the same block on LEFT vs RIGHT,
        // a correct implementation must return the same overall Size2D and assign equal bounds
        // extents to that single side block. A throw-deleting patch that nulls leftBlock makes
        // the LEFT variant silently skip arrange/setBounds, violating this observable symmetry.
        EmptyBlock leftBlock = new EmptyBlock(oversize, tall);
        BlockContainer leftContainer = new BlockContainer(new BorderArrangement());
        leftContainer.add(leftBlock, RectangleEdge.LEFT);
        if (addCenter) {
            leftContainer.add(new EmptyBlock(positive(data.consumeInt(1, 30)), positive(data.consumeInt(1, 60))));
        }

        EmptyBlock rightBlock = new EmptyBlock(oversize, tall);
        BlockContainer rightContainer = new BlockContainer(new BorderArrangement());
        rightContainer.add(rightBlock, RectangleEdge.RIGHT);
        if (addCenter) {
            rightContainer.add(new EmptyBlock(positive(data.consumeInt(1, 30)), positive(data.consumeInt(1, 60))));
        }

        Size2D leftSize;
        Size2D rightSize;
        try {
            leftSize = leftContainer.arrange(g2, constraint);
            rightSize = rightContainer.arrange(g2, constraint);
        } catch (Throwable t) {
            return;
        }

        Rectangle2D lb = leftBlock.getBounds();
        Rectangle2D rb = rightBlock.getBounds();
        if (lb == null || rb == null) {
            return;
        }

        if (!same(leftSize.getWidth(), rightSize.getWidth())
                || !same(leftSize.getHeight(), rightSize.getHeight())
                || !same(lb.getWidth(), rb.getWidth())
                || !same(lb.getHeight(), rb.getHeight())
                || lb.getWidth() <= 0.0
                || lb.getHeight() <= 0.0) {
            throw new RuntimeException(
                    "metamorphic violation: left/right symmetry"
                            + " input={fixedWidth=" + fixedWidth
                            + ", leftWidth=" + oversize
                            + ", leftHeight=" + tall
                            + ", center=" + addCenter
                            + ", top=" + addTop
                            + ", bottom=" + addBottom
                            + "} lhs=size(" + leftSize.getWidth() + "," + leftSize.getHeight()
                            + ") bounds(" + lb.getX() + "," + lb.getY() + "," + lb.getWidth() + "," + lb.getHeight()
                            + ") rhs=size(" + rightSize.getWidth() + "," + rightSize.getHeight()
                            + ") bounds(" + rb.getX() + "," + rb.getY() + "," + rb.getWidth() + "," + rb.getHeight()
                            + ")");
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                    && ("arrangeFF".equals(method)
                    || "arrangeFN".equals(method)
                    || "arrange".equals(method))) {
                return true;
            }
            if ("org.jfree.data.Range".equals(cls) && "<init>".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static double positive(int v) {
        return Math.abs((double) v) + 1.0;
    }

    private static boolean same(double a, double b) {
        return Math.abs(a - b) <= 0.0000001;
    }
}
