package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeEscapeCsv("\uD83D\uDE30", true);
        invokeEscapeCsv("\uD800\uDC00", true);
        invokeEscapeCsv("\uD834\uDD1E", true);
        invokeEscapeCsv("\uDBFF\uDFFD", true);

        String prefix = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 16)));
        String suffix = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 16)));
        int pairCount = data.consumeInt(1, 4);

        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        for (int i = 0; i < pairCount; i++) {
            int codePoint = nextSupplementaryCodePoint(data);
            sb.append(Character.toChars(codePoint));
            if (data.consumeBoolean()) {
                sb.append(sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 8))));
            }
        }
        sb.append(suffix);

        String constructed = sb.toString();
        invokeEscapeCsv(constructed, true);

        if (data.consumeBoolean()) {
            String left = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 12)))
                    + new String(Character.toChars(nextSupplementaryCodePoint(data)));
            String right = sanitizeCsvSafeAscii(data.consumeAsciiString(data.consumeInt(0, 12)))
                    + new String(Character.toChars(nextSupplementaryCodePoint(data)));

            try {
                String whole = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(left + right);
                String parts = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(left)
                        + org.apache.commons.lang3.StringEscapeUtils.escapeCsv(right);
                /*
                 * Contract used: CSV escaping only adds quoting/quote-doubling when the input
                 * contains ',', '"', '\r', or '\n'. For inputs constructed here, neither side
                 * contains any CSV-special character, so each escapeCsv call must return its
                 * argument unchanged. Therefore escapeCsv(left + right) == escapeCsv(left) +
                 * escapeCsv(right) == left + right. A patch that merely avoids the exception by
                 * skipping output or mis-advancing would violate this observable result.
                 */
                if (!whole.equals(parts)) {
                    throw new RuntimeException(
                            "metamorphic violation: composition on CSV-safe input left=" + left
                                    + " right=" + right + " lhs=" + whole + " rhs=" + parts);
                }
            } catch (Throwable t) {
                if (isMetamorphicViolation(t)) {
                    throw (RuntimeException) t;
                }
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCause(t)) {
                    rethrowUnchecked(t);
                }
            }
        }
    }

    private static void invokeEscapeCsv(String input, boolean assertIdentity) {
        try {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(input);
            /*
             * Contract used: StringEscapeUtilsTest.testEscapeSurrogatePairs asserts that
             * escapeCsv returns the original string for surrogate-pair-only inputs. More
             * generally, when no CSV-special characters (comma, quote, CR, LF) are present,
             * CSV escaping must leave the string unchanged. Our generated inputs are built to
             * satisfy that precondition, so equality is required for every correct
             * implementation. A throw-deleting or branch-skipping patch would break this.
             */
            if (assertIdentity && !input.equals(escaped)) {
                throw new RuntimeException(
                        "metamorphic violation: escapeCsv identity on CSV-safe input input="
                                + input + " lhs=" + escaped + " rhs=" + input);
            }
        } catch (Throwable t) {
            if (isMetamorphicViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
        }
    }

    private static String sanitizeCsvSafeAscii(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else if (c < 0x20 || c > 0x7e) {
                sb.append('B');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static int nextSupplementaryCodePoint(FuzzedDataProvider data) {
        int cp = data.consumeInt(0x10000, 0x10FFFF);
        if (!Character.isValidCodePoint(cp) || cp < 0x10000) {
            return 0x10000;
        }
        return cp;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement frame : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(frame.getClassName())
                    && "translate".equals(frame.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(frame.getClassName())
                    && "translate".equals(frame.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(frame.getClassName())
                    && "translate".equals(frame.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(frame.getClassName())
                    && "translate".equals(frame.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
                && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:");
    }

    private static void rethrowUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
    }
}
