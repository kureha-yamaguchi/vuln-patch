         * h[0] == 0 and h[2] == fixed constraint height, so after a successful
         * arrange the left block's bounds must reflect the real arranged size
         * computed by left.arrange(...) under the same RectangleConstraint.
         * A patch that silently drops leftBlock bookkeeping breaks this
         * observable post-condition even if no exception is thrown.
         */
        if (!approximately(actualBounds.getX(), 0.0)
                || !approximately(actualBounds.getY(), 0.0)
                || !approximately(actualBounds.getWidth(), expectedLeft.getWidth())
                || !approximately(actualBounds.getHeight(), constraintHeight)) {
            throw new RuntimeException("metamorphic violation: left bounds after arrangeFF input="
                    + describe(constraintWidth, constraintHeight, leftWidth, leftHeight)
                    + " expectedBounds=[0.0,0.0," + expectedLeft.getWidth() + "," + constraintHeight + "]"
                    + " actualBounds=[" + actualBounds.getX() + "," + actualBounds.getY() + ","
                    + actualBounds.getWidth() + "," + actualBounds.getHeight() + "]"
                    + " containerSize=[" + arrangedSize.getWidth() + "," + arrangedSize.getHeight() + "]");
        }
    }

