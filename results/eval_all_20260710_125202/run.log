public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            tryCreateNumber(anchors[i], false);
        }

        String singleCharCandidate;
        switch (data.consumeInt(0, 7)) {
            case 0:
                singleCharCandidate = "l";
                break;
            case 1:
                singleCharCandidate = "L";
                break;
            case 2:
                singleCharCandidate = "f";
                break;
            case 3:
                singleCharCandidate = "F";
                break;
            case 4:
                singleCharCandidate = "d";
                break;
            case 5:
                singleCharCandidate = "D";
                break;
            case 6:
                String s = data.consumeAsciiString(1);
                singleCharCandidate = s.length() == 0 ? "l" : s.substring(0, 1);
                break;
            default:
                String s2 = data.consumeString(1);
                singleCharCandidate = s2.length() == 0 ? "L" : s2.substring(0, 1);
                break;
        }
        tryCreateNumber(singleCharCandidate, false);

        String raw = data.consumeAsciiString(40);
        String digits = decimalDigitsOnly(raw, false);
        String signedDigits = decimalDigitsOnly(raw, true);
        String exp = decimalDigitsOnly(data.consumeAsciiString(8), true);

        if (digits.length() == 0) {
            digits = "0";
        }
        if (signedDigits.length() == 0 || "-".equals(signedDigits) || "+".equals(signedDigits)) {
            signedDigits = Integer.toString(data.consumeInt());
        }
        if (exp.length() == 0 || "-".equals(exp) || "+".equals(exp)) {
            exp = "0";
        }

        String hugeDigits = digits + digits + digits + digits;
        if (hugeDigits.length() == 0) {
            hugeDigits = "12345678901234567890";
        }

        String[] explore = new String[] {
                raw,
                signedDigits + "l",
                signedDigits + "L",
                hugeDigits + "l",
                hugeDigits + "L",
                signedDigits + "." + digits + "f",
                signedDigits + "." + digits + "F",
                signedDigits + "." + digits + "d",
                signedDigits + "." + digits + "D",
                signedDigits + "." + digits + "E" + exp + "f",
                signedDigits + "." + digits + "E" + exp + "D",
                "0x" + hexDigitsOnly(data.consumeAsciiString(16)),
                "-0x" + hexDigitsOnly(data.consumeAsciiString(16)),
                data.consumeRemainingAsString()
        };

        for (int i = 0; i < explore.length; i++) {
            tryCreateNumber(explore[i], false);
        }

        int n = data.consumeInt();
        String canonical = Integer.toString(n);

        /*
         * Contract asserted:
         * Commons Lang tests document that createNumber accepts integral decimal
         * strings with either 'l' or 'L' suffix (e.g. "12345L", "12345l",
         * "-1l", "01l"). For a canonical decimal int string, both suffix variants
         * must therefore be accepted and denote the same numeric value.
         * A throw-deleting or over-broad guard patch that makes the buggy branch
         * unreachable, or that silently changes which path is taken, can violate
         * acceptance, type, or value here even if no exception is thrown on the
         * original crashing seed.
         */
        assertCanonicalLongParses(canonical, "l", n);
        assertCanonicalLongParses(canonical, "L", n);

        try {
            Number lower = NumberUtils.createNumber(canonical + "l");
            Number upper = NumberUtils.createNumber(canonical + "L");
            if (lower == null || upper == null
                    || !lower.getClass().equals(upper.getClass())
                    || lower.longValue() != upper.longValue()
                    || lower.longValue() != (long) n) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + canonical
                                + " lhs=" + describe(lower) + " rhs=" + describe(upper));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                return;
            }
            throw t;
        }
    }
