    private static void runExplorePostcondition(FuzzedDataProvider data, Graphics2D g2) {
        double width = positiveTenths(data, 1, 300);
        double totalHeight = positiveTenths(data, 2, 300);
        double topHeight = positiveTenths(data, 0, Math.max(0, (int) Math.floor(totalHeight * 10.0) - 1));
        double bottomHeight = positiveTenths(data, 1, Math.max(1, (int) Math.floor((totalHeight - topHeight) * 10.0)));

        EmptyBlock top = new EmptyBlock(positiveTenths(data, 1, 300), topHeight);
        EmptyBlock bottom = new EmptyBlock(positiveTenths(data, 1, 300), bottomHeight);

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(top, RectangleEdge.TOP);
        container.add(bottom, RectangleEdge.BOTTOM);

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 120), positiveTenths(data, 1, 120)),
                    RectangleEdge.LEFT);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 120), positiveTenths(data, 1, 120)),
                    RectangleEdge.RIGHT);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 120), positiveTenths(data, 1, 120)));
        }

