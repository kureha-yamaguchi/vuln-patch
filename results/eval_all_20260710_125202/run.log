package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.optimization.GoalType;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCase(1.0, 1.0, false);
        exerciseCase(1.0, 1.0, true);

        double coeff = 1.0 + data.consumeInt(0, 50);
        double rhs = 1.0 + data.consumeInt(0, 50);
        boolean geqFirst = data.consumeBoolean();
        exerciseCase(coeff, rhs, geqFirst);

        if (data.remainingBytes() > 0) {
            double coeff2 = 1.0 + data.consumeInt(0, 200);
            double rhs2 = 1.0 + data.consumeInt(0, 200);
            exerciseCase(coeff2, rhs2, !geqFirst);
        }
    }

    private static void exerciseCase(double coeff, double rhs, boolean geqFirst) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0 }, 0.0);
        Collection<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        LinearConstraint leq = new LinearConstraint(new double[] { coeff }, Relationship.LEQ, rhs);
        LinearConstraint geq = new LinearConstraint(new double[] { coeff }, Relationship.GEQ, rhs);

        if (geqFirst) {
            constraints.add(geq);
            constraints.add(leq);
        } else {
            constraints.add(leq);
            constraints.add(geq);
        }

        SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, true, 1.0e-6, 10);

        if (tableau.getNumArtificialVariables() <= 0) {
            return;
        }

        int numObj = tableau.getNumObjectiveFunctions();
        if (tableau.getHeight() < numObj + 2) {
            return;
        }

        int xCol = numObj;
        int rhsCol = tableau.getWidth() - 1;
        int rowA = numObj;
        int rowB = numObj + 1;

        double phase1Coeff = tableau.getEntry(0, xCol);
        double eA = tableau.getEntry(rowA, xCol);
        double eB = tableau.getEntry(rowB, xCol);
        double rhsA = tableau.getEntry(rowA, rhsCol);
        double rhsB = tableau.getEntry(rowB, rhsCol);

        if (!(phase1Coeff < 0.0 && eA > 0.0 && eB > 0.0)) {
            return;
        }

        double ratioA = rhsA / eA;
        double ratioB = rhsB / eB;
        if (Double.compare(ratioA, ratioB) != 0) {
            return;
        }

        int artCol = tableau.getArtificialVariableOffset();
        Integer artRowBefore = tableau.getBasicRow(artCol);
        if (artRowBefore == null) {
            return;
        }

        int basicA = basicColumnForRow(tableau, rowA);
        int basicB = basicColumnForRow(tableau, rowB);
        if (basicA < 0 || basicB < 0) {
            return;
        }

        int blandRow = basicA < basicB ? rowA : rowB;
        int artificialRow = artRowBefore.intValue();

        if (blandRow == artificialRow) {
            return;
        }

        SimplexSolver solver = new SimplexSolver();
        solver.doIteration(tableau);

        Integer artRowAfter = tableau.getBasicRow(artCol);

        /*
         * Contract asserted from the code comment in getPivotRow:
         * on a tie in the minimum ratio test, the solver must apply Bland's rule
         * and choose the row whose basic variable has the smallest index.
         *
         * For the tableau built here, one tied row is basic in a slack variable and
         * the other is basic in an artificial variable, so Bland's rule must choose
         * the slack-basic row. Therefore the artificial variable must still be basic
         * after exactly one iteration. If it has left the basis, getPivotRow chose
         * the artificial row instead of the Bland row, i.e. the buggy behavior.
         */
        if (artRowAfter == null) {
            throw new RuntimeException(
                    "Bland tie-break violated: artificial variable was forced out of the basis"
                            + " coeff=" + coeff
                            + " rhs=" + rhs
                            + " geqFirst=" + geqFirst
                            + " artRowBefore=" + artificialRow
                            + " blandRow=" + blandRow);
        }
    }

    private static int basicColumnForRow(SimplexTableau tableau, int row) {
        for (int col = 0; col < tableau.getWidth() - 1; col++) {
            Integer basicRow = tableau.getBasicRow(col);
            if (basicRow != null && basicRow.intValue() == row) {
                return col;
            }
        }
        return -1;
    }
}
