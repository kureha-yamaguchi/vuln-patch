private static void exerciseToClass(Object[] array) {
        final Class<?>[] classes;
        try {
            classes = ClassUtils.toClass(array);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            if (isCleanRejection(e)) {
                return;
            }
            return;
        }

        if (classes == null || classes.length != array.length) {
            throw new RuntimeException("metamorphic violation: result shape mismatch inputLength="
                    + array.length + " resultLength=" + (classes == null ? -1 : classes.length));
        }

        for (int i = 0; i < array.length; i++) {
            Class<?> expected = array[i] == null ? null : array[i].getClass();
            if (classes[i] != expected) {
                throw new RuntimeException("metamorphic violation: element mapping mismatch at index="
                        + i + " input=" + String.valueOf(array[i]) + " expected=" + expected + " actual=" + classes[i]);
            }
        }

        // Contract visible from the test and implementation: toClass maps each element independently to
        // element.getClass(), preserving nulls and array length. Therefore cloning the input array must not
        // change the result; a patch that merely suppresses work or skips elements would violate this.
        try {
            Class<?>[] clonedResult = ClassUtils.toClass(ArrayUtils.clone(array));
            if (!java.util.Arrays.equals(classes, clonedResult)) {
                throw new RuntimeException("metamorphic violation: toClass(array) != toClass(clone(array)) lhs="
                        + java.util.Arrays.toString(classes) + " rhs=" + java.util.Arrays.toString(clonedResult));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }
