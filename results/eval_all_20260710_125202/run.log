package org.joda.time.format;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;
import org.joda.time.DateTimeZone;
import org.joda.time.MutableDateTime;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeFormatter formatter = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

        // Contract asserted below:
        // parseInto parses fields from the text into the supplied instant, preserving the
        // instant's untouched fields (time-of-day and zone), and returns the new parse position.
        // For valid-by-construction inputs "2 29"/"02 29" in leap year 2004, a correct
        // implementation must accept them and set month/day to Feb 29. A throw-deleting or
        // bookkeeping-skipping patch would violate either the returned position or the resulting
        // instant state, which we check observably after the call.

        // ANCHOR: exact failing inputs first.
        checkPreservesFields(
                formatter,
                new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, DateTimeZone.forID("America/New_York")),
                "2 29",
                0,
                2004,
                2,
                29);
        checkPreservesFields(
                formatter,
                new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, DateTimeZone.forID("Asia/Tokyo")),
                "2 29",
                0,
                2004,
                2,
                29);

        if (data.remainingBytes() == 0) {
            return;
        }

        DateTimeZone[] zones = new DateTimeZone[] {
                DateTimeZone.forID("America/New_York"),
                DateTimeZone.forID("Asia/Tokyo"),
                DateTimeZone.UTC,
                DateTimeZone.forID("Europe/London"),
                DateTimeZone.forID("Pacific/Auckland")
        };
        DateTimeZone zone = zones[data.consumeInt(0, zones.length - 1)];

        boolean startOfYear = data.consumeBoolean();
        int hour = data.consumeInt(0, 23);
        int minute = data.consumeInt(0, 59);
        int second = data.consumeInt(0, 59);
        int millis = data.consumeInt(0, 999);

        MutableDateTime base = startOfYear
                ? new MutableDateTime(2004, 1, 1, hour, minute, second, millis, zone)
                : new MutableDateTime(2004, 12, 31, hour, minute, second, millis, zone);

        String monthToken = data.consumeBoolean() ? "2" : "02";
        String dayToken = data.consumeBoolean() ? "29" : "029";
        String parsedCore = monthToken + " " + dayToken;

        String prefix = data.consumeAsciiString(8);
        String suffix = data.consumeAsciiString(8);
        String whole = prefix + parsedCore + suffix;
        int position = prefix.length();

        checkPreservesFields(formatter, base, whole, position, 2004, 2, 29);
    }

    private static void checkPreservesFields(
            DateTimeFormatter formatter,
            MutableDateTime base,
            String text,
            int position,
            int expectedYear,
            int expectedMonth,
            int expectedDay) {
        MutableDateTime actual = base.copy();
        final int expectedPos = position + parsedLength(text, position);

        try {
            int newPos = formatter.parseInto(actual, text, position);
            if (newPos != expectedPos) {
                throw new RuntimeException(
                        "metamorphic violation: parse position input=" + repr(text)
                                + " position=" + position
                                + " got=" + newPos
                                + " expected=" + expectedPos);
            }

            MutableDateTime expected = new MutableDateTime(
                    expectedYear,
                    expectedMonth,
                    expectedDay,
                    base.getHourOfDay(),
                    base.getMinuteOfHour(),
                    base.getSecondOfMinute(),
                    base.getMillisOfSecond(),
                    base.getZone());

            if (actual.getMillis() != expected.getMillis() || !sameZone(actual, expected)) {
                throw new RuntimeException(
                        "metamorphic violation: parseInto must set parsed month/day and preserve unparsed fields"
                                + " input=" + repr(text)
                                + " position=" + position
                                + " actual=" + actual
                                + " expected=" + expected);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) && !isRelevantRootCause(t)) {
                return;
            }
            if (isRelevantRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid leap-day parse rejected"
                                + " input=" + repr(text)
                                + " position=" + position
                                + " base=" + base,
                        t);
            }
            throw t;
        }
    }

    private static int parsedLength(String text, int position) {
        int i = position;
        while (i < text.length() && text.charAt(i) == '0') {
            i++;
        }
        if (i < text.length() && text.charAt(i) == '2') {
            i++;
        }
        if (i < text.length() && text.charAt(i) == ' ') {
            i++;
        }
        while (i < text.length() && text.charAt(i) == '0') {
            i++;
        }
        if (i + 1 < text.length() && text.charAt(i) == '2' && text.charAt(i + 1) == '9') {
            i += 2;
        }
        return i - position;
    }

    private static boolean sameZone(MutableDateTime a, MutableDateTime b) {
        DateTimeZone za = a.getZone();
        DateTimeZone zb = b.getZone();
        if (za == zb) {
            return true;
        }
        if (za == null || zb == null) {
            return false;
        }
        return za.getID().equals(zb.getID());
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.joda.time.") && name.contains("Illegal");
    }

    private static boolean isRelevantRootCause(Throwable t) {
        String name = t.getClass().getName();
        if (!(name.equals("org.joda.time.IllegalFieldValueException")
                || (t instanceof IllegalArgumentException)
                || (t instanceof NumberFormatException))) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if (cls.equals("org.joda.time.format.DateTimeFormatter")
                    && (method.equals("parseInto")
                    || method.equals("selectChronology")
                    || method.equals("requireParser"))) {
                return true;
            }
            if (cls.equals("org.joda.time.format.DateTimeParserBucket") && method.equals("getOffset")) {
                return true;
            }
        }
        return false;
    }

    private static String repr(String s) {
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
