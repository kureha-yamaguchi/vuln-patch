public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String trigger;
        switch (data.consumeInt(0, 5)) {
            case 0:
                trigger = "l";
                break;
            case 1:
                trigger = "L";
                break;
            case 2:
                trigger = data.consumeBoolean() ? "l" : "L";
                break;
            case 3:
                String one = data.consumeAsciiString(1);
                trigger = one.length() == 0 ? "l" : one.substring(0, 1);
                if (!"l".equals(trigger) && !"L".equals(trigger)) {
                    trigger = data.consumeBoolean() ? "l" : "L";
                }
                break;
            case 4:
                String two = data.consumeString(1);
                trigger = two.length() == 0 ? "L" : two.substring(0, 1);
                if (!"l".equals(trigger) && !"L".equals(trigger)) {
                    trigger = data.consumeBoolean() ? "l" : "L";
                }
                break;
            default:
                trigger = data.consumeBoolean() ? "l" : "L";
                break;
        }

        NumberUtils.createNumber(trigger);

        String core = Integer.toString(data.consumeInt());
        Number lower = NumberUtils.createNumber(core + "l");
        Number upper = NumberUtils.createNumber(core + "L");

        /*
         * Contract/metamorphic check:
         * Commons Lang tests document that both "12345L" and "12345l" are valid and
         * produce the same Long value. For any canonical decimal integer string core,
         * appending 'l' or 'L' must therefore yield equivalent results.
         */
        if (lower == null || upper == null
                || !lower.getClass().equals(upper.getClass())
                || lower.longValue() != upper.longValue()
                || lower.longValue() != Integer.parseInt(core)) {
            throw new RuntimeException(
                    "metamorphic violation: createNumber(core+'l') != createNumber(core+'L') core="
                            + core + " lhs=" + describe(lower) + " rhs=" + describe(upper));
        }
    }
