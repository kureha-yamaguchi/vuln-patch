package org.jfree.chart.block;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.awt.Graphics2D;
import java.awt.geom.Rectangle2D;
import java.awt.image.BufferedImage;
import org.jfree.chart.util.RectangleEdge;
import org.jfree.chart.util.Size2D;
import org.jfree.data.Range;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorVisibleTestInputs();
        anchorArrangeFFPostcondition();
        explore(data);
    }

    private static void anchorVisibleTestInputs() {
        Graphics2D g2 = newGraphics();
        try {
            RectangleConstraint constraint = new RectangleConstraint(
                    10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                    0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
            );

            BlockContainer container = new BlockContainer(new BorderArrangement());

            container.add(new EmptyBlock(5.0, 6.0));
            safeArrange(container, g2, constraint);

            container.clear();
            container.add(new EmptyBlock(15.0, 16.0));
            safeArrange(container, g2, constraint);

            container.clear();
            container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
            safeArrange(container, g2, constraint);
        } finally {
            g2.dispose();
        }
    }

    private static void anchorArrangeFFPostcondition() {
        Graphics2D g2 = newGraphics();
        try {
            EmptyBlock left = new EmptyBlock(3.0, 4.0);
            EmptyBlock center = new EmptyBlock(2.0, 2.0);
            BlockContainer container = new BlockContainer(new BorderArrangement());
            container.add(left, RectangleEdge.LEFT);
            container.add(center);

            RectangleConstraint constraint = new RectangleConstraint(10.0, 10.0);
            Size2D size = safeArrange(container, g2, constraint);
            if (size == null) {
                return;
            }

            Rectangle2D bounds = left.getBounds();
            /*
             * Contract asserted from BorderArrangement.arrangeFF shown in the patch context:
             * if this.leftBlock != null, arrangeFF must call leftBlock.setBounds(...).
             * For a positive-width EmptyBlock with positive fixed container width, the arranged
             * left width is positive, so a correct implementation must leave observable bounds
             * with positive width after arrange(). A "fix" that merely nulls/skips the left block
             * violates this post-condition without throwing.
             */
            if (bounds == null || !(bounds.getWidth() > 0.0)) {
                throw new RuntimeException(
                        "metamorphic violation: left block lost during arrangeFF anchor bounds="
                                + String.valueOf(bounds) + " size=" + size.width + "x" + size.height);
            }
        } finally {
            g2.dispose();
        }
    }

    private static void explore(FuzzedDataProvider data) {
        Graphics2D g2 = newGraphics();
        try {
            double cw = scaled(data.consumeInt(1, 200));
            double ch = scaled(data.consumeInt(1, 200));

            double leftW = scaled(data.consumeInt(1, 200));
            double leftH = scaled(data.consumeInt(1, 200));
            double centerW = scaled(data.consumeInt(1, 200));
            double centerH = scaled(data.consumeInt(1, 200));
            double rightW = scaled(data.consumeInt(1, 200));
            double rightH = scaled(data.consumeInt(1, 200));
            double topW = scaled(data.consumeInt(1, 200));
            double topH = scaled(data.consumeInt(1, 200));
            double bottomW = scaled(data.consumeInt(1, 200));
            double bottomH = scaled(data.consumeInt(1, 200));

            boolean addCenter = data.consumeBoolean();
            boolean addRight = data.consumeBoolean();
            boolean addTop = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();

            EmptyBlock left = new EmptyBlock(leftW, leftH);
            BlockContainer container = new BlockContainer(new BorderArrangement());
            container.add(left, RectangleEdge.LEFT);
            if (addCenter) {
                container.add(new EmptyBlock(centerW, centerH));
            }
            if (addRight) {
                container.add(new EmptyBlock(rightW, rightH), RectangleEdge.RIGHT);
            }
            if (addTop) {
                container.add(new EmptyBlock(topW, topH), RectangleEdge.TOP);
            }
            if (addBottom) {
                container.add(new EmptyBlock(bottomW, bottomH), RectangleEdge.BOTTOM);
            }

            RectangleConstraint ff = new RectangleConstraint(cw, ch);
            Size2D arranged = safeArrange(container, g2, ff);
            if (arranged == null) {
                return;
            }

            Rectangle2D bounds = left.getBounds();
            if (bounds == null || !(bounds.getWidth() > 0.0)) {
                throw new RuntimeException(
                        "metamorphic violation: left block bounds not set under fixed/fixed arrange "
                                + "cw=" + cw + " ch=" + ch
                                + " left=" + leftW + "x" + leftH
                                + " center=" + addCenter
                                + " right=" + addRight
                                + " top=" + addTop
                                + " bottom=" + addBottom
                                + " bounds=" + String.valueOf(bounds)
                                + " size=" + arranged.width + "x" + arranged.height);
            }

            BlockContainer twin = new BlockContainer(new BorderArrangement());
            EmptyBlock twinLeft = new EmptyBlock(leftW, leftH);
            twin.add(twinLeft, RectangleEdge.LEFT);
            if (addCenter) {
                twin.add(new EmptyBlock(centerW, centerH));
            }
            if (addRight) {
                twin.add(new EmptyBlock(rightW, rightH), RectangleEdge.RIGHT);
            }
            if (addTop) {
                twin.add(new EmptyBlock(topW, topH), RectangleEdge.TOP);
            }
            if (addBottom) {
                twin.add(new EmptyBlock(bottomW, bottomH), RectangleEdge.BOTTOM);
            }

            Size2D arrangedTwin = safeArrange(twin, g2, ff);
            if (arrangedTwin == null) {
                return;
            }
            Rectangle2D twinBounds = twinLeft.getBounds();
            if (twinBounds == null) {
                return;
            }

            if (Math.abs(bounds.getWidth() - twinBounds.getWidth()) > 0.000001
                    || Math.abs(bounds.getHeight() - twinBounds.getHeight()) > 0.000001
                    || Math.abs(bounds.getX() - twinBounds.getX()) > 0.000001
                    || Math.abs(bounds.getY() - twinBounds.getY()) > 0.000001) {
                throw new RuntimeException(
                        "metamorphic violation: equivalent containers produced different left bounds "
                                + "lhs=" + rectToString(bounds)
                                + " rhs=" + rectToString(twinBounds)
                                + " cw=" + cw + " ch=" + ch);
            }
        } finally {
            g2.dispose();
        }
    }

    private static Size2D safeArrange(BlockContainer container, Graphics2D g2, RectangleConstraint constraint) {
        try {
            return container.arrange(g2, constraint);
