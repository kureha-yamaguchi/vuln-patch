            Vector2D baryA = (Vector2D) a.getBarycenter();
            double sizeB = b.getSize();
            Vector2D baryB = (Vector2D) b.getBarycenter();

            if (Double.isFinite(sizeA) && Double.isFinite(sizeB) &&
                Double.isFinite(baryA.getX()) && Double.isFinite(baryA.getY()) &&
