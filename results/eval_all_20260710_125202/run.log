        "public void testCreateCopy2() {\n\n        TimeSeries series = new TimeSeries(\"Series\", Month.class);\n        series.add(new Month(MonthConstants.JANUARY, 2003), 45.0);\n        series.add(new Month(MonthConstants.FEBRUARY, 2003), 55.0);\n        series.add(new Month(MonthConstants.JUNE, 2003), 35.0);\n        series.add(new Month(MonthConstants.NOVEMBER, 2003), 85.0);\n        series.add(new Month(MonthConstants.DECEMBER, 2003), 75.0);\n\n        try {\n            // copy just the first item...\n            TimeSeries result1 = series.createCopy(0, 0);\n            assertEquals(new Month(1, 2003), result1.getTimePeriod(0));\n\n            // copy the first two items...\n            result1 = series.createCopy(0, 1);\n            assertEquals(new Month(2, 2003), result1.getTimePeriod(1));\n\n            // copy the middle three items...\n            result1 = series.createCopy(1, 3);\n            assertEquals(new Month(2, 2003), result1.getTimePeriod(0));\n            assertEquals(new Month(11, 2003), result1.getTimePeriod(2));\n\n            // copy the last two items...\n            result1 = series.createCopy(3, 4);\n            assertEquals(new Month(11, 2003), result1.getTimePeriod(0));\n            assertEquals(new Month(12, 2003), result1.getTimePeriod(1));\n\n            // copy the last item...\n            result1 = series.createCopy(4, 4);\n            assertEquals(new Month(12, 2003), result1.getTimePeriod(0));\n        }\n        catch (CloneNotSupportedException e) {\n            assertTrue(false);\n        }\n\n        // check negative first argument\n        boolean pass = false;\n        try {\n            /* TimeSeries result = */ series.createCopy(-1, 1);\n        }\n        catch (IllegalArgumentException e) {\n            pass = true;\n        }\n        catch (CloneNotSupportedException e) {\n            pass = false;\n        }\n        assertTrue(pass);\n\n        // check second argument less than first argument\n        pass = false;\n        try {\n            /* TimeSeries result = */ series.createCopy(1, 0);\n        }\n        catch (IllegalArgumentException e) {\n            pass = true;\n        }\n        catch (CloneNotSupportedException e) {\n            pass = false;\n        }\n        assertTrue(pass);\n\n        TimeSeries series2 = new TimeSeries(\"Series 2\");\n        try {\n            TimeSeries series3 = series2.createCopy(99, 999);\n            assertEquals(0, series3.getItemCount());\n        }\n        catch (CloneNotSupportedException e) {\n            assertTrue(false);\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (RuntimeException e) {\n            if (isOwnMetamorphicViolation(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int first = data.consumeInt(0, maxOrd - (count + 4));\n        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first - (count - 2)));\n        int second = first + initialGap;\n        ords[0] = first;\n        ords[1] = second;\n\n        int current = second;\n        for (int i = 2; i < count; i++) {\n            int remaining = count - i;\n            int maxStep = maxOrd - current - remaining;\n            if (maxStep < 1) {\n                return;\n            }\n            int step = data.consumeInt(1, Math.min(64, maxStep));\n            current += step;\n            ords[i] = current;\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < count; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), Integer.valueOf(data.consumeInt()));\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int gapIndex = findGap(ords);\n        if (gapIndex < 0) {\n            return;\n        }\n\n        int left = ords[gapIndex];\n        int right = ords[gapIndex + 1];\n        if (right - left < 2) {\n            return;\n        }\n\n        int startOrd = data.consumeInt(left + 1, right - 1);\n        int endOrd = data.consumeInt(startOrd, right - 1);\n\n        Day start = dayFromOrdinal(startOrd);\n        Day end = dayFromOrdinal(endOrd);\n\n        try {\n            series.getIndex(start);\n            series.getIndex(end);\n\n            TimeSeries copy = series.createCopy(start, end);\n            if (copy == null) {\n                throw new RuntimeException(\"metamorphic violation: null copy for gap range\");\n            }\n\n            /*\n             * Contract exercised by the patch:\n             * when start/end define a valid ordered range that lies wholly inside a gap\n             * between two existing time periods, there are no source items in that range,\n             * so the copy must be empty. A throw-deleting or wrong-bookkeeping patch can\n             * silently return a non-empty copy (for example, by delegating to the index-based\n             * overload with endIndex < startIndex), which this observable check catches.\n             */\n            if (copy.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: copy wholly inside a gap must be empty startOrd=\"\n                    + startOrd + \" endOrd=\" + endOrd + \" itemCount=\" + copy.getItemCount());\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (RuntimeException e) {\n            if (isOwnMetamorphicViolation(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        if (right - left >= 3) {\n            int startOrd2 = data.consumeInt(left + 1, right - 1);\n            int endOrd2 = data.consumeInt(startOrd2, right - 1);\n\n            Day start2 = dayFromOrdinal(startOrd2);\n            Day end2 = dayFromOrdinal(endOrd2);\n\n            try {\n                TimeSeries copyA = series.createCopy(start, end);\n                TimeSeries copyB = series.createCopy(start2, end2);\n\n                /*\n                 * Equivalent-inputs relation:\n                 * any two valid ranges chosen wholly inside the same empty gap denote the\n                 * same empty subset of the source series, so both copies must be equivalent.\n                 */\n                assertEquivalentCopies(copyA, copyB,\n                    \"same-gap ranges start1=\" + startOrd + \"..\" + endOrd\n                    + \" start2=\" + startOrd2 + \"..\" + endOrd2);\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (RuntimeException e) {\n                if (isOwnMetamorphicViolation(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            /*\n             * Equivalent-inputs relation:\n             * for existing boundaries taken directly from the series, the period-based\n             * overload and the index-based overload describe the same contiguous subsequence.\n             */\n            assertEquivalentCopies(byPeriod, byIndex, \"existing-period copy equals index copy i=\" + i + \" j=\" + j);\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        } catch (RuntimeException e) {\n            if (isOwnMetamorphicViolation(e)) {\n                throw e;\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int first = data.consumeInt(0, Math.max(0, maxOrd - (count + 3)));\n        int initialGapMax = Math.min(64, maxOrd - first - (count - 2));\n        if (initialGapMax < 2) {\n            return;\n        }\n        int initialGap = data.consumeInt(2, initialGapMax);\n        ords[0] = first;\n        ords[1] = first + initialGap;\n\n        int current = ords[1];\n        for (int i = 2; i < count; i++) {\n            int remainingAfter = count - 1 - i;\n            int maxStep = maxOrd - current - remainingAfter;\n            if (maxStep < 1) {\n                return;\n            }\n            int step = data.consumeInt(1, Math.min(64, maxStep));\n            current += step;\n            ords[i] = current;\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < ords.length; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int gapIndex = findGap(ords);\n        if (gapIndex == -1) {\n            return;\n        }\n\n        int left = ords[gapIndex];\n        int right = ords[gapIndex + 1];\n        if (right - left < 2) {\n            return;\n        }\n\n        int startOrd = data.consumeInt(left + 1, right - 1);\n        int endOrd = data.consumeInt(startOrd, right - 1);\n        Day start = dayFromOrdinal(startOrd);\n        Day end = dayFromOrdinal(endOrd);\n\n        try {\n            series.getIndex(start);\n            series.getIndex(end);\n            TimeSeries gapCopy = series.createCopy(start, end);\n\n            if (gapCopy == null) {\n                throw new RuntimeException(\"metamorphic violation: null copy for gap range startOrd=\" + startOrd + \" endOrd=\" + endOrd);\n            }\n\n            /*\n             * Contract/invariant used: createCopy(start, end) should return a series\n             * containing the items in the source series whose periods lie in [start, end].\n             * For a range wholly inside a gap between consecutive items, there are no such\n             * items, so the result must be empty. A patch that merely suppresses the throw\n             * but returns the wrong slice violates this observable post-condition.\n             */\n            if (gapCopy.getItemCount() != 0) {\n                throw new RuntimeException(\n                    \"metamorphic violation: copy wholly inside a gap must be empty\"\n                    + \" leftOrd=\" + left\n                    + \" rightOrd=\" + right\n                    + \" startOrd=\" + startOrd\n                    + \" endOrd=\" + endOrd\n                    + \" itemCount=\" + gapCopy.getItemCount());\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            return;\n        } catch (CloneNotSupportedException e) {\n            return;\n        } catch (RuntimeException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n            throw e;\n        }\n\n        if (right - left >= 3) {\n            int startOrd2 = data.consumeInt(left + 1, right - 1);\n            int endOrd2 = data.consumeInt(startOrd2, right - 1);\n            Day start2 = dayFromOrdinal(startOrd2);\n            Day end2 = dayFromOrdinal(endOrd2);\n\n            try {\n                TimeSeries copyA = series.createCopy(start, end);\n                TimeSeries copyB = series.createCopy(start2, end2);\n\n                /*\n                 * Contract/invariant used: any two ranges wholly contained in the same empty\n                 * gap select exactly the same set of source items: none. Therefore both copies\n                 * must be observably equivalent (in particular, both empty).\n                 */\n                if (copyA.getItemCount() != copyB.getItemCount()) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: same-gap ranges disagree on itemCount\"\n                        + \" range1=[\" + startOrd + \",\" + endOrd + \"]\"\n                        + \" range2=[\" + startOrd2 + \",\" + endOrd2 + \"]\"\n                        + \" count1=\" + copyA.getItemCount()\n                        + \" count2=\" + copyB.getItemCount());\n                }\n                if (copyA.getItemCount() != 0) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: same-gap ranges should both be empty\"\n                        + \" range1=[\" + startOrd + \",\" + endOrd + \"]\"\n                        + \" range2=[\" + startOrd2 + \",\" + endOrd2 + \"]\"\n                        + \" count=\" + copyA.getItemCount());\n                }\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        int beforeFirstOrd = ords[0] - 1;\n        if (beforeFirstOrd >= 0) {\n            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);\n            try {\n                series.getIndex(beforeFirst);\n                TimeSeries emptyBeforeFirst = series.createCopy(beforeFirst, beforeFirst);\n                if (emptyBeforeFirst == null) {\n                    throw new RuntimeException(\"metamorphic violation: null copy before first item\");\n                }\n                if (emptyBeforeFirst.getItemCount() != 0) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: copy before first item must be empty\"\n                        + \" beforeFirstOrd=\" + beforeFirstOrd\n                        + \" itemCount=\" + emptyBeforeFirst.getItemCount());\n                }\n            } catch (IllegalArgumentException e) {\n                if (isRootCause(e)) {\n                    throw e;\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            /*\n             * Contract/invariant used: when start and end are existing periods from indices\n             * i..j, createCopy(startPeriod, endPeriod) should select exactly the same items\n             * as createCopy(i, j). This checks that a \"fix\" did not break normal copies.\n             */\n            if (byPeriod.getItemCount() != byIndex.getItemCount()) {\n                throw new RuntimeException(\n                    \"metamorphic violation: existing-period copy != index copy itemCount\"\n                    + \" i=\" + i\n                    + \" j=\" + j\n                    + \" byPeriod=\" + byPeriod.getItemCount()\n                    + \" byIndex=\" + byIndex.getItemCount());\n            }\n            for (int k = 0; k < byPeriod.getItemCount(); k++) {\n                if (!byPeriod.getTimePeriod(k).equals(byIndex.getTimePeriod(k))) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: existing-period copy != index copy periods\"\n                        + \" i=\" + i\n                        + \" j=\" + j\n                        + \" k=\" + k\n                        + \" lhs=\" + byPeriod.getTimePeriod(k)\n                        + \" rhs=\" + byIndex.getTimePeriod(k));\n                }\n            }\n        } catch (IllegalArgumentException e) {\n            if (isRootCause(e)) {\n                throw e;\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        try {\n            runAnchor();\n        } catch (RuntimeException e) {\n            throw e;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        final int maxOrd = 28 * 12 * 40 - 1;\n\n        int count = data.consumeInt(2, 8);\n        int[] ords = new int[count];\n\n        int first = data.consumeInt(0, maxOrd - (count + 3));\n        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first - (count - 2)));\n        ords[0] = first;\n        ords[1] = first + initialGap;\n\n        int current = ords[1];\n        for (int i = 2; i < count; i++) {\n            int remaining = count - i;\n            int maxStep = maxOrd - current - remaining;\n            if (maxStep < 1) {\n                return;\n            }\n            int step = data.consumeInt(1, Math.min(64, maxStep));\n            current += step;\n            ords[i] = current;\n        }\n\n        TimeSeries series = new TimeSeries(data.consumeString(32));\n        for (int i = 0; i < count; i++) {\n            try {\n                series.add(dayFromOrdinal(ords[i]), data.consumeInt());\n            } catch (RuntimeException e) {\n                return;\n            }\n        }\n\n        if (series.getItemCount() < 2) {\n            return;\n        }\n\n        int beforeFirstOrd = ords[0] - 1;\n        if (beforeFirstOrd >= 0) {\n            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);\n            try {\n                series.getIndex(beforeFirst);\n                TimeSeries empty = series.createCopy(beforeFirst, beforeFirst);\n                if (empty == null) {\n                    throw new RuntimeException(\"metamorphic violation: clone-path copy is null\");\n                }\n                if (empty.getItemCount() != 0) {\n                    throw new RuntimeException(\"metamorphic violation: copy before first item must be empty itemCount=\" + empty.getItemCount());\n                }\n            } catch (RuntimeException e) {\n                if (isValidationFamily(e)) {\n                    return;\n                }\n                if (isRootCause(e)) {\n                    throw new RuntimeException(\"metamorphic violation: valid before-first range should clone to empty copy, but createCopy rejected it\", e);\n                }\n                return;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        int gapIndex = findGap(ords);\n        if (gapIndex == -1) {\n            return;\n        }\n\n        int left = ords[gapIndex];\n        int right = ords[gapIndex + 1];\n        if (right - left < 2) {\n            return;\n        }\n\n        int startOrd = data.consumeInt(left + 1, right - 1);\n        int endOrd = data.consumeInt(startOrd, right - 1);\n\n        Day start = dayFromOrdinal(startOrd);\n        Day end = dayFromOrdinal(endOrd);\n\n        try {\n            int startIndex = series.getIndex(start);\n            int endIndex = series.getIndex(end);\n            TimeSeries gapCopy = series.createCopy(start, end);\n\n            if (gapCopy == null) {\n                throw new RuntimeException(\"metamorphic violation: gap copy is null\");\n            }\n\n            /* Contract/invariant asserted:\n             * createCopy(start,end) should return a copy of the items in the inclusive period range.\n             * When both bounds lie strictly inside the same gap between adjacent existing periods,\n             * there are no items in that range, so every correct implementation must return an empty series.\n             * A patch that merely deletes the throw or otherwise changes bookkeeping incorrectly can return\n             * a non-empty copy, so this observable post-condition catches silent wrong answers.\n             */\n            if (startIndex < 0 && endIndex < 0 && insertionPoint(startIndex) == insertionPoint(endIndex)) {\n                if (gapCopy.getItemCount() != 0) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: copy wholly inside one gap must be empty startOrd=\" + startOrd\n                            + \" endOrd=\" + endOrd + \" itemCount=\" + gapCopy.getItemCount());\n                }\n            }\n        } catch (RuntimeException e) {\n            if (isValidationFamily(e)) {\n                if (isRootCause(e)) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: valid gap-bounded range was rejected startOrd=\" + startOrd + \" endOrd=\" + endOrd, e);\n                }\n                return;\n            }\n            throw e;\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n\n        if (right - left >= 3) {\n            int startOrd2 = data.consumeInt(left + 1, right - 1);\n            int endOrd2 = data.consumeInt(startOrd2, right - 1);\n\n            Day start2 = dayFromOrdinal(startOrd2);\n            Day end2 = dayFromOrdinal(endOrd2);\n\n            try {\n                TimeSeries copyA = series.createCopy(start, end);\n                TimeSeries copyB = series.createCopy(start2, end2);\n\n                /* Metamorphic relation asserted:\n                 * Any two ranges chosen wholly inside the same gap contain the same set of series items: none.\n                 * Therefore both copies must be observably equivalent, in particular both must have itemCount 0.\n                 */\n                if (copyA.getItemCount() != copyB.getItemCount()) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: same-gap copies disagree itemCount a=\" + copyA.getItemCount()\n                            + \" b=\" + copyB.getItemCount() + \" gap=(\" + left + \",\" + right + \")\");\n                }\n                if (copyA.getItemCount() != 0) {\n                    throw new RuntimeException(\n                        \"metamorphic violation: same-gap copies should both be empty itemCount=\" + copyA.getItemCount()\n                            + \" gap=(\" + left + \",\" + right + \")\");\n                }\n            } catch (RuntimeException e) {\n                if (isValidationFamily(e)) {\n                    if (isRootCause(e)) {\n                        throw new RuntimeException(\n                            \"metamorphic violation: valid same-gap range was rejected gap=(\" + left + \",\" + right + \")\", e);\n                    }\n                    return;\n                }\n                throw e;\n            } catch (CloneNotSupportedException e) {\n                return;\n            }\n        }\n\n        try {\n            int i = data.consumeInt(0, series.getItemCount() - 1);\n            int j = data.consumeInt(i, series.getItemCount() - 1);\n\n            RegularTimePeriod existingStart = series.getTimePeriod(i);\n            RegularTimePeriod existingEnd = series.getTimePeriod(j);\n\n            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);\n            TimeSeries byIndex = series.createCopy(i, j);\n\n            /* Metamorphic relation asserted:\n             * For bounds taken from existing items, createCopy(startPeriod,endPeriod) and createCopy(startIndex,endIndex)\n             * describe the same inclusive slice and must therefore produce equivalent copies.\n             */\n            assertEquivalent(byPeriod, byIndex, \"existing-period copy vs index copy\");\n        } catch (RuntimeException e) {\n            if (isValidationFamily(e)) {\n                if (isRootCause(e)) {\n                    throw new RuntimeException(\"metamorphic violation: existing-period slice was rejected\", e);\n                }\n                return;\n            }\n        } catch (CloneNotSupportedException e) {\n            return;\n        }\n    }",
