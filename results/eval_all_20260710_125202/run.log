            initial = min + (max - min) * (pos / 1000.0);
        }

        double lhs;
        double lhsAcc;
        try {
            BisectionSolver s1 = new BisectionSolver();
            lhs = s1.solve(f, min, max, initial);
            lhsAcc = s1.getAbsoluteAccuracy();
        } catch (Throwable t) {
