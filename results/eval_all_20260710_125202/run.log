package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract asserted:
         * NumberUtils.createNumber is the public parser API. Malformed inputs such as bare
         * type suffixes ("l", "L", "f", "F") must be rejected cleanly, not crash with an
         * internal StringIndexOutOfBoundsException while examining the numeric part.
         *
         * Metamorphic relation asserted for valid-by-construction inputs:
         * Commons Lang tests document that integral decimal strings with either 'l' or 'L'
         * suffix are accepted and denote the same numeric value. Therefore, for a canonical
         * decimal int string n built by this harness, createNumber(n+"l") and
         * createNumber(n+"L") must both succeed and produce the same numeric result equal to n.
         * A throw-deleting or branch-skipping patch could avoid the crash yet still violate
         * this observable contract.
         */

        String[] anchors = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (int i = 0; i < anchors.length; i++) {
            assertCleanInvalidRejection(anchors[i]);
        }

        String candidate;
        switch (data.consumeInt(0, 7)) {
            case 0:
                candidate = "l";
                break;
            case 1:
                candidate = "L";
                break;
            case 2:
                candidate = data.consumeBoolean() ? "f" : "F";
                break;
            case 3:
                candidate = data.consumeBoolean() ? "d" : "D";
                break;
            case 4:
                String s = data.consumeAsciiString(1);
                candidate = s.length() == 0 ? (data.consumeBoolean() ? "l" : "L") : s.substring(0, 1);
                break;
            case 5:
                String u = data.consumeString(1);
                candidate = u.length() == 0 ? (data.consumeBoolean() ? "l" : "L") : u.substring(0, 1);
                break;
            case 6:
                candidate = singleCharFromRemaining(data.consumeRemainingAsString(), data.consumeBoolean() ? "l" : "L");
                break;
            default:
                candidate = buildExploreCandidate(data);
                break;
        }
        tryCreateNumber(candidate);

        String singleSuffix = suffixOnly(data.consumeInt(0, 5));
        assertCleanInvalidRejection(singleSuffix);

        int n = data.consumeInt();
        String canonical = Integer.toString(n);
        Number lower;
        Number upper;
        try {
            lower = NumberUtils.createNumber(canonical + "l");
            upper = NumberUtils.createNumber(canonical + "L");
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw t;
            }
            return;
        }

        if (lower == null || upper == null
                || !lower.getClass().equals(upper.getClass())
                || lower.longValue() != upper.longValue()
                || lower.longValue() != (long) n) {
            throw new RuntimeException(
                    "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + canonical
                            + " lhs=" + describe(lower) + " rhs=" + describe(upper));
        }
    }

    private static void assertCleanInvalidRejection(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw t;
            }
            return;
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String suffixOnly(int which) {
        switch (which) {
            case 0:
                return "l";
            case 1:
                return "L";
            case 2:
                return "f";
            case 3:
                return "F";
            case 4:
                return "d";
            default:
                return "D";
        }
    }

    private static String singleCharFromRemaining(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s.substring(0, 1);
    }

    private static String buildExploreCandidate(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 8)) {
            case 0:
                return data.consumeBoolean() ? "l" : "L";
            case 1:
                return data.consumeBoolean() ? "f" : "F";
            case 2:
                return data.consumeBoolean() ? "d" : "D";
            case 3:
                return sanitizeIntegralCore(data.consumeAsciiString(24)) + (data.consumeBoolean() ? "l" : "L");
            case 4:
                return sanitizeIntegralCore(data.consumeString(24)) + (data.consumeBoolean() ? "l" : "L");
            case 5:
                return sanitizeIntegralCore(data.consumeAsciiString(24)) + (data.consumeBoolean() ? "f" : "F");
            case 6:
                return sanitizeIntegralCore(data.consumeAsciiString(12)) + "." + nonEmptyDigits(data.consumeAsciiString(12))
                        + (data.consumeBoolean() ? "d" : "D");
            case 7:
                return "0x" + hexOnly(data.consumeAsciiString(16));
            default:
                return data.consumeRemainingAsString();
        }
    }

    private static String sanitizeIntegralCore(String s) {
        if (s == null || s.length() == 0) {
            return "0";
        }
        StringBuilder out = new StringBuilder();
        int i = 0;
        char first = s.charAt(0);
        if (first == '-' || first == '+') {
            out.append(first);
            i = 1;
        }
        for (; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            }
        }
        if (out.length() == 0 || "-".equals(out.toString()) || "+".equals(out.toString())) {
            return "0";
        }
        return out.toString();
    }

    private static String nonEmptyDigits(String s) {
        StringBuilder out = new StringBuilder();
        if (s != null) {
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if (c >= '0' && c <= '9') {
                    out.append(c);
                }
            }
        }
        if (out.length() == 0) {
            return "0";
        }
        return out.toString();
    }

    private static String hexOnly(String s) {
        StringBuilder out = new StringBuilder();
        if (s != null) {
            for (int i = 0; i < s.length(); i++) {
                char c = s.charAt(i);
                if ((c >= '0' && c <= '9')
                        || (c >= 'a' && c <= 'f')
                        || (c >= 'A' && c <= 'F')) {
                    out.append(c);
                }
            }
        }
        if (out.length() == 0) {
            return "0";
        }
        return out.toString();
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + String.valueOf(n);
    }
