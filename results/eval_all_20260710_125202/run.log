                    + " expectedBounds=[0.0,0.0," + expectedLeft.getWidth() + "," + constraintHeight + "]"
                    + " actualBounds=[" + bounds.getX() + "," + bounds.getY() + ","
                    + bounds.getWidth() + "," + bounds.getHeight() + "]"
                    + " arranged=[" + arranged.getWidth() + "," + arranged.getHeight() + "]");
        }
    }

    private static double scaledPositive(int v) {
        return v / 10.0;
    }

    private static double scaledNonNegative(int v) {
        return v / 10.0;
    }

    private static boolean same(double a, double b) {
        return Math.abs(a - b) <= 0.0000001;
    }
