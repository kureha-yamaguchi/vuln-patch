package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            String anchorNullArray = StringUtils.join((Object[]) null, ',');
            if (anchorNullArray != null) {
                throw new RuntimeException("metamorphic violation: join((Object[]) null, ',') must return null lhs=" + anchorNullArray);
            }
        } catch (RuntimeException t) {
            StackTraceElement[] st = t.getStackTrace();
            boolean inJoin = false;
            for (int i = 0; i < st.length; i++) {
                if ("org.apache.commons.lang3.StringUtils".equals(st[i].getClassName())
                        && "join".equals(st[i].getMethodName())) {
                    inJoin = true;
                    break;
                }
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (t instanceof NullPointerException && inJoin) {
                throw t;
            }
            return;
        }

        Object[] anchor = new Object[] { null };
        try {
            String a = StringUtils.join(anchor, '/', 0, 1);
            String b = StringUtils.join(anchor, "/", 0, 1);
            if (a != null && b != null && !a.equals(b)) {
                throw new RuntimeException("metamorphic violation: char-vs-string separator anchor input lhs=" + a + " rhs=" + b);
            }
            if (a != null && !"".equals(a)) {
                throw new RuntimeException("metamorphic violation: null element must contribute empty text for anchor lhs=" + a);
            }
        } catch (RuntimeException t) {
            StackTraceElement[] st = t.getStackTrace();
            boolean inJoin = false;
            for (int i = 0; i < st.length; i++) {
                if ("org.apache.commons.lang3.StringUtils".equals(st[i].getClassName())
                        && "join".equals(st[i].getMethodName())) {
                    inJoin = true;
                    break;
                }
            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            if (t instanceof RuntimeException && !(t instanceof NullPointerException)) {
                throw t;
            }
            if (t instanceof NullPointerException && inJoin) {
                throw t;
            }
            return;
        }

        int len = data.consumeInt(1, 8);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                array[i] = null;
            } else {
                array[i] = data.consumeString(32);
            }
        }

        int startIndex = data.consumeInt(0, len - 1);
        int endIndex = data.consumeInt(startIndex + 1, len);

        if (data.consumeBoolean()) {
            array[startIndex] = null;
        }

        char sep = (char) (data.consumeByte() & 0xFF);
        String sepString = String.valueOf(sep);

        try {
            String lhs = StringUtils.join(array, sep, startIndex, endIndex);
            String rhs = StringUtils.join(array, sepString, startIndex, endIndex);

            /* Contract asserted:
             * The char-separator and single-character String-separator overloads implement the same join semantics
             * over the same array slice; tests also show null array elements are accepted and rendered as empty text.
             * A throw-deleting or branch-skipping patch can silently change one overload's result while avoiding a crash.
             */
            if (lhs != null && rhs != null && !lhs.equals(rhs)) {
                throw new RuntimeException(
                        "metamorphic violation: char-vs-string separator input start=" + startIndex
                                + " end=" + endIndex
                                + " sep=" + ((int) sep)
                                + " lhs=" + lhs
                                + " rhs=" + rhs);
            }

            try {
                int ll = StringUtils.length(lhs);
                int rl = StringUtils.length(rhs);
                if (ll != rl) {
                    throw new RuntimeException(
                            "metamorphic violation: length(join-char) == length(join-string) start=" + startIndex
                                    + " end=" + endIndex
                                    + " sep=" + ((int) sep)
                                    + " lhs=" + lhs
                                    + " rhs=" + rhs
                                    + " ll=" + ll
                                    + " rl=" + rl);
                }
            } catch (RuntimeException ignored) {
                return;
            }
        } catch (RuntimeException t) {
            StackTraceElement[] st = t.getStackTrace();
            boolean inJoinOrLength = false;
            for (int i = 0; i < st.length; i++) {
                String cn = st[i].getClassName();
                String mn = st[i].getMethodName();
                if ("org.apache.commons.lang3.StringUtils".equals(cn)
                        && ("join".equals(mn) || "length".equals(mn))) {
                    inJoinOrLength = true;
                    break;
                }
            }

            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }

            if (!(t instanceof NullPointerException)) {
                throw t;
            }

            if (inJoinOrLength) {
                throw t;
            }
        }
    }
}
