package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.ParsePosition;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = buildRegistry();

    private static Map buildRegistry() {
        Map map = new HashMap();
        map.put("lower", new LowerFormatFactory());
        return map;
    }

    private static final class LowerFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            if (!"lower".equals(name)) {
                return null;
            }
            return new LowerFormat(locale);
        }
    }

    private static final class LowerFormat extends Format {
        private final Locale locale;

        LowerFormat(Locale locale) {
            this.locale = locale == null ? Locale.ENGLISH : locale;
        }

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            String s = String.valueOf(obj);
            toAppendTo.append(s.toLowerCase(locale));
            return toAppendTo;
        }

        public Object parseObject(String source, ParsePosition pos) {
            int index = pos.getIndex();
            pos.setIndex(source.length());
            if (index <= source.length()) {
                return source.substring(index);
            }
            return "";
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();
        runExplore(data);
    }

    private static void runAnchor() {
        String pattern = "it''s a {0,lower} 'test'!";
        String arg = "DUMMY";
        try {
            String out = formatWithRegistry(pattern, arg);
            /* Contract asserted: in MessageFormat-style patterns, doubled apostrophe '' denotes one literal apostrophe,
               and quoted text 'test' is emitted literally. A throw-deleting or branch-skipping patch could avoid the
               crash but lose the apostrophe/quoted-literal semantics, so we assert the observable formatted result. */
            if (!"it's a dummy test!".equals(out)) {
                throw new RuntimeException("metamorphic violation: anchor quoted-apostrophe contract input=" + pattern + " lhs=" + out + " rhs=it's a dummy test!");
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static void runExplore(FuzzedDataProvider data) {
        String prefix = sanitizeLiteral(data.consumeAsciiString(20));
        String middle = sanitizeLiteral(data.consumeAsciiString(20));
        String quoted = sanitizeQuotedLiteral(data.consumeAsciiString(20));
        String arg = sanitizeArgument(data.consumeString(20));

        boolean includeBang = data.consumeBoolean();
        boolean includeSpace = data.consumeBoolean();

        StringBuilder pattern = new StringBuilder();
        pattern.append(prefix);
        pattern.append("''");
        pattern.append(middle);
        if (includeSpace) {
            pattern.append(' ');
        }
        pattern.append("{0,lower}");
        pattern.append(' ');
        pattern.append('\'');
        pattern.append(quoted);
        pattern.append('\'');
        if (includeBang) {
            pattern.append('!');
        }

        StringBuilder expected = new StringBuilder();
        expected.append(prefix);
        expected.append('\'');
        expected.append(middle);
        if (includeSpace) {
            expected.append(' ');
        }
        expected.append(arg.toLowerCase(Locale.ENGLISH));
        expected.append(' ');
        expected.append(quoted);
        if (includeBang) {
            expected.append('!');
        }

        try {
            String out = formatWithRegistry(pattern.toString(), arg);
            /* Same contract as anchor, but over many valid-by-construction patterns whose key property is that a
               literal section begins with an escaped quote (''). Correct implementations must preserve one apostrophe
               in output and still process the custom format and quoted literal text. */
            if (!expected.toString().equals(out)) {
                throw new RuntimeException("metamorphic violation: quoted-apostrophe formatting input=" + pattern + " lhs=" + out + " rhs=" + expected);
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }
    }

    private static String formatWithRegistry(String pattern, String arg) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, REGISTRY);
        return emf.format(new Object[] { arg });
    }

    private static void handleThrowable(Throwable t) {
        if (isRootCause(t)) {
            throw (OutOfMemoryError) t;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (t instanceof RuntimeException) {
            StackTraceElement[] st = t.getStackTrace();
            for (int i = 0; i < st.length; i++) {
                if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(st[i].getClassName())
                        && "appendQuotedString".equals(st[i].getMethodName())) {
                    return;
