    private static void runAnchor(Graphics2D g2) {
        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(1.0, 2.3), RectangleEdge.TOP);
        container.add(new EmptyBlock(1.0, 1.0), RectangleEdge.BOTTOM);
        container.getBlocks();

        RectangleConstraint constraint = new RectangleConstraint(10.0, 0.0);
        try {
            container.arrange(g2, constraint);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isGroundTruthAtReachableSite(t)) {
                return;
            }
        }
    }

    private static void runCrashExplore(FuzzedDataProvider data, Graphics2D g2) {
        double width = positiveScaled(data.consumeInt(1, 5000));
        double height = nonNegativeScaled(data.consumeInt(0, 5000));
        double topHeight = height + 0.1 + positiveScaled(data.consumeInt(1, 5000));
        double topWidth = positiveScaled(data.consumeInt(1, 5000));
        double bottomWidth = positiveScaled(data.consumeInt(1, 5000));
        double bottomHeight = nonNegativeScaled(data.consumeInt(0, 5000));

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(topWidth, topHeight), RectangleEdge.TOP);
        container.add(new EmptyBlock(bottomWidth, bottomHeight), RectangleEdge.BOTTOM);

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.CENTER);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.RIGHT);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.LEFT);
        }

        container.getBlocks();
        RectangleConstraint constraint = new RectangleConstraint(width, height);
        try {
            container.arrange(g2, constraint);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isGroundTruthAtReachableSite(t)) {
                return;
            }
        }
    }

    private static void runMetamorphic(FuzzedDataProvider data, Graphics2D g2) {
        double constraintWidth = positiveScaled(data.consumeInt(1, 5000));
        double constraintHeight = positiveScaled(data.consumeInt(1, 5000));
        double leftWidth = nonNegativeScaled(data.consumeInt(0, 5000));
        double leftHeight = nonNegativeScaled(data.consumeInt(0, 5000));

        BlockContainer container = new BlockContainer(new BorderArrangement());
        EmptyBlock left = new EmptyBlock(leftWidth, leftHeight);
        container.add(left, RectangleEdge.LEFT);
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.CENTER);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.RIGHT);
        }

        container.getBlocks();
        RectangleConstraint containerConstraint = new RectangleConstraint(constraintWidth, constraintHeight);

        Size2D arrangedSize;
        try {
            arrangedSize = container.arrange(g2, containerConstraint);
        } catch (RuntimeException t) {
            return;
        }

        RectangleConstraint leftConstraint = new RectangleConstraint(
                0.0, new Range(0.0, constraintWidth), LengthConstraintType.RANGE,
                constraintHeight, null, LengthConstraintType.FIXED);

        Size2D expectedLeft;
        try {
            expectedLeft = left.arrange(g2, leftConstraint);
        } catch (RuntimeException t) {
            return;
        }

        Rectangle2D actualBounds = left.getBounds();
        if (actualBounds == null) {
            throw new RuntimeException("metamorphic violation: left block bounds must be set after successful arrange input="
                    + describe(constraintWidth, constraintHeight, leftWidth, leftHeight)
                    + " size=" + arrangedSize);
        }

        /*
         * Contract asserted: BorderArrangement.arrangeFF explicitly calls
         * leftBlock.setBounds(new Rectangle2D.Double(0.0, h[0], w[2], h[2]))
         * whenever leftBlock != null. For a container with no top/bottom block,
         * h[0] == 0 and h[2] == fixed constraint height, so after a successful
         * arrange the left block's bounds must reflect the real arranged size
         * computed by left.arrange(...) under the same RectangleConstraint.
         * A throw-deleting or bookkeeping-skipping patch (such as nulling
         * leftBlock before setBounds) breaks this observable post-condition.
         */
        if (!approximately(actualBounds.getX(), 0.0)
                || !approximately(actualBounds.getY(), 0.0)
                || !approximately(actualBounds.getWidth(), expectedLeft.getWidth())
                || !approximately(actualBounds.getHeight(), constraintHeight)) {
            throw new RuntimeException("metamorphic violation: left bounds after arrangeFF input="
                    + describe(constraintWidth, constraintHeight, leftWidth, leftHeight)
                    + " expectedBounds=[0.0,0.0," + expectedLeft.getWidth() + "," + constraintHeight + "]"
                    + " actualBounds=[" + actualBounds.getX() + "," + actualBounds.getY() + ","
                    + actualBounds.getWidth() + "," + actualBounds.getHeight() + "]"
                    + " containerSize=[" + arrangedSize.getWidth() + "," + arrangedSize.getHeight() + "]");
        }
    }

    private static void runArrangeFNProbe(FuzzedDataProvider data, Graphics2D g2) {
        double width = positiveScaled(data.consumeInt(1, 5000));
        double centerW = nonNegativeScaled(data.consumeInt(0, 5000));
        double centerH = nonNegativeScaled(data.consumeInt(0, 5000));
        double rightW = nonNegativeScaled(data.consumeInt(0, 5000));
        double rightH = nonNegativeScaled(data.consumeInt(0, 5000));

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(centerW, centerH));
        container.add(new EmptyBlock(rightW, rightH), RectangleEdge.RIGHT);
        container.getBlocks();

        RectangleConstraint constraint = new RectangleConstraint(
                width, new Range(width, width), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE);
        try {
            container.arrange(g2, constraint);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
        }
    }

    private static boolean isGroundTruthAtReachableSite(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                    && ("arrangeFF".equals(method)
                    || "arrangeFN".equals(method)
                    || "arrange".equals(method))) {
                return true;
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "arrange".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.block.AbstractBlock".equals(cls)
                    && ("getWidth".equals(method) || "setBounds".equals(method))) {
                return true;
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "getBlocks".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException;
    }

    private static double positiveScaled(int v) {
        return v / 10.0;
    }

    private static double nonNegativeScaled(int v) {
        return v / 10.0;
    }

    private static boolean approximately(double a, double b) {
        return Math.abs(a - b) <= 0.0000001;
    }

    private static String describe(double cw, double ch, double lw, double lh) {
        return "constraint=[" + cw + "," + ch + "] left=[" + lw + "," + lh + "]";
    }
}
