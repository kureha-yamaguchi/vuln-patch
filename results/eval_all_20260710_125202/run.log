public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        /*
         * Contract checks used here:
         * 1) The unit tests for this class show that createNumber("1234.5") must succeed and
         *    produce the same numeric value/class as createFloat("1234.5") for this canonical
         *    decimal input. A patch that merely suppresses the crash by rejecting or misparsing
         *    valid decimals would violate this observable behavior.
         * 2) Malformed mixed-exponent inputs such as "1eE" are invalid and should be rejected
         *    cleanly via validation exceptions, not by crashing with StringIndexOutOfBoundsException.
         */

        String[] fixedSeeds = new String[] {
            "1234.5",
            "12345",
            "1234.5D",
            "1234.5d",
            "1234.5F",
            "1234.5f",
            "-1234.5",
            "-12345",
            "0xFADE",
            "-0xFADE",
            "1.1E200",
            "1.1E20",
            "-1.1E200",
            "1.1E-200",
            "12345L",
            "12345l",
            "12345678901234567890L",
            "1.1E-700F",
            "2.",
            "1eE"
        };

        for (int i = 0; i < fixedSeeds.length; i++) {
            try {
                NumberUtils.createNumber(fixedSeeds[i]);
            } catch (RuntimeException t) {
                boolean inCreateNumber = false;
                StackTraceElement[] st = t.getStackTrace();
                for (int j = 0; j < st.length; j++) {
                    if ("org.apache.commons.lang3.math.NumberUtils".equals(st[j].getClassName())
                            && "createNumber".equals(st[j].getMethodName())) {
                        inCreateNumber = true;
                        break;
                    }
                }

                if (fixedSeeds[i].equals("1eE")) {
                    if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {
                        throw new RuntimeException(
                                "metamorphic violation: malformed scientific notation must be rejected cleanly, not crash input=1eE",
                                t);
                    }
                } else if (fixedSeeds[i].equals("1234.5")) {
                    if (inCreateNumber && !(t instanceof IllegalArgumentException)) {
                        throw t;
                    }
                }
            }
        }

        try {
            Number lhs = NumberUtils.createNumber("1234.5");
            Number rhs = NumberUtils.createFloat("1234.5");
            if (lhs == null || rhs == null
                    || !lhs.getClass().equals(rhs.getClass())
                    || lhs.floatValue() != rhs.floatValue()) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(\"1234.5\") should match createFloat(\"1234.5\") lhs="
                                + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            boolean inCreateNumber = false;
            StackTraceElement[] st = t.getStackTrace();
            for (int j = 0; j < st.length; j++) {
                if ("org.apache.commons.lang3.math.NumberUtils".equals(st[j].getClassName())
                        && "createNumber".equals(st[j].getMethodName())) {
                    inCreateNumber = true;
                    break;
                }
            }
            if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {
                throw new RuntimeException(
                        "metamorphic violation: canonical decimal must parse successfully input=1234.5", t);
            }
            if (t instanceof RuntimeException && !(t instanceof IllegalArgumentException)) {
                throw t;
            }
        }

        String sign = data.consumeBoolean() ? "-" : "";
        int leftLen = data.consumeInt(1, 6);
        int midLen = data.consumeInt(0, 4);
        int tailLen = data.consumeInt(0, 4);

        String leftSrc = data.consumeAsciiString(leftLen);
        String midSrc = data.consumeAsciiString(midLen);
        String tailSrc = data.consumeAsciiString(tailLen);

        StringBuilder left = new StringBuilder();
        for (int i = 0; i < leftSrc.length(); i++) {
            left.append((char) ('0' + (leftSrc.charAt(i) % 10)));
        }
        if (left.length() == 0) {
            left.append('1');
        }

        StringBuilder mid = new StringBuilder();
        for (int i = 0; i < midSrc.length(); i++) {
            mid.append((char) ('0' + (midSrc.charAt(i) % 10)));
        }

        StringBuilder tail = new StringBuilder();
        for (int i = 0; i < tailSrc.length(); i++) {
            tail.append((char) ('0' + (tailSrc.charAt(i) % 10)));
        }

        String malformed;
        switch (data.consumeInt(0, 4)) {
            case 0:
                malformed = sign + left + "eE";
                break;
            case 1:
                malformed = sign + left + "Ee";
                break;
            case 2:
                malformed = sign + left + "e" + mid + "E";
                break;
            case 3:
                malformed = sign + left + "E" + mid + "e";
                break;
            default:
                malformed = sign + left + "e" + mid + "E" + tail;
                break;
        }

        try {
            NumberUtils.createNumber(malformed);
        } catch (RuntimeException t) {
            boolean reachable = false;
            StackTraceElement[] st = t.getStackTrace();
            for (int j = 0; j < st.length; j++) {
                String cn = st[j].getClassName();
                String mn = st[j].getMethodName();
                if ("org.apache.commons.lang3.math.NumberUtils".equals(cn)
                        && ("createNumber".equals(mn)
                        || "createInteger".equals(mn)
                        || "isAllZeros".equals(mn)
                        || "isDigits".equals(mn)
                        || "createLong".equals(mn)
                        || "createBigInteger".equals(mn)
                        || "createFloat".equals(mn)
                        || "createDouble".equals(mn)
                        || "createBigDecimal".equals(mn))) {
                    reachable = true;
                    break;
                }
                if ("java.lang.String".equals(cn) && "substring".equals(mn)) {
                    reachable = true;
                    break;
                }
            }

            if (t instanceof StringIndexOutOfBoundsException && reachable) {
                throw new RuntimeException(
                        "metamorphic violation: invalid mixed-exponent input must be rejected cleanly input="
                                + malformed,
                        t);
            }

            if (t instanceof IllegalArgumentException) {
                return;
            }
        }

        String validLeftSrc = data.consumeAsciiString(data.consumeInt(1, 6));
        String validRightSrc = data.consumeAsciiString(data.consumeInt(1, 6));
        StringBuilder validLeft = new StringBuilder();
        for (int i = 0; i < validLeftSrc.length(); i++) {
            validLeft.append((char) ('0' + (validLeftSrc.charAt(i) % 10)));
        }
        StringBuilder validRight = new StringBuilder();
        for (int i = 0; i < validRightSrc.length(); i++) {
            validRight.append((char) ('0' + (validRightSrc.charAt(i) % 10)));
        }
        if (validLeft.length() == 0) {
            validLeft.append('0');
        }
        if (validRight.length() == 0) {
            validRight.append('0');
        }

        String validDecimal = (data.consumeBoolean() ? "-" : "") + validLeft + "." + validRight;

        try {
            Number lhs = NumberUtils.createNumber(validDecimal);
            Number rhs = NumberUtils.createFloat(validDecimal);
            if (lhs == null || rhs == null
                    || !lhs.getClass().equals(rhs.getClass())
                    || lhs.floatValue() != rhs.floatValue()) {
                throw new RuntimeException(
                        "metamorphic violation: bounded canonical decimal should match createFloat input="
                                + validDecimal + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            boolean inCreateNumber = false;
            StackTraceElement[] st = t.getStackTrace();
            for (int j = 0; j < st.length; j++) {
                if ("org.apache.commons.lang3.math.NumberUtils".equals(st[j].getClassName())
                        && "createNumber".equals(st[j].getMethodName())) {
                    inCreateNumber = true;
                    break;
                }
            }

            if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {
                throw new RuntimeException(
                        "metamorphic violation: valid bounded decimal must parse successfully input=" + validDecimal,
                        t);
            }

            if (t instanceof IllegalArgumentException && inCreateNumber) {
                throw new RuntimeException(
                        "metamorphic violation: valid bounded decimal unexpectedly rejected input=" + validDecimal,
                        t);
            }

            if (!(t instanceof IllegalArgumentException)) {
                throw t;
            }
        }
    }
