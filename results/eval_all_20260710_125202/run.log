            anchor.add(new LinearConstraint(new double[] { 1.0, 0.0 }, Relationship.LEQ, 1.0));
            anchor.add(new LinearConstraint(new double[] { 0.0, 1.0 }, Relationship.LEQ, 1.0));
            anchor.add(new LinearConstraint(new double[] { 1.0, 1.0 }, Relationship.LEQ, 1.0));
            LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0, 0.0 }, 0.0);

            try {
                SimplexSolver solver = new SimplexSolver();
                PointValuePair p1 = solver.optimize(f, anchor, GoalType.MAXIMIZE, true);

                ArrayList<LinearConstraint> anchorReversed = new ArrayList<LinearConstraint>(anchor);
                Collections.reverse(anchorReversed);
                PointValuePair p2 = new SimplexSolver().optimize(f, anchorReversed, GoalType.MAXIMIZE, true);

