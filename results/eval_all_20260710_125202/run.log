            s.getIndex(end);
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor gap copy returned null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid same-gap range was rejected", e);
            }
            throw e;
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy returned null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid before-first range was rejected", e);
            }
            throw e;
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor existing-period copy was rejected", e);
            }
            throw e;
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int day = (ord % 28) + 1;
        int month = ((ord / 28) % 12) + 1;
        int year = 2000 + (ord / (28 * 12));
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String context) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: null copy in " + context);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: itemCount mismatch in " + context
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: period mismatch in " + context
                        + " index=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null) {
                if (vb != null) {
                    throw new RuntimeException(
                        "metamorphic violation: value mismatch in " + context
                            + " index=" + i + " lhs=null rhs=" + vb);
                }
            } else if (!va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: value mismatch in " + context
                        + " index=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isOwnViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            String cls = stack[i].getClassName();
            String m = stack[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(m) || "getIndex".equals(m) || "clone".equals(m))) {
                return true;
            }
            if ("java.lang.Object".equals(cls) && "clone".equals(m)) {
                return true;
            }
        }
        return false;
    }
