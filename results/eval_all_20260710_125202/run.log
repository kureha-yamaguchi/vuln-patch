        try {
            RectangleConstraint c1 = new RectangleConstraint(width, null,
                    LengthConstraintType.FIXED, 0.0, new Range(0.0, totalHeight),
                    LengthConstraintType.RANGE);
            Size2D topSize = top.arrange(g2, c1);

            if (topSize.height < 0.0 || topSize.height > totalHeight) {
