    private static void runCase(double[] objective, List<LinearConstraint> constraints, boolean nonNegative) {
        try {
            PointValuePair base = optimize(objective, constraints, nonNegative);

            List<LinearConstraint> duplicated = new ArrayList<LinearConstraint>(constraints);
            if (!constraints.isEmpty()) {
                duplicated.add(constraints.get(0));
            }
            PointValuePair dup = optimize(objective, duplicated, nonNegative);

            if (base != null && dup != null) {
