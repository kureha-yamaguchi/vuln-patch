package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor =
                "var goog = {};" +
                "goog.inherits = function(x, y) {};" +
                "var ns = {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.FooEvent = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.SelectEvent = function() {};" +
                "goog.inherits(ns.PageSelectionModel.ChangeEvent," +
                "    ns.PageSelectionModel.FooEvent);";

        runOne(anchor, true);

        String outer = ident(data.consumeAsciiString(24), "ns");
        String base = ident(data.consumeAsciiString(24), "PageSelectionModel");
        String superProp = ident(data.consumeAsciiString(24), "FooEvent");
        String otherDefined = ident(data.consumeAsciiString(24), "SelectEvent");
        String missingProp = ident(data.consumeAsciiString(24), "ChangeEvent");
        if (missingProp.equals(superProp)) {
            missingProp = missingProp + "X";
        }
        if (otherDefined.equals(superProp)) {
            otherDefined = otherDefined + "Y";
        }

        boolean addThirdCtor = data.consumeBoolean();
        boolean addWhitespace = data.consumeBoolean();
        boolean useNewlines = data.consumeBoolean();

        String source = buildSource(outer, base, superProp, otherDefined, missingProp, addThirdCtor, addWhitespace, useNewlines);
        runOne(source, true);

        String extraUnused = ident(data.consumeAsciiString(24), "UnusedEvent");
        if (extraUnused.equals(superProp) || extraUnused.equals(otherDefined) || extraUnused.equals(missingProp)) {
            extraUnused = extraUnused + "Z";
        }
        String related = addUnusedCtor(source, outer, base, extraUnused, useNewlines);

        String lhs = compileToSource(source);
        String rhs = compileToSource(related);
        if (lhs != null && rhs != null) {
            /*
             * Contract asserted: for this generated family, every statement is an unused,
             * side-effect-free declaration or a call to the empty goog.inherits function.
             * The upstream regression test for the exact trigger expects the optimized output
             * to be the empty program. Adding one more unused constructor declaration is the
             * same kind of dead code, so a correct smart-name-removal pass must still compile
             * both programs to the same optimized output (typically "").
             * A "fix" that merely skips the bookkeeping in NameAnalyzer.visit can make the
             * crashing branch unreachable while silently changing dead-code analysis, which
             * this equivalence check exposes.
             */
            if (!lhs.equals(rhs)) {
                throw new RuntimeException(
                        "metamorphic violation: adding unused constructor changed optimized output input="
                                + printable(source) + " lhs=" + printable(lhs) + " rhs=" + printable(rhs));
            }
            if (!"".equals(lhs)) {
                throw new RuntimeException(
                        "metamorphic violation: dead declarations should optimize away input="
                                + printable(source) + " lhs=" + printable(lhs));
            }
        }
    }

    private static void runOne(String source, boolean assertEmpty) {
        try {
            String out = doCompile(source);
            if (assertEmpty && out != null && !"".equals(out)) {
                throw new RuntimeException(
                        "metamorphic violation: expected empty optimized output input="
                                + printable(source) + " output=" + printable(out));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
        }
    }

    private static String compileToSource(String source) {
        try {
            return doCompile(source);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return null;
            }
            if (isRootCause(t)) {
                throwAsUnchecked(t);
            }
            return null;
        }
    }

    private static String doCompile(String source) {
        Compiler compiler = new Compiler();
        compiler.disableThreads();

        CompilerOptions options = new CompilerOptions();
        options.smartNameRemoval = true;

        SourceFile extern = SourceFile.fromCode("externs.js", "");
        SourceFile input = SourceFile.fromCode("input.js", source);
        compiler.compile(extern, input, options);
        String out = compiler.toSource();
        return out == null ? "" : out;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.contains("parse") && lower.contains("exception")) {
                    return true;
                }
                if (lower.contains("validation") || lower.contains("invalid")) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (!(cur instanceof RuntimeException)) {
                continue;
            }
            if (hasRelevantFrame(cur)) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(Throwable t) {
        StackTraceElement[] frames = t.getStackTrace();
        if (frames == null) {
            return false;
        }
        for (StackTraceElement f : frames) {
            String cls = f.getClassName();
            String m = f.getMethodName();
            if ("com.google.javascript.jscomp.NameAnalyzer".equals(cls)) {
                if ("visit".equals(m)
                        || "createNameInformation".equals(m)
                        || "recordSet".equals(m)
                        || "recordPrototypeSet".equals(m)
                        || "getName".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static String buildSource(
            String outer,
            String base,
            String superProp,
            String otherDefined,
            String missingProp,
            boolean addThirdCtor,
            boolean addWhitespace,
            boolean useNewlines) {

        String sep = useNewlines ? "\n" : "";
        String pad = addWhitespace ? " " : "";

        StringBuilder sb = new StringBuilder();
        sb.append("var").append(pad).append("goog").append(pad).append("=").append(pad).append("{};").append(sep);
        sb.append("goog.inherits").append(pad).append("=").append(pad).append("function(x, y) {};");
        sb.append(sep);
        sb.append("var").append(pad).append(outer).append(pad).append("=").append(pad).append("{};").append(sep);
        sb.append("/** @constructor */").append(sep);
        sb.append(outer).append(".").append(base).append(pad).append("=").append(pad).append("function() {};");
        sb.append(sep);
        sb.append("/** @constructor */").append(sep);
        sb.append(outer).append(".").append(base).append(".").append(superProp)
                .append(pad).append("=").append(pad).append("function() {};");
        sb.append(sep);
        sb.append("/** @constructor */").append(sep);
        sb.append(outer).append(".").append(base).append(".").append(otherDefined)
                .append(pad).append("=").append(pad).append("function() {};");
        sb.append(sep);
        if (addThirdCtor) {
            String extra = missingProp + "Helper";
            sb.append("/** @constructor */").append(sep);
            sb.append(outer).append(".").append(base).append(".").append(extra)
                    .append(pad).append("=").append(pad).append("function() {};");
            sb.append(sep);
        }
        sb.append("goog.inherits(")
                .append(outer).append(".").append(base).append(".").append(missingProp)
                .append(",")
                .append(outer).append(".").append(base).append(".").append(superProp)
                .append(");");
        return sb.toString();
    }

    private static String addUnusedCtor(String source, String outer, String base, String extraUnused, boolean useNewlines) {
        String sep = useNewlines ? "\n" : "";
        return source + sep + "/** @constructor */" + sep
                + outer + "." + base + "." + extraUnused + " = function() {};";
    }

    private static String ident(String raw, String fallback) {
        if (raw == null || raw.length() == 0) {
            return fallback;
        }
        StringBuilder sb = new StringBuilder();
        char c0 = raw.charAt(0);
        if (isIdentStart(c0)) {
            sb.append(c0);
        } else {
            sb.append('_');
        }
        for (int i = 1; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (isIdentPart(c)) {
                sb.append(c);
            }
        }
        String s = sb.toString();
        if (s.length() == 0) {
            s = fallback;
        }
        if (isReserved(s)) {
            s = "_" + s;
        }
        return s;
    }

    private static boolean isIdentStart(char c) {
        return (c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || c == '_'
                || c == '$';
    }

    private static boolean isIdentPart(char c) {
        return isIdentStart(c) || (c >= '0' && c <= '9');
    }

    private static boolean isReserved(String s) {
        return "var".equals(s)
                || "function".equals(s)
                || "return".equals(s)
                || "this".equals(s)
                || "new".equals(s)
                || "null".equals(s)
                || "true".equals(s)
                || "false".equals(s);
    }

    private static String printable(String s) {
        if (s == null) {
            return "null";
        }
        return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r");
    }

    private static void throwAsUnchecked(Throwable t) {
        FuzzHarness.<RuntimeException>throwUnchecked0(t);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked0(Throwable t) throws T {
        throw (T) t;
    }
}
