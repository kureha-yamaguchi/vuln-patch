        int[] ords = new int[count];

        int first = data.consumeInt(0, maxOrd - 3);
        int initialGap = data.consumeInt(2, Math.min(64, maxOrd - first));
        int second = first + initialGap;
        ords[0] = first;
        ords[1] = second;

        int current = second;
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - current - remaining + 1;
            if (maxStep < 1) {
                maxStep = 1;
            }
            int step = data.consumeInt(1, Math.min(64, maxStep));
            current += step;
            ords[i] = current;
        }

