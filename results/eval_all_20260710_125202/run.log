package org.apache.commons.math.distribution;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorChecks();
        exploreInvalidMeans(data);
        exploreValidMeans(data);
    }

    private static void anchorChecks() {
        // Contract from the regression test and constructor guard:
        // a non-positive Poisson mean must be rejected, never accepted silently.
        try {
            new PoissonDistributionImpl(-1);
            throw new RuntimeException("contract violation: negative mean was accepted by PoissonDistributionImpl(-1)");
        } catch (Throwable t) {
            if (!isCleanRejection(t)) {
                // Invalid input should be rejected cleanly; any unrelated failure is outside this patch's scope.
            }
        }

        // Contract visible in the test: for a valid positive mean, getMean() must return that mean.
        try {
            PoissonDistribution dist = new PoissonDistributionImpl(10.0);
            double mean = dist.getMean();
            if (Double.compare(mean, 10.0) != 0) {
                throw new RuntimeException("metamorphic violation: getMean must recover constructor mean input=10.0 observed=" + mean);
            }
        } catch (Throwable t) {
            // Per hygiene rules, if construction/read throws, skip the check for this input.
        }
    }

    private static void exploreInvalidMeans(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 4);
        int raw = data.consumeInt();
        byte fracByte = data.consumeByte();

        double fraction = (fracByte & 0xFF) / 255.0;
        double p;
        switch (mode) {
            case 0:
                p = 0.0;
                break;
            case 1:
                p = -Math.abs((double) raw);
                break;
            case 2:
                p = -Math.abs((double) raw) - fraction;
                break;
            case 3:
                p = -fraction;
                break;
            default:
                p = -1.0;
                break;
        }

        double epsilon = buildArbitraryDouble(data.consumeInt(), data.consumeByte(), data.consumeBoolean());
        int maxIterations = data.consumeInt();

        try {
            new PoissonDistributionImpl(p, epsilon, maxIterations);
            // Contract guarantee: constructor rejects p <= 0.
            // A throw-deleting or branch-skipping patch would accept such input, which is observably wrong.
            throw new RuntimeException(
                "contract violation: non-positive mean accepted inputMean=" + p +
                " epsilon=" + epsilon + " maxIterations=" + maxIterations);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            // Invalid input path: swallow unrelated failures to avoid false positives on correct patches.
        }
    }

    private static void exploreValidMeans(FuzzedDataProvider data) {
        int base = data.consumeInt(1, Integer.MAX_VALUE);
        byte fracByte = data.consumeByte();
        double p = base + ((fracByte & 0xFF) / 255.0);

        double epsilon = buildPositiveDouble(data.consumeInt(), data.consumeByte());
        int maxIterations = data.consumeInt(1, Integer.MAX_VALUE);

        try {
            // Documented/visible contract:
            // 1) getMean() returns the configured Poisson mean.
            // 2) epsilon/maxIterations affect computation controls, not the stored mean itself.
            PoissonDistribution oneArg = new PoissonDistributionImpl(p);
            PoissonDistribution threeArg = new PoissonDistributionImpl(p, epsilon, maxIterations);

            double m1 = oneArg.getMean();
            double m2 = threeArg.getMean();

            if (Double.compare(m1, p) != 0) {
                throw new RuntimeException(
                    "metamorphic violation: one-arg constructor mean not preserved input=" + p + " observed=" + m1);
            }
            if (Double.compare(m2, p) != 0) {
                throw new RuntimeException(
                    "metamorphic violation: three-arg constructor mean not preserved input=" + p +
                    " epsilon=" + epsilon + " maxIterations=" + maxIterations + " observed=" + m2);
            }
            if (Double.compare(m1, m2) != 0) {
                throw new RuntimeException(
                    "metamorphic violation: constructors with same mean disagree input=" + p +
                    " epsilon=" + epsilon + " maxIterations=" + maxIterations +
                    " lhs=" + m1 + " rhs=" + m2);
            }
        } catch (Throwable t) {
            // Hygiene: if either side throws, skip the relation for this input.
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        if (name.startsWith("org.apache.commons.math.exception.")) {
            return true;
        }
        if (name.contains("NotStrictlyPositive")
                || name.contains("IllegalArgument")
                || name.contains("Invalid")
                || name.contains("OutOfRange")
                || name.contains("MathIllegal")) {
            return true;
        }
        return false;
    }

    private static double buildArbitraryDouble(int whole, byte fracByte, boolean negate) {
        double v = Math.abs((double) whole) + ((fracByte & 0xFF) / 255.0);
        return negate ? -v : v;
    }

    private static double buildPositiveDouble(int whole, byte fracByte) {
        return Math.abs((double) whole) + ((fracByte & 0xFF) / 255.0) + 1.0e-12;
    }
}
