package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchorCase();

        int meanInt = data.consumeInt(-8, 8);
        int sdInt = data.consumeInt(1, 8);
        int steps = data.consumeInt(1, 12);
        boolean positiveSide = data.consumeBoolean();

        double mean = meanInt;
        double sd = sdInt;
        double expected = positiveSide ? mean + steps * sd : mean - steps * sd;

        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(mean, sd);

            double p;
            try {
                p = normal.cumulativeProbability(expected);
            } catch (Throwable t) {
                return;
            }

            if (!(p > 0.0 && p < 1.0) || Double.isNaN(p)) {
                return;
            }

            double recovered;
            try {
                recovered = normal.inverseCumulativeProbability(p);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCauseMathException(t)) {
                    sneakyThrow(t);
                }
                return;
            }

            /* Contract/metamorphic check:
             * inverseCumulativeProbability is the inverse of cumulativeProbability for probabilities
             * built from a real distribution value. Here p is constructed as cumulativeProbability(expected),
             * so a correct implementation must recover expected (up to numeric tolerance). A patch that
             * merely deletes the throw or skips correct bracketing could silently return a wrong quantile,
             * which this check exposes.
             */
            double tol = 1.0e-10 * Math.max(1.0, Math.abs(expected));
            if (Double.isNaN(recovered) || Math.abs(recovered - expected) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: normal inverse(cdf(x)) != x input="
                        + "mean=" + mean
                        + " sd=" + sd
                        + " steps=" + steps
                        + " positiveSide=" + positiveSide
                        + " p=" + p
                        + " expected=" + expected
                        + " actual=" + recovered);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (isRootCauseMathException(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static void exerciseAnchorCase() {
        try {
            NormalDistributionImpl normal = new NormalDistributionImpl(0, 1);
            double result = normal.inverseCumulativeProbability(0.9772498680518209d);

            /* Contract check from the regression test: for the standard normal distribution,
             * inverseCumulativeProbability(0.9772498680518209) must be 2.0.
             * A throw-deleting or branch-skipping patch could return some other value instead.
             */
            if (Double.isNaN(result) || Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor quantile mismatch p=0.9772498680518209 expected=2.0 actual=" + result);
            }
