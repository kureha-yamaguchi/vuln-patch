package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact regression input from StrBuilderAppendInsertTest.testLang299.
        runCase(1, "", "foo", false, 1, '-');

        String prefix = data.consumeString(16);
        String core = data.consumeString(32);
        int width = data.consumeInt(1, 16);
        char padChar = (char) (data.consumeByte() & 0xff);

        while (core.length() <= width) {
            if (data.remainingBytes() > 0) {
                core = core + data.consumeString(8);
            } else {
                core = core + "X";
            }
        }

        // EXPLORE strategy 1:
        // Root-cause property: width > 0, obj.toString().length() > width, and the builder's
        // capacity after ensureCapacity(size + width) is still too small for copying strLen chars
        // at offset size. Using constructor capacity prefix.length() + width makes that reachable.
        runCase(prefix.length() + width, prefix, core, false, width, padChar);

        // EXPLORE strategy 2:
        // Same property, but drive obj.toString() through the real StrBuilder.toString() implementation.
        runCase(prefix.length() + width, prefix, core, true, width, padChar);

        // EXPLORE strategy 3:
        // Vary surrounding content/capacity while keeping the same validity/property.
        int slack = data.consumeInt(0, 4);
        runCase(prefix.length() + width + slack, prefix, core, data.consumeBoolean(), width, padChar);
    }

    private static void runCase(int initialCapacity, String prefix, String core, boolean useStrBuilderObject, int width, char padChar) {
        if (width <= 0) {
            return;
        }
        if (core == null || core.length() <= width) {
            return;
        }
        if (initialCapacity < 0) {
            initialCapacity = 0;
        }

        StrBuilder target = new StrBuilder(initialCapacity);
        try {
            if (prefix != null && prefix.length() > 0) {
                target.append(prefix);
            }

            Object obj;
            if (useStrBuilderObject) {
                StrBuilder objBuilder = new StrBuilder(core.length());
                objBuilder.append(core);
                obj = objBuilder;
            } else {
                obj = core;
            }

            int beforeLen = target.length();
            target.appendFixedWidthPadRight(obj, width, padChar);

            // Contract asserted from appendFixedWidthPadRight's code:
            // on successful return with width > 0, it must increase size by exactly width and
            // append either the first width chars of obj.toString(), or the whole string plus padChar.
            // A "fix" that merely suppresses the crash or skips the copy would violate this observable API state.
            String actual = target.toString();
            String expectedSuffix = expectedFixedWidth(core, width, padChar);
            String expected = (prefix == null ? "" : prefix) + expectedSuffix;
            int expectedLen = beforeLen + width;

            if (target.length() != expectedLen || !actual.equals(expected)) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight contract"
                    + " initialCapacity=" + initialCapacity
                    + " prefix=" + String.valueOf(prefix)
                    + " core=" + core
                    + " useStrBuilderObject=" + useStrBuilderObject
                    + " width=" + width
                    + " padChar=" + (int) padChar
                    + " expectedLen=" + expectedLen
                    + " actualLen=" + target.length()
                    + " expected=" + expected
                    + " actual=" + actual
                );
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (t instanceof RuntimeException) {
                if (isRootCause((RuntimeException) t) || isMetamorphicViolation((RuntimeException) t)) {
                    throw (RuntimeException) t;
                }
            }
            return;
        }
    }

    private static String expectedFixedWidth(String s, int width, char padChar) {
        if (s.length() >= width) {
            return s.substring(0, width);
        }
        StringBuilder out = new StringBuilder(width);
        out.append(s);
        for (int i = s.length(); i < width; i++) {
            out.append(padChar);
        }
        return out.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        while (t != null) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            t = t.getCause();
        }
        return false;
    }

    private static boolean isMetamorphicViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.indexOf("metamorphic violation:") == 0;
    }

    private static boolean isRootCause(RuntimeException t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)) {
                if ("appendFixedWidthPadRight".equals(method)
                        || "ensureCapacity".equals(method)
                        || "getNullText".equals(method)) {
                    return true;
                }
