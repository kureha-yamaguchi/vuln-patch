<xref>
public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            runAnchor();
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        if (data.remainingBytes() <= 0) {
            return;
        }

        int count = data.consumeInt(2, 8);
        int[] ords = new int[count];

        int firstMax = maxOrd - (count + 4);
        if (firstMax < 0) {
            return;
        }
        int first = data.consumeInt(0, firstMax);
        int gapMax = Math.min(64, maxOrd - first - (count - 1));
        if (gapMax < 2) {
            return;
        }

        ords[0] = first;
        ords[1] = first + data.consumeInt(2, gapMax);

        int current = ords[1];
        for (int i = 2; i < count; i++) {
            int remaining = count - i;
            int maxStep = maxOrd - current - remaining;
            if (maxStep < 1) {
                return;
            }
            current += data.consumeInt(1, Math.min(64, maxStep));
            ords[i] = current;
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < count; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), Integer.valueOf(data.consumeInt()));
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int gapIndex = findGap(ords);
        if (gapIndex < 0) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);

        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            series.getIndex(start);
            series.getIndex(end);

            TimeSeries copy = series.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: null copy for valid same-gap range startOrd=" + startOrd + " endOrd=" + endOrd);
            }

            /*
             * Contract checked: createCopy(start, end) returns the items whose periods lie in
             * the inclusive range [start, end]. When start/end are valid ordered periods that
             * lie wholly inside a gap between existing items, there are no source items in that
             * range, so the copy must be empty. A throw-deleting/bookkeeping-only patch can
             * silently return the wrong slice; this observable itemCount check catches that.
             */
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: copy wholly inside gap must be empty startOrd="
                        + startOrd + " endOrd=" + endOrd + " itemCount=" + copy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        if (right - left >= 3) {
            int startOrd2 = data.consumeInt(left + 1, right - 1);
            int endOrd2 = data.consumeInt(startOrd2, right - 1);

            Day start2 = dayFromOrdinal(startOrd2);
            Day end2 = dayFromOrdinal(endOrd2);

            try {
                TimeSeries copyA = series.createCopy(start, end);
                TimeSeries copyB = series.createCopy(start2, end2);

                /*
                 * Equivalent-inputs relation: any two valid ranges chosen wholly inside the same
                 * empty gap select exactly the same set of source items: none. Therefore both
                 * copies must be equivalent.
                 */
                assertEquivalentCopies(copyA, copyB,
                    "same-gap ranges range1=" + startOrd + ".." + endOrd
                        + " range2=" + startOrd2 + ".." + endOrd2);
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (RuntimeException e) {
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        int beforeFirstOrd = ords[0] - 1;
        if (beforeFirstOrd >= 0) {
            Day beforeFirst = dayFromOrdinal(beforeFirstOrd);
            try {
                series.getIndex(beforeFirst);
                TimeSeries empty = series.createCopy(beforeFirst, beforeFirst);

                /*
                 * Contract checked: a valid ordered range entirely before the first series item
                 * contains no source items, so createCopy must succeed and return an empty series.
                 */
                if (empty == null) {
                    throw new RuntimeException("metamorphic violation: null copy for before-first range ord=" + beforeFirstOrd);
                }
                if (empty.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: before-first range must copy to empty series ord="
                            + beforeFirstOrd + " itemCount=" + empty.getItemCount());
                }
            } catch (IllegalArgumentException e) {
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            } catch (RuntimeException e) {
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);

            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);

            /*
             * Equivalent-inputs relation: when the bounds are existing periods taken directly
             * from indices i..j, createCopy(startPeriod, endPeriod) and createCopy(i, j)
             * describe the same inclusive slice and must therefore produce equivalent copies.
             */
            assertEquivalentCopies(byPeriod, byIndex,
                "existing-period copy equals index copy i=" + i + " j=" + j);
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }
