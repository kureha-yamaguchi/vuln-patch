    private static boolean isGroundTruthAtReachableSite(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                    && ("arrangeFF".equals(method)
                    || "arrangeFN".equals(method)
                    || "arrange".equals(method))) {
                return true;
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "arrange".equals(method)) {
                return true;
            }
            if ("org.jfree.chart.block.AbstractBlock".equals(cls)
                    && ("getWidth".equals(method) || "setBounds".equals(method))) {
                return true;
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "getBlocks".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException
                || t instanceof IndexOutOfBoundsException
                || t instanceof NullPointerException;
    }

    private static double positiveScaled(int v) {
        return v / 10.0;
    }

    private static double nonNegativeScaled(int v) {
        return v / 10.0;
    }

    private static boolean approximately(double a, double b) {
        return Math.abs(a - b) <= 0.0000001;
    }

    private static String describe(double cw, double ch, double lw, double lh) {
        return "constraint=[" + cw + "," + ch + "] left=[" + lw + "," + lh + "]";
    }
}
