package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runExactAnchorContract();
        runNullTextAnchorContract();

        String prefix = data.consumeString(16);
        String source = data.consumeString(32);
        char pad = (char) (data.consumeByte() & 0xff);

        int sourceLen = source.length();
        int width;
        if (sourceLen == 0) {
            width = 1;
            source = "A";
            sourceLen = 1;
        } else {
            width = data.consumeInt(1, sourceLen);
            if (width == sourceLen) {
                if (sourceLen < 32) {
                    source = source + "Z";
                    sourceLen = source.length();
                } else if (sourceLen > 1) {
                    width = sourceLen - 1;
                }
            }
        }

        if (source.length() <= width) {
            return;
        }

        int exactNeeded = prefix.length() + width;
        int capacity = exactNeeded;
        if (data.consumeBoolean()) {
            capacity = exactNeeded;
        } else {
            capacity = Math.max(0, exactNeeded - data.consumeInt(0, Math.min(8, exactNeeded)));
        }

        checkAppendFixedWidthTruncation(prefix, source, width, pad, capacity);
        checkAppendFixedWidthTruncationViaNullText(prefix, source, width, pad, capacity);

        if (data.consumeBoolean()) {
            String extraPrefix = data.consumeString(8);
            int capacity2 = Math.max(0, extraPrefix.length() + width);
            checkAppendFixedWidthTruncation(extraPrefix + prefix, source, width, pad, capacity2);
            checkAppendFixedWidthTruncationViaNullText(extraPrefix + prefix, source, width, pad, capacity2);
        }
    }

    private static void runExactAnchorContract() {
        checkAppendFixedWidthTruncation("", "foo", 1, '-', 1);
    }

    private static void runNullTextAnchorContract() {
        checkAppendFixedWidthTruncationViaNullText("", "foo", 1, '-', 1);
    }

    private static void checkAppendFixedWidthTruncation(String prefix, String source, int width, char pad, int capacity) {
        if (width <= 0 || source == null || source.length() <= width) {
            return;
        }
        try {
            StrBuilder sb = new StrBuilder(Math.max(0, capacity));
            sb.append(prefix);
            sb.appendFixedWidthPadRight(source, width, pad);

            /*
             * Contract asserted from appendFixedWidthPadRight's code:
             * when strLen >= width, it appends characters from the source string and then does size += width.
             * Therefore, for any correct implementation, the builder grows by exactly width characters and
             * the appended slice equals source.substring(0, width). A patch that merely suppresses the throw,
             * skips the copy, or copies the wrong number of characters violates this observable post-condition.
             */
            String got = sb.toString();
            String expected = prefix + source.substring(0, width);
            if (sb.length() != prefix.length() + width || !expected.equals(got)) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight truncation contract input="
                        + describe(prefix, source, width, pad, capacity)
                        + " expected=" + expected
                        + " got=" + got
                        + " len=" + sb.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkAppendFixedWidthTruncationViaNullText(String prefix, String nullText, int width, char pad, int capacity) {
        if (width <= 0 || nullText == null || nullText.length() <= width) {
            return;
        }
        try {
            StrBuilder sb = new StrBuilder(Math.max(0, capacity));
            sb.append(prefix);
            sb.setNullText(nullText);
            sb.appendFixedWidthPadRight(null, width, pad);

            /*
             * Same contract as above, but through the getNullText() path: when obj == null, appendFixedWidthPadRight
             * uses getNullText() as the source string. A correct implementation must therefore append exactly the first
             * width characters of nullText and increase length by width.
             */
            String got = sb.toString();
            String expected = prefix + nullText.substring(0, width);
            if (sb.length() != prefix.length() + width || !expected.equals(got)) {
                throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight nullText truncation contract input="
                        + describe(prefix, nullText, width, pad, capacity)
                        + " expected=" + expected
                        + " got=" + got
                        + " len=" + sb.length());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if (!"org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                continue;
            }
            String m = e.getMethodName();
            if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String describe(String prefix, String source, int width, char pad, int capacity) {
        return "{prefix=" + prefix + ", source=" + source + ", width=" + width + ", pad=" + (int) pad + ", capacity=" + capacity + "}";
    }
}
