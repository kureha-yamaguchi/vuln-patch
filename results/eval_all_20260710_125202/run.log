package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int mean = data.consumeInt(-20, 20);
        int step = data.consumeInt(-6, 6);
        if (step == 0) {
            step = 2;
        }

        NormalDistribution dist;
        try {
            dist = new NormalDistributionImpl(mean, 1.0);
        } catch (Throwable t) {
            return;
        }

        double x = mean + step;
        double p;
        try {
            p = dist.cumulativeProbability(x);
        } catch (Throwable t) {
            return;
        }

        tryInverseAndCheck(dist, p, x);

        if (data.consumeBoolean()) {
            int mean2 = data.consumeInt(-50, 50);
            int step2 = data.consumeInt(-4, 4);
            if (step2 == 0) {
                step2 = -2;
            }
            try {
                NormalDistribution dist2 = new NormalDistributionImpl(mean2, 1.0);
                double x2 = mean2 + step2;
                double p2 = dist2.cumulativeProbability(x2);
                tryInverseAndCheck(dist2, p2, x2);
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
            }
        }
    }

    private static void runAnchor() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            double p = 0.9772498680518209;
            double result = normal.inverseCumulativeProbability(p);

            if (Math.abs(result - 2.0) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: anchor known quantile input=" + p + " expected=2.0 actual=" + result);
            }

            double roundTrip = normal.cumulativeProbability(result);
            if (Math.abs(roundTrip - p) > 1.0e-12) {
                throw new RuntimeException("metamorphic violation: cdf(inv(p)) round-trip input=" + p + " lhs=" + roundTrip + " rhs=" + p);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void tryInverseAndCheck(NormalDistribution dist, double p, double expectedX) {
        double inv;
        try {
            inv = dist.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        /* Contract/metamorphic check:
         * inverseCumulativeProbability is the inverse of cumulativeProbability for the same
         * continuous distribution. Here p is constructed by the real library as
         * p = cumulativeProbability(expectedX), so a correct implementation must recover
         * expectedX (within numerical tolerance). A patch that only deletes the throw or
         * otherwise skips correct endpoint-root handling would violate this observable result.
         */
        if (Math.abs(inv - expectedX) > 1.0e-9) {
            throw new RuntimeException(
                "metamorphic violation: inv(cdf(x))!=x input=" + p + " expected=" + expectedX + " actual=" + inv);
        }

        double roundTrip;
        try {
            roundTrip = dist.cumulativeProbability(inv);
        } catch (Throwable t) {
            return;
        }

        if (Math.abs(roundTrip - p) > 1.0e-12) {
            throw new RuntimeException(
                "metamorphic violation: cdf(inv(p))!=p input=" + p + " lhs=" + roundTrip + " rhs=" + p);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && ("createIllegalArgumentException".equals(method) || "buildMessage".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        throw new RuntimeException(t);
    }
}
