package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact trigger from the failing test / ground truth.
        try {
            BooleanUtils.toBoolean("off");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // EXPLORE: exercise many short strings of the same general shape as the observed
        // failing inputs, driving them through the real public API.
        String[] seeds = new String[] {
            "off", "oof", "yep", "trux", "false", "a", "true", "truE", "trUe",
            "trUE", "tRue", "tRuE", "tRUe", "tRUE", "TRUE", "TRUe", "TRuE",
            "TRue", "TrUE", "TrUe", "TruE", "True", "on", "oN", "On", "ON",
            "yes", "yeS", "yEs", "yES", "Yes", "YeS", "YEs", "YES", "yes?", "tru"
        };

        String seed = seeds[data.consumeInt(0, seeds.length - 1)];
        String explored = mutateShortAscii(seed, data);
        try {
            BooleanUtils.toBoolean(explored);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        String arbitrary = data.consumeAsciiString(8);
        try {
            BooleanUtils.toBoolean(arbitrary);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }

        // POST-CONDITION / ORACLE FROM THE INPUT ITSELF:
        // The visible contract from the tests and implementation is that these canonical
        // tokens are accepted case-insensitively:
        // true/on/yes => true, false/off/no => false.
        // We build a valid token ourselves, then assert the returned boolean matches the
        // known value. A throw-deleting or branch-skipping patch that silently returns the
        // wrong boolean would violate this observable contract.
        String[] trueTokens = new String[] { "true", "on", "yes" };
        String[] falseTokens = new String[] { "false", "off", "no" };
        boolean expected = data.consumeBoolean();
        String token = expected
            ? trueTokens[data.consumeInt(0, trueTokens.length - 1)]
            : falseTokens[data.consumeInt(0, falseTokens.length - 1)];
        String mixedCaseToken = randomizeCase(token, data);
        try {
            boolean actual = BooleanUtils.toBoolean(mixedCaseToken);
            if (actual != expected) {
                throw new RuntimeException(
                    "metamorphic violation: valid token contract input=" + mixedCaseToken +
                    " expected=" + expected + " actual=" + actual);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
                throw t;
            }
        }

        // METAMORPHIC RELATION:
        // The implementation explicitly special-cases the interned literal "true", but the
        // API contract shown by the tests requires equal textual inputs to behave the same
        // whether or not they are interned. So for any string s, toBoolean(s) must equal
        // toBoolean(new String(s)). If either call throws, the relation does not apply and
        // we skip it, per hygiene rules.
        String maybeTrue = data.consumeBoolean() ? randomizeCase("true", data) : data.consumeAsciiString(6);
        try {
            boolean lhs = BooleanUtils.toBoolean(maybeTrue);
            boolean rhs = BooleanUtils.toBoolean(new String(maybeTrue));
            if (lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: equal-text/non-interned relation input=" + maybeTrue +
                    " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            if (data.consumeBoolean()) {
                chars[i] = Character.toUpperCase(chars[i]);
            } else {
                chars[i] = Character.toLowerCase(chars[i]);
            }
        }
        return new String(chars);
    }

    private static String mutateShortAscii(String seed, FuzzedDataProvider data) {
        String s = seed;

        if (data.consumeBoolean()) {
            s = randomizeCase(s, data);
        }

        int mode = data.consumeInt(0, 5);
        switch (mode) {
            case 0:
                return s;
            case 1: {
                String extra = data.consumeAsciiString(2);
                return truncate(s + extra, 8);
            }
            case 2: {
                String extra = data.consumeAsciiString(2);
                return truncate(extra + s, 8);
            }
            case 3: {
                if (s.length() == 0) {
                    return data.consumeAsciiString(1);
                }
                int idx = data.consumeInt(0, s.length() - 1);
                char replacement = printableAscii(data.consumeByte());
                char[] chars = s.toCharArray();
                chars[idx] = replacement;
                return new String(chars);
            }
            case 4: {
                int targetLen = data.consumeInt(0, 8);
                return truncate(s, targetLen);
            }
            default:
                return data.consumeAsciiString(8);
        }
    }

    private static String truncate(String s, int maxLen) {
        if (s.length() <= maxLen) {
            return s;
        }
        return s.substring(0, maxLen);
    }

    private static char printableAscii(byte b) {
        int v = b & 0xFF;
        return (char) (32 + (v % 95));
    }
}
