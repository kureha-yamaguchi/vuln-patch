package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.exception.MathIllegalStateException;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorCycleLike();

        int vars = data.consumeInt(4, 8);
        LinearObjectiveFunction objective = buildObjective(data, vars);
        ArrayList<LinearConstraint> constraints = buildCycleProneConstraints(data, vars);

        exerciseCase(objective, constraints, true);

        ArrayList<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
        if (permuted.size() > 1) {
            int shift = data.consumeInt(0, permuted.size() - 1);
            Collections.rotate(permuted, shift);
            checkObjectiveValueInvariant(objective, constraints, permuted, true);
        }

        ArrayList<LinearConstraint> scaled = scaleOneConstraint(data, constraints, vars);
        if (scaled != null) {
            checkObjectiveValueInvariant(objective, constraints, scaled, true);
        }
    }

    private static void runAnchorCycleLike() {
        LinearObjectiveFunction f = new LinearObjectiveFunction(
                new double[] { 10.0, -57.0, -9.0, -24.0 }, 0.0);

        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(
                new double[] { -0.5, 5.5, 2.5, -9.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(
                new double[] { -0.5, 1.5, 0.5, -1.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(
                new double[] { -1.0, 0.0, 0.0, 0.0 }, Relationship.GEQ, -1.0));

        exerciseCase(f, constraints, true);

        ArrayList<LinearConstraint> rotated = new ArrayList<LinearConstraint>(constraints);
        Collections.rotate(rotated, 1);
        checkObjectiveValueInvariant(f, constraints, rotated, true);

        ArrayList<LinearConstraint> scaled = new ArrayList<LinearConstraint>();
        scaled.add(new LinearConstraint(
                new double[] { -1.0, 11.0, 5.0, -18.0 }, Relationship.GEQ, 0.0));
        scaled.add(constraints.get(1));
        scaled.add(constraints.get(2));
        checkObjectiveValueInvariant(f, constraints, scaled, true);
    }

    private static LinearObjectiveFunction buildObjective(FuzzedDataProvider data, int vars) {
        double[] c = new double[vars];
        c[0] = 10.0 + data.consumeInt(-3, 3);
        for (int i = 1; i < vars; i++) {
            c[i] = -data.consumeInt(0, 60);
        }
        return new LinearObjectiveFunction(c, data.consumeInt(-3, 3));
    }

    private static ArrayList<LinearConstraint> buildCycleProneConstraints(FuzzedDataProvider data, int vars) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        double[] a = new double[vars];
        a[0] = -0.5;
        if (vars > 1) a[1] = 5.5 + data.consumeInt(-2, 2);
        if (vars > 2) a[2] = 2.5 + data.consumeInt(-2, 2);
        if (vars > 3) a[3] = -9.0 + data.consumeInt(-2, 2);
        for (int i = 4; i < vars; i++) {
            a[i] = data.consumeInt(-3, 3);
        }
        constraints.add(new LinearConstraint(a, Relationship.GEQ, 0.0));

        double[] b = new double[vars];
        b[0] = -0.5;
        if (vars > 1) b[1] = 1.5 + data.consumeInt(-2, 2);
        if (vars > 2) b[2] = 0.5 + data.consumeInt(-2, 2);
        if (vars > 3) b[3] = -1.0 + data.consumeInt(-1, 1);
        for (int i = 4; i < vars; i++) {
            b[i] = data.consumeInt(-2, 2);
        }
        constraints.add(new LinearConstraint(b, Relationship.GEQ, 0.0));

        double[] c = new double[vars];
        c[0] = -1.0;
        for (int i = 1; i < vars; i++) {
            c[i] = 0.0;
        }
        constraints.add(new LinearConstraint(c, Relationship.GEQ, -1.0));

        int extra = data.consumeInt(0, 3);
        for (int k = 0; k < extra; k++) {
            double[] e = new double[vars];
            int pivot = data.consumeInt(0, vars - 1);
            for (int i = 0; i < vars; i++) {
                if (i == pivot) {
                    e[i] = data.consumeBoolean() ? 1.0 : -1.0;
                } else {
                    e[i] = data.consumeInt(-2, 2);
                }
            }
            Relationship rel;
            int r = data.consumeInt(0, 2);
            if (r == 0) {
                rel = Relationship.GEQ;
            } else if (r == 1) {
                rel = Relationship.LEQ;
            } else {
                rel = Relationship.EQ;
            }
            constraints.add(new LinearConstraint(e, rel, data.consumeInt(-3, 3)));
        }

        return constraints;
    }

    private static ArrayList<LinearConstraint> scaleOneConstraint(FuzzedDataProvider data, List<LinearConstraint> original, int vars) {
        if (original.isEmpty()) {
            return null;
        }
        int idx = data.consumeInt(0, original.size() - 1);
        int factorInt = data.consumeInt(1, 4);
        double factor = factorInt;

        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>();
        for (int i = 0; i < original.size(); i++) {
            LinearConstraint lc = original.get(i);
            if (i != idx) {
                out.add(lc);
                continue;
            }
            double[] coeff = lc.getCoefficients().toArray();
            if (coeff.length != vars) {
                return null;
            }
            for (int j = 0; j < coeff.length; j++) {
                coeff[j] *= factor;
            }
            out.add(new LinearConstraint(coeff, lc.getRelationship(), lc.getValue() * factor));
        }
        return out;
    }

    private static void exerciseCase(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean restrictToNonNegative) {
        try {
            solve(f, constraints, restrictToNonNegative);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static PointValuePair solve(LinearObjectiveFunction f, Collection<LinearConstraint> constraints, boolean restrictToNonNegative) {
        SimplexSolver solver = new SimplexSolver();
        return solver.optimize(f, constraints, GoalType.MAXIMIZE, restrictToNonNegative);
    }

    private static void checkObjectiveValueInvariant(LinearObjectiveFunction f,
                                                     Collection<LinearConstraint> lhsConstraints,
                                                     Collection<LinearConstraint> rhsConstraints,
                                                     boolean restrictToNonNegative) {
        PointValuePair lhs;
        PointValuePair rhs;
        try {
            lhs = solve(f, lhsConstraints, restrictToNonNegative);
            rhs = solve(f, rhsConstraints, restrictToNonNegative);
        } catch (Throwable t) {
            return;
        }
        if (lhs == null || rhs == null) {
            return;
        }
        if (Double.isNaN(lhs.getValue()) || Double.isNaN(rhs.getValue())) {
            return;
        }
        if (Math.abs(lhs.getValue() - rhs.getValue()) > 1.0e-7) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent-constraints objective mismatch lhs="
                            + lhs.getValue() + " rhs=" + rhs.getValue()
                            + " lhsCount=" + lhsConstraints.size()
                            + " rhsCount=" + rhsConstraints.size());
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        if (t instanceof MathIllegalArgumentException) {
            return true;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            if (cn != null && cn.startsWith("org.apache.commons.math3.exception")) {
                if (!(t instanceof MaxCountExceededException) && !(t instanceof MathIllegalStateException)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
                    && "getPivotRow".equals(m)) {
