package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        boolean useNullObject = data.consumeBoolean();
        int width = data.consumeInt(1, 64);
        char padChar = (char) (data.consumeByte() & 0xff);

        String prefix = data.consumeString(32);
        String payload = data.consumeString(96);
        if (payload == null) {
            payload = "";
        }
        if (payload.length() < width) {
            String extra = data.consumeString(width - payload.length() + 8);
            if (extra == null) {
                extra = "";
            }
            while (payload.length() < width) {
                payload = payload + extra + "X";
            }
        }

        int initialCapacity;
        if (data.consumeBoolean()) {
            initialCapacity = Math.max(1, prefix.length() + width);
        } else {
            initialCapacity = data.consumeInt(1, Math.max(1, prefix.length() + width + 4));
        }

        if (useNullObject) {
            String nullText = payload;
            runCase(initialCapacity, prefix, null, width, padChar, true, nullText);
        } else {
            runCase(initialCapacity, prefix, payload, width, padChar, false, null);
        }

        String secondPrefix = data.consumeString(32);
        String secondPayload = data.consumeRemainingAsString();
        if (secondPayload == null) {
            secondPayload = "";
        }
        int secondWidth = width;
        if (secondPayload.length() < secondWidth) {
            while (secondPayload.length() < secondWidth) {
                secondPayload = secondPayload + "Y";
            }
        }
        int exactCapacity = Math.max(1, secondPrefix.length() + secondWidth);
        runCase(exactCapacity, secondPrefix, secondPayload, secondWidth, padChar, false, null);
    }

    private static void runAnchor() {
        runCase(1, "", "foo", 1, '-', false, null);
    }

    private static void runCase(int initialCapacity, String prefix, Object obj, int width, char padChar,
                                boolean setNullText, String nullTextValue) {
        StrBuilder sb = new StrBuilder(Math.max(1, initialCapacity));
        if (prefix != null && prefix.length() > 0) {
            sb.append(prefix);
        }
        if (setNullText) {
            try {
                sb.setNullText(nullTextValue);
            } catch (RuntimeException e) {
                if (isCleanRejection(e)) {
                    return;
                }
                if (isRootCause(e)) {
                    throw e;
                }
                return;
            }
        }

        String before;
        try {
            before = sb.toString();
        } catch (RuntimeException e) {
            return;
        }

        String source = (obj == null) ? sb.getNullText() : obj.toString();
        if (source == null || width <= 0) {
            return;
        }

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        String after;
        try {
            after = sb.toString();
        } catch (RuntimeException e) {
            return;
        }

        /*
         * Contract asserted:
         * appendFixedWidthPadRight(obj, width, padChar) must append exactly width characters;
         * if obj.toString().length() >= width it appends the leftmost width chars, otherwise it
         * appends the full string padded on the right. The failing test demonstrates this with
         * "foo", 1 -> "f". A throw-deleting or branch-skipping patch could avoid crashing yet
         * silently append the wrong text or wrong number of characters, so we verify observable
         * state via the real API after a successful call.
         */
        String expectedSuffix;
        if (source.length() >= width) {
            expectedSuffix = source.substring(0, width);
        } else {
            StringBuilder tmp = new StringBuilder(width);
            tmp.append(source);
            while (tmp.length() < width) {
                tmp.append(padChar);
            }
            expectedSuffix = tmp.toString();
        }
        String expected = before + expectedSuffix;

