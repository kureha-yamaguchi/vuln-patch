            constraints = bealeGeqScaled(factor);
        } else {
            constraints = bealeLeqScaled(factor);
        }

        if (rotate != 0) {
            Collections.rotate(constraints, rotate);
        }

        if (useMinimizeEquivalent) {
            f = new LinearObjectiveFunction(new double[] { -10.0, 57.0, 9.0, 24.0 }, 0.0);
        } else {
