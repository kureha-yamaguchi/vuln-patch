        if (gapIndex == -1) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd1 = data.consumeInt(left + 1, right - 1);
        int endOrd1 = data.consumeInt(startOrd1, right - 1);

        Day start1 = dayFromOrdinal(startOrd1);
        Day end1 = dayFromOrdinal(endOrd1);

        try {
            int sIdx = series.getIndex(start1);
            int eIdx = series.getIndex(end1);

            if (sIdx >= 0 || eIdx >= 0) {
