package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryBooleanCall("off");

        String generated = buildExplorationInput(data);
        tryBooleanCall(generated);

        int mode = data.consumeInt(0, 5);
        String base;
        switch (mode) {
            case 0:
                base = "true";
                break;
            case 1:
                base = "false";
                break;
            case 2:
                base = "on";
                break;
            case 3:
                base = "off";
                break;
            case 4:
                base = "yes";
                break;
            default:
                base = "no";
                break;
        }
        String variant = randomizeCase(base, data);
        checkEquivalentInputs(base, variant);

        String extra = data.consumeAsciiString(8);
        if (data.consumeBoolean()) {
            tryBooleanCall(variant + extra);
        } else {
            tryBooleanCall(extra + variant);
        }

        String raw = data.consumeString(8);
        tryBooleanCall(raw);
    }

    private static String buildExplorationInput(FuzzedDataProvider data) {
        int mode = data.consumeInt(0, 7);
        switch (mode) {
            case 0: {
                char first = data.consumeBoolean() ? 't' : 'T';
                char second = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                char third = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                return new String(new char[] { first, second, third });
            }
            case 1: {
                char first = data.consumeBoolean() ? 'y' : 'Y';
                char second = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                char third = (char) ('a' + Math.abs(data.consumeByte()) % 26);
                return new String(new char[] { first, second, third });
            }
            case 2:
                return randomizeCase("tru", data);
            case 3:
                return randomizeCase("off", data);
            case 4:
                return randomizeCase("false", data);
            case 5:
                return randomizeCase("yes", data);
            case 6:
                return randomizeCase("no", data);
            default:
                return data.consumeAsciiString(6);
        }
    }

    private static String randomizeCase(String s, FuzzedDataProvider data) {
        char[] chars = s.toCharArray();
        for (int i = 0; i < chars.length; i++) {
            chars[i] = data.consumeBoolean() ? Character.toUpperCase(chars[i]) : Character.toLowerCase(chars[i]);
        }
        return new String(chars);
    }

    private static void tryBooleanCall(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException e) {
            if (isCleanRejection(e)) {
                return;
            }
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement ste = stack[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static void checkEquivalentInputs(String canonical, String variant) {
        Boolean lhs;
        Boolean rhs;
        try {
            lhs = Boolean.valueOf(BooleanUtils.toBoolean(canonical));
            rhs = Boolean.valueOf(BooleanUtils.toBoolean(variant));
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted: this API performs case-insensitive parsing for the documented
         * boolean words handled by the patch ("true"/"false"/"on"/"off"/"yes"/"no").
         * Therefore any mixed-case variant of the same token must produce the same result
         * as its canonical lowercase form. A patch that merely disables the crashing path
         * or drops one of these branches can stop throwing yet silently return the wrong
         * boolean for some accepted tokens, which this relation catches.
         */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                "metamorphic violation: case-insensitive token equivalence input="
                    + variant + " lhs=" + lhs + " rhs=" + rhs);
        }
    }
}
