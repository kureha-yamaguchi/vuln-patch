            Integer oracle = NumberUtils.createInteger(canonicalInt);
            if (parsed == null || oracle == null
                    || !parsed.getClass().equals(Integer.class)
                    || parsed.intValue() != oracle.intValue()) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(decimal int) != createInteger same input input="
