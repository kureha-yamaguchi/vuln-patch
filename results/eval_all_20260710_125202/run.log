                double tol = Math.max(solver4.getAbsoluteAccuracy(), solver3.getAbsoluteAccuracy());
                if (Double.isNaN(r4) || Double.isNaN(r3) || Math.abs(r4 - r3) > tol) {
                    throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial) vs solve(f,min,max)"
                        + " input=[" + min + "," + max + "] initial=" + initial
