    private static void callTarget(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void checkMalformedMixedExponent(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: malformed mixed exponent must be rejected cleanly input=" + quote(s),
                        t);
            }
        }
    }

    private static void checkValidPlainDecimal(String s) {
        try {
            Float oracle = NumberUtils.createFloat(s);
            Number parsed = NumberUtils.createNumber(s);
            if (oracle != null && parsed != null
                    && (!(parsed instanceof Float) || oracle.floatValue() != parsed.floatValue())) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(valid plain decimal) != createFloat input="
                                + quote(s) + " lhs=" + describe(parsed) + " rhs=" + describe(oracle));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid plain decimal should not crash internally input=" + quote(s), t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cn)
                    && ("createNumber".equals(mn)
                    || "createInteger".equals(mn)
                    || "isAllZeros".equals(mn)
                    || "isDigits".equals(mn)
                    || "createLong".equals(mn)
                    || "createBigInteger".equals(mn)
                    || "createFloat".equals(mn)
                    || "createDouble".equals(mn)
                    || "createBigDecimal".equals(mn))) {
                return true;
            }
            if ("java.lang.String".equals(cn) && ("substring".equals(mn) || "charAt".equals(mn))) {
                return true;
            }
        }
        return false;
    }

    private static String digitsOnly(String s) {
        StringBuilder out = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            out.append((char) ('0' + (s.charAt(i) % 10)));
        }
        return out.toString();
    }

    private static String nonEmptyDigits(String s) {
        String out = digitsOnly(s);
        return out.length() == 0 ? "1" : out;
    }

    private static String quote(String s) {
        return "\"" + s + "\"";
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + String.valueOf(n);
    }
