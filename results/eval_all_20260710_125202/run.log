private static void tryCreateNumber(String s, boolean reportRootCause) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                if (reportRootCause) {
                    throw t;
                }
                return;
            }
        }
    }
