        int k = data.consumeInt(-32, 32);
        double center = k * Math.PI;

        double left = 0.01 + (Math.abs(data.consumeInt()) % 1000) / 1000.0;   // [0.01, 1.009]
        double right = 0.01 + (Math.abs(data.consumeInt()) % 1000) / 1000.0;  // [0.01, 1.009]

        double min = center - left;
        double max = center + right;
        if (min >= max) {
            return;
        }

        double initial;
