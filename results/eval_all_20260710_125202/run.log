    private static void exploreXYRange(FuzzedDataProvider data) {
        double base = (double) data.consumeInt();
        double extra = (double) data.consumeInt();
        int prefixCount = data.consumeInt(0, 4);
        boolean doEmptyCheck = data.consumeBoolean();

        if (doEmptyCheck) {
            XYPlot emptyPlot = new XYPlot();
            ValueMarker absent = new ValueMarker(base);
            try {
                boolean r1 = emptyPlot.removeRangeMarker(absent);
                boolean r2 = emptyPlot.removeRangeMarker(absent);
                if (r1 || r2) {
                    throw new RuntimeException(
                        "metamorphic violation: removing an absent range marker from a fresh XYPlot must stay false; input="
                            + base + " lhs=" + r1 + " rhs=" + r2);
                }
            } catch (RuntimeException t) {
                if (isValidationRejection(t)) {
                    return;
                }
                if (isWantedRootCause(t, "org.jfree.chart.plot.XYPlot", "removeRangeMarker")) {
                    throw t;
                }
                return;
            }
        }

        XYPlot plot = new XYPlot();
        for (int i = 0; i < prefixCount; i++) {
            try {
                plot.addRangeMarker(new ValueMarker(base + extra + i + 1.0));
            } catch (RuntimeException t) {
                if (isValidationRejection(t)) {
                    return;
                }
                return;
            }
        }

        ValueMarker marker = new ValueMarker(base);
        boolean firstRemoved;
        boolean secondRemoved;
        try {
            plot.addRangeMarker(marker);
            firstRemoved = plot.removeRangeMarker(marker);
            secondRemoved = plot.removeRangeMarker(marker);
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isWantedRootCause(t, "org.jfree.chart.plot.XYPlot", "removeRangeMarker")) {
                throw t;
            }
            return;
        }

        /*
         * Contract asserted: removeRangeMarker returns whether the marker was removed.
         * Therefore, after addRangeMarker(marker), the first removeRangeMarker(marker)
         * must return true, and a second removeRangeMarker(marker) must return false
         * because the marker is no longer present. A "fix" that only suppresses the
         * crash by returning false or by skipping the actual removal breaks this.
         */
        if (!firstRemoved || secondRemoved) {
            throw new RuntimeException(
                "metamorphic violation: add/remove/remove on XYPlot range markers must yield true then false; input="
                    + base + " prefixCount=" + prefixCount + " lhs=" + firstRemoved
                    + " rhs=" + secondRemoved);
        }
    }

    private static boolean isValidationRejection(Throwable t) {
        while (t != null) {
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return true;
            }
            String name = t.getClass().getName();
            if (name != null) {
                String lower = name.toLowerCase();
                if (lower.indexOf("invalid") >= 0 || lower.indexOf("validation") >= 0) {
                    return true;
                }
            }
            t = t.getCause();
        }
        return false;
    }

    private static boolean isWantedRootCause(Throwable t, String className, String methodName) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if (className.equals(e.getClassName()) && methodName.equals(e.getMethodName())) {
                return true;
            }
            if ("org.jfree.chart.plot.Plot".equals(e.getClassName())
                    && "fireChangeEvent".equals(e.getMethodName())) {
                return true;
            }
            if (className.equals(e.getClassName()) && "get".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }
