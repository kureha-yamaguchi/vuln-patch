package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        String prefix = data.consumeString(32);
        int width = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xff);
        boolean useNullObject = data.consumeBoolean();

        if (useNullObject) {
            String nullText = data.consumeString(64);
            if (nullText == null) {
                return;
            }
            explore(prefix, null, width, padChar, nullText);
        } else {
            String source = data.consumeString(64);
            if (source == null) {
                return;
            }
            explore(prefix, source, width, padChar, null);
        }
    }

    private static void anchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
            /*
             * Contract from appendFixedWidthPadRight: for width > 0 it appends exactly
             * a fixed-width field; when the source string is longer than width, the
             * leftmost width characters are appended. A throw-deleting or branch-skipping
             * patch would violate either the final length or the appended content.
             */
            String actual = sb.toString();
            if (sb.length() != 1 || !"f".equals(actual)) {
                throw new RuntimeException(
                        "metamorphic violation: fixed-width truncation contract input=foo width=1 pad=45 expected=f actual="
                                + actual + " len=" + sb.length());
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static void explore(String prefix, Object obj, int width, char padChar, String nullText) {
        String source = (obj == null) ? nullText : String.valueOf(obj);
        if (source == null) {
            return;
        }

        if (width <= 0) {
            return;
        }

        if (source.length() <= width) {
            return;
        }

        int prefixLen = prefix == null ? 0 : prefix.length();
        StrBuilder sb = new StrBuilder(prefixLen);
        if (nullText != null) {
            sb.setNullText(nullText);
        }

        try {
            if (prefixLen > 0) {
                sb.append(prefix);
            }

            int beforeLen = sb.length();
            String before = sb.toString();

            sb.appendFixedWidthPadRight(obj, width, padChar);

            /*
             * Contract from appendFixedWidthPadRight visible in the implementation:
             * on any successful call with width > 0, size increases by exactly width
             * and the appended segment is either the whole source plus right padding
             * or, when source.length() >= width, the leftmost width characters.
             * This observable post-condition catches "fixed" versions that merely avoid
             * the crash by skipping/truncating the branch incorrectly.
             */
            String actual = sb.toString();
            String expected = before + source.substring(0, width);

            if (sb.length() != beforeLen + width || !expected.equals(actual)) {
                throw new RuntimeException(
                        "metamorphic violation: appendFixedWidthPadRight must append exactly fixed-width content"
                                + " before=" + before
                                + " source=" + source
                                + " width=" + width
                                + " pad=" + (int) padChar
                                + " expected=" + expected
                                + " actual=" + actual
                                + " beforeLen=" + beforeLen
                                + " afterLen=" + sb.length()
                                + " usedNullObject=" + (obj == null)
                                + " nullText=" + nullText);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof RuntimeException) {
            String msg = t.getMessage();
            if (msg != null && msg.startsWith("metamorphic violation:")) {
                return true;
            }
        }

        if (!(t instanceof StringIndexOutOfBoundsException || t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }

        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if (!"org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())) {
                continue;
            }
            String m = e.getMethodName();
            if ("appendFixedWidthPadRight".equals(m) || "ensureCapacity".equals(m) || "getNullText".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
