            if (isRootCause(e)) {
                throw e;
            }
        } catch (Error e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static double positiveTenths(FuzzedDataProvider data, int minTenths, int maxTenths) {
        int lo = Math.min(minTenths, maxTenths);
        int hi = Math.max(minTenths, maxTenths);
        return data.consumeInt(lo, hi) / 10.0;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.jfree.chart.block.BorderArrangement".equals(e.getClassName())) {
