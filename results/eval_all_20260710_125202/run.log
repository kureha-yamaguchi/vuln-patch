        } catch (NumberFormatException ignored) {
        }

        StringBuilder fixed = new StringBuilder();
        if (data.consumeBoolean()) {
            fixed.append('-');
        }
        fixed.append(data.consumeInt(0, 999999));
        if (data.consumeBoolean()) {
            fixed.append('.');
            int fracLen = data.consumeInt(0, 12);
            for (int i = 0; i < fracLen; i++) {
