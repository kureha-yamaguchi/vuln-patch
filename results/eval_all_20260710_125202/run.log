package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.apache.commons.math3.exception.MaxCountExceededException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(buildAnchorObjective(), buildAnchorConstraints(), GoalType.MINIMIZE, true, true);

        int vars = Math.max(2, data.consumeInt(2, 8));
        LinearObjectiveFunction objective = buildObjective(data, vars);
        ArrayList<LinearConstraint> constraints = buildExplorationConstraints(data, vars);
        boolean nonNegative = data.consumeBoolean();
        GoalType goal = data.consumeBoolean() ? GoalType.MINIMIZE : GoalType.MAXIMIZE;

        runCase(objective, constraints, goal, nonNegative, false);
    }

    private static void runCase(LinearObjectiveFunction objective,
                                List<LinearConstraint> constraints,
                                GoalType goal,
                                boolean nonNegative,
                                boolean isAnchor) {
        try {
            SimplexSolver solver = new SimplexSolver();
            PointValuePair lhs = solver.optimize(objective, constraints, goal, nonNegative);

            ArrayList<LinearConstraint> permuted = new ArrayList<LinearConstraint>(constraints);
            Collections.reverse(permuted);
            SimplexSolver solver2 = new SimplexSolver();
            PointValuePair rhs = solver2.optimize(objective, permuted, goal, nonNegative);

            if (lhs != null && rhs != null) {
                double lv = lhs.getValue();
                double rv = rhs.getValue();
                if (!approximatelyEqual(lv, rv)) {
                    throw new RuntimeException(
                        "metamorphic violation: reversing constraint order changed optimum value input="
                            + summarize(objective, constraints, goal, nonNegative)
                            + " lhs=" + lv + " rhs=" + rv);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isAnchor && t instanceof RuntimeException) {
                if (isRootCause(t)) {
                    throw (RuntimeException) t;
                }
            }
        }
    }

    private static LinearObjectiveFunction buildAnchorObjective() {
        double[] c = new double[31];
        c[0] = 1.0;
        return new LinearObjectiveFunction(c, 0.0);
    }

    private static ArrayList<LinearConstraint> buildAnchorConstraints() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        constraints.add(new LinearConstraint(new double[] {
            0.0, 16.0, 14.0, 69.0, 1.0, 85.0, 52.0, 43.0, 64.0, 97.0,
            14.0, 74.0, 89.0, 28.0, 94.0, 58.0, 13.0, 22.0, 21.0, 17.0,
            30.0, 25.0, 1.0, 59.0, 91.0, 78.0, 12.0, 74.0, 56.0, 3.0, 88.0
        }, Relationship.GEQ, 91.0));
        constraints.add(new LinearConstraint(new double[] {
            0.0, 60.0, 40.0, 81.0, 71.0, 72.0, 46.0, 45.0, 38.0, 48.0,
            40.0, 17.0, 33.0, 85.0, 64.0, 32.0, 84.0, 3.0, 54.0, 44.0,
            71.0, 67.0, 90.0, 95.0, 54.0, 99.0, 99.0, 29.0, 52.0, 98.0, 9.0
        }, Relationship.GEQ, 54.0));
        constraints.add(new LinearConstraint(new double[] {
            0.0, 41.0, 12.0, 86.0, 90.0, 61.0, 31.0, 41.0, 23.0, 89.0,
            17.0, 74.0, 44.0, 27.0, 16.0, 47.0, 80.0, 32.0, 11.0, 56.0,
            68.0, 82.0, 11.0, 62.0, 62.0, 53.0, 39.0, 16.0, 48.0, 1.0, 63.0
        }, Relationship.GEQ, 62.0));

        constraints.add(new LinearConstraint(onlyAt(31, 0, 1.0), Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(onlyAt(31, 0, 1.0), Relationship.LEQ, 1.0));

        for (int i = 1; i < 31; i++) {
            constraints.add(new LinearConstraint(onlyAt(31, i, 1.0), Relationship.GEQ, 0.0));
            constraints.add(new LinearConstraint(onlyAt(31, i, 1.0), Relationship.LEQ, 100.0));
        }

        return constraints;
    }

    private static LinearObjectiveFunction buildObjective(FuzzedDataProvider data, int vars) {
        double[] c = new double[vars];
        c[0] = 1.0;
        for (int i = 1; i < vars; i++) {
            c[i] = data.consumeInt(-2, 2);
        }
        return new LinearObjectiveFunction(c, data.consumeInt(-3, 3));
    }

    private static ArrayList<LinearConstraint> buildExplorationConstraints(FuzzedDataProvider data, int vars) {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

        int dupCount = data.consumeInt(2, 5);
        double baseCoeff = positiveSmall(data);
        double rhs = positiveSmall(data);

        double[] duplicate = new double[vars];
        duplicate[0] = baseCoeff;
        for (int j = 1; j < vars; j++) {
            duplicate[j] = data.consumeInt(0, 5);
        }
        for (int i = 0; i < dupCount; i++) {
            constraints.add(new LinearConstraint(copyOf(duplicate), Relationship.GEQ, rhs));
        }

        int extra = data.consumeInt(1, 8);
        for (int i = 0; i < extra; i++) {
            double[] coeff = new double[vars];
            int kind = data.consumeInt(0, 3);

            if (kind == 0) {
                coeff[0] = baseCoeff;
                for (int j = 1; j < vars; j++) {
                    coeff[j] = data.consumeInt(0, 6);
                }
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, rhs));
            } else if (kind == 1) {
                coeff[0] = data.consumeInt(1, 6);
                for (int j = 1; j < vars; j++) {
                    coeff[j] = data.consumeInt(-2, 6);
                }
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, positiveSmall(data)));
            } else if (kind == 2) {
                int idx = data.consumeInt(0, vars - 1);
                coeff[idx] = 1.0;
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, 0.0));
            } else {
                int idx = data.consumeInt(0, vars - 1);
                coeff[idx] = 1.0;
                constraints.add(new LinearConstraint(coeff, Relationship.LEQ, data.consumeInt(1, 10)));
            }
        }

        return constraints;
    }

    private static double positiveSmall(FuzzedDataProvider data) {
        return (double) data.consumeInt(1, 10);
    }

    private static double[] onlyAt(int len, int idx, double v) {
        double[] a = new double[len];
        a[idx] = v;
        return a;
    }

    private static double[] copyOf(double[] in) {
        double[] out = new double[in.length];
        System.arraycopy(in, 0, out, 0, in.length);
        return out;
    }

    private static boolean approximatelyEqual(double a, double b) {
        if (Double.isNaN(a) || Double.isNaN(b)) {
            return false;
        }
        if (Double.isInfinite(a) || Double.isInfinite(b)) {
            return a == b;
        }
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return Math.abs(a - b) <= 1.0e-7 * scale;
    }

