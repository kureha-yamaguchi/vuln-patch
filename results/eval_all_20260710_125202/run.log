package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistributionImpl standard = new NormalDistributionImpl(0.0, 1.0);

        // ANCHOR: exact failing test input.
        exerciseInverse(standard, 0.9772498680518209, Double.valueOf(2.0), true);

        // EXPLORE: construct valid probabilities via the real public API so that
        // inverseCumulativeProbability(cumulativeProbability(x)) should recover x.
        // Choosing integer x values often makes the bracket search land exactly on a root
        // at an endpoint (fa == 0 or fb == 0), which is the patched root cause.
        int x1 = data.consumeInt(-64, 64);
        exploreRoundTrip(standard, x1);

        int x2 = data.consumeInt(-64, 64);
        exploreRoundTrip(standard, x2);

        int x3 = data.consumeInt(-256, 256);
        exploreRoundTrip(standard, x3);

        // Also vary mean and sigma while keeping inputs valid by construction.
        double mean = data.consumeInt(-50, 50);
        double sigma = 1.0 + Math.abs(data.consumeInt(-20, 20));
        NormalDistributionImpl shifted = new NormalDistributionImpl(mean, sigma);

        int k1 = data.consumeInt(-16, 16);
        double point1 = mean + (k1 * sigma);
        exploreRoundTrip(shifted, point1);

        int k2 = data.consumeInt(-16, 16);
        double point2 = mean + (k2 * sigma);
        exploreRoundTrip(shifted, point2);

        // A few direct valid probabilities too; correct implementations must either
        // return a quantile or cleanly reject only invalid inputs. These are valid.
        if (data.remainingBytes() >= 4) {
            int raw = data.consumeInt();
            double p = ((raw & 0x7fffffff) / (double) Integer.MAX_VALUE);
            if (p > 0.0 && p < 1.0) {
                exerciseInverse(standard, p, null, true);
            }
        }
    }

    private static void exploreRoundTrip(NormalDistributionImpl dist, double x) {
        try {
            double p = dist.cumulativeProbability(x);
            if (p > 0.0 && p < 1.0) {
                exerciseInverse(dist, p, Double.valueOf(x), true);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static void exerciseInverse(NormalDistributionImpl dist, double p, Double expectedX, boolean validByConstruction) {
        double q;
        try {
            q = dist.inverseCumulativeProbability(p);
        } catch (Throwable t) {
            if (isCleanRejection(t) && !validByConstruction) {
                return;
            }
            if (isRootCause(t) && validByConstruction) {
                throw rethrow(t);
            }
            return;
        }

        if (expectedX != null) {
            if (Math.abs(q - expectedX.doubleValue()) > 1.0e-12) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) must recover x for valid x; x="
                        + expectedX + " p=" + p + " q=" + q);
            }
        }

        // Contract-based metamorphic check:
        // For a distribution, cumulativeProbability(inverseCumulativeProbability(p)) == p
        // for valid probabilities. A "fix" that merely suppresses the throw or skips
        // the intended bracketing behavior can silently return the wrong quantile; this
        // round-trip exposes that wrong-output bug.
        try {
            double p2 = dist.cumulativeProbability(q);
            if (Math.abs(p2 - p) > 1.0e-12) {
                throw new RuntimeException(
                    "metamorphic violation: cdf(inv(p)) must equal p for valid p; p="
                        + p + " q=" + q + " cdf(q)=" + p2);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw rethrow(t);
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException && hasBracketFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasBracketFrame(Throwable t) {
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(ste.getClassName())
                    && "bracket".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        FuzzHarness.<RuntimeException>sneakyThrow(t);
        return null;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
