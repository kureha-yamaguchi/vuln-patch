                return;
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: valid range before first item should be accepted and yield empty series",
                        e);
                }
                return;
            }
        }

        int gapIndex = findGap(ords);
        if (gapIndex == -1) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);

        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            int startIndex = series.getIndex(start);
            int endIndex = series.getIndex(end);

            /* Contract exercised from real API:
             * when start/end are valid non-null periods with start <= end and both lie strictly
             * inside the same gap in a sorted TimeSeries, there are no matching data items, so
             * createCopy(start, end) must return an empty TimeSeries rather than reject or invent
             * items. A throw-deleting or bookkeeping-breaking patch would violate this observable
             * itemCount post-condition or disagreement with same-gap copies below.
             */
            if (startIndex >= 0 || endIndex >= 0) {
                return;
            }
            int insertionPoint = -(startIndex + 1);
            int endBefore = -(endIndex + 1) - 1;
            if (endBefore >= insertionPoint) {
                return;
            }

            TimeSeries gapCopy = series.createCopy(start, end);
            if (gapCopy == null) {
                throw new RuntimeException("metamorphic violation: gap copy returned null");
            }
            if (gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: copy wholly inside gap must be empty startOrd=" + startOrd
                        + " endOrd=" + endOrd
                        + " itemCount=" + gapCopy.getItemCount());
