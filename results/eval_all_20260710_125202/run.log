package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.analysis.polynomials.PolynomialFunction;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchorNormal();
        exploreNormal(data);
        exploreBracketEndpointRoot(data);
    }

    private static void anchorNormal() {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            double p = 0.9772498680518209d;
            double x = normal.inverseCumulativeProbability(p);
            double back = normal.cumulativeProbability(x);
            if (Math.abs(x - 2.0d) > 1.0e-12d || Math.abs(back - p) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: normal inverse/cdf anchor input=" + p + " x=" + x + " back=" + back);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isDuplicateKnownRootCause(t)) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            sneakyThrow(t);
        }
    }

    private static void exploreNormal(FuzzedDataProvider data) {
        try {
            NormalDistribution normal = new NormalDistributionImpl(0, 1);
            int n = data.consumeInt(-8, 8);
            double p = normal.cumulativeProbability((double) n);
            double x = normal.inverseCumulativeProbability(p);

            /* Contract used: inverseCumulativeProbability is the inverse of cumulativeProbability on valid probabilities.
               For p constructed by p = cumulativeProbability(n), a correct implementation must recover n (within numerical tolerance).
               A throw-deleting or branch-skipping patch in the bracketing logic can silently return a wrong quantile instead. */
            if (Math.abs(x - (double) n) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: normal inverse(cdf(n)) input=" + n + " p=" + p + " x=" + x);
            }

            double back = normal.cumulativeProbability(x);
            if (Math.abs(back - p) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: normal cdf(inverse(p)) input=" + n + " p=" + p + " x=" + x + " back=" + back);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isDuplicateKnownRootCause(t)) {
                return;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            sneakyThrow(t);
        }
    }

    private static void exploreBracketEndpointRoot(FuzzedDataProvider data) {
        int initial = data.consumeInt(-50, 50);
        int steps = data.consumeInt(1, 20);
        boolean hitUpperEndpoint = data.consumeBoolean();
        int scale = data.consumeInt(-20, 20);
        if (scale == 0) {
            scale = 1;
        }

        int root = hitUpperEndpoint ? initial + steps : initial - steps;
        double lower = Math.min(initial - steps - 5, root - 5);
        double upper = Math.max(initial + steps + 5, root + 5);
        int maxIterations = steps + data.consumeInt(0, 5);

        PolynomialFunction f = new PolynomialFunction(new double[] { -((double) scale) * ((double) root), (double) scale });

        try {
            double[] bracket = UnivariateRealSolverUtils.bracket(f, (double) initial, lower, upper, maxIterations);

            /* Contract used: bracket returns an interval bracketing a root; from the method logic, failure is only justified when
               the sampled endpoint values do not bracket a root after the search. Our inputs are valid by construction and place
               an exact root at one searched endpoint, so any correct implementation must return an interval whose endpoint value is
               exactly zero or whose endpoint values have opposite signs. A patch that merely deletes the throw or corrupts the
               stopping logic can return a non-bracketing interval, which this post-condition detects. */
            double fa = f.value(bracket[0]);
            double fb = f.value(bracket[1]);
            boolean ok = (fa == 0.0d) || (fb == 0.0d) || (fa * fb < 0.0d);
            if (!ok) {
                throw new RuntimeException(
                    "metamorphic violation: bracket must contain endpoint root or sign change"
                        + " initial=" + initial
                        + " steps=" + steps
                        + " root=" + root
                        + " lower=" + lower
                        + " upper=" + upper
                        + " maxIterations=" + maxIterations
                        + " a=" + bracket[0]
                        + " b=" + bracket[1]
                        + " fa=" + fa
                        + " fb=" + fb);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseAtBracket(t)) {
                sneakyThrow(t);
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean isDuplicateKnownRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(e.getClassName())
                    && "inverseCumulativeProbability".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCauseAtBracket(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String c = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(c) && "bracket".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.MathRuntimeException".equals(c) && "createIllegalArgumentException".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.analysis.polynomials.PolynomialFunction".equals(c) && "<init>".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.exception.util.MessageFactory".equals(c) && "buildMessage".equals(m)) {
                return true;
            }
            if ("org.apache.commons.math.analysis.polynomials.PolynomialFunction".equals(c) && "value".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Invalid") || name.contains("Illegal") || name.contains("OutOfRange")) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
