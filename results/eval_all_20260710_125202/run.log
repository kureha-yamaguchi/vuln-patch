public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        checkValidPlainDecimal("1234.5");

        exerciseKnownLiteral("12345");
        exerciseKnownLiteral("1234.5D");
        exerciseKnownLiteral("1234.5d");
        exerciseKnownLiteral("1234.5F");
        exerciseKnownLiteral("1234.5f");
        exerciseKnownLiteral("12345L");
        exerciseKnownLiteral("12345l");
        exerciseKnownLiteral("-1234.5");
        exerciseKnownLiteral("-12345");
        exerciseKnownLiteral("0xFADE");
        exerciseKnownLiteral("-0xFADE");
        exerciseKnownLiteral("1.1E200");
        exerciseKnownLiteral("1.1E20");
        exerciseKnownLiteral("-1.1E200");
        exerciseKnownLiteral("1.1E-200");
        exerciseKnownLiteral("12345678901234567890L");
        exerciseKnownLiteral("1.1E-700F");
        exerciseKnownLiteral("2.");
        exerciseKnownLiteral("-1l");
        exerciseKnownLiteral("01l");
        exerciseKnownLiteral("1l");
        exerciseMalformed("1eE");

        String left = nonEmptyDigits(data.consumeAsciiString(data.consumeInt(0, 8)));
        String middle = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 8)));
        String right = digitsOnly(data.consumeAsciiString(data.consumeInt(0, 8)));
        String sign = data.consumeBoolean() ? "-" : "";

        exerciseMalformed(left + "e" + middle + "E" + right);
        exerciseMalformed(left + "E" + middle + "e" + right);
        exerciseMalformed(sign + left + "eE");
        exerciseMalformed(sign + left + "E" + middle + "e");
        exerciseMalformed(sign + left + "e" + middle + "E");

        /*
         * Contract: for a valid decimal string with a decimal point and no suffix,
         * createNumber goes through the library's floating-point parsing path and,
         * for small finite decimals like the ones built here, should agree with
         * createFloat on both type and value. A patch that merely skips the intended
         * path or silently changes the result violates this observable relation.
         */
        String frac = nonEmptyDigits(data.consumeAsciiString(data.consumeInt(0, 8)));
        checkValidPlainDecimal(sign + left + "." + frac);

        /*
         * Contract: for canonical base-10 integers that fit in int, createNumber
         * first tries createInteger and must return the same Integer result.
         */
        String canonicalInt = Integer.toString(data.consumeInt());
        checkCanonicalInteger(canonicalInt);

        /*
         * Contract: inputs beginning with 0x or -0x are delegated by createNumber
         * to createInteger; both real entry points must therefore agree.
         */
        String hex = (data.consumeBoolean() ? "-0x" : "0x")
                + nonEmptyHex(data.consumeAsciiString(data.consumeInt(0, 12)));
        checkHexEquivalence(hex);

        /*
