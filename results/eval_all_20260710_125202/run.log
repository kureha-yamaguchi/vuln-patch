package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression input from BisectionSolverTest.testMath369.
        try {
            BisectionSolver solver = new BisectionSolver();
            double result = solver.solve(f, 3.0, 3.2, 3.1);
            double expected = Math.PI;
            double tol = Math.max(solver.getAbsoluteAccuracy(), 1e-12);
            if (Double.isNaN(result) || Math.abs(result - expected) > tol) {
                throw new RuntimeException("metamorphic violation: anchor expected pi input=[3.0,3.2,3.1] result=" + result + " expected=" + expected);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
        }

        // EXPLORE: generate many valid brackets around a real SinFunction root.
        // Property: call the public BisectionSolver API solve(f, min, max, initial)
        // with a non-null real function and a valid interval containing a root.
        // On buggy code, the function argument is lost and a NullPointerException
        // emerges from BisectionSolver.solve. On fixed code, these inputs are valid.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        double left = 1.0e-6 + (data.consumeInt(0, 1_000_000) / 1_000_000.0);
        double right = 1.0e-6 + (data.consumeInt(0, 1_000_000) / 1_000_000.0);
        double min = root - left;
        double max = root + right;

        double initial;
        switch (Math.abs(data.consumeInt()) % 4) {
            case 0:
                initial = root;
                break;
            case 1:
                initial = min;
                break;
            case 2:
                initial = max;
                break;
            default:
                double span = max - min;
                double frac = (data.consumeInt(0, 1_000_000) / 1_000_000.0);
                initial = min + frac * span;
                break;
        }

        // Mandatory post-condition / metamorphic check:
        // For BisectionSolver, the "initial" parameter is irrelevant to the algorithm,
        // and the patched method explicitly delegates solve(f, min, max, initial) to
        // solve(f, min, max). Therefore, for any valid bracket and real function, both
        // public API calls must agree. A throw-deleting or wrong-delegation patch can
        // make the 4-arg call return a wrong result or skip the intended behavior; this
        // relation catches that even when no exception is thrown.
        Double lhs = null;
        Double rhs = null;
        try {
            BisectionSolver solver1 = new BisectionSolver();
            lhs = solver1.solve(f, min, max, initial);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        try {
            BisectionSolver solver2 = new BisectionSolver();
            rhs = solver2.solve(f, min, max);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (lhs != null && rhs != null) {
            double tol = Math.max(new BisectionSolver().getAbsoluteAccuracy(), 1e-12);
            if (Double.isNaN(lhs.doubleValue()) != Double.isNaN(rhs.doubleValue())
                    || (!Double.isNaN(lhs.doubleValue()) && Math.abs(lhs.doubleValue() - rhs.doubleValue()) > tol)) {
                throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                                + " input=[k=" + k
                                + ", min=" + min
                                + ", max=" + max
                                + ", initial=" + initial
                                + "] lhs=" + lhs
                                + " rhs=" + rhs);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("ConvergenceException")
                || n.contains("MaxIterationsExceededException")
                || n.contains("FunctionEvaluationException")
                || n.contains("MathRuntimeException");
    }

    private static void throwUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
