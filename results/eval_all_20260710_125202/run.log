package org.joda.time.format;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;
import org.joda.time.DateTimeZone;
import org.joda.time.MutableDateTime;

public class FuzzHarness {
    private static final DateTimeFormatter FORMATTER =
            DateTimeFormat.forPattern("M d").withLocale(Locale.UK);
    private static final DateTimeZone NEW_YORK = DateTimeZone.forID("America/New_York");
    private static final DateTimeZone TOKYO = DateTimeZone.forID("Asia/Tokyo");

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runValidCase(true, 2004, "2 29", 0, 2, 29);
        runValidCase(false, 2004, "2 29", 0, 2, 29);

        boolean useNewYork = data.consumeBoolean();
        int leapYear = 2000 + 4 * data.consumeInt(0, 24);

        String prefix = data.consumeAsciiString(16);
        String suffix = data.consumeAsciiString(16);

        int month;
        int day;
        if (data.consumeBoolean()) {
            month = 2;
            day = 29;
        } else {
            month = data.consumeInt(1, 12);
            day = validDayForLeapYear(month, data);
        }

        String core = Integer.toString(month) + " " + Integer.toString(day);
        String text = prefix + core + suffix;
        int position = prefix.length();

        runValidCase(useNewYork, leapYear, text, position, month, day);
    }

    private static int validDayForLeapYear(int month, FuzzedDataProvider data) {
        switch (month) {
            case 2:
                return data.consumeInt(1, 29);
            case 4:
            case 6:
            case 9:
            case 11:
                return data.consumeInt(1, 30);
            default:
                return data.consumeInt(1, 31);
        }
    }

    private static void runValidCase(boolean newYorkCase, int year, String text, int position, int month, int day) {
        MutableDateTime result = newYorkCase
                ? new MutableDateTime(year, 1, 1, 0, 0, 0, 0, NEW_YORK)
                : new MutableDateTime(year, 12, 31, 23, 59, 59, 999, TOKYO);

        final int expectedHour = result.getHourOfDay();
        final int expectedMinute = result.getMinuteOfHour();
        final int expectedSecond = result.getSecondOfMinute();
        final int expectedMillis = result.getMillisOfSecond();
        final DateTimeZone expectedZone = result.getZone();
        final int expectedNewPos = position + (Integer.toString(month) + " " + Integer.toString(day)).length();

        try {
            int newPos = FORMATTER.parseInto(result, text, position);

            /* Contract asserted by the public API as exercised by the regression tests:
             * parsing "M d" into an existing MutableDateTime consumes exactly the parsed token
             * and updates the instant to the parsed month/day while preserving the original
             * time-of-day and zone. A patch that only suppresses the exception or skips the
             * year/default-year bookkeeping could return without throwing but leave the wrong
             * date or wrong parse position, so we check both observables here.
             */
            if (newPos != expectedNewPos) {
                throw new RuntimeException(
                        "metamorphic violation: parseInto consumed unexpected length input="
                                + quote(text) + " position=" + position + " expectedPos="
                                + expectedNewPos + " actualPos=" + newPos);
            }
            if (result.getYear() != year
                    || result.getMonthOfYear() != month
                    || result.getDayOfMonth() != day
                    || result.getHourOfDay() != expectedHour
                    || result.getMinuteOfHour() != expectedMinute
                    || result.getSecondOfMinute() != expectedSecond
                    || result.getMillisOfSecond() != expectedMillis
                    || !result.getZone().equals(expectedZone)) {
                throw new RuntimeException(
                        "metamorphic violation: parseInto produced wrong instant input="
                                + quote(text) + " position=" + position
                                + " expected=" + describe(year, month, day, expectedHour, expectedMinute,
                                        expectedSecond, expectedMillis, expectedZone)
                                + " actual=" + describe(result.getYear(), result.getMonthOfYear(),
                                        result.getDayOfMonth(), result.getHourOfDay(),
                                        result.getMinuteOfHour(), result.getSecondOfMinute(),
                                        result.getMillisOfSecond(), result.getZone()));
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)
                && !(t instanceof NumberFormatException)
                && !t.getClass().getName().startsWith("org.joda.time.")) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.joda.time.format.DateTimeFormatter".equals(cls)
                    && ("parseInto".equals(method)
                        || "selectChronology".equals(method)
                        || "requireParser".equals(method))) {
                return true;
            }
            if ("org.joda.time.format.DateTimeParserBucket".equals(cls)
                    && "getOffset".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return "\"" + s + "\"";
    }

    private static String describe(int year, int month, int day,
                                   int hour, int minute, int second, int millis,
                                   DateTimeZone zone) {
        return year + "-" + month + "-" + day + "T"
                + hour + ":" + minute + ":" + second + "." + millis
                + "@" + zone.getID();
    }
}
