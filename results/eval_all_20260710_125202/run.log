package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(1, "", "foo", 1, '-', false, null);

        int initialCapacity = Math.max(1, data.consumeInt(1, 64));
        String prefix = data.consumeString(32);
        String objString = data.consumeString(64);
        int width = data.consumeInt(-8, 64);
        char padChar = (char) (data.consumeByte() & 0xFF);
        boolean useNullObject = data.consumeBoolean();
        boolean setNullText = data.consumeBoolean();
        String nullTextValue = data.consumeBoolean() ? null : data.consumeString(64);

        if (useNullObject) {
            runCase(initialCapacity, prefix, null, width, padChar, setNullText, nullTextValue);
        } else {
