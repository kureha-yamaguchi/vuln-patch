    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();
        registry.put("lower", LOWER_FACTORY);

        // ANCHOR: exact regression-test trigger. On the buggy version this should
        // reach ExtendedMessageFormat.appendQuotedString during construction.
        String anchorPattern = "it''s a {0,lower} 'test'!";
        ExtendedMessageFormat anchor = new ExtendedMessageFormat(anchorPattern, registry);
        String anchorOut = anchor.format(new Object[] { "DUMMY" });
        if (!"it's a dummy test!".equals(anchorOut)) {
            throw new RuntimeException(
                "metamorphic violation: anchor formatting mismatch input=" + anchorPattern
                    + " lhs=" + anchorOut + " rhs=it's a dummy test!");
        }

        // EXPLORE: the behavioral difference in the patch is for inputs where
        // appendQuotedString(..., escapingOn=true) starts on a quote character.
        // That happens on doubled quotes ('') while parsing patterns containing
        // custom formats. Generate many such patterns, but always keep them
        // syntactically valid and ensure they contain {0,lower}.
        String a = sanitize(data.consumeAsciiString(24));
        String b = sanitize(data.consumeAsciiString(24));
        String c = sanitize(data.consumeAsciiString(24));
        String d = sanitize(data.consumeAsciiString(24));
        String arg = data.consumeString(24);

