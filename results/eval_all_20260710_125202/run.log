                break;
            case 1:
                invalidMean = -1.0d * data.consumeInt(1, 1000000);
                break;
            case 2:
                invalidMean = -((double) data.consumeInt(1, 1000000)) / (double) data.consumeInt(1, 1000000);
                break;
            case 3:
                invalidMean = -((double) data.consumeByte());
                if (invalidMean > 0.0d) {
                    invalidMean = -invalidMean;
                }
                break;
            case 4:
                invalidMean = -((double) data.consumeInt());
                if (invalidMean > 0.0d) {
                    invalidMean = -invalidMean;
                }
                break;
            default:
                invalidMean = -0.0d;
                break;
        }
        if (invalidMean > 0.0d) {
            invalidMean = -invalidMean;
        }

        boolean useOneArg = data.consumeBoolean();
        double epsilon = ((double) data.consumeInt(1, 1000000)) / 1000000.0d;
        int maxIterations = data.consumeInt(1, 1000000);
        exerciseInvalidMean(invalidMean, useOneArg, epsilon, maxIterations);

        // POST-CONDITION / METAMORPHIC CHECK:
        // The constructor stores the supplied mean ("mean = p"), and getMean()
        // must therefore return that same positive value for any valid mean.
        // Also, both public constructors taking the same valid mean must agree on it.
        // A bad patch that deletes assignment/bookkeeping or otherwise silently
        // constructs the object with the wrong mean would violate this without throwing.
        double validMean = buildPositiveMean(data);
        checkMeanPreserved(validMean, epsilon, maxIterations);
    }

    private static void exerciseInvalidMean(double mean, boolean useOneArg, double epsilon, int maxIterations) {
        try {
            if (useOneArg) {
                new PoissonDistributionImpl(mean);
            } else {
                new PoissonDistributionImpl(mean, epsilon, maxIterations);
            }
            throw new RuntimeException("metamorphic violation: invalid Poisson mean was accepted mean=" + mean
                    + " useOneArg=" + useOneArg + " epsilon=" + epsilon + " maxIterations=" + maxIterations);
        } catch (Throwable t) {
            if (isRootCause(t)) {
                rethrowUnchecked(t);
            }
            if (isCleanRejection(t)) {
                return;
            }
