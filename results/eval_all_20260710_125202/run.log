package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        invokeAndPropagateRootCause("off");

        String explored = buildThreeCharNonYesPrefix(data);
        invokeAndPropagateRootCause(explored);

        if (data.consumeBoolean()) {
            String extra = data.consumeAsciiString(16);
            invokeAndPropagateRootCause(extra);
        }

        if (data.consumeBoolean()) {
            String arbitrary = data.consumeString(32);
            invokeAndPropagateRootCause(arbitrary);
        }

        // Contract asserted from BooleanUtils.toBoolean(String) behavior and the provided tests:
        // the parser is case-insensitive for the accepted true literals "true", "on", and "yes".
        // A patch that merely deletes the crashing access or makes the buggy branch unreachable
        // must still preserve these observable results; otherwise it silently changes semantics.
        checkConstructedTrueLiteral(data, "true");
        checkConstructedTrueLiteral(data, "yes");
        checkConstructedTrueLiteral(data, "on");

        // Additional observable contract from the failing test: "off" must evaluate to false.
        // On the buggy version this input crashes; on a correct fix it must return false.
        try {
            boolean off = BooleanUtils.toBoolean(new String(new char[] {'o', 'f', 'f'}));
            if (off) {
                throw new RuntimeException("metamorphic violation: canonical false literal input=off lhs=" + off + " rhs=false");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void invokeAndPropagateRootCause(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildThreeCharNonYesPrefix(FuzzedDataProvider data) {
        char first = (char) (data.consumeByte() & 0x7f);
        if (first == 'y' || first == 'Y') {
            first = 'o';
        }

        String tail = data.consumeAsciiString(2);
        StringBuilder sb = new StringBuilder(3);
        sb.append(first);
        if (tail.length() >= 1) {
            sb.append(tail.charAt(0));
        } else {
            sb.append((char) ('a' + data.consumeInt(0, 25)));
        }
        if (tail.length() >= 2) {
            sb.append(tail.charAt(1));
        } else {
            sb.append((char) ('a' + data.consumeInt(0, 25)));
        }
        return sb.toString();
    }

    private static void checkConstructedTrueLiteral(FuzzedDataProvider data, String canonical) {
        String variant = randomAsciiCase(data, canonical);
        try {
            boolean result = BooleanUtils.toBoolean(variant);
            if (!result) {
                throw new RuntimeException("metamorphic violation: case-insensitive true literal input=" + variant + " lhs=" + result + " rhs=true");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static String randomAsciiCase(FuzzedDataProvider data, String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (data.consumeBoolean()) {
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(Character.toLowerCase(ch));
            }
        }
        return sb.toString();
    }
}
