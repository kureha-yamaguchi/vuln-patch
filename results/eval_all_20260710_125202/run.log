package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new RuntimeException("anchor parse failed");
        }

        exerciseRegressionAnchors();

        requireUppercaseHexAgreement("0Xfade");
        requireUppercaseHexAgreement("-0Xfade");

        tryCreateNumber(data.consumeString(64));

        String upperHex = buildValidUppercaseHexLiteral(data);
        requireUppercaseHexAgreement(upperHex);

        String lowerHex = upperHex.startsWith("-0X")
                ? "-0x" + upperHex.substring(3)
                : "0x" + upperHex.substring(2);
        requireEquivalentHexPrefixes(upperHex, lowerHex);

        String canonicalInt = Integer.toString(data.consumeInt());
        requireCanonicalDecimalAgreement(canonicalInt);

        tryCreateNumber(buildLongLiteral(data));
        tryCreateNumber(buildScientificLiteral(data));
        tryCreateNumber(buildFixedPointLiteral(data));
        tryCreateNumber(buildBigIntegerLiteral(data));
        tryCreateNumber(data.consumeRemainingAsString());
    }

    private static void exerciseRegressionAnchors() {
        String[] literals = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "0Xfade",
                "-0xFADE",
                "-0Xfade",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                "-1l",
                "01l",
                "1l",
                "1eE"
        };
        for (int i = 0; i < literals.length; i++) {
            tryCreateNumber(literals[i]);
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isRootCauseThrowable(t)) {
                throw t;
            }
        }
    }

    private static void requireUppercaseHexAgreement(String s) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(s);
        } catch (RuntimeException ignored) {
            tryCreateNumber(s);
            return;
        }

        try {
            Number actual = NumberUtils.createNumber(s);
            if (actual == null) {
                throw new RuntimeException("metamorphic violation: valid uppercase hex returned null input=" + s);
            }
            if (actual.intValue() != expected.intValue()) {
                throw new RuntimeException(
                        "metamorphic violation: uppercase hex oracle mismatch input=" + s
                                + " lhs=" + actual.intValue()
                                + " rhs=" + expected.intValue());
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                throw new RuntimeException("metamorphic violation: createNumber rejected valid uppercase hex input=" + s, t);
            }
            if (isRootCauseThrowable(t)) {
                throw new RuntimeException("metamorphic violation: uppercase hex triggered root-cause rejection input=" + s, t);
            }
        }
    }

    private static void requireEquivalentHexPrefixes(String upper, String lower) {
        Integer upperOracle;
        Integer lowerOracle;
        try {
            upperOracle = NumberUtils.createInteger(upper);
            lowerOracle = NumberUtils.createInteger(lower);
        } catch (RuntimeException ignored) {
            return;
        }

        if (!upperOracle.equals(lowerOracle)) {
            throw new RuntimeException(
                    "metamorphic violation: createInteger x/X equivalence input=" + upper
                            + " lhs=" + upperOracle
                            + " rhs=" + lowerOracle);
        }

        Number upperNumber;
        Number lowerNumber;
        try {
            upperNumber = NumberUtils.createNumber(upper);
            lowerNumber = NumberUtils.createNumber(lower);
        } catch (RuntimeException ignored) {
            return;
        }

        if (upperNumber == null || lowerNumber == null) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent 0X/0x inputs returned null input="
                            + upper + " lhs=" + upperNumber + " rhs=" + lowerNumber);
        }
        if (!upperNumber.equals(lowerNumber)) {
            throw new RuntimeException(
                    "metamorphic violation: 0X and 0x forms must be equivalent input="
                            + upper + " lhs=" + upperNumber + " rhs=" + lowerNumber);
        }
    }

    private static void requireCanonicalDecimalAgreement(String s) {
        try {
            Integer viaInteger = NumberUtils.createInteger(s);
            Number viaNumber = NumberUtils.createNumber(s);
            if (viaInteger != null && viaNumber != null && viaInteger.intValue() != viaNumber.intValue()) {
                throw new RuntimeException(
                        "metamorphic violation: canonical decimal parse disagrees input="
                                + s + " lhs=" + viaNumber + " rhs=" + viaInteger);
            }
        } catch (RuntimeException ignored) {
        }
    }

    private static String buildValidUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int digitCount = data.consumeInt(1, 7);
        int leadingZeros = data.consumeInt(0, 6);
        String seed = data.consumeAsciiString(digitCount);
        String hexAlphabet = "0123456789abcdefABCDEF";

        StringBuilder digits = new StringBuilder();
        for (int i = 0; i < leadingZeros; i++) {
            digits.append('0');
        }
        for (int i = 0; i < digitCount; i++) {
            char c = i < seed.length() ? seed.charAt(i) : (char) ('0' + i);
            digits.append(hexAlphabet.charAt((c & 0x7fffffff) % hexAlphabet.length()));
        }

        return (negative ? "-0X" : "0X") + digits.toString();
    }

    private static String buildLongLiteral(FuzzedDataProvider data) {
        long value = (((long) data.consumeInt()) << 32) ^ (data.consumeInt() & 0xffffffffL);
        return Long.toString(value) + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(Math.abs(data.consumeInt()));
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracLen = data.consumeInt(0, 8);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        sb.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '+' : '-');
        }
        sb.append(data.consumeInt(0, 300));
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return sb.toString();
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(Math.abs(data.consumeInt()));
        sb.append('.');
        int fracLen = data.consumeInt(0, 12);
        for (int i = 0; i < fracLen; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return sb.toString();
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int len = data.consumeInt(1, 40);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isRootCauseThrowable(Throwable t) {
        if (!(t instanceof NumberFormatException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
