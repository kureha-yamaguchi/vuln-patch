package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        testInput("\uD83D\uDE30", true);
        testInput("\uD800\uDC00", true);
        testInput("\uD834\uDD1E", true);
        testInput("\uDBFF\uDFFD", true);

        String explored = buildValidNoCsvString(data);
        testInput(explored, true);

        String maybeSafeAscii = sanitizeCsvNeutral(data.consumeAsciiString(64));
        testInput(maybeSafeAscii, true);

        if (data.consumeBoolean()) {
            String extra = buildValidNoCsvString(data) + sanitizeCsvNeutral(data.consumeAsciiString(16));
            testInput(extra, true);
        }
    }

    private static void testInput(String input, boolean validByConstruction) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            if (validByConstruction) {
                /*
                 * Contract of StringEscapeUtils.escapeCsv:
                 * if the value does not contain comma, newline, or double quote,
                 * then it is returned unchanged.
                 * We construct only valid strings with no CSV metacharacters, so any
                 * correct implementation must return the exact same String content.
                 * A "fix" that merely skips translation/bookkeeping or silently alters
                 * output would violate this observable post-condition.
                 */
                if (!escaped.equals(input)) {
                    throw new RuntimeException(
                        "metamorphic violation: escapeCsv must return unchanged input without CSV metacharacters input="
                            + printable(input) + " lhs=" + printable(escaped) + " rhs=" + printable(input));
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls)
                    && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String buildValidNoCsvString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        int pairs = data.consumeInt(1, 4);
        for (int i = 0; i < pairs; i++) {
            sb.append(sanitizeCsvNeutral(data.consumeAsciiString(8)));
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
        }
        sb.append(sanitizeCsvNeutral(data.consumeAsciiString(8)));
        if (sb.length() == 0) {
            sb.append(Character.toChars(0x1F630));
        }
        return sb.toString();
    }

    private static String sanitizeCsvNeutral(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c != ',' && c != '"' && c != '\r' && c != '\n') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (c < 0x20 || c > 0x7e) {
                        sb.append(String.format("\\u%04X", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
