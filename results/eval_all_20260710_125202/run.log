package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static String safeLiteral(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '{' && c != '}' && c != '\'') {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        String anchorPattern = "it''s a {0} 'test'!";
        ExtendedMessageFormat anchor = new ExtendedMessageFormat(anchorPattern, registry);
        String anchorOut = anchor.format(new Object[] { "dummy" });
        if (!"it's a dummy test!".equals(anchorOut)) {
            throw new RuntimeException(
                "metamorphic violation: anchor formatting input=" + anchorPattern
                    + " lhs=" + anchorOut + " rhs=it's a dummy test!");
        }

        String prefix = safeLiteral(data.consumeAsciiString(12));
        String middle = safeLiteral(data.consumeAsciiString(12));
        String literal = safeLiteral(data.consumeAsciiString(12));
        String arg = data.consumeRemainingAsString();

        /*
         * Contract asserted: MessageFormat/ExtendedMessageFormat treats doubled single
         * quotes ('') as one literal quote and text inside single quotes as literal text.
         * This pattern is valid by construction, so a correct implementation must format
         * to exactly the concatenation below. A bogus "fix" that only suppresses the buggy
         * branch or skips its position update would change this observable result.
         */
        String pattern = prefix + "''" + middle + " {0} '" + literal + "'!";
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, registry);
        String out = emf.format(new Object[] { arg });
        String expected = prefix + "'" + middle + " " + arg + " " + literal + "!";
        if (!expected.equals(out)) {
            throw new RuntimeException(
                "metamorphic violation: constructed formatting input=" + pattern
                    + " lhs=" + out + " rhs=" + expected);
        }

        ExtendedMessageFormat roundTrip = new ExtendedMessageFormat(emf.toPattern(), registry);
        String out2 = roundTrip.format(new Object[] { arg });
        if (!out.equals(out2)) {
            throw new RuntimeException(
                "metamorphic violation: toPattern round-trip input=" + pattern
                    + " lhs=" + out + " rhs=" + out2);
        }
    }
