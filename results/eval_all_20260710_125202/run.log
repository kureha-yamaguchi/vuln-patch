package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor inputs from the failing test: these are valid surrogate-pair strings
        // with no CSV meta characters, so StringEscapeUtils.escapeCsv must return them unchanged.
        exercise("\uD83D\uDE30", true);
        exercise("\uD800\uDC00", true);
        exercise("\uD834\uDD1E", true);
        exercise("\uDBFF\uDFFD", true);

        String fuzz = buildValidSupplementaryNoCsvString(data);
        exercise(fuzz, true);
    }

    private static void exercise(String input, boolean expectIdentity) {
        try {
            String escaped = StringEscapeUtils.escapeCsv(input);

            // Contract used for this check:
            // CSV escaping only adds quotes/escapes when the input contains CSV-special
            // characters (comma, quote, CR, LF). For inputs we construct without any of
            // those characters, the correct result is the original string unchanged.
            // A bogus "fix" that skips bookkeeping or drops/duplicates characters would
            // violate this observable post-condition without necessarily throwing.
            if (expectIdentity && !input.equals(escaped)) {
                throw new RuntimeException(
                    "metamorphic violation: escapeCsv(identity-on-no-csv-specials) input=" + printable(input)
                        + " lhs=" + printable(escaped) + " rhs=" + printable(input)
                );
            }
        } catch (Throwable t) {
            if (isMetamorphicViolation(t)) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                if (t instanceof RuntimeException) {
                    throw (RuntimeException) t;
                }
                throw new RuntimeException(t);
            }
            // Ignore unrelated exceptions to avoid false positives on correctly patched versions.
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(ste.getClassName())
                    && "translate".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
        }
        String name = t.getClass().getName().toLowerCase();
        return name.contains("invalid") || name.contains("validation");
    }

    private static boolean isMetamorphicViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static String buildValidSupplementaryNoCsvString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();

        appendSafeAscii(sb, data.consumeAsciiString(data.consumeInt(0, 16)));

        int pairs = data.consumeInt(1, 4);
        for (int i = 0; i < pairs; i++) {
            int cp = data.consumeInt(0x10000, 0x10FFFF);
            sb.append(Character.toChars(cp));
            appendSafeAscii(sb, data.consumeAsciiString(data.consumeInt(0, 8)));
        }

        if (data.consumeBoolean()) {
            appendSafeAscii(sb, data.consumeRemainingAsString());
        }

        if (sb.length() == 0 || !containsSupplementaryCodePoint(sb)) {
            sb.append("\uD83D\uDE30");
        }

        return sb.toString();
    }

    private static void appendSafeAscii(StringBuilder sb, String s) {
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch == ',' || ch == '"' || ch == '\r' || ch == '\n') {
                sb.append('a');
            } else if (Character.isHighSurrogate(ch) || Character.isLowSurrogate(ch)) {
                sb.append('b');
            } else {
                sb.append(ch);
            }
        }
    }

    private static boolean containsSupplementaryCodePoint(CharSequence s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isHighSurrogate(s.charAt(i))
                    && i + 1 < s.length()
                    && Character.isLowSurrogate(s.charAt(i + 1))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            switch (ch) {
                case '\\':
                    sb.append("\\\\");
                    break;
                case '"':
                    sb.append("\\\"");
                    break;
                case '\r':
                    sb.append("\\r");
                    break;
                case '\n':
                    sb.append("\\n");
                    break;
                case '\t':
                    sb.append("\\t");
                    break;
                default:
                    if (ch < 0x20 || ch > 0x7e) {
                        String hex = Integer.toHexString(ch);
                        sb.append("\\u");
                        for (int p = hex.length(); p < 4; p++) {
                            sb.append('0');
                        }
                        sb.append(hex);
                    } else {
                        sb.append(ch);
                    }
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
