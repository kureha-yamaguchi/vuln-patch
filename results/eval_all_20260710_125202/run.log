package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression input from BisectionSolverTest.testMath369.
        try {
            BisectionSolver solver = new BisectionSolver();
            double result = solver.solve(f, 3.0, 3.2, 3.1);

            // Contract / metamorphic check:
            // For BisectionSolver, the "initial" parameter must not change the computed root;
            // calling solve(f, min, max, initial) should be equivalent to solve(f, min, max)
            // on the same valid bracketing interval. A patch that merely suppresses the crash
            // or skips the real solving path would violate this observable equality.
            try {
                BisectionSolver oracle = new BisectionSolver();
                double expected = oracle.solve(f, 3.0, 3.2);
                if (!approximatelyEqual(result, expected, solver.getAbsoluteAccuracy(), oracle.getAbsoluteAccuracy())) {
                    throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial)==solve(f,min,max) input=[3.0,3.2,3.1] lhs="
                            + result + " rhs=" + expected);
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // EXPLORE: generate many valid bracketing intervals around a known sine root k*pi.
        // Property: min < k*pi < max, so the interval brackets a real root and a correct
        // BisectionSolver must handle it. The "initial" value is varied but should not affect
        // the result for bisection.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftMilli = data.consumeInt(1, 1500);
        int rightMilli = data.consumeInt(1, 1500);
        double left = leftMilli / 1000.0;
        double right = rightMilli / 1000.0;

        double min = root - left;
        double max = root + right;

        double initial;
        if (data.consumeBoolean()) {
            initial = root;
        } else {
            int pos = data.consumeInt(0, 1000);
            initial = min + (max - min) * (pos / 1000.0);
        }

        try {
            BisectionSolver solverWithInitial = new BisectionSolver();
            double lhs = solverWithInitial.solve(f, min, max, initial);

            try {
                BisectionSolver solverWithoutInitial = new BisectionSolver();
                double rhs = solverWithoutInitial.solve(f, min, max);

                if (!approximatelyEqual(lhs, rhs,
                        solverWithInitial.getAbsoluteAccuracy(),
                        solverWithoutInitial.getAbsoluteAccuracy())) {
                    throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial)==solve(f,min,max) input=["
                            + min + "," + max + "," + initial + "] lhs=" + lhs + " rhs=" + rhs);
                }
            } catch (Throwable t) {
                if (isRootCause(t)) {
                    throwUnchecked(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    private static boolean approximatelyEqual(double a, double b, double acc1, double acc2) {
        double tol = Math.max(Math.max(acc1, acc2), 1e-12);
        return Math.abs(a - b) <= tol;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
            || name.contains("NoBracketing")
            || name.contains("Invalid")
            || name.contains("Argument");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
