        String lhs = StringUtils.join(array, sep, startIndex, endIndex);
        String rhs = StringUtils.join(array, sepString, startIndex, endIndex);
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                "metamorphic violation: char-vs-string separator start=" + startIndex
                    + " end=" + endIndex
                    + " sep=" + ((int) sep)
