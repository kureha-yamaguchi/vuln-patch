        if (fuzzClassName.length() != 0) {
            try {
                ClassUtils.getClass(cl, fuzzClassName, data.consumeBoolean());
            } catch (ClassNotFoundException e) {
            } catch (LinkageError e) {
            } catch (SecurityException e) {
            }
        }

        ClassUtils.toClass(null);
        ClassUtils.toClass(ArrayUtils.EMPTY_OBJECT_ARRAY);
        ClassUtils.toClass(new Object[] { "Test", Integer.valueOf(1), Double.valueOf(99d) });
        ClassUtils.toClass(new Object[] { "Test", null, Double.valueOf(99d) });

        int len = data.consumeInt(0, 16);
        Object[] array = new Object[len];
        boolean forceNull = data.consumeBoolean();

        for (int i = 0; i < len; i++) {
            int choice = data.consumeInt(0, 8);
            switch (choice) {
                case 0:
                    array[i] = null;
                    break;
                case 1:
                    array[i] = data.consumeString(32);
                    break;
                case 2:
                    array[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 3:
                    array[i] = Long.valueOf(data.consumeInt());
                    break;
                case 4:
                    array[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 5:
                    array[i] = Byte.valueOf(data.consumeByte());
                    break;
                case 6:
                    array[i] = data.consumeBytes(data.consumeInt(0, 16));
                    break;
                case 7:
                    array[i] = new Object[] { data.consumeString(8), Integer.valueOf(data.consumeInt()) };
                    break;
                default:
                    array[i] = new int[] { data.consumeInt(), data.consumeInt() };
                    break;
            }
        }

        if (forceNull && len > 0) {
            array[data.consumeInt(0, len - 1)] = null;
        }

        ClassUtils.toClass(array);
