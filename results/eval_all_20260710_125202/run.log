package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeString(32);
        boolean useNullObject = data.consumeBoolean();
        String objectString = data.consumeString(128);
        int width;
        if (data.consumeBoolean()) {
            width = data.consumeInt(1, 128);
        } else {
            width = data.consumeInt(-16, 128);
        }
        char padChar = (char) (data.consumeByte() & 0xFF);

        int initialCapacity;
        if (data.consumeBoolean()) {
            int base = Math.max(0, prefix.length() + Math.max(width, 0));
            int slack = data.consumeInt(0, 4);
            initialCapacity = Math.max(0, base - slack);
        } else {
            initialCapacity = data.consumeInt(0, 64);
        }

        StrBuilder sb = new StrBuilder(initialCapacity);
        if (prefix.length() > 0) {
            sb.append(prefix);
        }

        Object obj = useNullObject ? null : objectString;

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }

        try {
            checkPostCondition(prefix, obj, width, padChar, sb);
        } catch (RuntimeException metamorphicViolation) {
            throw metamorphicViolation;
        } catch (Throwable ignored) {
            return;
        }
    }

    private static void runAnchor() {
        StrBuilder sb = new StrBuilder(1);
        try {
            sb.appendFixedWidthPadRight("foo", 1, '-');
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        String actual = sb.toString();
        if (!"f".equals(actual)) {
            throw new RuntimeException("metamorphic violation: anchor expected=f actual=" + actual);
        }
    }

    private static void checkPostCondition(String prefix, Object obj, int width, char padChar, StrBuilder sb) {
        if (width <= 0) {
            String actual = sb.toString();
            if (!prefix.equals(actual)) {
