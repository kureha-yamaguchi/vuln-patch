    private static void assertCleanInvalidRejection(String s) {
        try {
            Number n = NumberUtils.createNumber(s);
            throw new RuntimeException(
                    "contract violation: invalid input accepted input=" + s + " result=" + String.valueOf(n));
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                throw new RuntimeException(
                        "contract violation: invalid input crashed instead of rejecting cleanly input=" + s, t);
            }
            return;
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
        }
    }

    private static void assertCanonicalLongParses(String canonical, String suffix, int expected) {
        try {
            Number n = NumberUtils.createNumber(canonical + suffix);
            if (!(n instanceof Long) || n.longValue() != (long) expected) {
                throw new RuntimeException(
                        "metamorphic violation: canonical long suffix parse wrong input=" + canonical + suffix
                                + " result=" + describe(n) + " expected=" + expected);
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseFromCreateNumber(t)) {
                return;
            }
            throw t;
        }
    }

    private static boolean sameNumber(Number a, Number b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (!a.getClass().equals(b.getClass())) {
            return false;
        }
        return a.toString().equals(b.toString());
    }

    private static String describe(Number n) {
        if (n == null) {
            return "null";
        }
        return n.getClass().getName() + ":" + n.toString();
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isRootCauseFromCreateNumber(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.apache.commons.lang.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static String decimalDigitsOnly(String s, boolean allowSign) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') {
                out.append(c);
            } else if (allowSign && out.length() == 0 && (c == '-' || c == '+')) {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static String hexDigitsOnly(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer out = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if ((c >= '0' && c <= '9')
                    || (c >= 'a' && c <= 'f')
                    || (c >= 'A' && c <= 'F')) {
                out.append(c);
            }
        }
        return out.toString();
    }

    private static boolean isSignedDecimalDigits(String s) {
        if (s == null || s.length() == 0) {
            return false;
        }
        int start = 0;
        char first = s.charAt(0);
        if (first == '-' || first == '+') {
            if (s.length() == 1) {
                return false;
            }
            start = 1;
        }
        for (int i = start; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') {
                return false;
            }
        }
        return true;
    }

    private static String buildBigIntegralCore(FuzzedDataProvider data, String fallbackDigits) {
        String raw = decimalDigitsOnly(data.consumeAsciiString(48), false);
        if (raw.length() == 0) {
            raw = fallbackDigits;
        }
        if (raw.length() < 20) {
            raw = raw + fallbackDigits;
        }
        if (raw.length() == 0) {
            raw = "12345678901234567890";
        }
        if (data.consumeBoolean()) {
            raw = "-" + raw;
        }
        return raw;
    }

    private static String buildDecimalBase(FuzzedDataProvider data, String signedDigits, String digits, String exp) {
        String intPart = signedDigits;
        String fracPart = digits;
        String exponent = exp;

        if (!isSignedDecimalDigits(intPart)) {
            intPart = Integer.toString(data.consumeInt());
        }
        if (fracPart.length() == 0) {
            fracPart = "0";
        }
        if (!isSignedDecimalDigits(exponent)) {
            exponent = "0";
        }

        switch (data.consumeInt(0, 3)) {
            case 0:
                return intPart + "." + fracPart;
            case 1:
                return intPart + "." + fracPart + "E" + exponent;
            case 2:
                return intPart + ".0";
            default:
                return "0." + fracPart + "E" + exponent;
        }
    }
}
