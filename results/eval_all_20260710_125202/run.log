private static void exerciseCompositionRelation(Object[] left, Object[] right) {
        Class<?>[] whole;
        Class<?>[] lhs;
        Class<?>[] rhs;
        try {
            whole = ClassUtils.toClass(ArrayUtils.addAll(left, right));
            lhs = ClassUtils.toClass(left);
            rhs = ClassUtils.toClass(right);
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw e;
            }
            return;
        }

        Class<?>[] parts;
        try {
            parts = ArrayUtils.addAll(lhs, rhs);
        } catch (RuntimeException e) {
            return;
        }

        // Each output position depends only on the corresponding input element, so applying toClass to a
        // concatenation must equal concatenating the per-part results.
        if (!java.util.Arrays.equals(whole, parts)) {
            throw new RuntimeException("metamorphic violation: composition left="
                    + java.util.Arrays.toString(left)
                    + " right=" + java.util.Arrays.toString(right)
                    + " whole=" + java.util.Arrays.toString(whole)
                    + " parts=" + java.util.Arrays.toString(parts));
        }
    }
