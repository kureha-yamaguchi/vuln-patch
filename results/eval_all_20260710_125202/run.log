package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runTarget("off");

        runTarget("oof");
        runTarget("yep");
        runTarget("trux");
        runTarget("false");
        runTarget("a");
        runTarget("true");
        runTarget("tru");

        String raw = data.consumeString(64);
        String ascii = data.consumeAsciiString(64);

        runTarget(raw);
        runTarget(ascii);

        if (ascii != null) {
            int maxStarts = Math.min(8, ascii.length());
            for (int i = 0; i < maxStarts; i++) {
                int len = Math.min(3, ascii.length() - i);
                if (len == 3) {
                    runTarget(ascii.substring(i, i + 3));
                }
            }
        }

        String trigger3 = buildThreeCharCandidate(data);
        runTarget(trigger3);

        String trigger3WrappedLeft = data.consumeAsciiString(8) + trigger3;
        String trigger3WrappedRight = trigger3 + data.consumeAsciiString(8);
        runTarget(trigger3WrappedLeft);
        runTarget(trigger3WrappedRight);

        if (trigger3WrappedLeft.length() >= 3) {
            for (int i = 0; i <= trigger3WrappedLeft.length() - 3 && i < 6; i++) {
                runTarget(trigger3WrappedLeft.substring(i, i + 3));
            }
        }
        if (trigger3WrappedRight.length() >= 3) {
            for (int i = 0; i <= trigger3WrappedRight.length() - 3 && i < 6; i++) {
                runTarget(trigger3WrappedRight.substring(i, i + 3));
            }
        }

        String maybeT = buildTLikeShortCandidate(data);
        runTarget(maybeT);

        checkCaseInsensitivity(raw);
        checkCaseInsensitivity(ascii);
        checkCaseInsensitivity(trigger3);
        checkCaseInsensitivity(maybeT);
        checkCaseInsensitivity(trigger3WrappedLeft);
        checkCaseInsensitivity(trigger3WrappedRight);
    }

    private static void runTarget(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] trace = t.getStackTrace();
        if (trace == null) {
            return false;
        }
        for (int i = 0; i < trace.length; i++) {
            StackTraceElement e = trace[i];
            if ("org.apache.commons.lang.BooleanUtils".equals(e.getClassName())
                    && "toBoolean".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String buildThreeCharCandidate(FuzzedDataProvider data) {
        char first;
        if (data.consumeBoolean()) {
            first = data.consumeBoolean() ? 't' : 'T';
        } else {
            first = nextNonYAscii(data);
        }
        if (first == 'y' || first == 'Y') {
            first = 't';
        }
        char second = nextAscii(data);
        char third = nextAscii(data);
        return new String(new char[] { first, second, third });
    }

    private static String buildTLikeShortCandidate(FuzzedDataProvider data) {
        int style = data.consumeInt(0, 4);
        if (style == 0) {
            return "t" + data.consumeAsciiString(2);
        }
        if (style == 1) {
            return "T" + data.consumeAsciiString(2);
        }
        if (style == 2) {
            return "t" + data.consumeAsciiString(3);
        }
        if (style == 3) {
            return "T" + data.consumeAsciiString(3);
        }
        return buildThreeCharCandidate(data);
    }

    private static char nextAscii(FuzzedDataProvider data) {
        return (char) (32 + Math.floorMod((int) data.consumeByte(), 95));
    }

    private static char nextNonYAscii(FuzzedDataProvider data) {
        char c = nextAscii(data);
        if (c == 'y' || c == 'Y') {
            c = 't';
        }
        return c;
    }

    private static void checkCaseInsensitivity(String s) {
        if (s == null) {
            return;
        }
        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(s.toUpperCase(Locale.ROOT));
            boolean rhs2 = BooleanUtils.toBoolean(s.toLowerCase(Locale.ROOT));

            /*
             * Contract asserted:
             * BooleanUtils.toBoolean(String) recognizes "true", "on", and "yes"
             * case-insensitively (visible in the implementation and tests), and all
             * other strings evaluate to false. Therefore changing only letter case
             * must not change the returned boolean for any String input.
             * A throw-deleting or branch-skipping patch that makes one case variant
             * behave differently would violate this observable API guarantee.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                        "metamorphic violation: case-insensitive upper input=" + String.valueOf(s)
                                + " lhs=" + lhs + " rhs=" + rhs);
            }
            if (lhs != rhs2) {
                throw new RuntimeException(
                        "metamorphic violation: case-insensitive lower input=" + String.valueOf(s)
                                + " lhs=" + lhs + " rhs=" + rhs2);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && !(t instanceof StringIndexOutOfBoundsException)) {
                throw (RuntimeException) t;
            }
            if (isRootCause(t)) {
                throw (RuntimeException) t;
            }
        }
    }
}
