public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            NumberUtils.createNumber("l");
        } catch (IllegalArgumentException e) {
        }

        try {
            NumberUtils.createNumber("L");
        } catch (IllegalArgumentException e) {
        }

        String oneChar = data.consumeBoolean() ? "l" : "L";
        try {
            NumberUtils.createNumber(oneChar);
        } catch (IllegalArgumentException e) {
        }

        String maybeSingle = data.consumeString(1);
        if (maybeSingle.length() == 0) {
            maybeSingle = data.consumeBoolean() ? "l" : "L";
        } else {
            char c = maybeSingle.charAt(0);
            if (data.consumeBoolean()) {
                c = data.consumeBoolean() ? 'l' : 'L';
            }
            maybeSingle = String.valueOf(c);
        }
        try {
            NumberUtils.createNumber(maybeSingle);
        } catch (IllegalArgumentException e) {
        }

        String base = buildIntegralBase(data);

        try {
            Number lower = NumberUtils.createNumber(base + "l");
            Number upper = NumberUtils.createNumber(base + "L");
            if (lower != null && upper != null) {
                if (!lower.getClass().equals(upper.getClass()) || lower.longValue() != upper.longValue()) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(x+'l') != createNumber(x+'L') input=" + base
                                    + " lhs=" + describe(lower) + " rhs=" + describe(upper));
                }
            }
        } catch (IllegalArgumentException e) {
        }
    }
