        String middle = sanitizeLiteral(data.consumeAsciiString(32));
        String right = sanitizeLiteral(data.consumeAsciiString(32));
        String arg = sanitizeLiteral(data.consumeAsciiString(32));
        int variant = data.consumeInt(0, 3);

