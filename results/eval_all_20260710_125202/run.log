    private static void assertLeftBoundsSet(EmptyBlock left, String where) {
        Rectangle2D b = left.getBounds();
        if (b == null || !(b.getWidth() > 0.0) || !(b.getHeight() >= 0.0)) {
            throw new RuntimeException(
                "metamorphic violation: left bounds not set in " + where + " bounds=" + String.valueOf(b)
            );
        }
    }

    private static boolean isHarnessViolation(RuntimeException e) {
        return e.getClass() == RuntimeException.class
            && e.getMessage() != null
            && e.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean sameRect(Rectangle2D a, Rectangle2D b) {
        return close(a.getX(), b.getX())
            && close(a.getY(), b.getY())
            && close(a.getWidth(), b.getWidth())
            && close(a.getHeight(), b.getHeight());
    }

    private static boolean close(double a, double b) {
        return Math.abs(a - b) <= 0.000001;
    }

    private static String rect(Rectangle2D r) {
        return r.getX() + "," + r.getY() + "," + r.getWidth() + "," + r.getHeight();
    }

    private static Graphics2D graphics() {
        return new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB).createGraphics();
    }

    private static double pos(int v) {
        return v / 10.0;
    }
}
