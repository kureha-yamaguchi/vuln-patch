package org.jfree.data.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            TimeSeries anchor = new TimeSeries("S");
            anchor.add(new Day(19, 8, 2005), Integer.valueOf(1));
            anchor.add(new Day(31, 1, 2006), Integer.valueOf(1));

            Day anchorStart = new Day(1, 12, 2005);
            Day anchorEnd = new Day(18, 1, 2006);

            try {
                anchor.getIndex(anchorStart);
                anchor.getIndex(anchorEnd);
                TimeSeries copy = anchor.createCopy(anchorStart, anchorEnd);

                /*
                 * Contract from createCopy(start, end): it returns the items whose periods lie
                 * in the inclusive range [start, end]. For a range wholly inside a gap between
                 * two existing items, there are no such items, so the result must be an empty
                 * TimeSeries. A throw-deleting or bookkeeping-breaking patch can violate this.
                 */
                if (copy == null || copy.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: anchor same-gap copy must be empty itemCount="
                            + (copy == null ? -1 : copy.getItemCount()));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: anchor valid same-gap range was rejected", e);
                }
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }

            Day beforeFirst = new Day(18, 8, 2005);
            try {
                anchor.getIndex(beforeFirst);
                TimeSeries empty = anchor.createCopy(beforeFirst, beforeFirst);
                if (empty == null || empty.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: anchor before-first copy must be empty itemCount="
                            + (empty == null ? -1 : empty.getItemCount()));
                }
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: anchor valid before-first range was rejected", e);
                }
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }

            try {
                TimeSeries byPeriod = anchor.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
                TimeSeries byIndex = anchor.createCopy(0, 1);

                /*
                 * Equivalent-inputs relation: when start/end are existing periods taken directly
                 * from the series, createCopy(startPeriod, endPeriod) and createCopy(startIndex,
                 * endIndex) denote the same contiguous subsequence and must produce equivalent
                 * copies.
                 */
                assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
            } catch (RuntimeException e) {
                if (isRootCause(e)) {
                    throw new RuntimeException(
                        "metamorphic violation: anchor existing-period copy was rejected", e);
                }
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
            return;
        }

        final int maxOrd = 28 * 12 * 40 - 1;

        int count = data.consumeInt(2, 8);
        int firstMax = maxOrd - (count + 4);
        if (firstMax < 0) {
            return;
        }

        int[] ords = new int[count];
        int first = data.consumeInt(0, firstMax);
        int gapMax = Math.min(64, maxOrd - first - (count - 1));
        if (gapMax < 2) {
            return;
        }
        ords[0] = first;
        ords[1] = first + data.consumeInt(2, gapMax);

        int current = ords[1];
        for (int i = 2; i < count; i++) {
            int remaining = count - 1 - i;
            int maxStep = maxOrd - current - remaining;
            if (maxStep < 1) {
                return;
            }
            current += data.consumeInt(1, Math.min(64, maxStep));
            ords[i] = current;
        }

        TimeSeries series = new TimeSeries(data.consumeString(32));
        for (int i = 0; i < ords.length; i++) {
            try {
                series.add(dayFromOrdinal(ords[i]), Integer.valueOf(data.consumeInt()));
            } catch (RuntimeException e) {
                return;
            }
        }

        if (series.getItemCount() < 2) {
            return;
        }

        int beforeOrd = ords[0] - 1;
        if (beforeOrd >= 0) {
            try {
                Day before = dayFromOrdinal(beforeOrd);
                series.getIndex(before);
                TimeSeries empty = series.createCopy(before, before);

                /*
                 * Contract: a range completely before the first item contains no series items,
                 * so createCopy must return an empty clone-like series rather than invent data.
                 * This also drives the empty-range clone path.
                 */
                if (empty == null || empty.getItemCount() != 0) {
                    throw new RuntimeException(
                        "metamorphic violation: before-first copy must be empty ord=" + beforeOrd
                            + " itemCount=" + (empty == null ? -1 : empty.getItemCount()));
                }
            } catch (RuntimeException e) {
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        int gapIndex = findGap(ords);
        if (gapIndex < 0) {
            return;
        }

        int left = ords[gapIndex];
        int right = ords[gapIndex + 1];
        if (right - left < 2) {
            return;
        }

        int startOrd = data.consumeInt(left + 1, right - 1);
        int endOrd = data.consumeInt(startOrd, right - 1);
        Day start = dayFromOrdinal(startOrd);
        Day end = dayFromOrdinal(endOrd);

        try {
            series.getIndex(start);
            series.getIndex(end);
            TimeSeries gapCopy = series.createCopy(start, end);

            /*
             * Contract: for any valid ordered range wholly inside a gap between adjacent items,
             * there are zero source items in that range, so the copied series must be empty.
             */
            if (gapCopy == null || gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: same-gap copy must be empty left=" + left
                        + " right=" + right
                        + " start=" + startOrd
                        + " end=" + endOrd
                        + " itemCount=" + (gapCopy == null ? -1 : gapCopy.getItemCount()));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: valid same-gap range was rejected start="
                        + startOrd + " end=" + endOrd, e);
            }
            if (isHarnessViolation(e)) {
                throw e;
            }
            return;
        } catch (CloneNotSupportedException e) {
            return;
        }

        if (right - left >= 3) {
            int startOrd2 = data.consumeInt(left + 1, right - 1);
            int endOrd2 = data.consumeInt(startOrd2, right - 1);
            Day start2 = dayFromOrdinal(startOrd2);
            Day end2 = dayFromOrdinal(endOrd2);

            try {
                TimeSeries copyA = series.createCopy(start, end);
                TimeSeries copyB = series.createCopy(start2, end2);

                /*
                 * Equivalent-inputs relation: any two valid ranges wholly inside the same empty
                 * gap select the same set of source items: none. Therefore both copies must be
                 * observably equivalent.
                 */
                assertEquivalentCopies(
                    copyA, copyB,
                    "same-gap ranges " + startOrd + ".." + endOrd + " vs " + startOrd2 + ".." + endOrd2);
            } catch (RuntimeException e) {
                if (isHarnessViolation(e)) {
                    throw e;
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
            }
        }

        try {
            int i = data.consumeInt(0, series.getItemCount() - 1);
            int j = data.consumeInt(i, series.getItemCount() - 1);
            RegularTimePeriod existingStart = series.getTimePeriod(i);
            RegularTimePeriod existingEnd = series.getTimePeriod(j);

            TimeSeries byPeriod = series.createCopy(existingStart, existingEnd);
            TimeSeries byIndex = series.createCopy(i, j);

            /*
             * Equivalent-inputs relation: for existing boundaries from indices i..j, the
             * period-based overload and the index-based overload describe the same slice.
             */
            assertEquivalentCopies(byPeriod, byIndex, "existing-period copy vs index copy " + i + ".." + j);
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 1900 + ord / (28 * 12);
        int rem = ord % (28 * 12);
        int month = rem / 28 + 1;
        int day = rem % 28 + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] > 1) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String context) {
        if (a == null || b == null) {
            throw new RuntimeException(
                "metamorphic violation: null copy in " + context
                    + " lhs=" + (a == null) + " rhs=" + (b == null));
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: itemCount mismatch in " + context
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (pa == null ? pb != null : !pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: period mismatch in " + context
                        + " at=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: value mismatch in " + context
                        + " at=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String method = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(method) || "getIndex".equals(method))) {
                return true;
            }
            if ("clone".equals(method)) {
                return true;
            }
        }
        return false;
    }
}
