package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            BooleanUtils.toBoolean("off");
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
        }

        String raw = data.consumeAsciiString(16);
        String remaining = data.consumeRemainingAsString();

        String forcedLen3 = buildLen3Candidate(data, raw);
        String mixedLen3 = buildMixedLen3(raw, remaining);

        String[] literals = new String[] {
            "off", "oof", "yep", "tru", "yes?", "false", "true", "on", "yes"
        };
        String chosenLiteral = literals[Math.abs(data.consumeInt()) % literals.length];

        exercise(raw);
        exercise(remaining);
        exercise(forcedLen3);
        exercise(mixedLen3);
        exercise(chosenLiteral);

        if (raw != null && raw.length() >= 3) {
            exercise(raw.substring(0, 3));
        }
        if (remaining != null && remaining.length() >= 3) {
            exercise(remaining.substring(0, 3));
        }
    }

    private static void exercise(String s) {
        try {
            BooleanUtils.toBoolean(s);
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
            if (isCleanRejection(t)) {
                return;
            }
            return;
        }

        if (s == null) {
            return;
        }

        String upper = s.toUpperCase(Locale.ROOT);

        try {
            boolean lhs = BooleanUtils.toBoolean(s);
            boolean rhs = BooleanUtils.toBoolean(upper);

            /*
             * Contract asserted: BooleanUtils.toBoolean(String) recognizes tokens
             * case-insensitively ("true", "on", "yes") and returns false otherwise.
             * Therefore any ASCII input and its upper-case variant must yield the same
             * boolean result. A patch that merely suppresses the crash or skips part of
             * the intended matching logic could violate this without throwing.
             */
            if (lhs != rhs) {
                throw new RuntimeException(
                    "metamorphic violation: case-insensitive equivalence input=" + s +
                    " upper=" + upper + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static String buildLen3Candidate(FuzzedDataProvider data, String seed) {
        char c0 = pickAscii(seed, 0, 'o');
        char c1 = pickAscii(seed, 1, 'f');
        char c2 = pickAscii(seed, 2, 'f');

        if ((c0 == 'y' || c0 == 'Y') &&
            ((c1 == 'e' || c1 == 'E') && (c2 == 's' || c2 == 'S'))) {
            c2 = 'p';
        }

        if (data.consumeBoolean()) {
            c0 = (data.consumeBoolean() ? 'o' : 'O');
        } else if ((c0 == 'y' || c0 == 'Y') &&
                   !((c1 == 'e' || c1 == 'E') && (c2 == 's' || c2 == 'S'))) {
            c0 = 'o';
        }

        return new String(new char[] { c0, c1, c2 });
    }

    private static String buildMixedLen3(String a, String b) {
        char c0 = pickAscii(a, 0, 'o');
        char c1 = pickAscii(b, 0, 'o');
        char c2 = pickAscii(a, 1, 'f');

        if ((c0 == 'y' || c0 == 'Y') &&
            ((c1 == 'e' || c1 == 'E') && (c2 == 's' || c2 == 'S'))) {
            c2 = 'x';
        }

        return new String(new char[] { c0, c1, c2 });
    }

    private static char pickAscii(String s, int idx, char dflt) {
        if (s != null && idx >= 0 && idx < s.length()) {
            char c = s.charAt(idx);
            if (c >= 32 && c <= 126) {
                return c;
            }
        }
        return dflt;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.BooleanUtils".equals(ste.getClassName())
                    && "toBoolean".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
