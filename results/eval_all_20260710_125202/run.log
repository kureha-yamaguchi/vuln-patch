        double constraintHeight = scaledPositive(data.consumeInt(1, 1000));
        double leftWidth = scaledNonNegative(data.consumeInt(0, 1000));
        double leftHeight = scaledNonNegative(data.consumeInt(0, 1000));

        BlockContainer container = new BlockContainer(new BorderArrangement());
        EmptyBlock left = new EmptyBlock(leftWidth, leftHeight);
        container.add(left, RectangleEdge.LEFT);

