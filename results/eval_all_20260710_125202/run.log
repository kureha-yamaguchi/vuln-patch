    private static void runExplore(FuzzedDataProvider data) {
        int vars = data.consumeInt(2, 5);
        int cases = data.consumeInt(1, 8);

        for (int c = 0; c < cases; c++) {
            double[] objective = new double[vars];
            for (int i = 0; i < vars; i++) {
                objective[i] = 1.0 + data.consumeInt(0, 3);
            }

            List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();

            for (int i = 0; i < vars; i++) {
                double[] upper = new double[vars];
                upper[i] = 1.0;
                constraints.add(new LinearConstraint(upper, Relationship.LEQ, 1.0 + data.consumeInt(0, 2)));
            }

            int duplicateGroups = data.consumeInt(1, 4);
            for (int g = 0; g < duplicateGroups; g++) {
                double[] coeff = new double[vars];
                for (int j = 0; j < vars; j++) {
                    coeff[j] = 1.0 + data.consumeInt(0, 3);
                }
                double rhs = 1.0 + data.consumeInt(0, vars);
                constraints.add(new LinearConstraint(coeff, Relationship.GEQ, rhs));
                constraints.add(new LinearConstraint(coeff.clone(), Relationship.GEQ, rhs));
            }

            if (data.consumeBoolean()) {
                double[] coeff = new double[vars];
                for (int j = 0; j < vars; j++) {
                    coeff[j] = data.consumeBoolean() ? 1.0 : 0.0;
                }
                boolean allZero = true;
                for (int j = 0; j < vars; j++) {
                    if (coeff[j] != 0.0) {
                        allZero = false;
                        break;
                    }
                }
                if (allZero) {
                    coeff[0] = 1.0;
                }
                double rhs = data.consumeInt(0, 2);
                constraints.add(new LinearConstraint(coeff, Relationship.EQ, rhs));
            }

            optimize(objective, constraints, data.consumeInt(-2, 2));
        }
    }

    private static void optimize(double[] objective, List<LinearConstraint> constraints, double constantTerm) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, constantTerm);
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
    }
