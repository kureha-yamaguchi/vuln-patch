package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();
        explore(data);
    }

    private static void anchor() {
        NormalDistribution normal = new NormalDistributionImpl(0.0, 1.0);
        double p = 0.9772498680518209d;
        try {
            double x = normal.inverseCumulativeProbability(p);
            if (Math.abs(x - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: inverseCumulativeProbability should recover 2.0 for the known valid normal probability"
                    + " p=" + p + " result=" + x);
            }
        } catch (Throwable t) {
            handleThrowable(t, "anchor", p, 2.0d);
        }
    }

    private static void explore(FuzzedDataProvider data) {
        int trials = 1 + Math.min(8, Math.max(0, data.remainingBytes()));
        for (int i = 0; i < trials; i++) {
            double mean = data.consumeInt(-1000, 1000);
            double sd = data.consumeInt(1, 1000);
            int kInt;
            if (i == 0) {
                kInt = 2;
            } else {
                kInt = data.consumeInt(-6, 6);
            }
            double expectedX = mean + (sd * (double) kInt);

            NormalDistribution normal;
            try {
                normal = new NormalDistributionImpl(mean, sd);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                return;
            }

            try {
                /*
                 * Contract asserted: inverseCumulativeProbability is the quantile function,
                 * i.e. it inverts cumulativeProbability on valid probabilities for a continuous
                 * distribution. We construct a valid probability p by calling the real
                 * cumulativeProbability on a real NormalDistribution instance, then require
                 * inverseCumulativeProbability(p) to recover the original x. A patch that
                 * merely deletes the throw or otherwise returns a wrong value will violate
                 * this observable round-trip relation without requiring any custom oracle.
                 */
                double p = normal.cumulativeProbability(expectedX);
                double recoveredX = normal.inverseCumulativeProbability(p);
                if (Math.abs(recoveredX - expectedX) > 1.0e-9d) {
                    throw new RuntimeException(
                        "metamorphic violation: inverseCumulativeProbability(cumulativeProbability(x)) != x"
                        + " mean=" + mean
                        + " sd=" + sd
                        + " x=" + expectedX
                        + " p=" + p
                        + " recovered=" + recoveredX);
                }
            } catch (Throwable t) {
                handleThrowable(t, "roundtrip", Double.NaN, expectedX);
            }
        }
    }

    private static void handleThrowable(Throwable t, String context, double p, double expectedX) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            throw new RuntimeException(
                "metamorphic violation: valid NormalDistribution round-trip failed"
                + " context=" + context
                + " p=" + p
                + " expectedX=" + expectedX,
                t);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MathException)) {
            return false;
        }
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            for (StackTraceElement ste : cur.getStackTrace()) {
                String cls = ste.getClassName();
                String method = ste.getMethodName();
                if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                        && "bracket".equals(method))
                    || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                        && "inverseCumulativeProbability".equals(method))
                    || ("org.apache.commons.math.MathRuntimeException".equals(cls)
                        && "createIllegalArgumentException".equals(method))
                    || ("org.apache.commons.math.distribution.NormalDistributionImpl".equals(cls)
                        && "value".equals(method))
                    || ("org.apache.commons.math.ConvergenceException".equals(cls)
                        && "<init>".equals(method))
                    || ("org.apache.commons.math.MathException".equals(cls)
                        && "buildMessage".equals(method))) {
                    return true;
                }
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Illegal")
                || name.contains("Invalid")
                || name.contains("Argument")
                || name.contains("Format")) {
                return true;
            }
        }
        return false;
    }
}
