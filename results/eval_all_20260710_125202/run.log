package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        String prefix = data.consumeString(32);
        String obj = data.consumeString(64);
        int width = data.consumeInt(1, 64);
        int initialCapacity = data.consumeInt(0, 8);
        char padChar = (char) (data.consumeByte() & 0xff);

        runOne(prefix, obj, width, padChar, initialCapacity);

        if (obj.length() > 0) {
            int altWidth = data.consumeInt(1, Math.max(1, obj.length()));
            int altCapacity = data.consumeInt(0, 8);
            runOne(prefix, obj, altWidth, padChar, altCapacity);
        }

        String surrounding = data.consumeRemainingAsString();
        if (surrounding.length() > 0) {
            String pref2 = prefix + surrounding;
            int width2 = data.consumeInt(1, 64);
            int cap2 = data.consumeInt(0, 8);
            runOne(pref2, obj, width2, padChar, cap2);
        }
    }

    private static void runAnchor() {
        try {
            StrBuilder sb = new StrBuilder(1);
            sb.appendFixedWidthPadRight("foo", 1, '-');

            if (!"f".equals(sb.toString())) {
                throw new RuntimeException("metamorphic violation: appendFixedWidthPadRight contract input=anchor lhs="
                        + sb.toString() + " rhs=f");
            }
            if (sb.length() != 1) {
                throw new RuntimeException("metamorphic violation: fixed-width length input=anchor lhs="
                        + sb.length() + " rhs=1");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static void runOne(String prefix, String obj, int width, char padChar, int initialCapacity) {
        try {
            StrBuilder sb = new StrBuilder(initialCapacity);
            sb.append(prefix);
            int beforeLen = sb.length();

            sb.appendFixedWidthPadRight(obj, width, padChar);

            String result = sb.toString();
            String expectedSuffix = expectedFixedWidthPadRight(obj, width, padChar);
            String actualSuffix = result.substring(beforeLen);

            /*
             * Contract asserted:
             * appendFixedWidthPadRight appends exactly width characters; if the string
             * is longer than width, the leftmost width characters are appended,
             * otherwise the string is appended and padded on the right.
             * A "fix" that only suppresses the crash or skips the copy would violate
             * either the new length or the appended suffix.
             */
            if (sb.length() != beforeLen + width) {
                throw new RuntimeException("metamorphic violation: fixed-width length input=prefix="
                        + quote(prefix) + ",obj=" + quote(obj) + ",width=" + width + ",pad=" + (int) padChar
                        + ",cap=" + initialCapacity + " lhs=" + sb.length() + " rhs=" + (beforeLen + width));
            }
            if (!expectedSuffix.equals(actualSuffix)) {
                throw new RuntimeException("metamorphic violation: appendFixedWidthPadRight suffix input=prefix="
                        + quote(prefix) + ",obj=" + quote(obj) + ",width=" + width + ",pad=" + (int) padChar
                        + ",cap=" + initialCapacity + " lhs=" + quote(actualSuffix) + " rhs=" + quote(expectedSuffix));
            }
            if (!result.startsWith(prefix)) {
                throw new RuntimeException("metamorphic violation: prefix preserved input=prefix="
                        + quote(prefix) + ",obj=" + quote(obj) + ",width=" + width + ",pad=" + (int) padChar
                        + ",cap=" + initialCapacity + " lhs=" + quote(result) + " rhs-prefix=" + quote(prefix));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.text.StrBuilder".equals(e.getClassName())
                    && "appendFixedWidthPadRight".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String expectedFixedWidthPadRight(String obj, int width, char padChar) {
        if (obj == null) {
            obj = "null";
        }
        if (obj.length() >= width) {
            return obj.substring(0, width);
        }
        StringBuffer sb = new StringBuffer(width);
        sb.append(obj);
        while (sb.length() < width) {
            sb.append(padChar);
        }
        return sb.toString();
    }

    private static String quote(String s) {
        return String.valueOf(s);
    }
}
