        if (validRight.length() == 0) {
            validRight.append('0');
        }

        String validDecimal = (data.consumeBoolean() ? "-" : "") + validLeft + "." + validRight;

        try {
            Number lhs = NumberUtils.createNumber(validDecimal);
            Number rhs = NumberUtils.createFloat(validDecimal);
            if (lhs == null || rhs == null
                    || !lhs.getClass().equals(rhs.getClass())
                    || lhs.floatValue() != rhs.floatValue()) {
                throw new RuntimeException(
                        "metamorphic violation: bounded canonical decimal should match createFloat input="
                                + validDecimal + " lhs=" + lhs + " rhs=" + rhs);
            }
        } catch (RuntimeException t) {
            boolean inCreateNumber = false;
            StackTraceElement[] st = t.getStackTrace();
            for (int j = 0; j < st.length; j++) {
                if ("org.apache.commons.lang3.math.NumberUtils".equals(st[j].getClassName())
                        && "createNumber".equals(st[j].getMethodName())) {
                    inCreateNumber = true;
                    break;
                }
            }

            if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {
                throw new RuntimeException(
                        "metamorphic violation: valid bounded decimal must parse successfully input=" + validDecimal,
                        t);
            }

            if (t instanceof IllegalArgumentException && inCreateNumber) {
                throw new RuntimeException(
                        "metamorphic violation: valid bounded decimal unexpectedly rejected input=" + validDecimal,
                        t);
            }

            if (!(t instanceof IllegalArgumentException)) {
                throw t;
            }
