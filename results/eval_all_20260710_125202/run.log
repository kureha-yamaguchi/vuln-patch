package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchorMetamorphic();
        runExploreMetamorphic(data);
    }

    /*
     * Contract asserted:
     * For a real distribution, if p is obtained from cumulativeProbability(x),
     * then inverseCumulativeProbability(p) must recover x (up to numerical tolerance).
     * This is valid-by-construction because p comes from the same distribution, so a
     * correct implementation is obligated to accept it. A throw-deleting patch that
     * silently returns a wrong value, or a buggy implementation that throws instead of
     * returning the inverse, violates this observable round-trip relation.
     */
    private static void runAnchorMetamorphic() {
        checkRoundTrip(0.0, 1.0, 2.0, "anchor");
    }

    private static void runExploreMetamorphic(FuzzedDataProvider data) {
        double mean = data.consumeInt(-1000, 1000);
        mean += (data.consumeByte() / 32.0);

        double sd = data.consumeInt(1, 1000);
        sd += ((data.consumeByte() & 0xFF) / 255.0);

        double x = mean + sd + 1.0;

        checkRoundTrip(mean, sd, x, "explore");

        if (data.consumeBoolean()) {
            double mean2 = mean + data.consumeInt(-20, 20);
            double sd2 = sd + data.consumeInt(0, 20);
            if (sd2 > 0.0 && Double.isFinite(mean2) && Double.isFinite(sd2)) {
                double x2 = mean2 + sd2 + 1.0;
                checkRoundTrip(mean2, sd2, x2, "explore2");
            }
        }
    }

    private static void checkRoundTrip(double mean, double sd, double x, String tag) {
        if (!Double.isFinite(mean) || !Double.isFinite(sd) || !Double.isFinite(x) || sd <= 0.0) {
            return;
        }

        try {
            NormalDistribution normal = new NormalDistributionImpl(mean, sd);
            double p = normal.cumulativeProbability(x);
            if (!Double.isFinite(p) || p <= 0.0 || p >= 1.0) {
                return;
            }

            double recovered;
            try {
                recovered = normal.inverseCumulativeProbability(p);
            } catch (Throwable t) {
                if (isCleanRejection(t)) {
                    return;
                }
                if (isRootCauseThrowable(t)) {
                    throw asMetamorphicViolation(
                        "inverse(cdf(x)) threw for valid-by-construction input tag=" + tag +
                        " mean=" + mean + " sd=" + sd + " x=" + x + " p=" + p, t);
                }
                return;
            }

            if (!Double.isFinite(recovered)) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) produced non-finite result" +
                    " tag=" + tag + " mean=" + mean + " sd=" + sd + " x=" + x +
                    " p=" + p + " recovered=" + recovered);
            }

            double tol = 1.0e-9 * Math.max(1.0, Math.abs(x));
            if (Math.abs(recovered - x) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) != x" +
                    " tag=" + tag + " mean=" + mean + " sd=" + sd +
                    " x=" + x + " p=" + p + " recovered=" + recovered + " tol=" + tol);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            if (isCleanRejection(t)) {
