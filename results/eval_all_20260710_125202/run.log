        String digitsB = digitize(data.consumeAsciiString(data.consumeInt(0, 24)));
        if (digitsA.length() == 0) {
            digitsA = "1";
        }
        if (digitsB.length() == 0) {
            digitsB = "1";
        }

        String mixed1 = digitsA + "e" + digitsB + "E";
        String mixed2 = digitsA + "E" + digitsB + "e";
        String mixed3 = (data.consumeBoolean() ? "-" : "") + digitsA + "eE";
        exercise(mixed1);
        exercise(mixed2);
        exercise(mixed3);

