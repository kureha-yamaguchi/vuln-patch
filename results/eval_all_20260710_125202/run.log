            }
            if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
                return;
            }
            return;
        }

        char c0 = (char) ('a' + Math.abs(data.consumeInt()) % 26);
        if (c0 == 'y' || c0 == 'Y') {
            c0 = 'o';
        }
        char c1 = (char) (32 + (Math.abs(data.consumeInt()) % 95));
