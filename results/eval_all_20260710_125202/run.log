    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor();

        int n = data.consumeInt(3, 40);
        double amplitude = positiveMagnitude(data.consumeInt());
        double sigma = 0.1 + positiveMagnitude(data.consumeInt()) * 10.0;
        double center = data.consumeInt(-100, 100);
        double xStart = data.consumeInt(-50, 50);
        double xStep = 0.25 + positiveMagnitude(data.consumeInt()) * 4.0;
        double floor = data.consumeBoolean() ? 0.0 : Math.min(amplitude * 1e-6, 1e-12 + positiveMagnitude(data.consumeInt()) * 1e-9);

        double[] y = new double[n];
        for (int i = 0; i < n; i++) {
            double x = xStart + i * xStep;
            double z = (x - center) / sigma;
            double v = amplitude * Math.exp(-0.5 * z * z) + floor;
            if (!(v > 0.0) || Double.isInfinite(v) || Double.isNaN(v)) {
                v = Math.max(1e-300, amplitude);
            }
            y[i] = v;
        }

        exerciseFit(y, xStart, xStep, true);

        if (data.remainingBytes() > 0) {
            int m = Math.min(data.remainingBytes(), 40);
            byte[] extra = data.consumeBytes(m);
            double[] y2 = new double[Math.max(3, extra.length == 0 ? 3 : extra.length)];
            for (int i = 0; i < y2.length; i++) {
                int b = extra.length == 0 ? i : (extra[i % extra.length] & 0xFF);
                double xx = xStart + i * xStep;
                double base = amplitude * Math.exp(-0.5 * Math.pow((xx - center) / sigma, 2.0)) + floor;
                double factor = 0.5 + (b / 255.0);
                double v = Math.max(1e-300, base * factor);
                y2[i] = v;
            }
            exerciseFit(y2, xStart, xStep, true);
        }
    }

    private static void runAnchor() {
        exerciseFit(ANCHOR_DATA, 0.0, 1.0, true);
    }

    private static void exerciseFit(double[] y, double xStart, double xStep, boolean validByConstruction) {
        try {
            GaussianFitter fitter = buildFitter(y, xStart, xStep);
            fitter.fit();
        } catch (Throwable t) {
            if (validByConstruction && isRootCauseFromPatchedRegion(t)) {
                sneakyThrow(t);
            }
            return;
        }

        /* Contract/metamorphic check:
         * GaussianFitter.fit() is defined by the implementation itself as:
         *   final double[] guess = (new ParameterGuesser(getObservations())).guess();
         *   return fit(guess);
         * Therefore, for any observation set accepted by the library, calling fit()
         * must produce the same result as explicitly computing the same guess and
         * calling fit(guess). A patch that merely suppresses the exception path or
         * changes the delegated call incorrectly breaks this equivalence even when no
         * exception is thrown.
         *
