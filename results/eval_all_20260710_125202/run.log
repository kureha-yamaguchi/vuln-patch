package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Number anchor = NumberUtils.createNumber("1234.5");
        if (anchor == null || anchor.doubleValue() != 1234.5d) {
            throw new IllegalStateException("anchor parse failed");
        }

        exerciseRegressionCorpus();

        assertUppercaseHexContract("0Xfade");
        assertUppercaseHexContract("-0Xfade");

        tryCreateNumber(data.consumeString(64));

        String validUpperHex = buildValidUppercaseHexLiteral(data);
        assertUppercaseHexContract(validUpperHex);

        String lowerHex = validUpperHex.startsWith("-0X")
                ? "-0x" + validUpperHex.substring(3)
                : "0x" + validUpperHex.substring(2);
        assertEquivalentHexPrefixes(validUpperHex, lowerHex);

        tryCreateNumber(buildLongLiteral(data));
        tryCreateNumber(buildScientificLiteral(data));
        tryCreateNumber(buildFixedPointLiteral(data));
        tryCreateNumber(buildBigIntegerLiteral(data));
        tryCreateNumber(data.consumeRemainingAsString());
    }

    private static void exerciseRegressionCorpus() {
        String[] literals = new String[] {
                "12345",
                "1234.5D",
                "1234.5d",
                "1234.5F",
                "1234.5f",
                "12345L",
                "12345l",
                "-1234.5",
                "-12345",
                "0xFADE",
                "0Xfade",
                "-0xFADE",
                "-0Xfade",
                "1.1E200",
                "1.1E20",
                "-1.1E200",
                "1.1E-200",
                "12345678901234567890L",
                "1.1E-700F",
                "2.",
                "-1l",
                "01l",
                "1l",
                "1eE"
        };
        for (int i = 0; i < literals.length; i++) {
            tryCreateNumber(literals[i]);
        }
    }

    private static void tryCreateNumber(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isReachableRegionException(t)) {
                return;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException;
    }

    private static boolean isReachableRegionException(Throwable t) {
        StackTraceElement[] trace = t.getStackTrace();
        for (int i = 0; i < trace.length; i++) {
            String cls = trace[i].getClassName();
            String method = trace[i].getMethodName();
            if ("org.apache.commons.lang3.math.NumberUtils".equals(cls)) {
                if ("createNumber".equals(method)
                        || "createInteger".equals(method)
                        || "isAllZeros".equals(method)
                        || "isDigits".equals(method)
                        || "createLong".equals(method)
                        || "createBigInteger".equals(method)
                        || "createFloat".equals(method)
                        || "createDouble".equals(method)
                        || "createBigDecimal".equals(method)) {
                    return true;
                }
            }
            if ("java.lang.String".equals(cls) && ("charAt".equals(method) || "substring".equals(method))) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(cls) && "isBlank".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static void assertUppercaseHexContract(String upperHex) {
        Integer expected;
        try {
            expected = NumberUtils.createInteger(upperHex);
        } catch (RuntimeException t) {
            tryCreateNumber(upperHex);
            return;
        }

        Number actual;
        try {
            actual = NumberUtils.createNumber(upperHex);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) && isReachableRegionException(t)) {
                throw new RuntimeException("metamorphic violation: valid uppercase hex rejected input=" + upperHex, t);
            }
            return;
        }

        if (actual == null || actual.intValue() != expected.intValue()) {
            throw new RuntimeException(
                    "metamorphic violation: createNumber/createInteger disagree for valid uppercase hex input="
                            + upperHex + " lhs=" + actual + " rhs=" + expected);
        }
    }

    private static void assertEquivalentHexPrefixes(String upperHex, String lowerHex) {
        Integer upperOracle;
        Integer lowerOracle;
        try {
            upperOracle = NumberUtils.createInteger(upperHex);
            lowerOracle = NumberUtils.createInteger(lowerHex);
        } catch (RuntimeException t) {
            tryCreateNumber(upperHex);
            tryCreateNumber(lowerHex);
            return;
        }

        if (!upperOracle.equals(lowerOracle)) {
            throw new RuntimeException(
                    "metamorphic violation: createInteger oracle mismatch input=" + upperHex + " lhs=" + upperOracle
                            + " rhs=" + lowerOracle);
        }

        Number upperNumber;
        Number lowerNumber;
        try {
            upperNumber = NumberUtils.createNumber(upperHex);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) && isReachableRegionException(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid 0X-prefixed hex rejected input=" + upperHex, t);
            }
            return;
        }

        try {
            lowerNumber = NumberUtils.createNumber(lowerHex);
        } catch (RuntimeException t) {
            return;
        }

        if (upperNumber == null || lowerNumber == null) {
            throw new RuntimeException(
                    "metamorphic violation: equivalent hex prefixes returned null input=" + upperHex + " lhs="
                            + upperNumber + " rhs=" + lowerNumber);
        }
        if (!upperNumber.equals(lowerNumber)) {
            throw new RuntimeException(
                    "metamorphic violation: 0X and 0x forms must be equivalent input=" + upperHex + " lhs="
                            + upperNumber + " rhs=" + lowerNumber);
        }
    }

    private static String buildValidUppercaseHexLiteral(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        int magnitude = data.consumeInt(0, Integer.MAX_VALUE);
        String digits = Integer.toHexString(magnitude).toUpperCase();

        if (digits.length() == 0) {
            digits = "0";
        }

        int forceAlphaIndex = data.consumeInt(0, digits.length() - 1);
        char forced = "ABCDEF".charAt(data.consumeInt(0, 5));
        StringBuilder sb = new StringBuilder(digits);
        sb.setCharAt(forceAlphaIndex, forced);

        int leadingZeros = data.consumeInt(0, 6);
        StringBuilder full = new StringBuilder();
        if (negative) {
            full.append("-0X");
        } else {
            full.append("0X");
        }
        for (int i = 0; i < leadingZeros; i++) {
            full.append('0');
        }
        full.append(sb.toString());
        return full.toString();
    }

    private static String buildLongLiteral(FuzzedDataProvider data) {
        long hi = ((long) data.consumeInt()) << 32;
        long lo = data.consumeInt() & 0xffffffffL;
        long value = hi ^ lo;
        return Long.toString(value) + (data.consumeBoolean() ? "L" : "l");
    }

    private static String buildBigIntegerLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        int len = data.consumeInt(1, 40);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        if (sb.length() == 1 && sb.charAt(0) == '-') {
            sb.append('0');
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }

    private static String buildFixedPointLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 999999));
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracLen = data.consumeInt(0, 12);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return sb.toString();
    }

    private static String buildScientificLiteral(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append('-');
        }
        sb.append(data.consumeInt(0, 9999));
        if (data.consumeBoolean()) {
            sb.append('.');
            int fracLen = data.consumeInt(0, 8);
            for (int i = 0; i < fracLen; i++) {
                sb.append((char) ('0' + data.consumeInt(0, 9)));
            }
        }
        sb.append(data.consumeBoolean() ? 'E' : 'e');
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '+' : '-');
        }
        sb.append(data.consumeInt(0, 999));
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'F' : 'f');
        } else if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'D' : 'd');
        }
        return sb.toString();
    }
}
