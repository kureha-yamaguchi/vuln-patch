public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map registry = new HashMap();

        // Anchor: same escaped-quote shape as the regression, but with a standard {0}
        // so the pattern is valid without any custom FormatFactory and must flow through
        // ExtendedMessageFormat's real pattern parser.
        checkPattern("it''s a {0} 'test'!", "DUMMY", registry);

        String a = scrub(data.consumeAsciiString(16));
        String b = scrub(data.consumeAsciiString(16));
        String c = scrub(data.consumeAsciiString(16));
        String d = scrub(data.consumeAsciiString(16));
        String arg = data.consumeString(32);

        String pattern;
        switch (data.consumeInt(0, 5)) {
            case 0:
                pattern = a + "''" + b + " {0}";
                break;
            case 1:
                pattern = "''" + a + " {0} '" + b + "'";
                break;
            case 2:
                pattern = a + " {0} " + b + "''" + c;
                break;
            case 3:
                pattern = a + " 'x''y' {0} " + b;
                break;
            case 4:
                pattern = a + "''" + b + " 'q' {0} " + c + "''" + d;
                break;
            default:
                pattern = a + " {0} '" + b + "' " + c + "''" + d;
                break;
        }

        checkPattern(pattern, arg, registry);
    }

    private static void checkPattern(String pattern, Object arg, Map registry) {
        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
        String actual = emf.format(new Object[] { arg });

        // Metamorphic/post-condition:
        // With an empty registry, ExtendedMessageFormat should behave like MessageFormat
        // on the same valid pattern because there are no custom formats to change semantics.
        String expected = new MessageFormat(pattern, Locale.US).format(new Object[] { arg });
        if (!actual.equals(expected)) {
            throw new RuntimeException(
                "metamorphic violation: pattern=" + pattern + " actual=" + actual + " expected=" + expected);
        }
    }

    private static String scrub(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch != '{' && ch != '}' && ch != '\'') {
                out.append(ch);
            }
        }
        return out.toString();
    }
}
