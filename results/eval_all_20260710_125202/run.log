package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final double anchorP = 0.9772498680518209d;

        /*
         * Contract asserted below:
         * For a real distribution, inverseCumulativeProbability(cumulativeProbability(x))
         * should recover x for values built from the same distribution, and the regression
         * test documents the specific oracle inverseCumulativeProbability(0.9772498680518209) == 2.0.
         * A "fix" that merely deletes/avoids the throw but returns a silent wrong answer
         * violates this observable API post-condition.
         */

        // ANCHOR: exact regression input first.
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0d, 1.0d);
            double result = anchor.inverseCumulativeProbability(anchorP);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor inverseCumulativeProbability exact oracle input="
                        + anchorP + " lhs=" + result + " rhs=2.0");
            }
        } catch (Throwable t) {
            boolean rootCause = false;
            if (t instanceof MathException) {
                for (StackTraceElement e : t.getStackTrace()) {
                    String c = e.getClassName();
                    String m = e.getMethodName();
                    if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(c) && "bracket".equals(m))
                        || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(c)
                            && "inverseCumulativeProbability".equals(m))) {
                        rootCause = true;
                        break;
                    }
                }
            }
            if (rootCause) {
                throw (RuntimeException) new RuntimeException("anchor root-cause exception", t);
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            return;
        }

        // EXPLORE: generate many valid-by-construction probabilities p = CDF(k)
        // for integer k >= 2 on the real NormalDistribution API. These inputs make
        // the inverse round-trip obligation directly observable.
        try {
            NormalDistribution normal = new NormalDistributionImpl(0.0d, 1.0d);
            int k = data.consumeInt(2, 32);

            double p;
            try {
                p = normal.cumulativeProbability((double) k);
            } catch (Throwable t) {
                return;
            }

            double inv;
            try {
                inv = normal.inverseCumulativeProbability(p);
            } catch (Throwable t) {
                boolean rootCause = false;
                if (t instanceof MathException) {
                    for (StackTraceElement e : t.getStackTrace()) {
                        String c = e.getClassName();
                        String m = e.getMethodName();
                        if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(c) && "bracket".equals(m))
                            || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(c)
                                && "inverseCumulativeProbability".equals(m))) {
                            rootCause = true;
                            break;
                        }
                    }
                }
                if (rootCause) {
                    throw (RuntimeException) new RuntimeException(
                        "valid round-trip input triggered root-cause exception: k=" + k + " p=" + p, t);
                }
                return;
            }

            if (Double.isNaN(inv) || Math.abs(inv - (double) k) > 1.0e-9d) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(k)) round-trip input=k:" + k
                        + " lhs=" + inv + " rhs=" + (double) k + " p=" + p);
            }

            // Additional equivalent-input check on the same real API:
            // if p = CDF(k), then inverseCumulativeProbability(1 - p) should be -k
            // for the standard normal distribution's symmetry.
            // If either side throws, the check does not apply.
            try {
                double reflected = normal.inverseCumulativeProbability(1.0d - p);
                if (Double.isNaN(reflected) || Math.abs(reflected + (double) k) > 1.0e-9d) {
                    throw new RuntimeException(
                        "metamorphic violation: normal symmetry inverse(1-cdf(k))=-k input=k:" + k
                            + " lhs=" + reflected + " rhs=" + (-(double) k) + " p=" + p);
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (RuntimeException e) {
            throw e;
        } catch (Throwable ignored) {
            return;
        }
    }
}
