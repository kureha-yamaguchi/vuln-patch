                                    + " before=" + beforeObj
                                    + " source=" + source
                                    + " width=" + width
                                    + " pad=" + (int) padChar
                                    + " expected=" + expectedObj
                                    + " actual=" + actualObj
                                    + " beforeLen=" + beforeObj.length()
                                    + " afterLen=" + sbObj.length());
