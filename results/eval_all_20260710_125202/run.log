public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact failing test input first.
        try {
            BisectionSolver solver = new BisectionSolver();
            double r = solver.solve(f, 3.0, 3.2, 3.1);

            // Contract / observable guarantee:
            // BisectionSolver.solve(f, min, max, initial) in this class is supposed to behave
            // like solve(f, min, max); the failing test asserts the returned root is PI within
            // solver accuracy for [3.0, 3.2]. A throw-deleting or branch-skipping patch can
            // avoid the NPE but still return a wrong value, so we assert the documented result.
            double acc = solver.getAbsoluteAccuracy();
            if (!Double.isFinite(r) || Math.abs(r - Math.PI) > acc) {
                throw new RuntimeException("metamorphic violation: anchor root not near PI input=[3.0,3.2,3.1] result=" + r + " acc=" + acc);
            }

            // Equivalent-input relation using only real library calls:
            // for BisectionSolver, the overload with 'initial' delegates to the same 3-arg solve
            // and therefore must agree with solve(f, min, max) on the same bracketing interval.
            try {
                BisectionSolver solver2 = new BisectionSolver();
                double r2 = solver2.solve(f, 3.0, 3.2);
                double tol = Math.max(acc, solver2.getAbsoluteAccuracy()) * 2.0;
                if (Double.isFinite(r2) && Math.abs(r - r2) > tol) {
                    throw new RuntimeException("metamorphic violation: solve(f,min,max,initial) != solve(f,min,max) input=[3.0,3.2,3.1] lhs=" + r + " rhs=" + r2 + " tol=" + tol);
                }
            } catch (Throwable t) {
                // If either side throws, the relation does not apply for this input.
            }
        } catch (Throwable t) {
            if (shouldPropagate(t)) {
                throwUnchecked(t);
            }
            return;
        }

        int iters = 1 + Math.abs(data.consumeInt(0, 3));
        for (int i = 0; i < iters; i++) {
            exerciseExplore(data, f);
        }
    }

    private static void exerciseExplore(FuzzedDataProvider data, UnivariateRealFunction f) {
        // Root-cause property:
        // any non-null function passed to solve(f, min, max, initial) reaches the patched
