package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Contract asserted below:
        // For a continuous normal distribution, inverseCumulativeProbability(cumulativeProbability(x))
        // should recover x (up to floating-point tolerance) for x values we construct ourselves.
        // A patch that merely deletes the throw in bracket or otherwise changes control flow can
        // make the call stop crashing but still return the wrong quantile; this round-trip check
        // detects that observable misbehavior.

        // ANCHOR: exact regression input from the failing test.
        try {
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            double p = 0.9772498680518209d;
            double result = anchor.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException(
                    "metamorphic violation: anchor inverse(CDF(2)) input=" + p +
                    " expected=2.0 actual=" + result);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
            // Unrelated/pre-existing failures are ignored.
        }

        // EXPLORE: valid-by-construction inputs satisfying the root-cause property:
        // p is produced by the real NormalDistribution cumulativeProbability at a known x,
        // so inverseCumulativeProbability(p) is obliged to return that x for a correct implementation.
        double mean = boundedDouble(data.consumeInt(), -10.0d, 10.0d);
        double sd = 0.5d + boundedDouble(data.consumeInt(), 0.0d, 10.0d);
        int selector = data.consumeInt(0, 7);
        double knownX;
        switch (selector) {
            case 0:
                knownX = mean + sd * 2.0d;
                break;
            case 1:
                knownX = mean - sd * 2.0d;
                break;
            case 2:
                knownX = mean + sd;
                break;
            case 3:
                knownX = mean - sd;
                break;
            case 4:
                knownX = mean;
                break;
            case 5:
                knownX = mean + sd * 3.0d;
                break;
            case 6:
                knownX = mean - sd * 3.0d;
                break;
            default:
                knownX = mean + sd * boundedDouble(data.consumeInt(), -4.0d, 4.0d);
                break;
        }

        try {
            NormalDistribution normal = new NormalDistributionImpl(mean, sd);
            double p = normal.cumulativeProbability(knownX);
            double inv = normal.inverseCumulativeProbability(p);

            double tol = Math.max(1.0e-12d, Math.abs(sd) * 1.0e-12d);
            if (Math.abs(inv - knownX) > tol) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) input=" + knownX +
                    " p=" + p + " lhs=" + inv + " rhs=" + knownX +
                    " mean=" + mean + " sd=" + sd);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
        }

        // Additional metamorphic relation using only real library calls:
        // For any normal distribution, by symmetry around the mean,
        // inverseCumulativeProbability(1 - p) == 2*mean - inverseCumulativeProbability(p)
        // for valid probabilities strictly between 0 and 1.
        try {
            NormalDistribution normal = new NormalDistributionImpl(mean, sd);
            double x = mean + sd * boundedDouble(data.consumeInt(), -3.0d, 3.0d);
            double p = normal.cumulativeProbability(x);

            if (p > 0.0d && p < 1.0d) {
                double left = normal.inverseCumulativeProbability(1.0d - p);
                double right = 2.0d * mean - normal.inverseCumulativeProbability(p);
                double tol = Math.max(1.0e-12d, Math.abs(sd) * 1.0e-12d);
                if (Math.abs(left - right) > tol) {
                    throw new RuntimeException(
                        "metamorphic violation: normal symmetry p=" + p +
                        " lhs=" + left + " rhs=" + right +
                        " mean=" + mean + " sd=" + sd);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw propagate(t);
            }
        }

        // Steer some executions into real validation paths as negative testing,
        // but swallow clean argument-checking failures.
        try {
            double badSd = data.consumeBoolean() ? 0.0d : -Math.abs(boundedDouble(data.consumeInt(), 0.0d, 10.0d));
            new NormalDistributionImpl(mean, badSd);
        } catch (Throwable t) {
            if (!isCleanRejection(t) && isRootCause(t)) {
                throw propagate(t);
            }
        }
    }

    private static double boundedDouble(int raw, double min, double max) {
        long u = raw & 0xffffffffL;
        double fraction = u / (double) 0xffffffffL;
        return min + (max - min) * fraction;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
            || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (t instanceof RuntimeException && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:")) {
            return true;
        }
        if (!(t instanceof MathException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if (("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method))
                || ("org.apache.commons.math.distribution.AbstractContinuousDistribution".equals(cls)
                    && "inverseCumulativeProbability".equals(method))
                || ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && "createIllegalArgumentException".equals(method))
                || ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "value".equals(method))
                || ("org.apache.commons.math.ConvergenceException".equals(cls)
                    && "<init>".equals(method))
                || ("org.apache.commons.math.MathRuntimeException".equals(cls)
                    && "buildMessage".equals(method))) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException propagate(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
