package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            StringUtils.join((Object[]) null, ',');
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCauseNpe(t)) {
                return;
            }
        }

        try {
            String anchor = StringUtils.join(new Object[] { null }, '/', 0, 1);
            StringUtils.length(anchor);
            if (!"".equals(anchor)) {
                throw new RuntimeException("metamorphic violation: documented null-element join with char separator should produce empty string input=[null] lhs=" + anchor + " rhs=");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
            throw t;
        }

        try {
            String anchor = StringUtils.join(new Object[] { null }, "/", 0, 1);
            StringUtils.length(anchor);
            if (!"".equals(anchor)) {
                throw new RuntimeException("metamorphic violation: documented null-element join with string separator should produce empty string input=[null] lhs=" + anchor + " rhs=");
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
            throw t;
        }

        int len = data.consumeInt(1, 8);
        Object[] array = new Object[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                array[i] = null;
            } else {
                array[i] = data.consumeString(16);
            }
        }

        if (data.consumeBoolean()) {
            array[0] = null;
        }
        if (len > 1 && data.consumeBoolean()) {
            array[data.consumeInt(0, len - 1)] = null;
        }

        int start = data.consumeInt(0, len);
        int end = data.consumeInt(start, len);
        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString = data.consumeBoolean() ? null : data.consumeString(8);

        /* Contract asserted:
         * join(array, sep, start, end) iterates from startIndex to endIndex and concatenates the
         * selected elements, inserting the separator between positions and skipping null elements'
         * content. Therefore, joining a slice must equal joining the materialized subarray over its
         * full range. A throw-deleting or branch-skipping patch that changes observable output would
         * violate this equivalence.
         */
        checkSliceEquivalenceChar(array, sepChar, start, end);
        checkSliceEquivalenceString(array, sepString, start, end);

        /* Equivalent-input relation:
         * A one-character String separator has the same semantics as the corresponding char
         * separator for every valid input. Both are real public StringUtils entry points.
         */
        checkCharVsStringEquivalence(array, sepChar, start, end);
    }

    private static void checkSliceEquivalenceChar(Object[] array, char sep, int start, int end) {
        String lhs;
        String rhs;
        try {
            lhs = StringUtils.join(array, sep, start, end);
            Object[] sub = slice(array, start, end);
            rhs = StringUtils.join(sub, sep, 0, sub.length);
            StringUtils.length(lhs);
            StringUtils.length(rhs);
        } catch (RuntimeException t) {
            if (isCleanRejection(t) || isRootCauseNpe(t)) {
                return;
            }
            return;
        }
        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException("metamorphic violation: slice equivalence (char) inputStart=" + start + " inputEnd=" + end + " lhs=" + lhs + " rhs=" + rhs);
        }
    }

    private static void checkSliceEquivalenceString(Object[] array, String sep, int start, int end) {
        String lhs;
