package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.MessageFormat;
import java.text.ParsePosition;
import java.util.Collections;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map EMPTY_REGISTRY = Collections.EMPTY_MAP;
    private static final Map LOWER_REGISTRY = createLowerRegistry();

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryAnchor();

        String a = sanitize(data.consumeAsciiString(24));
        String b = sanitize(data.consumeAsciiString(24));
        String c = sanitize(data.consumeAsciiString(24));
        String d = sanitize(data.consumeAsciiString(24));
        String arg = sanitizeArg(data.consumeString(24));
        int mode = data.consumeInt(0, 4);

        String pattern;
        switch (mode) {
            case 0:
                pattern = a + "''" + b + "{0}" + c;
                break;
            case 1:
                pattern = "{0}" + a + "''" + b;
                break;
            case 2:
                pattern = a + "''" + b + " {0} " + c + "''" + d;
                break;
            case 3:
                pattern = a + " '" + b + "' " + c + "''" + d + "{0}";
                break;
            default:
                pattern = a + "''" + b + "{" + 0 + "}" + c;
                break;
        }

        checkEquivalentToMessageFormat(pattern, arg);
    }

    private static void tryAnchor() {
        String pattern = "it''s a {0,lower} 'test'!";
        try {
            String out = new ExtendedMessageFormat(pattern, LOWER_REGISTRY).format(new Object[] { "DUMMY" });
            if (!"it's a dummy test!".equals(out)) {
                throw new RuntimeException("metamorphic violation: anchor expected=it's a dummy test! actual=" + out);
            }
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (OutOfMemoryError) t;
            }
        }
    }

    private static void checkEquivalentToMessageFormat(String pattern, String arg) {
        String lhs;
        try {
            lhs = new ExtendedMessageFormat(pattern, EMPTY_REGISTRY).format(new Object[] { arg });
        } catch (Throwable t) {
            if (isRootCause(t)) {
                throw (OutOfMemoryError) t;
            }
            return;
        }

        String rhs;
        try {
            rhs = new MessageFormat(pattern).format(new Object[] { arg });
        } catch (Throwable t) {
            return;
        }

        /*
         * Contract asserted:
         * ExtendedMessageFormat is a MessageFormat extension; with a non-null but empty registry
         * and only standard {0} elements, it must behave like MessageFormat for the same pattern.
         * A patch that merely deletes bookkeeping like next(pos) can avoid the crash but silently
         * change quote handling, breaking this equivalence.
         */
        if (!lhs.equals(rhs)) {
            throw new RuntimeException(
                "metamorphic violation: ExtendedMessageFormat(empty registry) != MessageFormat pattern=" +
                pattern + " lhs=" + lhs + " rhs=" + rhs + " arg=" + arg);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(e.getClassName())
                    && "appendQuotedString".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static String sanitize(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (ch != '{' && ch != '}' && ch != '\'') {
                sb.append(ch);
            }
        }
        return sb.toString();
    }

    private static String sanitizeArg(String s) {
        if (s == null) {
            return "";
        }
        return s.replace('{', '_').replace('}', '_');
    }

    private static Map createLowerRegistry() {
        Map map = new HashMap();
        map.put("lower", new LowerFormatFactory());
        return map;
    }

    private static final class LowerFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new LowerFormat(locale == null ? Locale.getDefault() : locale);
        }
    }

    private static final class LowerFormat extends Format {
        private final Locale locale;

        private LowerFormat(Locale locale) {
            this.locale = locale;
        }

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            String s = String.valueOf(obj);
            toAppendTo.append(s.toLowerCase(locale));
            return toAppendTo;
        }

        public Object parseObject(String source, ParsePosition pos) {
            pos.setErrorIndex(pos.getIndex());
            return null;
        }
    }
}
