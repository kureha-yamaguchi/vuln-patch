private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor gap copy returned null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid same-gap range was rejected", e);
            }
            throw e;
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy returned null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid before-first range was rejected", e);
            }
            throw e;
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor existing-period copy was rejected", e);
            }
            throw e;
        }
    }
