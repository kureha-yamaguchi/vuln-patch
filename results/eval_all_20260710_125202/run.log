                 * changing container contents or constraint must yield the same size and same
                 * stored bounds. A state-corrupting patch (for example, nulling leftBlock during
                 * the first call) breaks this relation even if no exception is thrown.
                 */
                if (Math.abs(s1.getWidth() - s2.getWidth()) > 0.0000001
                        || Math.abs(s1.getHeight() - s2.getHeight()) > 0.0000001
                        || leftBounds2 == null
                        || Math.abs(leftWidth1 - leftBounds2.getWidth()) > 0.0000001
                        || Math.abs(leftHeight1 - leftBounds2.getHeight()) > 0.0000001
                        || Math.abs(leftX1 - leftBounds2.getX()) > 0.0000001
                        || Math.abs(leftY1 - leftBounds2.getY()) > 0.0000001) {
                    throw new RuntimeException("metamorphic violation: repeated arrange changed result"
                            + " firstSize=" + s1.getWidth() + "x" + s1.getHeight()
                            + " secondSize=" + s2.getWidth() + "x" + s2.getHeight()
                            + " firstLeft=" + rectToString(leftBounds1)
                            + " secondLeft=" + rectToString(leftBounds2));
                }

                if (right != null) {
                    Rectangle2D rb = right.getBounds();
                    if (rb == null || rb.getWidth() <= 0.0 || rb.getHeight() <= 0.0) {
                        throw new RuntimeException("metamorphic violation: right block lost its positive bounds"
                                + " rightBounds=" + String.valueOf(rb));
                    }
                }

                if (bottom != null) {
                    Rectangle2D bb = bottom.getBounds();
                    if (bb == null || bb.getWidth() <= 0.0 || bb.getHeight() <= 0.0) {
                        throw new RuntimeException("metamorphic violation: bottom block lost its positive bounds"
                                + " bottomBounds=" + String.valueOf(bb));
                    }
                }
            } catch (Throwable t) {
                handleThrowable(t, true);
            }
        } finally {
            g2.dispose();
        }
    }

    private static void tryArrange(BlockContainer container, Graphics2D g2,
                                   RectangleConstraint constraint, boolean validByConstruction) {
        try {
            container.arrange(g2, constraint);
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction);
        }
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction) {
        if (t instanceof RuntimeException && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:")) {
            throw (RuntimeException) t;
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (validByConstruction && isRootCauseInReachableRegion(t)) {
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
            throw new RuntimeException(t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException
                || t instanceof NumberFormatException;
    }

    private static boolean isRootCauseInReachableRegion(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.jfree.chart.block.BorderArrangement".equals(cls)
                    && ("arrangeFF".equals(m)
                    || "arrangeFN".equals(m)
                    || "arrange".equals(m))) {
                return true;
            }
            if ("org.jfree.chart.block.BlockContainer".equals(cls) && "arrange".equals(m)) {
                return true;
            }
            if ("org.jfree.chart.block.AbstractBlock".equals(cls)
                    && ("getWidth".equals(m) || "setBounds".equals(m))) {
                return true;
            }
            if ("org.jfree.data.Range".equals(cls) && "<init>".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static double positiveDim(FuzzedDataProvider data, int max) {
        return 1.0 + data.consumeInt(0, max);
    }

    private static String rectToString(Rectangle2D r) {
        if (r == null) {
            return "null";
        }
        return r.getX() + "," + r.getY() + "," + r.getWidth() + "," + r.getHeight();
    }
}
