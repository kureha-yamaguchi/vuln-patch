package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        anchor();

        String prefix = data.consumeString(32);
        int width = data.consumeInt(1, 32);
        int extra = data.consumeInt(1, 32);
        char padChar = (char) (data.consumeByte() & 0xFF);

        String source = data.consumeString(64);
        int requiredLen = width + extra;
        if (source.length() < requiredLen) {
            StringBuilder sb = new StringBuilder(source);
            while (sb.length() < requiredLen) {
                sb.append('X');
            }
            source = sb.toString();
        } else if (source.length() > 128) {
            source = source.substring(0, 128);
        }

        explore(prefix, source, width, padChar);
    }

    private static void anchor() {
        try {
            StrBuilder sb = new StrBuilder(1);
            applyAndCheck(sb, "foo", 1, '-');
        } catch (RuntimeException t) {
            if (shouldPropagate(t)) {
                throw t;
            }
        }
    }

    private static void explore(String prefix, String source, int width, char padChar) {
        try {
            /*
             * Contract asserted: appendFixedWidthPadRight appends exactly one fixed-width field.
             * Its externally visible result must not depend on internal buffer capacity, and when
             * source.length() >= width it must append the leftmost width characters and increase
             * length by exactly width. A throw-deleting or branch-skipping patch would violate this.
             */
            StrBuilder small = new StrBuilder(prefix.length() + 1);
            small.append(prefix);
            applyAndCheck(small, source, width, padChar);

            StrBuilder large = new StrBuilder(prefix.length() + source.length() + width + 8);
            large.append(prefix);
            applyAndCheck(large, source, width, padChar);

            String smallOut = small.toString();
            String largeOut = large.toString();
            int smallLen = small.length();
            int largeLen = large.length();

            if (smallLen != largeLen || !smallOut.equals(largeOut)) {
                throw new RuntimeException(
                        "metamorphic violation: appendFixedWidthPadRight result must be independent of initial capacity"
                                + " prefix=" + prefix
                                + " source=" + source
                                + " width=" + width
                                + " pad=" + (int) padChar
                                + " smallOut=" + smallOut
                                + " largeOut=" + largeOut
                                + " smallLen=" + smallLen
                                + " largeLen=" + largeLen);
            }
        } catch (RuntimeException t) {
            if (shouldPropagate(t)) {
                throw t;
            }
        }
    }

    private static void applyAndCheck(StrBuilder sb, Object obj, int width, char padChar) {
        int beforeLen = sb.length();
        String before = sb.toString();

        sb.appendFixedWidthPadRight(obj, width, padChar);

        if (width <= 0) {
            String afterNoop = sb.toString();
            if (sb.length() != beforeLen || !before.equals(afterNoop)) {
                throw new RuntimeException(
                        "metamorphic violation: non-positive width must leave builder unchanged"
                                + " width=" + width
                                + " before=" + before
                                + " after=" + afterNoop);
            }
            return;
        }

        String source = (obj == null) ? sb.getNullText() : obj.toString();
        if (source == null) {
            return;
        }

        String actual = sb.toString();
        String expected = before + expectedFixedWidth(source, width, padChar);

        if (sb.length() != beforeLen + width || !expected.equals(actual)) {
            throw new RuntimeException(
                    "metamorphic violation: appendFixedWidthPadRight must append exactly fixed-width content"
                            + " before=" + before
                            + " source=" + source
                            + " width=" + width
                            + " pad=" + (int) padChar
                            + " expected=" + expected
                            + " actual=" + actual
                            + " beforeLen=" + beforeLen
                            + " afterLen=" + sb.length());
        }
    }

    private static String expectedFixedWidth(String source, int width, char padChar) {
        if (width <= 0) {
            return "";
        }
        if (source.length() >= width) {
            return source.substring(0, width);
        }
        StringBuilder sb = new StringBuilder(width);
        sb.append(source);
        while (sb.length() < width) {
            sb.append(padChar);
        }
        return sb.toString();
    }

    private static boolean shouldPropagate(RuntimeException t) {
        if (t instanceof IllegalArgumentException) {
            return false;
        }
        if (isHarnessViolation(t)) {
            return true;
        }
        return isRootCause(t);
    }

    private static boolean isHarnessViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException) && !(t instanceof ArrayIndexOutOfBoundsException)) {
            return false;
        }
        StackTraceElement[] stack = t.getStackTrace();
        if (stack == null) {
            return false;
        }
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.lang.text.StrBuilder".equals(cls)) {
