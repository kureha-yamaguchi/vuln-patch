            }

            RectangleConstraint c2 = new RectangleConstraint(width, null,
                    LengthConstraintType.FIXED, 0.0, new Range(0.0, totalHeight - topSize.height),
                    LengthConstraintType.RANGE);
            Size2D expectedBottom = bottom.arrange(g2, c2);

            Size2D arranged = container.arrange(g2, constraint);

            Rectangle2D bottomBounds = bottom.getBounds();
            if (bottomBounds == null) {
                return;
            }

            // Contract asserted: in BorderArrangement.arrangeFF, when bottomBlock != null,
            // h[1] is obtained from bottomBlock.arrange(g2, c2) and then bottomBlock.setBounds(..., h[1])
            // is executed. Therefore, after a successful arrangeFF-based layout, the bottom block's
            // bounds height must equal the height returned by the real bottomBlock.arrange under c2.
            // A patch that simply deletes/skips the bottom-block bookkeeping breaks this observable API state.
            double actualBottomHeight = bottomBounds.getHeight();
            if (Math.abs(actualBottomHeight - expectedBottom.height) > 0.0000001) {
