    private static void checkEquivalentToMessageFormat(String pattern, Object[] args) {
        // Contract used for this metamorphic check:
        // with no custom registry involved, ExtendedMessageFormat is a MessageFormat-compatible parser/formatter.
        // Therefore, for any pattern that both accept, formatting the same arguments must produce the same result.
        // A patch that merely suppresses/skirts the buggy branch, or consumes quotes incorrectly, can change parsing
        // and silently alter the formatted output even when no exception is thrown.
        String lhs;
        String rhs;
