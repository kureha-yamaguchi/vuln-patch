        "public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {\n        /*\n         * Contract checks used here:\n         * 1) The unit tests for this class show that createNumber(\"1234.5\") must succeed and\n         *    produce the same numeric value/class as createFloat(\"1234.5\") for this canonical\n         *    decimal input. A patch that merely suppresses the crash by rejecting or misparsing\n         *    valid decimals would violate this observable behavior.\n         * 2) Malformed mixed-exponent inputs such as \"1eE\" are invalid and should be rejected\n         *    cleanly via validation exceptions, not by crashing with StringIndexOutOfBoundsException.\n         */\n\n        String[] fixedSeeds = new String[] {\n            \"1234.5\",\n            \"12345\",\n            \"1234.5D\",\n            \"1234.5d\",\n            \"1234.5F\",\n            \"1234.5f\",\n            \"-1234.5\",\n            \"-12345\",\n            \"0xFADE\",\n            \"-0xFADE\",\n            \"1.1E200\",\n            \"1.1E20\",\n            \"-1.1E200\",\n            \"1.1E-200\",\n            \"12345L\",\n            \"12345l\",\n            \"12345678901234567890L\",\n            \"1.1E-700F\",\n            \"2.\",\n            \"1eE\"\n        };\n\n        for (int i = 0; i < fixedSeeds.length; i++) {\n            try {\n                NumberUtils.createNumber(fixedSeeds[i]);\n            } catch (RuntimeException t) {\n                boolean inCreateNumber = false;\n                StackTraceElement[] st = t.getStackTrace();\n                for (int j = 0; j < st.length; j++) {\n                    if (\"org.apache.commons.lang3.math.NumberUtils\".equals(st[j].getClassName())\n                            && \"createNumber\".equals(st[j].getMethodName())) {\n                        inCreateNumber = true;\n                        break;\n                    }\n                }\n\n                if (fixedSeeds[i].equals(\"1eE\")) {\n                    if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {\n                        throw new RuntimeException(\n                                \"metamorphic violation: malformed scientific notation must be rejected cleanly, not crash input=1eE\",\n                                t);\n                    }\n                } else if (fixedSeeds[i].equals(\"1234.5\")) {\n                    if (inCreateNumber && !(t instanceof IllegalArgumentException)) {\n                        throw t;\n                    }\n                }\n            }\n        }\n\n        try {\n            Number lhs = NumberUtils.createNumber(\"1234.5\");\n            Number rhs = NumberUtils.createFloat(\"1234.5\");\n            if (lhs == null || rhs == null\n                    || !lhs.getClass().equals(rhs.getClass())\n                    || lhs.floatValue() != rhs.floatValue()) {\n                throw new RuntimeException(\n                        \"metamorphic violation: createNumber(\\\"1234.5\\\") should match createFloat(\\\"1234.5\\\") lhs=\"\n                                + lhs + \" rhs=\" + rhs);\n            }\n        } catch (RuntimeException t) {\n            boolean inCreateNumber = false;\n            StackTraceElement[] st = t.getStackTrace();\n            for (int j = 0; j < st.length; j++) {\n                if (\"org.apache.commons.lang3.math.NumberUtils\".equals(st[j].getClassName())\n                        && \"createNumber\".equals(st[j].getMethodName())) {\n                    inCreateNumber = true;\n                    break;\n                }\n            }\n            if (t instanceof StringIndexOutOfBoundsException && inCreateNumber) {\n                throw new RuntimeException(\n                        \"metamorphic violation: canonical decimal must parse successfully input=1234.5\", t);\n            }\n            if (t instanceof RuntimeException && !(t instanceof IllegalArgumentException)) {\n   