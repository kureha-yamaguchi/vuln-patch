package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        NormalDistribution normal = new NormalDistributionImpl(0, 1);

        // ANCHOR: exact regression input from NormalDistributionTest.testMath280.
        // Contract asserted: inverseCumulativeProbability(p) returns the quantile x for p,
        // so for the known test input it must return 2.0.
        try {
            double p = 0.9772498680518209d;
            double result = normal.inverseCumulativeProbability(p);
            if (Math.abs(result - 2.0d) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: inverseCumulativeProbability(anchor) input=" + p
                        + " lhs=" + result + " rhs=2.0");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // EXPLORE: generate many REAL inputs with the same root-cause property.
        // We construct p using the library's own cumulativeProbability(k) for integer k with |k| >= 2.
        // For a correct implementation, inverseCumulativeProbability(cumulativeProbability(k)) must recover k.
        // This directly tests the patched bracket behavior when one bracket endpoint is an exact root.
        int magnitude = data.consumeInt(2, 8);
        int sign = data.consumeBoolean() ? 1 : -1;
        int k = sign * magnitude;

        try {
            double p = normal.cumulativeProbability((double) k);
            double recovered = normal.inverseCumulativeProbability(p);
            if (Math.abs(recovered - (double) k) > 1.0e-12d) {
                throw new RuntimeException("metamorphic violation: inverse(cdf(k)) input=" + k
                        + " lhs=" + recovered + " rhs=" + k + " p=" + p);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }

        // Additional varied valid inputs from the same property, still through the public API.
        int extraCases = data.consumeInt(0, 4);
        for (int i = 0; i < extraCases; i++) {
            int kmag = data.consumeInt(2, 12);
            int ksign = data.consumeBoolean() ? 1 : -1;
            int kv = ksign * kmag;
            try {
                double p = normal.cumulativeProbability((double) kv);
                double recovered = normal.inverseCumulativeProbability(p);
                if (Math.abs(recovered - (double) kv) > 1.0e-12d) {
