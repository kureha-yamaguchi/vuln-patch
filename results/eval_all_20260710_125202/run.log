        constraints.add(new LinearConstraint(new double[] { 0.0, 0.0, 1.0, 0.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 0.0, 0.0, 1.0, 0.0 }, Relationship.GEQ, 1.0));
        constraints.add(new LinearConstraint(new double[] { 1.0, -1.0, -1.0, 0.0 }, Relationship.GEQ, -2.0));
