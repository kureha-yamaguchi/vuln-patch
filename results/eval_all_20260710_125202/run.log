public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final int MAX_ORD = 28 * 12 * 40 - 1;

        TimeSeries anchor = new TimeSeries("S");
        try {
            anchor.add(new Day(19, 8, 2005), 1);
            anchor.add(new Day(31, 1, 2006), 1);
        } catch (RuntimeException e) {
            return;
        }

        Day anchorStart = new Day(1, 12, 2005);
        Day anchorEnd = new Day(18, 1, 2006);
        try {
            anchor.getIndex(anchorStart);
            anchor.getIndex(anchorEnd);
            TimeSeries copy = anchor.createCopy(anchorStart, anchorEnd);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor same-gap copy returned null");
            }
            /*
             * Contract asserted: createCopy(start, end) returns the items whose periods lie in
             * the inclusive range [start, end]. When both bounds lie strictly inside the same
             * gap between consecutive items, there are no matching items, so the copy must be
             * empty. A throw-deleting or bookkeeping-breaking patch can silently return the
             * wrong slice; this observable itemCount check catches that.
             */
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount="
                        + copy.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (IllegalArgumentException e) {
            boolean root = false;
            for (StackTraceElement ste : e.getStackTrace()) {
                String cn = ste.getClassName();
                String mn = ste.getMethodName();
                if ("org.jfree.data.time.TimeSeries".equals(cn)
                        && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                    root = true;
                    break;
                }
            }
            if (root) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid same-gap range was rejected", e);
            }
            return;
        } catch (RuntimeException e) {
            throw e;
        }

        Day anchorBefore = new Day(18, 8, 2005);
        try {
            anchor.getIndex(anchorBefore);
            TimeSeries empty = anchor.createCopy(anchorBefore, anchorBefore);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy returned null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount="
                        + empty.getItemCount());
            }
        } catch (CloneNotSupportedException e) {
            return;
        } catch (IllegalArgumentException e) {
            boolean root = false;
            for (StackTraceElement ste : e.getStackTrace()) {
                String cn = ste.getClassName();
                String mn = ste.getMethodName();
                if ("org.jfree.data.time.TimeSeries".equals(cn)
                        && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                    root = true;
                    break;
                }
            }
            if (root) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid before-first range was rejected", e);
            }
            return;
        }

        try {
            TimeSeries byPeriod = anchor.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = anchor.createCopy(0, 1);
            if (byPeriod == null || byIndex == null) {
                throw new RuntimeException("metamorphic violation: anchor copy comparison returned null");
            }
            /*
             * Contract asserted: for existing boundaries taken directly from the series,
             * createCopy(startPeriod, endPeriod) and createCopy(startIndex, endIndex) describe
             * the same contiguous subsequence and must therefore be observably equivalent.
             */
            if (byPeriod.getItemCount() != byIndex.getItemCount()) {
                throw new RuntimeException(
                    "metamorphic violation: anchor existing-period copy != index copy itemCount lhs="
