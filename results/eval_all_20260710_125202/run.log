    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries gapCopy = s.createCopy(start, end);
            if (gapCopy == null || gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount="
                        + (gapCopy == null ? -1 : gapCopy.getItemCount()));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e) || isHarnessViolation(e)) {
                throw e;
            }
            throw e;
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            s.getIndex(beforeFirst);
            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
            if (empty == null || empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount="
                        + (empty == null ? -1 : empty.getItemCount()));
            }
        } catch (RuntimeException e) {
            if (isRootCause(e) || isHarnessViolation(e)) {
                throw e;
            }
            throw e;
        }

        try {
