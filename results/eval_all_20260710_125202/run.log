import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        BufferedImage image = new BufferedImage(200, 100, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = image.createGraphics();
        try {
            anchor(g2);
            explore(data, g2);
        } finally {
            g2.dispose();
        }
    }

    private static void anchor(Graphics2D g2) {
        RectangleConstraint constraint = new RectangleConstraint(
                10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());
        container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.LEFT);
        container.add(new EmptyBlock(1.0, 2.0), RectangleEdge.RIGHT);

        exercise(container, constraint, g2, true);
    }

    private static void explore(FuzzedDataProvider data, Graphics2D g2) {
        double totalWidth = positiveTenths(data, 1, 500);
        double leftWidth = totalWidth + positiveTenths(data, 1, 300);
        double leftHeight = positiveTenths(data, 1, 500);
        double rightWidth = positiveTenths(data, 1, 300);
        double rightHeight = positiveTenths(data, 1, 500);

        RectangleConstraint constraint = new RectangleConstraint(
                totalWidth, new Range(totalWidth, totalWidth), LengthConstraintType.FIXED,
                0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
        );

        BlockContainer container = new BlockContainer(new BorderArrangement());

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 300), positiveTenths(data, 1, 300)), RectangleEdge.TOP);
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 300), positiveTenths(data, 1, 300)), RectangleEdge.BOTTOM);
        }

        container.add(new EmptyBlock(leftWidth, leftHeight), RectangleEdge.LEFT);
        container.add(new EmptyBlock(rightWidth, rightHeight), RectangleEdge.RIGHT);

        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(positiveTenths(data, 1, 300), positiveTenths(data, 1, 300)));
        }

        exercise(container, constraint, g2, true);
    }

    private static void exercise(BlockContainer container, RectangleConstraint constraint, Graphics2D g2, boolean validByConstruction) {
        try {
            Size2D first = container.arrange(g2, constraint);

            if (!sameDouble(first.width, constraint.getWidth())) {
                throw new RuntimeException("metamorphic violation: fixed-width arrange must preserve requested width input="
                        + constraint.getWidth() + " observed=" + first.width);
            }

            try {
                // Contract/invariant used here:
                // arranging the same real BlockContainer twice with the same Graphics2D and the same
                // RectangleConstraint should be deterministic/idempotent in observable result size.
                // arrangeFF is allowed to set bounds, but it must not silently discard blocks or mutate
                // the arrangement so that a second identical arrange returns a different Size2D.
                Size2D second = container.arrange(g2, constraint);
                if (!sameDouble(first.width, second.width) || !sameDouble(first.height, second.height)) {
                    throw new RuntimeException("metamorphic violation: idempotent arrange inputWidth="
                            + constraint.getWidth() + " first=(" + first.width + "," + first.height + ") second=("
                            + second.width + "," + second.height + ")");
                }
            } catch (Throwable ignored) {
                return;
            }
        } catch (RuntimeException t) {
            if (isRootCause(t, validByConstruction)) {
                throw t;
            }
        }
    }

    private static boolean isRootCause(Throwable t, boolean validByConstruction) {
        if (!validByConstruction) {
            return false;
        }
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.jfree.chart.block.BorderArrangement".equals(ste.getClassName())) {
                String m = ste.getMethodName();
                if ("arrangeFF".equals(m) || "arrangeFN".equals(m) || "arrange".equals(m)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static double positiveTenths(FuzzedDataProvider data, int minTenths, int maxTenths) {
        return data.consumeInt(minTenths, maxTenths) / 10.0;
    }

    private static boolean sameDouble(double a, double b) {
        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
    }
}
