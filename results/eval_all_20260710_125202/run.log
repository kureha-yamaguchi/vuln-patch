    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries gapCopy = s.createCopy(start, end);
            if (gapCopy == null || gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount="
                        + (gapCopy == null ? -1 : gapCopy.getItemCount()));
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid same-gap range was rejected", e);
            }
            throw e;
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            s.getIndex(beforeFirst);
            TimeSeries emptyBefore = s.createCopy(beforeFirst, beforeFirst);
            if (emptyBefore == null || emptyBefore.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount="
                        + (emptyBefore == null ? -1 : emptyBefore.getItemCount()));
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor valid before-first range was rejected", e);
            }
            throw e;
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor existing-period copy was rejected", e);
            }
            throw e;
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 1900 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String label) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: null copy in " + label);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: unequal itemCount in " + label
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: period mismatch in " + label
                        + " index=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: value mismatch in " + label
                        + " index=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cn)
                    && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                return true;
            }
            if ("java.lang.Object".equals(cn) && "clone".equals(mn)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isHarnessViolation(RuntimeException e) {
        String m = e.getMessage();
        return m != null && m.startsWith("metamorphic violation:");
    }
}
