t;\n            }\n        }\n\n        /* Contract used below: a decimal string larger than Integer.MAX_VALUE but within long range\n           must be parsed by createNumber as a Long, matching createLong on the same canonical input. */\n        String longStr = \"2147483648\";\n        try {\n            Number parsedLong = NumberUtils.createNumber(longStr);\n            Long oracleLong = NumberUtils.createLong(longStr);\n            if (parsedLong == null || oracleLong == null\n                    || !parsedLong.getClass().equals(Long.class)\n                    || parsedLong.longValue() != oracleLong.longValue()) {\n                throw new RuntimeException(\n                        \"metamorphic violation: createNumber(long-range decimal) != createLong input=\"\n                                + longStr + \" lhs=\" + valueDesc(parsedLong) + \" rhs=\" + valueDesc(oracleLong));\n            }\n        } catch (RuntimeException t) {\n            if (isCleanRejection(t)) {\n                return;\n            }\n            if (isRootCause(t) || isMetamorphicFailure(t)) {\n                throw t;\n            }\n        }\n\n        /* Contract used below: valid scientific notation differs only by exponent-marker case.\n           Correct parsing must give equivalent results for e and E. If either side rejects, the\n           relation does not apply and is skipped. */\n        String mant = digitize(data.consumeAsciiString(data.consumeInt(0, 12)));\n        String exp = digitize(data.consumeAsciiString(data.consumeInt(0, 8)));\n        if (mant.length() == 0) {\n            mant = \"1\";\n        }\n        if (exp.length() == 0) {\n            exp = \"0\";\n        }\n        String sciLower = (data.consumeBoolean() ? \"-\" : \"\") + mant + \"e\" + exp;\n        String sciUpper = sciLower.replace('e', 'E');\n        try {\n            Number a = NumberUtils.createNumber(sciLower);\n            Number b = NumberUtils.createNumber(sciUpper);\n            if (a 