        ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, REGISTRY);
        String lhs = emf.format(new Object[] { arg });

        String plainPattern = before + "'" + between + "{0} " + quoted + "!" + after;
        String rhs = new MessageFormat(plainPattern, Locale.getDefault()).format(new Object[] {
                arg == null ? null : arg.toLowerCase()
        });

