package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.MathException;
import org.apache.commons.math.distribution.NormalDistribution;
import org.apache.commons.math.distribution.NormalDistributionImpl;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        try {
            // Contract asserted below:
            // For a continuous normal distribution, if we first compute p = cumulativeProbability(x)
            // using the real library, then inverseCumulativeProbability(p) should recover x (up to
            // small floating-point error). A patch that merely suppresses the throw in the buggy
            // bracket path could silently return the wrong quantile, so this round-trip check detects
            // wrong-output "fixes" as well as crashes.

            // ANCHOR: exact trigger from the failing test.
            NormalDistribution anchor = new NormalDistributionImpl(0.0, 1.0);
            handleNormalCase(anchor, 0.9772498680518209, 2.0, true);

            // EXPLORE: same root-cause property, but with varied real inputs.
            // The root cause is an exact root appearing at a bracket endpoint, making fa * fb be -0.0.
            // For translated standard normals, choosing p = CDF(mean + 2) exercises the same pattern
            // through the public NormalDistribution API while keeping inputs valid by construction.
            int meanInt = data.consumeInt(-1000000, 1000000);
            double mean = (double) meanInt;
            NormalDistribution shifted = new NormalDistributionImpl(mean, 1.0);
            double x = mean + 2.0;
            double p;
            try {
                p = shifted.cumulativeProbability(x);
            } catch (Throwable t) {
                return;
            }
            handleNormalCase(shifted, p, x, true);

            // Additional exploration over the same real API with varied surrounding values.
            // If any call here throws, the metamorphic check does not apply for that input.
            int count = data.consumeInt(0, 4);
            for (int i = 0; i < count; i++) {
                int localMeanInt = data.consumeInt(-10000, 10000);
                double localMean = (double) localMeanInt;
                NormalDistribution varied = new NormalDistributionImpl(localMean, 1.0);
                double localX = localMean + 2.0;
                double localP;
                try {
                    localP = varied.cumulativeProbability(localX);
                } catch (Throwable t) {
                    continue;
                }
                handleNormalCase(varied, localP, localX, true);
            }
        } catch (Throwable t) {
            sneakyThrow(t);
        }
    }

    private static void handleNormalCase(NormalDistribution dist, double p, double expectedX, boolean validByConstruction) throws MathException {
        try {
            double inverse = dist.inverseCumulativeProbability(p);

            // Metamorphic oracle from the input itself:
            // p was obtained from the same distribution as cumulativeProbability(expectedX),
            // so inverseCumulativeProbability(p) should recover expectedX for this continuous distribution.
            if (!(Math.abs(inverse - expectedX) <= 1.0e-12)) {
                throw new RuntimeException(
                    "metamorphic violation: inverse(cdf(x)) != x input=" + expectedX +
                    " p=" + p + " inverse=" + inverse + " expected=" + expectedX);
            }

            // Secondary observable post-condition via real library calls only.
            double roundTrip = dist.cumulativeProbability(inverse);
            if (!(Math.abs(roundTrip - p) <= 1.0e-12)) {
                throw new RuntimeException(
                    "metamorphic violation: cdf(inverse(p)) != p input=" + expectedX +
                    " p=" + p + " cdf(inverse)=" + roundTrip + " inverse=" + inverse);
            }
        } catch (Throwable t) {
            if (t instanceof RuntimeException && !(t instanceof MathException)) {
                throw (RuntimeException) t;
            }

            if (isCleanRejection(t) && !validByConstruction) {
                return;
            }
            if (isCleanRejection(t) && validByConstruction) {
                return;
            }

            if (isGroundTruthMathExceptionFromPatchedRegion(t)) {
                throwAsMathException(t);
            }

            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.indexOf("Illegal") >= 0 || name.indexOf("Invalid") >= 0 || name.indexOf("Argument") >= 0) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean isGroundTruthMathExceptionFromPatchedRegion(Throwable t) {
        Throwable cur = t;
        while (cur != null) {
            if (cur instanceof MathException && hasPatchedRegionFrame(cur)) {
                return true;
            }
            cur = cur.getCause();
        }
        return false;
    }

    private static boolean hasPatchedRegionFrame(Throwable t) {
        StackTraceElement[] stack = t.getStackTrace();
        for (int i = 0; i < stack.length; i++) {
            StackTraceElement e = stack[i];
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math.analysis.solvers.UnivariateRealSolverUtils".equals(cls)
                    && "bracket".equals(method)) {
                return true;
            }
            if (cls != null && cls.startsWith("org.apache.commons.math")) {
                if ("createIllegalArgumentException".equals(method)
                        || "value".equals(method)
                        || "buildMessage".equals(method)
                        || "<init>".equals(method)) {
                    return true;
                }
            }
        }
        return false;
    }

    private static void throwAsMathException(Throwable t) throws MathException {
        if (t instanceof MathException) {
            throw (MathException) t;
        }
        if (t.getCause() != null) {
            throwAsMathException(t.getCause());
        }
        throw new RuntimeException(t);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void sneakyThrow(Throwable t) throws T {
        throw (T) t;
    }
}
