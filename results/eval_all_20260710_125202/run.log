            }
        }
        return false;
    }

    private static RuntimeException asMetamorphicViolation(String msg, Throwable cause) {
        RuntimeException r = new RuntimeException("metamorphic violation: " + msg, cause);
        if (cause != null && cause.getStackTrace() != null && cause.getStackTrace().length > 0) {
            r.setStackTrace(cause.getStackTrace());
        }
        return r;
    }
}
