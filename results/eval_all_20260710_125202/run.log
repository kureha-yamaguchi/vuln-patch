package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runOne(buildAnchorInput());

        int variants = 1 + Math.min(8, Math.max(0, data.remainingBytes()));
        for (int i = 0; i < variants; i++) {
            String js = buildFuzzInput(data, i);
            runOne(js);
        }
    }

    private static void runOne(String js) {
        try {
            String out = compile(js);
            if (out != null && !isEffectivelyEmptyJs(out)) {
                throw new RuntimeException(
                    "metamorphic violation: smartNameRemoval should eliminate this unused inheritance-only program input="
                        + summarize(js) + " output=" + summarize(out));
            }

            String jsWhitespaceVariant = " \n\t" + js + "\n/*fuzz*/\n";
            String out2 = compile(jsWhitespaceVariant);
            if (out != null && out2 != null) {
                String n1 = normalizeJs(out);
                String n2 = normalizeJs(out2);
                if (!n1.equals(n2)) {
                    throw new RuntimeException(
                        "metamorphic violation: whitespace-equivalent inputs compiled differently input="
                            + summarize(js) + " lhs=" + summarize(out) + " rhs=" + summarize(out2));
                }
            }
        } catch (RuntimeException e) {
            if (isRootCause(e) || isOurMetamorphicViolation(e)) {
                throw e;
            }
        } catch (Throwable t) {
        }
    }

    private static String compile(String js) throws Exception {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        options.smartNameRemoval = true;

        JSSourceFile[] externs = new JSSourceFile[] {
            JSSourceFile.fromCode("externs.js", "")
        };
        JSSourceFile[] inputs = new JSSourceFile[] {
            JSSourceFile.fromCode("input.js", js)
        };

        compiler.compile(externs, inputs, options);
        return compiler.toSource();
    }

    private static String buildAnchorInput() {
        return "var goog = {};"
            + "goog.inherits = function(x, y) {};"
            + "var ns = {};"
            + "/** @constructor */"
            + "ns.PageSelectionModel = function() {};"
            + "/** @constructor */"
            + "ns.PageSelectionModel.FooEvent = function() {};"
            + "/** @constructor */"
            + "ns.PageSelectionModel.SelectEvent = function() {};"
            + "goog.inherits(ns.PageSelectionModel.ChangeEvent,"
            + "ns.PageSelectionModel.FooEvent);";
    }

    private static String buildFuzzInput(FuzzedDataProvider data, int salt) {
        String googObj = distinctId(sanitizeIdentifier(data.consumeAsciiString(12), "goog"), "g" + salt);
        String inheritsProp = distinctId(sanitizeIdentifier(data.consumeAsciiString(12), "inherits"), "inherits" + salt);
        String ns = distinctId(sanitizeIdentifier(data.consumeAsciiString(12), "ns"), "ns" + salt);
        String outer = distinctId(sanitizeIdentifier(data.consumeAsciiString(16), "PageSelectionModel"), "Outer" + salt);
        String base = distinctId(sanitizeIdentifier(data.consumeAsciiString(16), "FooEvent"), "Base" + salt);
        String other = distinctId(sanitizeIdentifier(data.consumeAsciiString(16), "SelectEvent"), "Other" + salt);
        String missing = distinctId(sanitizeIdentifier(data.consumeAsciiString(16), "ChangeEvent"), "Missing" + salt);

        if (base.equals(other)) {
            other = other + "X";
        }
        if (base.equals(missing)) {
            missing = missing + "Y";
        }
        if (other.equals(missing)) {
            missing = missing + "Z";
        }

        String ctorTag = data.consumeBoolean() ? "/** @constructor */" : "";
        String extraStmt = "";
        if (data.consumeBoolean()) {
            String extra = distinctId(sanitizeIdentifier(data.consumeAsciiString(12), "Extra"), "Extra" + salt);
            if (extra.equals(base) || extra.equals(other) || extra.equals(missing)) {
                extra = extra + "Q";
            }
            extraStmt = ctorTag + ns + "." + outer + "." + extra + "=function(){};";
        }

        String sep1 = data.consumeBoolean() ? "\n" : "";
        String sep2 = data.consumeBoolean() ? "\n" : "";
        String sep3 = data.consumeBoolean() ? "\n" : "";
        String sep4 = data.consumeBoolean() ? "\n" : "";

        return "var " + googObj + "={};" + sep1
            + googObj + "." + inheritsProp + "=function(x,y){};" + sep2
            + "var " + ns + "={};" + sep3
            + ctorTag + ns + "." + outer + "=function(){};" 
            + ctorTag + ns + "." + outer + "." + base + "=function(){};"
            + ctorTag + ns + "." + outer + "." + other + "=function(){};"
            + extraStmt + sep4
            + googObj + "." + inheritsProp + "("
            + ns + "." + outer + "." + missing + ","
            + ns + "." + outer + "." + base + ");";
    }

    private static String sanitizeIdentifier(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        StringBuilder b = new StringBuilder();
        char c0 = s.charAt(0);
        if (Character.isLetter(c0) || c0 == '_' || c0 == '$') {
            b.append(c0);
        } else {
            b.append('A');
        }
        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == '_' || c == '$') {
                b.append(c);
            } else {
                b.append('_');
            }
        }
        String out = b.toString();
        if (isJsKeyword(out)) {
            out = out + "_";
        }
        return out.length() == 0 ? fallback : out;
    }

    private static String distinctId(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        return s;
    }

    private static boolean isJsKeyword(String s) {
        return "break".equals(s) || "case".equals(s) || "catch".equals(s) || "continue".equals(s)
            || "default".equals(s) || "delete".equals(s) || "do".equals(s) || "else".equals(s)
            || "finally".equals(s) || "for".equals(s) || "function".equals(s) || "if".equals(s)
            || "in".equals(s) || "instanceof".equals(s) || "new".equals(s) || "return".equals(s)
            || "switch".equals(s) || "this".equals(s) || "throw".equals(s) || "try".equals(s)
            || "typeof".equals(s) || "var".equals(s) || "void".equals(s) || "while".equals(s)
            || "with".equals(s) || "class".equals(s) || "const".equals(s) || "enum".equals(s)
            || "export".equals(s) || "extends".equals(s) || "import".equals(s) || "super".equals(s);
    }

    private static boolean isEffectivelyEmptyJs(String out) {
        return normalizeJs(out).length() == 0;
    }

    private static String normalizeJs(String s) {
        if (s == null) {
            return "";
        }
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (!Character.isWhitespace(c) && c != ';') {
                b.append(c);
            }
        }
        return b.toString();
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof RuntimeException)) {
            return false;
        }
        boolean sawRelevantFrame = false;
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("com.google.javascript.jscomp.NameAnalyzer".equals(cls)
                && ("visit".equals(m)
                    || "createNameInformation".equals(m)
                    || "recordSet".equals(m)
                    || "recordPrototypeSet".equals(m)
                    || "getName".equals(m))) {
                sawRelevantFrame = true;
                break;
            }
            if ("com.google.javascript.jscomp.NodeUtil".equals(cls)
                && ("isFunction".equals(m) || "getFunctionName".equals(m))) {
                sawRelevantFrame = true;
                break;
            }
            if ("com.google.javascript.rhino.Node".equals(cls)
                && ("getType".equals(m) || "getParent".equals(m) || "getFirstChild".equals(m))) {
                sawRelevantFrame = true;
                break;
            }
        }
        if (sawRelevantFrame) {
            return true;
        }
        Throwable cause = t.getCause();
        if (cause != null && cause != t) {
            return isRootCause(cause);
        }
        return false;
    }

    private static boolean isOurMetamorphicViolation(RuntimeException e) {
        String msg = e.getMessage();
        return msg != null && msg.indexOf("metamorphic violation:") != -1;
    }

    private static String summarize(String s) {
        if (s == null) {
            return "null";
        }
        String oneLine = s.replace('\n', ' ').replace('\r', ' ').replace('\t', ' ');
        if (oneLine.length() > 200) {
            return oneLine.substring(0, 200) + "...";
        }
        return oneLine;
    }
}
