import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase("", "foo", 1, '-');

        String prefix = data.consumeString(32);
        String a = data.consumeString(64);
        String b = data.consumeRemainingAsString();
        if (a == null) {
            a = "";
        }
        if (b == null) {
            b = "";
        }

        String obj = a + b;
        if (obj.length() < 2) {
            obj = obj + "ABCD";
        }

        int maxWidth = Math.min(Math.max(1, obj.length() - 1), 32);
        int width = data.remainingBytes() > 0 ? data.consumeInt(1, maxWidth) : 1;
        if (width >= obj.length()) {
            width = obj.length() - 1;
        }
        if (width <= 0) {
            return;
        }

