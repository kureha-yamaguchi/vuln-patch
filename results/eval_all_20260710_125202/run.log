    private static void checkNoCutPostCondition(Object attr, double size, Object bary, Vector2D[][] vertices, boolean isAnchor) {
        if (vertices == null) {
            return;
        }
        if (vertices.length != 0) {
            throw new RuntimeException("metamorphic violation: no-cut tree must expose zero loops input=" + describe(attr) + " vertices=" + vertices.length + " anchor=" + isAnchor);
        }
        if (!(bary instanceof Vector2D)) {
            return;
        }
        Vector2D v = (Vector2D) bary;
        if (Boolean.TRUE.equals(attr)) {
            if (!Double.isInfinite(size) || size < 0.0d || !Double.isNaN(v.getX()) || !Double.isNaN(v.getY())) {
                throw new RuntimeException("metamorphic violation: whole-space no-cut leaf input=" + describe(attr) + " size=" + size + " x=" + v.getX() + " y=" + v.getY());
            }
        } else if (Boolean.FALSE.equals(attr)) {
            if (Double.doubleToLongBits(size) != Double.doubleToLongBits(0.0d) ||
                Double.doubleToLongBits(v.getX()) != Double.doubleToLongBits(0.0d) ||
                Double.doubleToLongBits(v.getY()) != Double.doubleToLongBits(0.0d)) {
                throw new RuntimeException("metamorphic violation: empty no-cut leaf input=" + describe(attr) + " size=" + size + " x=" + v.getX() + " y=" + v.getY() + " anchor=" + isAnchor);
