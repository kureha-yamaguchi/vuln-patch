                "var ns = {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.FooEvent = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.SelectEvent = function() {};" +
                "goog.inherits(ns.PageSelectionModel.ChangeEvent," +
                "    ns.PageSelectionModel.FooEvent);";

        assertAnchorCompiles(anchor);

        int rounds = data.consumeInt(1, 4);
        for (int i = 0; i < rounds; i++) {
            String ns = ident(data.consumeAsciiString(12), "ns");
            String model = ident(data.consumeAsciiString(12), "Model");
            String superEvent = ident(data.consumeAsciiString(12), "FooEvent");
            String siblingEvent = ident(data.consumeAsciiString(12), "SelectEvent");
            String missingEvent = ident(data.consumeAsciiString(12), "ChangeEvent");
            if (missingEvent.equals(superEvent)) {
                missingEvent = missingEvent + "X";
            }
            if (missingEvent.equals(siblingEvent)) {
                missingEvent = missingEvent + "Y";
            }

            String prefix =
                    "var goog = {};" +
                    "goog.inherits = function(x, y) {};" +
                    "var " + ns + " = {};" +
                    "/** @constructor */" +
                    ns + "." + model + " = function() {};" +
                    "/** @constructor */" +
                    ns + "." + model + "." + superEvent + " = function() {};" +
                    "/** @constructor */" +
                    ns + "." + model + "." + siblingEvent + " = function() {};";

            String missingSubclassProgram =
                    prefix +
                    "goog.inherits(" + ns + "." + model + "." + missingEvent + "," +
                    ns + "." + model + "." + superEvent + ");";

            String explicitSubclassProgram =
                    prefix +
                    "/** @constructor */" +
                    ns + "." + model + "." + missingEvent + " = function() {};" +
                    "goog.inherits(" + ns + "." + model + "." + missingEvent + "," +
                    ns + "." + model + "." + superEvent + ");";

            assertEquivalentIfBothCompile(
                    missingSubclassProgram,
                    explicitSubclassProgram,
                    ns + "." + model + "." + missingEvent);
        }
    }

