            s.getIndex(end);
            TimeSeries gapCopy = s.createCopy(start, end);

            /*
             * Exact failing-test anchor plus post-condition: the documented createCopy(start,end)
             * contract copies only items whose periods lie in [start, end]. This exact range is
             * wholly inside the gap between the two stored days, so the result must be empty.
             */
            if (gapCopy == null) {
                throw new RuntimeException("metamorphic violation: anchor same-gap copy returned null");
            }
            if (gapCopy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount=" + gapCopy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            s.getIndex(beforeFirst);
            TimeSeries emptyBefore = s.createCopy(beforeFirst, beforeFirst);
            if (emptyBefore == null) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy returned null");
            }
            if (emptyBefore.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount="
                        + emptyBefore.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        try {
            TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 1900 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String context) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: null copy in " + context);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: unequal itemCount in " + context
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: unequal period in " + context
                        + " index=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null) {
                if (vb != null) {
                    throw new RuntimeException(
                        "metamorphic violation: unequal value nullability in " + context
                            + " index=" + i + " lhs=null rhs=" + vb);
                }
            } else if (!va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: unequal value in " + context
                        + " index=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException) && !(t instanceof NumberFormatException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
