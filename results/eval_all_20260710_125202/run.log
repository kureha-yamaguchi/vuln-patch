    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor =
                "var goog = {};" +
                "goog.inherits = function(x, y) {};" +
                "var ns = {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.FooEvent = function() {};" +
                "/** @constructor */" +
                "ns.PageSelectionModel.SelectEvent = function() {};" +
                "goog.inherits(ns.PageSelectionModel.ChangeEvent," +
                "    ns.PageSelectionModel.FooEvent);";

        try {
            String out = compile(anchor);
            /* Contract/post-condition asserted:
             * The real regression tests for this exact input expect successful compilation
             * with empty output. A patch that merely deletes the crashing bookkeeping
             * statement or makes the branch unreachable can silently keep dead code,
             * so successful compilation must still yield the same observable optimized result.
             */
            if (out != null && out.trim().length() != 0) {
                throw new RuntimeException("metamorphic violation: anchor should optimize to empty output, got=" + summarize(out));
            }
        } catch (Throwable t) {
            handleThrowable(t, anchor);
        }

        String goog = "goog";
        String ns = sanitizeIdentifier(data.consumeAsciiString(20), "ns");
        String base = sanitizeIdentifier(data.consumeAsciiString(24), "PageSelectionModel");
        String superName = sanitizeIdentifier(data.consumeAsciiString(24), "FooEvent");
        String siblingName = sanitizeIdentifier(data.consumeAsciiString(24), "SelectEvent");
        String missingSubclass = sanitizeIdentifier(data.consumeAsciiString(24), "ChangeEvent");

        if (superName.equals(siblingName)) {
            siblingName = siblingName + "X";
        }
        if (superName.equals(missingSubclass)) {
            missingSubclass = missingSubclass + "Y";
        }
        if (siblingName.equals(missingSubclass)) {
            missingSubclass = missingSubclass + "Z";
        }

        int extraCount = data.consumeInt(0, 3);
        StringBuilder extras = new StringBuilder();
        for (int i = 0; i < extraCount; i++) {
            String extra = sanitizeIdentifier(data.consumeAsciiString(16), "Extra" + i);
            if (extra.equals(superName) || extra.equals(siblingName) || extra.equals(missingSubclass)) {
                extra = extra + "Q";
            }
            extras.append("/** @constructor */")
                  .append(ns).append(".").append(base).append(".").append(extra)
                  .append(" = function() {};");
        }

        String source =
                "var " + goog + " = {};" +
                goog + ".inherits = function(x, y) {};" +
                "var " + ns + " = {};" +
                "/** @constructor */" +
                ns + "." + base + " = function() {};" +
                "/** @constructor */" +
                ns + "." + base + "." + superName + " = function() {};" +
                "/** @constructor */" +
                ns + "." + base + "." + siblingName + " = function() {};" +
                extras.toString() +
                goog + ".inherits(" + ns + "." + base + "." + missingSubclass + "," +
                ns + "." + base + "." + superName + ");";

        try {
            String out = compile(source);
            /* Same contract as the regression test, generalized to alpha-renamed inputs:
             * this pattern contains only constructor declarations plus a class-defining call
             * and is unused otherwise, so smart name removal should eliminate it completely.
             * A throw-deleting or bookkeeping-skipping patch may compile but preserve code.
             */
            if (out != null && out.trim().length() != 0) {
                throw new RuntimeException(
                        "metamorphic violation: dead class-defining program should optimize to empty output input="
                                + summarize(source) + " output=" + summarize(out));
            }
        } catch (Throwable t) {
            handleThrowable(t, source);
        }
    }

    private static String compile(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);
        options.smartNameRemoval = true;
        options.prettyPrint = false;
        options.generatePseudoNames = false;

        JSSourceFile extern = JSSourceFile.fromCode("externs", "");
        JSSourceFile input = JSSourceFile.fromCode("input", js);
        compiler.compile(extern, input, options);
        return compiler.toSource();
    }

    private static void handleThrowable(Throwable t, String source) {
        if (isCleanRejection(t)) {
            return;
        }
        if (isRootCause(t)) {
            throw new RuntimeException(
                    "metamorphic violation: valid smartNameRemoval compilation triggered internal compiler error input="
                            + summarize(source), t);
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("ParseException")
                    || name.contains("Validation")
                    || name.contains("Invalid")
                    || name.contains("IllegalSyntax")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        boolean runtimeLike = false;
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof RuntimeException) {
                runtimeLike = true;
                break;
            }
        }
        if (!runtimeLike) {
            return false;
        }

        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("com.google.javascript.jscomp.NameAnalyzer".equals(cls)) {
                if ("visit".equals(method)
                        || "createNameInformation".equals(method)
                        || "recordSet".equals(method)
                        || "recordPrototypeSet".equals(method)
                        || "getName".equals(method)) {
                    return true;
                }
            }
            if ("com.google.javascript.jscomp.Compiler".equals(cls)
                    && "runCallable".equals(method)) {
                return true;
            }
        }

        Throwable cause = t.getCause();
        return cause != null && cause != t && isRootCause(cause);
    }

    private static String sanitizeIdentifier(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        StringBuilder sb = new StringBuilder();
        char first = s.charAt(0);
        if (Character.isLetter(first) || first == '_' || first == '$') {
            sb.append(first);
        } else {
            sb.append(fallback);
        }
        for (int i = 1; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == '_' || c == '$') {
                sb.append(c);
            }
        }
        if (sb.length() == 0) {
            return fallback;
        }
        String id = sb.toString();
        if (isReservedWord(id)) {
            return fallback + "R";
        }
        return id;
    }

    private static boolean isReservedWord(String s) {
        return "break".equals(s) || "case".equals(s) || "catch".equals(s) || "continue".equals(s)
                || "debugger".equals(s) || "default".equals(s) || "delete".equals(s)
                || "do".equals(s) || "else".equals(s) || "finally".equals(s) || "for".equals(s)
                || "function".equals(s) || "if".equals(s) || "in".equals(s) || "instanceof".equals(s)
                || "new".equals(s) || "return".equals(s) || "switch".equals(s) || "this".equals(s)
                || "throw".equals(s) || "try".equals(s) || "typeof".equals(s) || "var".equals(s)
                || "void".equals(s) || "while".equals(s) || "with".equals(s) || "class".equals(s)
                || "const".equals(s) || "enum".equals(s) || "export".equals(s) || "extends".equals(s)
                || "import".equals(s) || "super".equals(s) || "implements".equals(s)
                || "interface".equals(s) || "let".equals(s) || "package".equals(s)
                || "private".equals(s) || "protected".equals(s) || "public".equals(s)
                || "static".equals(s) || "yield".equals(s);
    }

    private static String summarize(String s) {
        if (s == null) {
            return "null";
        }
        if (s.length() <= 200) {
            return s.replace('\n', ' ');
        }
        return s.substring(0, 200).replace('\n', ' ') + "...(len=" + s.length() + ")";
    }
}
