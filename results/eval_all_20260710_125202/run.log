            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))));
        }
        if (data.consumeBoolean()) {
            container.add(new EmptyBlock(nonNegativeScaled(data.consumeInt(0, 5000)),
                    nonNegativeScaled(data.consumeInt(0, 5000))), RectangleEdge.RIGHT);
        }

        container.getBlocks();
        RectangleConstraint containerConstraint = new RectangleConstraint(constraintWidth, constraintHeight);

        Size2D arrangedSize;
        try {
            arrangedSize = container.arrange(g2, containerConstraint);
        } catch (RuntimeException t) {
            return;
        }

        RectangleConstraint leftConstraint = new RectangleConstraint(
                0.0, new Range(0.0, constraintWidth), LengthConstraintType.RANGE,
                constraintHeight, null, LengthConstraintType.FIXED);

        Size2D expectedLeft;
        try {
            expectedLeft = left.arrange(g2, leftConstraint);
        } catch (RuntimeException t) {
            return;
        }

        Rectangle2D actualBounds = left.getBounds();
        if (actualBounds == null) {
            throw new RuntimeException("metamorphic violation: left block bounds must be set after successful arrange input="
