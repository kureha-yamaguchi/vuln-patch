            TimeSeries byIndex = s.createCopy(0, 1);
            assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
        } catch (RuntimeException e) {
            if (isRootCause(e) || isHarnessViolation(e)) {
                throw e;
            }
            throw e;
        }
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 1900 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String where) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: null copy in " + where);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: itemCount mismatch in " + where
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod ap = a.getTimePeriod(i);
            RegularTimePeriod bp = b.getTimePeriod(i);
            if (!ap.equals(bp)) {
                throw new RuntimeException(
                    "metamorphic violation: period mismatch in " + where + " at index=" + i
                        + " lhs=" + ap + " rhs=" + bp);
            }
            Number av = a.getValue(i);
            Number bv = b.getValue(i);
            if (av == null ? bv != null : !av.equals(bv)) {
                throw new RuntimeException(
                    "metamorphic violation: value mismatch in " + where + " at index=" + i
                        + " lhs=" + av + " rhs=" + bv);
            }
        }
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException) && !(t instanceof NumberFormatException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cn = st[i].getClassName();
            String mn = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cn)
                    && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                return true;
            }
            if ("java.lang.Object".equals(cn) && "clone".equals(mn)) {
                return true;
            }
        }
        return false;
    }
