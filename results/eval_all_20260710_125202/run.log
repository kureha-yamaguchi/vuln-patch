        Graphics2D g2 = image.createGraphics();
        try {
            RectangleConstraint constraint = new RectangleConstraint(
                    10.0, new Range(10.0, 10.0), LengthConstraintType.FIXED,
                    0.0, new Range(0.0, 0.0), LengthConstraintType.NONE
            );

            BlockContainer container = new BlockContainer(new BorderArrangement());

            tryArrange(container, g2, constraint, false);

            container.clear();
            container.add(new EmptyBlock(5.0, 6.0));
            tryArrange(container, g2, constraint, false);

            container.clear();
            container.add(new EmptyBlock(15.0, 16.0));
            tryArrange(container, g2, constraint, false);

            container.clear();
            container.add(new EmptyBlock(12.3, 45.6), RectangleEdge.RIGHT);
            tryArrange(container, g2, constraint, false);
        } finally {
            g2.dispose();
        }
    }

    private static void explore(FuzzedDataProvider data) {
        BufferedImage image = new BufferedImage(64, 64, BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = image.createGraphics();
        try {
            double topW = positiveDim(data, 20);
            double topH = positiveDim(data, 20);
            double leftW = positiveDim(data, 20);
            double leftH = positiveDim(data, 20);
            double centerW = positiveDim(data, 20);
            double centerH = positiveDim(data, 20);

            boolean addRight = data.consumeBoolean();
            boolean addBottom = data.consumeBoolean();

            double rightW = addRight ? positiveDim(data, 20) : 0.0;
            double rightH = addRight ? positiveDim(data, 20) : 0.0;
            double bottomW = addBottom ? positiveDim(data, 20) : 0.0;
            double bottomH = addBottom ? positiveDim(data, 20) : 0.0;

            double widthSlack = 1.0 + data.consumeInt(0, 10);
            double heightSlack = 1.0 + data.consumeInt(0, 10);

            double totalWidth = leftW + centerW + rightW + widthSlack;
            double middleHeight = Math.max(leftH, Math.max(centerH, rightH));
            double totalHeight = topH + middleHeight + bottomH + heightSlack;

            BorderArrangement arrangement = new BorderArrangement();
            BlockContainer container = new BlockContainer(arrangement);

            EmptyBlock top = new EmptyBlock(topW, topH);
            EmptyBlock left = new EmptyBlock(leftW, leftH);
            EmptyBlock center = new EmptyBlock(centerW, centerH);

            container.add(top, RectangleEdge.TOP);
            container.add(left, RectangleEdge.LEFT);
            container.add(center);

            EmptyBlock right = null;
            if (addRight) {
                right = new EmptyBlock(rightW, rightH);
                container.add(right, RectangleEdge.RIGHT);
            }

            EmptyBlock bottom = null;
            if (addBottom) {
                bottom = new EmptyBlock(bottomW, bottomH);
                container.add(bottom, RectangleEdge.BOTTOM);
            }

            RectangleConstraint fixedFixed = new RectangleConstraint(totalWidth, totalHeight);

            try {
                Size2D s1 = container.arrange(g2, fixedFixed);

                if (Math.abs(s1.getWidth() - totalWidth) > 0.0000001
                        || Math.abs(s1.getHeight() - totalHeight) > 0.0000001) {
                    throw new RuntimeException("metamorphic violation: fixed/fixed arrange must return the fixed size"
                            + " width=" + totalWidth + " height=" + totalHeight
                            + " actual=" + s1.getWidth() + "x" + s1.getHeight());
