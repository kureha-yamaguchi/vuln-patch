                 * strictly positive available width and fixed positive height, so a correct
                 * implementation must leave the left block with positive bounds. A "fix" that
                 * merely deletes the crash-causing logic by nulling/skipping the left block
                 * violates this observable post-condition.
                 */
                if (leftBounds1 == null || leftBounds1.getWidth() <= 0.0 || leftBounds1.getHeight() <= 0.0) {
                    throw new RuntimeException("metamorphic violation: left block lost its positive bounds"
                            + " constraint=" + totalWidth + "x" + totalHeight
                            + " top=" + topW + "x" + topH
                            + " left=" + leftW + "x" + leftH
                            + " center=" + centerW + "x" + centerH
                            + " leftBounds=" + String.valueOf(leftBounds1));
                }

                if (topBounds1 == null || topBounds1.getHeight() <= 0.0) {
                    throw new RuntimeException("metamorphic violation: top block lost its positive bounds"
                            + " topBounds=" + String.valueOf(topBounds1));
                }

                if (centerBounds1 == null || centerBounds1.getWidth() <= 0.0 || centerBounds1.getHeight() <= 0.0) {
                    throw new RuntimeException("metamorphic violation: center block lost its positive bounds"
                            + " centerBounds=" + String.valueOf(centerBounds1));
                }

                double leftWidth1 = leftBounds1.getWidth();
                double leftHeight1 = leftBounds1.getHeight();
                double leftX1 = leftBounds1.getX();
                double leftY1 = leftBounds1.getY();

                Size2D s2 = container.arrange(g2, fixedFixed);
                Rectangle2D leftBounds2 = left.getBounds();

                /*
                 * Determinism/idempotence guarantee:
                 * arrangeFF() is a pure layout computation over the current blocks and the given
