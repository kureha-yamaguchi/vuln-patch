package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collections;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;

public class FuzzHarness {
    private static PointValuePair solve(LinearObjectiveFunction f, ArrayList<LinearConstraint> constraints) {
        return new SimplexSolver().optimize(f, constraints, GoalType.MAXIMIZE, true);
    }

    private static ArrayList<LinearConstraint> bealeGeqAnchor() {
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { -0.5, 5.5, 2.5, -9.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { -0.5, 1.5, 0.5, -1.0 }, Relationship.GEQ, 0.0));
        constraints.add(new LinearConstraint(new double[] { -1.0, 0.0, 0.0, 0.0 }, Relationship.GEQ, -1.0));
        return constraints;
    }

    private static LinearObjectiveFunction bealeObjective() {
        return new LinearObjectiveFunction(new double[] { 10.0, -57.0, -9.0, -24.0 }, 0.0);
    }

    private static ArrayList<LinearConstraint> scaleConstraints(ArrayList<LinearConstraint> in, int[] scales) {
        ArrayList<LinearConstraint> out = new ArrayList<LinearConstraint>(in.size());
        for (int i = 0; i < in.size(); i++) {
            LinearConstraint c = in.get(i);
            double[] coeff = c.getCoefficients().toArray();
            int s = scales[i];
            for (int j = 0; j < coeff.length; j++) {
                coeff[j] *= s;
            }
            out.add(new LinearConstraint(coeff, c.getRelationship(), c.getValue() * s));
        }
        return out;
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        LinearObjectiveFunction anchorObjective = bealeObjective();
        ArrayList<LinearConstraint> anchorConstraints = bealeGeqAnchor();

        // Exact anchor first: this reaches the real optimize() -> doOptimize() -> doIteration() ->
        // getPivotRow() path on the buggy version. The behavioral difference in the patch is only
        // exercised when there is a minimum-ratio tie in phase 1 with artificial variables present;
        // these GEQ constraints force artificial variables, and this classic cycling LP is the
        // smallest real family known to hit that path.
        PointValuePair anchor = solve(anchorObjective, anchorConstraints);

        // Mandatory post-condition / metamorphic check:
        // Reordering constraints does not change the feasible region of a linear program, so a
        // correct solver must return the same optimum for the same objective under any permutation
        // of the same constraints. A patch that merely "avoids the crash" by taking the wrong pivot
        // or skipping required basis updates can violate this observable contract without throwing.
        ArrayList<LinearConstraint> reversed = new ArrayList<LinearConstraint>(anchorConstraints);
        Collections.reverse(reversed);
        PointValuePair anchorReversed = solve(anchorObjective, reversed);
        if (Math.abs(anchor.getValue() - anchorReversed.getValue()) > 1.0e-8) {
            throw new RuntimeException(
                "metamorphic violation: constraint order changed optimum on anchor lhs="
                    + anchor.getValue() + " rhs=" + anchorReversed.getValue());
        }

        int s1 = data.consumeInt(1, 7);
        int s2 = data.consumeInt(1, 7);
        int s3 = data.consumeInt(1, 7);
        int objectiveScale = data.consumeInt(1, 5);
        boolean reverse = data.consumeBoolean();

        ArrayList<LinearConstraint> base = bealeGeqAnchor();
        int[] scales = new int[] { s1, s2, s3 };
        ArrayList<LinearConstraint> scaled = scaleConstraints(base, scales);
        if (reverse) {
            Collections.reverse(scaled);
        }

        LinearObjectiveFunction scaledObjective =
            new LinearObjectiveFunction(new double[] {
                10.0 * objectiveScale,
                -57.0 * objectiveScale,
                -9.0 * objectiveScale,
                -24.0 * objectiveScale
            }, 0.0);

        PointValuePair lhs = solve(anchorObjective, base);
        PointValuePair rhs = solve(scaledObjective, scaled);

        // Second metamorphic check:
        // Multiplying every coefficient of the objective by a positive constant and multiplying each
        // individual constraint by a positive constant preserves the same feasible set and the same
        // argmax; only the optimum value scales by that positive objective factor.
        double expected = lhs.getValue() * objectiveScale;
        if (Math.abs(rhs.getValue() - expected) > 1.0e-8) {
            throw new RuntimeException(
                "metamorphic violation: positive scaling changed optimum unexpectedly base="
                    + lhs.getValue() + " scaled=" + rhs.getValue() + " factor=" + objectiveScale);
        }

        double[] lp = lhs.getPoint();
        double[] rp = rhs.getPoint();
        if (lp != null && rp != null && lp.length == rp.length) {
            for (int i = 0; i < lp.length; i++) {
                if (Math.abs(lp[i] - rp[i]) > 1.0e-8) {
                    throw new RuntimeException(
                        "metamorphic violation: positive scaling changed optimizer point index="
                            + i + " lhs=" + lp[i] + " rhs=" + rp[i]);
                }
            }
        }
    }
