<xref>
private static void checkCanonicalInteger(String s) {
        /*
         * Contract used for this check:
         * For a canonical base-10 integer string with no suffix, createNumber
         * tries createInteger first, then wider integral types only on overflow.
         * Thus when we build s from Integer.toString(int)-style digits in range,
         * createNumber(s) must agree with createInteger(s).
         */
        try {
            Integer oracle = NumberUtils.createInteger(s);
            Number parsed = NumberUtils.createNumber(s);
            if (oracle != null && parsed != null) {
                if (!(parsed instanceof Integer) || parsed.intValue() != oracle.intValue()) {
                    throw new RuntimeException(
                            "metamorphic violation: createNumber(canonical int) != createInteger input="
                                    + quote(s) + " oracle=" + oracle + " parsed="
                                    + String.valueOf(parsed) + " parsedClass="
                                    + parsed.getClass().getName());
                }
            }
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: canonical integer should not hit internal substring failure input="
                                + quote(s), t);
            }
        }
    }
