            series.getIndex(end);
            TimeSeries gapCopy = series.createCopy(start, end);

            if (gapCopy == null) {
                throw new RuntimeException("metamorphic violation: null copy for gap range startOrd=" + startOrd + " endOrd=" + endOrd);
            }

