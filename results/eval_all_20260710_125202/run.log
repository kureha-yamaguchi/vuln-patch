public class FuzzHarness {
    private static final Format LOWER_FORMAT = new Format() {
        private static final long serialVersionUID = 1L;

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            if (obj != null) {
                toAppendTo.append(obj.toString().toLowerCase(Locale.ROOT));
            }
            return toAppendTo;
        }

        public Object parseObject(String source, ParsePosition pos) {
            int start = pos.getIndex();
            pos.setIndex(source.length());
            return source.substring(start);
        }
    };

    private static final FormatFactory LOWER_FACTORY = new FormatFactory() {
        public Format getFormat(String name, String arguments, Locale locale) {
            return LOWER_FORMAT;
        }
    };

    private static final Map REGISTRY = Collections.singletonMap("lower", LOWER_FACTORY);

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        tryOne("it''s a {0,lower} 'test'!", "DUMMY", "it's a dummy test!");

        String pre = sanitizeLiteral(data.consumeAsciiString(24));
        String mid = sanitizeLiteral(data.consumeAsciiString(24));
        String quoted = sanitizeQuoted(data.consumeAsciiString(24));
        String arg = data.consumeString(32);

        String validPattern = pre + "''" + mid + "{0,lower}'" + quoted + "'";
        String expected = pre + "'" + mid + arg.toLowerCase(Locale.ROOT) + quoted;
        tryOne(validPattern, arg, expected);

        String randomA = data.consumeRemainingAsString();
        String randomB = data.consumeAsciiString(32);
        String randomC = data.consumeAsciiString(32);
        String randomPattern = randomA + "''" + randomB + "{0,lower}" + randomC;
        tryRaw(randomPattern, arg);
    }

    private static void tryOne(String pattern, String arg, String expected) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, REGISTRY);
            Object[] args = new Object[] { arg };
            String actual = emf.format(args);

            /*
             * Contract asserted:
             * - In MessageFormat patterns, doubled apostrophe ('') denotes one literal apostrophe.
             * - Quoted text is copied literally.
             * - The registered "lower" format is applied to argument 0.
             * A patch that merely skips the quoted-string bookkeeping can avoid the crash yet produce
             * wrong output by losing the apostrophe or quoted literal, so compare the observable result.
