        // same solver on the same function and interval; in particular on [3.0, 3.2] for sin(x),
        // which contains the unique root pi, both overloads must return approximately pi and agree.
        try {
            BisectionSolver solverWithInitial = new BisectionSolver();
            double withInitial = solverWithInitial.solve(f, 3.0, 3.2, 3.1);

            BisectionSolver solverWithoutInitial = new BisectionSolver();
            double withoutInitial = solverWithoutInitial.solve(f, 3.0, 3.2);

            double pi = Math.PI;
            double tol = Math.max(
                    Math.max(solverWithInitial.getAbsoluteAccuracy(), solverWithoutInitial.getAbsoluteAccuracy()) * 4.0,
                    1e-8);

            if (Math.abs(withInitial - pi) > tol) {
                throw new RuntimeException("metamorphic violation: anchor oracle input=[3.0,3.2,3.1] result="
                        + withInitial + " expected~=" + pi);
            }
            if (Math.abs(withInitial - withoutInitial) > tol) {
                throw new RuntimeException("metamorphic violation: overload equivalence input=[3.0,3.2,3.1] lhs="
                        + withInitial + " rhs=" + withoutInitial);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        // EXPLORE: generate many valid, real inputs with the same root-cause property:
        // calling the public solve(f, min, max, initial) overload on a valid interval.
        // We construct intervals around a known root r = k*pi of sin(x), with width < pi,
        // so the interval contains exactly one root and is valid by construction.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftMillis = data.consumeInt(1, 1000);
        int rightMillis = data.consumeInt(1, 1000);
        double left = leftMillis / 1000.0;
        double right = rightMillis / 1000.0;

        double min = root - left;
        double max = root + right;

        // Keep initial inside the interval, with varied placement and surrounding content.
        int selector = data.consumeInt(0, 6);
        double initial;
        switch (selector) {
            case 0:
                initial = min;
                break;
            case 1:
                initial = max;
                break;
            case 2:
                initial = root;
                break;
            case 3:
                initial = (min + max) / 2.0;
                break;
            case 4:
                initial = min + (max - min) * (data.consumeInt(0, 1000) / 1000.0);
                break;
            case 5:
                initial = root + ((data.consumeBoolean() ? 1.0 : -1.0) * (Math.min(left, right) / 2.0));
                break;
            default:
                initial = min + (max - min) * 0.6180339887498949;
                break;
        }

        try {
            BisectionSolver solverWithInitial = new BisectionSolver();
            double withInitial = solverWithInitial.solve(f, min, max, initial);

            // Metamorphic relation using only real library calls:
            // On an interval containing the unique sin root k*pi, both overloads solve the same problem
            // and must therefore agree up to solver accuracy.
