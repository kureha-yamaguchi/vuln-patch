    private static void solveAndCheck(double[] objective, List<LinearConstraint> constraints) {
        PointValuePair p1 = new SimplexSolver().optimize(
            new LinearObjectiveFunction(objective, 0.0),
            constraints,
            org.apache.commons.math3.optimization.GoalType.MAXIMIZE,
            true
        );

        double[] scaled = new double[objective.length];
        for (int i = 0; i < objective.length; i++) {
            scaled[i] = objective[i] * 2.0;
        }

        PointValuePair p2 = new SimplexSolver().optimize(
            new LinearObjectiveFunction(scaled, 0.0),
            constraints,
            org.apache.commons.math3.optimization.GoalType.MAXIMIZE,
            true
        );

        double[] x1 = p1.getPoint();
        double[] x2 = p2.getPoint();

        if (x1.length != x2.length) {
            throw new RuntimeException("metamorphic violation: dimension changed lhs=" + x1.length + " rhs=" + x2.length);
        }

        for (int i = 0; i < x1.length; i++) {
            if (Math.abs(x1[i] - x2[i]) > 1.0e-6) {
                throw new RuntimeException(
                    "metamorphic violation: positive scaling of objective must preserve an optimal point objective="
                        + Arrays.toString(objective)
                        + " constraints=" + constraints.size()
                        + " lhsPoint=" + Arrays.toString(x1)
                        + " rhsPoint=" + Arrays.toString(x2)
                );
            }
        }

        double v1 = p1.getValue();
        double v2 = p2.getValue();
        double tol = 1.0e-6 * Math.max(1.0, Math.max(Math.abs(v1), Math.abs(v2)));
        if (Math.abs(v2 - 2.0 * v1) > tol) {
            throw new RuntimeException(
                "metamorphic violation: positive scaling of objective must double optimum value objective="
                    + Arrays.toString(objective)
                    + " constraints=" + constraints.size()
                    + " lhsValue=" + v1
                    + " rhsValue=" + v2
            );
        }
    }
