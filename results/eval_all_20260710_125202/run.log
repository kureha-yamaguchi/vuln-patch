package org.joda.time.format;

import java.util.Locale;
import org.joda.time.DateTimeZone;
import org.joda.time.MutableDateTime;
import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        DateTimeFormatter formatter = DateTimeFormat.forPattern("M d").withLocale(Locale.UK);

        DateTimeZone newYork = DateTimeZone.forID("America/New_York");
        MutableDateTime nyStart = new MutableDateTime(2004, 1, 1, 0, 0, 0, 0, newYork);
        MutableDateTime nyExpected = new MutableDateTime(2004, 2, 29, 0, 0, 0, 0, newYork);
        runValidCase(formatter, "2 29", 0, nyStart, 4, nyExpected);

        DateTimeZone tokyo = DateTimeZone.forID("Asia/Tokyo");
        MutableDateTime tokyoStart = new MutableDateTime(2004, 12, 31, 23, 59, 59, 999, tokyo);
        MutableDateTime tokyoExpected = new MutableDateTime(2004, 2, 29, 23, 59, 59, 999, tokyo);
        runValidCase(formatter, "2 29", 0, tokyoStart, 4, tokyoExpected);

        int leapYear = 2004 + 4 * data.consumeInt(0, 20);
        boolean negativeOffsetCase = data.consumeBoolean();
        DateTimeZone zone;
        MutableDateTime start;
        MutableDateTime expected;
        if (negativeOffsetCase) {
            int offsetHours = data.consumeInt(-23, -1);
            zone = DateTimeZone.forOffsetHours(offsetHours);
            start = new MutableDateTime(
                    leapYear,
                    1,
                    1,
                    0,
                    0,
                    0,
                    0,
                    zone);
            expected = new MutableDateTime(
                    leapYear,
                    2,
                    29,
                    0,
                    0,
                    0,
                    0,
                    zone);
        } else {
            int offsetHours = data.consumeInt(1, 23);
            zone = DateTimeZone.forOffsetHours(offsetHours);
            start = new MutableDateTime(
                    leapYear,
                    12,
                    31,
                    23,
                    59,
                    59,
                    999,
                    zone);
            expected = new MutableDateTime(
                    leapYear,
                    2,
                    29,
                    23,
                    59,
                    59,
                    999,
                    zone);
        }

        String prefix = data.consumeAsciiString(16);
        String suffix = "_" + data.consumeAsciiString(16);
        String text = prefix + "2 29" + suffix;
        int position = prefix.length();
        int expectedPos = position + 4;
        runValidCase(formatter, text, position, start, expectedPos, expected);
    }

    /*
     * Contract asserted:
     * The real public API used by the regression tests is DateTimeFormatter.parseInto.
     * For a valid "M d" input parsed into an existing MutableDateTime, it must:
     *   (1) return the index immediately after the parsed text, and
     *   (2) update the supplied instant to the parsed month/day while preserving time-of-day and zone.
     * A throw-deleting or guard-skipping patch could avoid the original exception but still leave the
     * instant unchanged or return the wrong position; this post-condition catches that.
     */
    private static void runValidCase(DateTimeFormatter formatter, String text, int position,
                                     MutableDateTime start, int expectedPos, MutableDateTime expected) {
        MutableDateTime actual = new MutableDateTime(start);
        try {
            int newPos = formatter.parseInto(actual, text, position);
            if (newPos != expectedPos) {
                throw new RuntimeException(
                        "metamorphic violation: parseInto returned wrong position input=" + quote(text)
                                + " position=" + position + " expectedPos=" + expectedPos
                                + " actualPos=" + newPos);
            }
            if (!actual.equals(expected)) {
                throw new RuntimeException(
                        "metamorphic violation: parseInto produced wrong instant input=" + quote(text)
                                + " position=" + position + " expected=" + expected
                                + " actual=" + actual);
            }
        } catch (Throwable t) {
            if (isRelevantToPatchedRegion(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid parse threw input=" + quote(text)
                                + " position=" + position + " start=" + start, t);
            }
        }
    }

    private static boolean isRelevantToPatchedRegion(Throwable t) {
        for (StackTraceElement frame : t.getStackTrace()) {
            String cls = frame.getClassName();
            String method = frame.getMethodName();
            if ("org.joda.time.format.DateTimeFormatter".equals(cls) && "parseInto".equals(method)) {
                return true;
            }
            if ("org.joda.time.format.DateTimeFormatter".equals(cls)
                    && ("selectChronology".equals(method) || "requireParser".equals(method))) {
                return true;
            }
            if (("org.joda.time.format.DateTimeParserBucket".equals(cls)
                    || "org.joda.time.format.DateTimeParserBucket$SavedField".equals(cls))
                    && "getOffset".equals(method)) {
                return true;
            }
            if ("org.joda.time.chrono.BasicChronology$HalfdayField".equals(cls) && "get".equals(method)) {
                return true;
            }
            if (cls.startsWith("org.joda.time") && "get".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static String quote(String s) {
        return "\"" + s + "\"";
    }
}
