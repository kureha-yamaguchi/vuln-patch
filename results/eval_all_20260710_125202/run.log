    private static void runMetamorphic(FuzzedDataProvider data, Graphics2D g2) {
        double constraintWidth = positiveScaled(data.consumeInt(1, 5000));
        double constraintHeight = positiveScaled(data.consumeInt(1, 5000));
        double leftWidth = nonNegativeScaled(data.consumeInt(0, 5000));
        double leftHeight = nonNegativeScaled(data.consumeInt(0, 5000));

