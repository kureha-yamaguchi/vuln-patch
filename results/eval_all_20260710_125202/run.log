            sbObj.append(prefix);

            StrBuilder sbNull = new StrBuilder(initialCapacity);
            sbNull.append(prefix);
            sbNull.setNullText(source);

            String beforeObj = sbObj.toString();
            String beforeNull = sbNull.toString();

