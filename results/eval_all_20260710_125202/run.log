        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
        } catch (CloneNotSupportedException e) {
            return;
        }
    }

    private static void runAnchor() throws CloneNotSupportedException {
        TimeSeries s = new TimeSeries("S");
        s.add(new Day(19, 8, 2005), Integer.valueOf(1));
        s.add(new Day(31, 1, 2006), Integer.valueOf(1));

        Day start = new Day(1, 12, 2005);
        Day end = new Day(18, 1, 2006);

        try {
            s.getIndex(start);
            s.getIndex(end);
            TimeSeries copy = s.createCopy(start, end);
            if (copy == null) {
                throw new RuntimeException("metamorphic violation: anchor copy is null");
            }
            if (copy.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor same-gap copy must be empty itemCount=" + copy.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        Day beforeFirst = new Day(18, 8, 2005);
        try {
            TimeSeries empty = s.createCopy(beforeFirst, beforeFirst);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor before-first copy is null");
            }
            if (empty.getItemCount() != 0) {
                throw new RuntimeException(
                    "metamorphic violation: anchor before-first copy must be empty itemCount=" + empty.getItemCount());
            }
        } catch (IllegalArgumentException e) {
            if (isRootCause(e)) {
                throw e;
            }
        }

        TimeSeries byPeriod = s.createCopy(new Day(19, 8, 2005), new Day(31, 1, 2006));
        TimeSeries byIndex = s.createCopy(0, 1);
        assertEquivalentCopies(byPeriod, byIndex, "anchor existing-period copy vs index copy");
    }

    private static Day dayFromOrdinal(int ord) {
        int year = 2000 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i < ords.length - 1; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String context) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: equivalent copies must be non-null context=" + context);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: equivalent copies disagree on itemCount context=" + context
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: equivalent copies disagree on period context=" + context
                        + " index=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null ? vb != null : !va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: equivalent copies disagree on value context=" + context
                        + " index=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        for (int i = 0; i < st.length; i++) {
            String cls = st[i].getClassName();
            String m = st[i].getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cls)
                    && ("createCopy".equals(m) || "getIndex".equals(m) || "clone".equals(m))) {
                return true;
            }
        }
        return false;
    }
}
