    private static Day dayFromOrdinal(int ord) {
        int year = 1900 + (ord / (28 * 12));
        int rem = ord % (28 * 12);
        int month = (rem / 28) + 1;
        int day = (rem % 28) + 1;
        return new Day(day, month, year);
    }

    private static int findGap(int[] ords) {
        for (int i = 0; i + 1 < ords.length; i++) {
            if (ords[i + 1] - ords[i] >= 2) {
                return i;
            }
        }
        return -1;
    }

    private static void assertEquivalentCopies(TimeSeries a, TimeSeries b, String what) {
        if (a == null || b == null) {
            throw new RuntimeException("metamorphic violation: null copy in " + what);
        }
        if (a.getItemCount() != b.getItemCount()) {
            throw new RuntimeException(
                "metamorphic violation: itemCount mismatch in " + what
                    + " lhs=" + a.getItemCount() + " rhs=" + b.getItemCount());
        }
        for (int i = 0; i < a.getItemCount(); i++) {
            RegularTimePeriod pa = a.getTimePeriod(i);
            RegularTimePeriod pb = b.getTimePeriod(i);
            if (!pa.equals(pb)) {
                throw new RuntimeException(
                    "metamorphic violation: time period mismatch in " + what
                        + " index=" + i + " lhs=" + pa + " rhs=" + pb);
            }
            Number va = a.getValue(i);
            Number vb = b.getValue(i);
            if (va == null) {
                if (vb != null) {
                    throw new RuntimeException(
                        "metamorphic violation: value mismatch in " + what
                            + " index=" + i + " lhs=null rhs=" + vb);
                }
            } else if (!va.equals(vb)) {
                throw new RuntimeException(
                    "metamorphic violation: value mismatch in " + what
                        + " index=" + i + " lhs=" + va + " rhs=" + vb);
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cn = ste.getClassName();
            String mn = ste.getMethodName();
            if ("org.jfree.data.time.TimeSeries".equals(cn)
                    && ("createCopy".equals(mn) || "getIndex".equals(mn) || "clone".equals(mn))) {
                return true;
            }
            if ("java.lang.Object".equals(cn) && "clone".equals(mn)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException
            && t.getMessage() != null
            && t.getMessage().startsWith("metamorphic violation:");
    }
