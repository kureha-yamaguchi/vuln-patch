            // should lie within that interval. A patch that suppresses the failing call and returns a stale
            // or default value would violate this.
            if (fourArg < min - tol || fourArg > max + tol) {
                throw new RuntimeException(
                    "metamorphic violation: result not within bracketing interval"
                        + " input=min=" + min + " max=" + max + " initial=" + initial
                        + " result=" + fourArg);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
