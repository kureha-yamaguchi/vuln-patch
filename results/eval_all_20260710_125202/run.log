package org.apache.commons.math3.optimization.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.Collection;
import org.apache.commons.math3.exception.MathIllegalArgumentException;
import org.apache.commons.math3.optimization.GoalType;
import org.apache.commons.math3.optimization.PointValuePair;
import org.apache.commons.math3.util.Precision;

public class FuzzHarness {
    private static final double EPS = 1.0e-6;
    private static final int MAX_ULPS = 10;

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseCase(1, 1, 1, true);
        exerciseCase(2, 3, 5, true);

        int a = positive(data.consumeInt(1, 20));
        int c = positive(data.consumeInt(1, 20));
        int ratio = positive(data.consumeInt(1, 20));
        boolean restrict = data.consumeBoolean();

        exerciseCase(a, c, ratio, restrict);

        int a2 = positive(data.consumeInt(1, 50));
        int c2 = positive(data.consumeInt(1, 50));
        int ratio2 = positive(data.consumeInt(1, 50));
        exerciseCase(a2, c2, ratio2, true);
    }

    private static void exerciseCase(int a, int c, int ratio, boolean restrictToNonNegative) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(new double[] { 1.0 }, 0.0);
        Collection<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        constraints.add(new LinearConstraint(new double[] { (double) a }, Relationship.LEQ, (double) a * (double) ratio));
        constraints.add(new LinearConstraint(new double[] { (double) c }, Relationship.GEQ, (double) c * (double) ratio));

        try {
            SimplexSolver solver = new SimplexSolver();
            PointValuePair p = solver.optimize(f, constraints, GoalType.MAXIMIZE, restrictToNonNegative);
            if (p != null) {
                double[] point = p.getPoint();
                if (point != null && point.length == 1) {
                    double x = point[0];
                    if (!Double.isNaN(x) && !Double.isInfinite(x)) {
                        double expected = ratio;
                        if (Math.abs(x - expected) > 1.0e-7) {
                            throw new RuntimeException("metamorphic violation: equivalent single-variable bounds should solve to x=ratio input="
                                    + a + "," + c + "," + ratio + "," + restrictToNonNegative
                                    + " actual=" + x + " expected=" + expected);
                        }
                    }
                }
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
        } catch (Throwable t) {
            return;
        }

        try {
            SimplexTableau tableau = new SimplexTableau(f, constraints, GoalType.MAXIMIZE, restrictToNonNegative, EPS, MAX_ULPS);

            int pivotCol = choosePivotColumn(tableau);
            if (pivotCol < 0) {
                return;
            }

            Integer expectedRow = choosePivotRowBlandOnly(tableau, pivotCol);
            if (expectedRow == null) {
                return;
            }

            SimplexSolver solver = new SimplexSolver();
            solver.doIteration(tableau);

            Integer actualRow = tableau.getBasicRow(pivotCol);

            /*
             * Contract asserted:
             * getPivotRow's own comment says that on a tie in the minimum ratio test the solver must
             * "apply Bland's rule ... take the row for which the corresponding basic variable has the smallest index".
             * For the constructed inputs, the LEQ row and GEQ row tie on rhs/entry, and the LEQ row's slack basic
             * variable has a smaller index than the GEQ row's artificial variable. A patch that merely deletes the
             * failing behavior or makes the branch unreachable would violate this observable choice of leaving row.
             */
            if (actualRow == null || !actualRow.equals(expectedRow)) {
                throw new RuntimeException("metamorphic violation: Bland pivot-row selection input="
                        + a + "," + c + "," + ratio + "," + restrictToNonNegative
                        + " pivotCol=" + pivotCol + " expectedRow=" + expectedRow + " actualRow=" + actualRow);
            }
        } catch (IllegalArgumentException e) {
            return;
        } catch (MathIllegalArgumentException e) {
            return;
        } catch (RuntimeException e) {
            if (isHarnessViolation(e)) {
                throw e;
            }
        } catch (Throwable t) {
            return;
        }
    }

    private static int choosePivotColumn(SimplexTableau tableau) {
        int objectiveRow = 0;
        int width = tableau.getWidth();
        int minPos = -1;
        double minValue = 0.0;
        for (int i = tableau.getNumObjectiveFunctions(); i < width - 1; i++) {
            double entry = tableau.getEntry(objectiveRow, i);
            if (entry < minValue && !Precision.equals(entry, minValue, MAX_ULPS)) {
                minValue = entry;
                minPos = i;
            }
        }
        return minPos;
    }

    private static Integer choosePivotRowBlandOnly(SimplexTableau tableau, int col) {
        ArrayList<Integer> minRatioPositions = new ArrayList<Integer>();
        double minRatio = Double.MAX_VALUE;

        for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getHeight(); i++) {
            final double rhs = tableau.getEntry(i, tableau.getWidth() - 1);
            final double entry = tableau.getEntry(i, col);

            if (Precision.compareTo(entry, 0d, MAX_ULPS) > 0) {
                final double ratio = rhs / entry;
                final int cmp = Double.compare(ratio, minRatio);
                if (cmp == 0) {
                    minRatioPositions.add(i);
                } else if (cmp < 0) {
                    minRatio = ratio;
                    minRatioPositions = new ArrayList<Integer>();
                    minRatioPositions.add(i);
                }
            }
        }

        if (minRatioPositions.size() == 0) {
            return null;
        } else if (minRatioPositions.size() == 1) {
            return minRatioPositions.get(0);
        }

        Integer minRow = null;
        int minIndex = tableau.getWidth();
        for (Integer row : minRatioPositions) {
            for (int i = tableau.getNumObjectiveFunctions(); i < tableau.getWidth() - 1 && minRow != row; i++) {
                Integer basic = tableau.getBasicRow(i);
                if (basic != null && row.intValue() == basic.intValue()) {
                    if (i < minIndex) {
                        minIndex = i;
                        minRow = row;
                    }
                }
            }
        }
        return minRow;
    }

    private static int positive(int v) {
        return v <= 0 ? 1 : v;
    }

    private static boolean isHarnessViolation(Throwable t) {
        return t instanceof RuntimeException && t.getMessage() != null
                && t.getMessage().startsWith("metamorphic violation:");
    }
}
