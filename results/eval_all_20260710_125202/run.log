        1.2431632654852931E-11
    };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runCase(ANCHOR, true);

        int cases = 1 + Math.min(4, data.remainingBytes() / 4);
        for (int i = 0; i < cases; i++) {
            double[] ys = buildExplorationInput(data);
            runCase(ys, true);
        }
    }

    private static void runCase(double[] ys, boolean validByConstruction) {
        double[] noArgResult;
        try {
            noArgResult = fitNoArg(ys);
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction, true);
            return;
        }

        /*
         * Contract / code-visible guarantee asserted here:
         * GaussianFitter.fit() computes a ParameterGuesser guess from the current
         * observations and delegates to fit(guess). Therefore, whenever both calls
         * succeed on the same observations, they must return the same parameter array.
         * A "fix" that merely deletes the failing path, skips delegation, or routes to
         * different behavior would violate this observable equivalence.
         *
         * Hygiene rule: if either side throws, the relation does not apply and we return.
         */
        double[] explicitResult;
        try {
            explicitResult = fitExplicitWithSameGuess(ys);
        } catch (Throwable t) {
            handleThrowable(t, validByConstruction, false);
            return;
        }

        if (!sameArray(noArgResult, explicitResult)) {
            throw new RuntimeException(
                "metamorphic violation: fit() != fit(ParameterGuesser.guess()) input="
                    + Arrays.toString(ys)
                    + " lhs=" + Arrays.toString(noArgResult)
                    + " rhs=" + Arrays.toString(explicitResult));
        }
    }

    private static double[] fitNoArg(double[] ys) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ys.length; i++) {
            fitter.addObservedPoint(i, ys[i]);
        }
        return fitter.fit();
    }

    private static double[] fitExplicitWithSameGuess(double[] ys) {
        GaussianFitter fitter = new GaussianFitter(new LevenbergMarquardtOptimizer());
        for (int i = 0; i < ys.length; i++) {
            fitter.addObservedPoint(i, ys[i]);
        }
        double[] guess = new GaussianFitter.ParameterGuesser(fitter.getObservations()).guess();
        return fitter.fit(guess);
    }

    private static double[] buildExplorationInput(FuzzedDataProvider data) {
        int n = data.consumeInt(3, 40);
        double[] ys = new double[n];

        boolean peakRight = data.consumeBoolean();
        double center;
        if (peakRight) {
            center = (n - 1) + data.consumeInt(1, 30);
        } else {
            center = -data.consumeInt(1, 30);
        }

        double sigma = data.consumeInt(1, 200) / 10.0;
        double amplitude = Math.pow(10.0, -data.consumeInt(0, 20));
        double baseline = data.consumeBoolean() ? Math.pow(10.0, -data.consumeInt(21, 40)) : 0.0;

        for (int i = 0; i < n; i++) {
            double dx = i - center;
            double y = amplitude * Math.exp(-(dx * dx) / (2.0 * sigma * sigma)) + baseline;

            if (data.consumeBoolean()) {
                double jitter = data.consumeInt(0, 1000) / 1000000.0;
                y *= (1.0 + jitter);
            }

            if (!(y > 0.0) || Double.isNaN(y) || Double.isInfinite(y)) {
                y = Double.MIN_NORMAL;
            }
            ys[i] = y;
        }

        if (data.consumeBoolean()) {
            int idx = data.consumeInt(0, n - 1);
            ys[idx] = Math.max(ys[idx], Double.MIN_NORMAL);
        }

        return ys;
    }

    private static void handleThrowable(Throwable t, boolean validByConstruction, boolean fromPatchedNoArgFit) {
        if (fromPatchedNoArgFit && validByConstruction && isRootCause(t)) {
            throwAsUnchecked(t);
        }
        if (isCleanRejection(t)) {
            return;
        }
        if (t instanceof VirtualMachineError || t instanceof ThreadDeath || t instanceof LinkageError) {
            throwAsUnchecked(t);
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof IllegalArgumentException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String method = e.getMethodName();
            if ("org.apache.commons.math.analysis.function.Gaussian$Parametric".equals(cls)
                    && "validateParameters".equals(method)) {
                return true;
            }
            if ("org.apache.commons.math.optimization.fitting.GaussianFitter".equals(cls)
                    && "fit".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.startsWith("org.apache.commons.math.exception.");
    }

    private static boolean sameArray(double[] a, double[] b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null || a.length != b.length) {
            return false;
        }
        for (int i = 0; i < a.length; i++) {
            if (Double.doubleToLongBits(a[i]) != Double.doubleToLongBits(b[i])) {
                return false;
            }
        }
        return true;
    }

    private static void throwAsUnchecked(Throwable t) {
        if (t instanceof RuntimeException) {
            throw (RuntimeException) t;
        }
        if (t instanceof Error) {
            throw (Error) t;
        }
        throw new RuntimeException(t);
    }
}
