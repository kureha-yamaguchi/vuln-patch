public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        Map lowerRegistry = createLowerRegistry();

        String anchorPattern = "it''s a {0,lower} 'test'!";
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(anchorPattern, lowerRegistry);
            String out = emf.format(new Object[] { "DUMMY" });
            if (!"it's a dummy test!".equals(out)) {
                throw new RuntimeException(
                    "metamorphic violation: anchor expected formatting input=" + anchorPattern +
                    " lhs=" + out + " rhs=it's a dummy test!"
                );
            }
        } catch (Throwable t) {
            handleThrowable(t);
        }

        for (int i = 0; i < 3; i++) {
            String prefix = sanitize(data.consumeString(20));
            String middle = sanitize(data.consumeString(20));
            String quoted = sanitize(data.consumeString(20));
            String suffix = sanitize(data.consumeRemainingAsString());
            String arg = data.consumeString(20);

            if (quoted.length() == 0) {
                quoted = "q";
            }

            String pattern = prefix + "''" + middle + " {0} '" + quoted + "'" + suffix;

            try {
                MessageFormat mf = new MessageFormat(pattern);
                String expected = mf.format(new Object[] { arg });

                ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, new HashMap());
                String actual = emf.format(new Object[] { arg });

                /*
                 * Contract asserted: ExtendedMessageFormat is a MessageFormat variant; for a
                 * standard MessageFormat pattern with no custom formats registered, formatting
                 * must agree with MessageFormat. A "fix" that merely skips the quoted-string
                 * handling branch or corrupts quote bookkeeping can stop crashing but produce
                 * different visible output, which this comparison detects.
                 */
                if (!expected.equals(actual)) {
                    throw new RuntimeException(
                        "metamorphic violation: ExtendedMessageFormat vs MessageFormat input=" +
                        pattern + " lhs=" + actual + " rhs=" + expected
                    );
                }
            } catch (Throwable t) {
                handleThrowable(t);
            }
        }
    }

    private static Map createLowerRegistry() {
        Map registry = new HashMap();
        registry.put("lower", new FormatFactory() {
            public Format getFormat(String name, String args, final Locale locale) {
                return new Format() {
                    public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
                        if (obj != null) {
                            Locale useLocale = (locale == null) ? Locale.getDefault() : locale;
                            toAppendTo.append(obj.toString().toLowerCase(useLocale));
                        }
                        return toAppendTo;
                    }

                    public Object parseObject(String source, ParsePosition pos) {
                        pos.setIndex(source == null ? 0 : source.length());
                        return source;
                    }
                };
            }
        });
        return registry;
    }

    private static String sanitize(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '{' || c == '}' || c == '\'') {
                sb.append('x');
            } else if (Character.isISOControl(c)) {
                sb.append(' ');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static void handleThrowable(Throwable t) {
        if (t instanceof RuntimeException && !(t instanceof IllegalArgumentException) && !(t instanceof NumberFormatException)) {
            throw (RuntimeException) t;
        }
        if (isRootCause(t)) {
            if (t instanceof Error) {
                throw (Error) t;
            }
            if (t instanceof RuntimeException) {
                throw (RuntimeException) t;
            }
        }
        if (isCleanRejection(t)) {
            return;
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName().toLowerCase();
        return name.indexOf("invalid") >= 0 || name.indexOf("validation") >= 0;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
