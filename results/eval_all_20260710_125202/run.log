package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static final class NullToStringObject {
        @Override
        public String toString() {
            return null;
        }
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        StringUtils.join((Object[]) null, ',');

        Object[] anchor = new Object[] { new NullToStringObject() };

        try {
            StringUtils.join(anchor, '/', 0, 1);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            StringUtils.join(anchor, "/", 0, 1);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        int len = data.consumeInt(1, 6);
        Object[] array = new Object[len];
        int startIndex = data.consumeInt(0, len - 1);
        int endIndex = data.consumeInt(startIndex + 1, len);
        array[startIndex] = new NullToStringObject();

        for (int i = 0; i < len; i++) {
            if (i == startIndex) {
                continue;
            }
            int choice = data.consumeInt(0, 3);
            if (choice == 0) {
                array[i] = null;
            } else if (choice == 1) {
                array[i] = data.consumeString(16);
            } else if (choice == 2) {
                array[i] = Integer.valueOf(data.consumeInt());
            } else {
                array[i] = data.consumeAsciiString(16);
            }
        }

        char sepChar = (char) (data.consumeByte() & 0xff);
        String sepString = String.valueOf(sepChar);

        try {
            StringUtils.join(array, sepChar, startIndex, endIndex);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        try {
            StringUtils.join(array, sepString, startIndex, endIndex);
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }

        // Contract/metamorphic check:
        // For the same array slice and a one-character separator, the char-separator and
        // String-separator overloads implement the same joining behavior and must return
        // identical results. A bogus patch that merely suppresses the crashing path or
        // skips appending would violate this observable equivalence without throwing.
        try {
            String lhs = StringUtils.join(array, sepChar, startIndex, endIndex);
            String rhs = StringUtils.join(array, sepString, startIndex, endIndex);
            if (lhs == null ? rhs != null : !lhs.equals(rhs)) {
                throw new RuntimeException(
                    "metamorphic violation: char-vs-string join equivalence inputLen=" + len +
                    " startIndex=" + startIndex +
                    " endIndex=" + endIndex +
                    " sepChar=" + (int) sepChar +
                    " lhs=" + lhs +
                    " rhs=" + rhs
                );
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            if (t.getMessage() != null && t.getMessage().startsWith("metamorphic violation:")) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "join".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.AnnotationUtils".equals(ste.getClassName())
                    && "toString".equals(ste.getMethodName())) {
                return true;
            }
            if ("org.apache.commons.lang3.StringUtils".equals(ste.getClassName())
                    && "length".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }
}
