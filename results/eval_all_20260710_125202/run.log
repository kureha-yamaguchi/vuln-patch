    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof ClassCastException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cn = e.getClassName();
            String mn = e.getMethodName();
            if ("org.apache.commons.math3.geometry.euclidean.twod.PolygonsSet".equals(cn) &&
                ("computeGeometricalProperties".equals(mn) || "getVertices".equals(mn))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.AbstractRegion".equals(cn) &&
                ("getSize".equals(mn) || "getBarycenter".equals(mn))) {
                return true;
            }
            if ("org.apache.commons.math3.geometry.partitioning.BSPTree".equals(cn) &&
                "visit".equals(mn)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isMetamorphicViolation(RuntimeException t) {
        String msg = t.getMessage();
        return msg != null && msg.startsWith("metamorphic violation:");
    }

    private static String describe(Object attr) {
        if (attr == null) {
            return "null";
        }
        return attr.getClass().getName() + ":" + String.valueOf(attr);
    }
