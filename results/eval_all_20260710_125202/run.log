            double leftWidth = data.consumeInt(1, 1_000_000) / 1_000_000.0;
            double rightWidth = data.consumeInt(1, 1_000_000) / 1_000_000.0;

            double min = root - leftWidth;
            double max = root + rightWidth;

            int mode = data.consumeInt(0, 4);
            double initial;
            switch (mode) {
                case 0:
                    initial = root;
                    break;
                case 1:
                    initial = min;
                    break;
                case 2:
                    initial = max;
                    break;
                case 3:
                    initial = (min + max) * 0.5;
                    break;
                default:
                    double span = max - min;
                    double fraction = data.consumeInt(0, 1_000_000) / 1_000_000.0;
                    initial = min + fraction * span;
                    break;
            }

            runCase(f, min, max, initial, false);
        }
    }

    private static void runCase(UnivariateRealFunction f, double min, double max, double initial, boolean anchor) {
        try {
            BisectionSolver solver4 = new BisectionSolver();
            double result4 = solver4.solve(f, min, max, initial);

            // Post-condition / metamorphic check:
            // For BisectionSolver, the 4-argument solve(f, min, max, initial) solves the same
            // bracketed problem as solve(f, min, max); the extra initial value must not change
            // the root found for a correct bisection implementation. A "fix" that merely avoids
            // the crash but skips using the real function/solver logic can violate this.
            try {
                BisectionSolver solver3 = new BisectionSolver();
                double result3 = solver3.solve(f, min, max);

                double tol = Math.max(solver4.getAbsoluteAccuracy(), solver3.getAbsoluteAccuracy()) * 2.0;
                if (Double.isNaN(result4) != Double.isNaN(result3) || Math.abs(result4 - result3) > tol) {
                    throw new RuntimeException(
                        "metamorphic violation: solve(f,min,max,initial) != solve(f,min,max)"
                            + " input=[min=" + min + ", max=" + max + ", initial=" + initial + ", anchor=" + anchor + "]"
                            + " lhs=" + result4 + " rhs=" + result3);
                }
            } catch (Throwable t) {
                // If either side throws, the relation does not apply for this input.
                if (isRootCause(t)) {
                    throw rethrow(t);
                }
                return;
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw rethrow(t);
            }
            // Any other throwable is outside this patch's scope.
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.contains("ConvergenceException")
            || name.contains("FunctionEvaluationException")
            || name.contains("MaxIterationsExceededException")
            || name.contains("MathException");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof NullPointerException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static RuntimeException rethrow(Throwable t) {
        if (t instanceof RuntimeException) {
            return (RuntimeException) t;
        }
        return new RuntimeException(t);
    }
}
