        } catch (Throwable t) {
            return;
        }
        if (!safeEquals(lhs, rhs)) {
            throw new RuntimeException(
                "metamorphic violation: ExtendedMessageFormat without registry must match MessageFormat"
                    + " input=" + pattern + " lhs=" + lhs + " rhs=" + rhs);
