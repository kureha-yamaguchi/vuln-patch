            public Format getFormat(String name, String arguments, Locale locale) {
                return new Format() {
                    public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
                        if (obj == null) {
                            return toAppendTo;
                        }
                        return toAppendTo.append(obj.toString().toLowerCase(Locale.ROOT));
                    }

                    public Object parseObject(String source, ParsePosition pos) {
                        pos.setIndex(source.length());
                        return source;
                    }
                };
            }
        });
    }

    private static String sanitizeLiteral(String s) {
        if (s == null) {
            return "";
        }
        StringBuilder b = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '{' || c == '}') {
                b.append('x');
            } else if (c >= 32 && c < 127) {
                b.append(c);
            } else {
                b.append('y');
            }
        }
        return b.toString();
    }

    private static String expectedForPattern(String left, String middle, String right, String arg, int variant) {
        String lower = arg.toLowerCase(Locale.ROOT);
