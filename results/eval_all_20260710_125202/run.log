package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.text.FieldPosition;
import java.text.Format;
import java.text.MessageFormat;
import java.text.ParsePosition;
import java.util.HashMap;
import java.util.Locale;
import java.util.Map;

public class FuzzHarness {
    private static final Map REGISTRY = makeRegistry();
    private static final Object[] SEED_ARGS = new Object[] { "DUMMY" };

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        exerciseAnchor();

        String arg = data.consumeString(32);
        String prefix = sanitizeLiteral(data.consumeAsciiString(24));
        String middle = sanitizeLiteral(data.consumeAsciiString(24));
        String quoted = sanitizeLiteral(data.consumeAsciiString(24));
        String suffix = sanitizeLiteral(data.consumeRemainingAsString());

        if (data.consumeBoolean()) {
            prefix = "";
        }
        if (data.consumeBoolean()) {
            middle = middle + " ";
        }
        if (data.consumeBoolean()) {
            suffix = " " + suffix;
        }

        String pattern = buildPattern(prefix, middle, quoted, suffix, data.consumeBoolean());
        Object[] args = new Object[] { arg };

        invokeAndCheck(pattern, args, prefix, middle, quoted, suffix, arg);

        String prefix2 = sanitizeLiteral(data.consumeAsciiString(16));
        String middle2 = sanitizeLiteral(data.consumeAsciiString(16));
        String quoted2 = sanitizeLiteral(data.consumeAsciiString(16));
        String suffix2 = sanitizeLiteral(data.consumeAsciiString(16));
        String arg2 = data.consumeString(16);
        String pattern2 = buildPattern(prefix2, middle2, quoted2, suffix2, true);
        invokeAndCheck(pattern2, new Object[] { arg2 }, prefix2, middle2, quoted2, suffix2, arg2);
    }

    private static void exerciseAnchor() {
        String pattern = "it''s a {0,lower} 'test'!";
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.getDefault(), REGISTRY);
            String out = emf.format(SEED_ARGS);
            if (!"it's a dummy test!".equals(out)) {
                throw new RuntimeException("metamorphic violation: seed-format input=" + pattern + " lhs=" + out + " rhs=it's a dummy test!");
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (OutOfMemoryError) t;
            }
        }
    }

    private static void invokeAndCheck(String pattern, Object[] args, String prefix, String middle, String quoted, String suffix, String arg) {
        try {
            ExtendedMessageFormat emf = new ExtendedMessageFormat(pattern, Locale.getDefault(), REGISTRY);
            String actual = emf.format(args);

            String expectedPattern = prefix + "'" + middle + " {0} " + quoted + suffix;
            String expected = new MessageFormat(expectedPattern, Locale.getDefault())
                    .format(new Object[] { arg == null ? null : arg.toLowerCase(Locale.ROOT) });

            /*
             * Contract asserted:
             * ExtendedMessageFormat is a MessageFormat with additional custom formats.
             * For this harness's registry, {0,lower} is defined to format the argument as lower-case text.
             * Also, in MessageFormat syntax, doubled apostrophe ('') denotes a literal apostrophe and a quoted
             * section like 'text' denotes literal text without the quote delimiters.
             * Therefore this pattern:
             *   prefix + "''" + middle + " {0,lower} '" + quoted + "'" + suffix
             * must produce the same output as the standard MessageFormat pattern:
             *   prefix + "'" + middle + " {0} " + quoted + suffix
             * applied to the lower-cased argument.
             * A patch that merely skips the quoted-string bookkeeping can make the crashing branch unreachable
             * or silently mis-parse the quote handling; then no exception fires, but this equivalence breaks.
             */
            if (!safeEquals(actual, expected)) {
                throw new RuntimeException(
                        "metamorphic violation: quote-normalization input=" + pattern
                                + " lhs=" + actual
                                + " rhs=" + expected);
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw (OutOfMemoryError) t;
            }
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        StackTraceElement[] st = t.getStackTrace();
        if (st == null) {
            return false;
        }
        for (int i = 0; i < st.length; i++) {
            StackTraceElement e = st[i];
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(e.getClassName())
                    && "appendQuotedString".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        return name.indexOf("Validate") >= 0
                || name.indexOf("Validation") >= 0
                || name.indexOf("Illegal") >= 0
                || name.indexOf("Format") >= 0 && t instanceof RuntimeException;
    }

    private static String buildPattern(String prefix, String middle, String quoted, String suffix, boolean spaceBeforeQuotedLiteral) {
        StringBuilder sb = new StringBuilder();
        sb.append(prefix);
        sb.append("''");
        sb.append(middle);
        sb.append(" {0,lower}");
        if (spaceBeforeQuotedLiteral) {
            sb.append(" ");
        }
        sb.append("'");
        sb.append(quoted);
        sb.append("'");
        sb.append(suffix);
        return sb.toString();
    }

    private static String sanitizeLiteral(String s) {
        if (s == null || s.length() == 0) {
            return "x";
        }
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == ' ' || c == '_' || c == '-' || c == '.' || c == '!') {
                sb.append(c);
            } else {
                sb.append('x');
            }
        }
        if (sb.length() == 0) {
            sb.append('x');
        }
        return sb.toString();
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }

    private static Map makeRegistry() {
        Map m = new HashMap();
        m.put("lower", new LowerFormatFactory());
        return m;
    }

    private static final class LowerFormatFactory implements FormatFactory {
        public Format getFormat(String name, String arguments, Locale locale) {
            return new LowerFormat(locale == null ? Locale.getDefault() : locale);
        }
    }

    private static final class LowerFormat extends Format {
        private final Locale locale;

        private LowerFormat(Locale locale) {
            this.locale = locale;
        }

        public StringBuffer format(Object obj, StringBuffer toAppendTo, FieldPosition pos) {
            if (obj == null) {
                return toAppendTo;
            }
            String s = String.valueOf(obj).toLowerCase(locale);
            toAppendTo.append(s);
            return toAppendTo;
        }

        public Object parseObject(String source, ParsePosition pos) {
            int idx = pos.getIndex();
            if (source == null) {
                pos.setErrorIndex(idx);
                return null;
            }
            pos.setIndex(source.length());
            return source.substring(idx);
        }
    }
}
