    private static void execute(double[] objective, double[][] coeffs, Relationship[] rels, double[] rhs) {
        try {
            solve(objective, coeffs, rels, rhs);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
        }
    }

    private static PointValuePair solve(double[] objective, double[][] coeffs, Relationship[] rels, double[] rhs) {
        LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
        ArrayList<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
        for (int i = 0; i < coeffs.length; i++) {
            constraints.add(new LinearConstraint(coeffs[i], rels[i], rhs[i]));
        }
        SimplexSolver solver = new SimplexSolver();
        solver.setMaxIterations(100);
        return solver.optimize(f, constraints, GoalType.MINIMIZE, true);
    }

    private static void metamorphicDuplicateConstraint(
            double[] objective,
            double[][] coeffsA, Relationship[] relsA, double[] rhsA,
            double[][] coeffsB, Relationship[] relsB, double[] rhsB) {

        PointValuePair a;
        PointValuePair b;
        try {
            a = solve(objective, coeffsA, relsA, rhsA);
            b = solve(objective, coeffsB, relsB, rhsB);
        } catch (Throwable t) {
            return;
        }

        if (a == null || b == null || a.getPoint() == null || b.getPoint() == null) {
            return;
        }

        /*
         * Contract asserted: adding an exact duplicate linear constraint does not change the feasible region,
         * so the optimum point/value must be unchanged for any correct solver. A patch that merely avoids
         * the cycling/selection logic in getPivotRow by skipping a pivot-row choice can silently return a
         * wrong optimum instead of throwing; this relation catches that wrong-output behavior.
         */
        if (Double.compare(a.getValue(), b.getValue()) != 0 || !Arrays.equals(a.getPoint(), b.getPoint())) {
            throw new RuntimeException(
                "metamorphic violation: duplicate constraint changed optimum"
                    + " objective=" + Arrays.toString(objective)
                    + " baseCoeffs=" + deepToString(coeffsA)
                    + " dupCoeffs=" + deepToString(coeffsB)
                    + " lhsValue=" + a.getValue()
                    + " rhsValue=" + b.getValue()
                    + " lhsPoint=" + Arrays.toString(a.getPoint())
                    + " rhsPoint=" + Arrays.toString(b.getPoint()));
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        if (t instanceof MathIllegalArgumentException) {
            return true;
        }
        if (t instanceof MathIllegalStateException && !(t instanceof MaxCountExceededException)) {
            return true;
        }
        String n = t.getClass().getName();
        return n.contains("NoFeasibleSolution") || n.contains("UnboundedSolution") || n.contains("TooMany");
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof MaxCountExceededException)) {
            return false;
        }
        for (StackTraceElement e : t.getStackTrace()) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("org.apache.commons.math3.optimization.linear.SimplexSolver".equals(cls)
