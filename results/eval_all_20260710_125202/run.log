private static void checkValidPlainDecimal(String s) {
        /*
         * Contract used for this check:
         * For a valid decimal string with a decimal point and no exponent/suffix,
         * createNumber goes down the float/double/bigdecimal path. For small,
         * finite, non-underflowing decimals such as the ones we construct here,
         * the implementation first creates a Float and returns it.
         * Therefore, for these valid-by-construction inputs, createNumber(s)
         * must agree with createFloat(s), and a patch that merely suppresses
         * the old crash or skips the intended parsing branch would violate this.
         */
        Float oracle;
        try {
            oracle = NumberUtils.createFloat(s);
        } catch (RuntimeException t) {
            return;
        }

        try {
            Number parsed = NumberUtils.createNumber(s);
            if (!(parsed instanceof Float) || !oracle.equals(parsed)) {
                throw new RuntimeException(
                        "metamorphic violation: createNumber(valid plain decimal) != createFloat input="
                                + quote(s) + " oracle=" + oracle + " parsed="
                                + String.valueOf(parsed) + " parsedClass="
                                + (parsed == null ? "null" : parsed.getClass().getName()));
            }
        } catch (RuntimeException t) {
            if (isValidationRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw new RuntimeException(
                        "metamorphic violation: valid plain decimal should parse like createFloat input="
                                + quote(s) + " oracle=" + oracle, t);
            }
        }
    }
