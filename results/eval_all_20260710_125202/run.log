        try {
            s.getIndex(before);
            TimeSeries empty = s.createCopy(before, before);
            if (empty == null) {
                throw new RuntimeException("metamorphic violation: anchor clone-path copy is null");
            }
            if (empty.getItemCount() != 0) {
