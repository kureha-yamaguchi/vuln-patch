                                    && row.equals(basic)) {
                                return true;
                            }
                        }
                    }
                }
            }
        } catch (Throwable t) {
            return false;
        }
        return false;
    }

    private static double boundedCoeff(int raw) {
        int v = raw % 7;
        if (v < -3) {
            v += 7;
        } else if (v > 3) {
            v -= 7;
        }
        return v;
    }

    private static boolean isCleanRejection(Throwable t) {
