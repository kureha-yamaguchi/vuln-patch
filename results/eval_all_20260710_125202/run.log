            runCase(prefix2, obj, width, padChar);
        }
    }

    private static void runCase(String prefix, String obj, int width, char padChar) {
        if (prefix == null || obj == null || width <= 0) {
            return;
        }

        StrBuilder sb = new StrBuilder(prefix.length() + width);
        sb.append(prefix);
        int beforeLen = sb.length();

        try {
            sb.appendFixedWidthPadRight(obj, width, padChar);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                sneakyThrow(t);
            }
            return;
        }

        /* Contract asserted: appendFixedWidthPadRight appends exactly width characters;
           if the input string is longer than width, the leftmost width characters are appended,
           otherwise the value is padded on the right with padChar until width is reached.
           A patch that merely suppresses the crash or skips the write/bookkeeping would violate
           the observable length/suffix checks below. */
        if (sb.length() != beforeLen + width) {
            throw new RuntimeException(
                "metamorphic violation: fixed-width length growth prefix=" + prefix
                    + " obj=" + obj
                    + " width=" + width
                    + " beforeLen=" + beforeLen
                    + " afterLen=" + sb.length());
        }

        String expectedSuffix;
        if (obj.length() >= width) {
            expectedSuffix = obj.substring(0, width);
        } else {
            StringBuffer tmp = new StringBuffer(width);
            tmp.append(obj);
            while (tmp.length() < width) {
                tmp.append(padChar);
            }
            expectedSuffix = tmp.toString();
        }

        String actual = sb.toString();
        String actualSuffix = actual.substring(beforeLen);
        if (!expectedSuffix.equals(actualSuffix)) {
            throw new RuntimeException(
                "metamorphic violation: appendFixedWidthPadRight suffix prefix=" + prefix
                    + " obj=" + obj
                    + " width=" + width
                    + " pad=" + (int) padChar
                    + " lhs=" + actualSuffix
                    + " rhs=" + expectedSuffix);
