        exercise("-1.1E200");
        exercise("1.1E-200");
        exercise("12345678901234567890L");
        exercise("1.1E-700F");
        exercise("2.");
        exercise("1eE");
        exercise("-1l");
        exercise("01l");
        exercise("1l");

