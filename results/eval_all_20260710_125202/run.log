                if (isValidationFamily(e)) {
                    return;
                }
                if (isRootCause(e)) {
                    throw new RuntimeException("metamorphic violation: valid before-first range should clone to empty copy, but createCopy rejected it", e);
                }
                return;
            } catch (CloneNotSupportedException e) {
                return;
