        tryPattern("it''s a {0,lower} 'test'!", registry, new Object[] { "DUMMY" }, false);

        // EXPLORE: root-cause property is a pattern containing an escaped quote ("''"),
        // especially near other pattern syntax so parsing must advance correctly.
        String prefix = data.consumeAsciiString(24);
        String middle = data.consumeAsciiString(24);
        String suffix = data.consumeAsciiString(24);
        String arg = data.consumeString(32);
        boolean addFormat = data.consumeBoolean();
        boolean addQuotedSection = data.consumeBoolean();
        boolean escapedAtStart = data.consumeBoolean();

        StringBuilder pattern = new StringBuilder();
        if (escapedAtStart) {
            pattern.append("''");
        }
        pattern.append(prefix);
        pattern.append("''");
        pattern.append(middle);
        if (addQuotedSection) {
            pattern.append(" '");
            pattern.append(data.consumeAsciiString(16));
            pattern.append("''");
            pattern.append(data.consumeAsciiString(16));
            pattern.append("'");
        }
        if (addFormat) {
            pattern.append(" {0}");
        }
        pattern.append(suffix);

        tryPattern(pattern.toString(), null, new Object[] { arg }, true);

        // Additional varied real inputs satisfying the same property.
        String p1 = "''";
        String p2 = data.consumeAsciiString(10) + "''" + data.consumeAsciiString(10);
        String p3 = data.consumeAsciiString(10) + "''" + data.consumeAsciiString(10) + " {0}";
        String p4 = data.consumeAsciiString(10) + " 'x''y' " + data.consumeAsciiString(10) + " {0}";
        tryPattern(p1, null, new Object[] { arg }, true);
        tryPattern(p2, null, new Object[] { arg }, true);
        tryPattern(p3, null, new Object[] { arg }, true);
        tryPattern(p4, null, new Object[] { arg }, true);
    }

    private static void tryPattern(String pattern, Map registry, Object[] args, boolean checkSemantics) {
        try {
            ExtendedMessageFormat emf;
            if (registry == null) {
                emf = new ExtendedMessageFormat(pattern, Locale.US);
            } else {
                emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
            }
            emf.format(args);

            if (checkSemantics && registry == null) {
                // Contract used for this metamorphic check:
                // ExtendedMessageFormat is a MessageFormat subclass; with no custom registry,
                // there are no extended formats to alter parsing/formatting semantics, so it
                // must behave like MessageFormat on the same valid pattern and arguments.
                // A patch that merely makes the crashing branch unreachable or skips quote
                // handling can violate this equality without throwing.
                String lhs;
                String rhs;
                try {
                    lhs = new ExtendedMessageFormat(pattern, Locale.US).format(args);
                    rhs = new MessageFormat(pattern, Locale.US).format(args);
                } catch (Throwable t) {
                    return;
                }
                if (!safeEquals(lhs, rhs)) {
                    throw new RuntimeException(
                            "metamorphic violation: ExtendedMessageFormat(pattern)==MessageFormat(pattern) when registry is absent input="
                                    + pattern + " lhs=" + lhs + " rhs=" + rhs);
                }
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
        }
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException
                    || cur instanceof NumberFormatException
                    || cur instanceof IndexOutOfBoundsException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Validate") || name.contains("Invalid") || name.contains("Malformed")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof OutOfMemoryError)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            if ("org.apache.commons.lang.text.ExtendedMessageFormat".equals(ste.getClassName())
                    && "appendQuotedString".equals(ste.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean safeEquals(String a, String b) {
        return a == null ? b == null : a.equals(b);
    }
}
