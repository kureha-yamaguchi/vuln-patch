package org.apache.commons.math.analysis.solvers;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.math.FunctionEvaluationException;
import org.apache.commons.math.MaxIterationsExceededException;
import org.apache.commons.math.analysis.SinFunction;
import org.apache.commons.math.analysis.UnivariateRealFunction;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        UnivariateRealFunction f = new SinFunction();

        // ANCHOR: exact regression test input that is known to crash the buggy version.
        exerciseAndCheck(f, 3.0d, 3.2d, 3.1d, true);

        // EXPLORE: the root cause is calling solve(f, min, max, initial) with a real non-null
        // function; the buggy method drops f and dereferences internal state as null. We generate
        // many valid bracketing intervals for sin(x) around k*pi so a correct implementation is
        // obligated to handle them.
        int k = data.consumeInt(-1000, 1000);
        double root = k * Math.PI;

        int leftMilli = data.consumeInt(1, 1000);
        int rightMilli = data.consumeInt(1, 1000);
        double min = root - (leftMilli / 1000.0d);
        double max = root + (rightMilli / 1000.0d);
        if (min > max) {
            double t = min;
            min = max;
            max = t;
        }

        double initial;
        switch (data.consumeInt(0, 4)) {
            case 0:
                initial = min;
                break;
            case 1:
                initial = max;
                break;
            case 2:
                initial = root;
                break;
            case 3:
                initial = min + (max - min) * 0.5d;
                break;
            default:
                int frac = data.consumeInt(0, 1000000);
                initial = min + (max - min) * (frac / 1000000.0d);
                break;
        }

        exerciseAndCheck(f, min, max, initial, false);

        // Additional exploration with a second independently varied valid interval.
        int k2 = data.consumeInt(-1000, 1000);
        double root2 = k2 * Math.PI;
        int widthMilli = data.consumeInt(1, 2000);
        double width = widthMilli / 1000.0d;
        double min2 = root2 - width;
        double max2 = root2 + width;
        double initial2 = data.consumeBoolean() ? (min2 + max2) / 2.0d : root2;
        exerciseAndCheck(f, min2, max2, initial2, false);
    }

    private static void exerciseAndCheck(UnivariateRealFunction f, double min, double max, double initial, boolean anchor) {
        BisectionSolver solver = new BisectionSolver();
        try {
            double result = solver.solve(f, min, max, initial);

            // Post-condition from the solver contract: on successful return, the solver provides
            // a zero of the function in the given interval, to within its configured accuracy.
            // A bogus "fix" that merely avoids the NPE but returns an arbitrary value violates this.
            if (!(result >= min && result <= max)) {
                throw new RuntimeException(
                    "metamorphic violation: successful solve returned value outside interval input=[" +
                    min + "," + max + "] initial=" + initial + " result=" + result);
            }

            double y = f.value(result);
            double tol = Math.max(solver.getAbsoluteAccuracy(), 1.0e-6d);
            if (!(Math.abs(y) <= tol)) {
                throw new RuntimeException(
                    "metamorphic violation: successful solve did not return a root approximation input=[" +
                    min + "," + max + "] initial=" + initial + " result=" + result + " f(result)=" + y +
                    " tol=" + tol);
            }

            // Equivalent-input relation for these valid-by-construction bracketing intervals:
            // varying the "initial" guess must not change the computed root materially for a correct
            // bisection solve on sin over an interval that brackets a unique root near k*pi.
            try {
                BisectionSolver solver2 = new BisectionSolver();
                double altInitial = (min + max) / 2.0d;
                double result2 = solver2.solve(f, min, max, altInitial);
                double eqTol = Math.max(Math.max(solver.getAbsoluteAccuracy(), solver2.getAbsoluteAccuracy()), 1.0e-6d);
                if (Math.abs(result - result2) > eqTol) {
                    throw new RuntimeException(
                        "metamorphic violation: equivalent inputs disagreed input=[" + min + "," + max +
                        "] initial1=" + initial + " initial2=" + altInitial +
                        " lhs=" + result + " rhs=" + result2);
                }
            } catch (Throwable ignored) {
                // If either side throws, the relation does not apply for this input.
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            if (anchor && t instanceof RuntimeException && hasRelevantFrame(t)) {
                // Preserve unexpected runtime failures from the anchored public entry point only if
                // they occur in the patched region; this helps surface sibling manifestations.
                throw (RuntimeException) t;
            }
            // Any other throwable is outside this patch's scope or an acceptable rejection.
        }
    }

    private static boolean isRootCause(Throwable t) {
        return t instanceof NullPointerException && hasRelevantFrame(t);
    }

    private static boolean hasRelevantFrame(Throwable t) {
        for (StackTraceElement e : t.getStackTrace()) {
            if ("org.apache.commons.math.analysis.solvers.BisectionSolver".equals(e.getClassName())
                    && "solve".equals(e.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        if (t instanceof IllegalArgumentException || t instanceof NumberFormatException) {
            return true;
        }
        String name = t.getClass().getName();
        String lower = name.toLowerCase();
        if (lower.contains("invalid") || lower.contains("argument") || lower.contains("convergence")) {
            return true;
        }
        return t instanceof MaxIterationsExceededException || t instanceof FunctionEvaluationException;
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwUnchecked(Throwable t) throws T {
        throw (T) t;
    }
}
