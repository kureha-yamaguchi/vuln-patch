package com.google.javascript.jscomp;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.ArrayList;
import java.util.List;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        String anchor =
                "var goog = {};"
                        + "goog.inherits = function(x, y) {};"
                        + "var ns = {};"
                        + "/** @constructor */"
                        + "ns.PageSelectionModel = function() {};"
                        + "/** @constructor */"
                        + "ns.PageSelectionModel.FooEvent = function() {};"
                        + "/** @constructor */"
                        + "ns.PageSelectionModel.SelectEvent = function() {};"
                        + "goog.inherits(ns.PageSelectionModel.ChangeEvent,"
                        + "    ns.PageSelectionModel.FooEvent);";

        tryCompileAndCheck(anchor);

        String ns = ident(data.consumeAsciiString(16), "ns");
        String base = ident(data.consumeAsciiString(16), "PageSelectionModel");
        String defined1 = ident(data.consumeAsciiString(16), "FooEvent");
        String defined2 = ident(data.consumeAsciiString(16), "SelectEvent");
        String missing = ident(data.consumeAsciiString(16), "ChangeEvent");
        if (missing.equals(defined1) || missing.equals(defined2) || missing.equals(base)) {
            missing = missing + "Missing";
        }

        String inheritsName = data.consumeBoolean() ? "inherits" : ident(data.consumeAsciiString(12), "inherits");
        String googDecl = data.consumeBoolean() ? "var goog = {};" : "var goog={};";
        String spacing1 = data.consumeBoolean() ? "" : "\n";
        String spacing2 = data.consumeBoolean() ? "" : " ";
        String comment = data.consumeBoolean() ? "/** @constructor */" : "";
        String comment2 = data.consumeBoolean() ? "/** @constructor */" : "";
        String comment3 = data.consumeBoolean() ? "/** @constructor */" : "";

        StringBuilder fuzzProgram = new StringBuilder();
        fuzzProgram.append(googDecl);
        fuzzProgram.append("goog.").append(inheritsName).append("=function(x,y){};").append(spacing1);
        fuzzProgram.append("var ").append(ns).append("={};").append(spacing1);
        fuzzProgram.append(comment).append(spacing2)
                .append(ns).append(".").append(base).append("=function(){};").append(spacing1);
        fuzzProgram.append(comment2).append(spacing2)
                .append(ns).append(".").append(base).append(".").append(defined1).append("=function(){};").append(spacing1);
        fuzzProgram.append(comment3).append(spacing2)
                .append(ns).append(".").append(base).append(".").append(defined2).append("=function(){};").append(spacing1);
        fuzzProgram.append("goog.").append(inheritsName).append("(")
                .append(ns).append(".").append(base).append(".").append(missing).append(",")
                .append(ns).append(".").append(base).append(".").append(defined1).append(");");

        tryCompileAndCheck(fuzzProgram.toString());

        String whitespaceVariant = fuzzProgram.toString()
                .replace(";", ";\n")
                .replace("=", " = ")
                .replace(",", ", ");
        tryMetamorphicEquivalentOutput(fuzzProgram.toString(), whitespaceVariant);
    }

    /*
     * Contract asserted:
     * The project already codifies that this smart-name-removal input shape compiles to the empty output
     * (see the provided IntegrationTest/NameAnalyzerTest expecting "").
     * These constructed programs contain only dead namespace/object/function declarations plus a class-defining
     * call through goog.inherits; a correct implementation should accept them and remove all code.
     * A patch that merely deletes the bookkeeping statement at the patched site can avoid the crash while
     * silently keeping wrong output, which this check catches.
     */
    private static void tryCompileAndCheck(String js) {
        try {
            String out = compile(js);
            if (out != null && out.trim().length() != 0) {
                throw new RuntimeException("metamorphic violation: expected empty optimized output input=" + summarize(js) + " output=" + summarize(out));
            }
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
        }
    }

    /*
     * Equivalent-input relation:
     * Reformatting with extra whitespace does not change JavaScript semantics, so any correct compiler
     * optimization result must be identical for both programs. If either side throws, the relation does
     * not apply and is skipped.
     */
    private static void tryMetamorphicEquivalentOutput(String a, String b) {
        String outA;
        try {
            outA = compile(a);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        String outB;
        try {
            outB = compile(b);
        } catch (Throwable t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throwUnchecked(t);
            }
            return;
        }

        if (outA != null && outB != null && !outA.equals(outB)) {
            throw new RuntimeException("metamorphic violation: whitespace-equivalent compile outputs differ inputA="
                    + summarize(a) + " inputB=" + summarize(b) + " lhs=" + summarize(outA) + " rhs=" + summarize(outB));
        }
    }

    private static String compile(String js) {
        Compiler compiler = new Compiler();
        CompilerOptions options = new CompilerOptions();
        CompilationLevel.SIMPLE_OPTIMIZATIONS.setOptionsForCompilationLevel(options);
        options.smartNameRemoval = true;
        try {
            options.setCodingConvention(new ClosureCodingConvention());
        } catch (Throwable ignored) {
        }

        JSSourceFile extern = JSSourceFile.fromCode("externs.js", "");
        JSSourceFile input = JSSourceFile.fromCode("input.js", js);
        compiler.compile(extern, input, options);
        return compiler.toSource();
    }

    private static boolean isCleanRejection(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (cur instanceof IllegalArgumentException || cur instanceof NumberFormatException) {
                return true;
            }
            String name = cur.getClass().getName();
            if (name.contains("Parse") || name.contains("Validation") || name.contains("Invalid")) {
                return true;
            }
        }
        return false;
    }

    private static boolean isRootCause(Throwable t) {
        for (Throwable cur = t; cur != null; cur = cur.getCause()) {
            if (!(cur instanceof RuntimeException) && !(cur instanceof AssertionError)) {
                continue;
            }
            if (hasRelevantFrame(cur.getStackTrace())) {
                return true;
            }
        }
        return false;
    }

    private static boolean hasRelevantFrame(StackTraceElement[] trace) {
        for (StackTraceElement e : trace) {
            String cls = e.getClassName();
            String m = e.getMethodName();
            if ("com.google.javascript.jscomp.NameAnalyzer".equals(cls)) {
                if ("visit".equals(m)
                        || "createNameInformation".equals(m)
                        || "recordSet".equals(m)
                        || "recordPrototypeSet".equals(m)
                        || "getName".equals(m)) {
                    return true;
                }
            }
            if ("com.google.javascript.jscomp.NodeUtil".equals(cls) && "isFunctionDeclaration".equals(m)) {
                return true;
            }
            if ("com.google.javascript.rhino.Node".equals(cls)) {
                if ("getType".equals(m) || "getParent".equals(m) || "getFirstChild".equals(m)) {
                    return true;
                }
            }
            if ("com.google.javascript.jscomp.NodeUtil".equals(cls) && "getFunctionName".equals(m)) {
                return true;
            }
        }
        return false;
    }

    private static String ident(String s, String fallback) {
        if (s == null || s.length() == 0) {
            return fallback;
        }
        StringBuilder b = new StringBuilder();
        char first = s.charAt(0);
        if (!Character.isLetter(first) && first != '_' && first != '$') {
            b.append(fallback);
        }
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (Character.isLetterOrDigit(c) || c == '_' || c == '$') {
                b.append(c);
            }
        }
        if (b.length() == 0) {
            return fallback;
        }
        return b.toString();
    }

    private static String summarize(String s) {
        if (s == null) {
            return "null";
        }
        String oneLine = s.replace('\n', ' ').replace('\r', ' ');
        if (oneLine.length() > 200) {
            return oneLine.substring(0, 200) + "...";
        }
        return oneLine;
    }

    private static void throwUnchecked(Throwable t) {
        FuzzHarness.<RuntimeException>throwAny(t);
    }

    @SuppressWarnings("unchecked")
    private static <T extends Throwable> void throwAny(Throwable t) throws T {
        throw (T) t;
    }
