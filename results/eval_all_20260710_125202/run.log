package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        runAnchor("\uD83D\uDE30");
        runAnchor("\uD800\uDC00");
        runAnchor("\uD834\uDD1E");
        runAnchor("\uDBFF\uDFFD");

        String fuzzed = buildSafeStringWithSurrogatePairs(data);
        if (fuzzed != null) {
            exerciseAndCheck(fuzzed);
        }

        String maybeSafe = sanitizeCsvMetacharacters(data.consumeString(Math.min(64, Math.max(0, data.remainingBytes()))));
        if (maybeSafe.length() > 0 && containsSurrogateCodeUnit(maybeSafe)) {
            exerciseAndCheck(maybeSafe);
        }
    }

    private static void runAnchor(String s) {
        exerciseAndCheck(s);
    }

    private static void exerciseAndCheck(String s) {
        try {
            String out = StringEscapeUtils.escapeCsv(s);

            /*
             * Contract asserted: the CSV escaper only quotes/escapes values containing CSV meta-characters
             * (comma, quote, CR, LF). For inputs constructed to contain none of these characters, the result
             * must be the original input unchanged. The failing test itself demonstrates this for surrogate pairs.
             * A "fix" that merely suppresses the crash but skips/duplicates characters would violate this.
             */
            if (!containsCsvMeta(s) && !s.equals(out)) {
                throw new RuntimeException("metamorphic violation: escapeCsv(identity on CSV-safe input) input=" + printable(s) + " lhs=" + printable(out) + " rhs=" + printable(s));
            }
        } catch (RuntimeException t) {
            if (isCleanRejection(t)) {
                return;
            }
            if (isRootCause(t)) {
                throw t;
            }
            return;
        }
    }

    private static boolean isRootCause(Throwable t) {
        if (!(t instanceof StringIndexOutOfBoundsException)) {
            return false;
        }
        for (StackTraceElement ste : t.getStackTrace()) {
            String cls = ste.getClassName();
            String method = ste.getMethodName();
            if ("org.apache.commons.lang3.text.translate.CharSequenceTranslator".equals(cls) && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.LookupTranslator".equals(cls) && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.CodePointTranslator".equals(cls) && "translate".equals(method)) {
                return true;
            }
            if ("org.apache.commons.lang3.text.translate.AggregateTranslator".equals(cls) && "translate".equals(method)) {
                return true;
            }
        }
        return false;
    }

    private static boolean isCleanRejection(Throwable t) {
        return t instanceof IllegalArgumentException || t instanceof NumberFormatException;
    }

    private static String buildSafeStringWithSurrogatePairs(FuzzedDataProvider data) {
        int parts = data.consumeInt(1, 8);
        StringBuilder sb = new StringBuilder();
        boolean insertedSupplementary = false;

        for (int i = 0; i < parts; i++) {
            if (data.consumeBoolean()) {
                int asciiLen = data.consumeInt(0, 8);
                for (int j = 0; j < asciiLen; j++) {
                    sb.append(safeAsciiFromByte(data.consumeByte()));
                }
            } else {
                int cp = chooseSupplementaryCodePoint(data.consumeInt());
                sb.append(Character.toChars(cp));
                insertedSupplementary = true;
            }
        }

        if (!insertedSupplementary) {
            sb.append(Character.toChars(chooseSupplementaryCodePoint(data.consumeInt())));
        }

        return sb.toString();
    }

    private static int chooseSupplementaryCodePoint(int seed) {
        int range = 0x10FFFF - 0x10000 + 1;
        int cp = 0x10000 + Math.floorMod(seed, range);
        if (!Character.isValidCodePoint(cp) || cp < 0x10000) {
            cp = 0x10000;
        }
        return cp;
    }

    private static char safeAsciiFromByte(byte b) {
        int v = b & 0xFF;
        char c = (char) (' ' + (v % 95));
        if (c == ',' || c == '"' || c == '\r' || c == '\n') {
            return 'A';
        }
        return c;
    }

    private static String sanitizeCsvMetacharacters(String s) {
        StringBuilder sb = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                sb.append('A');
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    private static boolean containsCsvMeta(String s) {
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == ',' || c == '"' || c == '\r' || c == '\n') {
                return true;
            }
        }
        return false;
    }

    private static boolean containsSurrogateCodeUnit(String s) {
        for (int i = 0; i < s.length(); i++) {
            if (Character.isSurrogate(s.charAt(i))) {
                return true;
            }
        }
        return false;
    }

    private static String printable(String s) {
        StringBuilder sb = new StringBuilder();
        sb.append('"');
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= 32 && c <= 126 && c != '\\' && c != '"') {
                sb.append(c);
            } else {
                sb.append("\\u");
                String hex = Integer.toHexString(c);
                for (int j = hex.length(); j < 4; j++) {
                    sb.append('0');
                }
                sb.append(hex);
            }
        }
        sb.append('"');
        return sb.toString();
    }
}
