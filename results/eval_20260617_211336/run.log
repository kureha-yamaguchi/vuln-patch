package org.joda.time.tz;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        final long farFutureProbe =
                new org.joda.time.DateTime(2500, 1, 1, 12, 0, 0, 0, org.joda.time.DateTimeZone.UTC).getMillis();

        DateTimeZoneBuilder seedBuilder1 = new DateTimeZoneBuilder();
        seedBuilder1.setStandardOffset(0);
        seedBuilder1.addRecurringSavings(
                "DST", 60 * 60 * 1000, 2000, Integer.MAX_VALUE,
                'w', 3, 31, 0, false, 2 * 60 * 60 * 1000);
        seedBuilder1.addRecurringSavings(
                "STD", 0, 2000, Integer.MAX_VALUE,
                'w', 10, 31, 0, false, 2 * 60 * 60 * 1000);

        seedBuilder1.toDateTimeZone("TestDTZ1", true);

        final org.joda.time.DateTimeZone[] zone = new org.joda.time.DateTimeZone[1];
        Thread t = new Thread(new Runnable() {
            public void run() {
                DateTimeZoneBuilder seedBuilder2 = new DateTimeZoneBuilder();
                seedBuilder2.setStandardOffset(0);
                seedBuilder2.addRecurringSavings(
                        "DST", 60 * 60 * 1000, 2000, Integer.MAX_VALUE,
                        'w', 3, 31, 0, false, 2 * 60 * 60 * 1000);
                seedBuilder2.addRecurringSavings(
                        "STD", 0, 2000, Integer.MAX_VALUE,
                        'w', 10, 31, 0, false, 2 * 60 * 60 * 1000);
                zone[0] = seedBuilder2.toDateTimeZone("TestDTZ2", true);
            }
        });
        t.start();
        try {
            t.join();
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            return;
        }

        if (zone[0] == null) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: assertNotNull(zone[0])");
        }

        if (zone[0].nextTransition(farFutureProbe) <= farFutureProbe) {
            throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                    "semantic mismatch: infinite recurring rules lost future transitions");
        }

        String fuzzId = data.consumeAsciiString(32);
        if (fuzzId.length() == 0) {
            fuzzId = "FuzzDTZ";
        }

        int standardOffset = data.consumeInt(-18 * 60 * 60 * 1000, 18 * 60 * 60 * 1000);
        int dstSavings = data.consumeInt(1, 6 * 60 * 60 * 1000);
        int startMonth = data.consumeInt(1, 12);
        int endMonth = data.consumeInt(1, 12);
        if (endMonth == startMonth) {
            endMonth = (endMonth % 12) + 1;
        }
        int startDay = data.consumeInt(1, 28);
        int endDay = data.consumeInt(1, 28);
        int startMillis = data.consumeInt(0, 23) * 60 * 60 * 1000;
        int endMillis = data.consumeInt(0, 23) * 60 * 60 * 1000;

        try {
            DateTimeZoneBuilder fuzzBuilder1 = new DateTimeZoneBuilder();
            fuzzBuilder1.setStandardOffset(standardOffset);
            fuzzBuilder1.addRecurringSavings(
                    "DST", dstSavings, 2000, Integer.MAX_VALUE,
                    'w', startMonth, startDay, 0, false, startMillis);
            fuzzBuilder1.addRecurringSavings(
                    "STD", 0, 2000, Integer.MAX_VALUE,
                    'w', endMonth, endDay, 0, false, endMillis);

            org.joda.time.DateTimeZone fuzzZone1 = fuzzBuilder1.toDateTimeZone(fuzzId, true);

            if (fuzzZone1 == null) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: toDateTimeZone returned null for two infinite recurring rules");
            }

            if (!fuzzId.equals(fuzzZone1.getID())) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: toDateTimeZone(..., true) did not preserve the supplied id");
            }

            if (fuzzZone1.nextTransition(farFutureProbe) <= farFutureProbe) {
                throw new com.code_intelligence.jazzer.api.FuzzerSecurityIssueLow(
                        "semantic mismatch: fuzzed infinite recurring rules lost future transitions");
            }

            DateTimeZoneBuilder fuzzBuilder2 = new DateTimeZoneBuilder();
