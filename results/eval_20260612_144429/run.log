        // EXPLORE: generate varied inputs that keep the "toString() returns null at startIndex" property
        int n = 1 + Math.abs(data.consumeInt()) % 16; // ensure at least 1
        Object[] arr = new Object[n];
        for (int i = 0; i < n; i++) {
            int choice = Math.abs(data.consumeInt()) % 7;
            switch (choice) {
                case 0:
                    arr[i] = null;
                    break;
                case 1:
                    arr[i] = data.consumeString(20);
                    break;
                case 2:
                    arr[i] = data.consumeAsciiString(20);
                    break;
                case 3:
                    arr[i] = Integer.valueOf(data.consumeInt());
                    break;
                case 4:
                    arr[i] = Boolean.valueOf(data.consumeBoolean());
                    break;
                case 5:
                    arr[i] = new Object();
                    break;
                default:
                    arr[i] = Long.valueOf(data.consumeInt());
                    break;
            }
        }
        // Ensure at least one element has a toString() that returns null
        int posBroken = data.consumeInt(0, n - 1);
        arr[posBroken] = new NullToString();

        // Choose start/end so that frequently startIndex hits the broken element
        int startIndex = data.consumeBoolean() ? posBroken : data.consumeInt(0, n - 1);
        int remaining = n - startIndex - 1;
        int endIndex = startIndex + 1 + (remaining > 0 ? data.consumeInt(0, remaining) : 0);

        // Separators
        String oneChar = data.consumeAsciiString(1);
        char sepChar = oneChar.length() == 1 ? oneChar.charAt(0) : ',';
        String sepString = data.consumeAsciiString(5);
        if (!data.consumeBoolean()) {
            sepString = null; // also exercise null separator behavior (treated as "")
        }

        // Drive the patched overloads
        StringUtils.join(arr, sepChar, startIndex, endIndex);
        StringUtils.join(arr, sepString, startIndex, endIndex);

        // Additional slices around the broken element
        if (n > 1) {
            int s2 = posBroken;
            int rem2 = n - s2 - 1;
            int e2 = s2 + 1 + (rem2 > 0 ? data.consumeInt(0, rem2) : 0);
            StringUtils.join(arr, sepChar, s2, e2);
            StringUtils.join(arr, sepString, s2, e2);
        }

        // METAMORPHIC CHECK:
        // For any array and single-character separator c, the char- and String-based
        // overloads over the same slice [0, n) must agree.
        String lhs = StringUtils.join(arr, sepChar, 0, arr.length);
        String rhs = StringUtils.join(arr, Character.toString(sepChar), 0, arr.length);
        if (lhs != null && rhs != null && !lhs.equals(rhs)) {
            throw new RuntimeException("metamorphic violation: join(arr, char, 0, n) != join(arr, String(oneChar), 0, n)");
        }
    }
