    private static String buildSingleExponent(FuzzedDataProvider data) {
        // Construct a number with exactly one exponent marker and no decimal point or type suffix.
        boolean negative = data.consumeBoolean();
        String digits1 = digitsOnly(data.consumeAsciiString(20));
        if (digits1.isEmpty()) digits1 = "1";
        String digits2 = digitsOnly(data.consumeAsciiString(10));
        if (digits2.isEmpty()) digits2 = "2";
        char expChar = data.consumeBoolean() ? 'e' : 'E';

        StringBuilder sb = new StringBuilder();
        if (negative) sb.append('-');
        sb.append(digits1);
        sb.append(expChar);
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        sb.append(digits2);
        String s = sb.toString();

        if (s.indexOf('.') >= 0) return null;
        if (s.startsWith("0x") || s.startsWith("-0x")) return null;
        // Ensure exactly one exponent character
        int count = 0;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == 'e' || c == 'E') count++;
        }
        if (count != 1) return null;
        return s;
    }

    private static String digitsOnly(String s) {
        if (s == null || s.isEmpty()) return "";
        StringBuilder out = new StringBuilder(s.length());
