            iterations = 3;
        }

        for (int i = 0; i < iterations; i++) {
            // Build a string that often contains supplementary code points (surrogate pairs)
            StringBuilder sb = new StringBuilder();

            // Optional ASCII prefix/suffix to vary positions
            if (data.consumeBoolean()) {
                sb.append(data.consumeAsciiString(16));
            }

            // Insert 0..3 supplementary code points
            int pairCount = data.consumeInt(0, 3);
            for (int p = 0; p < pairCount; p++) {
                int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
                // Filter out invalid non-characters in the surrogate range is unnecessary; toChars handles it
                sb.append(new String(Character.toChars(cp)));
                if (data.consumeBoolean()) {
                    // Between pairs, optionally insert ASCII to vary positions
                    sb.append(data.consumeAsciiString(8));
                }
            }

            // Ensure we sometimes hit the minimal-length property: exactly one surrogate pair
            if (sb.length() == 0 || data.consumeBoolean()) {
                int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
                String onePair = new String(Character.toChars(cp));
                if (data.consumeBoolean()) {
                    // Replace entirely with exactly one pair to stress the root cause (len == 2)
                    sb.setLength(0);
                    sb.append(onePair);
                } else {
                    sb.append(onePair);
                }
            }

            // Optionally inject CSV-special chars to trigger full-field translation (consumed > 1)
            if (data.consumeBoolean()) {
                char[] specials = new char[] { '"', ',', '\n', '\r' };
                char chosen = specials[data.consumeInt(0, specials.length - 1)];
                // Insert at random position
                int pos = 0;
                if (sb.length() > 0) {
                    pos = data.consumeInt(0, sb.length());
                }
                sb.insert(pos, chosen);
            }

            if (data.consumeBoolean()) {
                sb.append(data.consumeAsciiString(16));
            }

