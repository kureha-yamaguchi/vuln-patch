        StringBuilder sb = new StringBuilder();
        if (negative) sb.append('-');
        sb.append(base);

        char e = data.consumeBoolean() ? 'e' : 'E';
        sb.append(e);
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        String exp = digitsOnly(data.consumeAsciiString(16));
        if (exp.isEmpty()) exp = "1";
        sb.append(exp);

        if (withSuffix && data.consumeBoolean()) {
            char[] suffixes = new char[] {'f', 'F', 'd', 'D'};
            char suff = suffixes[data.consumeInt(0, suffixes.length - 1)];
            sb.append(suff);
        }

        return sb.toString();
    }

    private static String buildInteger(FuzzedDataProvider data, boolean allowLongSuffix) {
        // Optional sign
        StringBuilder sb = new StringBuilder();
        if (data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? '-' : '+');
        }
        String digits = digitsOnly(data.consumeAsciiString(32));
        if (digits.isEmpty()) digits = "0";
        sb.append(digits);

        if (allowLongSuffix && data.consumeBoolean()) {
            sb.append(data.consumeBoolean() ? 'L' : 'l');
        }
        return sb.toString();
    }

    private static String buildHex(FuzzedDataProvider data) {
        boolean negative = data.consumeBoolean();
        String digits = digitsOnly(data.consumeAsciiString(32));
        if (digits.isEmpty()) digits = "0";
        StringBuilder sb = new StringBuilder();
        if (negative) sb.append('-');
        sb.append("0x").append(digits);
        return sb.toString();
    }

    private static String digitsOnly(String s) {
        if (s == null || s.isEmpty()) return "";
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c >= '0' && c <= '9') out.append(c);
        }
        return out.toString();
    }

    private static String toggleExponentCase(String s) {
        StringBuilder out = new StringBuilder(s.length());
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == 'e') out.append('E');
            else if (c == 'E') out.append('e');
            else out.append(c);
        }
        return out.toString();
    }
}
