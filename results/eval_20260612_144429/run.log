package org.apache.commons.lang3.math;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.math.BigDecimal;
import java.math.BigInteger;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact crashing input on buggy version
        try {
            NumberUtils.createNumber("1234.5");
        } catch (NumberFormatException expected) {
            // Clean rejection is fine.
        }

        // EXPLORE: Generate numbers that hit the patched path (no dot, with exponent).
        int expNoDotIters = 1 + data.consumeInt(0, 10);
        for (int i = 0; i < expNoDotIters; i++) {
            String s = buildExpNoDot(data);
            parseSafely(s);
        }

        // Additional exploration: decimals and exponents with/without suffixes to vary surrounding content.
        int generalIters = 1 + data.consumeInt(0, 10);
        for (int i = 0; i < generalIters; i++) {
            String s1 = buildDecimalMaybeExp(data);
            parseSafely(s1);

            // Sometimes also try a plain integer or hex to mix coverage
            if (data.consumeBoolean()) {
                String s2 = buildIntegerOrHex(data);
                parseSafely(s2);
            }
        }

        // Also try one raw ASCII slice shaped into a number-like string quickly.
        if (data.consumeBoolean()) {
            String ascii = data.consumeAsciiString(64);
            String cleaned = keepNumberLike(ascii);
            if (!cleaned.isEmpty()) {
                parseSafely(cleaned);
            }
        }

        // ONE metamorphic check: case-insensitive equivalence for exponent/suffix forms.
        // Build a candidate with exponent or suffix (not hex) and assert f(s) == f(toggleCase(s)).
        String meta = data.consumeBoolean() ? buildExpNoDot(data) : buildDecimalMaybeExp(data);
        if (!containsHexPrefix(meta)) {
            String toggled = toggleSuffixAndExponentCase(meta);
            if (!toggled.equals(meta)) {
                try {
                    Number n1 = NumberUtils.createNumber(meta);
                    Number n2 = NumberUtils.createNumber(toggled);
                    if (n1 != null && n2 != null) {
                        BigDecimal b1 = toBigDecimalSafe(n1);
                        BigDecimal b2 = toBigDecimalSafe(n2);
                        if (b1 != null && b2 != null && b1.compareTo(b2) != 0) {
                            throw new RuntimeException("metamorphic violation: case-insensitive parse mismatch");
                        }
                    }
                } catch (NumberFormatException ignored) {
                    // If either is rejected cleanly, skip the check.
                }
            }
        }
    }

    private static void parseSafely(String s) {
        try {
            NumberUtils.createNumber(s);
        } catch (NumberFormatException expected) {
            // Clean rejection is fine and expected for many fuzzed inputs.
        }
