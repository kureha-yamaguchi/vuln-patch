package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: Known crashing seeds from the failing test
        String[] seeds = {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String seed : seeds) {
            String escaped = StringEscapeUtils.escapeCsv(seed);
            String roundTrip = StringEscapeUtils.unescapeCsv(escaped);
            if (!seed.equals(roundTrip)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(seed)) != seed");
            }
        }

        // EXPLORE: Fuzz varied inputs containing supplementary code points and CSV specials
        int iterations = data.consumeInt(1, 10);
        for (int i = 0; i < iterations; i++) {
            StringBuilder sb = new StringBuilder();

            // Random ASCII prefix
            sb.append(data.consumeAsciiString(20));

            // Optionally add CSV special chars to exercise translators that consume multiple code units
            if (data.consumeBoolean()) sb.append(',');
            if (data.consumeBoolean()) sb.append('"');
            if (data.consumeBoolean()) sb.append('\n');
            if (data.consumeBoolean()) sb.append('\r');

            // Ensure at least one supplementary code point (surrogate pair) is present somewhere
            int supCount = data.consumeInt(1, 4);
            for (int j = 0; j < supCount; j++) {
                int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000); // valid supplementary plane
                sb.append(new String(Character.toChars(cp)));
                // Interleave more specials randomly
                if (data.consumeBoolean()) sb.append(',');
                if (data.consumeBoolean()) sb.append('"');
                if (data.consumeBoolean()) sb.append('\n');
            }

            // Random ASCII suffix
            sb.append(data.consumeAsciiString(20));

            String s = sb.toString();

            // Drive through the real public API
            String escaped = StringEscapeUtils.escapeCsv(s);

            // Metamorphic check: unescape(escape(x)) == x
            String unescaped = StringEscapeUtils.unescapeCsv(escaped);
            if (!s.equals(unescaped)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(s)) != s");
            }
        }
    }
}
