        // EXPLORE: Generate varied inputs that end with 'l' or 'L' to exercise the patched path.
        int iterations = data.consumeInt(1, 32);
        for (int i = 0; i < iterations; i++) {
            String base = buildBase(data);
            char suffix = data.consumeBoolean() ? 'l' : 'L';
            String val = base + suffix;

            // Drive through the real entry point.
            Number n1 = null;
            boolean ok1 = false;
            try {
                n1 = NumberUtils.createNumber(val);
                ok1 = true;
            } catch (NumberFormatException expected) {
                // Invalid input is expected to be cleanly rejected.
            }

            // Metamorphic check: case-insensitive suffix (l vs L) should yield identical result when both valid.
            String toggled = base + (suffix == 'l' ? 'L' : 'l');
            try {
                Number n2 = NumberUtils.createNumber(toggled);
                if (ok1) {
                    if (!n1.getClass().equals(n2.getClass()) || !n1.toString().equals(n2.toString())) {
                        throw new RuntimeException("metamorphic violation: case-insensitive 'l/L' suffix should not change value/type");
                    }
                }
            } catch (NumberFormatException expected) {
                // If either side is rejected, skip the relation (only assert when both succeed).
            }
        }

        // Extra direct probe for the minimal crashing case: single-char 'l' or 'L'
        if (data.consumeBoolean()) {
            String minimal = String.valueOf(data.consumeBoolean() ? 'l' : 'L');
            try {
                NumberUtils.createNumber(minimal);
            } catch (NumberFormatException expected) {
                // expected rejection after fix
            }
        }
    }

    private static String buildBase(FuzzedDataProvider data) {
        switch (data.consumeInt(0, 5)) {
            case 0:
                // Empty base -> hits the original root cause when suffixed with 'l'/'L'
                return "";
            case 1:
                // Digits only
                return randomDigits(data, 16);
            case 2: {
                // Optional sign + digits
                String digits = randomDigits(data, 16);
                if (digits.length() == 0) {
                    digits = randomDigits(data, 1);
                }
                return (data.consumeBoolean() ? "-" : "") + digits;
            }
            case 3: {
                // Decimal form
                String a = randomDigits(data, 8);
                String b = randomDigits(data, 8);
                return a + '.' + b;
            }
            case 4: {
                // Scientific notation in the base
                String a = randomDigits(data, 8);
                char e = data.consumeBoolean() ? 'e' : 'E';
                String sign = data.consumeBoolean() ? (data.consumeBoolean() ? "-" : "+") : "";
                String b = randomDigits(data, 8);
                return a + e + sign + b;
            }
            default:
                // Random ASCII base
                return data.consumeAsciiString(16);
        }
    }

    private static String randomDigits(FuzzedDataProvider data, int maxLen) {
        int len = data.consumeInt(0, maxLen);
