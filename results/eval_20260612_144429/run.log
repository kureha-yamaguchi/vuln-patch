        }

        // EXPLORE: Fuzz many variants that satisfy the root-cause property: both 'e' and 'E' present,
        // no decimal point, and one of them at the end to maximize expPos > length.
        int iterations = 1 + data.consumeInt(0, 50);
        for (int i = 0; i < iterations; i++) {
            boolean endWithLower = data.consumeBoolean(); // choose which exponent char ends the string
            boolean negative = data.consumeBoolean();
            String prefix = digitsOnly(data.consumeAsciiString(20));
            if (prefix.isEmpty()) prefix = "1";
            String mid = digitsOnly(data.consumeAsciiString(10));
            String s;
            if (endWithLower) {
                // ensure last char is 'e'
                s = (negative ? "-" : "") + prefix + 'E' + mid + 'e';
            } else {
                // ensure last char is 'E'
                s = (negative ? "-" : "") + prefix + 'e' + mid + 'E';
            }
            // Avoid hex shortcut
            if (s.startsWith("0x") || s.startsWith("-0x")) continue;

            try {
                NumberUtils.createNumber(s);
            } catch (NumberFormatException ignore) {
                // clean rejection; swallow
            }
        }

