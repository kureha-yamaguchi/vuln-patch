                Number n2 = NumberUtils.createNumber(toggleExponentCase(singleExp));
                double d1 = n1.doubleValue();
                double d2 = n2.doubleValue();
                if (Double.doubleToLongBits(d1) != Double.doubleToLongBits(d2)) {
                    throw new RuntimeException("metamorphic violation: exponent case-insensitive parse");
                }
            } catch (NumberFormatException ignore) {
