    private static BigDecimal toBigDecimalSafe(Number n) {
        if (n == null) return null;
        if (n instanceof BigDecimal) {
            return (BigDecimal) n;
        } else if (n instanceof BigInteger) {
            return new BigDecimal((BigInteger) n);
        } else if (n instanceof Byte || n instanceof Short || n instanceof Integer || n instanceof Long) {
            return BigDecimal.valueOf(n.longValue());
        } else if (n instanceof Float) {
            float f = ((Float) n).floatValue();
            if (Float.isInfinite(f) || Float.isNaN(f)) return null;
            return BigDecimal.valueOf(((Float) n).doubleValue());
        } else if (n instanceof Double) {
            double d = ((Double) n).doubleValue();
            if (Double.isInfinite(d) || Double.isNaN(d)) return null;
            return BigDecimal.valueOf(d);
        } else {
            // Fallback via string to preserve value if possible
            try {
                return new BigDecimal(n.toString());
            } catch (Exception e) {
                return null;
            }
        }
    }

    private static String keepNumberLike(String s) {
