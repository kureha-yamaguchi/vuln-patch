package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor inputs from failing test
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD83D\uDE30");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD800\uDC00");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        org.apache.commons.lang3.StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        // Explore: construct strings containing surrogate pairs in varied positions and contexts
        String prefix = data.consumeString(30);
        String suffix = data.consumeString(30);
        int pairs = 1 + Math.abs(data.consumeInt()) % 4; // ensure at least one surrogate pair

        StringBuilder sb = new StringBuilder();

        // Optionally include CSV special characters in the prefix to exercise full-string translation paths
        if (data.consumeBoolean()) {
            sb.append(prefix);
        } else {
            String p = prefix;
            if (data.consumeBoolean()) p += ",";
            if (data.consumeBoolean()) p += "\"";
            if (data.consumeBoolean()) p += "\r\n";
            sb.append(p);
        }

        for (int i = 0; i < pairs; i++) {
            // Add a supplementary-plane code point (forces a surrogate pair)
            int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
