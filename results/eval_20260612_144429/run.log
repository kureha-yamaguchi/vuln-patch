            String country = randomCountry(data);
            String variant = randomVariant(data);

            Locale loc;
            int ctorChoice = data.consumeInt(0, 2);
            if (ctorChoice == 0) {
                loc = new Locale(lang);
            } else if (ctorChoice == 1) {
                loc = new Locale(lang, country);
            } else {
