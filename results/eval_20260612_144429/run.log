package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: replicate exact inputs from the tests; first call must be before any cache initialization
        Locale LOCALE_EN = new Locale("en", "");
        Locale LOCALE_EN_US = new Locale("en", "US");
        Locale LOCALE_EN_US_ZZZZ = new Locale("en", "US", "ZZZZ");
        Locale LOCALE_FR = new Locale("fr", "");
        Locale LOCALE_FR_CA = new Locale("fr", "CA");
        Locale LOCALE_QQ = new Locale("qq", "");
        Locale LOCALE_QQ_ZZ = new Locale("qq", "ZZ");

        // The first call here triggers the buggy NPE on Lang_57_buggy
        LocaleUtils.isAvailableLocale(LOCALE_EN);
        // Further calls exercise varied real locales from the test suite
        LocaleUtils.isAvailableLocale(LOCALE_EN_US);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US_ZZZZ);
        LocaleUtils.isAvailableLocale(LOCALE_FR);
        LocaleUtils.isAvailableLocale(LOCALE_FR_CA);
        LocaleUtils.isAvailableLocale(LOCALE_QQ);
        LocaleUtils.isAvailableLocale(LOCALE_QQ_ZZ);

        // EXPLORE: generate many varied inputs hitting the patched line via the real API
        int iterations = 1 + data.consumeInt(0, 32);
        Locale last = LOCALE_EN;
        for (int i = 0; i < iterations; i++) {
            Locale loc;
            if (data.consumeBoolean()) {
                // Include null as a valid input to isAvailableLocale
                loc = null;
            } else {
                String lang = data.consumeAsciiString(8);
                String country = data.consumeAsciiString(8);
                String variant = data.consumeAsciiString(8);
                // Use different constructors to vary length/positions/surrounding content
                switch (data.consumeInt(0, 2)) {
                    case 0:
                        loc = new Locale(lang == null ? "" : lang);
                        break;
                    case 1:
                        // Randomly upper-case the country to mimic real usage
                        if (data.consumeBoolean() && country != null) country = country.toUpperCase();
                        loc = new Locale(lang == null ? "" : lang, country == null ? "" : country);
                        break;
                    default:
                        if (data.consumeBoolean() && country != null) country = country.toUpperCase();
                        loc = new Locale(lang == null ? "" : lang, country == null ? "" : country, variant == null ? "" : variant);
                        break;
                }
            }
            LocaleUtils.isAvailableLocale(loc);
            if (loc != null) last = loc;
        }

        // METAMORPHIC CHECK: availableLocaleSet().contains(l) must equal isAvailableLocale(l)
        // Guarded to always use real library calls only
        java.util.Set set = LocaleUtils.availableLocaleSet();
        boolean expected = set.contains(last);
        boolean actual = LocaleUtils.isAvailableLocale(last);
        if (expected != actual) {
            throw new RuntimeException("metamorphic violation: availableLocaleSet().contains(locale) == isAvailableLocale(locale)");
        }
    }
}
