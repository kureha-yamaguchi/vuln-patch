        double eps = epsOptions[Math.abs(data.consumeInt()) % epsOptions.length];

        OpenMapRealVector a = new OpenMapRealVector(dim, eps);
        boolean[] present = new boolean[dim];

        // Populate 'a' with random entries, including some zeros.
        int nonZeroCount = 0;
        for (int i = 0; i < dim; i++) {
            boolean set = data.consumeBoolean();
            if (set) {
                // Generate a value in a reasonable range.
                double val = (double) data.consumeInt(-1000, 1000) / 10.0;
                // Occasionally force exact zero.
                if (data.consumeBoolean()) {
                    val = 0.0;
                }
                a.setEntry(i, val);
                present[i] = Math.abs(val) > eps;
                if (present[i]) {
                    nonZeroCount++;
                }
            }
        }
        if (nonZeroCount == 0) {
            // Ensure at least one non-zero entry to drive iterations.
            int idx = Math.abs(data.consumeInt()) % dim;
            a.setEntry(idx, 1.0);
            present[idx] = true;
            nonZeroCount = 1;
        }

        // Build a sparse vector 'b' that often has zeros where 'a' is non-zero to trigger removals on multiply.
        OpenMapRealVector b = new OpenMapRealVector(dim, eps);
        for (int i = 0; i < dim; i++) {
            double val;
            if (present[i] && data.consumeBoolean()) {
                val = 0.0; // likely removal when multiplying
            } else {
                val = (double) data.consumeInt(-1000, 1000) / 10.0;
            }
            b.setEntry(i, val);
        }

        // Build a dense array 'c' aligned with 'a' to trigger removals on multiply as well.
        double[] c = new double[dim];
        for (int i = 0; i < dim; i++) {
            double val;
            if (present[i] && data.consumeBoolean()) {
                val = 0.0; // removal when multiplying
            } else {
                val = (double) data.consumeInt(-1000, 1000) / 10.0;
            }
            c[i] = val;
        }

        // Drive through real API that hits doRemove via internal removals while iterating.
        // These calls may, on the buggy version, throw a concurrent modification exception.
        RealVector r1 = a.ebeMultiply(b);
        RealVector r2 = a.ebeMultiply(c);
        RealVector r3 = a.ebeDivide(b);
        RealVector r4 = a.ebeDivide(c);

        // Metamorphic check: multiplying by an all-ones dense vector should be an identity operation.
        // Use only library calls to validate: u - u .* ones has zero norm.
        double[] ones = new double[dim];
        for (int i = 0; i < dim; i++) {
            ones[i] = 1.0;
        }
        RealVector id = a.ebeMultiply(ones);
        double norm = id.subtract(a).getNorm();
        if (!Double.isNaN(norm) && !Double.isInfinite(norm) && norm != 0.0) {
            throw new RuntimeException("metamorphic violation: multiply by ones should be identity");
        }
    }
