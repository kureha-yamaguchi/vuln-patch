                // expected rejection for invalid numbers
            }
        }

        // EXPLORE: generate varied strings that end with 'l' or 'L' to exercise the patched branch
        int trials = 1;
        if (data.remainingBytes() > 0) {
            trials = data.consumeInt(1, 50);
        }
        for (int i = 0; i < trials; i++) {
            char suffix = data.consumeBoolean() ? 'l' : 'L';

            String prefix;
            if (data.consumeBoolean()) {
                // random ascii prefix (may contain '.', 'e', etc.)
                prefix = data.consumeAsciiString(40);
            } else {
                // sometimes enforce digit-heavy or empty prefixes
                if (data.consumeBoolean()) {
                    prefix = "";
                } else {
                    int len = data.consumeInt(0, 20);
                    StringBuilder sb = new StringBuilder();
                    if (len > 0 && data.consumeBoolean()) {
                        sb.append(data.consumeBoolean() ? '-' : '+');
                    }
                    for (int j = 0; j < len; j++) {
                        int d = Math.abs(data.consumeInt()) % 10;
                        sb.append((char) ('0' + d));
                    }
                    // optionally inject a single '.' or 'e' to vary dec/exp handling
                    if (data.consumeBoolean() && sb.length() > 0) {
                        int pos = data.consumeInt(0, sb.length());
                        char c = data.consumeBoolean() ? 'e' : '.';
                        sb.insert(pos, c);
                    }
                    prefix = sb.toString();
                }
            }

            String candidate = prefix + suffix;
            try {
                NumberUtils.createNumber(candidate);
            } catch (NumberFormatException expected) {
                // expected rejection for invalid numbers
            }
        }

        // METAMORPHIC CHECK: for any integer n, parsing "n" and "nL" should yield numerically equivalent results
        // Compare via toString() to avoid cross-type equality issues (Integer vs Long)
        int n = data.consumeInt();
        String base = Integer.toString(n);
        String withL = base + (data.consumeBoolean() ? "l" : "L");
        try {
            Number a = NumberUtils.createNumber(base);
            Number b = NumberUtils.createNumber(withL);
            if (a != null && b != null) {
                if (!a.toString().equals(b.toString())) {
                    throw new RuntimeException("metamorphic violation: createNumber(s).toString() != createNumber(s+'L').toString() for s=" + base);
                }
            }
        } catch (NumberFormatException e) {
            // For integer strings this should not occur; ignore if it does to avoid false positives.
        }
    }
