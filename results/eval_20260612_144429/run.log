package org.apache.commons.math.linear;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing test scenario
        {
            final RealVector u = new OpenMapRealVector(3, 1e-6);
            u.setEntry(0, 1);
            u.setEntry(1, 0);
            u.setEntry(2, 2);

            final RealVector v1 = new OpenMapRealVector(3, 1e-6);
            final double[] v2 = new double[3];
            v1.setEntry(0, 0);
            v2[0] = 0;
            v1.setEntry(1, 3);
            v2[1] = 3;
            v1.setEntry(2, 0);
            v2[2] = 0;

            RealVector w;
            w = u.ebeMultiply(v1);
            w = u.ebeMultiply(v2);

            w = u.ebeDivide(v1);
            w = u.ebeDivide(v2);
        }

        // EXPLORE: generate varied inputs that exercise setEntry on default values during ebeMultiply
        int n = data.consumeInt(1, 64);
        int expUEps = data.consumeInt(0, 12);
        int expVEps = data.consumeInt(0, 12);
        double uEps = Math.pow(10.0, -expUEps);
        double vEps = Math.pow(10.0, -expVEps);

        OpenMapRealVector u = new OpenMapRealVector(n, uEps);
        OpenMapRealVector vVec = new OpenMapRealVector(n, vEps);
        double[] vArr = new double[n];

        // Ensure at least one index where u is non-default and v is default (zero)
        int k = data.consumeInt(0, n - 1);
        double uValK = ((double) data.consumeInt(-1000, 1000)) / 10.0;
        if (Math.abs(uValK) < uEps) {
            uValK = (data.consumeBoolean() ? 1.0 : -1.0) * (uEps * 10.0 + 1.0);
        }
        u.setEntry(k, uValK);
        vVec.setEntry(k, 0.0);
        vArr[k] = 0.0;

        // Fill remaining entries with random values, sometimes default (to vary structure)
        for (int i = 0; i < n; i++) {
            if (i != k) {
                // Randomly set entries in u
                if (data.consumeBoolean()) {
                    double val = ((double) data.consumeInt(-1000, 1000)) / 10.0;
                    if (Math.abs(val) < uEps && data.consumeBoolean()) {
                        val = (val >= 0 ? 1.0 : -1.0) * (uEps * 10.0 + 1.0);
                    }
                    u.setEntry(i, val);
                }
                // Random values for v (vector and array must match)
                double vv = ((double) data.consumeInt(-1000, 1000)) / 10.0;
                if (data.consumeBoolean()) {
                    // Occasionally force a default entry in v to stress the path
                    double tiny = Math.abs(((double) data.consumeInt(0, 1000)) / 1e9);
                    if (tiny < vEps) {
                        vv = tiny;
                    }
                }
                vVec.setEntry(i, vv);
                vArr[i] = vv;
            }
        }

        RealVector w1 = u.ebeMultiply(vVec);
