package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {

    // Minimal, real-usage FormatFactory to enable ExtendedMessageFormat's custom parsing path.
    private static final class PassThroughFormat extends java.text.Format {
        private static final long serialVersionUID = 1L;
        @Override
        public StringBuffer format(Object obj, StringBuffer toAppendTo, java.text.FieldPosition pos) {
            if (obj != null) {
                toAppendTo.append(obj.toString());
            }
            return toAppendTo;
        }
        @Override
        public Object parseObject(String source, java.text.ParsePosition pos) {
            // Not used by this harness; return the full string.
            if (source == null) {
                pos.setIndex(0);
                return null;
            }
            pos.setIndex(source.length());
            return source;
        }
    }

    private static final class SimpleFactory implements org.apache.commons.lang.text.FormatFactory {
        @Override
        public java.text.Format getFormat(String name, String args, java.util.Locale locale) {
            // Always return a benign Format; we only need to activate the custom parsing path.
            return new PassThroughFormat();
        }
    }

    private static String sanitizeLiteral(String s, int maxLen) {
        if (s == null) return "";
        StringBuilder b = new StringBuilder(Math.min(maxLen, s.length()));
        for (int i = 0; i < s.length() && b.length() < maxLen; i++) {
            char ch = s.charAt(i);
            // Keep a simple subset to avoid mismatched braces/quotes in random fuzz.
            if ((ch >= 'A' && ch <= 'Z') ||
                (ch >= 'a' && ch <= 'z') ||
                (ch >= '0' && ch <= '9') ||
                ch == ' ' || ch == '.' || ch == ',' || ch == '!' || ch == '?') {
                b.append(ch);
            }
        }
        return b.toString();
    }

