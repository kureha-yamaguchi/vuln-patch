package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Local class to emulate an element whose toString() returns null (as in the failing test)
        class NullToString {
            @Override
            public String toString() {
                return null;
            }
        }

        // ANCHOR: Mirror the failing test calls to reliably trigger the original bug.
        // 1) Equivalent to: assertEquals(null, StringUtils.join((Object[]) null, ','));
        StringUtils.join((Object[]) null, ',');
        // 2) Equivalent to: assertEquals("null", StringUtils.join(NULL_TO_STRING_LIST,'/', 0, 1));
        Object[] anchorArr = new Object[] { new NullToString() };
        StringUtils.join(anchorArr, '/', 0, 1);
        // Also exercise the String-separator overload on the same anchored input.
        StringUtils.join(anchorArr, "/", 0, 1);

        // EXPLORE: Generate varied inputs that exercise the root cause:
        // when array[startIndex].toString() returns null (or other edge cases).
        boolean useNullArray = data.consumeBoolean();
        if (useNullArray) {
            // Null array should return null cleanly.
            char sepChar = (char) data.consumeInt(0, 65535);
            String sepStr = data.consumeBoolean() ? null : data.consumeString(5);
            String res1 = StringUtils.join((Object[]) null, sepChar, 0, 0);
            String res2 = StringUtils.join((Object[]) null, String.valueOf(sepChar), 0, 0);
            if ((res1 == null && res2 != null) || (res1 != null && !res1.equals(res2))) {
                throw new RuntimeException("metamorphic violation: char vs string separator equivalence (null array)");
            }
            // Also call with random indices that won't be used (method returns early for null array).
            StringUtils.join((Object[]) null, sepStr, data.consumeInt(), data.consumeInt());
            return;
        }

        int n = data.consumeInt(0, 16);
        Object[] arr = new Object[n];

        // Optionally ensure at least one element has toString() == null.
        boolean includeNullToString = n > 0 && data.consumeBoolean();
        int nullToStringIndex = -1;
        if (includeNullToString) {
            nullToStringIndex = data.consumeInt(0, n - 1);
            arr[nullToStringIndex] = new NullToString();
        }

        // Populate remaining elements with a mix of types, including nulls and normal strings/objects.
        for (int i = 0; i < n; i++) {
            if (arr[i] != null) {
                continue;
            }
            int choice = data.consumeInt(0, 4);
            switch (choice) {
                case 0:
                    arr[i] = null;
                    break;
                case 1:
                    arr[i] = data.consumeString(20);
                    break;
                case 2:
                    arr[i] = new Object(); // Object.toString() is non-null
                    break;
                case 3:
                    arr[i] = new NullToString();
                    break;
                default:
                    arr[i] = data.consumeAsciiString(20);
                    break;
            }
        }

        // Choose valid start/end indices, often aligning start with a NullToString element to hit the original bug.
        int start;
        int end;
        if (n == 0) {
            start = 0;
            end = 0;
        } else {
            boolean alignWithNullToString = includeNullToString && data.consumeBoolean();
            if (alignWithNullToString) {
                start = nullToStringIndex;
            } else {
                start = data.consumeInt(0, n);
            }
            if (start == n) {
                end = n;
            } else {
                end = data.consumeInt(start, n);
            }
        }

        // Separators
        char sepChar = (char) data.consumeInt(0, 65535);
        String sepStr = data.consumeBoolean() ? null : data.consumeString(5);

        // Exercise both overloads with fuzzed input.
        StringUtils.join(arr, sepChar, start, end);
        StringUtils.join(arr, sepStr, start, end);

        // Metamorphic check: joining with a char separator must equal joining with the equivalent 1-char String separator.
        String r1 = StringUtils.join(arr, sepChar, start, end);
        String r2 = StringUtils.join(arr, String.valueOf(sepChar), start, end);
        if ((r1 == null && r2 != null) || (r1 != null && !r1.equals(r2))) {
            throw new RuntimeException("metamorphic violation: char vs string separator equivalence");
        }
    }
}
