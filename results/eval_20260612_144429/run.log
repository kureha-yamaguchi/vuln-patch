            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);

            // Metamorphic check: unescape(escape(s)) == s
            String roundTrip = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);
            if (!s.equals(roundTrip)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(s)) != s");
            }

