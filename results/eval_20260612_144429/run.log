            StringEscapeUtils.escapeCsv(s);
        }

        // Build fuzzed input with surrogate pairs and varied content
        String prefix = data.consumeAsciiString(50);
        String suffix = data.consumeAsciiString(50);

        int pairs = 1 + (Math.abs(data.consumeInt()) % 4); // ensure at least one surrogate pair
        StringBuilder sb = new StringBuilder();
        sb.append(prefix);

        for (int i = 0; i < pairs; i++) {
            String pair;
            if (data.consumeBoolean()) {
                switch (data.consumeInt(0, 3)) {
                    case 0: pair = "\uD83D\uDE30"; break;
                    case 1: pair = "\uD800\uDC00"; break;
