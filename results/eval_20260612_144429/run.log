package org.joda.time;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    private static int maxDomForMonth(int m) {
        switch (m) {
            case 2:
                return 29; // allow leap-day exploration
            case 4:
            case 6:
            case 9:
            case 11:
                return 30;
            default:
                return 31;
        }
    }

