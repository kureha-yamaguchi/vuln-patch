package org.apache.commons.lang3;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: mirror the failing test input that triggered the NPE in the buggy version
        // Do not catch NullPointerException here; let genuine defects propagate.
        StringUtils.replaceEach("aba", new String[]{"a", "b"}, new String[]{"c", null});

        // EXPLORE: generate varied inputs where either array may contain null elements,
        // ensuring we exercise the patched path through the real public API.
        int rounds = data.consumeInt(1, 3);
        for (int r = 0; r < rounds; r++) {
            String text = data.consumeBoolean() ? null
                    : (data.consumeBoolean() ? data.consumeAsciiString(256) : data.consumeString(256));

            int len = data.consumeInt(0, 6);
            String[] search = new String[len];
            String[] repl = new String[len];

            for (int i = 0; i < len; i++) {
                search[i] = data.consumeBoolean() ? null
                        : (data.consumeBoolean() ? data.consumeAsciiString(16) : data.consumeString(16));
                repl[i] = data.consumeBoolean() ? null
                        : (data.consumeBoolean() ? data.consumeAsciiString(16) : data.consumeString(16));
            }

            try {
                StringUtils.replaceEach(text, search, repl);
            } catch (IllegalArgumentException | IllegalStateException expected) {
                // Documented validation failures (e.g., mismatched array lengths); not a bug.
            }
        }

        // METAMORPHIC CHECK: Idempotence under identity mapping.
        // If search[i] == replacement[i] for all i, replaceEach should be a no-op,
        // hence applying it twice equals applying it once.
        String metaText = data.consumeBoolean() ? data.consumeAsciiString(128) : data.consumeString(128);
        int m = data.consumeInt(0, 6);
        String[] from = new String[m];
        String[] to = new String[m];
        for (int i = 0; i < m; i++) {
            String token = data.consumeBoolean() ? data.consumeAsciiString(8) : data.consumeString(8);
            if (token == null) {
                token = ""; // FuzzedDataProvider won't return null, but guard defensively.
            }
            from[i] = token;
            to[i] = token;
        }
        String once = StringUtils.replaceEach(metaText, from, to);
        String twice = StringUtils.replaceEach(once, from, to);
        if ((once == null && twice != null) || (once != null && !once.equals(twice))) {
            throw new RuntimeException("metamorphic violation: idempotence with identity mapping");
        }
    }
}
