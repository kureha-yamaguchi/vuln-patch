package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import java.util.Locale;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact inputs from the failing test
        Locale LOCALE_EN = new Locale("en");
        Locale LOCALE_EN_US = new Locale("en", "US");
        Locale LOCALE_EN_US_ZZZZ = new Locale("en", "US", "ZZZZ");
        Locale LOCALE_FR = new Locale("fr");
        Locale LOCALE_FR_CA = new Locale("fr", "CA");
        Locale LOCALE_QQ = new Locale("qq");
        Locale LOCALE_QQ_ZZ = new Locale("qq", "ZZ");

        // Trigger the buggy behavior: call isAvailableLocale before touching availableLocaleList/Set
        LocaleUtils.isAvailableLocale(LOCALE_EN);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US);
        LocaleUtils.isAvailableLocale(LOCALE_EN_US_ZZZZ);
        LocaleUtils.isAvailableLocale(LOCALE_FR);
        LocaleUtils.isAvailableLocale(LOCALE_FR_CA);
        LocaleUtils.isAvailableLocale(LOCALE_QQ);
        LocaleUtils.isAvailableLocale(LOCALE_QQ_ZZ);

        // EXPLORE: generate varied Locales and exercise the real API
        int n = data.consumeInt(1, 30);
        Locale last = null;
        for (int i = 0; i < n; i++) {
            String lang = data.consumeAsciiString(8);
            String country = data.consumeAsciiString(8);
            String variant = data.consumeAsciiString(16);
            if (lang == null) lang = "";
            if (country == null) country = "";
            if (variant == null) variant = "";

            int choice = data.consumeInt(0, 2);
            Locale loc;
            if (choice == 0) {
                loc = new Locale(lang);
            } else if (choice == 1) {
                loc = new Locale(lang, country);
            } else {
                loc = new Locale(lang, country, variant);
            }
            last = loc;

            boolean apiRes = LocaleUtils.isAvailableLocale(loc);

            // Occasionally cross-check against list membership during exploration
            if (data.consumeBoolean()) {
                boolean listHas = LocaleUtils.availableLocaleList().contains(loc);
                if (apiRes != listHas) {
                    throw new RuntimeException("metamorphic violation: isAvailableLocale vs availableLocaleList().contains");
                }
            }
        }

        // METAMORPHIC CHECK: set.contains(locale) == isAvailableLocale(locale)
        Locale testLocale = last != null ? last : LOCALE_EN;
        boolean fromSet = LocaleUtils.availableLocaleSet().contains(testLocale);
        boolean viaAPI = LocaleUtils.isAvailableLocale(testLocale);
        if (fromSet != viaAPI) {
            throw new RuntimeException("metamorphic violation: availableLocaleSet().contains != isAvailableLocale");
        }
    }
}
