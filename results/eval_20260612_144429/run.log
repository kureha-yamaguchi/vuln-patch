public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // Anchor: exact failing test inputs
        String[] anchors = new String[] {
            "\uD83D\uDE30",
            "\uD800\uDC00",
            "\uD834\uDD1E",
            "\uDBFF\uDFFD"
        };
        for (String a : anchors) {
            String escaped = StringEscapeUtils.escapeCsv(a);
            String unescaped = StringEscapeUtils.unescapeCsv(escaped);
            if (!a.equals(unescaped)) {
                throw new RuntimeException("metamorphic violation: unescape(escape(x)) != x (anchor)");
            }
        }

        // Explore: random supplementary code point alone
        int sup = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
        // Guard against invalid code points above U+10FFFF (consumeInt upper bound is inclusive and safe here)
        if (sup <= 0x10FFFF) {
            String supStr = new String(Character.toChars(sup));
            String e = StringEscapeUtils.escapeCsv(supStr);
            String u = StringEscapeUtils.unescapeCsv(e);
            if (!supStr.equals(u)) {
                throw new RuntimeException("metamorphic violation: unescape(escape(x)) != x (single supplementary)");
            }
        }

        // Explore: fuzzed strings with supplementary code points and optional CSV-special chars
        int iterations = data.consumeInt(1, 5);
        for (int i = 0; i < iterations; i++) {
            // Base string (may contain any Unicode, including random surrogates)
            String base = data.consumeString(64);
            if (base == null) {
                base = "";
            }

            // Insert at least one supplementary code point
            int cp = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
            if (cp > 0x10FFFF) {
                cp = 0x10FFFF;
            }
            String cpStr = new String(Character.toChars(cp));

            String s;
            if (data.consumeBoolean()) {
                s = cpStr + base;
            } else {
                s = base + cpStr;
            }

            // Optionally sprinkle more supplementary code points
            int extraSupCount = data.consumeInt(0, 3);
            for (int k = 0; k < extraSupCount; k++) {
                int cp2 = 0x10000 + data.consumeInt(0, 0x10FFFF - 0x10000);
                if (cp2 > 0x10FFFF) {
                    cp2 = 0x10FFFF;
                }
                String cpStr2 = new String(Character.toChars(cp2));
                if (data.consumeBoolean()) {
                    s = cpStr2 + s;
                } else {
                    s = s + cpStr2;
                }
            }

            // Optionally insert a CSV-special character to force the translator to consume > 0 at index 0
            if (data.consumeBoolean()) {
                char[] specials = new char[] { ',', '"', '\r', '\n' };
                char sc = specials[data.consumeInt(0, specials.length - 1)];
                int idx = s.length() == 0 ? 0 : data.consumeInt(0, s.length());
                String before = idx <= 0 ? "" : s.substring(0, Math.min(idx, s.length()));
                String after = idx >= s.length() ? "" : s.substring(Math.min(idx, s.length()));
                s = before + sc + after;
            }

            // Drive the real API and enforce round-trip metamorphic relation
            String escaped = StringEscapeUtils.escapeCsv(s);
            String unescaped = StringEscapeUtils.unescapeCsv(escaped);
            if (!s.equals(unescaped)) {
                throw new RuntimeException("metamorphic violation: unescape(escape(x)) != x");
            }
        }
    }
}
