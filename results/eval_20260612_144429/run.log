                    intPart = "0";
                }
                StringBuilder sb = new StringBuilder();
                if (negative) {
                    sb.append('-');
                }
                sb.append(intPart);
                if (includeDot) {
                    sb.append('.');
                    sb.append(fracPart);
                }
                boolean includeExp = data.consumeBoolean();
                if (includeExp) {
                    char eChar = data.consumeBoolean() ? 'e' : 'E';
                    sb.append(eChar);
                    if (data.consumeBoolean()) {
                        sb.append(data.consumeBoolean() ? '+' : '-');
                    }
                    String expDigits = consumeDigits(data, data.consumeInt(0, 6));
                    if (expDigits.isEmpty()) {
