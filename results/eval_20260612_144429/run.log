            StringEscapeUtils.escapeCsv("\uD800\uDC00"); // U+10000
            StringEscapeUtils.escapeCsv("\uD834\uDD1E"); // U+1D11E
            StringEscapeUtils.escapeCsv("\uDBFF\uDFFD"); // U+10FFD
        } catch (IllegalArgumentException expected) {
            // Clean API rejection (not the bug); stop this fuzz iteration
            return;
        }

        // Explore: generate varied inputs that contain at least one surrogate pair
        int iterations = 1;
        try {
            iterations = 1 + Math.floorMod(data.consumeInt(), 3); // 1..3
        } catch (Throwable t) {
            // Fallback to 1 iteration on any unexpected issue with the fuzzer input
            iterations = 1;
        }

        String lastInputForCheck = null;
        for (int it = 0; it < iterations; it++) {
            StringBuilder sb = new StringBuilder();

            int pairs = 1 + Math.floorMod(data.consumeInt(), 4); // ensure at least one supplementary code point
            for (int i = 0; i < pairs; i++) {
                // Prefix ASCII noise
                int asciiLen = data.consumeInt(0, 16);
                sb.append(data.consumeAsciiString(asciiLen));

                // Sprinkle CSV-significant characters to vary behavior
                if (data.consumeBoolean()) sb.append(',');
                if (data.consumeBoolean()) sb.append('"');
                if (data.consumeBoolean()) sb.append('\n');

                // Append one supplementary code point (guarantees at least one surrogate pair)
                int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
                sb.append(Character.toChars(cp));
            }

            // Trailing ASCII
            int tailLen = data.consumeInt(0, 16);
            sb.append(data.consumeAsciiString(tailLen));

            String s = sb.toString();

            try {
                // Drive through the real public API
                StringEscapeUtils.escapeCsv(s);
            } catch (IllegalArgumentException expected) {
                // Cleanly rejected input; skip to next
                continue;
            }

            lastInputForCheck = s;
        }

        // Metamorphic check: unescape(escape(s)) == s
        if (lastInputForCheck != null) {
            String escaped;
            try {
                escaped = StringEscapeUtils.escapeCsv(lastInputForCheck);
            } catch (IllegalArgumentException expected) {
                // Clean rejection; treat as non-bug for this input
                return;
            }

            String roundTripped;
            try {
                roundTripped = StringEscapeUtils.unescapeCsv(escaped);
            } catch (IllegalArgumentException expected) {
                // Unescape shouldn't reject the output of escape; signal a violation
                throw new RuntimeException("metamorphic violation: unescape rejected escape output");
            }

            if (roundTripped != null && !roundTripped.equals(lastInputForCheck)) {
                throw new RuntimeException("metamorphic violation: unescape(escape(s)) != s");
            }
        }
    }
}
