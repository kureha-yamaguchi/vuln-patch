package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact input property from tests: LOCALE_EN ~ new Locale("en", "")
        java.util.Locale anchorLocale = new java.util.Locale("en", "");
        // Buggy version throws NPE here before any availableLocaleSet/list initialization.
        boolean anchor = LocaleUtils.isAvailableLocale(anchorLocale);

        // EXPLORE: generate many different Locales and exercise isAvailableLocale
        java.util.Locale chosen = anchorLocale;
        int iterations = data.consumeInt(0, 30);
        for (int i = 0; i < iterations; i++) {
            if (data.consumeBoolean()) {
                // Use LocaleUtils.toLocale on varied strings
                String s;
                if (data.consumeBoolean()) {
                    // Construct likely-valid 1/2/3-part forms
                    int parts = data.consumeInt(1, 3);
                    if (parts == 1) {
                        s = randomLowerLetters(data, 2);
                    } else if (parts == 2) {
                        s = randomLowerLetters(data, 2) + "_" + randomUpperLetters(data, 2);
                    } else {
                        s = randomLowerLetters(data, 2) + "_" + randomUpperLetters(data, 2) + "_" + randomAlphaNum(data, 1, 8);
                    }
                } else {
                    // Random ASCII, often invalid, to hit rejection paths
                    s = data.consumeAsciiString(20);
                }
                try {
                    java.util.Locale loc = LocaleUtils.toLocale(s);
                    if (loc != null) {
                        LocaleUtils.isAvailableLocale(loc);
                        chosen = loc;
                    }
                } catch (IllegalArgumentException ignored) {
                    // Expected rejection for ill-formed locale strings; ignore.
                }
            } else {
                // Construct Locales via constructors with varied components
                int ctor = data.consumeInt(1, 3);
                String lang = data.consumeBoolean() ? randomLowerLetters(data, 2) : data.consumeAsciiString(5);
                String country = data.consumeBoolean() ? randomUpperLetters(data, 2) : data.consumeAsciiString(4);
                String variant = data.consumeAsciiString(6);
                java.util.Locale loc;
                if (ctor == 1) {
                    loc = new java.util.Locale(lang);
                } else if (ctor == 2) {
                    loc = new java.util.Locale(lang, country);
                } else {
                    loc = new java.util.Locale(lang, country, variant);
                }
                LocaleUtils.isAvailableLocale(loc);
                chosen = loc;
            }
        }

        // METAMORPHIC CHECK: membership via availableLocaleSet must match isAvailableLocale
        boolean setContains = LocaleUtils.availableLocaleSet().contains(chosen);
        boolean apiContains = LocaleUtils.isAvailableLocale(chosen);
        if (setContains != apiContains) {
            throw new RuntimeException("metamorphic violation: isAvailableLocale vs availableLocaleSet.contains");
        }
    }

    private static String randomLowerLetters(FuzzedDataProvider data, int len) {
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            c[i] = (char) ('a' + data.consumeInt(0, 25));
        }
        return new String(c);
    }

    private static String randomUpperLetters(FuzzedDataProvider data, int len) {
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            c[i] = (char) ('A' + data.consumeInt(0, 25));
        }
        return new String(c);
    }

    private static String randomAlphaNum(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            if (data.consumeBoolean()) {
                c[i] = (char) ('a' + data.consumeInt(0, 25));
            } else if (data.consumeBoolean()) {
                c[i] = (char) ('A' + data.consumeInt(0, 25));
            } else {
                c[i] = (char) ('0' + data.consumeInt(0, 9));
            }
        }
        return new String(c);
    }
}
