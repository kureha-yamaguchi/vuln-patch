package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang3.StringEscapeUtils;

public class FuzzHarness {
    private static String cpToString(int cp) {
        if (cp < 0x10000) {
            cp = 0x10000;
        } else if (cp > 0x10FFFF) {
            cp = 0x10FFFF;
        }
        return new String(Character.toChars(cp));
    }

    private static String randomSupplementaryPair(FuzzedDataProvider data) {
        int span = 0x10FFFF - 0x10000 + 1;
        int rnd = data.consumeInt();
        int cp = 0x10000 + Math.abs(rnd % span);
        return cpToString(cp);
    }

    private static String buildCsvLikeString(FuzzedDataProvider data) {
        StringBuilder sb = new StringBuilder();
        // Optionally start with a supplementary code point (to target surrogate-pair handling).
        if (data.consumeBoolean()) {
            sb.append(randomSupplementaryPair(data));
        }
        // Insert random ASCII before potential CSV specials.
        sb.append(data.consumeAsciiString(20));

        // Optionally inject CSV special characters that force the CSV escaper to process the whole input.
        if (data.consumeBoolean()) {
            char[] specials = new char[] { ',', '"', '\r', '\n' };
            int count = data.consumeInt(0, 4);
            for (int i = 0; i < count; i++) {
                sb.append(specials[data.consumeInt(0, specials.length - 1)]);
                // Surround specials with possible supplementary pairs to vary positions.
                if (data.consumeBoolean()) {
                    sb.append(randomSupplementaryPair(data));
                }
            }
        }

        // Optionally end with a supplementary code point.
        if (data.consumeBoolean()) {
            sb.append(randomSupplementaryPair(data));
        }
        // And some trailing ASCII.
        sb.append(data.consumeAsciiString(20));
        return sb.toString();
    }

    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
