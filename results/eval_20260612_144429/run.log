                Double baseX = Double.valueOf((double) data.consumeInt());
                Double y1 = Double.valueOf((double) data.consumeInt());
                s.addOrUpdate(baseX, y1);

                int extra = 0;
                if (data.remainingBytes() > 0) {
                    extra = data.consumeInt(0, 5);
                }
                for (int j = 0; j < extra; j++) {
                    Double xj = Double.valueOf((double) data.consumeInt());
                    Double yj = Double.valueOf((double) data.consumeInt());
                    s.addOrUpdate(xj, yj);
                }

                Double y2 = Double.valueOf((double) data.consumeInt());
                s.addOrUpdate(baseX, y2);

                int count = s.getItemCount();
