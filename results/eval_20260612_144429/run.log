                // Ensure at least one more duplicate insert to exercise the patched path.
                Number yDup = new Double(data.consumeInt());
                s.addOrUpdate(x0, yDup);

                // Lightly exercise read APIs.
                int count = s.getItemCount();
                if (count > 0) {
                    s.getX(0);
                    s.getY(0);
                    s.getX(count - 1);
                    s.getY(count - 1);
