package org.apache.commons.lang.text;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;
import org.apache.commons.lang.StringUtils;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing test input
        StrBuilder anchor = new StrBuilder(1);
        anchor.appendFixedWidthPadRight("foo", 1, '-');

        // EXPLORE: generate varied real inputs exercising the same path
        int iterations = 1 + data.consumeInt(0, 10);
        for (int i = 0; i < iterations; i++) {
            // width can be zero or positive; method is a no-op for <=0
            int width = data.consumeInt(0, 256);
            char padChar = (char) (data.consumeByte() & 0xFF);

            // Decide initial capacity to stress ensureCapacity; often set to <= width
            int initCapChoice = data.consumeInt(0, 3);
            int initCap;
            switch (initCapChoice) {
                case 0:
                    initCap = width; // classic trigger case when strLen > width
                    break;
                case 1:
                    initCap = 0; // force growth to exactly 'width'
                    break;
                case 2:
                    initCap = data.consumeInt(0, Math.max(1, width)); // small capacity
                    break;
                default:
                    initCap = data.consumeInt(0, 512); // arbitrary
                    break;
            }
            StrBuilder sb = new StrBuilder(initCap);

            // Optionally prefill builder to vary 'size' and destinationIndex
            if (data.consumeBoolean()) {
                String prefix = data.consumeString(128);
                if (prefix != null) {
                    sb.append(prefix);
                }
            }

            // Possibly pass null; ensure nullText is set so null input is representable
            boolean passNull = data.consumeBoolean();
            if (passNull) {
                String nt = data.consumeAsciiString(8);
                if (nt == null) nt = "NULL";
                sb.setNullText(nt);
            }
            String s = passNull ? null : data.consumeString(512);

            // To deliberately exercise the bug path sometimes, ensure strLen >= width
            if (width > 0 && s != null && data.consumeBoolean()) {
                if (s.length() > 0) {
                    width = Math.min(width, Math.max(1, data.consumeInt(1, s.length())));
                }
            }

            sb.appendFixedWidthPadRight(s, width, padChar);
        }

        // METAMORPHIC CHECK:
        // For width > 0 and using sb's nullText resolution, result must equal
        // left(str, width) if strLen >= width, else rightPad(str, width, padChar).
        {
            int initCap = data.consumeInt(0, 16);
            StrBuilder sbM = new StrBuilder(initCap);
            // Ensure nulls are representable
            sbM.setNullText("NULL");
            String sM = data.consumeString(128);
            int wM = data.consumeInt(1, 128); // only positive widths for the relation
            char cM = (char) (data.consumeByte() & 0xFF);

            sbM.appendFixedWidthPadRight(sM, wM, cM);
            String result = sbM.toString();

            String sResolved = (sM == null ? sbM.getNullText() : sM);
            String expected;
            if (sResolved.length() >= wM) {
                expected = StringUtils.left(sResolved, wM);
            } else {
                expected = StringUtils.rightPad(sResolved, wM, cM);
            }
            if (!result.equals(expected)) {
                throw new RuntimeException("metamorphic violation: appendFixedWidthPadRight != left/rightPad equivalence");
            }
        }
    }
}
