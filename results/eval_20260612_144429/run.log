                if (prefix != null) {
                    sb.append(prefix);
                }
            }

            String s = data.consumeString(64);
            if (s == null) {
                s = "";
            }
            int width = data.consumeInt(1, 8);
            String padStr = data.consumeAsciiString(1);
            char pad = padStr.length() > 0 ? padStr.charAt(0) : ' ';

            // Ensure we frequently exercise the buggy branch (strLen > width)
            if (s.length() <= width) {
                int target = width + 1 + data.consumeInt(0, 10);
