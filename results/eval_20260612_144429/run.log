            } else {
                char hi = (char) data.consumeInt(0xD800, 0xDBFF);
                char lo = (char) data.consumeInt(0xDC00, 0xDFFF);
                pair = new String(new char[] { hi, lo });
            }
            sb.append(pair);
            if (data.consumeBoolean()) {
                char[] extras = new char[] { ',', '"', '\n', '\r' };
                sb.append(extras[data.consumeInt(0, extras.length - 1)]);
            }
            if (data.consumeBoolean()) {
