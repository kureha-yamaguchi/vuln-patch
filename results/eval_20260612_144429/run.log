package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing inputs from the test
        String[] anchors = {
            "\uD83D\uDE30", // U+1F630
            "\uD800\uDC00", // U+10000
            "\uD834\uDD1E", // U+1D11E
            "\uDBFF\uDFFD"  // Near U+10FFD
        };
        for (String s : anchors) {
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
            String unescaped = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);
            if (unescaped != null && !unescaped.equals(s)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(anchor)) != anchor");
            }
        }

        // EXPLORE: fuzz diverse strings that include surrogate pairs and CSV specials
        int cases = 1 + Math.abs(data.consumeInt()) % 5; // 1..5 exploratory cases
        for (int t = 0; t < cases; t++) {
            int maxUnits = 1 + Math.abs(data.consumeInt()) % 200; // up to ~200 code units
            StringBuilder sb = new StringBuilder(maxUnits);

            // Ensure at least one surrogate pair is present to exercise code point handling
            boolean insertedPair = false;

            int units = 0;
            while (units < maxUnits) {
                int choice = Math.abs(data.consumeInt()) % 8;
                switch (choice) {
                    case 0: // ASCII chunk
                    case 1: {
                        String chunk = data.consumeAsciiString(Math.min(16, maxUnits - units));
                        sb.append(chunk);
                        units += chunk.length();
                        break;
                    }
                    case 2: // comma
                        sb.append(',');
                        units += 1;
                        break;
                    case 3: // quote
                        sb.append('"');
                        units += 1;
                        break;
                    case 4: // newline
                        sb.append('\n');
                        units += 1;
                        break;
                    case 5: // carriage return
                        sb.append('\r');
                        units += 1;
                        break;
                    case 6: // random BMP char (excluding surrogates)
                    {
                        int ch;
                        do {
                            ch = Math.abs(data.consumeInt()) % 0x10000;
                        } while (ch >= 0xD800 && ch <= 0xDFFF); // skip surrogate code units
                        sb.append((char) ch);
                        units += 1;
                        break;
                    }
                    case 7: // supplementary code point (valid surrogate pair)
                    default: {
                        if (units + 2 > maxUnits) {
                            // not enough space left for a pair; fall back to simple char
                            sb.append('a');
                            units += 1;
                            break;
                        }
                        int cp = 0x10000 + (Math.abs(data.consumeInt()) % (0x10FFFF - 0x10000 + 1));
                        char[] pair = Character.toChars(cp);
                        sb.append(pair);
                        units += pair.length;
                        insertedPair = true;
                        break;
                    }
                }
            }

            // As an additional nudge, optionally insert a supplementary code point at a random position if none yet
            if (!insertedPair && sb.length() + 2 <= maxUnits) {
                int cp = 0x10000 + (Math.abs(data.consumeInt()) % (0x10FFFF - 0x10000 + 1));
                char[] pair = Character.toChars(cp);
                int pos = sb.length() == 0 ? 0 : Math.abs(data.consumeInt()) % (sb.length() + 1);
                sb.insert(pos, pair);
                insertedPair = true;
            }

            String s = sb.toString();

            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
            String unescaped = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);

            // Metamorphic property: unescapeCsv(escapeCsv(s)) == s
            if (unescaped != null && !unescaped.equals(s)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(s)) != s");
            }
        }
    }
}
