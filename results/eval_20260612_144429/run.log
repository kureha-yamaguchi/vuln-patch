            }

            // Drive the real API to the patched line.
            boolean res = LocaleUtils.isAvailableLocale(loc);

            // Occasionally also test null input.
            if (data.consumeBoolean()) {
                LocaleUtils.isAvailableLocale(null);
            }
        }

        // METAMORPHIC CHECK:
        // For any locale L, isAvailableLocale(L) must equal availableLocaleList().contains(L).
        // This holds for correct implementations; differences indicate a logic bug.
        Locale mm = new Locale(randomLanguage(data), randomCountry(data), randomVariant(data));
        boolean lhs = LocaleUtils.availableLocaleList().contains(mm);
        boolean rhs = LocaleUtils.isAvailableLocale(mm);
        if (lhs != rhs) {
            throw new RuntimeException("metamorphic violation: isAvailableLocale(L) != availableLocaleList().contains(L)");
        }
    }

    private static String randomLanguage(FuzzedDataProvider data) {
        // Common forms: "", 2-letter, 3-letter, or random 1..8 lowercase letters.
        int choice = data.consumeInt(0, 3);
        int len;
        switch (choice) {
            case 0: return "";
            case 1: len = 2; break;
            case 2: len = 3; break;
            default: len = data.consumeInt(1, 8); break;
        }
        return lettersLower(data, len);
    }

    private static String randomCountry(FuzzedDataProvider data) {
        // Common forms: "", 2-letter uppercase country code.
        if (!data.consumeBoolean()) {
            return "";
        }
        return lettersUpper(data, 2);
    }

    private static String randomVariant(FuzzedDataProvider data) {
        // Allow empty or up to 8 mixed-case letters as variant.
        int len = data.consumeInt(0, 8);
        if (len == 0) return "";
        return lettersMixed(data, len);
    }

    private static String lettersLower(FuzzedDataProvider data, int len) {
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            int v = data.consumeByte() & 0xFF;
            c[i] = (char) ('a' + (v % 26));
        }
        return new String(c);
    }

    private static String lettersUpper(FuzzedDataProvider data, int len) {
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            int v = data.consumeByte() & 0xFF;
            c[i] = (char) ('A' + (v % 26));
        }
        return new String(c);
    }

    private static String lettersMixed(FuzzedDataProvider data, int len) {
        char[] c = new char[len];
        for (int i = 0; i < len; i++) {
            int v = data.consumeByte() & 0xFF;
            int mode = v % 3;
            if (mode == 0) {
                c[i] = (char) ('a' + (v % 26));
            } else if (mode == 1) {
                c[i] = (char) ('A' + (v % 26));
            } else {
                c[i] = (char) ('0' + (v % 10));
            }
        }
        return new String(c);
    }
}
