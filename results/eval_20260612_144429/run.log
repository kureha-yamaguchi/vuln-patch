public class FuzzHarness {
    private static double toDoubleRange(FuzzedDataProvider data, double min, double max, int scale) {
        if (max < min) {
            double t = min;
            min = max;
            max = t;
        }
        int sMin = (int) Math.round(min * scale);
        int sMax = (int) Math.round(max * scale);
        int v = data.consumeInt(sMin, Math.max(sMin, sMax));
        return v / (double) scale;
    }

    private static double nonNegativeDouble(FuzzedDataProvider data, double max) {
        if (max < 0) {
            max = 0;
        }
        return toDoubleRange(data, 0.0, max, 10);
    }

    private static boolean approxEq(double a, double b) {
        double diff = Math.abs(a - b);
        double scale = Math.max(1.0, Math.max(Math.abs(a), Math.abs(b)));
        return diff <= 1e-9 * scale;
    }

