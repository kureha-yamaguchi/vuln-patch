package org.apache.commons.lang;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing-test inputs first
        String[] badInputs = new String[] { "l", "L", "f", "F", "junk", "bobL" };
        for (String s : badInputs) {
            try {
                NumberUtils.createNumber(s);
            } catch (NumberFormatException expected) {
                // Clean rejection on fixed version; ignore.
            }
        }

        // EXPLORE: generate many variants focusing on 'l'/'L' suffix behavior
        int iterations = 1 + data.consumeInt(0, 32);
        for (int i = 0; i < iterations; i++) {
            char suffix = data.consumeBoolean() ? 'l' : 'L';
            int pattern = data.consumeInt(0, 6);
            String base;
            switch (pattern) {
                case 0:
                    // Empty mantissa (root cause when combined with 'l'/'L')
                    base = "";
                    break;
                case 1:
                    // Digits only
                    base = randomDigits(data, 1, 32);
                    break;
                case 2:
                    // Optional minus with optional digits
                    if (data.consumeBoolean()) {
                        base = "-" + randomDigits(data, 1, 32);
                    } else {
                        base = "-";
                    }
                    break;
                case 3:
                    // Random ASCII
                    base = data.consumeAsciiString(32);
                    break;
                case 4:
                    // Decimal form
                    String before = randomDigitsAllowEmpty(data, 0, 16);
                    String after = randomDigitsAllowEmpty(data, 0, 16);
                    String sign = data.consumeBoolean() ? "-" : "";
                    base = sign + before + "." + after;
                    break;
                case 5:
                    // Exponent form
                    String mant = randomDigitsAllowEmpty(data, 0, 16);
                    String e = data.consumeBoolean() ? "e" : "E";
                    String expSign = data.consumeBoolean() ? "-" : "";
                    String expDigits = randomDigitsAllowEmpty(data, 0, 8);
                    String sign2 = data.consumeBoolean() ? "-" : "";
                    base = sign2 + mant + e + expSign + expDigits;
                    break;
                case 6:
                default:
                    // Hex-like form
                    String hx = data.consumeBoolean() ? "-0x" : "0x";
                    base = hx + randomHexDigits(data, 1, 16);
                    break;
            }
            String candidate = base + suffix;
            try {
                NumberUtils.createNumber(candidate);
            } catch (NumberFormatException expected) {
                // Clean rejection; ignore.
            }
        }

        // METAMORPHIC CHECK: 'l' vs 'L' suffix should yield same numeric value for any int n
        String intStr = Integer.toString(data.consumeInt());
        String lower = intStr + "l";
        String upper = intStr + "L";
        try {
            Number nLower = NumberUtils.createNumber(lower);
            Number nUpper = NumberUtils.createNumber(upper);
            if (nLower != null && nUpper != null) {
                if (nLower.longValue() != nUpper.longValue()) {
                    throw new RuntimeException("metamorphic violation: l/L suffix equivalence");
                }
            }
        } catch (NumberFormatException expected) {
            // Should not happen for integer + l/L, but if it does, skip the check.
        }
    }

    private static String randomDigits(FuzzedDataProvider data, int minLen, int maxLen) {
        int len = data.consumeInt(minLen, maxLen);
        StringBuilder sb = new StringBuilder(len);
        for (int i = 0; i < len; i++) {
            sb.append((char) ('0' + data.consumeInt(0, 9)));
        }
        return sb.toString();
    }

    private static String randomDigitsAllowEmpty(FuzzedDataProvider data, int minLen, int maxLen) {
