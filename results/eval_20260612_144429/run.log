                case 2: suffix = 'D'; break;
                case 3: suffix = 'f'; break;
                case 4: suffix = 'F'; break;
                case 5: suffix = 'l'; break;
                case 6: suffix = 'L'; break;
                default: suffix = 0; // no suffix
