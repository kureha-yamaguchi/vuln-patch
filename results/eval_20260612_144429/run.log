package org.apache.commons.lang3.text.translate;

import com.code_intelligence.jazzer.api.FuzzedDataProvider;

public class FuzzHarness {
    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: Known crashing inputs from the failing test
        String[] anchors = new String[] {
            "\uD83D\uDE30", // U+1F630
            "\uD800\uDC00", // U+10000 (lowest)
            "\uD834\uDD1E", // U+1D11E
            "\uDBFF\uDFFD"  // U+10FFD (near highest)
        };
        for (String s : anchors) {
            // This goes through StringEscapeUtils -> CsvEscaper -> CharSequenceTranslator.translate
            // and triggers the buggy loop that mishandles surrogate pairs.
            org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);
        }

        // EXPLORE: Generate varied inputs that include supplementary code points (surrogates)
        int iterations = 1;
        try {
            iterations = Math.abs(data.consumeInt()) % 16 + 1;
        } catch (Throwable t) {
            // Fallback to 1 in case consumeInt misbehaves (shouldn't happen).
            iterations = 1;
        }

        for (int i = 0; i < iterations; i++) {
            String s;
            if (data.consumeBoolean()) {
                // Single supplementary code point (surrogate pair) to strongly exercise the bug path.
                int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
                s = new String(Character.toChars(cp));
            } else {
                // Mixed string with at least one surrogate pair and optional CSV-affecting chars.
                StringBuilder sb = new StringBuilder();
                // Optionally add some ASCII prefix
                if (data.consumeBoolean()) {
                    sb.append(data.consumeAsciiString(16));
                }
                // Ensure at least one supplementary code point is present
                int pairCount = 1 + data.consumeInt(0, 4);
                for (int p = 0; p < pairCount; p++) {
                    int cp = 0x10000 + Math.floorMod(data.consumeInt(), 0x10FFFF - 0x10000 + 1);
                    sb.append(Character.toChars(cp));
                    // Optionally interleave some CSV-relevant characters to vary behavior
                    if (data.consumeBoolean()) {
                        switch (data.consumeInt(0, 4)) {
                            case 0: sb.append(','); break;
                            case 1: sb.append('"'); break;
                            case 2: sb.append('\n'); break;
                            case 3: sb.append('\r'); break;
                            default: sb.append(data.consumeAsciiString(4)); break;
                        }
                    } else if (data.consumeBoolean()) {
                        sb.append(data.consumeAsciiString(8));
                    }
                }
                // Optional suffix
                if (data.consumeBoolean()) {
                    sb.append(data.consumeAsciiString(16));
                }
                s = sb.toString();
            }

            // Drive through the real public API
            String escaped = org.apache.commons.lang3.StringEscapeUtils.escapeCsv(s);

            // Metamorphic relation: unescape(escape(s)) == s
            // This should hold for any correct implementation.
            String unescaped = org.apache.commons.lang3.StringEscapeUtils.unescapeCsv(escaped);
            if (unescaped == null || !unescaped.equals(s)) {
                throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(s)) != s");
            }
        }
    }
}
