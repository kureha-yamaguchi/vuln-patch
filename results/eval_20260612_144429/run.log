    private static String buildDecimal(FuzzedDataProvider data, boolean withExponent, boolean withSuffix) {
        boolean negative = data.consumeBoolean();
        String before = digitsOnly(data.consumeAsciiString(32));
        String after = digitsOnly(data.consumeAsciiString(32));
        boolean trailingDot = data.consumeBoolean();

        // Ensure we have at least one digit overall
        if (before.isEmpty() && after.isEmpty()) {
            before = "1";
        }

        StringBuilder sb = new StringBuilder();
        if (negative) sb.append('-');
        if (before.isEmpty()) before = "0";
        sb.append(before);
        sb.append('.');

        // Optionally make trailing dot form "2."
        if (!trailingDot || after.length() > 0) {
            if (after.isEmpty()) after = "0";
            sb.append(after);
        }

        if (withExponent && data.consumeBoolean()) {
            char e = data.consumeBoolean() ? 'e' : 'E';
            sb.append(e);
            // Optional sign in exponent
            if (data.consumeBoolean()) {
                sb.append(data.consumeBoolean() ? '-' : '+');
            }
            String expDigits = digitsOnly(data.consumeAsciiString(16));
            if (expDigits.isEmpty()) expDigits = "1";
            sb.append(expDigits);
        }

        if (withSuffix && data.consumeBoolean()) {
            char[] suffixes = new char[] {'f', 'F', 'd', 'D'};
            char suff = suffixes[data.consumeInt(0, suffixes.length - 1)];
            sb.append(suff);
        }

