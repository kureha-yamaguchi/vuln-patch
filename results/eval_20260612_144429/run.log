        StringEscapeUtils.escapeCsv("\uD834\uDD1E");
        StringEscapeUtils.escapeCsv("\uDBFF\uDFFD");

        // EXPLORE: Generate varied inputs stressing surrogate pairs and CSV processing.
        // Case A: Exactly one supplementary code point (length == 2 chars).
