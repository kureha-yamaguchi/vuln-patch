        String unescaped = StringEscapeUtils.unescapeCsv(escaped);
        if (unescaped != null && !unescaped.equals(fuzzInput)) {
            throw new RuntimeException("metamorphic violation: unescapeCsv(escapeCsv(s)) != s");
        }
    }
}
