        MonthDay expected = new MonthDay(1, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: plusMonths(-1) from 2/29 UTC");
        }

        result = test.minusDays(-1);
        expected = new MonthDay(3, 1, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: minusDays(-1) from 2/29 UTC");
        }

        result = test.plusMonths(1);
        expected = new MonthDay(3, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: plusMonths(1) from 2/29 UTC");
        }

        MonthDay testB = new MonthDay(3, 31, ISOChronology.getInstanceUTC());
        result = testB.plusMonths(-1);
        expected = new MonthDay(2, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: plusMonths(-1) from 3/31 UTC");
        }

        result = testB.minusMonths(1);
        expected = new MonthDay(2, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: minusMonths(1) from 3/31 UTC");
        }

        result = test.minusMonths(-1);
        expected = new MonthDay(3, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: minusMonths(-1) from 2/29 UTC");
        }

        result = test.minusMonths(1);
        expected = new MonthDay(1, 29, ISOChronology.getInstance());
        if (!expected.equals(result)) {
            throw new RuntimeException("anchor mismatch: minusMonths(1) from 2/29 UTC");
        }

        result = test.plusDays(1);
        expected = new MonthDay(3, 1, ISOChronology.getInstance());
        if (!expected.equals(result)) {
