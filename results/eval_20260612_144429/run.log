            }
        }

        // EXPLORE: Generate many inputs that end with 'l' or 'L' to exercise the patched branch.
        int rounds = 1 + data.consumeInt(0, 20);
        for (int i = 0; i < rounds; i++) {
            String prefix;
            int mode = data.consumeInt(0, 3);
            switch (mode) {
                case 0:
                    // Minimal case: just the suffix -> reproduces "l"/"L"
                    prefix = "";
                    break;
                case 1:
                    // Pure digits, maybe with a sign
                    int val = data.consumeInt();
                    prefix = (data.consumeBoolean() ? "-" : "") + Integer.toString(Math.abs(val));
                    break;
                case 2:
                    // Arbitrary ASCII
                    prefix = data.consumeAsciiString(40);
                    break;
                case 3:
                default:
                    // ASCII with some '.'/'e'/'E' optionally kept to vary dec/exp handling
                    String raw = data.consumeAsciiString(40);
                    StringBuilder sb = new StringBuilder();
                    for (int j = 0; j < raw.length(); j++) {
                        char c = raw.charAt(j);
                        if (c == '.' || c == 'e' || c == 'E') {
                            if (data.consumeBoolean()) {
                                sb.append(c);
                            }
                        } else {
                            sb.append(c);
                        }
                    }
                    prefix = sb.toString();
                    break;
            }
            char suffix = data.consumeBoolean() ? 'l' : 'L';
            String candidate = prefix + suffix;
            try {
                NumberUtils.createNumber(candidate);
            } catch (NumberFormatException expected) {
                // Expected for invalid inputs; ignore
            }
        }

        // METAMORPHIC CHECK: Parsing a canonical int string must recover the same int.
        int n = data.consumeInt(-1_000_000, 1_000_000);
        String intStr = Integer.toString(n);
        Number parsed = NumberUtils.createNumber(intStr);
        if (parsed == null || parsed.intValue() != n) {
            throw new RuntimeException("metamorphic violation: parse(intString) != original int");
        }
    }
