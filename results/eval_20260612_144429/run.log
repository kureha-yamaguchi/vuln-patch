                return;
            }
        }
        // Find a gap with at least 2ms so we can pick start/end within the same gap.
        int gapIndex = -1;
        for (int i = 0; i < n - 1; i++) {
            if (times[i + 1] - times[i] >= 2) {
                gapIndex = i;
                break;
            }
        }
        if (gapIndex == -1) {
            return; // no suitable gap
        }
        long left = times[gapIndex];
        long right = times[gapIndex + 1];
        long delta = right - left; // >= 2
        // Choose start strictly inside (left, right)
        int maxDx = (int) Math.min(delta - 1, Integer.MAX_VALUE);
        int dx = data.consumeInt(1, Math.max(1, maxDx));
