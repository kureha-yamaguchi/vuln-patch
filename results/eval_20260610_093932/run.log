    public static void fuzzerTestOneInput(com.code_intelligence.jazzer.api.FuzzedDataProvider data) {
        // ANCHOR: exact failing input from the test to trigger the buggy behavior
        NormalDistribution std = new NormalDistributionImpl(0.0, 1.0);
        try {
            std.inverseCumulativeProbability(0.9772498680518209d);
        } catch (MathException e) {
            throw new RuntimeException(e);
        }

        // EXPLORE: generate probabilities that make the bracketing endpoint a root (fa*fb == 0)
        // Strategy 1: Standard normal, choose x = initial + n where initial = 1 for p > 0.5,
        // so x in {2,3,4,...} and p = CDF(x). This makes f(b) = CDF(b) - p = 0 at some iteration.
        int trials = 1 + Math.abs(data.consumeInt()) % 8; // up to 8 exploratory cases
        for (int i = 0; i < trials; i++) {
            boolean positiveSide = data.consumeBoolean();
            int k = 1 + Math.abs(data.consumeInt()) % 10; // step 1..10 from the initial side
            double x = (positiveSide ? 1.0 : -1.0) * (1.0 + k); // e.g. 2,3,... or -2,-3,...
            double p;
            try {
                p = std.cumulativeProbability(x);
            } catch (MathException e) {
                throw new RuntimeException(e);
            }
            try {
                std.inverseCumulativeProbability(p);
            } catch (MathException e) {
                throw new RuntimeException(e);
            }
        }

        // Strategy 2: Vary mean and sd, construct p so that x = initial +/- 1 is an exact root endpoint.
        int more = 1 + Math.abs(data.consumeInt()) % 3;
        for (int j = 0; j < more; j++) {
            // mean in roughly [-10, 10], sd in [0.1, 5.1]
            double mean = ((data.consumeInt() % 2001) / 100.0) - 10.0;
            double sd = (Math.abs(data.consumeInt()) % 500) / 100.0 + 0.1;
            NormalDistribution d = new NormalDistributionImpl(mean, sd);

            boolean useUpperSide = data.consumeBoolean(); // pick p > 0.5 or p < 0.5 side
            double initial = useUpperSide ? (mean + sd) : (mean - sd);
            double xCand = initial + (useUpperSide ? 1.0 : -1.0);

            double p2;
            try {
                p2 = d.cumulativeProbability(xCand);
            } catch (MathException e) {
                throw new RuntimeException(e);
            }

            try {
                d.inverseCumulativeProbability(p2);
            } catch (MathException e) {
                throw new RuntimeException(e);
            }
        }
    }
}
