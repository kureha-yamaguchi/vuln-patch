                m = data.consumeInt(3, 12);
            }
            List<LinearConstraint> constraints = new ArrayList<LinearConstraint>(m);

            // Create a base constraint and a duplicate to enforce a tie scenario.
            double[] base = new double[n];
            for (int i = 0; i < n; i++) {
                int val = (data.remainingBytes() > 0) ? data.consumeInt(0, 5) : 1;
                if (i == 0 && val == 0) {
                    val = 1; // ensure at least one positive coefficient
                }
                base[i] = (double) val;
