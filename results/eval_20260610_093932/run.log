            double rhsBase = (data.remainingBytes() > 0) ? (double) data.consumeInt(1, 20) : 2.0;

            constraints.add(new LinearConstraint(base, Relationship.GEQ, rhsBase));
            constraints.add(new LinearConstraint(base.clone(), Relationship.GEQ, rhsBase));

            for (int i = 2; i < m; i++) {
                double[] a = new double[n];
                boolean makeDuplicate = data.remainingBytes() > 0 && data.consumeBoolean();
                if (makeDuplicate) {
