        // This exercises the getPivotRow degeneracy/tie-breaking logic in SimplexSolver.
        {
            SimplexSolver solver = new SimplexSolver();
            double[] objective = new double[] {1.0, 0.0, 0.0};
            LinearObjectiveFunction f = new LinearObjectiveFunction(objective, 0.0);
            List<LinearConstraint> constraints = new ArrayList<LinearConstraint>();
            // Two identical GEQ constraints create artificial variables and a tie in the min ratio test for the first pivot.
            constraints.add(new LinearConstraint(new double[] {2.0, 1.0, 0.0}, Relationship.GEQ, 2.0));
            constraints.add(new LinearConstraint(new double[] {2.0, 1.0, 0.0}, Relationship.GEQ, 2.0));
            // Add an extra GEQ to keep Phase 1 active and maintain feasibility.
            constraints.add(new LinearConstraint(new double[] {0.0, 1.0, 1.0}, Relationship.GEQ, 2.0));
            solver.optimize(f, constraints, GoalType.MAXIMIZE, true);
        }

        // Explore: generate varied problems with properties likely to trigger degeneracy:
        // - Many GEQ/EQ constraints (to introduce artificial variables).
        // - At least two identical constraints (to create ties in the min ratio test).
        int problems = 1;
        if (data.remainingBytes() > 0) {
            problems = data.consumeInt(1, 3);
        }
        for (int p = 0; p < problems; p++) {
            int n = 3;
            if (data.remainingBytes() > 0) {
                n = data.consumeInt(2, 8);
            }
            double[] coeffs = new double[n];
            for (int i = 0; i < n; i++) {
