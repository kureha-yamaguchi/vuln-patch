# minfix_w2 — Wave-2 mechanisms (always-wrong legs) + iteration rerun of
# the minfix_w1 misses. New since minfix_w1:
#   --replay_relations_on_patched  (P3.2 replay: screened relations run
#       standalone against the patched build; firings go to the verifier)
#   documented-formula synthesis strategy (W2.10)
#   P3.3 crash-type pinning (always-on)
#   W1.4 REVISED: latent firings are no longer auto-dismissed — the
#       firing input is replayed on buggy and the verifier decides
#       (the auto-dismiss killed Lang-60-o's true capacity catch).
# Correct legs FIRST (per-suite pool: c legs seed their bug's pool).
#
# Expectations:
#   Math-2-c    clean  (tolerance guard: replay must not false-fire on SOFix)
#   Chart-26-c  CLEAN  (was FP always — P3.3 pinning + lift context)
#   Lang-60-c   clean  (replay-FP guard + pool seed)
#   Lang-7-c    clean  (latent-path guard: revised W1.4 must not re-admit FP)
#   Math-2-o    CATCH  (formula strategy + pool + replay)
#   Lang-50-o   CATCH hoped (replay runs the latent locale relations)
#   Math-53-o   CATCH hoped (replay + trigger literals)
#   Lang-27-o   miss accepted (crash-only)
#   Time-4-o    CATCH  (stable smoke)
#   Lang-60-o   CATCH  (revised latent handling — verifier sees the replay fact)
#   Chart-3-o   CATCH hoped (reroll + replay)
#   Closure-33-o CATCH hoped (reroll + replay)
#   Lang-41-o   CATCH hoped (reroll + replay; sibling-agreement relation)
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Chart/patch1-Chart-26-Jaid.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SimFix/Lang/patch1-Lang-60-SimFix.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/ACS/Lang/patch1-Lang-7-ACS.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-50-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Math/patch1-Math-53-DeepRepair.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Lang/patch1-Lang-27-DeepRepair.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Time/patch1-Time-4-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-60-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Elixir/Chart/patch1-Chart-3-Elixir-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Closure/patch1-Closure-33-Jaid-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-41-Arja-plausible.patch"
)
