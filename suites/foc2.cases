# foc2: validate FOCUSED (per-source) synthesis on 2 legs.
#   Math-2-o — the mean-formula MUST now be synthesized every roll (the
#     formula pass enumerates all documented formulas); target TP, and
#     the success signal is 'hypergeom-mean-formula' present in the
#     formula pass on the trace, not just the score.
#   Math-2-c — same class, correct patch: the mean-formula stays quiet
#     (correct code satisfies it); must be TN (no new FP from more
#     candidates).
# --focused_synthesis + --attribution_judge both ON.
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched --rule_compile_repair --focused_synthesis --attribution_judge"
CASES=(
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
)
