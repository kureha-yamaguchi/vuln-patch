# 24-run diagnostic set (distinct bugs of diag_A/B) — the FINAL-CONFIRMATION
# sweep. EXPENSIVE: 24 full runs at gpt-5.4. Do NOT run casually while
# iterating — use suites/semantic8.cases (or t4.cases) for iteration and
# save this for the final confirm.
#   ./run_suite.sh <name> suites/diag24.cases
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations"
CASES=(
  # NOTE: Lang-7/Arja, Lang-22/Arja and Math-70/SketchFix o-legs are
  # undetectable (suites/UNDETECTABLE.md). Kept ACTIVE here for
  # comparability with the historical diag baseline — but score recall
  # against the certified-detectable denominator (i.e. expect these three
  # as permanent FNs). All other o-legs in this suite are now certified
  # detectable (certified_suite.jsonl, 2026-07-16).
  "-o Lang 7 Arja"
  "-c Lang 7 ACS"
  "-o Lang 22 Arja"
  "-c Lang 22 DeepRepair"
  "-o Lang 27 DeepRepair"
  "-c Lang 27 SimFix"
  "-o Lang 43 Arja"
  "-c Lang 43 Arja"
  "-o Lang 55 Arja"
  "-c Lang 55 Jaid"
  "-o Chart 1 Arja"
  "-c Chart 1 CapGen"
  "-o Chart 5 DeepRepair"
  "-c Chart 5 Arja"
  "-o Chart 19 Arja"
  "-c Chart 19 ACS"
  "-o Chart 26 Jaid"
  "-c Chart 26 Jaid"
  "-o Time 4 Arja"
  "-c Time 4 Elixir"
  "-o Math 2 Arja"
  "-c Math 2 SOFix"
  "-o Math 70 SketchFix"
  "-c Math 70 Arja"
)
