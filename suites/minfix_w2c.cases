# minfix_w2c — guard run for the three post-w2b fixes:
#   (1) broadened differential-replay eligibility: ANY escaped non-alarm
#       exception on a semantic leg (Math-2-c's NotPositiveException FP)
#   (2) symmetric-firing verifier note (Chart-26-c FP) — Lang-41-o and
#       Lang-60-o are the guards that symmetric catches survive it
#   (3) formula-first synthesis strategy (Math-2-o via pool + replay)
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Chart/patch1-Chart-26-Jaid.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SimFix/Lang/patch1-Lang-60-SimFix.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-41-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-60-Arja-plausible.patch"
)
