# 8-bug semantic set (distinct bugs of mined54_A/B) — one overfitting + one
# correct patch per bug. Synthesis is ON since the B2 post-overhaul gate
# (2026-07-15): this suite now measures the FULL stack. For cheaper
# iteration without synthesis, drop --synthesize_relations --replay_relations_on_patched locally.
#   ./run_suite.sh <name> suites/semantic8.cases
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched"
CASES=(
  # o-legs of Lang-7/Arja and Lang-22/Arja EXCLUDED (environment-
  # undetectable — see suites/UNDETECTABLE.md); c-legs kept for precision.
  # "-o Lang 7 Arja"
  "-c Lang 7 ACS"
  # "-o Lang 22 Arja"
  "-c Lang 22 DeepRepair"
  "-o Lang 55 Arja"
  "-c Lang 55 Jaid"
  "-o Chart 1 Arja"
  "-c Chart 1 CapGen"
  "-o Chart 19 Arja"
  "-c Chart 19 ACS"
  "-o Chart 26 Jaid"
  "-c Chart 26 Jaid"
  "-o Time 4 Arja"
  "-c Time 4 Elixir"
  "-o Math 2 Arja"
  "-c Math 2 SOFix"
)
