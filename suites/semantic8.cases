# 8-bug semantic set (distinct bugs of mined54_A/B) — one overfitting + one
# correct patch per bug. This is the CHEAP ITERATION set: relation
# verification on, but NO --synthesize_relations.
#   ./run_suite.sh <name> suites/semantic8.cases
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations"
CASES=(
  "-o Lang 7 Arja"
  "-c Lang 7 ACS"
  "-o Lang 22 Arja"
  "-c Lang 22 DeepRepair"
  "-o Lang 55 Arja"
  "-c Lang 55 Jaid"
  "-o Chart 1 Arja"
  "-c Chart 1 CapGen"
  "-o Chart 19 Arja"
  "-c Chart 19 ACS"
  "-o Chart 26 Jaid"
  "-c Chart 26 Jaid"
  "-o Time 4 Arja"
  "-c Time 4 Elixir"
  "-o Math 2 Arja"
  "-c Math 2 SOFix"
)
