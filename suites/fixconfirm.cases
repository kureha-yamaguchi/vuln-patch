  # suites/UNDETECTABLE.md. Do not count as FN; c-leg kept for precision.
  # "-o Lang 7 Arja"
  "-c Lang 7 ACS"
  "-o Math 2 Arja"
  "-c Math 2 SOFix"
  "-o Chart 26 Jaid"
  "-c Chart 26 Jaid"
)
