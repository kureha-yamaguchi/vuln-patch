# Phase-1 baseline — the 30-leg dev split of pinned_tasks.jsonl (P1.1).
# Regenerated 2026-07-17 after the pin-order fix (Closure-92/Time-11
# back to their witness-pinned patch1).
# Expected permanent miss: Time-11-o (cross-thread). Expected FP until
# P3.3: Chart-26-c (flag-pattern message launder).
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched --rule_compile_repair"
