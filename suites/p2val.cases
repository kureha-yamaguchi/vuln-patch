# Phase-2 validation: cheap direction + determinism checks.
# - Lang-7-c: direction fix — synthesis should stop inverting the --/null
#   relation now that it sees the failing test. Correct leg must stay clean.
# - Math-2 pair: determinism — the sample() oracle is flaky; the
#   deterministic getNumericalMean discriminator should now rank first.
#   Overfit should catch RELIABLY; correct must stay clean.
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/ACS/Lang/patch1-Lang-7-ACS.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
)
