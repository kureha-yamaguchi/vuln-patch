# foc15: ~15-leg validation of focused synthesis + attribution + the
# conservative state pass, BEFORE any ceiling-raising work. Spans all four
# passes and both sides. Baseline to compare: single-call full30v2 and the
# focused foc5 (4/4 recall, 1 state FP now fixed).
# Overfits (recall — must catch the mechanism-reachable ones):
#   Math-2, Math-53, Lang-41, Lang-50, Lang-60, Chart-7, Chart-26, Time-4
# Corrects (precision — the state-pass fix + fencing must hold):
#   Math-2, Math-53, Lang-41, Lang-60, Chart-26, Time-4, Lang-50
# (Excludes the known-unreachable walls Chart-3/Closure-33/92/Math-57/Time-11
#  -o and the mislabeled Lang-7 — those are ceiling work, not this test.)
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched --rule_compile_repair --focused_synthesis --attribution_judge"
CASES=(
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Math/patch1-Math-53-DeepRepair.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Arja/Math/patch1-Math-53-Arja.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-41-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-50-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-60-Arja-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SimFix/Lang/patch1-Lang-60-SimFix.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Chart/patch1-Chart-7-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Chart/patch1-Chart-26-Jaid-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Chart/patch1-Chart-26-Jaid.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Time/patch1-Time-4-Arja-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Elixir/Time/patch1-Time-4-Elixir.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Closure/patch1-Closure-62-Jaid.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Closure/patch1-Closure-62-Jaid-plausible.patch"
)
