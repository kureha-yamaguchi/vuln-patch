# P3.2 validation — Math-2 pair, SEQUENTIAL (PARALLEL=1) so the correct
# leg seeds the pool with the mean-formula BEFORE the overfit leg runs.
# Expect: correct TN (mean-formula holds on fixed build), overfit TP
# RELIABLY (pooled deterministic mean-formula fires on Arja build where
# getNumericalMean stays -49.76). Also tests root-region anchoring.
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Math/patch1-Math-2-Arja-plausible.patch"
)
