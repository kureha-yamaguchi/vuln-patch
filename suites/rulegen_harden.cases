# Soundness-hardening ON. Identical to rulegen_widen.cases (the harden-OFF
# baseline) except --rule_soundness_harden. Watch [harden] log lines (does it
# detect+repair unsound relations?) and false-fire on the -c legs vs baseline.
MODEL="gpt-5.4"
COMMON="-n 1 -m 1 --fuzz_timeout 20 --synthesize_relations --rulegen_only --screen_runs 5000 --rule_compile_repair --rule_soundness_harden"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Arja/Chart/patch1-Chart-3-Arja.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SimFix/Lang/patch1-Lang-60-SimFix.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Arja/Math/patch1-Math-53-Arja.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/CapGen/Math/patch1-Math-57-CapGen.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Elixir/Chart/patch1-Chart-3-Elixir-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-41-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Arja/Lang/patch1-Lang-60-Arja-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Math/patch1-Math-53-DeepRepair.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/ssFix/Math/patch1-Math-57-ssFix-plausible.patch"
)
