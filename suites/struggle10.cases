# struggle10: the five stubborn dev misses (Chart-3, Closure-33, Lang-27,
# Math-53, Math-57) with their correct siblings as false-alarm guards.
# Purpose (2026-07-19): validate the replay-flag + harden-fix repair — the
# CORRECTION section in semantic-recall-brainstorm.md. Math-53-o is the flip
# candidate (its convicting field-level NaN rule was synthesized in `onefull`
# and lost to the harden pass + missing replay flag).
# LAUNCH: PARALLEL=1 (serial) — pooling needs each correct leg to FINISH
# before its overfit sibling STARTS; pairs are ordered c-then-o per bug.
# Harden deliberately OFF; compile-repair (R1, measured win) ON.
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched --rule_compile_repair"
CASES=(
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Arja/Math/patch1-Math-53-Arja.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Math/patch1-Math-53-DeepRepair.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/CapGen/Math/patch1-Math-57-CapGen.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/ssFix/Math/patch1-Math-57-ssFix-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Arja/Chart/patch1-Chart-3-Arja.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Elixir/Chart/patch1-Chart-3-Elixir-plausible.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SimFix/Lang/patch1-Lang-27-SimFix.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Lang/patch1-Lang-27-DeepRepair.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Closure/patch1-Closure-33-Jaid.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Closure/patch1-Closure-33-Jaid-plausible.patch"
)
