# hfix11: first measurement of H1+H2+H3 (whole-test context, real failure
# message, setup-fidelity gate) ON TOP OF the pool-free / synth-8 /
# all-tripwires code. Overfit-heavy on purpose (recall iteration): the five
# stubborn misses, the Lang-27 confirming repeat, and the two catches still
# owing their rule-#2 repeat (Closure-62-o is H1's poster child — its test
# calls a formatter() helper the writer was never shown before H1).
# Three correct guards chosen adversarially against the H changes:
# Closure-62-c (setup-divergence FP class — H3 must auto-reject it),
# Chart-26-c (entity-wiring FP class), Math-2-c (extreme-magnitude FP class).
# LAUNCH: PARALLEL=4 (pooling is gone — no ordering constraint).
MODEL="gpt-5.4"
COMMON="-n 3 -m 8 --fuzz_timeout 20 --verify_timeout 20 --verify_relations --synthesize_relations --replay_relations_on_patched --rule_compile_repair"
CASES=(
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Math/patch1-Math-53-DeepRepair.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/ssFix/Math/patch1-Math-57-ssFix-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Elixir/Chart/patch1-Chart-3-Elixir-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Closure/patch1-Closure-33-Jaid-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/DeepRepair/Lang/patch1-Lang-27-DeepRepair.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/Jaid/Closure/patch1-Closure-62-Jaid-plausible.patch"
  "-o patchfile:/home/code/drr/Patches/Doverfitting/SequenceR/Closure/patch1-Closure-92-SequenceR.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Closure/patch1-Closure-62-Jaid.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/Jaid/Chart/patch1-Chart-26-Jaid.patch"
  "-c patchfile:/home/code/drr/Patches/Dcorrect/SOFix/Math/patch1-Math-2-SOFix.patch"
)
